+++ b/utils/context_utils.py
@@ -0,0 +1,75 @@
+"""
+Helpers for keeping the LLM context small: truncating long tool outputs and
+compacting old conversation turns. These never alter the structure of messages
+(tool_use / tool_result pairing is preserved); they only shorten text payloads.
+"""
+import copy
+
+MAX_TOOL_OUTPUT_CHARS = 10000   # max chars of a single tool result kept in context
+KEEP_RECENT_MESSAGES = 6        # most recent messages are never compacted
+MAX_OLD_TEXT_CHARS = 1000       # max chars of a text payload in an old message
+
+
+def truncate_text(text, max_chars):
+    """
+    Keep the head and tail of `text` so that at most roughly `max_chars`
+    characters remain, with a marker stating how many characters were removed.
+    """
+    if not isinstance(text, str) or len(text) <= max_chars:
+        return text
+    marker_fmt = "\n... [{} characters truncated] ...\n"
+    # Reserve room for the marker itself (worst case digits included).
+    budget = max(max_chars - len(marker_fmt.format(len(text))), 0)
+    head_len = budget // 2
+    tail_len = budget - head_len
+    removed = len(text) - head_len - tail_len
+    head = text[:head_len]
+    tail = text[len(text) - tail_len:] if tail_len > 0 else ""
+    return head + marker_fmt.format(removed) + tail
+
+
+def truncate_tool_output(output, max_chars=MAX_TOOL_OUTPUT_CHARS):
+    """Truncate a tool result string before it is added to the conversation."""
+    if not isinstance(output, str):
+        output = str(output)
+    return truncate_text(output, max_chars)
+
+
+def _compact_content_text(value, max_chars):
+    """Shorten the text inside a content value (string or list of blocks)."""
+    if isinstance(value, str):
+        return truncate_text(value, max_chars)
+    if isinstance(value, list):
+        new_blocks = []
+        for block in value:
+            if isinstance(block, dict):
+                block = dict(block)
+                btype = block.get('type')
+                if btype == 'text' and isinstance(block.get('text'), str):
+                    block['text'] = truncate_text(block['text'], max_chars)
+                elif btype == 'tool_result':
+                    block['content'] = _compact_content_text(block.get('content'), max_chars)
+            new_blocks.append(block)
+        return new_blocks
+    return value
+
+
+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, max_old_chars=MAX_OLD_TEXT_CHARS):
+    """
+    Return a copy of `messages` where every message except the `keep_recent`
+    most recent ones has its long text payloads (text blocks, tool results,
+    function_call_output) truncated. The input list is not modified.
+    """
+    cutoff = max(len(messages) - keep_recent, 0)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        new_msg = dict(msg)
+        if 'content' in new_msg:
+            new_msg['content'] = _compact_content_text(new_msg['content'], max_old_chars)
+        if new_msg.get('type') == 'function_call_output' and isinstance(new_msg.get('output'), str):
+            new_msg['output'] = truncate_text(new_msg['output'], max_old_chars)
+        compacted.append(new_msg)
+    return compacted
