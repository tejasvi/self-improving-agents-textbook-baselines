+    def _run_attempt_with_retry(self, instruction):
+        """
+        Run one conversation attempt. If it raises an exception, retry the
+        conversation once from its last good state, which is the empty starting
+        history of the attempt (the failed run produced no usable history).
+        Returns (patch, passed). If both tries raise, passed is False.
+        """
+        for try_no in (1, 2):
+            if try_no > 1:
+                # Discard any partial edits from the failed try before retrying.
+                reset_to_commit(self.git_tempdir, self.base_commit)
+            try:
+                msg_history = chat_with_agent(
+                    instruction, model=self.code_model,
+                    msg_history=[], logging=safe_log,
+                )
+                patch = diff_versus_commit(self.git_tempdir, self.base_commit)
+                passed = self._examples_passed(msg_history)
+                return patch, passed
+            except Exception as e:
+                safe_log(f"Attempt raised an exception (try {try_no}/2): {e!r}")
+        patch = diff_versus_commit(self.git_tempdir, self.base_commit)
+        return patch, False
