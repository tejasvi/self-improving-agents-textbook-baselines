+import json
+import sys
+import pytest
+
+sys.path.insert(0, __import__("os").path.dirname(__import__("os").path.dirname(__import__("os").path.abspath(__file__))))
+
+from tools.run_io_tests import tool_info, tool_function
+
+SUM_PROGRAM = "a, b = map(int, input().split())\nprint(a + b)\n"
+
+
+def _write(tmp_path, name, src):
+    p = tmp_path / name
+    p.write_text(src)
+    return str(p)
+
+
+def test_schema_structure():
+    info = tool_info()
+    assert info["name"] == "run_io_tests"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert set(schema["required"]) == {"solution_path", "test_cases"}
+    assert set(schema["properties"]) >= {"solution_path", "test_cases", "timeout_seconds"}
+    for prop in schema["properties"].values():
+        assert "type" in prop and "description" in prop
+    assert "required" not in schema["properties"]
+
+
+def test_all_pass(tmp_path):
+    path = _write(tmp_path, "sol.py", SUM_PROGRAM)
+    cases = json.dumps([
+        {"input": "1 2\n", "expected_output": "3\n"},
+        {"input": "10 -4\n", "expected_output": "6\n"},
+    ])
+    assert tool_function(path, cases) == "PASS 2/2"
+
+
+def test_wrong_output_reports_expected_and_actual(tmp_path):
+    path = _write(tmp_path, "sol.py", "a, b = map(int, input().split())\nprint(a - b)\n")
+    cases = json.dumps([{"input": "5 2\n", "expected_output": "7\n"}])
+    out = tool_function(path, cases)
+    assert out.startswith("PASS 0/1")
+    assert "FAIL" in out
+    assert "7" in out and "3" in out
+
+
+def test_timeout_is_reported(tmp_path):
+    path = _write(tmp_path, "loop.py", "while 1:\n    pass\n")
+    cases = json.dumps([{"input": "", "expected_output": "x\n"}])
+    out = tool_function(path, cases, timeout_seconds=0.5)
+    assert "TIMEOUT" in out
+    assert "PASS 0/1" in out
+
+
+def test_exception_stderr_reported(tmp_path):
+    path = _write(tmp_path, "boom.py", "raise ValueError('kaboom')\n")
+    cases = json.dumps([{"input": "", "expected_output": "1\n"}])
+    out = tool_function(path, cases)
+    assert "PASS 0/1" in out
+    assert "kaboom" in out
+
+
+def test_whitespace_and_crlf_tolerance(tmp_path):
+    path = _write(tmp_path, "sol.py", "print('1 2')\nprint('3')\n")
+    cases = json.dumps([{"input": "", "expected_output": "1 2\r\n3"}])
+    assert tool_function(path, cases) == "PASS 1/1"
+
+
+def test_malformed_json(tmp_path):
+    path = _write(tmp_path, "sol.py", SUM_PROGRAM)
+    out = tool_function(path, "[{bad json")
+    assert "not valid JSON" in out
+
+
+def test_empty_list(tmp_path):
+    path = _write(tmp_path, "sol.py", SUM_PROGRAM)
+    assert "empty" in tool_function(path, "[]")
+
+
+def test_bad_entry_shape(tmp_path):
+    path = _write(tmp_path, "sol.py", SUM_PROGRAM)
+    out = tool_function(path, json.dumps([{"input": "1 2"}]))
+    assert "expected_output" in out
+
+
+def test_missing_file(tmp_path):
+    out = tool_function(str(tmp_path / "nope.py"), json.dumps([{"input": "", "expected_output": ""}]))
+    assert "does not exist" in out
+
+
+def test_non_py_file(tmp_path):
+    path = _write(tmp_path, "sol.txt", SUM_PROGRAM)
+    out = tool_function(path, json.dumps([{"input": "", "expected_output": ""}]))
+    assert ".py" in out
+
+
+def test_loader_picks_up_tool():
+    from tools import load_all_tools
+    names = [t["name"] for t in load_all_tools(logging=lambda *_: None)]
+    assert "run_io_tests" in names
