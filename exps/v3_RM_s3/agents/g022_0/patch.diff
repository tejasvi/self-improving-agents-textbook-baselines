+def extract_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in a generic-format message history.
+    Handles both plain-string content and list-of-blocks content.
+    Returns '' if no assistant text is found.
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content', '')
+        if isinstance(content, str):
+            if content.strip():
+                return content
+            continue
+        texts = [
+            b.get('text', '') for b in content
+            if isinstance(b, dict) and b.get('type') == 'text' and b.get('text')
+        ]
+        text = "\n".join(t for t in texts if t.strip())
+        if text.strip():
+            return text
+    return ''
+
