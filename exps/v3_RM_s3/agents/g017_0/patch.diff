+def log_response_metadata(response, model='', logging=print):
+    """
+    Logs the metadata of a single model response (stop reason and token usage)
+    to the chat history via the given logging function.
+    """
+    try:
+        if 'claude' in model:
+            stop_reason = getattr(response, 'stop_reason', None)
+            usage = getattr(response, 'usage', None)
+            input_tokens = getattr(usage, 'input_tokens', None)
+            output_tokens = getattr(usage, 'output_tokens', None)
+            meta = {
+                'stop_reason': stop_reason,
+                'usage': {'input_tokens': input_tokens, 'output_tokens': output_tokens},
+            }
+        elif model.startswith('o3-'):
+            status = getattr(response, 'status', None)
+            incomplete = getattr(response, 'incomplete_details', None)
+            stop_reason = getattr(incomplete, 'reason', None) if incomplete else None
+            usage = getattr(response, 'usage', None)
+            input_tokens = getattr(usage, 'input_tokens', None)
+            output_tokens = getattr(usage, 'output_tokens', None)
+            meta = {
+                'stop_reason': stop_reason if stop_reason else status,
+                'status': status,
+                'usage': {'input_tokens': input_tokens, 'output_tokens': output_tokens},
+            }
+        else:
+            return
+        logging(f"\n===== Response Metadata =====\n{meta}")
+    except Exception as e:
+        logging(f"Failed to log response metadata: {e}")
+
