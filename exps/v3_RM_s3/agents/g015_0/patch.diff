diff --git a/tools/run_io_tests.py b/tools/run_io_tests.py
new file mode 100644
index 0000000..b4eda90
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,132 @@
+import os
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10.0
+MAX_SHOWN_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python solution program on given inputs and compare its standard output with the expected outputs.
+
+* The solution file must be a complete Python program that reads from standard input and writes to standard output.
+* Each test case provides an 'input' (fed to stdin) and an 'expected_output' (compared against stdout).
+* Comparison ignores trailing whitespace on each line and trailing empty lines, but is otherwise exact.
+* Each test is run in a fresh process with a time limit (default 10 seconds per test).
+* The result reports PASS/FAIL for every test case, with the actual output and stderr for failing cases, followed by a summary.
+* Use this tool to check your solution against the sample tests from the problem statement and against your own additional test cases.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each test case is an object with 'input' and 'expected_output' strings.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should write to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Time limit in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    """Strip trailing whitespace on each line and trailing empty lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def _truncate(text: str) -> str:
+    if len(text) > MAX_SHOWN_CHARS:
+        return text[:MAX_SHOWN_CHARS] + f"\n... [truncated, {len(text) - MAX_SHOWN_CHARS} more chars]"
+    return text
+
+
+def _run_one(solution_path: str, test_input: str, timeout: float):
+    """Run the solution once. Returns (status, stdout, stderr) where status is 'ok', 'timeout', or 'crash'."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return "timeout", out, err
+    if proc.returncode != 0:
+        return "crash", proc.stdout, proc.stderr
+    return "ok", proc.stdout, proc.stderr
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = None) -> str:
+    try:
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: test_cases must be a non-empty list of objects with 'input' and 'expected_output'."
+        time_limit = DEFAULT_TIMEOUT if timeout is None else float(timeout)
+
+        reports = []
+        passed = 0
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Test {idx}: FAIL (malformed test case, needs 'input' and 'expected_output')")
+                continue
+            test_input = str(case["input"])
+            expected = str(case["expected_output"])
+            status, out, err = _run_one(solution_path, test_input, time_limit)
+
+            if status == "timeout":
+                reports.append(
+                    f"Test {idx}: FAIL (time limit exceeded after {time_limit}s)\n"
+                    f"--- stdout so far ---\n{_truncate(out)}\n--- stderr ---\n{_truncate(err)}"
+                )
+            elif status == "crash":
+                reports.append(
+                    f"Test {idx}: FAIL (runtime error, exit code non-zero)\n"
+                    f"--- input ---\n{_truncate(test_input)}\n--- stderr ---\n{_truncate(err)}"
+                )
+            elif _normalize(out) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+            else:
+                reports.append(
+                    f"Test {idx}: FAIL (wrong answer)\n"
+                    f"--- input ---\n{_truncate(test_input)}\n"
+                    f"--- expected output ---\n{_truncate(expected)}\n"
+                    f"--- actual output ---\n{_truncate(out)}\n"
+                    f"--- stderr ---\n{_truncate(err)}"
+                )
+
+        total = len(test_cases)
+        summary = f"Summary: {passed}/{total} tests passed."
+        return "\n\n".join(reports) + "\n\n" + summary
+    except Exception as e:
+        return f"Error: {str(e)}"
