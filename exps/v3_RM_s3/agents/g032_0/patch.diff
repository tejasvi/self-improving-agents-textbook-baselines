+import os
+import copy
+
+import pytest
+
+from tools.run_io_tests import tool_function, tool_info, normalize_output, truncate_field
+
+
+ECHO_DOUBLE = "n = int(input())\nprint(n * 2)\n"
+
+
+@pytest.fixture
+def write_script(tmp_path):
+    def _write(code, name="sol.py"):
+        p = tmp_path / name
+        p.write_text(code)
+        return str(p)
+    return _write
+
+
+def test_schema_nesting():
+    info = tool_info()
+    assert info["name"] == "run_io_tests"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert set(schema["required"]) == {"solution_path", "test_cases"}
+    allowed = {"type", "description", "properties", "required", "items"}
+    for name, prop in schema["properties"].items():
+        assert "type" in prop and "description" in prop, name
+        assert set(prop) <= allowed, name
+    items = schema["properties"]["test_cases"]["items"]
+    assert set(items["required"]) == {"input", "expected_output"}
+    assert set(items["properties"]) == {"input", "expected_output"}
+
+
+def test_all_pass(write_script):
+    path = write_script(ECHO_DOUBLE)
+    out = tool_function(path, [{"input": "2\n", "expected_output": "4\n"}, {"input": "5\n", "expected_output": "10"}])
+    assert "Case 1: PASS" in out and "Case 2: PASS" in out
+    assert "Summary: 2/2 passed." in out
+
+
+def test_wrong_answer_shows_details(write_script):
+    path = write_script("n = int(input())\nprint(n * 3)\n")
+    out = tool_function(path, [{"input": "2\n", "expected_output": "4\n"}])
+    assert "Case 1: FAIL" in out
+    assert "Summary: 0/1 passed." in out
+    assert "Expected output:" in out and "Actual stdout:" in out
+    assert "6" in out
+
+
+def test_whitespace_tolerant(write_script):
+    path = write_script("print('hi   ')\nprint()\nprint()\n")
+    out = tool_function(path, [{"input": "", "expected_output": "hi\n"}])
+    assert "Case 1: PASS" in out
+
+
+def test_timeout_does_not_block_other_cases(write_script):
+    path = write_script("import time\nn = int(input())\nif n == 0:\n    time.sleep(5)\nprint(n)\n")
+    out = tool_function(path, [{"input": "0\n", "expected_output": "0\n"}, {"input": "7\n", "expected_output": "7\n"}],
+                        timeout_seconds=0.5)
+    assert "Case 1: TIMEOUT" in out
+    assert "Case 2: PASS" in out
+    assert "Summary: 1/2 passed." in out
+
+
+def test_runtime_error_reports_stderr(write_script):
+    path = write_script("raise ValueError('boom')\n")
+    out = tool_function(path, [{"input": "", "expected_output": "x\n"}])
+    assert "Case 1: RUNTIME ERROR" in out
+    assert "boom" in out
+
+
+def test_invalid_arguments_return_error_strings(write_script):
+    path = write_script(ECHO_DOUBLE)
+    assert tool_function("relative.py", [{"input": "", "expected_output": ""}]).startswith("Error:")
+    assert tool_function("/nonexistent/x.py", [{"input": "", "expected_output": ""}]).startswith("Error:")
+    assert tool_function(path, []).startswith("Error:")
+    assert tool_function(path, [{"input": "1"}]).startswith("Error:")
+    assert tool_function(path, [{"input": "1", "expected_output": "2"}], timeout_seconds=0).startswith("Error:")
+
+
+def test_helpers():
+    assert normalize_output("a  \nb\n\n\n") == ["a", "b"]
+    assert normalize_output("") == []
+    long = "x" * 1500
+    t = truncate_field(long)
+    assert len(t) < 1500 and "clipped" in t
