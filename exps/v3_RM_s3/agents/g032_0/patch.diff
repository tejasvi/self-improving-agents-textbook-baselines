+++ b/tools/run_io_tests.py
@@ -0,0 +1,146 @@
+import os
+import subprocess
+import sys
+
+MAX_FIELD_CHARS = 1000
+DEFAULT_TIMEOUT_SECONDS = 10
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python solution program on a list of test cases and compare its standard output with the expected output.\n
+* Each test case provides an `input` string that is fed to the program's standard input, and an `expected_output` string.\n
+* Comparison is whitespace-tolerant: trailing spaces on each line and trailing blank lines are ignored.\n
+* The report contains one line per case (PASS, FAIL, TIMEOUT, or RUNTIME ERROR), a summary, and the details of failing cases (input, expected output, actual stdout, and stderr).\n
+* Use this tool for stdin/stdout programs. For a method of a `Solution` class, write your own harness instead.\n
+* Each case runs in a separate process with a per-case time limit, so a slow or hanging case does not block the others.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to run."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each test case has an 'input' (stdin) and an 'expected_output' (expected stdout).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Expected text the program writes to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Per-case time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def truncate_field(text, max_chars=MAX_FIELD_CHARS):
+    """Keep the head of long text and mark how much was clipped."""
+    if text is None:
+        return ""
+    if len(text) <= max_chars:
+        return text
+    return text[:max_chars] + f"\n... <{len(text) - max_chars} chars clipped>"
+
+
+def normalize_output(text):
+    """Strip trailing spaces on each line and drop trailing blank lines."""
+    lines = [line.rstrip() for line in (text or "").splitlines()]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def run_case(solution_path, case_input, timeout_seconds):
+    """Run the solution once. Returns (status, stdout, stderr)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=case_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+        )
+    except subprocess.TimeoutExpired:
+        return "TIMEOUT", "", f"Timed out after {timeout_seconds} seconds."
+    except Exception as e:
+        return "RUNTIME ERROR", "", f"Error running command: {e}"
+
+    if proc.returncode != 0:
+        return "RUNTIME ERROR", proc.stdout, proc.stderr
+    return None, proc.stdout, proc.stderr
+
+
+def tool_function(solution_path, test_cases, timeout_seconds=None):
+    """
+    Run the solution on each test case and compare its stdout with the expected output.
+    Returns a text report. Errors are reported as strings starting with 'Error:'.
+    """
+    try:
+        if not isinstance(solution_path, str) or not os.path.isabs(solution_path):
+            return f"Error: solution_path must be an absolute path, got {solution_path}."
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file {solution_path} does not exist."
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: test_cases must be a non-empty list of objects with 'input' and 'expected_output'."
+        if timeout_seconds is None:
+            timeout_seconds = DEFAULT_TIMEOUT_SECONDS
+        if not isinstance(timeout_seconds, (int, float)) or timeout_seconds <= 0:
+            return "Error: timeout_seconds must be a positive number."
+
+        for i, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                return f"Error: test case {i} must be an object with 'input' and 'expected_output'."
+
+        report_lines = []
+        details = []
+        passed = 0
+        total = len(test_cases)
+
+        for i, case in enumerate(test_cases, start=1):
+            case_input = str(case["input"])
+            expected = str(case["expected_output"])
+            status, stdout, stderr = run_case(solution_path, case_input, timeout_seconds)
+
+            if status is None:
+                if normalize_output(stdout) == normalize_output(expected):
+                    status = "PASS"
+                else:
+                    status = "FAIL"
+
+            if status == "PASS":
+                passed += 1
+            else:
+                details.append(
+                    f"--- Case {i}: {status} ---\n"
+                    f"Input:\n{truncate_field(case_input)}\n"
+                    f"Expected output:\n{truncate_field(expected)}\n"
+                    f"Actual stdout:\n{truncate_field(stdout)}\n"
+                    f"Stderr:\n{truncate_field(stderr)}"
+                )
+            report_lines.append(f"Case {i}: {status}")
+
+        summary = f"Summary: {passed}/{total} passed."
+        report = "\n".join(report_lines) + "\n" + summary
+        if details:
+            report += "\n\n" + "\n\n".join(details)
+        return report
+
+    except Exception as e:
+        return f"Error: {str(e)}"
