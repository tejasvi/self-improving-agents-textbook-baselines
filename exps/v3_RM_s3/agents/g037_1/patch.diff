+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of very long output, marking how much was dropped."""
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    dropped = len(text) - 2 * half
+    return f"{text[:half]}\n... [{dropped} characters truncated] ...\n{text[-half:]}"
