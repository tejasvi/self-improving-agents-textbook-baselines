@@ -0,0 +1,72 @@
+import os
+import tempfile
+import pytest
+from tools.io_tester import tool_info, tool_function
+
+SOLUTION = "a, b = map(int, input().split())\nprint(a + b)\n"
+
+@pytest.fixture
+def sol_file():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "sol.py")
+        with open(p, "w") as f:
+            f.write(SOLUTION)
+        yield p
+
+def test_schema():
+    info = tool_info()
+    assert info["name"] == "io_tester"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert set(schema["required"]) == {"solution_file", "test_cases"}
+    assert "timeout" in schema["properties"]
+
+def test_all_pass(sol_file):
+    cases = [{"input": "1 2\n", "expected_output": "3\n"},
+             {"input": "10 -4", "expected_output": "6"}]
+    out = tool_function(sol_file, cases)
+    assert "Summary: 2/2" in out
+    assert "FAIL" not in out
+
+def test_wrong_answer_reported(sol_file):
+    cases = [{"input": "1 2\n", "expected_output": "3\n"},
+             {"input": "1 1\n", "expected_output": "3\n"}]
+    out = tool_function(sol_file, cases)
+    assert "Summary: 1/2" in out
+    assert "WRONG ANSWER" in out
+    assert "Test 2: FAIL" in out
+
+def test_timeout(sol_file):
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "slow.py")
+        with open(p, "w") as f:
+            f.write("import time\ntime.sleep(5)\n")
+        out = tool_function(p, [{"input": "", "expected_output": ""}], timeout=0.5)
+        assert "TIMEOUT" in out
+        assert "Summary: 0/1" in out
+
+def test_runtime_error_reported(sol_file):
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "bad.py")
+        with open(p, "w") as f:
+            f.write("raise ValueError('boom')\n")
+        out = tool_function(p, [{"input": "", "expected_output": "x"}])
+        assert "Summary: 0/1" in out
+        assert "boom" in out
+
+def test_missing_file():
+    out = tool_function("/nonexistent/sol.py", [{"input": "", "expected_output": ""}])
+    assert out.startswith("Error")
+
+def test_empty_cases(sol_file):
+    assert tool_function(sol_file, []).startswith("Error")
+
+def test_malformed_case(sol_file):
+    out = tool_function(sol_file, [{"input": "1 2"}])
+    assert "malformed" in out
+    assert "Summary: 0/1" in out
+
+def test_loaded_by_registry():
+    from tools import load_all_tools
+    names = [t["name"] for t in load_all_tools()]
+    assert "io_tester" in names
diff --git a/tools/io_tester.py b/tools/io_tester.py
