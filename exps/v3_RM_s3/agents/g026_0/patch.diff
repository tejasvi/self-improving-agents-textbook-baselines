index 0000000..523932c
--- /dev/null
+++ b/tools/io_tester.py
@@ -0,0 +1,155 @@
+import os
+import subprocess
+import sys
+import tempfile
+
+def tool_info():
+    return {
+        "name": "io_tester",
+        "description": """Run a Python solution program on given inputs and compare its standard output with expected outputs.\n
+* Each test case is run as a separate process: the solution file is executed with `python <solution_file>` and `input` is fed to its standard input.\n
+* The actual stdout is compared with `expected_output` after stripping trailing whitespace on each line and surrounding blank lines.\n
+* Returns a summary with PASS/FAIL per test case. For failures, the input, expected output, actual output and stderr (if any) are shown.\n
+* Use this to check a solution against the sample tests from the problem statement and against your own additional tests.\n
+* A test case that exceeds the timeout is reported as FAIL with a timeout message.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_file": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a complete program reading standard input and writing standard output)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with 'input' (string fed to stdin) and 'expected_output' (string expected on stdout).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The standard input given to the program."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The expected standard output of the program for this input."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional timeout in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_file", "test_cases"]
+        }
+    }
+
+MAX_FIELD_LENGTH = 2000
+MAX_OUTPUT_LENGTH = 20000
+
+
+def _normalize(text: str) -> list:
+    """Strip trailing whitespace on each line and surrounding blank lines."""
+    lines = [line.rstrip() for line in (text or "").replace("\r\n", "\n").split("\n")]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def _clip(text: str, limit: int = MAX_FIELD_LENGTH) -> str:
+    if text is None:
+        return ""
+    if len(text) > limit:
+        return text[:limit] + "\n<response clipped>"
+    return text
+
+
+def _run_case(solution_file: str, case_input: str, timeout: float):
+    """Run the solution once. Returns (status, stdout, stderr) where status is
+    'ok', 'timeout' or 'error'."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_file],
+            input=case_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return "ok", proc.stdout, proc.stderr
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return "timeout", out, err
+    except Exception as e:
+        return "error", "", f"{type(e).__name__}: {e}"
+
+
+def tool_function(solution_file: str, test_cases: list, timeout: float = 10) -> str:
+    """
+    Run solution_file on every test case and compare stdout with expected_output.
+    """
+    try:
+        if not solution_file or not os.path.isfile(solution_file):
+            return f"Error: solution file not found: {solution_file}"
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: `test_cases` must be a non-empty list of objects with 'input' and 'expected_output'."
+        try:
+            timeout = float(timeout) if timeout is not None else 10.0
+        except (TypeError, ValueError):
+            return f"Error: invalid timeout value: {timeout}"
+        if timeout <= 0:
+            return "Error: timeout must be positive."
+
+        # Run from the solution's directory so relative file access behaves as expected.
+        abs_solution = os.path.abspath(solution_file)
+        cwd = os.path.dirname(abs_solution)
+
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Test {idx}: FAIL (malformed test case; needs 'input' and 'expected_output')")
+                continue
+            case_input = case["input"] if case["input"] is not None else ""
+            expected = case["expected_output"] if case["expected_output"] is not None else ""
+            cwd_orig = os.getcwd()
+            try:
+                os.chdir(cwd)
+                status, stdout, stderr = _run_case(abs_solution, case_input, timeout)
+            finally:
+                os.chdir(cwd_orig)
+
+            if status == "ok" and _normalize(stdout) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+                continue
+
+            if status == "timeout":
+                reason = f"TIMEOUT after {timeout} seconds"
+            elif status == "error":
+                reason = f"EXECUTION ERROR: {stderr}"
+            else:
+                reason = "WRONG ANSWER"
+            report = [
+                f"Test {idx}: FAIL ({reason})",
+                f"--- input ---\n{_clip(case_input)}",
+                f"--- expected output ---\n{_clip(expected)}",
+                f"--- actual output ---\n{_clip(stdout)}",
+            ]
+            if stderr and status != "error":
+                report.append(f"--- stderr ---\n{_clip(stderr)}")
+            reports.append("\n".join(report))
+
+        total = len(test_cases)
+        summary = f"Summary: {passed}/{total} test cases passed."
+        out = "\n\n".join(reports + [summary])
+        if len(out) > MAX_OUTPUT_LENGTH:
+            out = out[:MAX_OUTPUT_LENGTH] + "\n<response clipped>"
+        return out
+
+    except Exception as e:
+        return f"Error: {str(e)}"
