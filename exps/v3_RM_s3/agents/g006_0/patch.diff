+    def test_stdin_is_closed(self):
+        """A command reading stdin must get EOF instead of hanging."""
+        result = tool_function("read x; echo \"got=[$x]\"")
+        assert "got=[]" in result
+
+    def test_timeout_kills_command(self, monkeypatch):
+        """A command exceeding the timeout is killed and reported."""
+        monkeypatch.setattr(bash_mod, "TIMEOUT_SECONDS", 1)
+        result = tool_function("echo BEFORE_MARK; sleep 30; echo AFTER_MARK")
+        assert "BEFORE_MARK" in result
+        assert "AFTER_MARK" not in result
+        assert "timed out" in result
+
+    def test_timeout_kills_child_processes(self, monkeypatch):
+        """Background children in the same process group are killed too."""
+        monkeypatch.setattr(bash_mod, "TIMEOUT_SECONDS", 1)
+        result = tool_function("(sleep 30; echo leaked) & sleep 30")
+        assert "timed out" in result
+        assert "leaked" not in result
+
+    def test_long_output_is_clipped(self, monkeypatch):
+        """Very long output is truncated and marked."""
+        monkeypatch.setattr(bash_mod, "MAX_OUTPUT_CHARS", 1000)
+        result = tool_function("head -c 100000 /dev/zero | tr '\\0' 'x'; echo END")
+        assert CLIP_MARKER.strip() in result
+        assert "END" in result  # tail is kept
+        assert len(result) < 2 * 1000 + 200
+
