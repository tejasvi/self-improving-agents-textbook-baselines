+class TestReadClipped:
+    def _file(self, data: bytes):
+        return io.BytesIO(data)
+
+    def test_short_content_unchanged(self):
+        assert read_clipped(self._file(b"abc"), limit=10) == "abc"
+
+    def test_exact_boundary_unchanged(self):
+        data = b"a" * 20
+        assert read_clipped(self._file(data), limit=10) == data.decode()
+
+    def test_clipped_keeps_head_and_tail(self):
+        data = b"H" * 10 + b"M" * 500 + b"T" * 10
+        out = read_clipped(self._file(data), limit=10)
+        assert out == "H" * 10 + CLIP_MARKER + "T" * 10
+
+    def test_random_against_reference(self):
+        """Cross-check against a naive reference on random sizes and limits."""
+        rng = random.Random(12345)
+        for _ in range(300):
+            n = rng.randint(0, 200)
+            limit = rng.randint(1, 60)
+            data = bytes(rng.randrange(256) for _ in range(n))
+            got = read_clipped(self._file(data), limit=limit)
+            if n <= 2 * limit:
+                expected = data.decode(errors="replace")
+            else:
+                expected = (data[:limit].decode(errors="replace") + CLIP_MARKER
+                            + data[-limit:].decode(errors="replace"))
+            assert got == expected, (n, limit)
+
+    def test_bash_session_run_returns_pair(self, bash_session):
+        import asyncio
+        out, err = asyncio.run(bash_session.run("echo out; echo err >&2"))
+        assert out == "out"
+        assert err == "err"
+        assert bash_session.timed_out is False
