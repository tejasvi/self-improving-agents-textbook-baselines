+def read_clipped(f, limit=None):
+    """Read a binary temp file, keeping at most ~limit bytes from its head and tail."""
+    if limit is None:
+        limit = MAX_OUTPUT_CHARS  # read at call time so the module constant can be overridden
+    f.flush()
+    size = f.seek(0, os.SEEK_END)
+    if size <= 2 * limit:
+        f.seek(0)
+        return f.read().decode(errors='replace')
+    f.seek(0)
+    head = f.read(limit)
+    f.seek(size - limit)
+    tail = f.read(limit)
+    return head.decode(errors='replace') + CLIP_MARKER + tail.decode(errors='replace')
 
