+def truncate_text(text, max_chars=8000):
+    """
+    Shorten a long string by keeping its head and tail and dropping the middle.
+    Returns the text unchanged if it already fits within max_chars.
+    """
+    text = str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    marker = f"\n... [truncated {len(text) - max_chars} characters] ...\n"
+    keep = max(max_chars - len(marker), 0)
+    head = keep // 2
+    tail = keep - head
+    return text[:head] + marker + (text[-tail:] if tail > 0 else '')
