+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, max_chars=OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of the message list where tool results in older turns are truncated.
+    The most recent `keep_recent` messages are left untouched, and the original list is not modified.
+    """
+    cutoff = max(len(messages) - keep_recent, 0)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        new_msg = dict(msg)
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                    block = dict(block)
+                    block['content'] = truncate_text(block['content'], max_chars)
+                new_content.append(block)
+            new_msg['content'] = new_content
+        elif msg.get('type') == 'function_call_output' and isinstance(msg.get('output'), str):
+            new_msg['output'] = truncate_text(msg['output'], max_chars)
+        compacted.append(new_msg)
+    return compacted
