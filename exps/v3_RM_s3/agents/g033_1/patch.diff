+import pytest
+import tempfile
+from pathlib import Path
+from tools.io_tester import tool_function, tool_info
+
+@pytest.fixture
+def solution_file():
+    with tempfile.TemporaryDirectory() as d:
+        p = Path(d) / "sol.py"
+        p.write_text("a = int(input())\nprint(a * 2)\n")
+        yield str(p)
+
+def test_schema():
+    info = tool_info()
+    assert info["name"] == "run_io_tests"
+    assert set(info["input_schema"]["required"]) == {"file_path", "test_cases"}
+
+def test_all_pass(solution_file):
+    r = tool_function(solution_file, [{"input": "3\n", "expected_output": "6\n"}])
+    assert "1/1 test cases passed" in r
+
+def test_wrong_answer(solution_file):
+    r = tool_function(solution_file, [{"input": "3\n", "expected_output": "7"}])
+    assert "wrong answer" in r and "0/1" in r
+
+def test_runtime_error(solution_file):
+    r = tool_function(solution_file, [{"input": "x\n", "expected_output": ""}])
+    assert "runtime error" in r
+
+def test_missing_file():
+    assert "not found" in tool_function("/nonexistent/x.py", [{"input": "", "expected_output": ""}])
diff --git a/tools/io_tester.py b/tools/io_tester.py
new file mode 100644
index 0000000..5e84c31
--- /dev/null
+++ b/tools/io_tester.py
@@ -0,0 +1,137 @@
+import os
+import subprocess
+import sys
+
+MAX_DIFF_CHARS = 2000
+DEFAULT_TIMEOUT = 10.0
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python solution program on given inputs and compare its standard output with the expected outputs.\n
+* Each test case is run as a separate process: the `input` string is fed to the program's stdin and its stdout is captured.\n
+* Outputs are compared after normalizing line endings, stripping trailing whitespace on each line and ignoring leading/trailing blank lines.\n
+* The result reports PASS/FAIL (with a diff for failures), runtime errors (stderr and exit code) and timeouts for each case.\n
+* Use this tool to check a solution against sample tests or your own generated tests before finishing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file (a complete program that reads stdin and writes stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run against the solution.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text to feed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text of the program's standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional per-test timeout in seconds (default 10)."
+                }
+            },
+            "required": ["file_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> list:
+    """Normalize output for comparison: line endings, trailing spaces, outer blank lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def _truncate(text: str, limit: int = MAX_DIFF_CHARS) -> str:
+    if len(text) > limit:
+        return text[:limit] + "\n<response clipped>"
+    return text
+
+
+def _run_one(file_path: str, cwd: str, test_input: str, timeout: float):
+    """Run the program once. Returns (status, actual_stdout, detail)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, file_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "TIMEOUT", "", f"Timed out after {timeout} seconds."
+    if proc.returncode != 0:
+        return "RUNTIME_ERROR", proc.stdout, f"Exit code {proc.returncode}.\n{proc.stderr}"
+    return "OK", proc.stdout, proc.stderr
+
+
+def _diff_block(expected: str, actual: str) -> str:
+    exp_lines = _normalize(expected)
+    act_lines = _normalize(actual)
+    return _truncate(
+        "--- expected\n" + "\n".join(exp_lines) +
+        "\n+++ actual\n" + "\n".join(act_lines)
+    )
+
+
+def tool_function(file_path: str, test_cases: list, timeout: float = None) -> str:
+    """Run the solution on each test case and compare stdout with the expected output."""
+    try:
+        if not os.path.isfile(file_path):
+            return f"Error: solution file not found: {file_path}"
+        if not isinstance(test_cases, list) or not test_cases:
+            return "Error: `test_cases` must be a non-empty list of objects with 'input' and 'expected_output'."
+        try:
+            timeout = float(timeout) if timeout is not None else DEFAULT_TIMEOUT
+        except (TypeError, ValueError):
+            timeout = DEFAULT_TIMEOUT
+
+        abs_path = os.path.abspath(file_path)
+        cwd = os.path.dirname(abs_path)
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Test {idx}: ERROR (case must contain 'input' and 'expected_output')")
+                continue
+            test_input = str(case["input"])
+            expected = str(case["expected_output"])
+            status, actual, detail = _run_one(abs_path, cwd, test_input, timeout)
+
+            if status == "OK" and _normalize(actual) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+            elif status == "OK":
+                reports.append(f"Test {idx}: FAIL (wrong answer)\n{_diff_block(expected, actual)}")
+            elif status == "TIMEOUT":
+                reports.append(f"Test {idx}: FAIL (time limit exceeded)\n{detail}")
+            else:
+                reports.append(f"Test {idx}: FAIL (runtime error)\n{_truncate(detail)}")
+
+        total = len(test_cases)
+        summary = f"Result: {passed}/{total} test cases passed."
+        return summary + "\n\n" + "\n\n".join(reports)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    print(tool_function(os.path.abspath(__file__), [{"input": "", "expected_output": ""}]))
