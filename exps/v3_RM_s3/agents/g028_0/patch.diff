+def format_response_metadata(response, model=''):
+    """
+    Build a one-line summary of a model response's metadata (stop reason and
+    token usage) for the chat history. Never raises.
+    """
+    try:
+        if 'claude' in model:
+            stop_reason = getattr(response, 'stop_reason', None)
+        else:
+            stop_reason = getattr(response, 'status', None)
+            incomplete = getattr(response, 'incomplete_details', None)
+            if incomplete is not None and getattr(incomplete, 'reason', None):
+                stop_reason = f"{stop_reason} ({incomplete.reason})"
+        usage = getattr(response, 'usage', None)
+        if usage is None:
+            usage_str = "unavailable"
+        elif 'claude' in model:
+            usage_str = (f"input_tokens={getattr(usage, 'input_tokens', None)}, "
+                         f"output_tokens={getattr(usage, 'output_tokens', None)}")
+        else:
+            usage_str = (f"input_tokens={getattr(usage, 'input_tokens', None)}, "
+                         f"output_tokens={getattr(usage, 'output_tokens', None)}, "
+                         f"total_tokens={getattr(usage, 'total_tokens', None)}")
+        return f"Response metadata: stop_reason={stop_reason}, usage: {usage_str}"
+    except Exception as e:
+        return f"Response metadata: unavailable ({e})"
+
+def log_response_metadata(response, model='', logging=print):
+    """Log the stop reason and usage of a model response to the chat history."""
+    logging(format_response_metadata(response, model=model))
+
