+        # Phase 2: implementation attempts. Each failed attempt's diff and test
+        # output is fed into the next attempt so the agent can learn from it.
+        # The loop is bounded by MAX_ATTEMPTS (no unbounded loops).
+        msg_history = analysis_history
+        failed_attempts = []
+        for attempt in range(1, MAX_ATTEMPTS + 1):
+            implementation_instruction = (
+                f"{task}\n\n"
+                "Phase 2 of 2: IMPLEMENTATION.\n"
+                "Follow the plan you produced above. Make the edits to the code files now. "
+                "Implement the solution, write and run tests to verify it against the problem's examples and edge cases, "
+                "and refine the solution until the tests pass. Make sure the final code reads input and writes output "
+                "exactly as the problem requires (or implements the requested Solution method)."
+            )
+            if failed_attempts:
+                implementation_instruction += "\n\n" + build_retry_context(failed_attempts)
+
+            safe_log(f"=== Implementation attempt {attempt}/{MAX_ATTEMPTS} ===")
+            msg_history = chat_with_agent(
+                implementation_instruction, model=self.code_model, msg_history=msg_history, logging=safe_log
+            )
+
+            test_result = self.run_tests()
+            if test_result is None:
+                safe_log("No test command configured for this language; skipping test run.")
+                break
+            if test_result['returncode'] == 0:
+                safe_log(f"Tests passed on attempt {attempt}.")
+                break
+
+            safe_log(f"Tests failed on attempt {attempt} (return code {test_result['returncode']}).")
+            failed_attempts.append({
+                'attempt': attempt,
+                'diff': truncate_text(str(diff_versus_commit(self.git_tempdir, self.base_commit)), MAX_DIFF_CHARS),
+                'test_output': truncate_text(test_result['output'], MAX_TEST_OUTPUT_CHARS),
+                'returncode': test_result['returncode'],
+            })
+
+        return msg_history
+
+    def run_tests(self):
+        """
+        Run the language's test commands in git_tempdir.
+        Returns None if no test commands are configured for the language,
+        otherwise a dict with 'returncode' and 'output' (raw stdout+stderr).
+        """
+        commands = TEST_COMMANDS.get(self.language)
+        if not commands:
+            return None
+        output_parts = []
+        returncode = 0
+        for cmd in commands:
+            try:
+                proc = subprocess.run(
+                    cmd, cwd=self.git_tempdir, capture_output=True, text=True,
+                    timeout=TEST_TIMEOUT_SECONDS,
+                )
+                output_parts.append(f"$ {' '.join(cmd)}\n{proc.stdout}{proc.stderr}")
+                returncode = proc.returncode
+            except subprocess.TimeoutExpired as e:
+                out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+                output_parts.append(f"$ {' '.join(cmd)}\nTimed out after {TEST_TIMEOUT_SECONDS} seconds.\n{out}")
+                returncode = -1
+            except Exception as e:
+                output_parts.append(f"$ {' '.join(cmd)}\nError running command: {e}")
+                returncode = -1
+            if returncode != 0:
+                break
+        return {'returncode': returncode, 'output': "\n".join(output_parts)}
 
