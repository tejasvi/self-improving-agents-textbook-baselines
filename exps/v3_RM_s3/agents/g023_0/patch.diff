diff --git a/tests/test_coding_agent_retry.py b/tests/test_coding_agent_retry.py
new file mode 100644
index 0000000..8ee4cb3
--- /dev/null
+++ b/tests/test_coding_agent_retry.py
@@ -0,0 +1,141 @@
+import coding_agent
+from coding_agent import (
+    AgenticSystem,
+    build_retry_context,
+    truncate_text,
+    MAX_ATTEMPTS,
+    MAX_TEST_OUTPUT_CHARS,
+    MAX_DIFF_CHARS,
+)
+
+
+class FakeChat:
+    """Records every chat_with_agent call and returns a growing history."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, msg, model=None, msg_history=None, logging=print):
+        self.calls.append({"msg": msg, "history_len": len(msg_history or [])})
+        return list(msg_history or []) + [{"role": "assistant", "content": f"reply {len(self.calls)}"}]
+
+
+def make_system(tmp_path, monkeypatch, language="python"):
+    monkeypatch.setattr(coding_agent, "setup_logger", lambda *a, **k: None)
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+    return AgenticSystem(
+        problem_statement="double the input",
+        git_tempdir=str(tmp_path),
+        base_commit="abc",
+        chat_history_file=str(tmp_path / "log.md"),
+        language=language,
+    )
+
+
+def test_truncate_text_short_passthrough():
+    assert truncate_text("abc", 10) == "abc"
+
+
+def test_truncate_text_long_keeps_head_and_tail():
+    text = "H" * 500 + "T" * 500
+    out = truncate_text(text, 100)
+    assert len(out) < len(text)
+    assert out.startswith("H")
+    assert out.endswith("T")
+    assert "clipped" in out
+
+
+def test_build_retry_context_contains_all_attempts():
+    attempts = [
+        {"attempt": 1, "diff": "DIFF_ONE", "test_output": "FAIL_ONE", "returncode": 1},
+        {"attempt": 2, "diff": "", "test_output": "", "returncode": 2},
+    ]
+    ctx = build_retry_context(attempts)
+    assert "Failed attempt 1" in ctx and "DIFF_ONE" in ctx and "FAIL_ONE" in ctx
+    assert "Failed attempt 2" in ctx
+    assert "(empty diff)" in ctx and "(no output)" in ctx
+
+
+def test_passes_first_try_single_impl_call(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch)
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    monkeypatch.setattr(sys_, "run_tests", lambda: {"returncode": 0, "output": "ok"})
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "")
+    sys_.forward()
+    # 1 analysis call + 1 implementation call
+    assert len(fake.calls) == 2
+    assert "Failed attempt" not in fake.calls[1]["msg"]
+
+
+def test_retries_bounded_and_include_previous_failures(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch)
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    monkeypatch.setattr(sys_, "run_tests", lambda: {"returncode": 1, "output": "AssertionError XYZ"})
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "DIFF_MARK")
+    sys_.forward()
+    # 1 analysis + MAX_ATTEMPTS implementation calls, never more
+    assert len(fake.calls) == 1 + MAX_ATTEMPTS
+    # first impl attempt has no failure context
+    assert "Failed attempt" not in fake.calls[1]["msg"]
+    # later attempts see earlier diffs and test output
+    last = fake.calls[-1]["msg"]
+    assert "Failed attempt 1" in last and "AssertionError XYZ" in last and "DIFF_MARK" in last
+    assert f"Failed attempt {MAX_ATTEMPTS - 1}" in last
+    # history grows with each call (context carried forward)
+    lens = [c["history_len"] for c in fake.calls]
+    assert lens == sorted(lens) and lens[-1] > lens[0]
+
+
+def test_stops_when_tests_pass_on_retry(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch)
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    results = iter([{"returncode": 1, "output": "bad"}, {"returncode": 0, "output": "ok"}])
+    monkeypatch.setattr(sys_, "run_tests", lambda: next(results))
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "")
+    sys_.forward()
+    assert len(fake.calls) == 3  # analysis + 2 impl attempts
+
+
+def test_no_test_command_skips_retries(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch, language="brainfuck")
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "")
+    sys_.forward()
+    assert len(fake.calls) == 2  # analysis + one impl, no test-driven retries
+
+
+def test_run_tests_reports_failure_output(tmp_path, monkeypatch):
+    (tmp_path / "test_fail.py").write_text("def test_x():\n    assert 1 == 2\n")
+    sys_ = make_system(tmp_path, monkeypatch)
+    res = sys_.run_tests()
+    assert res["returncode"] != 0
+    assert "assert 1 == 2" in res["output"] or "AssertionError" in res["output"]
+
+
+def test_run_tests_passing(tmp_path, monkeypatch):
+    (tmp_path / "test_ok.py").write_text("def test_x():\n    assert True\n")
+    sys_ = make_system(tmp_path, monkeypatch)
+    res = sys_.run_tests()
+    assert res["returncode"] == 0
+
+
+def test_run_tests_unknown_language_returns_none(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch, language="nope")
+    assert sys_.run_tests() is None
+
+
+def test_huge_output_is_bounded(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch)
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    monkeypatch.setattr(sys_, "run_tests", lambda: {"returncode": 1, "output": "x" * 200000})
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "d" * 200000)
+    sys_.forward()
+    last = fake.calls[-1]["msg"]
+    per_attempt_cap = MAX_TEST_OUTPUT_CHARS + MAX_DIFF_CHARS + 500
+    assert len(last) < (MAX_ATTEMPTS - 1) * per_attempt_cap + 5000
+    assert "chars clipped" in last
