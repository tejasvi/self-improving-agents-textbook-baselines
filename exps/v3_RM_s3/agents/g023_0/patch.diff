+def truncate_text(text, max_chars):
+    """Keep the head and tail of long text, with a marker in between."""
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    return text[:half] + f"\n... <{len(text) - max_chars} chars clipped> ...\n" + text[-half:]
+
+def build_retry_context(failed_attempts):
+    """Summarize previous failed attempts (diff + raw test output) for the next retry."""
+    parts = [
+        "Previous attempts FAILED the tests. Review them below, then fix the code. "
+        "Do not repeat the same mistakes; analyze the test output carefully."
+    ]
+    for a in failed_attempts:
+        parts.append(
+            f"## Failed attempt {a['attempt']} (test return code {a['returncode']})\n"
+            f"### Diff produced in that attempt\n{a['diff'] or '(empty diff)'}\n"
+            f"### Test output\n{a['test_output'] or '(no output)'}"
+        )
+    return "\n\n".join(parts)
+
