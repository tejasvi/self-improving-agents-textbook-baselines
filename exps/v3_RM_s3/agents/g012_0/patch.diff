diff --git a/tools/run_io_tests.py b/tools/run_io_tests.py
new file mode 100644
index 0000000..0975838
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,116 @@
+import os
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10  # seconds per test case
+MAX_OUTPUT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python program on given test cases and compare its standard output with the expected output.\n
+* Each test case's `input` is fed to the program via standard input; its stdout is compared with `expected_output`.\n
+* Comparison ignores trailing whitespace on each line and trailing blank lines; otherwise it is exact.\n
+* Each test case runs in a separate subprocess with a time limit of 10 seconds.\n
+* The result reports PASS/FAIL per test case, and for failures shows the actual output, stderr, exit code or timeout status.\n
+* Use this to check the solution file against the sample tests from the problem statement and against your own additional tests (e.g. edge cases and random small cases compared with a brute-force reference).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python program (solution file) to run."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run against the program.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact text expected on the program's standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    """Strip trailing whitespace on each line and trailing blank lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def _truncate(text: str) -> str:
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+
+def _run_case(solution_path: str, cwd: str, test_input: str, timeout: float):
+    """Returns (status, stdout, stderr, returncode); status in {'ok', 'timeout', 'error'}."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", "", "", None
+    except Exception as e:
+        return "error", "", str(e), None
+    return "ok", proc.stdout or "", proc.stderr or "", proc.returncode
+
+
+def tool_function(solution_path: str, test_cases: list) -> str:
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file {solution_path} does not exist."
+    if not test_cases:
+        return "Error: no test cases provided."
+
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    timeout = DEFAULT_TIMEOUT
+    passed = 0
+    reports = []
+    for idx, case in enumerate(test_cases, 1):
+        test_input = case.get("input", "")
+        expected = case.get("expected_output", "")
+        status, stdout, stderr, returncode = _run_case(solution_path, cwd, test_input, timeout)
+
+        if status == "timeout":
+            reports.append(f"Test {idx}: FAIL (timed out after {timeout}s)")
+            continue
+        if status == "error":
+            reports.append(f"Test {idx}: FAIL (could not run program: {stderr})")
+            continue
+        if returncode == 0 and _normalize(stdout) == _normalize(expected):
+            passed += 1
+            reports.append(f"Test {idx}: PASS")
+            continue
+
+        report = [f"Test {idx}: FAIL (exit code {returncode})"]
+        report.append(f"--- input ---\n{_truncate(test_input)}")
+        report.append(f"--- expected output ---\n{_truncate(_normalize(expected))}")
+        report.append(f"--- actual output ---\n{_truncate(_normalize(stdout))}")
+        if stderr.strip():
+            report.append(f"--- stderr ---\n{_truncate(stderr)}")
+        reports.append("\n".join(report))
+
+    summary = f"{passed}/{len(test_cases)} test cases passed."
+    return "\n\n".join(reports) + "\n\n" + summary
