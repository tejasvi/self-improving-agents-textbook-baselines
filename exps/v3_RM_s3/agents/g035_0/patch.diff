+import os
+import subprocess
+
+import pytest
+
+import coding_agent
+from coding_agent import AgenticSystem, parse_verdict, last_assistant_text, MAX_ATTEMPTS
+
+
+def test_parse_verdict_pass_fail_missing():
+    assert parse_verdict("ok\nEXAMPLES: PASS") is True
+    assert parse_verdict("ok\nEXAMPLES: FAIL") is False
+    assert parse_verdict("no marker here") is False
+    # Last marker wins
+    assert parse_verdict("EXAMPLES: PASS\nactually\nEXAMPLES: FAIL") is False
+
+
+def test_last_assistant_text_handles_blocks_and_strings():
+    hist = [
+        {"role": "user", "content": [{"type": "text", "text": "q"}]},
+        {"role": "assistant", "content": [{"type": "text", "text": "first"}]},
+        {"role": "user", "content": "more"},
+        {"role": "assistant", "content": [{"type": "text", "text": "EXAMPLES: PASS"}]},
+    ]
+    assert last_assistant_text(hist) == "EXAMPLES: PASS"
+    assert last_assistant_text([]) == ""
+    assert last_assistant_text([{"role": "assistant", "content": "plain"}]) == "plain"
+
+
+@pytest.fixture
+def system(tmp_path, monkeypatch):
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+    s = AgenticSystem("problem", str(tmp_path), "base", chat_history_file=str(tmp_path / "h.md"))
+    return s
+
+
+def _fake_run(outcomes, calls, patches):
+    """outcomes: list of bool verdicts per attempt; patches: patch text per attempt."""
+    def fake(self, attempt_idx):
+        calls.append(attempt_idx)
+        return patches[attempt_idx], outcomes[attempt_idx]
+    return fake
+
+
+def test_stops_at_first_passing_attempt(system, monkeypatch):
+    calls, resets, applied = [], [], []
+    monkeypatch.setattr(AgenticSystem, "_run_attempt", _fake_run([False, True, False], calls, ["p1", "p2", "p3"]))
+    monkeypatch.setattr(coding_agent, "reset_to_commit", lambda d, c: resets.append(d))
+    monkeypatch.setattr(coding_agent, "apply_patch", lambda d, p: applied.append(p))
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda d, c: "other")
+    res = system.forward()
+    assert calls == [0, 1]
+    assert res == {'attempt': 2, 'passed': True, 'patch': 'p2'}
+    assert len(resets) >= 2  # reset before each attempt
+    assert applied == ['p2']
+
+
+def test_all_fail_picks_last_nonempty(system, monkeypatch):
+    calls = []
+    monkeypatch.setattr(AgenticSystem, "_run_attempt", _fake_run([False] * 3, calls, ["a", "", "c"]))
+    monkeypatch.setattr(coding_agent, "reset_to_commit", lambda d, c: None)
+    monkeypatch.setattr(coding_agent, "apply_patch", lambda d, p: None)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda d, c: "c")
+    res = system.forward()
+    assert calls == [0, 1, 2]
+    assert len(calls) == MAX_ATTEMPTS
+    assert res['passed'] is False and res['patch'] == 'c' and res['attempt'] == 3
+
+
+def test_exception_in_attempt_is_isolated(system, monkeypatch):
+    def fake(self, idx):
+        if idx == 0:
+            raise RuntimeError("boom")
+        return "ok-patch", True
+    monkeypatch.setattr(AgenticSystem, "_run_attempt", fake)
+    monkeypatch.setattr(coding_agent, "reset_to_commit", lambda d, c: None)
+    monkeypatch.setattr(coding_agent, "apply_patch", lambda d, p: None)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda d, c: "")
+    res = system.forward()
+    assert res == {'attempt': 2, 'passed': True, 'patch': 'ok-patch'}
+
+
+def test_all_empty_failures_return_last_attempt(system, monkeypatch):
+    monkeypatch.setattr(AgenticSystem, "_run_attempt", _fake_run([False] * 3, [], ["", "", ""]))
+    monkeypatch.setattr(coding_agent, "reset_to_commit", lambda d, c: None)
+    monkeypatch.setattr(coding_agent, "apply_patch", lambda d, p: None)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda d, c: "")
+    res = system.forward()
+    assert res['attempt'] == 3 and res['passed'] is False and res['patch'] == ''
