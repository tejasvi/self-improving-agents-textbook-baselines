+# ---- Brute-force cross-check on a real git repo (scratch files only, not part of the patch) ----
+
+def _git(d, *args):
+    subprocess.run(["git", "-C", str(d), *args], check=True, capture_output=True)
+
+
+def test_end_to_end_real_git_keeps_passing_attempt(tmp_path, monkeypatch):
+    """Real git repo: attempt 1 writes a wrong solution, attempt 2 writes the right one.
+    The final working tree must contain the passing attempt's solution."""
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    _git(repo, "config", "user.email", "t@t")
+    _git(repo, "config", "user.name", "t")
+    (repo / "sol.py").write_text("print(0)\n")
+    _git(repo, "add", ".")
+    _git(repo, "commit", "-qm", "base")
+    base = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
+
+    wrong = "print(1)\n"
+    right = "a, b = map(int, input().split())\nprint(a + b)\n"
+    counter = {"n": 0}
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        if "Verification step" in msg:
+            counter["n"] += 0  # verification handled below
+            text = "EXAMPLES: PASS" if open(repo / "sol.py").read() == right else "EXAMPLES: FAIL"
+            return (msg_history or []) + [{"role": "assistant", "content": [{"type": "text", "text": text}]}]
+        if "Phase 1 of 2" in msg:
+            return [{"role": "assistant", "content": [{"type": "text", "text": "plan"}]}]
+        # Phase 2: edit. Attempt 1 writes wrong code, attempt 2 right code.
+        counter["n"] += 1
+        content = wrong if counter["n"] == 1 else right
+        (repo / "sol.py").write_text(content)
+        return (msg_history or []) + [{"role": "assistant", "content": [{"type": "text", "text": "done"}]}]
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    s = AgenticSystem("add two ints", str(repo), base, chat_history_file=str(tmp_path / "h.md"))
+    res = s.forward()
+    assert res['passed'] is True and res['attempt'] == 2
+    assert (repo / "sol.py").read_text() == right
+    assert "sol.py" in res['patch']
+
+
+def test_bruteforce_crosscheck_parse_verdict():
+    """Naive reference (scan all marker occurrences) vs. parse_verdict on seeded random texts."""
+    import random
+    rng = random.Random(2024)
+    pieces = ["EXAMPLES: PASS", "EXAMPLES: FAIL", "EXAMPLES:", " PASS", " FAIL", "\n", "x", "ok "]
+
+    def brute(text):
+        last_pass = max((i for i in range(len(text)) if text.startswith("EXAMPLES: PASS", i)), default=-1)
+        last_fail = max((i for i in range(len(text)) if text.startswith("EXAMPLES: FAIL", i)), default=-1)
+        return last_pass > last_fail
+
+    for _ in range(500):
+        text = "".join(rng.choice(pieces) for _ in range(rng.randint(0, 12)))
+        assert parse_verdict(text) == brute(text), repr(text)
