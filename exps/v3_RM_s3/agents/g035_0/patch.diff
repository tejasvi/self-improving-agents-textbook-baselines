+def last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in a message history ('' if none).
+    Handles both plain-string content and lists of content blocks.
+    """
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            texts = [b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text']
+            return '\n'.join(t for t in texts if t)
+        return ''
+    return ''
+
+def parse_verdict(text):
+    """
+    Return True if the last PASS/FAIL marker in `text` is PASS, False otherwise.
+    A missing marker counts as a failure.
+    """
+    pass_idx = text.rfind(PASS_MARKER)
+    fail_idx = text.rfind(FAIL_MARKER)
+    return pass_idx > fail_idx
