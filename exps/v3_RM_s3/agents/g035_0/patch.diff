+    def forward(self):
+        """
+        The forward function for the AgenticSystem.
+        Runs up to MAX_ATTEMPTS independent attempts from the base commit, stops at the first attempt whose
+        solution passes the problem's examples, and leaves that attempt's patch in the repository.
+        Returns a dict with the chosen attempt index, whether it passed, and its patch.
+        """
+        attempts = []  # list of (patch, passed)
+        for attempt_idx in range(MAX_ATTEMPTS):
+            reset_to_commit(self.git_tempdir, self.base_commit)
+            try:
+                patch, passed = self._run_attempt(attempt_idx)
+            except Exception as e:
+                safe_log(f"Attempt {attempt_idx + 1} raised an error: {e}")
+                attempts.append(('', False))
+                continue
+            attempts.append((patch, passed))
+            if passed:
+                break
+
+        # Choose the first passing attempt; otherwise the last attempt that produced edits.
+        chosen_idx = next((i for i, (_, ok) in enumerate(attempts) if ok), None)
+        if chosen_idx is None:
+            non_empty = [i for i, (p, _) in enumerate(attempts) if p.strip()]
+            chosen_idx = non_empty[-1] if non_empty else len(attempts) - 1
+        chosen_patch, chosen_passed = attempts[chosen_idx]
+        safe_log(f"Selected attempt {chosen_idx + 1} (passed={chosen_passed})")
+
+        # Restore the chosen attempt's state in the repository.
+        current_patch = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        if current_patch.strip() != chosen_patch.strip():
+            reset_to_commit(self.git_tempdir, self.base_commit)
+            if chosen_patch.strip():
+                apply_patch(self.git_tempdir, chosen_patch)
+
+        return {'attempt': chosen_idx + 1, 'passed': chosen_passed, 'patch': chosen_patch}
+
