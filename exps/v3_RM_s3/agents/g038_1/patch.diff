+def test_prompts_state_deliverable_and_retry_context(tmp_path, monkeypatch):
+    sys_ = make_system(tmp_path, monkeypatch)
+    fake = FakeChat()
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    results = iter([{"returncode": 1, "output": "BOOM"}, {"returncode": 0, "output": "ok"}])
+    monkeypatch.setattr(sys_, "run_tests", lambda: next(results))
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", lambda *a: "")
+    sys_.forward()
+    analysis, impl1, impl2 = (c["msg"] for c in fake.calls)
+    assert "Do NOT modify any files" in analysis and "Finish with the plan only." in analysis
+    assert "final solution file" in analysis and "double the input" in analysis
+    assert "Phase 2 of 2" in impl1 and "final solution file" in impl1
+    assert "Failed attempt" not in impl1
+    assert "Failed attempt 1" in impl2 and "BOOM" in impl2
