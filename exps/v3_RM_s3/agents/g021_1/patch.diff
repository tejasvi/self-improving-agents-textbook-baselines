--- a/llm_withtools.py
+++ b/llm_withtools.py
@@ -22,6 +22,40 @@ def process_tool_call(tools_dict, tool_name, tool_input):
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def log_response_metadata(response, model='', logging=print):
+    """
+    Log the metadata (stop reason and token usage) of a model response to the chat history.
+    Works for Claude (Messages API) and OpenAI (Responses API) responses; missing fields are logged as None.
+    """
+    try:
+        if 'claude' in model:
+            stop_reason = getattr(response, 'stop_reason', None)
+        elif model.startswith('o3-'):
+            stop_reason = getattr(response, 'status', None)
+            incomplete = getattr(response, 'incomplete_details', None)
+            if incomplete is not None and getattr(incomplete, 'reason', None):
+                stop_reason = f"{stop_reason} ({incomplete.reason})"
+        else:
+            stop_reason = None
+
+        usage = getattr(response, 'usage', None)
+        if usage is None:
+            usage_str = 'None'
+        elif 'claude' in model:
+            usage_str = (
+                f"input_tokens={getattr(usage, 'input_tokens', None)}, "
+                f"output_tokens={getattr(usage, 'output_tokens', None)}"
+            )
+        else:
+            usage_str = (
+                f"input_tokens={getattr(usage, 'input_tokens', None)}, "
+                f"output_tokens={getattr(usage, 'output_tokens', None)}, "
+                f"total_tokens={getattr(usage, 'total_tokens', None)}"
+            )
+        logging(f"\n[Response metadata] stop_reason={stop_reason}, usage: {usage_str}")
+    except Exception as e:
+        logging(f"Failed to log response metadata: {str(e)}")
+
 @backoff.on_exception(
     backoff.expo,
     (openai.RateLimitError, openai.APITimeoutError, anthropic.RateLimitError, anthropic.APIStatusError),
