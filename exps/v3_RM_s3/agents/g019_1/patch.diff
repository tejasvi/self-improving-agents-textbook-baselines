--- /dev/null
+++ b/tests/test_llm_retry.py
@@ -0,0 +1,100 @@
+import sys, os
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from unittest import mock
+import httpx, openai, anthropic
+import llm, llm_withtools
+
+def oai_err(cls, code):
+    req = httpx.Request("POST", "https://x")
+    resp = httpx.Response(code, request=req)
+    return cls(message="boom", response=resp, body=None)
+
+def test_transient_then_success():
+    calls = {"n": 0}
+    def f():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise oai_err(openai.RateLimitError, 429)
+        return "ok"
+    with mock.patch.object(llm.time, "sleep") as sl:
+        assert llm.call_with_retries(f, logging=lambda m: None) == "ok"
+    assert calls["n"] == 3 and sl.call_count == 2
+
+def test_permanent_not_retried():
+    calls = {"n": 0}
+    def f():
+        calls["n"] += 1
+        raise oai_err(openai.BadRequestError, 400)
+    with mock.patch.object(llm.time, "sleep") as sl:
+        try:
+            llm.call_with_retries(f, logging=lambda m: None)
+            assert False
+        except openai.BadRequestError:
+            pass
+    assert calls["n"] == 1 and sl.call_count == 0
+
+def test_anthropic_400_not_retried_but_500_is():
+    req = httpx.Request("POST", "https://x")
+    e400 = anthropic.APIStatusError("bad", response=httpx.Response(400, request=req), body=None)
+    e500 = anthropic.InternalServerError("srv", response=httpx.Response(500, request=req), body=None)
+    assert not llm.is_transient_api_error(e400)
+    assert llm.is_transient_api_error(e500)
+
+def test_bounded_retries():
+    calls = {"n": 0}
+    def f():
+        calls["n"] += 1
+        raise oai_err(openai.APITimeoutError, 504) if False else oai_err(openai.RateLimitError, 429)
+    with mock.patch.object(llm.time, "sleep"):
+        try:
+            llm.call_with_retries(f, max_retries=4, logging=None)
+            assert False
+        except openai.RateLimitError:
+            pass
+    assert calls["n"] == 5
+
+def test_withtools_none_logger_no_crash_and_retries():
+    calls = {"n": 0}
+    class C:
+        class messages:
+            @staticmethod
+            def create(**kw):
+                calls["n"] += 1
+                if calls["n"] < 2:
+                    raise anthropic.APIConnectionError(request=httpx.Request("POST", "https://x"))
+                return "resp"
+    with mock.patch.object(llm.time, "sleep"):
+        out = llm_withtools.get_response_withtools(C(), "claude-3-5-sonnet-20241022", [], [], None)
+    assert out == "resp" and calls["n"] == 2
+
+def test_withtools_permanent_raises_immediately():
+    calls = {"n": 0}
+    class C:
+        class messages:
+            @staticmethod
+            def create(**kw):
+                calls["n"] += 1
+                raise anthropic.BadRequestError("bad", response=httpx.Response(400, request=httpx.Request("POST","https://x")), body=None)
+    with mock.patch.object(llm.time, "sleep") as sl:
+        try:
+            llm_withtools.get_response_withtools(C(), "claude-3-5-sonnet-20241022", [], [], None)
+            assert False
+        except anthropic.BadRequestError:
+            pass
+    assert calls["n"] == 1 and sl.call_count == 0
+
+def test_get_response_from_llm_retries_claude():
+    calls = {"n": 0}
+    class Block: text = "hi"
+    class R: content = [Block()]
+    class C:
+        class messages:
+            @staticmethod
+            def create(**kw):
+                calls["n"] += 1
+                if calls["n"] == 1:
+                    raise anthropic.RateLimitError("rl", response=httpx.Response(429, request=httpx.Request("POST","https://x")), body=None)
+                return R()
+    with mock.patch.object(llm.time, "sleep"):
+        out, hist = llm.get_response_from_llm("m", C(), "claude-3-5-sonnet-20241022", "sys")
+    assert out == "hi" and calls["n"] == 2
