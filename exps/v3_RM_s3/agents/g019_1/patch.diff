 MAX_OUTPUT_TOKENS = 4096
+
+# Retry policy for model API calls.
+MAX_API_RETRIES = 5
+API_RETRY_BASE_DELAY = 1.0   # seconds
+API_RETRY_MAX_DELAY = 60.0   # seconds
+
+_TRANSIENT_ERROR_TYPES = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+_TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+
+def is_transient_api_error(exc):
+    """
+    Return True if the exception is a transient API failure that is worth retrying
+    (rate limits, timeouts, connection problems, 5xx server errors, overloads).
+    Permanent client errors (e.g. 400, 401, 403, 404) return False.
+    """
+    if isinstance(exc, _TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(exc, "status_code", None)
+    if isinstance(status, int) and (status in _TRANSIENT_STATUS_CODES or status >= 500):
+        return True
+    return False
+
+
+def call_with_retries(fn, *args, max_retries=MAX_API_RETRIES,
+                      base_delay=API_RETRY_BASE_DELAY, max_delay=API_RETRY_MAX_DELAY,
+                      logging=None, **kwargs):
+    """
+    Call fn(*args, **kwargs), retrying transient API failures with capped
+    exponential backoff and jitter. Non-transient errors are raised immediately,
+    and so is the last transient error once max_retries retries are exhausted.
+    """
+    log = logging if logging is not None else print
+    for attempt in range(max_retries + 1):
+        try:
+            return fn(*args, **kwargs)
+        except Exception as e:
+            if attempt >= max_retries or not is_transient_api_error(e):
+                raise
+            delay = min(max_delay, base_delay * (2 ** attempt))
+            delay *= random.uniform(0.5, 1.0)  # jitter
+            log(f"Transient API error ({type(e).__name__}: {e}); "
+                f"retry {attempt + 1}/{max_retries} in {delay:.1f}s")
+            time.sleep(delay)
+    # Unreachable: the loop always returns or raises.
+    raise RuntimeError("call_with_retries: retry loop exited unexpectedly")
+
