     "deepseek-reasoner",
 ]
 
+MAX_API_RETRIES = 6  # total attempts per API call (1 initial + retries)
+MAX_BACKOFF_SECONDS = 60
+
+_TRANSIENT_ERROR_TYPES = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+)
+_TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+
+def is_transient_api_error(e: Exception) -> bool:
+    """Return True if the exception is a transient API failure worth retrying
+    (rate limits, timeouts, connection errors, 408/409/429 and 5xx responses)."""
+    if isinstance(e, _TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(e, "status_code", None)
+    if isinstance(status, int):
+        return status in _TRANSIENT_STATUS_CODES or status >= 500
+    return False
+
+
+def api_retry(func):
+    """Decorator: retry an LLM API call on transient failures with exponential
+    backoff and full jitter. Non-transient errors are raised immediately."""
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        giveup=lambda e: not is_transient_api_error(e),
+        max_tries=MAX_API_RETRIES,
+        max_value=MAX_BACKOFF_SECONDS,
+        jitter=backoff.full_jitter,
+    )(func)
+
