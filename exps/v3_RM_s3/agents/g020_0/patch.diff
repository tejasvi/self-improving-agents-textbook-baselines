@@ -0,0 +1,106 @@
+import httpx
+import openai
+import pytest
+
+from utils import retry as retry_mod
+from utils.retry import is_transient, retry_api_call
+import llm
+
+
+def _resp(status):
+    return httpx.Response(status, request=httpx.Request("POST", "http://x"))
+
+
+def _rate_limit():
+    return openai.RateLimitError("rate", response=_resp(429), body=None)
+
+
+def _bad_request():
+    return openai.BadRequestError("bad", response=_resp(400), body=None)
+
+
+@pytest.fixture(autouse=True)
+def no_sleep(monkeypatch):
+    # Keep backoff waits at zero so tests are fast and deterministic.
+    monkeypatch.setattr("backoff._sync.time.sleep", lambda s: None)
+
+
+def test_is_transient_classification():
+    assert is_transient(_rate_limit())
+    assert is_transient(openai.APIConnectionError(request=httpx.Request("GET", "http://x")))
+    assert not is_transient(_bad_request())
+    assert not is_transient(ValueError("x"))
+
+    class Fake(Exception):
+        status_code = 503
+    assert is_transient(Fake())
+
+    class Odd(Exception):
+        status_code = "503"  # non-int status must not be treated as transient
+    assert not is_transient(Odd())
+
+
+def test_transient_then_success_returns_value():
+    calls = []
+
+    @retry_api_call(max_tries=3, max_time=10, max_value=0.01)
+    def f():
+        calls.append(1)
+        if len(calls) < 2:
+            raise _rate_limit()
+        return "ok"
+
+    assert f() == "ok"
+    assert len(calls) == 2
+
+
+def test_transient_exhausts_tries_and_reraises():
+    calls = []
+
+    @retry_api_call(max_tries=4, max_time=10, max_value=0.01)
+    def f():
+        calls.append(1)
+        raise _rate_limit()
+
+    with pytest.raises(openai.RateLimitError):
+        f()
+    assert len(calls) == 4
+
+
+@pytest.mark.parametrize("exc", [_bad_request(), ValueError("boom")])
+def test_non_transient_not_retried(exc):
+    calls = []
+
+    @retry_api_call(max_tries=5, max_time=10, max_value=0.01)
+    def f():
+        calls.append(1)
+        raise exc
+
+    with pytest.raises(type(exc)):
+        f()
+    assert len(calls) == 1
+
+
+def test_max_tries_one_no_retry():
+    calls = []
+
+    @retry_api_call(max_tries=1, max_time=10, max_value=0.01)
+    def f():
+        calls.append(1)
+        raise _rate_limit()
+
+    with pytest.raises(openai.RateLimitError):
+        f()
+    assert len(calls) == 1
+
+
+def test_create_client_llama_returns_tuple(monkeypatch):
+    monkeypatch.setenv("OPENROUTER_API_KEY", "k")
+    client, model = llm.create_client("llama3.1-405b")
+    assert model == "llama3.1-405b"
+    assert client is not None
+
+
+def test_unsupported_model_raises_once():
+    with pytest.raises(ValueError):
+        llm.get_response_from_llm("hi", None, "not-a-model", "sys")
