diff --git a/utils/retry.py b/utils/retry.py
new file mode 100644
index 0000000..2c5b09a
--- /dev/null
+++ b/utils/retry.py
@@ -0,0 +1,81 @@
+"""
+Retry helpers for model API calls.
+
+Transient failures (rate limits, timeouts, connection drops, 5xx/overloaded
+responses) are retried with exponential backoff and full jitter, up to a
+bounded number of attempts and a bounded total time. Non-transient failures
+(bad request, auth, not found, programming errors) are raised immediately.
+"""
+import logging
+
+import anthropic
+import backoff
+import openai
+
+API_MAX_TRIES = 5
+API_MAX_TIME = 300  # seconds, total budget across all attempts
+API_MAX_BACKOFF = 60  # seconds, cap for a single wait
+
+TRANSIENT_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+
+# HTTP statuses that indicate a retryable condition.
+TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+_logger = logging.getLogger(__name__)
+
+
+def is_transient(exc):
+    """Return True if the exception looks like a transient API failure."""
+    if isinstance(exc, TRANSIENT_ERRORS):
+        return True
+    status = getattr(exc, "status_code", None)
+    if isinstance(status, int):
+        return status in TRANSIENT_STATUS_CODES or 500 <= status <= 599
+    return False
+
+
+def _log_backoff(details):
+    _logger.warning(
+        "Transient API error on attempt %s, retrying in %.1fs: %s",
+        details.get("tries"),
+        details.get("wait", 0.0),
+        details.get("exception"),
+    )
+
+
+def _log_giveup(details):
+    _logger.error(
+        "API call failed after %s attempt(s): %s",
+        details.get("tries"),
+        details.get("exception"),
+    )
+
+
+def retry_api_call(max_tries=API_MAX_TRIES, max_time=API_MAX_TIME, max_value=API_MAX_BACKOFF):
+    """
+    Decorator: retry transient model API failures with exponential backoff.
+
+    Attempts are bounded by `max_tries` and `max_time`. Non-transient errors
+    are not retried. The final exception is re-raised once retries are exhausted.
+    """
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        max_tries=max_tries,
+        max_time=max_time,
+        max_value=max_value,
+        jitter=backoff.full_jitter,
+        giveup=lambda e: not is_transient(e),
+        on_backoff=_log_backoff,
+        on_giveup=_log_giveup,
+        raise_on_giveup=True,
+    )
