+
+# Context-size control
+MAX_TOOL_RESULT_CHARS = 10000   # max chars kept from a freshly produced tool result
+MAX_OLD_RESULT_CHARS = 1000     # max chars kept from a tool result once it is an old turn
+KEEP_RECENT_MESSAGES = 6        # the most recent messages are never compacted
+
+def truncate_text(text, max_chars=MAX_TOOL_RESULT_CHARS):
+    """
+    Keep the head and tail of a long string, dropping the middle.
+    Returns the text unchanged if it is short enough.
+    """
+    text = text if isinstance(text, str) else str(text)
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n<... {omitted} characters truncated ...>\n{text[-half:]}"
+
+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, old_max_chars=MAX_OLD_RESULT_CHARS):
+    """
+    Return a copy of `messages` for sending to the model where old tool results
+    (older than the last `keep_recent` messages) are truncated. The originals are not modified.
+    Supports Claude tool_result blocks and OpenAI function_call_output items.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        if msg.get('type') == 'function_call_output':
+            new_msg = dict(msg)
+            new_msg['output'] = truncate_text(msg.get('output', ''), old_max_chars)
+            compacted.append(new_msg)
+            continue
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    block = dict(block)
+                    block['content'] = truncate_text(block.get('content', ''), old_max_chars)
+                new_content.append(block)
+            compacted.append({**msg, 'content': new_content})
+        else:
+            compacted.append(msg)
+    return compacted
+
