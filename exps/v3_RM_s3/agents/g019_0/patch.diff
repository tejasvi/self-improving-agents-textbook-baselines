+MAX_PREV_ATTEMPT_CHARS = 6000
+
+def get_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in msg_history (or '' if none).
+    Handles both plain-text blocks (dicts) and SDK content block objects.
+    """
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        parts = []
+        for block in content or []:
+            if isinstance(block, dict):
+                text = block.get('text')
+            else:
+                text = getattr(block, 'text', None)
+            if text:
+                parts.append(text)
+        if parts:
+            return "\n".join(parts)
+    return ''
+
+def truncate_text(text, limit=MAX_PREV_ATTEMPT_CHARS):
+    if text is None:
+        return ''
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... [truncated {len(text) - limit} characters]"
