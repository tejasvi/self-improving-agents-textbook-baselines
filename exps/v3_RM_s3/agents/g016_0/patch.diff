+# Context-size controls
+MAX_TOOL_OUTPUT_CHARS = 10000   # max characters of a single tool output kept in context
+MAX_HISTORY_TURN_PAIRS = 30     # max (assistant tool_use, user tool_result) pairs sent to the model
+
+def truncate_text(text, max_chars=MAX_TOOL_OUTPUT_CHARS):
+    """
+    Truncate a long string, keeping its beginning and end and noting how much was removed.
+    """
+    text = str(text)
+    if len(text) <= max_chars:
+        return text
+    head_chars = (max_chars * 2) // 3
+    tail_chars = max_chars - head_chars
+    removed = len(text) - head_chars - tail_chars
+    return (
+        text[:head_chars]
+        + f"\n... [truncated {removed} characters] ...\n"
+        + text[len(text) - tail_chars:]
+    )
+
+def trim_history(msg_history, max_pairs=MAX_HISTORY_TURN_PAIRS):
+    """
+    Keep the first message (the task) and only the most recent tool-use turn pairs.
+    Turns are assumed to be laid out as [first, assistant, user, assistant, user, ...],
+    so the kept tail always starts on an assistant message and no tool_result is orphaned.
+    Returns a new list; the input list is not modified.
+    """
+    if max_pairs is None or len(msg_history) <= 1 + 2 * max_pairs:
+        return list(msg_history)
+    start = len(msg_history) - 2 * max_pairs
+    if start % 2 == 0:
+        start += 1
+    return [msg_history[0]] + list(msg_history[start:])
+
