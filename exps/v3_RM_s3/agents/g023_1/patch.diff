diff --git a/llm_withtools.py b/llm_withtools.py
index 8e238b9..68f3b6a 100644
--- a/llm_withtools.py
+++ b/llm_withtools.py
@@ -22,6 +22,31 @@ def process_tool_call(tools_dict, tool_name, tool_input):
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def get_response_metadata(response, model=''):
+    """
+    Extracts stop reason and usage metadata from a model response.
+    Returns a human-readable string.
+    """
+    if 'claude' in model:
+        stop_reason = getattr(response, 'stop_reason', None)
+        usage = getattr(response, 'usage', None)
+        usage_info = {
+            'input_tokens': getattr(usage, 'input_tokens', None),
+            'output_tokens': getattr(usage, 'output_tokens', None),
+        } if usage is not None else None
+    else:
+        stop_reason = getattr(response, 'status', None)
+        incomplete = getattr(response, 'incomplete_details', None)
+        if incomplete is not None:
+            stop_reason = f"{stop_reason} ({getattr(incomplete, 'reason', None)})"
+        usage = getattr(response, 'usage', None)
+        usage_info = {
+            'input_tokens': getattr(usage, 'input_tokens', None),
+            'output_tokens': getattr(usage, 'output_tokens', None),
+            'total_tokens': getattr(usage, 'total_tokens', None),
+        } if usage is not None else None
+    return f"Response metadata - Stop reason: {stop_reason}, Usage: {usage_info}"
+
 @backoff.on_exception(
     backoff.expo,
     (openai.RateLimitError, openai.APITimeoutError, anthropic.RateLimitError, anthropic.APIStatusError),
@@ -52,6 +77,8 @@ def get_response_withtools(
             response = response
         else:
             raise ValueError(f"Unsupported model: {model}")
+        if logging is not None:
+            logging(get_response_metadata(response, model=model))
         return response
     except Exception as e:
         logging(f"Error in get_response_withtools: {str(e)}")
