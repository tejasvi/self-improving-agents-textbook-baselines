diff --git a/tools/run_examples.py b/tools/run_examples.py
new file mode 100644
index 0000000..f54e95c
--- /dev/null
+++ b/tools/run_examples.py
@@ -0,0 +1,146 @@
+import json
+import os
+import shlex
+import subprocess
+import time
+
+from tools.stress_test import _outputs_match
+
+MAX_FIELD_CHARS = 2000
+VALID_COMPARE = ('exact', 'tokens', 'float')
+
+
+def tool_info():
+    return {
+        "name": "run_examples",
+        "description": """Deterministically run the examples from the problem statement against a solution command.
+
+* Reads examples_file, a JSON list of {"input": str, "output": str} objects (the examples copied verbatim from the problem statement).
+* For each example, runs cmd with the example input on stdin and compares stdout with the expected output using `compare`.
+* Reports every case as PASS or FAIL, with expected output, actual output, stderr and wall time for failing cases (truncated), and ends with a line 'SUMMARY: ALL_PASS' or 'SUMMARY: FAILED k/n'.
+* cmd is parsed with shlex and run directly (no shell). Use absolute paths, e.g. 'python3 /tmp/stress/driver.py'.
+* compare: 'exact' compares lines after rstrip; 'tokens' compares whitespace-separated tokens; 'float' compares tokens, treating numeric tokens as equal within 1e-6.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "cmd": {
+                    "type": "string",
+                    "description": "Command that reads the example input from stdin and writes the answer to stdout, e.g. 'python3 /tmp/stress/driver.py'."
+                },
+                "examples_file": {
+                    "type": "string",
+                    "description": "Path to a JSON file containing a list of objects {\"input\": str, \"output\": str}."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each case (default 10)."
+                },
+                "compare": {
+                    "type": "string",
+                    "description": "Output comparison mode: 'exact', 'tokens', or 'float' (default 'tokens')."
+                }
+            },
+            "required": ["cmd", "examples_file"]
+        }
+    }
+
+
+def _trunc(text):
+    if text is None:
+        return ''
+    if isinstance(text, bytes):
+        text = text.decode('utf-8', errors='replace')
+    if len(text) > MAX_FIELD_CHARS:
+        return text[:MAX_FIELD_CHARS] + f'...[truncated {len(text) - MAX_FIELD_CHARS} chars]'
+    return text
+
+
+def _load_examples(examples_file):
+    """Return (examples, error). examples is a list of (input, output) string pairs."""
+    if not examples_file or not os.path.isfile(examples_file):
+        return None, f"ERROR: examples_file not found: {examples_file}"
+    try:
+        with open(examples_file, 'r', encoding='utf-8') as f:
+            data = json.load(f)
+    except (OSError, json.JSONDecodeError) as e:
+        return None, f"ERROR: could not read examples_file as JSON: {e}"
+    if not isinstance(data, list):
+        return None, "ERROR: examples_file must contain a JSON list."
+    examples = []
+    for i, ex in enumerate(data, start=1):
+        if not isinstance(ex, dict) or 'input' not in ex or 'output' not in ex:
+            return None, f"ERROR: example {i} must be an object with 'input' and 'output' keys."
+        if not isinstance(ex['input'], str) or not isinstance(ex['output'], str):
+            return None, f"ERROR: example {i} 'input' and 'output' must be strings."
+        examples.append((ex['input'], ex['output']))
+    if not examples:
+        return None, "ERROR: examples_file contains no examples."
+    return examples, None
+
+
+def _run_case(cmd, input_text, timeout):
+    """Returns (proc_or_None, status_note, wall_time)."""
+    start = time.monotonic()
+    try:
+        proc = subprocess.run(
+            shlex.split(cmd),
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc, None, time.monotonic() - start
+    except subprocess.TimeoutExpired:
+        return None, f'timed out after {timeout}s', time.monotonic() - start
+    except (OSError, ValueError) as e:
+        return None, f'could not run cmd: {e}', time.monotonic() - start
+
+
+def tool_function(cmd, examples_file, timeout=10, compare='tokens'):
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError) as e:
+        return f"ERROR: invalid timeout: {e}"
+    if compare not in VALID_COMPARE:
+        return f"ERROR: unknown compare mode '{compare}'. Use 'exact', 'tokens', or 'float'."
+    if not cmd:
+        return "ERROR: cmd is required."
+
+    examples, err = _load_examples(examples_file)
+    if err:
+        return err
+
+    n = len(examples)
+    failed = 0
+    lines = []
+    for idx, (inp, expected) in enumerate(examples, start=1):
+        proc, note, wall = _run_case(cmd, inp, timeout)
+        if proc is None:
+            failed += 1
+            lines.append(f"case {idx}: FAIL ({note}) wall_time={wall:.3f}s")
+            lines.append(f"input:\n{_trunc(inp)}")
+            lines.append(f"expected:\n{_trunc(expected)}")
+            continue
+        if proc.returncode != 0:
+            failed += 1
+            lines.append(f"case {idx}: FAIL (runtime error, return code {proc.returncode}) wall_time={wall:.3f}s")
+            lines.append(f"input:\n{_trunc(inp)}")
+            lines.append(f"expected:\n{_trunc(expected)}")
+            lines.append(f"actual stdout:\n{_trunc(proc.stdout)}")
+            lines.append(f"stderr:\n{_trunc(proc.stderr)}")
+            continue
+        if _outputs_match(proc.stdout, expected, compare):
+            lines.append(f"case {idx}: PASS wall_time={wall:.3f}s")
+            continue
+        failed += 1
+        lines.append(f"case {idx}: FAIL (wrong answer, compare={compare}) wall_time={wall:.3f}s")
+        lines.append(f"input:\n{_trunc(inp)}")
+        lines.append(f"expected:\n{_trunc(expected)}")
+        lines.append(f"actual:\n{_trunc(proc.stdout)}")
+        lines.append(f"stderr:\n{_trunc(proc.stderr)}")
+
+    if failed == 0:
+        lines.append("SUMMARY: ALL_PASS")
+    else:
+        lines.append(f"SUMMARY: FAILED {failed}/{n}")
+    return "\n".join(lines)
