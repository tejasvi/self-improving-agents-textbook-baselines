diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..3ce2091
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,240 @@
+import os
+import shlex
+import subprocess
+import time
+
+MAX_FIELD_CHARS = 2000
+MAX_TIME_BUDGET = 115.0
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Deterministic stress testing and benchmarking helper.
+
+* mode='stress': for seed in 0..num_cases-1, runs gen_cmd with the seed appended as the last argument to produce an input, then runs solution_cmd and brute_cmd on that input (stdin) and compares their stdout according to `compare`. Stops at the first mismatch, runtime error, timeout, or generator error, and returns a structured report that includes the failing input and both outputs. Returns PASS if all cases match (or if time_budget ran out first; the report says how many cases completed).
+* mode='benchmark': runs solution_cmd with stdin read from input_file and reports wall time, return code, and truncated stdout/stderr. Status is OK, TIMEOUT, or RUNTIME_ERROR.
+* Commands are parsed with shlex and run directly (no shell). Use absolute paths for files, e.g. `python3 /tmp/stress/sol.py`.
+* compare: 'exact' compares lines after rstrip; 'tokens' compares whitespace-separated tokens; 'float' compares tokens, treating numeric tokens as equal within 1e-6 relative/absolute tolerance.
+* Keep the total time under the bash tool's 120s limit; time_budget defaults to 100 seconds.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "mode": {
+                    "type": "string",
+                    "description": "'stress' to compare solution_cmd against brute_cmd on generated inputs, or 'benchmark' to time solution_cmd on input_file."
+                },
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command that runs the solution. It reads the input from stdin and writes the answer to stdout, e.g. 'python3 /path/to/solution.py'."
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Command that runs the reference brute-force solution (stress mode only), same I/O format as solution_cmd."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Command that generates one random input to stdout. The seed is appended as the last argument, e.g. 'python3 /tmp/stress/gen.py' is run as 'python3 /tmp/stress/gen.py 17' (stress mode only)."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test in stress mode (default 300)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each individual run (default 10)."
+                },
+                "compare": {
+                    "type": "string",
+                    "description": "Output comparison mode: 'exact', 'tokens', or 'float' (default 'tokens')."
+                },
+                "input_file": {
+                    "type": "string",
+                    "description": "Path to the input file fed to solution_cmd on stdin (benchmark mode only)."
+                },
+                "time_budget": {
+                    "type": "number",
+                    "description": "Total wall-clock budget in seconds for stress mode (default 100, must stay below 120)."
+                }
+            },
+            "required": ["mode", "solution_cmd"]
+        }
+    }
+
+
+def _trunc(text):
+    if text is None:
+        return ''
+    if isinstance(text, bytes):
+        text = text.decode('utf-8', errors='replace')
+    if len(text) > MAX_FIELD_CHARS:
+        return text[:MAX_FIELD_CHARS] + f'...[truncated {len(text) - MAX_FIELD_CHARS} chars]'
+    return text
+
+
+def _run(cmd, input_text, timeout):
+    """Run a command with stdin text. Returns (CompletedProcess or None, timed_out)."""
+    try:
+        proc = subprocess.run(
+            shlex.split(cmd),
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc, False
+    except subprocess.TimeoutExpired:
+        return None, True
+
+
+def _tokens_equal_float(a, b, tol=1e-6):
+    if len(a) != len(b):
+        return False
+    for x, y in zip(a, b):
+        if x == y:
+            continue
+        try:
+            fx, fy = float(x), float(y)
+        except ValueError:
+            return False
+        if abs(fx - fy) <= tol or abs(fx - fy) <= tol * max(abs(fx), abs(fy)):
+            continue
+        return False
+    return True
+
+
+def _outputs_match(out_a, out_b, compare):
+    if compare == 'exact':
+        la = [l.rstrip() for l in out_a.splitlines()]
+        lb = [l.rstrip() for l in out_b.splitlines()]
+        # Drop trailing empty lines so a missing final newline does not count.
+        while la and la[-1] == '':
+            la.pop()
+        while lb and lb[-1] == '':
+            lb.pop()
+        return la == lb
+    ta = out_a.split()
+    tb = out_b.split()
+    if compare == 'float':
+        return _tokens_equal_float(ta, tb)
+    return ta == tb
+
+
+def _stress(solution_cmd, brute_cmd, gen_cmd, num_cases, timeout, compare, time_budget):
+    if not brute_cmd or not gen_cmd:
+        return "ERROR: stress mode requires brute_cmd and gen_cmd."
+    if compare not in ('exact', 'tokens', 'float'):
+        return f"ERROR: unknown compare mode '{compare}'. Use 'exact', 'tokens', or 'float'."
+
+    start = time.monotonic()
+    completed = 0
+
+    def budget_left():
+        return time_budget - (time.monotonic() - start)
+
+    def budget_report():
+        return (f"PASS (time budget of {time_budget}s exhausted)\n"
+                f"cases completed: {completed} of {num_cases}\n"
+                f"No mismatch found in the completed cases.")
+
+    for seed in range(num_cases):
+        if budget_left() <= 0:
+            return budget_report()
+        # Cap each run so the whole call stays within time_budget.
+        run_timeout = min(timeout, budget_left())
+
+        gen_proc, gen_timeout = _run(f"{gen_cmd} {seed}", None, run_timeout)
+        if gen_timeout and budget_left() <= 0:
+            return budget_report()
+        if gen_timeout or gen_proc.returncode != 0 or not gen_proc.stdout.strip():
+            status = 'GENERATOR_ERROR'
+            return _report(status, seed, completed, '', None, None,
+                           gen_proc.stderr if gen_proc else 'generator timed out')
+        test_input = gen_proc.stdout
+
+        run_timeout = min(timeout, budget_left())
+        sol_proc, sol_timeout = _run(solution_cmd, test_input, run_timeout)
+        if sol_timeout:
+            if budget_left() <= 0 and run_timeout < timeout:
+                return budget_report()
+            return _report('TIMEOUT', seed, completed, test_input, None, None,
+                           f'solution exceeded {timeout}s')
+        if sol_proc.returncode != 0:
+            return _report('RUNTIME_ERROR', seed, completed, test_input,
+                           sol_proc.stdout, None, sol_proc.stderr)
+
+        run_timeout = min(timeout, budget_left())
+        brute_proc, brute_timeout = _run(brute_cmd, test_input, run_timeout)
+        if brute_timeout:
+            if budget_left() <= 0 and run_timeout < timeout:
+                return budget_report()
+            return _report('TIMEOUT', seed, completed, test_input, sol_proc.stdout, None,
+                           f'brute force exceeded {timeout}s (brute_cmd, not the solution)')
+        if brute_proc.returncode != 0:
+            return _report('RUNTIME_ERROR', seed, completed, test_input,
+                           sol_proc.stdout, brute_proc.stdout,
+                           'brute force (brute_cmd) failed: ' + (brute_proc.stderr or ''))
+
+        if not _outputs_match(sol_proc.stdout, brute_proc.stdout, compare):
+            return _report('WRONG_ANSWER', seed, completed, test_input,
+                           sol_proc.stdout, brute_proc.stdout, sol_proc.stderr)
+        completed += 1
+
+    return (f"PASS\n"
+            f"cases completed: {completed} of {num_cases}\n"
+            f"All cases matched (compare={compare}).")
+
+
+def _report(status, seed, completed, test_input, sol_out, brute_out, stderr):
+    lines = [
+        f"status: {status}",
+        f"seed: {seed}",
+        f"cases completed before failure: {completed}",
+        f"input:\n{_trunc(test_input)}",
+    ]
+    if sol_out is not None:
+        lines.append(f"solution output:\n{_trunc(sol_out)}")
+    if brute_out is not None:
+        lines.append(f"brute output:\n{_trunc(brute_out)}")
+    lines.append(f"stderr:\n{_trunc(stderr)}")
+    return "\n".join(lines)
+
+
+def _benchmark(solution_cmd, input_file, timeout):
+    if not input_file:
+        return "ERROR: benchmark mode requires input_file."
+    if not os.path.isfile(input_file):
+        return f"ERROR: input_file not found: {input_file}"
+    with open(input_file, 'r') as f:
+        data = f.read()
+    start = time.monotonic()
+    proc, timed_out = _run(solution_cmd, data, timeout)
+    wall = time.monotonic() - start
+    if timed_out:
+        return f"status: TIMEOUT\nwall_time: {wall:.3f}s (limit {timeout}s)"
+    status = 'OK' if proc.returncode == 0 else 'RUNTIME_ERROR'
+    return "\n".join([
+        f"status: {status}",
+        f"wall_time: {wall:.3f}s",
+        f"return_code: {proc.returncode}",
+        f"stdout (first 500 chars):\n{(proc.stdout or '')[:500]}",
+        f"stderr (first 500 chars):\n{(proc.stderr or '')[:500]}",
+    ])
+
+
+def tool_function(mode, solution_cmd, brute_cmd=None, gen_cmd=None, num_cases=300,
+                  timeout=10, compare='tokens', input_file=None, time_budget=100):
+    try:
+        num_cases = int(num_cases)
+        timeout = float(timeout)
+        time_budget = min(float(time_budget), MAX_TIME_BUDGET)
+    except (TypeError, ValueError) as e:
+        return f"ERROR: invalid numeric argument: {e}"
+
+    if mode == 'stress':
+        if num_cases < 1:
+            return "ERROR: num_cases must be at least 1."
+        return _stress(solution_cmd, brute_cmd, gen_cmd, num_cases, timeout, compare, time_budget)
+    if mode == 'benchmark':
+        return _benchmark(solution_cmd, input_file, timeout)
+    return f"ERROR: unknown mode '{mode}'. Use 'stress' or 'benchmark'."
