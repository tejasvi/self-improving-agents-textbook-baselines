+    def _response_has_marker(self, msg_history, marker=ALL_CHECKS_PASSED_MARKER):
+        """Return True if the most recent assistant message contains the marker."""
+        for msg in reversed(msg_history):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                texts = [content]
+            elif isinstance(content, list):
+                texts = [
+                    (b.get('text') if isinstance(b, dict) else getattr(b, 'text', None)) or ''
+                    for b in content
+                ]
+            else:
+                texts = []
+            return any(marker in t for t in texts)
+        return False
