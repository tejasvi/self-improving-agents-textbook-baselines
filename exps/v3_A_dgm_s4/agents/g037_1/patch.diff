@@ -0,0 +1,94 @@
+import os
+import subprocess
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a program on every sample test case in a directory and report an exact per-sample PASS/FAIL.\n
+* The samples directory must contain pairs of files: N.in (input) and N.out (expected output), e.g. 1.in/1.out, 2.in/2.out.\n
+* For each *.in file, the program is run with that file as standard input, and its standard output is compared byte-for-byte (ignoring only trailing newlines at the end of the output) with the matching *.out file.\n
+* For every FAIL, an exact unified diff of expected vs actual output is returned.\n
+* Use this after every change to the solution to confirm all samples still match exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to run (e.g. /tmp/work/solution.py)."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing N.in / N.out sample pairs (e.g. /tmp/samples)."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Interpreter/command used to run the solution file, e.g. 'python3'. Defaults to 'python3'."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+def _rstrip_trailing(s):
+    return s.rstrip("\r\n")
+
+def tool_function(solution_path, samples_dir, command="python3"):
+    import difflib
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isdir(samples_dir):
+        return f"Error: samples directory not found: {samples_dir}"
+    cmd_parts = command.split() if command else ["python3"]
+    in_files = sorted(f for f in os.listdir(samples_dir) if f.endswith(".in"))
+    if not in_files:
+        return f"Error: no *.in files found in {samples_dir}"
+
+    lines = []
+    passed = 0
+    for fname in in_files:
+        stem = fname[:-3]
+        in_path = os.path.join(samples_dir, fname)
+        out_path = os.path.join(samples_dir, stem + ".out")
+        if not os.path.isfile(out_path):
+            lines.append(f"[{stem}] FAIL: missing expected output file {stem}.out")
+            continue
+        with open(in_path, "r") as f:
+            stdin_data = f.read()
+        with open(out_path, "r") as f:
+            expected = f.read()
+        try:
+            proc = subprocess.run(
+                cmd_parts + [solution_path],
+                input=stdin_data, capture_output=True, text=True, timeout=10,
+            )
+            actual = proc.stdout
+            err = proc.stderr
+        except subprocess.TimeoutExpired:
+            lines.append(f"[{stem}] FAIL: timed out after 10 seconds")
+            continue
+        except Exception as e:
+            lines.append(f"[{stem}] FAIL: could not run program: {e}")
+            continue
+
+        if _rstrip_trailing(actual) == _rstrip_trailing(expected):
+            passed += 1
+            lines.append(f"[{stem}] PASS")
+        else:
+            lines.append(f"[{stem}] FAIL")
+            diff = difflib.unified_diff(
+                expected.splitlines(keepends=True), actual.splitlines(keepends=True),
+                fromfile=f"{stem}.out (expected)", tofile=f"{stem} actual stdout",
+            )
+            lines.append("".join(diff).rstrip("\n"))
+            if err.strip():
+                lines.append("stderr:\n" + err.strip()[-2000:])
+
+    lines.append(f"Summary: {passed}/{len(in_files)} samples passed")
+    return "\n".join(lines)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("Usage: python sample_check.py <solution_path> <samples_dir> [command]")
+    else:
+        print(tool_function(sys.argv[1], sys.argv[2], *(sys.argv[3:4])))
