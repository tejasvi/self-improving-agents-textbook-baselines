+    def _extract_code_block(self, text):
+        """
+        Return the longest fenced code block in text, or None if there is none.
+        """
+        blocks = re.findall(r'```(?:python)?\n(.*?)```', text or '', re.S)
+        if not blocks:
+            return None
+        return max(blocks, key=len)
+
+    def _last_assistant_text(self, msg_history):
+        """
+        Return the concatenated text of the last assistant message in msg_history ('' if none).
+        """
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                parts = []
+                for block in content:
+                    text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+                    if isinstance(text, str):
+                        parts.append(text)
+                return '\n'.join(parts)
+            return ''
+        return ''
+
+    def _request_code_only(self, prompt):
