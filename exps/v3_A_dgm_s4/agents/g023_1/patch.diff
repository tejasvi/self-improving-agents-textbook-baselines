+    def _target_file_from_problem(self):
+        """
+        Guess the target source file: a backticked filename in the problem statement,
+        else an existing stub file from git, else 'solution.py'.
+        """
+        m = re.findall(r'`([\w\-./]+\.py)`', self.problem_statement or '')
+        for candidate in m:
+            if not _is_test_path(candidate) and not os.path.isabs(candidate) and '..' not in candidate:
+                return candidate
+        try:
+            out = subprocess.run(
+                ['git', 'ls-files'], cwd=self.git_tempdir,
+                capture_output=True, text=True, timeout=60,
+            ).stdout
+            files = [f for f in out.splitlines() if f.endswith('.py') and not _is_test_path(f)]
+            for f in files:
+                if f == 'solution.py':
+                    return f
+            if len(files) == 1:
+                return files[0]
+        except Exception:
+            safe_log("[forward] git ls-files failed while locating target file", level=logging.WARNING)
+        return 'solution.py'
