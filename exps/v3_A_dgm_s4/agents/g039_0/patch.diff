+def _select_best_record(records):
+    """
+    Pick the best attempt record: passing first, then fewest harness failures,
+    then the latest non-empty, non-test patch. Returns None if nothing is usable.
+    """
+    candidates = [r for r in records if r['classification'] == 'ok']
