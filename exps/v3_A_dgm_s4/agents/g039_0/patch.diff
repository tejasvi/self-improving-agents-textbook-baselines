+def _run_harness(harness_path, cwd, timeout=HARNESS_TIMEOUT):
+    """
+    Run the test harness in a subprocess.
+    Returns (passed, output_tail, timed_out). The raw output is returned without parsing.
+    """
+    if not os.path.exists(harness_path):
+        return False, f"Harness file not found: {harness_path}", False
+    timed_out = False
+    try:
+        result = subprocess.run(
+            [sys.executable, harness_path],
+            cwd=cwd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=timeout,
+            text=True,
+            errors='replace',
+            check=False,
+        )
+        output = result.stdout or ""
+        passed = result.returncode == 0
+    except subprocess.TimeoutExpired as e:
+        timed_out = True
+        passed = False
+        raw = e.output or ""
+        if isinstance(raw, bytes):
+            raw = raw.decode('utf-8', errors='replace')
+        output = raw + f"\n[harness timed out after {timeout}s]"
+    tail = output[-HARNESS_TAIL_CHARS:]
+    return passed, tail, timed_out
+
