diff --git a/tools/run_timed.py b/tools/run_timed.py
new file mode 100644
index 0000000..65e293b
--- /dev/null
+++ b/tools/run_timed.py
@@ -0,0 +1,104 @@
+import os
+import resource
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_timed",
+        "description": """Run a shell command with a hard wall-clock timeout and report its performance.\n
+* Use this to benchmark solutions on maximum-size inputs without risking a hung shell.\n
+* Returns the elapsed wall time, the exit code (or an explicit TIMEOUT marker), an approximate peak memory figure, and truncated stdout/stderr.\n
+* The whole process group is killed when the timeout is reached.\n
+* Example: command='python solution.py < big_input.txt', timeout_seconds=10.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python solution.py < input.txt'."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Hard wall-clock limit in seconds. Defaults to 10."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Optional text to feed to the command's standard input."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n...[truncated {len(text) - MAX_OUTPUT_CHARS} chars]...\n" + text[-half:]
+
+
+def tool_function(command, timeout_seconds=10, stdin_text=None):
+    try:
+        timeout_seconds = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        timeout_seconds = 10.0
+    timeout_seconds = max(0.1, min(timeout_seconds, 300.0))
+
+    stdin_data = stdin_text.encode() if stdin_text is not None else b""
+    before = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+
+    start = time.monotonic()
+    proc = subprocess.Popen(
+        ["bash", "-c", command],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+    )
+    timed_out = False
+    try:
+        out, err = proc.communicate(input=stdin_data, timeout=timeout_seconds)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        out, err = proc.communicate()
+    elapsed = time.monotonic() - start
+    after = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+
+    # ru_maxrss for RUSAGE_CHILDREN is the largest child seen so far (KB on Linux).
+    # It is only a reliable per-command figure when this command set a new maximum.
+    peak_mb = after / 1024.0 if after > before else None
+
+    lines = [f"Elapsed wall time: {elapsed:.3f}s"]
+    if timed_out:
+        lines.append(f"TIMEOUT after {timeout_seconds:g}s (process killed)")
+    else:
+        lines.append(f"Exit code: {proc.returncode}")
+    if peak_mb is not None:
+        lines.append(f"Peak memory (approx, max child so far): {peak_mb:.1f} MB")
+    else:
+        lines.append("Peak memory: not available")
+
+    stdout_text = _truncate(out.decode(errors="replace").strip())
+    stderr_text = _truncate(err.decode(errors="replace").strip())
+    lines.append(f"--- stdout ---\n{stdout_text}")
+    lines.append(f"--- stderr ---\n{stderr_text}")
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: python run_timed.py '<command>' [timeout_seconds]")
+    else:
+        t = float(sys.argv[2]) if len(sys.argv) > 2 else 10
+        print(tool_function(sys.argv[1], timeout_seconds=t))
