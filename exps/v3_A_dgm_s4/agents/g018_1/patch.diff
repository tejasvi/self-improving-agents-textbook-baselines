+    def _extract_code_block(self, text):
+        """
+        Return the longest fenced code block (```python or plain ```) in text, or None.
+        """
+        if not isinstance(text, str) or not text:
+            return None
+        pattern = re.compile(r"```[ \t]*(?:python|py|Python)?[ \t]*\n(.*?)```", re.DOTALL)
+        blocks = [m.group(1).strip("\n") for m in pattern.finditer(text)]
+        blocks = [b for b in blocks if b.strip()]
+        if not blocks:
+            return None
+        return max(blocks, key=len)
+
+    def _get_last_assistant_text(self, msg_history):
+        """
+        Concatenate the text blocks of the last assistant message (dict or SDK object blocks).
+        """
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj.get(key)
+            return getattr(obj, key, None)
+
+        for msg in reversed(msg_history or []):
+            if _get(msg, 'role') != 'assistant':
+                continue
+            content = _get(msg, 'content')
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                text = _get(block, 'text')
+                if isinstance(text, str):
+                    parts.append(text)
+            return "\n".join(parts)
+        return ""
+
+    def _direct_codegen_fallback(self, target_path):
+        """
+        Tool-free fallback: ask the model for the complete program in one code block and write it to target_path.
+        Tries up to 3 progressively simpler prompts. Returns True if source edits exist afterwards.
+        """
+        existing = ""
+        if os.path.exists(target_path):
+            try:
+                with open(target_path, 'r') as f:
+                    existing = f.read()
+            except OSError:
+                existing = ""
+        stub_block = f"\n\nExisting contents of {target_path}:\n```python\n{existing}\n```\n" if existing else ""
+
+        variants = [
+            (
+                f"Solve the following competitive programming problem by writing a complete Python 3 program "
+                f"that reads standard input and writes standard output.\n\n"
+                f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+                f"Target file: {target_path}{stub_block}\n"
+                "Reply with the complete Python 3 program in a single ```python block. "
+                "Brute force that is correct is acceptable if you cannot find an efficient algorithm; "
+                "do not call tools."
+            ),
+            (
+                f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+                f"Write a Python 3 program for the problem above that reads stdin and writes stdout. "
+                f"Reply with the program in a single ```python block and do not call tools."
+            ),
+            (
+                f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+                "Baseline brute-force only: write the simplest correct Python 3 program that reads stdin and "
+                "writes stdout for the problem above. Reply with one ```python block and do not call tools."
+            ),
+        ]
+
+        for idx, prompt in enumerate(variants):
+            try:
+                history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+            except Exception as e:
+                safe_log(f"[fallback] variant {idx + 1} failed: {e}")
+                continue
+            code = self._extract_code_block(self._get_last_assistant_text(history))
+            if not code:
+                safe_log(f"[fallback] variant {idx + 1}: no code block in reply")
+                continue
+            os.makedirs(os.path.dirname(target_path), exist_ok=True)
+            with open(target_path, 'w') as f:
+                f.write(code + "\n")
+            safe_log(f"[fallback] variant {idx + 1}: wrote {len(code)} chars to {target_path}")
+            if self._has_source_edits():
+                return True
+        return self._has_source_edits()
+
