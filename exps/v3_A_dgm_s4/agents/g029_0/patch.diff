+def _block_field(block, name):
+    if isinstance(block, dict):
+        return block.get(name)
+    return getattr(block, name, None)
+
+def _last_assistant_text(msg_history):
+    """
+    Concatenate the text blocks of the last assistant message in msg_history.
+    Supports dict blocks and objects exposing `.text`. Returns '' if none found.
+    """
+    for msg in reversed(msg_history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role != 'assistant':
+            continue
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            return content
+        parts = []
+        for block in content or []:
+            if _block_field(block, 'type') == 'text':
+                text = _block_field(block, 'text')
+                if isinstance(text, str):
+                    parts.append(text)
+        return ''.join(parts)
+    return ''
+
+def _extract_code_block(text):
+    """
+    Return the longest fenced code block (```python or plain ```) in text, or None.
+    """
+    blocks = re.findall(r'```(?:python|py)?\s*\n(.*?)```', text or '', re.S)
+    blocks = [b for b in blocks if b.strip()]
+    if not blocks:
+        return None
+    return max(blocks, key=len)
+
