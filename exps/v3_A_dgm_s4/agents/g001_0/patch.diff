+    def _classify_patch(self):
+        """
+        Classify the current repo diff versus base_commit.
+        Returns 'empty' (no changes), 'tests_only' (all changed files are test files), or 'ok'.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_files = []
+        for line in diff.splitlines():
+            match = re.match(r'^diff --git a/(.+?) b/(.+)$', line)
+            if match:
+                changed_files.append(match.group(2).strip())
+        if not changed_files:
+            return 'empty'
+
+        def is_test_file(path):
+            normalized = path.replace('\\', '/')
+            basename = normalized.split('/')[-1]
+            if basename.startswith('test_') or basename.endswith('_test.py'):
+                return True
+            if basename.endswith('.test.js') or basename.endswith('.spec.js') or basename.endswith('_test.go'):
+                return True
+            parts = normalized.split('/')[:-1]
+            if 'tests' in parts or 'test' in parts:
+                return True
+            return False
+
+        if all(is_test_file(f) for f in changed_files):
+            return 'tests_only'
+        return 'ok'
+
