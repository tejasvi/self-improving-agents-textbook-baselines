+    def _file_matches_base(self, path):
+        """
+        True if the file content is identical to its content at base_commit.
+        """
+        rel = os.path.relpath(path, self.git_tempdir).replace('\\', '/')
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "show", f"{self.base_commit}:{rel}"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        if result.returncode != 0:
+            # Not present in base commit: it is new, so compare against empty content
+            base_content = b''
+        else:
+            base_content = result.stdout
+        try:
+            with open(path, 'rb') as f:
+                current = f.read()
+        except OSError:
+            return False
+        return current == base_content
+
