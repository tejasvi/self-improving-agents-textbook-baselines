+            if not isinstance(m, dict):
+                continue
+            content = m.get('content')
+            if not isinstance(content, list):
+                continue
+            for b in content:
+                btype = b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)
+                if btype == 'tool_result':
+                    val = b.get('content') if isinstance(b, dict) else getattr(b, 'content', None)
+                    if isinstance(val, list):
+                        val = "\n".join(str(x.get('text', x)) if isinstance(x, dict) else str(x) for x in val)
+                    results.append(str(val or ''))
+        return results
+
+    def _last_stress_result_passed(self, msg_history):
