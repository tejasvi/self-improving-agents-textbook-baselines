+++ b/tools/stress_test.py
@@ -0,0 +1,189 @@
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+
+MAX_OUTPUT_CHARS = 4000
+
+HARNESS = textwrap.dedent('''
+import importlib.util
+import io
+import json
+import random
+import sys
+import traceback
+import contextlib
+
+solution_path, brute_path, generator_path, num_cases = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+sol_mod = load(solution_path, "candidate_solution")
+brute_mod = load(brute_path, "brute_reference")
+gen_mod = load(generator_path, "case_generator")
+
+# Solution mode: a Solution class method (method name 'brute' is found in brute module as `brute`)
+has_solution_class = hasattr(sol_mod, "Solution")
+brute_fn = getattr(brute_mod, "brute", None)
+gen_fn = getattr(gen_mod, "gen", None)
+if brute_fn is None or gen_fn is None:
+    print("HARNESS ERROR: brute module must define brute(...) and generator must define gen(rng).")
+    sys.exit(0)
+
+# Discover the method to call on Solution: the first public method not starting with '_'
+method_name = None
+if has_solution_class:
+    cls = sol_mod.Solution
+    for name in dir(cls):
+        if not name.startswith("_") and callable(getattr(cls, name)):
+            method_name = name
+            break
+
+
+def normalize(v):
+    try:
+        return json.dumps(v, sort_keys=True, default=str)
+    except Exception:
+        return repr(v)
+
+
+def compute(fn, args):
+    out = io.StringIO()
+    with contextlib.redirect_stdout(out):
+        result = fn(*args)
+    return result
+
+
+best = None  # (size, description)
+for seed in range(num_cases):
+    rng = random.Random(seed)
+    case = gen_fn(rng)
+    args = case if isinstance(case, tuple) else (case,)
+    try:
+        if has_solution_class and method_name is not None:
+            sol_obj = sol_mod.Solution()
+            got = compute(getattr(sol_obj, method_name), args)
+        elif hasattr(sol_mod, "solve"):
+            got = compute(sol_mod.solve, args)
+        else:
+            print("HARNESS ERROR: solution must define class Solution with a method, or a solve(...) function.")
+            sys.exit(0)
+    except Exception:
+        got = "TRACEBACK:\\n" + traceback.format_exc()
+    try:
+        expected = compute(brute_fn, args)
+    except Exception:
+        expected = "TRACEBACK:\\n" + traceback.format_exc()
+    if normalize(got) != normalize(expected):
+        size = len(normalize(args))
+        if best is None or size < best[0]:
+            best = (size, seed, args, got, expected)
+
+if best is None:
+    print("ALL PASSED")
+else:
+    _, seed, args, got, expected = best
+    print(f"FAILED on seed={seed}")
+    print("input args:", normalize(args))
+    print("solution output:", normalize(got))
+    print("brute output:", normalize(expected))
+''')
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test: compare a candidate solution against a brute-force reference on many small random inputs.\n
+* solution_path: the candidate file. Either a Solution class (method called with generated args) or a module with solve(...).
+* brute_path: a brute-force reference file (outside the repo, e.g. /tmp) defining brute(...), the same signature as the solution's method.
+* generator_path: a file defining gen(rng) that returns a tuple of arguments (rng is a random.Random seeded per case).
+* Runs num_cases seeded cases under a timeout. Returns 'ALL PASSED' or the smallest failing input with the raw solution output and brute output (including any traceback).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate solution file (e.g. solution.py)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference file defining brute(...)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random generator file defining gen(rng) that returns the argument tuple."
+                },
+                "num_cases": {
+                    "type": "number",
+                    "description": "Number of random seeded cases to run. Defaults to 500."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Overall wall-clock limit in seconds. Defaults to 60."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n...[truncated {len(text) - MAX_OUTPUT_CHARS} chars]...\n" + text[-half:]
+
+
+def tool_function(solution_path, brute_path, generator_path, num_cases=500, timeout_seconds=60):
+    try:
+        num_cases = int(num_cases) if num_cases is not None else 500
+    except (TypeError, ValueError):
+        num_cases = 500
+    try:
+        timeout_seconds = float(timeout_seconds) if timeout_seconds is not None else 60.0
+    except (TypeError, ValueError):
+        timeout_seconds = 60.0
+    num_cases = max(1, min(num_cases, 100000))
+    timeout_seconds = max(1.0, min(timeout_seconds, 600.0))
+
+    for label, p in (("solution_path", solution_path), ("brute_path", brute_path), ("generator_path", generator_path)):
+        if not os.path.isfile(p):
+            return f"ERROR: {label} does not exist: {p}"
+
+    with tempfile.NamedTemporaryFile("w", suffix="_stress_harness.py", delete=False) as f:
+        f.write(HARNESS)
+        harness_path = f.name
+    try:
+        proc = subprocess.run(
+            [sys.executable, harness_path, os.path.abspath(solution_path), os.path.abspath(brute_path),
+             os.path.abspath(generator_path), str(num_cases)],
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+            cwd=os.path.dirname(os.path.abspath(solution_path)),
+        )
+        out = proc.stdout.strip()
+        err = proc.stderr.strip()
+        if proc.returncode != 0:
+            return _truncate(f"HARNESS CRASHED (exit {proc.returncode}):\n--- stdout ---\n{out}\n--- stderr ---\n{err}")
+        if not out:
+            return _truncate(f"No output from harness.\n--- stderr ---\n{err}")
+        return _truncate(out + (f"\n--- stderr ---\n{err}" if err else ""))
+    except subprocess.TimeoutExpired as e:
+        partial = (e.stdout or b"")
+        if isinstance(partial, bytes):
+            partial = partial.decode(errors="replace")
+        return _truncate(f"TIMEOUT after {timeout_seconds:g}s (harness killed). Partial stdout:\n{partial.strip()}")
+    finally:
+        try:
+            os.unlink(harness_path)
+        except OSError:
+            pass
