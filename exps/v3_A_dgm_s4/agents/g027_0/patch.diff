+    def _message_texts(self, msg):
+        """Return the raw text pieces of one history message (text, tool results, tool calls)."""
+        pieces = []
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', msg)
+        blocks = content if isinstance(content, list) else [content]
+        for b in blocks:
+            if isinstance(b, str):
+                pieces.append(b)
+                continue
+            if isinstance(b, dict):
+                for key in ('text', 'content'):
+                    val = b.get(key)
+                    if isinstance(val, str):
+                        pieces.append(val)
+                if not any(isinstance(b.get(k), str) for k in ('text', 'content')):
+                    pieces.append(str(b))
+            else:
+                val = getattr(b, 'text', None)
+                if isinstance(val, str):
+                    pieces.append(val)
+                else:
+                    pieces.append(str(b))
+        return pieces
+
+    def _tail_output(self, msg_history, max_chars=3000, max_msgs=4):
+        """Raw text of the last few history messages, truncated from the left."""
+        chunks = []
+        for m in (msg_history or [])[-max_msgs:]:
+            chunks.extend(self._message_texts(m))
+        text = "\n".join(c for c in chunks if c and c.strip())
+        return text[-max_chars:]
+
+    def _needs_repair(self, msg_history):
+        """
+        True if the last few history entries show a failure signal or an empty final assistant reply.
+        Plain substring checks only; the raw text is handed back to the agent.
+        """
+        if not msg_history:
+            return False
+        recent = msg_history[-6:]
+        signals = ('Traceback', 'AssertionError', 'FAILED', 'Error:')
+        for m in recent:
+            if isinstance(m, dict) and m.get('role') == 'assistant' and not any(
+                    t.strip() for t in self._message_texts(m)) and not self._has_tool_call(m):
+                return True
+        for m in recent:
+            for t in self._message_texts(m):
+                if any(sig in t for sig in signals):
+                    return True
+        last = msg_history[-1]
+        if isinstance(last, dict) and last.get('role') == 'assistant':
+            if not self._has_tool_call(last) and not any(t.strip() for t in self._message_texts(last)):
+                return True
+        return False
+
+    def _has_tool_call(self, msg):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if not isinstance(content, list):
+            return False
+        for b in content:
+            btype = b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)
+            if btype in ('tool_use', 'function_call', 'tool_call'):
+                return True
+        return False
+
+    def _tool_result_texts(self, msg_history):
+        """Raw tool-result strings in the history, oldest first (not prompts or assistant text)."""
+        results = []
