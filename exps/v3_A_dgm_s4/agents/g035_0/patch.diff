-    def _guard_text_only_turn(self, msg_history, label):
-        """
-        If the last pass ended with a text-only assistant reply (no tool call) and the repo has
-        no changes, send one immediate continuation message telling the agent to use the editor now.
-        """
-        if not msg_history:
-            return msg_history
-        last = msg_history[-1]
-        if not isinstance(last, dict) or last.get('role') != 'assistant':
-            return msg_history
-        if _has_tool_use(last):
-            return msg_history
-        patch = str(diff_versus_commit(self.git_tempdir, self.base_commit))
-        if _classify_patch(patch) != 'empty':
-            return msg_history
-        safe_log(f"[forward] {label}: text-only turn with empty patch; sending continuation")
-        return self._run_attempt(
-            "Proceed: call the editor tool now to write the solution file. Do not reply with text only.",
-            msg_history,
-            f"{label} continuation",
-        )
-
-    def _run_attempt(self, msg, msg_history, label):
-        """
-        Invoke the agent once and return the updated message history.
-        Returns an empty history if the agent call raised an exception.
-        """
-        msg_history = _sanitize_history(msg_history)
-        safe_log(f"[forward] starting agent pass: {label}")
-        try:
-            new_history = chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
-        except Exception:
-            import traceback
-            safe_log(f"[forward] agent pass {label} failed:\n{traceback.format_exc()}", level=logging.ERROR)
-            safe_log(f"[forward] finished agent pass: {label} (failed, history reset)")
-            return []
-        if new_history is None:
-            # Fall back to a fresh history with the task re-stated
-            new_history = [{
-                "role": "user",
-                "content": [{"type": "text", "text": f"{self._task_instruction}\n\n{msg}"}],
-            }]
-        new_history = _sanitize_history(new_history)
-        safe_log(f"[forward] finished agent pass: {label}")
-        return new_history
-
