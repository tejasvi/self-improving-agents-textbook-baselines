-def _is_test_path(path):
-    """
-    Return True if a repository-relative path looks like a test file.
-    """
-    normalized = path.replace('\\', '/')
-    parts = [p for p in normalized.split('/') if p]
-    if not parts:
-        return False
-    basename = parts[-1]
-    dirs = parts[:-1]
-    if any(d in ('tests', 'test') for d in dirs):
-        return True
-    if basename.startswith('test_') or '_test.' in basename:
-        return True
-    if '.spec.' in basename or 'conftest' in basename:
-        return True
-    return False
-
-def _classify_patch(diff):
-    """
-    Classify a git diff as 'empty', 'tests_only', or 'ok'.
-    """
-    if not diff or not diff.strip():
-        return 'empty'
-    paths = []
-    for line in diff.splitlines():
-        m = re.match(r'^diff --git a/(\S+) b/(\S+)', line)
-        if m:
-            paths.append(m.group(2))
-    if not paths:
-        return 'empty'
-    if all(_is_test_path(p) for p in paths):
-        return 'tests_only'
-    return 'ok'
-
-def _block_has_text(block):
-    return isinstance(block, dict) and block.get('type') == 'text'
-
-def _is_empty_text_block(block):
-    return _block_has_text(block) and not str(block.get('text') or '').strip()
-
-def _has_tool_use(msg):
-    """
-    Return True if a message contains a tool_use block (Claude) or tool_calls (OpenAI).
-    """
-    content = msg.get('content')
-    if isinstance(content, list):
-        for block in content:
-            if isinstance(block, dict) and block.get('type') in ('tool_use', 'tool_result'):
-                return True
-    if msg.get('tool_calls'):
-        return True
-    return False
-
-def _has_tool_use_in_history(msg_history):
-    return any(_has_tool_use(m) for m in msg_history if isinstance(m, dict))
-
-def _sanitize_history(history):
-    """
-    Clean a message history:
-    - drop assistant messages that contain only empty/whitespace text (no tool_use)
-    - strip empty text blocks from other messages
-    - merge consecutive messages with the same role
-    """
-    if not history:
-        return []
-    cleaned = []
-    for msg in history:
-        if not isinstance(msg, dict):
-            continue
-        content = msg.get('content')
-        if isinstance(content, str):
-            if not content.strip():
-                if msg.get('role') == 'assistant':
-                    continue
-                # Skip empty user strings as well; they carry no information
-                continue
-            new_msg = dict(msg)
-        elif isinstance(content, list):
-            new_blocks = [b for b in content if not _is_empty_text_block(b)]
-            if not new_blocks:
-                # Nothing left in this message
-                continue
-            if msg.get('role') == 'assistant' and not any(
-                isinstance(b, dict) and b.get('type') != 'text' for b in new_blocks
-            ) and all(_block_has_text(b) for b in new_blocks) and not any(
-                str(b.get('text') or '').strip() for b in new_blocks
-            ):
-                continue
-            new_msg = dict(msg)
-            new_msg['content'] = new_blocks
-        else:
-            new_msg = dict(msg)
-
-        if cleaned and cleaned[-1].get('role') == new_msg.get('role'):
-            prev = cleaned[-1]
-            prev_content = prev.get('content')
-            new_content = new_msg.get('content')
-            if isinstance(prev_content, str) and isinstance(new_content, str):
-                prev['content'] = prev_content + "\n\n" + new_content
-            else:
-                def _as_blocks(c):
-                    if isinstance(c, list):
-                        return list(c)
-                    return [{'type': 'text', 'text': str(c)}]
-                prev['content'] = _as_blocks(prev_content) + _as_blocks(new_content)
-        else:
-            cleaned.append(new_msg)
-    return cleaned
