+def _block_field(block, key):
+    if isinstance(block, dict):
+        return block.get(key)
+    return getattr(block, key, None)
+
+def _is_empty_assistant_msg(msg):
+    """True if an assistant message has no non-empty text and no tool_use blocks."""
+    content = msg.get('content', [])
+    if isinstance(content, str):
+        return not content.strip()
+    for block in content or []:
+        btype = _block_field(block, 'type')
+        if btype == 'tool_use':
+            return False
+        if btype == 'text' and (_block_field(block, 'text') or '').strip():
+            return False
+        if btype not in (None, 'text'):
+            # Non-text blocks (e.g. tool results, thinking) are kept as meaningful
+            return False
+    return True
+
+def _sanitize_history(msg_history):
+    """Drop assistant messages whose content blocks are all empty text."""
+    if not msg_history:
+        return []
+    return [
+        m for m in msg_history
+        if not (m.get('role') == 'assistant' and _is_empty_assistant_msg(m))
+    ]
+
+def _last_assistant_text(msg_history):
+    """Return the concatenated text of the last assistant message in the history."""
+    for m in reversed(msg_history or []):
+        if m.get('role') != 'assistant':
+            continue
+        content = m.get('content', [])
+        if isinstance(content, str):
+            return content
+        texts = []
+        for block in content or []:
+            if _block_field(block, 'type') == 'text':
+                texts.append(_block_field(block, 'text') or '')
+        return "\n".join(texts)
+    return ""
+
+def _extract_python_code(text):
+    """Extract the last fenced python code block from text, or None."""
+    blocks = re.findall(r"```(?:python|py)?[ \t]*\n(.*?)```", text or "", flags=re.DOTALL)
+    blocks = [b for b in blocks if b.strip()]
+    if not blocks:
+        return None
+    return blocks[-1]
+
