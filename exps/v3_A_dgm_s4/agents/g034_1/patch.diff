+++ b/tests/test_timed_run_tool.py
@@ -0,0 +1,38 @@
+import time
+from tools.timed_run import tool_function, tool_info
+
+
+def test_tool_info_schema():
+    info = tool_info()
+    assert info["name"] == "timed_run"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert schema["required"] == ["command"]
+    assert schema["properties"]["command"]["type"] == "string"
+    assert schema["properties"]["timeout_sec"]["type"] == "number"
+
+
+def test_successful_command_reports_output_and_time():
+    result = tool_function("echo hello", timeout_sec=5)
+    assert "hello" in result
+    assert "Exit code: 0" in result
+    assert "Elapsed:" in result
+
+
+def test_timeout_is_reported_and_killed():
+    start = time.monotonic()
+    result = tool_function("sleep 30", timeout_sec=1)
+    assert time.monotonic() - start < 10
+    assert result.startswith("TIMEOUT")
+
+
+def test_timeout_kills_child_processes():
+    start = time.monotonic()
+    result = tool_function("sh -c 'sleep 30' & sleep 30", timeout_sec=1)
+    assert time.monotonic() - start < 10
+    assert "TIMEOUT" in result
+
+
+def test_output_is_truncated():
+    result = tool_function("python3 -c \"print('x' * 20000)\"", timeout_sec=10)
+    assert "<response clipped>" in result
diff --git a/tools/timed_run.py b/tools/timed_run.py
new file mode 100644
index 0000000..0149507
--- /dev/null
+++ b/tools/timed_run.py
@@ -0,0 +1,101 @@
+import os
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 5000
+
+
+def tool_info():
+    return {
+        "name": "timed_run",
+        "description": """Run a shell command with a hard timeout and report its wall-clock time.\n
+* Use this to run stress tests and timing measurements (e.g. `python3 solution.py < big_input.txt`) so a slow or hanging program cannot block the persistent bash session.\n
+* Returns the exit code, stdout and stderr (truncated if long) and the elapsed seconds.\n
+* If the command exceeds `timeout_sec`, the whole process group is killed and the result starts with 'TIMEOUT'.\n
+* Prefer this tool over the bash tool for any run whose runtime is uncertain.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. `python3 solution.py < input.txt`."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Hard time limit in seconds (default 20)."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+
+def _kill_group(proc):
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError, OSError):
+        try:
+            proc.kill()
+        except OSError:
+            pass
+
+
+def tool_function(command: str, timeout_sec: float = 20) -> str:
+    """Run `command` in a shell with a timeout; return output and elapsed time."""
+    try:
+        timeout_sec = float(timeout_sec) if timeout_sec is not None else 20.0
+    except (TypeError, ValueError):
+        return f"Error: invalid timeout_sec: {timeout_sec}"
+    if timeout_sec <= 0:
+        return "Error: timeout_sec must be positive."
+
+    start = time.monotonic()
+    try:
+        # start_new_session puts the shell and its children in their own process group,
+        # so the whole group can be killed on timeout.
+        proc = subprocess.Popen(
+            command,
+            shell=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+            text=True,
+        )
+    except Exception as e:
+        return f"Error starting command: {type(e).__name__}: {e}"
+
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout_sec)
+    except subprocess.TimeoutExpired:
+        _kill_group(proc)
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except Exception:
+            stdout, stderr = "", ""
+        elapsed = time.monotonic() - start
+        out = _truncate(stdout or "")
+        err = _truncate(stderr or "")
+        return (
+            f"TIMEOUT after {timeout_sec:g}s (process killed; elapsed {elapsed:.2f}s).\n"
+            f"Partial stdout:\n{out}\nPartial stderr:\n{err}"
+        )
+
+    elapsed = time.monotonic() - start
+    return (
+        f"Exit code: {proc.returncode}\n"
+        f"Elapsed: {elapsed:.2f}s\n"
+        f"STDOUT:\n{_truncate(stdout or '')}\n"
+        f"STDERR:\n{_truncate(stderr or '')}"
+    )
+
+
+if __name__ == "__main__":
+    print(tool_function("echo hi; sleep 0.1", 5))
+    print(tool_function("sleep 10", 1))
