index 0000000..cb592c4
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,153 @@
+import difflib
+import os
+import signal
+import subprocess
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a program on a list of sample inputs and compare its stdout with the expected sample outputs.\n
+* Each sample is an object with 'input' (fed to stdin) and 'expected' (the exact sample output from the problem statement).\n
+* For each sample the result is EXACT_MATCH (byte-identical to the expected text), WHITESPACE_MATCH (equal after stripping trailing whitespace on each line and trailing blank lines), or MISMATCH (with actual output, expected output and a unified diff).\n
+* Ends with a summary line such as '3/5 exact matches'.\n
+* Use it after implementing a solution to check every sample from the statement at once. Pass the command that runs your solution, e.g. 'python3 solution.py'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command that runs the program under test, e.g. 'python3 solution.py'. It reads stdin and writes stdout."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases extracted from the problem statement.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's stdin."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected stdout for this input, as given in the problem statement."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Optional working directory in which to run the command. Defaults to the current directory."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Per-sample wall-clock limit in seconds. Defaults to 10."
+                }
+            },
+            "required": ["command", "samples"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n...[truncated {len(text) - MAX_OUTPUT_CHARS} chars]...\n" + text[-half:]
+
+
+def _strip_trailing_ws(text):
+    lines = [line.rstrip() for line in text.splitlines()]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def _run_one(command, stdin_text, cwd, timeout_seconds):
+    """Returns (stdout_text, error_note_or_None)."""
+    proc = subprocess.Popen(
+        ["bash", "-c", command],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=cwd,
+        start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(input=stdin_text.encode(), timeout=timeout_seconds)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        out, err = proc.communicate()
+        return out.decode(errors="replace"), f"TIMEOUT after {timeout_seconds}s"
+    note = None
+    if proc.returncode != 0:
+        note = f"exit code {proc.returncode}; stderr:\n{_truncate(err.decode(errors='replace'))}"
+    return out.decode(errors="replace"), note
+
+
+def tool_function(command, samples, cwd=None, timeout_seconds=10):
+    try:
+        timeout_seconds = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        timeout_seconds = 10.0
+    timeout_seconds = max(0.1, min(timeout_seconds, 300.0))
+
+    if isinstance(samples, str):
+        return "Error: 'samples' must be an array of objects with 'input' and 'expected' keys."
+    if not samples:
+        return "Error: no samples provided."
+
+    reports = []
+    exact = 0
+    total = len(samples)
+    for idx, sample in enumerate(samples, start=1):
+        if not isinstance(sample, dict) or "input" not in sample or "expected" not in sample:
+            reports.append(f"=== Sample {idx}: MISMATCH ===\nMalformed sample; each sample needs 'input' and 'expected' strings.")
+            continue
+        sample_input = str(sample["input"])
+        expected = str(sample["expected"])
+        try:
+            actual, note = _run_one(command, sample_input, cwd, timeout_seconds)
+        except Exception as e:
+            reports.append(f"=== Sample {idx}: MISMATCH ===\nFailed to run command: {e}")
+            continue
+
+        if actual == expected:
+            status = "EXACT_MATCH"
+            exact += 1
+        elif _strip_trailing_ws(actual) == _strip_trailing_ws(expected) and note is None:
+            status = "WHITESPACE_MATCH"
+        else:
+            status = "MISMATCH"
+
+        lines = [f"=== Sample {idx}: {status} ==="]
+        if note:
+            lines.append(f"Run note: {note}")
+        if status == "MISMATCH":
+            diff = difflib.unified_diff(
+                expected.splitlines(keepends=True),
+                actual.splitlines(keepends=True),
+                fromfile="expected",
+                tofile="actual",
+            )
+            lines.append("--- expected output ---")
+            lines.append(_truncate(expected))
+            lines.append("--- actual output ---")
+            lines.append(_truncate(actual))
+            lines.append("--- diff (expected -> actual) ---")
+            lines.append(_truncate("".join(diff)))
+        elif status == "WHITESPACE_MATCH":
+            lines.append("Output differs only by trailing whitespace; check whether the grader is strict.")
+            lines.append("--- actual output ---")
+            lines.append(_truncate(actual))
+        reports.append("\n".join(lines))
+
+    summary = f"Summary: {exact}/{total} exact matches"
+    return "\n\n".join(reports) + "\n\n" + summary
