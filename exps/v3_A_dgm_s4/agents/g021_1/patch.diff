diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..0852da4
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,189 @@
+import os
+import signal
+import subprocess
+import tempfile
+import time
+
+MAX_OUTPUT_CHARS = 2000
+MAX_INPUT_CHARS = 1500
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress tester for a solution program.\n
+* For each seed in [0, iterations): runs generator_cmd with the seed (as the first argument and in env var SEED) to produce one random test input on stdout.
+* Runs solution_cmd on that input (stdin) under a hard timeout (the whole process group is killed on timeout).
+* Verification: if checker_cmd is given, it is run as `checker_cmd <input_file> <output_file>` and must exit 0 for a valid output. Otherwise, if reference_cmd is given, its stdout (run on the same input) must equal the solution's stdout after whitespace normalization.
+* Stops at the first failure and reports the seed, the (truncated) input, the solution output, the reference output or checker stderr, and exit codes. If all iterations pass, reports the pass count and the max runtime.
+* Use a checker when several answers are valid; use reference_cmd (a brute force) when the answer is unique.
+* Commands are run through bash, so pipes and redirections work. Example: solution_cmd='python3 solution.py', generator_cmd='python3 gen.py', checker_cmd='python3 check.py', iterations=300, timeout_seconds=5.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command that runs the solution; it reads the test input on stdin and writes its answer to stdout."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Command that prints ONE random test input to stdout. The seed is passed as the first command-line argument and also in the env var SEED."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional. Command run as `<checker_cmd> <input_file> <output_file>`; must exit 0 iff the solution output is valid."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Optional. Brute-force command reading the same input on stdin; its stdout must match the solution's stdout after whitespace normalization."
+                },
+                "iterations": {
+                    "type": "number",
+                    "description": "Number of random seeds to test (0, 1, ..., iterations-1). Defaults to 200."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Wall-clock limit in seconds for each individual command run (generator, solution, reference, checker)."
+                }
+            },
+            "required": ["solution_cmd", "generator_cmd", "timeout_seconds"]
+        }
+    }
+
+
+def _truncate(text, limit):
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + f"\n...[truncated {len(text) - limit} chars]...\n" + text[-half:]
+
+
+def _run(command, timeout, stdin_data=b"", env=None, extra_args=()):
+    """Run a bash command in its own session; kill the process group on timeout.
+    Returns (returncode or None on timeout, stdout_bytes, stderr_bytes, elapsed, timed_out)."""
+    start = time.monotonic()
+    if extra_args:
+        full = ["bash", "-c", command + " \"$@\"", "bash", *extra_args]
+    else:
+        full = ["bash", "-c", command]
+    proc = subprocess.Popen(
+        full,
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+        env=env,
+    )
+    timed_out = False
+    try:
+        out, err = proc.communicate(input=stdin_data, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        out, err = proc.communicate()
+    elapsed = time.monotonic() - start
+    rc = None if timed_out else proc.returncode
+    return rc, out, err, elapsed, timed_out
+
+
+def _normalize(text):
+    return text.split()
+
+
+def tool_function(solution_cmd, generator_cmd, timeout_seconds=10, checker_cmd=None,
+                  reference_cmd=None, iterations=200):
+    try:
+        timeout_seconds = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        timeout_seconds = 10.0
+    timeout_seconds = max(0.1, min(timeout_seconds, 300.0))
+    try:
+        iterations = int(iterations) if iterations is not None else 200
+    except (TypeError, ValueError):
+        iterations = 200
+    iterations = max(1, min(iterations, 100000))
+
+    if not solution_cmd or not generator_cmd:
+        return "Error: solution_cmd and generator_cmd are required."
+
+    passed = 0
+    max_runtime = 0.0
+    with tempfile.TemporaryDirectory() as tmpdir:
+        for seed in range(iterations):
+            env = dict(os.environ)
+            env["SEED"] = str(seed)
+            # Generator
+            rc, gen_out, gen_err, _, gen_timeout = _run(
+                generator_cmd, timeout_seconds, env=env, extra_args=[str(seed)])
+            if gen_timeout or rc != 0:
+                return (f"Generator failed at seed {seed}: exit={rc}"
+                        f"{' (TIMEOUT)' if gen_timeout else ''}\n"
+                        f"--- generator stderr ---\n{_truncate(gen_err.decode(errors='replace').strip(), MAX_OUTPUT_CHARS)}")
+            input_text = gen_out.decode(errors='replace')
+            input_path = os.path.join(tmpdir, "input.txt")
+            with open(input_path, "w") as f:
+                f.write(input_text)
+
+            # Solution
+            rc, sol_out, sol_err, elapsed, sol_timeout = _run(
+                solution_cmd, timeout_seconds, stdin_data=input_text.encode(), env=env)
+            max_runtime = max(max_runtime, elapsed)
+            sol_text = sol_out.decode(errors='replace')
+            common = (f"seed={seed}\n--- input (truncated) ---\n"
+                      f"{_truncate(input_text, MAX_INPUT_CHARS)}\n")
+            if sol_timeout:
+                return (f"FAIL: solution timed out after {timeout_seconds:g}s at seed {seed}.\n{common}"
+                        f"--- solution stdout ---\n{_truncate(sol_text, MAX_OUTPUT_CHARS)}")
+            if rc != 0:
+                return (f"FAIL: solution exited with code {rc} at seed {seed}.\n{common}"
+                        f"--- solution stdout ---\n{_truncate(sol_text, MAX_OUTPUT_CHARS)}\n"
+                        f"--- solution stderr ---\n{_truncate(sol_err.decode(errors='replace').strip(), MAX_OUTPUT_CHARS)}")
+
+            # Verification
+            if checker_cmd:
+                output_path = os.path.join(tmpdir, "output.txt")
+                with open(output_path, "w") as f:
+                    f.write(sol_text)
+                crc, c_out, c_err, _, c_timeout = _run(
+                    checker_cmd + f" {input_path} {output_path}", timeout_seconds, env=env)
+                if c_timeout or crc != 0:
+                    return (f"FAIL: checker rejected output at seed {seed} (checker exit={crc}"
+                            f"{', TIMEOUT' if c_timeout else ''}).\n{common}"
+                            f"--- solution stdout ---\n{_truncate(sol_text, MAX_OUTPUT_CHARS)}\n"
+                            f"--- checker stderr/stdout ---\n"
+                            f"{_truncate((c_err or c_out).decode(errors='replace').strip(), MAX_OUTPUT_CHARS)}")
+            elif reference_cmd:
+                rrc, ref_out, ref_err, _, ref_timeout = _run(
+                    reference_cmd, timeout_seconds, stdin_data=input_text.encode(), env=env)
+                ref_text = ref_out.decode(errors='replace')
+                if ref_timeout or rrc != 0:
+                    return (f"Reference failed at seed {seed}: exit={rrc}"
+                            f"{' (TIMEOUT)' if ref_timeout else ''}\n{common}"
+                            f"--- reference stderr ---\n{_truncate(ref_err.decode(errors='replace').strip(), MAX_OUTPUT_CHARS)}")
+                if _normalize(sol_text) != _normalize(ref_text):
+                    return (f"FAIL: output mismatch vs reference at seed {seed}.\n{common}"
+                            f"--- solution output (exit {rc}) ---\n{_truncate(sol_text, MAX_OUTPUT_CHARS)}\n"
+                            f"--- reference output (exit {rrc}) ---\n{_truncate(ref_text, MAX_OUTPUT_CHARS)}")
+            elif not sol_text.strip():
+                return f"FAIL: empty solution output at seed {seed}.\n{common}"
+
+            passed += 1
+
+    return (f"PASS: {passed}/{iterations} random tests passed.\n"
+            f"Max solution runtime: {max_runtime:.3f}s (timeout {timeout_seconds:g}s).")
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("Usage: python stress_test.py '<solution_cmd>' '<generator_cmd>' [checker_cmd|-] [reference_cmd|-] [iterations] [timeout]")
+    else:
+        checker = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] != "-" else None
+        ref = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] != "-" else None
+        its = int(sys.argv[5]) if len(sys.argv) > 5 else 200
+        to = float(sys.argv[6]) if len(sys.argv) > 6 else 10
+        print(tool_function(sys.argv[1], sys.argv[2], timeout_seconds=to, checker_cmd=checker,
+                            reference_cmd=ref, iterations=its))
