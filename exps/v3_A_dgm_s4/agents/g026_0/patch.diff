diff --git a/tools/timed_run.py b/tools/timed_run.py
new file mode 100644
index 0000000..372ed8a
--- /dev/null
+++ b/tools/timed_run.py
@@ -0,0 +1,87 @@
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "timed_run",
+        "description": """Run a shell command with a wall-clock timeout and report its timing.\n
+* Use this to time a solution on a max-size input, e.g. command='python3 solution.py', stdin_file='big.txt', timeout_sec=10.\n
+* Returns the wall-clock time, the exit code, and (truncated) stdout/stderr.\n
+* If the command exceeds timeout_sec it is killed and a 'TIMEOUT' message is returned.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python3 solution.py'."
+                },
+                "stdin_file": {
+                    "type": "string",
+                    "description": "Optional path to a file whose contents are fed to the command's standard input."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum wall-clock seconds the command may run before it is killed. Defaults to 10."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+
+def tool_function(command, stdin_file=None, timeout_sec=10):
+    try:
+        timeout = float(timeout_sec) if timeout_sec is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    stdin_handle = None
+    try:
+        if stdin_file:
+            try:
+                stdin_handle = open(stdin_file, "rb")
+            except OSError as e:
+                return f"Error: could not open stdin_file '{stdin_file}': {e}"
+
+        start = time.monotonic()
+        try:
+            proc = subprocess.run(
+                command,
+                shell=True,
+                stdin=stdin_handle if stdin_handle is not None else subprocess.DEVNULL,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                timeout=timeout,
+            )
+        except subprocess.TimeoutExpired as e:
+            elapsed = time.monotonic() - start
+            out = e.stdout.decode(errors="replace") if e.stdout else ""
+            err = e.stderr.decode(errors="replace") if e.stderr else ""
+            return (
+                f"TIMEOUT: command exceeded {timeout} seconds and was killed "
+                f"(wall time {elapsed:.3f}s).\n"
+                f"stdout:\n{_truncate(out)}\nstderr:\n{_truncate(err)}"
+            )
+        elapsed = time.monotonic() - start
+        out = proc.stdout.decode(errors="replace")
+        err = proc.stderr.decode(errors="replace")
+        return (
+            f"wall_time_sec: {elapsed:.3f}\n"
+            f"return_code: {proc.returncode}\n"
+            f"stdout:\n{_truncate(out)}\n"
+            f"stderr:\n{_truncate(err)}"
+        )
+    except Exception as e:
+        return f"Error running command: {type(e).__name__}: {e}"
+    finally:
+        if stdin_handle is not None:
+            stdin_handle.close()
