+"""Helper logic for empty-reply handling and the direct no-tools fallback.
+
+These helpers are written against plain Python data so they can be merged into
+coding_agent.py's AgenticSystem class without depending on a specific SDK.
+"""
+import ast
+import re
+
+NUDGE = "Your last reply was empty. Call the editor tool now."
+
+SYSTEM_PROMPT = (
+    "You are an expert competitive programmer. Reply with one python code block."
+)
+
+_FENCE_RE = re.compile(r"```(?:python|py)?[ \t]*\n(.*?)```", re.DOTALL | re.IGNORECASE)
+_LOOSE_FENCE_RE = re.compile(r"```[a-zA-Z]*[ \t]*\n?(.*?)(?:```|$)", re.DOTALL)
+
+
+def _block_type(block):
+    if isinstance(block, dict):
+        return block.get("type")
+    return getattr(block, "type", None)
+
+
+def _block_text(block):
+    if isinstance(block, str):
+        return block
+    if isinstance(block, dict):
+        return block.get("text") or ""
+    return getattr(block, "text", None) or ""
+
+
+def _is_empty_assistant_msg(msg):
+    """True if msg is an assistant message with no non-whitespace content."""
+    if not isinstance(msg, dict) or msg.get("role") != "assistant":
+        return False
+    content = msg.get("content")
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ""
+    if isinstance(content, list):
+        if not content:
+            return True
+        for block in content:
+            if _block_type(block) == "tool_use":
+                return False
+            if _block_text(block).strip():
+                return False
+        return True
+    return False
+
+
+def _describe_msg(msg):
+    """Raw-ish representation of a message for diagnostics."""
+    if not isinstance(msg, dict):
+        return repr(msg)
+    content = msg.get("content")
+    if isinstance(content, list):
+        types = [str(_block_type(b)) for b in content]
+        return f"role={msg.get('role')!r} block_types={types} content={content!r}"
+    return f"role={msg.get('role')!r} content={content!r}"
+
+
+def _extract_code(text):
+    """Extract python code from a reply.
+
+    Prefers a fenced python block, then any fenced block, then the whole text
+    if it parses as python. Returns None when nothing usable is found.
+    """
+    if not text or not text.strip():
+        return None
+    m = _FENCE_RE.search(text)
+    if m and m.group(1).strip():
+        return m.group(1)
+    m = _LOOSE_FENCE_RE.search(text)
+    if m and m.group(1).strip():
+        return m.group(1)
+    try:
+        ast.parse(text)
+        return text
+    except SyntaxError:
+        return None
+
+
+def _direct_llm_code(complete_fn, problem, logger=print):
+    """Ask the model for code with no tools and a non-empty system prompt.
+
+    complete_fn(system, messages, max_tokens) -> str. It must not use tools.
+    Returns the extracted code string, or None on failure. Logs the exception
+    and the raw response on failure.
+    """
+    messages = [
+        {"role": "user", "content": problem},
+        {"role": "assistant", "content": "```python\n"},
+    ]
+    raw = None
+    try:
+        raw = complete_fn(SYSTEM_PROMPT, messages, 4096)
+    except Exception as e:  # noqa: BLE001
+        logger(f"[direct] LLM call failed: {type(e).__name__}: {e}")
+        return None
+    text = raw if isinstance(raw, str) else repr(raw)
+    if isinstance(raw, str):
+        text = "```python\n" + raw  # reconstruct the prefill
+    code = _extract_code(text)
+    if code is None:
+        logger(f"[direct] could not extract code; raw response: {raw!r}")
+    return code
+
+
+def run_with_empty_retries(run_fn, history, max_retries=2, logger=print):
+    """Run run_fn(history) -> history. If the last assistant message is empty,
+    retry on the same (unsanitized) history with a user nudge, up to max_retries.
+    Uses a bounded for loop only.
+    """
+    hist = run_fn(history)
+    for attempt in range(max_retries):
+        if not hist or not _is_empty_assistant_msg(hist[-1]):
+            break
+        logger(f"[run] empty assistant reply (attempt {attempt + 1}): "
+               f"{_describe_msg(hist[-1])}")
+        hist = list(hist) + [{"role": "user", "content": NUDGE}]
+        hist = run_fn(hist)
+    return hist
