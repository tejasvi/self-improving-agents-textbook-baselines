+    def _changed_files(self, diff):
+        """
+        Extract changed file paths from `diff --git a/X b/Y` header lines.
+        """
+        files = []
+        for line in str(diff or "").splitlines():
+            if line.startswith("diff --git "):
+                parts = line.split(" ")
+                if len(parts) >= 4:
+                    path = parts[3]
+                    if path.startswith("b/"):
+                        path = path[2:]
+                    files.append(path)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Return True if the path looks like a test file.
+        """
+        lowered = str(path).lower()
+        return 'test' in lowered or 'tests/' in lowered or 'spec' in lowered or lowered.startswith('test_')
+
+    def _patch_is_valid(self):
+        """
+        Check whether the current repo diff contains a non-test source edit.
+        Returns (ok, reason).
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit) or "")
+        if not diff.strip():
+            return False, "the diff is empty, no files were modified"
+        changed = self._changed_files(diff)
+        if not changed:
+            return False, "the diff is empty, no files were modified"
+        if all(self._is_test_file(p) for p in changed):
+            return False, "only test files were modified: " + ", ".join(changed)
+        return True, "ok"
+
