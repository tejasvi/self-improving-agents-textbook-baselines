+    def _diff_sections(self, diff):
+        """
+        Split a git diff into per-file sections. Returns a list of (path, section_text).
+        """
+        if not diff:
+            return []
+        sections = []
+        starts = [m.start() for m in re.finditer(r'^diff --git ', diff, re.MULTILINE)]
+        for i, start in enumerate(starts):
+            end = starts[i + 1] if i + 1 < len(starts) else len(diff)
+            section = diff[start:end]
+            match = re.match(r'diff --git a/(.+?) b/(.+)', section)
+            path = match.group(2).strip() if match else ''
+            sections.append((path, section))
+        return sections
+
