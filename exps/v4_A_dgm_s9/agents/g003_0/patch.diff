+    def _changed_files(self, diff):
+        """
+        Return the list of file paths changed in a git diff (parses 'diff --git a/X b/Y' lines).
+        """
+        if not diff:
+            return []
+        paths = []
+        for match in re.finditer(r'^diff --git a/(.+?) b/(.+)$', diff, re.MULTILINE):
+            path = match.group(2).strip()
+            if path not in paths:
+                paths.append(path)
+        return paths
+
+    def _is_test_file(self, path):
+        """
+        Return True if the path looks like a test file.
+        """
+        normalized = path.replace('\\', '/')
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        name = parts[-1]
+        if name.startswith('test_') or name.endswith('_test.py') or name.endswith('.test.js') or name.endswith('.spec.js'):
+            return True
+        if any(part in ('test', 'tests') for part in parts[:-1]):
+            return True
+        return False
+
+    def _has_source_edit(self):
+        """
+        Return True if the repository diff is non-empty and touches at least one non-test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        if not diff.strip():
+            return False
+        changed = self._changed_files(diff)
+        return any(not self._is_test_file(path) for path in changed)
+
