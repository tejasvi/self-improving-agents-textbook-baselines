--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,99 @@
+import os
+import re
+import subprocess
+
+SAMPLE_TIMEOUT = 10  # seconds per sample run
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution against the sample tests of a problem statement and check the output exactly.\n
+* Parses 'Sample Input N' / 'Sample Output N' blocks from the problem statement.\n
+* Runs `python3 solution_path` on each sample input (stdin) with a timeout.\n
+* Reports PASS if the whitespace-normalized stdout equals the expected output, otherwise FAIL with expected vs actual output.\n
+* Use it after writing the solution; any FAIL means the solution must be fixed, even if the statement says any valid answer is accepted.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_file": {
+                    "type": "string",
+                    "description": "Path to a file holding the problem statement text, or the problem statement itself."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed as `python3 solution_path`)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+_HEADER_RE = re.compile(r'^\s*Sample\s+(Input|Output)\s*(\d+)\s*:?[ \t]*$', re.IGNORECASE | re.MULTILINE)
+
+def _strip_fences(text):
+    lines = [ln for ln in text.strip('\n').splitlines() if not ln.strip().startswith('```')]
+    return '\n'.join(lines).strip('\n')
+
+def parse_samples(statement):
+    """Return a list of (index, input_text, expected_output_text) sorted by index."""
+    inputs, outputs = {}, {}
+    matches = list(_HEADER_RE.finditer(statement))
+    for i, m in enumerate(matches):
+        end = matches[i + 1].start() if i + 1 < len(matches) else len(statement)
+        body = _strip_fences(statement[m.end():end])
+        idx = int(m.group(2))
+        if m.group(1).lower() == 'input':
+            inputs[idx] = body
+        else:
+            outputs[idx] = body
+    samples = []
+    for idx in sorted(inputs):
+        if idx in outputs:
+            samples.append((idx, inputs[idx], outputs[idx]))
+    return samples
+
+def _normalize(text):
+    return '\n'.join(line.rstrip() for line in text.strip().splitlines()).strip()
+
+def tool_function(solution_path, problem_file=None):
+    if problem_file is None:
+        return "Error: no problem_file provided; cannot parse samples."
+    if os.path.isfile(problem_file):
+        with open(problem_file, 'r', encoding='utf-8', errors='replace') as f:
+            statement = f.read()
+    else:
+        statement = problem_file
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    samples = parse_samples(statement)
+    if not samples:
+        return "Error: no 'Sample Input N' / 'Sample Output N' blocks found in the problem statement."
+
+    reports = []
+    passed = 0
+    for idx, inp, expected in samples:
+        stdin_text = inp + '\n' if inp else ''
+        try:
+            proc = subprocess.run(
+                ['python3', solution_path],
+                input=stdin_text,
+                capture_output=True,
+                text=True,
+                timeout=SAMPLE_TIMEOUT,
+            )
+        except subprocess.TimeoutExpired:
+            reports.append(f"Sample {idx}: FAIL (timed out after {SAMPLE_TIMEOUT}s)\n"
+                           f"Expected:\n{expected}\nActual: <timeout>")
+            continue
+        actual = proc.stdout
+        if _normalize(actual) == _normalize(expected):
+            passed += 1
+            reports.append(f"Sample {idx}: PASS")
+        else:
+            extra = f"\nstderr:\n{proc.stderr.strip()}" if proc.stderr.strip() else ''
+            reports.append(f"Sample {idx}: FAIL\nExpected:\n{expected}\nActual:\n{actual.rstrip()}{extra}")
+
+    summary = f"{passed}/{len(samples)} samples passed."
+    return summary + "\n\n" + "\n\n".join(reports)
