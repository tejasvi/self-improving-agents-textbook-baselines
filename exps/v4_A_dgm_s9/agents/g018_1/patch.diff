+    def _verify_samples(self, msg_history, max_rounds=3):
+        """
+        Bounded post-run check: run the run_samples tool on the solution file(s).
+        If any sample mismatches, send the raw diff back to the agent to fix it.
+        """
+        from tools.run_samples import tool_function as run_samples
+        solution_path = self._find_solution_file()
+        if not solution_path:
+            safe_log("Sample verification skipped: no solution file found in the diff.")
+            return
+        for round_idx in range(max_rounds):
+            report = run_samples(solution_path=solution_path, problem_text=self.problem_statement)
+            if report.startswith("No samples found") or report.startswith("Error:"):
+                safe_log(f"Sample verification skipped: {report}")
+                return
+            if "MISMATCH" not in report and "TIMEOUT" not in report:
+                safe_log(f"Sample verification passed (round {round_idx + 1}/{max_rounds}).")
+                return
+            safe_log(f"Sample verification found mismatches (round {round_idx + 1}/{max_rounds}).")
+            follow_up = (
+                "The run_samples tool reports mismatches between your program's output and the expected sample outputs. "
+                "Fix the solution so that its output matches every sample output exactly, "
+                "adapting the construction to the canonical one implied by the samples. "
+                "Then re-run the samples to confirm.\n\nRaw run_samples report:\n" + report
+            )
+            msg_history = chat_with_agent(follow_up, model=self.code_model, msg_history=msg_history, logging=safe_log) or []
+
+    def _find_solution_file(self):
+        """
+        Pick a changed, non-test source file from the repo diff as the solution.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit) or "")
+        for path in self._changed_files(diff):
+            if not self._is_test_file(path) and path.endswith('.py'):
+                full = os.path.join(self.git_tempdir, path)
+                if os.path.exists(full):
+                    return full
+        return None
