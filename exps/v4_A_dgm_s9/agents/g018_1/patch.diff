+import difflib
+import os
+import re
+import subprocess
+import tempfile
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution file against the sample test cases of the problem and report, for each sample, whether the actual output matches the expected output exactly (after normalizing trailing whitespace).\n
+* Samples are parsed automatically from 'Sample Input k' / 'Sample Output k' blocks in problem_text.\n
+* Alternatively, pass explicit `samples` as a list of {"input": ..., "output": ...} objects if the parsing fails.\n
+* For each sample the result is PASS or MISMATCH, with the expected output, the actual output, and a unified diff (expected vs actual).\n
+* The raw stderr/exit status of the run is returned as-is so you can analyze it yourself.\n
+* Use this tool to verify that your output matches every sample output exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to run (e.g. /path/to/solution.py)."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the 'Sample Input k' / 'Sample Output k' blocks."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Command used to run the solution file, e.g. 'python3'. Optional; defaults to 'python3' when omitted."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Optional explicit samples as a list of objects with 'input' and 'output' string fields. Used instead of parsing problem_text when provided.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Standard input for the sample."
+                            },
+                            "output": {
+                                "type": "string",
+                                "description": "Expected standard output for the sample."
+                            }
+                        },
+                        "required": ["input", "output"]
+                    }
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+_INLINE_RE = re.compile(
+    r'(Sample|Example)\s+(Input|Output)\s*(\d+)?\s*[:\-]?[ \t]*\n',
+    re.IGNORECASE,
+)
+
+
+def _clean_block(text):
+    """Strip markdown code fences and surrounding blank lines from a sample block."""
+    lines = text.replace('\r\n', '\n').replace('\r', '\n').split('\n')
+    lines = [ln for ln in lines if not ln.strip().startswith('```')]
+    while lines and not lines[0].strip():
+        lines.pop(0)
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return '\n'.join(lines) + ('\n' if lines else '')
+
+
+def parse_samples(problem_text):
+    """
+    Heuristically parse 'Sample Input k' / 'Sample Output k' blocks.
+    Returns a list of {"index": k, "input": str, "output": str}, ordered by index.
+    """
+    text = str(problem_text or '')
+    headings = []
+    for m in _INLINE_RE.finditer(text):
+        kind = m.group(2).lower()
+        idx = m.group(3)
+        headings.append((m.start(), m.end(), kind, idx))
+    headings.sort(key=lambda h: h[0])
+
+    inputs, outputs = {}, {}
+    order = 0
+    for i, (start, end, kind, idx) in enumerate(headings):
+        block_end = headings[i + 1][0] if i + 1 < len(headings) else len(text)
+        block = _clean_block(text[end:block_end])
+        if idx is None:
+            order += 1
+            key = order
+        else:
+            key = int(idx)
+        target = inputs if kind == 'input' else outputs
+        if key not in target:
+            target[key] = block
+
+    samples = []
+    for key in sorted(set(inputs) & set(outputs)):
+        samples.append({"index": key, "input": inputs[key], "output": outputs[key]})
+    return samples
+
+
+def _normalize(text):
+    lines = str(text or '').replace('\r\n', '\n').replace('\r', '\n').split('\n')
+    lines = [ln.rstrip() for ln in lines]
+    while lines and not lines[-1]:
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _run_one(solution_path, command, stdin_text, timeout):
+    cmd = command.split() if command else ['python3']
+    cmd = cmd + [solution_path]
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or '')
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return out, err, None, True
+    except FileNotFoundError as e:
+        return '', str(e), None, False
+
+
+def tool_function(solution_path, problem_text=None, command='python3', samples=None, timeout=10):
+    if not solution_path or not os.path.exists(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    cases = []
+    if samples:
+        for i, s in enumerate(samples, start=1):
+            cases.append({"index": i, "input": str(s.get("input", "")), "output": str(s.get("output", ""))})
+    else:
+        cases = parse_samples(problem_text)
+
+    if not cases:
+        return ("No samples found. Parsing looked for 'Sample Input k' / 'Sample Output k' blocks; "
+                "pass explicit `samples` with 'input' and 'output' fields instead.")
+
+    # Make sure stdin always ends with a newline, as most judges provide one.
+    results = []
+    passed = 0
+    for case in cases:
+        stdin_text = case["input"] if case["input"].endswith('\n') else case["input"] + '\n'
+        stdout, stderr, rc, timed_out = _run_one(solution_path, command, stdin_text, timeout)
+        expected = _normalize(case["output"])
+        actual = _normalize(stdout)
+        header = f"Sample {case['index']}:"
+        if timed_out:
+            status = f"TIMEOUT (exceeded {timeout}s)"
+        elif rc != 0:
+            status = f"MISMATCH (exit code {rc})"
+        elif actual == expected:
+            status = "PASS"
+            passed += 1
+        else:
+            status = "MISMATCH"
+
+        block = [f"{header} {status}"]
+        if status == "PASS":
+            results.append("\n".join(block))
+            continue
+        diff = "\n".join(difflib.unified_diff(
+            expected.split('\n'), actual.split('\n'),
+            fromfile='expected', tofile='actual', lineterm='',
+        ))
+        block.append("--- expected ---")
+        block.append(expected)
+        block.append("--- actual ---")
+        block.append(actual)
+        block.append("--- diff (expected -> actual) ---")
+        block.append(diff if diff else "(no line differences)")
+        if stderr and stderr.strip():
+            block.append("--- stderr ---")
+            block.append(stderr.rstrip())
+        results.append("\n".join(block))
+
+    summary = f"{passed}/{len(cases)} samples passed."
+    return summary + "\n\n" + "\n\n".join(results)
