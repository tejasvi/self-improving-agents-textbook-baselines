+def _is_test_path(path):
+    """
+    Return True if a repository-relative path looks like a test file.
+    Plain string handling only: test directories, test_*.py, *_test.py,
+    *.spec.js, *_test.go, *.test.js, etc.
+    """
+    lowered = path.lower().replace('\\', '/')
+    parts = lowered.split('/')
+    dirs, name = parts[:-1], parts[-1]
+    if any(d in ('test', 'tests', '__tests__') for d in dirs):
+        return True
+    if name.startswith('test_') or name.startswith('tests_'):
+        return True
+    if name.startswith('test.') or name == 'conftest.py':
+        return True
+    for marker in ('_test.', '.test.', '.spec.', '_spec.', '_tests.'):
+        if marker in name:
+            return True
+    return False
+
+def _paths_from_diff(diff_text):
+    """
+    Extract the file paths from `diff --git a/X b/X` header lines.
+    """
+    paths = []
+    for line in diff_text.splitlines():
+        if not line.startswith('diff --git '):
+            continue
+        rest = line[len('diff --git '):]
+        if rest.startswith('a/') and ' b/' in rest:
+            path = rest[2:rest.rindex(' b/')]
+        else:
+            parts = rest.split()
+            path = parts[-1][2:] if parts and parts[-1].startswith('b/') else rest
+        paths.append(path)
+    return paths
+
+def classify_patch(diff_text):
+    """
+    Classify a git diff. Returns (has_source_change, has_any_change):
+      - has_any_change: True if the diff touches at least one file
+      - has_source_change: True if it touches at least one non-test file
+    """
+    paths = _paths_from_diff(diff_text or '')
+    has_any_change = len(paths) > 0
+    has_source_change = any(not _is_test_path(p) for p in paths)
+    return has_source_change, has_any_change
