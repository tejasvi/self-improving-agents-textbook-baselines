+    def _changed_files(self):
+        """
+        Return the set of files changed in git_tempdir, relative to the repo root,
+        covering both tracked edits versus base_commit and untracked files.
+        """
+        files = set()
+        status = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).stdout.decode(errors="replace")
+        for line in status.splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            if " -> " in path:  # renames: keep the new path
+                path = path.split(" -> ", 1)[1]
+            files.add(path.strip().strip('"'))
+        names = subprocess.run(
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).stdout.decode(errors="replace")
+        files.update(l.strip() for l in names.splitlines() if l.strip())
+        return files
+
+    @staticmethod
+    def _is_test_or_scratch_file(path):
+        import fnmatch
+        norm = path.replace("\\", "/")
+        base = os.path.basename(norm)
+        parts = norm.split("/")
+        if any(p in ("tests", "test", "__tests__", "scratch") for p in parts[:-1]):
+            return True
+        if any(fnmatch.fnmatch(base, pat) for pat in ("test_*", "*_test.*", "*.spec.*", "*.test.*")):
+            return True
+        if base.startswith(("scratch", "tmp_")) or base.endswith((".log", ".orig", ".rej")):
+            return True
+        return False
+
+    def _has_source_edit(self):
+        """
+        True if at least one changed file is neither a test nor a scratch file.
+        """
+        changed = self._changed_files()
+        return any(not self._is_test_or_scratch_file(f) for f in changed)
+
