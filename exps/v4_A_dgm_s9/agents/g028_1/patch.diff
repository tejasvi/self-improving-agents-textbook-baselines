+    def _ensure_source_edit(self, task, solution_file, msg_history):
+        """
+        Bounded (max 3 attempts) recovery when no source edit exists after a chat turn.
+        Returns (msg_history, failure_class, retries_used).
+        """
+        max_attempts = 3
+        failure_class = None
+        retries_used = 0
+        file_hint = solution_file or DEFAULT_SOLUTION_FILES.get(self.language, "solution.py")
+        for attempt in range(max_attempts):
+            if self._has_source_edit():
+                failure_class = None
+                break
+            failure_class = self._classify_failure(msg_history)
+            retries_used += 1
+            safe_log(f"[ensure] attempt={attempt} failure_class={failure_class} retry={retries_used}")
+            if failure_class == "empty_reply":
+                # Poisoned history: restart clean with a compact prompt; shorten further on each retry.
+                if attempt == 0:
+                    prompt = (
+                        f"{task}\nFirst action: run `ls -la {self.git_tempdir}` with bash, then create "
+                        f"{file_hint} with the editor tool containing the full solution."
+                    )
+                else:
+                    prompt = (
+                        f"Run `ls -la {self.git_tempdir}` with bash, then create {file_hint} "
+                        f"with the editor tool containing the full solution. Problem:\n{self.problem_statement}"
+                    )
+                msg_history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+            else:
+                corrective = (
+                    f"Your previous reply made no source edits. Call the editor tool now: command=create, "
+                    f"path={self.git_tempdir}/{file_hint}, file_text=<complete solution>. "
+                    f"Then run the samples with bash."
+                )
+                msg_history = chat_with_agent(
+                    corrective, model=self.code_model, msg_history=_clean_history(msg_history), logging=safe_log
+                )
+        else:
+            # Loop finished without break: check the final state.
+            if self._has_source_edit():
+                failure_class = None
+        safe_log(f"[ensure] done has_source_edit={self._has_source_edit()} failure_class={failure_class} retries={retries_used}")
+        return msg_history, failure_class, retries_used
