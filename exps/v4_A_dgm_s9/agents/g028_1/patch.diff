+def _is_empty_content(content):
+    """True if a message content (str or list of blocks) carries no non-whitespace text or tool use."""
+    if isinstance(content, str):
+        return not content.strip()
+    blocks = content or []
+    for block in blocks:
+        if _block_type(block) in ("tool_use", "tool_result"):
+            return False
+        if _block_text(block).strip():
+            return False
+    return True
+
+def _clean_history(msg_history):
+    """Return a copy of msg_history with trailing assistant messages that are empty/whitespace-only removed."""
+    cleaned = list(msg_history or [])
+    n_drop = 0
+    for msg in reversed(cleaned):
+        role = msg.get("role") if isinstance(msg, dict) else getattr(msg, "role", None)
+        content = msg.get("content") if isinstance(msg, dict) else getattr(msg, "content", None)
+        if role == "assistant" and _is_empty_content(content) and not _msg_has_tool_calls(msg):
+            n_drop += 1
+        else:
+            break
+    return cleaned[:len(cleaned) - n_drop]
+
+def _msg_has_tool_calls(msg):
+    if isinstance(msg, dict):
+        return bool(msg.get("tool_calls"))
+    return bool(getattr(msg, "tool_calls", None))
