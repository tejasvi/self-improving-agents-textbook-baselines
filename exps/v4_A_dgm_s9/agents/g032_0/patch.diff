@@ -0,0 +1,105 @@
+import re
+import subprocess
+
+SAMPLE_PATTERN = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n## Task|\Z)',
+    re.S
+)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Extract every 'Sample Input N' / 'Sample Output N' pair from the problem statement, run the Python solution on each sample input, and report PASS/FAIL per sample.\n
+* Comparison is exact after normalizing whitespace (lines are split and trailing whitespace is stripped).\n
+* On failure, the report includes the expected output, the actual output, and stderr.\n
+* Use this tool after writing the solution to verify it reproduces every sample output exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed with python3, reading stdin)."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the 'Sample Input N' and 'Sample Output N' blocks."
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+
+def extract_samples(problem_statement):
+    """Return a list of (index, input_text, expected_output_text) tuples."""
+    samples = []
+    for match in SAMPLE_PATTERN.finditer(problem_statement or ''):
+        samples.append((match.group(1), match.group(2), match.group(3)))
+    return samples
+
+
+def normalize_output(text):
+    """Split into lines, strip trailing whitespace, and drop trailing blank lines."""
+    lines = [line.rstrip() for line in (text or '').splitlines()]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def run_single_sample(solution_path, input_text, timeout=10):
+    """Run the solution on one input. Returns (actual_stdout, stderr, error_note)."""
+    try:
+        proc = subprocess.run(
+            ['python3', solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, None
+    except subprocess.TimeoutExpired as e:
+        stdout = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or '')
+        stderr = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return stdout, stderr, f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return '', '', f"Failed to run solution: {e}"
+
+
+def build_report(solution_path, problem_statement, timeout=10):
+    """Run all samples and return (report_text, all_passed)."""
+    samples = extract_samples(problem_statement)
+    if not samples:
+        return "No 'Sample Input N' / 'Sample Output N' pairs found in the problem statement.", False
+
+    lines = []
+    all_passed = True
+    for idx, input_text, expected_text in samples:
+        actual_text, stderr, error_note = run_single_sample(solution_path, input_text, timeout=timeout)
+        expected_lines = normalize_output(expected_text)
+        actual_lines = normalize_output(actual_text)
+        passed = error_note is None and expected_lines == actual_lines
+        if passed:
+            lines.append(f"Sample {idx}: PASS")
+        else:
+            all_passed = False
+            lines.append(f"Sample {idx}: FAIL")
+            if error_note:
+                lines.append(f"  Error: {error_note}")
+            lines.append("  Input:")
+            lines.extend(f"    {l}" for l in normalize_output(input_text))
+            lines.append("  Expected output:")
+            lines.extend(f"    {l}" for l in expected_lines)
+            lines.append("  Actual output:")
+            lines.extend(f"    {l}" for l in actual_lines)
+            if stderr and stderr.strip():
+                lines.append("  Stderr:")
+                lines.extend(f"    {l}" for l in stderr.rstrip().splitlines())
+    summary = "ALL SAMPLES PASSED" if all_passed else "SOME SAMPLES FAILED"
+    lines.append(summary)
+    return "\n".join(lines), all_passed
+
+
+def tool_function(solution_path, problem_statement):
+    report, _ = build_report(solution_path, problem_statement)
+    return report
