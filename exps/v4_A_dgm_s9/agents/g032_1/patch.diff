+    def _is_empty_assistant_message(self, msg):
+        """
+        True if an assistant message has no tool_use blocks and only blank text (or no content).
+        """
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            return False
+        content = msg.get('content')
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return not content.strip()
+        if isinstance(content, list):
+            for block in content:
+                btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+                if btype == 'tool_use':
+                    return False
+                if btype == 'text':
+                    text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', '')
+                    if str(text or '').strip():
+                        return False
+                elif btype is not None:
+                    # Any other non-text block (e.g. thinking/tool_result) counts as content.
+                    return False
+            return True
+        return False
+
+    def _is_plain_user_message(self, msg):
+        """
+        True if a user message is plain text (not a tool_result carrier).
+        """
+        if not isinstance(msg, dict) or msg.get('role') != 'user':
+            return False
+        content = msg.get('content')
+        if isinstance(content, str):
+            return True
+        if isinstance(content, list):
+            return all(isinstance(b, dict) and b.get('type') == 'text' for b in content)
+        return False
+
+    def _sanitize_history(self, msg_history):
+        """
+        Return a cleaned copy of msg_history: drops trailing assistant messages that are
+        empty or blank-text-only with no tool_use, and then drops trailing plain user
+        messages so the history ends on an assistant turn (or is empty) and roles alternate.
+        """
+        cleaned = list(msg_history or [])
+        while cleaned and self._is_empty_assistant_message(cleaned[-1]):
+            cleaned.pop()
+        while cleaned and self._is_plain_user_message(cleaned[-1]):
+            cleaned.pop()
+        return cleaned
 
