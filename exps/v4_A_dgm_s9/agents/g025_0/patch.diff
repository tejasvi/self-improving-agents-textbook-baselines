diff --git a/tools/run_limited.py b/tools/run_limited.py
new file mode 100644
index 0000000..e4607de
--- /dev/null
+++ b/tools/run_limited.py
@@ -0,0 +1,116 @@
+import resource
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_limited",
+        "description": (
+            "Run a shell command with a wall-clock timeout and an address-space (memory) limit. "
+            "Use this to benchmark solutions on max-size inputs. Returns exit code, elapsed wall time, "
+            "peak memory of the child process, truncated stdout/stderr, and an explicit TIMEOUT or "
+            "MEMORY_EXCEEDED marker when a limit is hit. A runaway command cannot hang the session."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python solution.py'.",
+                },
+                "stdin_file": {
+                    "type": "string",
+                    "description": "Optional path to a file whose contents are fed to the command's stdin.",
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Wall-clock timeout in seconds. Defaults to 10.",
+                },
+                "memory_mb": {
+                    "type": "number",
+                    "description": "Address-space limit in megabytes. Defaults to 1024.",
+                },
+            },
+            "required": ["command"],
+        },
+    }
+
+
+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + f"\n...[truncated {len(text) - limit} chars]...\n" + text[-half:]
+
+
+def tool_function(command, stdin_file=None, timeout_sec=10, memory_mb=1024):
+    timeout_sec = float(timeout_sec) if timeout_sec is not None else 10.0
+    memory_mb = float(memory_mb) if memory_mb is not None else 1024.0
+    limit_bytes = int(memory_mb * 1024 * 1024)
+
+    def _apply_limits():
+        resource.setrlimit(resource.RLIMIT_AS, (limit_bytes, limit_bytes))
+
+    stdin_handle = None
+    try:
+        if stdin_file:
+            try:
+                stdin_handle = open(stdin_file, "rb")
+            except OSError as e:
+                return f"ERROR: cannot open stdin_file {stdin_file!r}: {e}"
+
+        start = time.monotonic()
+        timed_out = False
+        try:
+            proc = subprocess.run(
+                command,
+                shell=True,
+                stdin=stdin_handle if stdin_handle else subprocess.DEVNULL,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                timeout=timeout_sec,
+                preexec_fn=_apply_limits,
+            )
+            returncode = proc.returncode
+            stdout = proc.stdout.decode("utf-8", errors="replace")
+            stderr = proc.stderr.decode("utf-8", errors="replace")
+        except subprocess.TimeoutExpired as e:
+            timed_out = True
+            returncode = None
+            stdout = (e.stdout or b"").decode("utf-8", errors="replace")
+            stderr = (e.stderr or b"").decode("utf-8", errors="replace")
+        elapsed = time.monotonic() - start
+
+        # Peak RSS of waited-for children (kilobytes on Linux). Approximate: cumulative max over children.
+        peak_kb = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+        peak_mb = peak_kb / 1024.0
+
+        marker = "OK"
+        if timed_out:
+            marker = "TIMEOUT"
+        elif returncode != 0 and ("MemoryError" in stderr or "Cannot allocate memory" in stderr):
+            marker = "MEMORY_EXCEEDED"
+        elif returncode is not None and returncode < 0:
+            marker = f"KILLED_SIGNAL_{-returncode}"
+
+        lines = [
+            f"MARKER: {marker}",
+            f"exit_code: {returncode if returncode is not None else 'N/A (timed out)'}",
+            f"elapsed_sec: {elapsed:.3f}",
+            f"peak_rss_mb: {peak_mb:.1f}",
+            f"memory_limit_mb: {memory_mb:g}",
+            f"timeout_sec: {timeout_sec:g}",
+            "stdout:",
+            _truncate(stdout),
+            "stderr:",
+            _truncate(stderr),
+        ]
+        return "\n".join(lines)
+    except Exception as e:
+        return f"ERROR: run_limited failed: {e}"
+    finally:
+        if stdin_handle:
+            stdin_handle.close()
