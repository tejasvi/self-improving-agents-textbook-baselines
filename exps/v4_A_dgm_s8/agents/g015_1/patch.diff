+++ b/tools/run_samples.py
@@ -0,0 +1,140 @@
+import re
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution file on the sample tests found in a problem statement and return the raw results.\n
+* Parses blocks following 'Sample Input N' / 'Sample Output N' headers (fallback: 'Input:' / 'Expected output:' headers).\n
+* Runs `python3 solution_path` on each sample input with a timeout.\n
+* For each sample returns the input, expected output, actual output and a status: EXACT_MATCH (identical), WHITESPACE_MATCH (differs only in whitespace), MISMATCH, or ERROR (with raw stderr / timeout info).\n
+* Output is raw text; interpret it yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed with python3)."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the sample input/output blocks."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-sample timeout in seconds. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "problem_text"]
+        }
+    }
+
+
+_HEADER_RE = re.compile(
+    r'^\s*(sample\s+input|sample\s+output|input\s*\d*\s*:?\s*$|output\s*\d*\s*:?\s*$|'
+    r'expected\s+output|example|explanation|note\b|constraints?\b)',
+    re.IGNORECASE,
+)
+
+
+def _collect(lines, start):
+    """Collect lines after a header until the next header or blank-line-terminated end of block."""
+    block = []
+    for line in lines[start:]:
+        if _HEADER_RE.match(line):
+            break
+        block.append(line)
+    while block and not block[-1].strip():
+        block.pop()
+    while block and not block[0].strip():
+        block.pop(0)
+    return "\n".join(block) + "\n" if block else ""
+
+
+def _parse_samples(problem_text):
+    """Return list of (input_str, expected_str) parsed from the problem text."""
+    lines = problem_text.splitlines()
+    inputs, outputs, order = {}, {}, []
+    fallback_inputs, fallback_outputs = [], []
+
+    for i, line in enumerate(lines):
+        m_in = re.match(r'^\s*sample\s+input\s*(\d*)', line, re.IGNORECASE)
+        m_out = re.match(r'^\s*sample\s+output\s*(\d*)', line, re.IGNORECASE)
+        if m_in:
+            key = m_in.group(1) or str(len(order) + 1)
+            inputs[key] = _collect(lines, i + 1)
+            order.append(key)
+        elif m_out:
+            key = m_out.group(1) or str(len(outputs) + 1)
+            outputs[key] = _collect(lines, i + 1)
+        elif re.match(r'^\s*input\s*\d*\s*:?\s*$', line, re.IGNORECASE):
+            fallback_inputs.append(_collect(lines, i + 1))
+        elif re.match(r'^\s*(expected\s+output|output)\s*\d*\s*:?\s*$', line, re.IGNORECASE):
+            fallback_outputs.append(_collect(lines, i + 1))
+
+    pairs = [(inputs[k], outputs[k]) for k in order if k in outputs]
+    if not pairs:
+        pairs = list(zip(fallback_inputs, fallback_outputs))
+    return pairs
+
+
+def _classify(expected, actual):
+    if expected.rstrip() == actual.rstrip():
+        return "EXACT_MATCH"
+    if expected.split() == actual.split():
+        return "WHITESPACE_MATCH"
+    return "MISMATCH"
+
+
+def tool_function(solution_path, problem_text, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    pairs = _parse_samples(problem_text or "")
+    if not pairs:
+        return "No sample input/output blocks found in the problem text."
+
+    results = []
+    for idx, (inp, expected) in enumerate(pairs, 1):
+        block = [f"=== Sample {idx} ===", "Input:", inp.rstrip("\n"), "Expected:", expected.rstrip("\n")]
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=inp,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+        except subprocess.TimeoutExpired as e:
+            block += [f"Status: ERROR (timed out after {timeout} seconds)"]
+            stdout = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+            if stdout:
+                block += ["Actual (partial stdout):", stdout.rstrip("\n")]
+            results.append("\n".join(block))
+            continue
+        except Exception as e:
+            block += [f"Status: ERROR (failed to run: {e})"]
+            results.append("\n".join(block))
+            continue
+
+        if proc.returncode != 0:
+            block += [
+                f"Status: ERROR (return code {proc.returncode})",
+                "Actual:",
+                proc.stdout.rstrip("\n"),
+                "Stderr:",
+                proc.stderr.rstrip("\n"),
+            ]
+            results.append("\n".join(block))
+            continue
+
+        actual = proc.stdout
+        status = _classify(expected, actual)
+        block += ["Actual:", actual.rstrip("\n"), f"Status: {status}"]
+        results.append("\n".join(block))
+
+    summary = f"Ran {len(pairs)} sample(s)."
+    return summary + "\n\n" + "\n\n".join(results)
