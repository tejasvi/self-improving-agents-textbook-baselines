+    def _find_source_file(self):
+        """Locate the primary non-test source/stub file (repo-relative path) or None."""
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                capture_output=True, text=True, check=False,
+            )
+            tracked = [line.strip() for line in result.stdout.splitlines() if line.strip()]
+        except Exception as e:
+            safe_log(f"_find_source_file: git ls-files failed: {e}")
+            return None
+
+        exts = (".py", ".cpp", ".go", ".rs", ".js", ".java")
+        candidates = [f for f in tracked if f.endswith(exts) and not _is_test_path(f)]
+        if not candidates:
+            return None
+
+        # Prefer solution.py if present
+        for f in candidates:
+            if os.path.basename(f) == "solution.py":
+                return f
+
+        # Prefer stubs containing `pass` or placeholder comments
+        placeholder_markers = ("TODO", "placeholder", "Placeholder", "stub", "Stub", "implement")
+        for f in candidates:
+            try:
+                with open(os.path.join(self.git_tempdir, f), 'r', errors='ignore') as fh:
+                    content = fh.read()
+            except OSError:
+                continue
+            if "pass" in content.split() or any(m in content for m in placeholder_markers):
+                return f
+
+        return candidates[0]
+
+    def _read_stub(self, path):
+        """Return current contents of the source file, or empty string if unreadable."""
+        try:
+            with open(os.path.join(self.git_tempdir, path), 'r', errors='ignore') as fh:
+                return fh.read()
+        except OSError:
+            return ""
+
+    def _last_assistant_text(self, msg_history):
+        """Extract the text of the last assistant message in a msg_history list."""
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = []
+                for block in content:
+                    if isinstance(block, dict) and block.get('type') == 'text' and block.get('text'):
+                        texts.append(block['text'])
+                    elif hasattr(block, 'text') and getattr(block, 'text', None):
+                        texts.append(block.text)
+                if texts:
+                    return "\n".join(texts)
+            return None
+        return None
+
