+++ b/tests/test_forward_flow.py
@@ -0,0 +1,70 @@
+import coding_agent as ca
+
+
+class FakeRepo:
+    """Stands in for git state: `diff` is what diff_versus_commit returns."""
+
+    def __init__(self):
+        self.diff = ""
+
+
+def make_system(monkeypatch, repo):
+    monkeypatch.setattr(ca, "diff_versus_commit", lambda d, c: repo.diff)
+    system = ca.AgenticSystem.__new__(ca.AgenticSystem)
+    system.problem_statement = "p"
+    system.git_tempdir = "/tmp/none"
+    system.base_commit = "HEAD"
+    system.code_model = "m"
+    system.logger = None
+    return system
+
+
+def test_empty_patch_triggers_followups_and_skips_verification(monkeypatch):
+    repo = FakeRepo()
+    system = make_system(monkeypatch, repo)
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=None):
+        calls.append((msg, list(msg_history or [])))
+        # Agent never edits anything and ends with an empty message.
+        return list(msg_history or []) + [{"role": "assistant", "content": ""}]
+
+    monkeypatch.setattr(ca, "chat_with_agent", fake_chat)
+    system.forward()
+
+    # 1 initial call + 4 ensure-patch follow-ups + 1 safety net; no verification prompts.
+    assert len(calls) == 6
+    assert all("Verification step" not in m for m, _ in calls)
+    # Follow-ups reuse the accumulated history (not []).
+    assert calls[1][1], "follow-up should carry msg_history"
+    assert "editor" in calls[1][0]
+
+
+def test_valid_patch_runs_verification_and_stops_on_runtime(monkeypatch):
+    repo = FakeRepo()
+    system = make_system(monkeypatch, repo)
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=None):
+        calls.append(msg)
+        if len(calls) == 1:
+            repo.diff = "diff --git a/solution.py b/solution.py\n+x = 1\n"
+        return list(msg_history or []) + [
+            {"role": "assistant", "content": "Done. Worst case 0.31 seconds."}
+        ]
+
+    monkeypatch.setattr(ca, "chat_with_agent", fake_chat)
+    system.forward()
+
+    verify = [m for m in calls if "Verification step" in m]
+    # Breaks as soon as the assistant reports a measured runtime.
+    assert len(verify) == 1
+
+
+def test_test_only_patch_is_invalid(monkeypatch):
+    repo = FakeRepo()
+    system = make_system(monkeypatch, repo)
+    repo.diff = "diff --git a/tests/test_x.py b/tests/test_x.py\n+assert True\n"
+    assert system._patch_is_valid() is False
+    repo.diff = "diff --git a/solution.py b/solution.py\n+x\n"
+    assert system._patch_is_valid() is True
