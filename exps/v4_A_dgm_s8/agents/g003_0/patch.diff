+TEST_PATH_SEGMENTS = {"test", "tests", "spec", "specs", "__tests__"}
+
+def _is_test_path(path):
+    """Heuristically decide whether a repo-relative path is a test file."""
+    parts = [p for p in path.replace("\\", "/").split("/") if p]
+    if not parts:
+        return False
+    for part in parts[:-1]:
+        if part.lower() in TEST_PATH_SEGMENTS:
+            return True
+    name = parts[-1].lower()
+    if name.startswith("test_") and name.endswith(".py"):
+        return True
+    if name.endswith("_test.py") or name.endswith("_test.go"):
+        return True
+    if name.endswith((".spec.js", ".spec.ts", ".spec.jsx", ".spec.tsx", ".test.js", ".test.ts", ".test.jsx", ".test.tsx")):
+        return True
+    if name.endswith("_spec.rb") or name.endswith("test.java") or name.endswith("tests.java"):
+        return True
+    stem = name.split(".")[0]
+    if stem in ("test", "tests", "spec", "specs"):
+        return True
+    return False
+
+def get_changed_files(diff_text):
+    """Parse changed file paths from `diff --git a/... b/...` headers."""
+    files = []
+    for line in diff_text.splitlines():
+        if line.startswith("diff --git "):
+            rest = line[len("diff --git "):]
+            # Prefer the b/ path (post-change name)
+            idx = rest.rfind(" b/")
+            if idx != -1:
+                path = rest[idx + 3:]
+            else:
+                path = rest.split(" ")[-1]
+            if path.startswith("b/"):
+                path = path[2:]
+            files.append(path.strip())
+    return files
+
