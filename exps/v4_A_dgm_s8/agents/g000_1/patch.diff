+++ b/tools/run_with_timeout.py
@@ -0,0 +1,81 @@
+import os
+import signal
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a shell command with a time limit and return the raw results.\n
+* The command is run with `sh -c` in the current working directory of the agent's shell (use absolute paths or `cd` inside the command when needed).\n
+* Optional `stdin_text` is written to the command's standard input (use this to feed an input file or to drive an interactive program's pipes via a script).\n
+* If the command does not finish within `timeout` seconds, its whole process group is killed and the output so far is returned.\n
+* The output is returned raw, without parsing: STDOUT, STDERR, RETURN CODE, TIMED OUT flag and ELAPSED seconds.\n
+* Useful for running solution files against sample inputs and stress tests, and for comparing outputs of two programs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run (executed with sh -c)."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Optional text to write to the command's standard input."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Maximum number of seconds the command may run before it is killed. Defaults to 10."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+def tool_function(command, stdin_text=None, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    start = time.time()
+    timed_out = False
+    try:
+        proc = subprocess.Popen(
+            ["sh", "-c", command],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,  # own process group so the whole tree can be killed
+            text=True,
+        )
+    except Exception as e:
+        return f"STDOUT:\n\nSTDERR:\nFailed to start command: {e}\nRETURN CODE: -1\nTIMED OUT: False\nELAPSED: 0.00s"
+
+    try:
+        stdout, stderr = proc.communicate(input=stdin_text, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except Exception:
+            stdout, stderr = "", ""
+    except Exception as e:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        return f"STDOUT:\n\nSTDERR:\nError while running command: {e}\nRETURN CODE: -1\nTIMED OUT: False\nELAPSED: {time.time() - start:.2f}s"
+
+    elapsed = time.time() - start
+    return (
+        f"STDOUT:\n{stdout or ''}\n"
+        f"STDERR:\n{stderr or ''}\n"
+        f"RETURN CODE: {proc.returncode}\n"
+        f"TIMED OUT: {timed_out}\n"
+        f"ELAPSED: {elapsed:.2f}s"
+    )
