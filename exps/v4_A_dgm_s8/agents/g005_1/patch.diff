+    def _changed_files(self):
+        """
+        Return the list of paths changed in git_tempdir (from `git status --porcelain`),
+        including untracked files.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+        paths = []
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            # Renames appear as "old -> new"; keep the new path
+            if ' -> ' in path:
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                paths.append(path)
+        return paths
+
+    @staticmethod
+    def _is_test_path(path):
+        """
+        Heuristic: a path is a test file if 'test' or 'spec' (or their plurals) appears as a
+        whole directory or filename component, where components are split on '/', '.', '_', '-'.
+        """
+        test_tokens = {'test', 'tests', 'spec', 'specs', 'testing'}
+        tokens = re.split(r'[/._\-]', path.lower())
+        return any(tok in test_tokens for tok in tokens if tok)
+
+    def _has_source_edits(self):
+        """
+        True if any changed path is not a test file.
+        """
+        return any(not self._is_test_path(p) for p in self._changed_files())
+
