+    def _chat_retry(self, instruction, msg_history):
+        """
+        Continue the conversation with the accumulated history. Falls back to a
+        text summary of the prior history if the returned value is not a history list.
+        """
+        try:
+            new_history = chat_with_agent(instruction, model=self.code_model, msg_history=msg_history, logging=safe_log)
+            if isinstance(new_history, list):
+                return new_history
+            safe_log("chat_with_agent did not return a history list; using a summary instead.")
+        except Exception as e:
+            safe_log(f"Retry chat_with_agent raised an error: {e}", level=logging.WARNING)
+        summary = self._summarize_history(msg_history)
+        try:
+            new_history = chat_with_agent(f"{summary}\n\n{instruction}", model=self.code_model, msg_history=[], logging=safe_log)
+            return new_history if isinstance(new_history, list) else []
+        except Exception as e:
+            safe_log(f"Summary retry raised an error: {e}", level=logging.WARNING)
+            return []
+
+    def _summarize_history(self, msg_history):
+        """Build a compact text summary of prior messages (text blocks only, truncated)."""
+        lines = []
+        for m in msg_history or []:
+            content = m.get('content')
+            if isinstance(content, str):
+                text = content
+            elif isinstance(content, list):
+                text = ' '.join(str(b.get('text', '')) for b in content if isinstance(b, dict))
+            else:
+                text = ''
+            text = text.strip()
+            if text:
+                lines.append(f"[{m.get('role', '?')}] {text[:300]}")
+        return "Summary of earlier work:\n" + "\n".join(lines[-20:])
+
+    def _fallback_target_path(self):
+        """Infer the target file: a backticked filename in the problem, else a placeholder file in the repo, else solution.py."""
+        m = re.search(r'`([\w\-./]+\.[A-Za-z0-9]+)`', self.problem_statement or '')
+        if m:
+            return m.group(1)
+        for root, dirs, files in os.walk(self.git_tempdir):
+            dirs[:] = [d for d in dirs if d not in ('.git', 'node_modules', '__pycache__')]
+            for name in files:
+                if not name.endswith('.py') or name.startswith('test') or '_test' in name:
+                    continue
+                path = os.path.join(root, name)
+                try:
+                    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
+                        if 'Write your solution' in f.read():
+                            return os.path.relpath(path, self.git_tempdir)
+                except OSError:
+                    continue
+        return 'solution.py'
+
+    def _fallback_write_solution(self):
+        """
+        Deterministic fallback: one tool-less LLM call asking for the full file contents,
+        extracted from a fenced code block and written to the target path.
+        """
+        target_rel = self._fallback_target_path()
+        target = os.path.join(self.git_tempdir, target_rel)
+        safe_log(f"Fallback writer: target path is {target_rel}")
+        system_message = "You are an expert competitive programmer. Output only what is requested."
+        prompt = (
+            "Solve the following problem in Python. Use only the standard library.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            f"Output ONLY the full final contents of the file `{target_rel}` inside a single ```python code block. "
+            "No explanation outside the code block."
+        )
+        try:
+            client, client_model = create_client(self.code_model)
+            response, _ = get_response_from_llm(prompt, client, client_model, system_message, msg_history=[], temperature=0.0)
+        except Exception as e:
+            safe_log(f"Fallback writer LLM call failed: {e}", level=logging.ERROR)
+            return False
+        safe_log(f"Fallback writer raw response length: {len(response or '')}")
+        match = re.search(r'```(?:python|py)?[ \t]*\n(.*?)```', response or '', re.S)
+        if not match or not match.group(1).strip():
+            safe_log("Fallback writer: no code block found in response; nothing written.", level=logging.ERROR)
+            return False
+        code = match.group(1)
+        os.makedirs(os.path.dirname(target) or '.', exist_ok=True)
+        with open(target, 'w') as f:
+            f.write(code)
+        safe_log(f"Fallback writer: wrote {len(code)} chars to {target}")
+        return True
 
