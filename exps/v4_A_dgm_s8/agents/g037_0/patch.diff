+PLACEHOLDER_MARKERS = ("pass", "Write your solution here")
+STUB_MAX_BYTES = 300
+
+def _find_target_file(git_tempdir, problem_statement):
+    """
+    Pick the primary non-test source file at the repo root that the agent should implement.
+    Priority: a root file named in the problem statement (e.g. `solution.py`), then a tiny
+    tracked file containing a placeholder. Returns a repo-relative path or None.
+    """
+    try:
+        out = subprocess.run(
+            ["git", "-C", git_tempdir, "ls-files"],
+            capture_output=True, text=True, check=False,
+        ).stdout
+    except Exception:
+        return None
+    candidates = [p for p in out.splitlines() if p and "/" not in p and not _is_test_path(p)]
+    if not candidates:
+        return None
+
+    named = set(re.findall(r"`(\w+\.py)`", problem_statement or ""))
+    for path in candidates:
+        if path in named:
+            return path
+
+    for path in candidates:
+        if not path.endswith(".py"):
+            continue
+        full = os.path.join(git_tempdir, path)
+        try:
+            if os.path.getsize(full) >= STUB_MAX_BYTES:
+                continue
+            with open(full, "r", errors="ignore") as f:
+                content = f.read()
+        except OSError:
+            continue
+        if any(marker in content for marker in PLACEHOLDER_MARKERS):
+            return path
+    return None
+
+def _last_assistant_text(msg_history):
+    """Return the text of the last assistant message in a message history (best effort)."""
+    for msg in reversed(msg_history or []):
+        if msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
+            return "\n".join(t for t in texts if t)
+        return ""
+    return ""
+
