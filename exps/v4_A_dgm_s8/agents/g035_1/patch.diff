+    @staticmethod
+    def _block_field(block, name):
+        if isinstance(block, dict):
+            return block.get(name)
+        return getattr(block, name, None)
+
+    def _is_empty_assistant_message(self, msg):
+        """
+        True if an assistant message has no tool_use block and every content
+        block is absent or a text block with an empty / whitespace-only string.
+        """
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            return False
+        content = msg.get('content')
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return content.strip() == ''
+        for block in content:
+            btype = self._block_field(block, 'type')
+            if btype == 'tool_use':
+                return False
+            if btype == 'text':
+                text = self._block_field(block, 'text')
+                if text is None or str(text).strip() == '':
+                    continue
+                return False
+            if btype is None and block is None:
+                continue
+            return False
+        return True
+
+    def _sanitize_history(self, history):
+        """
+        Return a copy of the message list without assistant messages that are
+        empty (or whitespace-only text with no tool_use), and without a trailing
+        empty assistant message.
+        """
+        cleaned = [m for m in (history or []) if not self._is_empty_assistant_message(m)]
+        # Bounded: drop trailing empty assistant messages, at most len(cleaned) times.
+        for _ in range(len(cleaned)):
+            if cleaned and self._is_empty_assistant_message(cleaned[-1]):
+                cleaned.pop()
+            else:
+                break
+        return cleaned
+
+    def _ends_with_empty_assistant(self, history):
+        return bool(history) and self._is_empty_assistant_message(history[-1])
+
+    def _write_stub_deliverable(self):
+        """
+        If the deliverable path is known and missing, write a minimal stub so a
+        non-empty file exists. Returns the path written, or None.
+        """
+        deliverable = self._deliverable_path()
+        if deliverable is None or os.path.exists(deliverable):
+            return None
+        ext = os.path.splitext(deliverable)[1].lower()
+        stubs = {
+            '.py': "import sys\ndata = sys.stdin.read()\nprint(0)\n",
+            '.cpp': "#include <iostream>\nint main() { return 0; }\n",
+            '.java': "// placeholder\n",
+            '.rs': "fn main() {}\n",
+            '.go': "package main\n\nfunc main() {}\n",
+            '.js': "// placeholder\n",
+        }
+        stub = stubs.get(ext, "# placeholder\n")
+        os.makedirs(os.path.dirname(deliverable), exist_ok=True)
+        with open(deliverable, 'w') as f:
+            f.write(stub)
+        safe_log(f"Wrote placeholder stub deliverable: {deliverable}")
+        return deliverable
+
