+def _read_files_for_prompt(paths, max_chars=6000):
+    """Return '### path' + fenced contents blocks. `paths` is a list of (repo_relative_path, full_path) tuples."""
+    blocks = []
+    for path, full_path in paths:
+        try:
+            with open(full_path, 'r', encoding='utf-8', errors='replace') as f:
+                contents = f.read()
+        except Exception as e:
+            contents = f"<could not read file: {e}>"
+        if len(contents) > max_chars:
+            contents = contents[:max_chars] + "\n...[truncated]"
+        blocks.append(f"### {path}\n```\n{contents}\n```")
+    return "\n\n".join(blocks)
