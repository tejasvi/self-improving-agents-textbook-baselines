@@ -0,0 +1,144 @@
+import difflib
+import os
+import re
+import subprocess
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python program against the sample tests in a problem statement and check EXACT output match.\n
+* Extracts every 'Sample Input k' / 'Sample Output k' pair from the problem text.\n
+* Runs `python3 solution_path` on each sample input (with a timeout) and compares the stdout with the expected sample output.\n
+* Comparison is exact, ignoring only trailing whitespace on each line and trailing blank lines.\n
+* Returns PASS/FAIL per sample; for failures it shows expected output, actual output and a unified diff.\n
+* Any mismatch is a failure, even if the problem says multiple answers are accepted: the grader may compare against the sample output exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python program to run (e.g. /path/to/solution.py)."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "The problem statement text containing the 'Sample Input k' / 'Sample Output k' blocks, OR a path to a file containing it."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+# Matches markers such as "Sample Input 1", "Sample Output 2:", "Sample input 3"
+_MARKER_RE = re.compile(r'sample\s+(input|output)\s*(\d+)\s*:?[ \t]*', re.IGNORECASE)
+# Lines that usually start a new section after a sample block
+_SECTION_RE = re.compile(r'^\s*(#+\s|note\b|notes\b|explanation\b|constraints\b|sample\b|example\b)', re.IGNORECASE)
+_FENCE_RE = re.compile(r'^\s*```.*$')
+
+def _clean_block(lines):
+    """Drop code fence lines and surrounding blank lines."""
+    lines = [l for l in lines if not _FENCE_RE.match(l)]
+    while lines and not lines[0].strip():
+        lines.pop(0)
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return lines
+
+def _extract_block_lines(raw_lines, is_output):
+    """
+    Take the lines belonging to one sample block. Stops at a section heading.
+    For outputs, stops at the first blank line after content has started.
+    """
+    kept = []
+    for line in raw_lines:
+        if _SECTION_RE.match(line) and kept:
+            break
+        if is_output and not line.strip() and kept:
+            break
+        kept.append(line)
+    return _clean_block(kept)
+
+def parse_samples(text):
+    """
+    Return a dict {index: {'input': str, 'output': str}} parsed from the problem text.
+    """
+    matches = list(_MARKER_RE.finditer(text))
+    inputs, outputs = {}, {}
+    for i, m in enumerate(matches):
+        kind = m.group(1).lower()
+        idx = int(m.group(2))
+        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
+        raw_lines = text[m.end():end].split('\n')
+        lines = _extract_block_lines(raw_lines, is_output=(kind == 'output'))
+        body = '\n'.join(lines)
+        if kind == 'input':
+            inputs.setdefault(idx, body)
+        else:
+            outputs.setdefault(idx, body)
+    samples = {}
+    for idx in sorted(set(inputs) & set(outputs)):
+        samples[idx] = {'input': inputs[idx], 'output': outputs[idx]}
+    return samples
+
+def _normalize(text):
+    lines = [l.rstrip() for l in text.replace('\r\n', '\n').split('\n')]
+    while lines and not lines[-1]:
+        lines.pop()
+    return lines
+
+def _load_problem_text(problem_text):
+    if problem_text and os.path.isfile(problem_text):
+        with open(problem_text, 'r', encoding='utf-8', errors='replace') as f:
+            return f.read()
+    return problem_text or ''
+
+def tool_function(solution_path, problem_text=None, timeout=10):
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    text = _load_problem_text(problem_text)
+    samples = parse_samples(text)
+    if not samples:
+        return "Error: no 'Sample Input k' / 'Sample Output k' pairs found in the problem text."
+
+    results = []
+    passed = 0
+    for idx, sample in samples.items():
+        stdin_text = sample['input'] + '\n'
+        expected = sample['output']
+        try:
+            proc = subprocess.run(
+                ['python3', solution_path],
+                input=stdin_text,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            actual = proc.stdout
+            status_extra = ''
+            if proc.returncode != 0:
+                status_extra = f"\nProgram exited with code {proc.returncode}. stderr:\n{proc.stderr}"
+        except subprocess.TimeoutExpired:
+            actual = ''
+            status_extra = f"\nProgram timed out after {timeout} seconds."
+
+        exp_lines = _normalize(expected)
+        act_lines = _normalize(actual)
+        if exp_lines == act_lines and not status_extra:
+            passed += 1
+            results.append(f"Sample {idx}: PASS")
+            continue
+
+        diff = '\n'.join(difflib.unified_diff(
+            exp_lines, act_lines,
+            fromfile=f'expected_sample_{idx}', tofile=f'actual_sample_{idx}', lineterm=''
+        ))
+        results.append(
+            f"Sample {idx}: FAIL{status_extra}\n"
+            f"--- input ---\n{sample['input']}\n"
+            f"--- expected output ---\n{expected}\n"
+            f"--- actual output ---\n{actual}\n"
+            f"--- diff (expected -> actual) ---\n{diff if diff else '(no line differences; check the status note above)'}"
+        )
+
+    summary = f"{passed}/{len(samples)} samples passed."
+    return summary + "\n\n" + "\n\n".join(results)
