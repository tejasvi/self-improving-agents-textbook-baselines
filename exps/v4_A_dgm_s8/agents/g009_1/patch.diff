@@ -0,0 +1,94 @@
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference on randomly generated inputs.\n
+* solution_path and brute_path are Python scripts that read the problem input from standard input and write the answer to standard output.\n
+* generator_path is a Python script that prints ONE random test input to standard output. It is invoked as `python3 generator_path <seed>` with a different integer seed for each case.\n
+* For each case the generator output is fed to both programs; their stdout (whitespace-trimmed) is compared.\n
+* Returns 'ALL PASSED' if every case matches, otherwise the raw first mismatch: the input, the expected output (brute force) and the actual output (solution), plus any raw stderr.\n
+* Each program run is limited by `timeout` seconds.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution script to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the Python brute-force reference script."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the Python random input generator script; it takes an integer seed as its only argument."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random cases to generate. Defaults to 500."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run time limit in seconds for each program invocation. Defaults to 60."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+def _run(script, stdin_text, timeout, args=None):
+    cmd = [sys.executable, script] + [str(a) for a in (args or [])]
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return -1, out, err, True
+
+def tool_function(solution_path, brute_path, generator_path, num_cases=500, timeout=60):
+    try:
+        num_cases = int(num_cases) if num_cases is not None else 500
+    except (TypeError, ValueError):
+        num_cases = 500
+    try:
+        timeout = float(timeout) if timeout is not None else 60.0
+    except (TypeError, ValueError):
+        timeout = 60.0
+
+    for seed in range(num_cases):
+        code, gen_out, gen_err, gen_to = _run(generator_path, None, timeout, args=[seed])
+        if code != 0 or gen_to:
+            return (f"Generator failed on seed {seed}.\nRETURN CODE: {code}\nTIMED OUT: {gen_to}\n"
+                    f"STDOUT:\n{gen_out}\nSTDERR:\n{gen_err}")
+        test_input = gen_out
+
+        b_code, b_out, b_err, b_to = _run(brute_path, test_input, timeout)
+        s_code, s_out, s_err, s_to = _run(solution_path, test_input, timeout)
+
+        if b_code != 0 or b_to:
+            return (f"Brute force failed on seed {seed} (fix the brute force first).\nINPUT:\n{test_input}\n"
+                    f"RETURN CODE: {b_code}\nTIMED OUT: {b_to}\nSTDERR:\n{b_err}")
+
+        if s_code != 0 or s_to or s_out.strip() != b_out.strip():
+            return (f"MISMATCH at seed {seed}\n"
+                    f"INPUT:\n{test_input}\n"
+                    f"EXPECTED (brute force):\n{b_out}\n"
+                    f"ACTUAL (solution):\n{s_out}\n"
+                    f"SOLUTION RETURN CODE: {s_code}\nSOLUTION TIMED OUT: {s_to}\n"
+                    f"SOLUTION STDERR:\n{s_err}")
+
+    return "ALL PASSED"
