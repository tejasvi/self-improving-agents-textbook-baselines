+    def _classify_diff(self):
+        """
+        Classify the current repo diff versus base_commit.
+        Returns 'empty' (no changed files), 'test_only' (all changed files are test files), or 'ok'.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        paths = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.+?) b/(.+)$', line)
+            if m:
+                paths.append(m.group(2))
+        if not paths:
+            return 'empty'
+        def is_test(path):
+            parts = path.split('/')
+            if any(part in ('test', 'tests') for part in parts[:-1]):
+                return True
+            name = parts[-1]
+            return bool(
+                name.startswith('test_') or '_test.' in name or '.spec.' in name
+                or name == 'test' or name.startswith('test.')
+            )
+        if all(is_test(p) for p in paths):
+            return 'test_only'
+        return 'ok'
+
