+    def _sanitize_history(self, msg_history):
+        """
+        Remove trailing assistant messages that carry no content: every block is a text
+        block with empty/whitespace text and there are no tool_use blocks.
+        Returns a new list; None or non-list input yields [].
+        """
+        if not isinstance(msg_history, list):
+            return []
+        history = list(msg_history)
+        while history:
+            last = history[-1]
+            if not isinstance(last, dict) or last.get('role') != 'assistant':
+                break
+            content = last.get('content')
+            if isinstance(content, str):
+                empty = content.strip() == ''
+            elif isinstance(content, list):
+                empty = True
+                for block in content:
+                    if not isinstance(block, dict) or block.get('type') == 'tool_use':
+                        empty = False
+                        break
+                    if block.get('type') != 'text' or (block.get('text') or '').strip() != '':
+                        empty = False
+                        break
+            else:
+                empty = content is None
+            if not empty:
+                break
+            history.pop()
+        return history
+
+    def _candidate_targets(self, files):
+        """
+        Order non-test files so that likely target files (solution.* / main.*) come first.
+        """
+        def rank(path):
+            base = path.replace('\\', '/').split('/')[-1].lower()
+            if base.startswith('solution.') or base == 'solution':
+                return 0
+            if base.startswith('main.') or base == 'main':
+                return 1
+            return 2
+        candidates = [f for f in files if not self._is_test_file(f)]
+        return sorted(candidates, key=rank)
+
+    def _target_file(self):
+        """
+        Pick the most likely target file among tracked non-test files (solution.* / main.* first).
+        """
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            tracked = [f for f in result.stdout.decode(errors='replace').splitlines() if f]
+        except Exception:
+            tracked = []
+        candidates = self._candidate_targets(tracked)
+        return candidates[0] if candidates else 'the solution source file'
+
+    def _repo_context(self, max_files=5, max_bytes=5 * 1024):
+        """
+        Build a string with the tracked (non-test) file listing and the contents of a few small,
+        likely-target files, so the model can see the stub it has to edit.
+        """
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            tracked = result.stdout.decode(errors='replace').splitlines()
+        except Exception as e:
+            safe_log(f"[repo_context] git ls-files failed: {e}")
+            tracked = []
+        non_test = [f for f in tracked if f and not self._is_test_file(f)]
+
+        sections = []
+        shown = 0
+        for rel in self._candidate_targets(non_test):
+            if shown >= max_files:
+                break
+            path = os.path.join(self.git_tempdir, rel)
+            try:
+                if not os.path.isfile(path) or os.path.getsize(path) > max_bytes:
+                    continue
+                with open(path, 'r', errors='replace') as f:
+                    content = f.read()
+            except Exception as e:
+                safe_log(f"[repo_context] failed to read {rel}: {e}")
+                continue
+            sections.append(f"--- {rel} ---\n{content}")
+            shown += 1
+
+        listing = '\n'.join(non_test) if non_test else '(no tracked non-test files)'
+        contents = '\n\n'.join(sections) if sections else '(no small source files to display)'
+        return (
+            f"# Repository files (tracked, non-test)\n{listing}\n\n"
+            f"# Contents of likely target files\n{contents}\n"
+        )
+
