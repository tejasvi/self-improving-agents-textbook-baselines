+def _is_empty_content(content):
+    """True if message content carries no text: empty/whitespace string, or a list whose blocks are all empty text blocks."""
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ''
+    if isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict) and block.get('type') == 'text' and str(block.get('text', '')).strip() == '':
+                continue
+            return False
+        return True
+    return False
+
+def _sanitize_history(msg_history):
+    """Drop messages whose content is empty (empty string or only empty text blocks).
+    Empty assistant turns otherwise get treated as a final answer and break retries."""
+    cleaned = []
+    for m in msg_history or []:
+        if isinstance(m, dict) and _is_empty_content(m.get('content')):
+            continue
+        cleaned.append(m)
+    return cleaned
+
