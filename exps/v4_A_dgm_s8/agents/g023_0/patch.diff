new file mode 100644
index 0000000..1bea204
--- /dev/null
+++ b/tools/run_with_timeout.py
@@ -0,0 +1,81 @@
+import shlex
+import subprocess
+import sys
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a Python script with a hard time limit and return its exit code, wall time, and truncated stdout/stderr.\n
+* Runs `python script_path` with stdin closed (DEVNULL), so the script must not wait for input.\n
+* Use this instead of running long or heavy scripts (e.g. performance tests, stress tests) directly in bash or via heredocs; it avoids hanging the shell and garbled output.\n
+* If the script exceeds timeout_sec, it is killed and 'TIMEOUT after N seconds' is returned together with any partial output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "script_path": {
+                    "type": "string",
+                    "description": "Path to the Python script to run."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Hard time limit in seconds (default 30)."
+                },
+                "args": {
+                    "type": "string",
+                    "description": "Optional command-line arguments passed to the script, as a single shell-style string."
+                }
+            },
+            "required": ["script_path"]
+        }
+    }
+
+def _truncate(text):
+    if text is None:
+        return ""
+    if isinstance(text, bytes):
+        text = text.decode("utf-8", errors="replace")
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n...<{len(text) - MAX_OUTPUT_CHARS} chars truncated>...\n" + text[-half:]
+
+def tool_function(script_path, timeout_sec=30, args=None):
+    try:
+        timeout_val = float(timeout_sec) if timeout_sec is not None else 30.0
+    except (TypeError, ValueError):
+        timeout_val = 30.0
+    if timeout_val <= 0:
+        timeout_val = 30.0
+    extra = shlex.split(args) if isinstance(args, str) and args.strip() else []
+
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, script_path] + extra,
+            timeout=timeout_val,
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            text=True,
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        partial_out = _truncate(e.stdout)
+        partial_err = _truncate(e.stderr)
+        return (
+            f"TIMEOUT after {timeout_val:g} seconds (elapsed {elapsed:.2f}s)\n"
+            f"--- partial stdout ---\n{partial_out}\n"
+            f"--- partial stderr ---\n{partial_err}"
+        )
+    except Exception as e:
+        return f"ERROR running script: {e}"
+
+    elapsed = time.time() - start
+    return (
+        f"exit code: {proc.returncode}\n"
+        f"wall time: {elapsed:.2f}s\n"
+        f"--- stdout ---\n{_truncate(proc.stdout)}\n"
+        f"--- stderr ---\n{_truncate(proc.stderr)}"
+    )
