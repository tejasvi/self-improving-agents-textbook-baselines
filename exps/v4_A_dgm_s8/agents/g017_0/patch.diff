+def _last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in msg_history ('' if none/empty).
+    Handles plain-string content and Claude-style lists of blocks.
+    """
+    if not msg_history:
+        return ""
+    for msg in reversed(msg_history):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            texts = []
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and block.get('text'):
+                        texts.append(block['text'])
+                elif getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                    texts.append(block.text)
+            return "\n".join(texts)
+        return ""
+    return ""
+
+def _extract_last_code_block(text):
+    """
+    Return the content of the last ```python (or bare ```) fenced block in text, or None.
+    """
+    if not text:
+        return None
+    blocks = re.findall(r'```(?:python|py)?[ \t]*\n(.*?)```', text, re.DOTALL)
+    if not blocks:
+        return None
+    code = blocks[-1].strip('\n')
+    return code + "\n" if code.strip() else None
