+    def _fallback_write_solution(self, deliverable):
+        """
+        Tool-free LLM request for only the full solution; writes the last fenced code block
+        to the deliverable file. Returns True if the file was written.
+        """
+        current = self._read_deliverable(deliverable)
+        prompt = f"""Write the complete solution for the following competitive programming problem in Python.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+The file `{deliverable}` currently contains:
+```python
+{current}
+```
+
+Respond with ONLY the complete, final contents of `{deliverable}` inside a single ```python fenced code block. Do not include any other code blocks, explanations, or tool calls.
+"""
+        safe_log(f"[fallback] requesting full solution for {deliverable} without tools")
+        try:
+            client, client_model = create_client(self.code_model)
+            content, _ = get_response_from_llm(
+                prompt, client=client, model=client_model,
+                system_message="You are an expert competitive programmer. Output only code.",
+                msg_history=[],
+            )
+        except Exception as e:
+            safe_log(f"[fallback] LLM request failed: {e}")
+            return False
+        code = _extract_last_code_block(content)
+        if not code:
+            safe_log("[fallback] no fenced code block found in response")
+            return False
+        with open(os.path.join(self.git_tempdir, deliverable), 'w') as fh:
+            fh.write(code)
+        safe_log(f"[fallback] wrote {len(code)} chars to {deliverable}")
+        return True
