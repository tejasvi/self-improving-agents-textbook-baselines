+    def _find_deliverable_file(self):
+        """
+        Pick the most likely main source file from tracked files in git_tempdir.
+        Returns a relative path or None.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        files = [f.strip() for f in result.stdout.decode(errors='replace').splitlines() if f.strip()]
+        candidates = []
+        for f in files:
+            base = os.path.basename(f)
+            lower = f.lower()
+            if base.startswith('.') or any(part.startswith('.') for part in f.split('/')):
+                continue
+            if lower.endswith(('.md', '.markdown', '.rst', '.txt')) or 'readme' in lower or 'license' in lower:
+                continue
+            if self._is_test_path(f):
+                continue
+            candidates.append(f)
+        if not candidates:
+            return None
+        preferred = ['solution.py', 'main.py']
+        for name in preferred:
+            for f in candidates:
+                if os.path.basename(f) == name:
+                    return f
+        # Stub-like: small file consisting only of comments/blank lines
+        for f in candidates:
+            try:
+                with open(os.path.join(self.git_tempdir, f), 'r', errors='replace') as fh:
+                    lines = [l.strip() for l in fh.read().splitlines() if l.strip()]
+            except OSError:
+                continue
+            if lines and all(l.startswith('#') for l in lines):
+                return f
+        py = [f for f in candidates if f.endswith('.py')]
+        return py[0] if py else candidates[0]
+
+    def _read_deliverable(self, deliverable):
