+def _changed_files(diff):
+    """
+    Parse 'diff --git a/X b/X' header lines and return the list of file paths.
+    """
+    files = []
+    for line in str(diff).splitlines():
+        if line.startswith('diff --git '):
+            parts = line.split(' ')
+            # Expected format: diff --git a/<path> b/<path>
+            if len(parts) >= 4 and parts[2].startswith('a/'):
+                path = parts[2][2:]
+                if path not in files:
+                    files.append(path)
+    return files
+
+def _is_source_file(path):
+    """
+    Return False for paths that look like test files, True otherwise.
+    """
+    norm = path.replace('\\', '/')
+    base = norm.split('/')[-1]
+    if norm.startswith('tests/') or norm.startswith('test/') or '/tests/' in norm or '/test/' in norm:
+        return False
+    if base.startswith('test_') and base.endswith('.py'):
+        return False
+    if base.endswith('_test.py'):
+        return False
+    if '.spec.' in base:
+        return False
+    if base.endswith('_test.go'):
+        return False
+    return True
+
