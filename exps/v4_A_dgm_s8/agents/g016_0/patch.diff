+    def _changed_files(self):
+        """
+        Return the list of files changed in git_tempdir versus base_commit,
+        including untracked files.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "-uall"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        files = []
+        for line in result.stdout.decode('utf-8', errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            if ' -> ' in path:  # renamed: keep the new path
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                files.append(path)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Heuristically decide whether a path refers to a test file.
+        """
+        normalized = path.replace('\\', '/')
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        dirs = parts[:-1]
+        if any(d in ('tests', 'test') for d in dirs):
+            return True
+        return any(fnmatch.fnmatch(basename, pat) for pat in (
+            'test_*.py', '*_test.*', '*.spec.*',
+        ))
+
+    def _deliverable_path(self):
+        """
+        If the problem statement names a deliverable file (e.g. `solution.py`
+        after the word 'in'), return its absolute path; otherwise None.
+        """
+        match = re.search(r"\bin\s+`([\w./-]+\.(?:py|cpp|java|rs|go|js))`", self.problem_statement or '')
+        if not match:
+            return None
+        return os.path.join(self.git_tempdir, match.group(1))
+
+    def _has_source_edit(self):
+        """
+        True if at least one changed non-test file exists, and the deliverable
+        (if the problem names one) exists and is non-empty.
+        """
+        changed = self._changed_files()
+        if not any(not self._is_test_file(f) for f in changed):
+            return False
+        deliverable = self._deliverable_path()
+        if deliverable is not None:
+            if not os.path.isfile(deliverable) or os.path.getsize(deliverable) == 0:
+                return False
+        return True
+
