+    def _changed_files(self, diff):
+        """
+        Parse the file paths touched by a git diff, from its `diff --git a/X b/Y` headers.
+        """
+        files = []
+        for line in (diff or '').splitlines():
+            match = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+            if match:
+                path = match.group(2)
+                if path not in files:
+                    files.append(path)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Generic heuristic: True if the path looks like a test file.
+        """
+        parts = [p for p in path.replace('\\', '/').split('/') if p]
+        if not parts:
+            return False
+        test_dirs = {'test', 'tests', 'spec', '__tests__'}
+        if any(p.lower() in test_dirs for p in parts[:-1]):
+            return True
+        basename = parts[-1].lower()
+        if basename in test_dirs:
+            return True
+        if basename.startswith('test_'):
+            return True
+        if re.search(r'_test\.[^.]+$', basename):
+            return True
+        if re.search(r'\.(test|spec)\.[^.]+$', basename):
+            return True
+        return False
+
