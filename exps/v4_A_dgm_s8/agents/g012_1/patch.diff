diff --git a/tools/timed_run.py b/tools/timed_run.py
new file mode 100644
index 0000000..1826313
--- /dev/null
+++ b/tools/timed_run.py
@@ -0,0 +1,97 @@
+import os
+import signal
+import subprocess
+import time
+from subprocess import DEVNULL
+
+DEFAULT_TIMEOUT_SECONDS = 10
+MAX_OUTPUT_CHARS = 10000
+
+
+def tool_info():
+    return {
+        "name": "timed_run",
+        "description": """Run a shell command with a hard time limit and report its output, exit code and wall-clock time.\n
+* Use this tool for benchmarks and any command that may run for a long time (e.g. timing a solution on max-size input).\n
+* The command runs with no stdin. If it exceeds `timeout_seconds`, its whole process group is killed and the result says 'TIMED OUT'. The shell session is never left in a bad state.\n
+* Prefer writing test/benchmark scripts to files (using the editor tool) and running them here, rather than long heredocs, which echo noisily.\n
+* Keep `timeout_seconds` small (e.g. 5-10 for a benchmark) so that slow solutions fail fast and can be optimized.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run (executed with `bash -c`)."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": f"Hard time limit in seconds before the command is killed. Defaults to {DEFAULT_TIMEOUT_SECONDS}."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+
+def tool_function(command, timeout_seconds=None):
+    if not command:
+        return "Error: no command provided."
+    try:
+        timeout = float(timeout_seconds) if timeout_seconds is not None else float(DEFAULT_TIMEOUT_SECONDS)
+    except (TypeError, ValueError):
+        return f"Error: invalid timeout_seconds: {timeout_seconds}"
+    if timeout <= 0:
+        return "Error: timeout_seconds must be positive."
+
+    start = time.time()
+    # start_new_session=True puts the child in its own process group so the whole group can be killed.
+    proc = subprocess.Popen(
+        ["bash", "-c", command],
+        stdin=DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+        elapsed = time.time() - start
+        return (
+            f"STDOUT:\n{_truncate(stdout or '')}\n"
+            f"STDERR:\n{_truncate(stderr or '')}\n"
+            f"RETURN CODE: {proc.returncode}\n"
+            f"ELAPSED: {elapsed:.3f}s"
+        )
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except Exception:
+            stdout, stderr = "", ""
+        elapsed = time.time() - start
+        return (
+            f"TIMED OUT after {int(timeout) if timeout == int(timeout) else timeout}s "
+            f"(process group killed).\n"
+            f"STDOUT:\n{_truncate(stdout or '')}\n"
+            f"STDERR:\n{_truncate(stderr or '')}\n"
+            f"RETURN CODE: none (killed)\n"
+            f"ELAPSED: {elapsed:.3f}s"
+        )
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: python timed_run.py '<command>' [timeout_seconds]")
+    else:
+        t = float(sys.argv[2]) if len(sys.argv) > 2 else None
+        print(tool_function(sys.argv[1], t))
