+def _is_text_block(block):
+    if isinstance(block, dict):
+        return block.get('type') == 'text'
+    return getattr(block, 'type', None) == 'text'
+
+def _block_text(block):
+    if isinstance(block, dict):
+        return block.get('text')
+    return getattr(block, 'text', None)
+
+def _sanitize_history(msg_history):
+    """
+    Return a new history with empty/whitespace-only text blocks removed, messages with no
+    remaining content dropped, and trailing empty assistant turns removed. tool_use and
+    tool_result blocks are kept intact so tool pairing stays valid.
+    """
+    if not msg_history:
+        return []
+    cleaned = []
+    for msg in msg_history:
+        if isinstance(msg, dict):
+            role = msg.get('role')
+            content = msg.get('content')
+        else:
+            role = getattr(msg, 'role', None)
+            content = getattr(msg, 'content', None)
+        if isinstance(content, str):
+            if not content.strip():
+                continue
+            new_content = content
+        elif isinstance(content, list):
+            new_content = []
+            for block in content:
+                if _is_text_block(block):
+                    text = _block_text(block)
+                    if not isinstance(text, str) or not text.strip():
+                        continue
+                if block is None:
+                    continue
+                new_content.append(block)
+            if not new_content:
+                continue
+        else:
+            continue
+        if isinstance(msg, dict):
+            new_msg = dict(msg)
+            new_msg['content'] = new_content
+        else:
+            new_msg = {'role': role, 'content': new_content}
+        cleaned.append(new_msg)
+    # Remove trailing assistant turns with no content
+    while cleaned and cleaned[-1].get('role') == 'assistant' and not cleaned[-1].get('content'):
+        cleaned.pop()
+    return cleaned
+
