+    def _patch_is_valid(self, patch):
+        """
+        A patch is valid only if it is non-empty and modifies at least one file
+        that is not a test/spec file. Parses 'diff --git a/<path> b/<path>' headers.
+        """
+        if not patch or not patch.strip():
+            return False
+        changed_paths = []
+        for line in patch.splitlines():
+            if line.startswith('diff --git '):
+                parts = line.split()
+                # Expected form: diff --git a/<path> b/<path>
+                if len(parts) >= 4:
+                    path = parts[3]
+                    if path.startswith('b/'):
+                        path = path[2:]
+                    changed_paths.append(path)
+        for path in changed_paths:
+            lowered = path.lower()
+            in_tests_dir = any(seg == 'tests' for seg in lowered.split('/')[:-1])
+            if 'test' in lowered or 'spec' in lowered or in_tests_dir:
+                continue
+            return True
+        return False
+
