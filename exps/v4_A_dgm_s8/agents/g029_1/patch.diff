+CANDIDATE_MAX_BYTES = 4000
+READ_MAX_CHARS = 20000
+
+def _git_list_files(git_dir):
+    """Tracked plus untracked (not ignored) file paths, relative to git_dir."""
+    files = []
+    for args in (["git", "-C", git_dir, "ls-files"],
+                 ["git", "-C", git_dir, "ls-files", "--others", "--exclude-standard"]):
+        try:
+            res = subprocess.run(args, capture_output=True, text=True, timeout=60)
+            files.extend(line.strip() for line in res.stdout.splitlines() if line.strip())
+        except Exception:
+            pass
+    return list(dict.fromkeys(files))
+
+def _find_target_files(git_dir, problem_statement, limit=3):
+    """Pick candidate non-test source files, preferring files named in the statement and small stubs."""
+    candidates = []
+    for rel in _git_list_files(git_dir):
+        if _is_test_path(rel):
+            continue
+        full = os.path.join(git_dir, rel)
+        if not os.path.isfile(full):
+            continue
+        try:
+            size = os.path.getsize(full)
+        except OSError:
+            continue
+        base = os.path.basename(rel)
+        mentioned = base in (problem_statement or "")
+        if not mentioned and size > CANDIDATE_MAX_BYTES:
+            continue
+        candidates.append((0 if mentioned else 1, size, rel))
+    candidates.sort()
+    return [rel for _, _, rel in candidates[:limit]]
+
+def _read_file(path):
+    """Read a file's text (truncated); returns an explanatory string on failure."""
+    try:
+        with open(path, 'r', errors='replace') as f:
+            text = f.read(READ_MAX_CHARS + 1)
+        if len(text) > READ_MAX_CHARS:
+            text = text[:READ_MAX_CHARS] + "\n... (truncated)"
+        return text
+    except Exception as e:
+        return f"(could not read {path}: {e})"
+
+def _last_assistant_text(msg_history):
+    """Concatenate text of the last assistant message in a history (dict or SDK block forms)."""
+    for msg in reversed(msg_history or []):
+        if msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content
+        parts = []
+        for block in content or []:
+            if isinstance(block, dict):
+                if block.get("type") == "text":
+                    parts.append(block.get("text", ""))
+            elif getattr(block, "type", None) == "text":
+                parts.append(getattr(block, "text", ""))
+        return "\n".join(parts)
+    return ""
+
+def _extract_code_block(text):
+    """Return the first fenced code block's body, or None."""
+    m = re.search(r"```(?:python|py)?[ \t]*\n(.*?)```", text or "", re.DOTALL)
+    if not m:
+        return None
+    code = m.group(1).strip("\n")
+    return code + "\n" if code.strip() else None
+
