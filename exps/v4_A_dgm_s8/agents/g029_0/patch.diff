@@ -0,0 +1,175 @@
+import os
+import signal
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "time_solution",
+        "description": """Time a solution on a (typically max-size) input and return the raw results.\n
+* Provide the program in one of three ways: `command` (run with `sh -c`), `python_code` (written to `file_path` and run with python3), or `module_call` (a Python snippet run with `python3 -c` in the current working directory, e.g. 'from solution import Solution; print(Solution().maxDistance(...))').\n
+* Optional `setup_script`: path to a Python generator script. It is run first (not timed) and its STDOUT is used as the program's standard input, unless `stdin_text` is given.\n
+* Optional `stdin_text`: text written to the program's standard input.\n
+* Set `repeat` (1-5) to run the program several times; each run's ELAPSED is reported, along with the maximum.\n
+* If a run does not finish within `timeout` seconds, its whole process group is killed. The output is returned raw: STDOUT, STDERR, RETURN CODE, TIMED OUT flag and ELAPSED time.\n
+* Use this for performance checks against the problem's constraints (aim for well under the time limit, e.g. under 2 seconds at max size).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "Shell command to run (executed with sh -c). Use this OR python_code OR module_call."
+                },
+                "python_code": {
+                    "type": "string",
+                    "description": "Python source code to write to file_path and run with python3."
+                },
+                "file_path": {
+                    "type": "string",
+                    "description": "Path where python_code is written (required when python_code is given)."
+                },
+                "module_call": {
+                    "type": "string",
+                    "description": "Python snippet executed with python3 -c in the current directory, e.g. 'from solution import Solution; print(Solution().maxDistance(...))'."
+                },
+                "setup_script": {
+                    "type": "string",
+                    "description": "Path to a Python generator script whose STDOUT becomes the program's stdin (not timed)."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Optional text written to the program's standard input (overrides setup_script output)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Time limit in seconds for each run before it is killed. Defaults to 5."
+                },
+                "repeat": {
+                    "type": "integer",
+                    "description": "Number of times to run the program (1 to 5). Defaults to 1."
+                }
+            },
+            "required": []
+        }
+    }
+
+
+def _run_once(cmd, stdin_text, timeout):
+    start = time.time()
+    timed_out = False
+    try:
+        proc = subprocess.Popen(
+            cmd,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,  # own process group so the whole tree can be killed
+            text=True,
+        )
+    except Exception as e:
+        return f"STDOUT:\n\nSTDERR:\nFailed to start command: {e}\nRETURN CODE: -1\nTIMED OUT: False\nELAPSED: 0.00s", 0.0, False
+
+    try:
+        stdout, stderr = proc.communicate(input=stdin_text, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except Exception:
+            stdout, stderr = "", ""
+    except Exception as e:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        elapsed = time.time() - start
+        return f"STDOUT:\n\nSTDERR:\nError while running command: {e}\nRETURN CODE: -1\nTIMED OUT: False\nELAPSED: {elapsed:.2f}s", elapsed, False
+
+    elapsed = time.time() - start
+    text = (
+        f"STDOUT:\n{stdout or ''}\n"
+        f"STDERR:\n{stderr or ''}\n"
+        f"RETURN CODE: {proc.returncode}\n"
+        f"TIMED OUT: {timed_out}\n"
+        f"ELAPSED: {elapsed:.2f}s"
+    )
+    return text, elapsed, timed_out
+
+
+def tool_function(
+    command=None,
+    python_code=None,
+    file_path=None,
+    module_call=None,
+    setup_script=None,
+    stdin_text=None,
+    timeout=5,
+    repeat=1,
+):
+    try:
+        timeout = float(timeout) if timeout is not None else 5.0
+    except (TypeError, ValueError):
+        timeout = 5.0
+    try:
+        repeat = int(repeat) if repeat is not None else 1
+    except (TypeError, ValueError):
+        repeat = 1
+    repeat = max(1, min(5, repeat))
+
+    # Build the program command.
+    if command:
+        cmd = ["sh", "-c", command]
+    elif python_code is not None:
+        if not file_path:
+            return "ERROR: file_path is required when python_code is given."
+        try:
+            os.makedirs(os.path.dirname(os.path.abspath(file_path)), exist_ok=True)
+            with open(file_path, "w") as f:
+                f.write(python_code)
+        except Exception as e:
+            return f"ERROR: could not write python_code to {file_path}: {e}"
+        cmd = ["python3", file_path]
+    elif module_call:
+        cmd = ["python3", "-c", module_call]
+    else:
+        return "ERROR: provide one of command, python_code (with file_path), or module_call."
+
+    # Generate input with the setup script (not timed).
+    if stdin_text is None and setup_script:
+        try:
+            gen = subprocess.run(
+                ["python3", setup_script],
+                capture_output=True,
+                text=True,
+                timeout=max(timeout, 30.0),
+            )
+        except subprocess.TimeoutExpired:
+            return f"ERROR: setup_script {setup_script} timed out."
+        except Exception as e:
+            return f"ERROR: setup_script {setup_script} failed to run: {e}"
+        if gen.returncode != 0:
+            return (
+                f"ERROR: setup_script {setup_script} exited with RETURN CODE {gen.returncode}.\n"
+                f"STDERR:\n{gen.stderr}"
+            )
+        stdin_text = gen.stdout
+
+    sections = []
+    times = []
+    any_timeout = False
+    for i in range(repeat):
+        text, elapsed, timed_out = _run_once(cmd, stdin_text, timeout)
+        times.append(elapsed)
+        any_timeout = any_timeout or timed_out
+        header = f"--- run {i + 1}/{repeat} ---\n" if repeat > 1 else ""
+        sections.append(header + text)
+
+    summary = f"SUMMARY: runs={repeat} max_elapsed={max(times):.2f}s any_timed_out={any_timeout} time_limit={timeout}s"
+    if repeat > 1:
+        summary += " elapsed_per_run=[" + ", ".join(f"{t:.2f}s" for t in times) + "]"
+    return summary + "\n" + "\n".join(sections)
