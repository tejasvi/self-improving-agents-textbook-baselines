+    def _extract_samples(self):
+        """
+        Extract (index, input, expected_output) triples from 'Sample Input N' /
+        'Sample Output N' blocks in self.problem_statement.
+        """
+        text = str(self.problem_statement).replace('\r\n', '\n')
+        pattern = re.compile(
+            r'Sample Input\s*(\d+)[ \t]*:?[ \t]*\n'
+            r'(.*?)\n[ \t]*Sample Output\s*\1[ \t]*:?[ \t]*\n'
+            r'(.*?)(?=\n[ \t]*\n|\n[ \t]*Sample Input|\n[ \t]*Explanation|\n[ \t]*Note\b|\Z)',
+            re.DOTALL | re.IGNORECASE,
+        )
+        samples = []
+        for match in pattern.finditer(text):
+            idx = int(match.group(1))
+            inp = '\n'.join(l for l in match.group(2).split('\n') if not l.strip().startswith('```')).strip()
+            out = '\n'.join(l for l in match.group(3).split('\n') if not l.strip().startswith('```')).strip()
+            samples.append((idx, inp + '\n', out))
+        return samples
+
+    def _check_samples(self):
+        """
+        Run `python3 solution.py` in git_tempdir on every extracted sample and return
+        a list of raw mismatch records (dicts with index, input, expected, actual).
+        Returns an empty list if there is no solution.py or no samples were found.
+        """
+        if not os.path.isfile(os.path.join(self.git_tempdir, 'solution.py')):
+            return []
+        mismatches = []
+        for idx, inp, expected in self._extract_samples():
+            try:
+                proc = subprocess.run(
+                    ['python3', 'solution.py'],
+                    input=inp,
+                    capture_output=True,
+                    text=True,
+                    cwd=self.git_tempdir,
+                    timeout=20,
+                )
+                actual = proc.stdout
+                if proc.returncode != 0 or proc.stderr.strip():
+                    actual += f"\n[stderr]\n{proc.stderr}\n[exit code {proc.returncode}]"
+            except subprocess.TimeoutExpired as e:
+                actual = f"[timed out after 20 seconds]\n{e.stdout or ''}"
+            if ' '.join(actual.split()) != ' '.join(expected.split()):
+                mismatches.append({'index': idx, 'input': inp, 'expected': expected, 'actual': actual})
+        return mismatches
+
