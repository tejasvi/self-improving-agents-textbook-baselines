+    def _patch_is_acceptable(self):
+        """
+        True only if the diff against base_commit is non-empty, contains at least one
+        non-test file, and (when solution.py exists in the repo) includes solution.py.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        if not diff.strip():
+            return False
+
+        changed = []
+        for line in diff.splitlines():
+            if line.startswith("diff --git "):
+                parts = line.split()
+                # format: diff --git a/<path> b/<path>
+                if len(parts) >= 4 and parts[2].startswith("a/"):
+                    changed.append(parts[2][2:])
+
+        def is_test_file(path):
+            norm = path.replace("\\", "/")
