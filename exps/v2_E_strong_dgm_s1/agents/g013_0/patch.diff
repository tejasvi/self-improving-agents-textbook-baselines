+            return (name.startswith("test") or name.endswith("_test.py")
+                    or "tests/" in norm or norm.startswith("tests/"))
+
+        if not any(not is_test_file(f) for f in changed):
+            return False
+
+        if os.path.exists(os.path.join(self.git_tempdir, "solution.py")):
+            if not filter_patch_by_files(diff, ["solution.py"]).strip():
+                return False
+        return True
