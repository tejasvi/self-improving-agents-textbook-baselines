+import os
+import signal
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a candidate stdin/stdout Python program against a reference program using a seeded generator script.
+* The generator is a Python script run as `python3 gen_path SEED`; it prints one test input to stdout.
+* For seeds 0..n_cases-1 it runs the generator, the reference and the candidate, and compares whitespace-tokenized stdout.
+* Returns the pass count and the first counterexample (input, expected output, actual output, stderr tail of the candidate). If all cases pass it says so.
+* Set time_input_path to a large input file instead to time the candidate on that file (wall time, with a hard timeout) and report whether it finished in time.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "ref_path": {"type": "string", "description": "Path to the reference (correct, slow is fine) Python program."},
+                "cand_path": {"type": "string", "description": "Path to the candidate Python program to test."},
+                "gen_path": {"type": "string", "description": "Path to the generator script; called as `python3 gen_path SEED` and prints one input."},
+                "n_cases": {"type": "integer", "description": "Number of seeds to test (seeds 0..n_cases-1). Default 300."},
+                "timeout_s": {"type": "integer", "description": "Hard timeout in seconds for each program run. Default 10."},
+                "mode": {"type": "string", "description": "Program type. Only 'stdin' is supported (programs read stdin, write stdout). Default 'stdin'."},
+                "time_input_path": {"type": "string", "description": "Optional. If given, skip stress testing and only time the candidate on this input file."}
+            },
+            "required": ["ref_path", "cand_path", "gen_path"]
+        }
+    }
+
+def _clip(s, n=1500):
+    s = (s or '').strip()
+    return s if len(s) <= n else s[: n // 2] + " ... " + s[-n // 2:]
+
+def _run(cmd, stdin_text, timeout_s, cwd=None):
+    """Run cmd; returns (status, stdout, stderr, elapsed). status is OK, ERROR or TIMEOUT."""
+    t0 = time.time()
+    try:
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, cwd=cwd, start_new_session=True)
+    except OSError as e:
+        return 'ERROR', '', f'failed to start: {e}', 0.0
+    try:
+        out, err = p.communicate(stdin_text, timeout=timeout_s)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'TIMEOUT', '', f'killed after {timeout_s}s', time.time() - t0
+    el = time.time() - t0
+    if p.returncode != 0:
+        return 'ERROR', out or '', (err or '') + f'\n(exit code {p.returncode})', el
+    return 'OK', out or '', err or '', el
+
+def _time_only(cand_path, time_input_path, timeout_s):
+    try:
+        with open(time_input_path, 'r', encoding='utf-8', errors='replace') as f:
+            data = f.read()
+    except OSError as e:
+        return f"ERROR: cannot read time_input_path: {e}"
+    status, out, err, el = _run(['python3', cand_path], data, timeout_s)
+    if status != 'OK':
+        return f"TIME {status} after {el:.2f}s (limit {timeout_s}s).\nStderr tail:\n{_clip(err)}"
+    return f"TIME OK: {el:.2f}s (limit {timeout_s}s). Output head: {_clip(out, 200)}"
+
+def tool_function(ref_path, cand_path, gen_path, n_cases=300, timeout_s=10, mode='stdin', time_input_path=None):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 10), 120))
+    except Exception:
+        timeout_s = 10
+    if mode not in (None, '', 'stdin'):
+        return f"ERROR: unsupported mode {mode!r}; only 'stdin' is supported."
+    ref_path = os.path.abspath(str(ref_path))
+    cand_path = os.path.abspath(str(cand_path))
+    gen_path = os.path.abspath(str(gen_path))
+    for p in (ref_path, cand_path, gen_path):
+        if not os.path.isfile(p):
+            return f"ERROR: file not found: {p}"
+    if time_input_path:
+        return _time_only(cand_path, os.path.abspath(str(time_input_path)), timeout_s)
+    try:
+        n_cases = max(1, min(int(n_cases or 300), 5000))
+    except Exception:
+        n_cases = 300
+
+    passed = 0
+    for seed in range(n_cases):
+        st, inp, gerr, _ = _run(['python3', gen_path, str(seed)], '', timeout_s)
+        if st != 'OK' or not inp.strip():
+            return f"ERROR: generator failed on seed {seed} ({st}). Stderr:\n{_clip(gerr)}\nPassed {passed}/{n_cases} before this."
+        st, exp, rerr, _ = _run(['python3', ref_path], inp, timeout_s)
+        if st != 'OK':
+            return f"ERROR: reference failed on seed {seed} ({st}). Stderr:\n{_clip(rerr)}\nPassed {passed}/{n_cases} before this."
+        st, act, cerr, el = _run(['python3', cand_path], inp, timeout_s)
+        if st == 'OK' and act.split() == exp.split():
+            passed += 1
+            continue
+        return (
+            f"FAIL on seed {seed} ({st}). Passed {passed}/{n_cases} before this.\n"
+            f"Input:\n{inp.strip()}\n"
+            f"Expected:\n{_clip(exp)}\n"
+            f"Actual:\n{_clip(act)}\n"
+            f"Candidate stderr tail:\n{_clip(cerr)}"
+        )
+    return f"PASS: {passed}/{n_cases} random cases agree with the reference."
