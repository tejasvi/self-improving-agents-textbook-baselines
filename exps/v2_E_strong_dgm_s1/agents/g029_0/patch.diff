+            except subprocess.TimeoutExpired:
+                rep['timing_note'] = f'max-size run TIMEOUT (>{TIME_LIMIT_S * 4}s)'
+            except OSError as e:
+                rep['timing_note'] = f'could not run timing: {e}'
+        return reports
