+    def _judge(self, cands):
+        """
+        Plain-Python judge. For each (k, path, truncated) in cands: check samples, compare with ref.py
+        on random seeds, and time a max-size input. Returns a list of report dicts.
+        """
+        wd = self._work_dir()
+        ref_path = os.path.join(wd, 'ref.py')
+        gen_path = os.path.join(wd, 'gen.py')
+        samples = self._extract_samples()
+        reports = []
+        for k, path, truncated in cands:
+            rep = {'k': k, 'path': path, 'samples_ok': False, 'sample_fail': '', 'agree': 0,
+                   'n': JUDGE_CASES, 'cex': None, 'time': None, 'timing_ok': False, 'timing_note': '',
+                   'truncated': truncated, 'exists': os.path.isfile(path)}
+            reports.append(rep)
+            if not rep['exists'] or not self._compiles(path):
+                rep['sample_fail'] = 'cand file missing or does not compile'
+                continue
+            fails = self._run_samples_on(path, samples)
+            rep['sample_fail'] = "\n".join(fails)
+            rep['samples_ok'] = not fails
+            # random agreement with the reference (stop at first disagreement)
+            for seed in range(JUDGE_CASES):
+                inp = ''
+                try:
+                    g = subprocess.run(['python3', gen_path, str(seed)], capture_output=True, text=True,
+                                       timeout=10, cwd=self.git_tempdir)
+                    inp = g.stdout
+                    if g.returncode != 0 or not inp.strip():
+                        rep['timing_note'] = 'generator failed; no random agreement check'
+                        break
+                    r = subprocess.run(['python3', ref_path], input=inp, capture_output=True, text=True,
+                                       timeout=10, cwd=self.git_tempdir)
+                    c = subprocess.run(['python3', path], input=inp, capture_output=True, text=True,
+                                       timeout=JUDGE_TIMEOUT, cwd=self.git_tempdir)
+                except (subprocess.TimeoutExpired, OSError):
+                    rep['cex'] = {'input': inp, 'expected': '',
+                                  'actual': 'TIMEOUT or OS error', 'stderr': ''}
+                    break
+                if r.returncode != 0:
+                    rep['timing_note'] = 'reference failed on a random case'
+                    break
+                if c.returncode == 0 and c.stdout.split() == r.stdout.split():
+                    rep['agree'] += 1
+                    continue
+                rep['cex'] = {'input': inp.strip(), 'expected': r.stdout.strip(),
+                              'actual': c.stdout.strip(), 'stderr': '\n'.join(c.stderr.strip().splitlines()[-8:])}
+                break
+            # max-size timing run
+            try:
+                g = subprocess.run(['python3', gen_path, '0', 'max'], capture_output=True, text=True,
+                                   timeout=10, cwd=self.git_tempdir)
+                if g.returncode == 0 and g.stdout.strip():
+                    t0 = time.time()
+                    c = subprocess.run(['python3', path], input=g.stdout, capture_output=True, text=True,
+                                       timeout=TIME_LIMIT_S * 4, cwd=self.git_tempdir)
+                    rep['time'] = time.time() - t0
+                    rep['timing_ok'] = c.returncode == 0 and rep['time'] <= TIME_LIMIT_S
+                    if not rep['timing_ok']:
+                        rep['timing_note'] = (f"max-size run took {rep['time']:.2f}s (limit {TIME_LIMIT_S}s)"
+                                              f"{'; error: ' + c.stderr.strip()[-300:] if c.returncode else ''}")
+                else:
