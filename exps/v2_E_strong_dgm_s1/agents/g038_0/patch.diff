+    def _tolerance(self):
+        """Numeric tolerance stated in the statement (e.g. 'absolute or relative error 10^-6'), or None."""
+        text = self.problem_statement or ''
+        m = re.search(r"(?:absolute or relative error|error)[^.]*?(?:10\^\{?-(\d+)\}?|1e-(\d+))", text, re.I)
+        if not m:
+            return None
+        digits = m.group(1) or m.group(2)
+        try:
+            return 10.0 ** -int(digits)
+        except (TypeError, ValueError):
+            return None
+
+    @staticmethod
+    def _as_float(tok):
+        try:
+            v = float(tok)
+        except ValueError:
+            return None
+        return v if math.isfinite(v) else None
+
+    def _outputs_match(self, actual, expected):
+        """Token-by-token comparison: exact equality, or numeric within tolerance when one is stated."""
+        a, b = actual.split(), expected.split()
+        if len(a) != len(b):
+            return False
+        tol = self._tolerance()
+        for x, y in zip(a, b):
+            if x == y:
+                continue
+            if tol is None:
+                return False
+            fa, fb = self._as_float(x), self._as_float(y)
+            if fa is None or fb is None:
+                return False
+            if not abs(fa - fb) <= tol * max(1.0, abs(fb)):
+                return False
+        return True
+
+    def _float_noise_note(self, actual, expected):
+        """If the first differing tokens are floats with relative difference < 1e-9, return a note; else ''."""
+        a, b = actual.split(), expected.split()
+        if len(a) != len(b):
+            return ''
+        for x, y in zip(a, b):
+            if x == y:
+                continue
+            fa, fb = self._as_float(x), self._as_float(y)
+            if fa is None or fb is None:
+                return ''
+            denom = max(abs(fb), 1e-300)
+            if abs(fa - fb) / denom < 1e-9 and ('.' in x or 'e' in x.lower() or '.' in y or 'e' in y.lower()):
+                return ("Note: the differing tokens are floats whose relative difference is below 1e-9; "
+                        "this difference is only float rounding; if the statement allows an error tolerance this is fine.")
+            return ''
+        return ''
+
