@@ -0,0 +1,147 @@
+import glob
+import os
+import signal
+import subprocess
+import time
+
+MAX_TOKEN_SHOW = 120   # max characters shown for a single differing token
+MAX_STDERR_TAIL = 600  # max characters of stderr shown for a crash
+MAX_DIFF_TOKENS = 5    # how many differing token pairs to show per WRONG sample
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run the solution on every sample test case and report the status of each sample.\n
+* Globs `sample*.in` in `samples_dir` (default: current directory). For each input file, the solution is run with stdin taken from that file.\n
+* Its stdout is compared with the matching `sample*.out` file (same base name) after whitespace normalization (tokens are compared).\n
+* Each sample is reported on one line as PASS, WRONG (with the first differing tokens), TIMEOUT, CRASH (non-zero exit, with the stderr tail) or NOEXP (no matching .out file), together with the elapsed time.\n
+* Use this tool after writing solution.py to verify it on all provided samples. A TIMEOUT on a large sample means the algorithm is too slow and must be replaced, not that the task is done.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin and writing stdout, e.g. 'python3 solution.py'."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing sample*.in and sample*.out files. Optional; defaults to the current working directory."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each sample run. Optional; default 5."
+                }
+            },
+            "required": ["solution_cmd"]
+        }
+    }
+
+
+def _cwd():
+    try:
+        from tools import bash as _bash
+        cwd = _bash._STATE.get('cwd')
+        if cwd and os.path.isdir(cwd):
+            return cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+def _clip(s, n):
+    if len(s) <= n:
+        return s
+    return s[:n] + "..."
+
+
+def _run_one(solution_cmd, in_path, cwd, timeout):
+    """Returns (status, stdout, stderr, elapsed)."""
+    start = time.time()
+    with open(in_path, 'rb') as fin:
+        proc = subprocess.Popen(
+            solution_cmd, shell=True, stdin=fin,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            cwd=cwd, start_new_session=True,
+        )
+        try:
+            out, err = proc.communicate(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except OSError:
+                pass
+            proc.communicate()
+            return 'TIMEOUT', '', '', time.time() - start
+    elapsed = time.time() - start
+    out_s = out.decode('utf-8', errors='replace')
+    err_s = err.decode('utf-8', errors='replace')
+    if proc.returncode != 0:
+        return 'CRASH', out_s, err_s, elapsed
+    return 'OK', out_s, err_s, elapsed
+
+
+def _compare(got_text, exp_text):
+    got = got_text.split()
+    exp = exp_text.split()
+    if got == exp:
+        return None
+    diffs = []
+    for i in range(max(len(got), len(exp))):
+        g = got[i] if i < len(got) else '<EOF>'
+        e = exp[i] if i < len(exp) else '<EOF>'
+        if g != e:
+            diffs.append(f"token {i}: expected {_clip(e, MAX_TOKEN_SHOW)!r} got {_clip(g, MAX_TOKEN_SHOW)!r}")
+            if len(diffs) >= MAX_DIFF_TOKENS:
+                break
+    if not diffs:
+        diffs.append("differing token count")
+    return "; ".join(diffs)
+
+
+def tool_function(solution_cmd, samples_dir=None, timeout=5):
+    if not solution_cmd:
+        return "Error: solution_cmd is required."
+    try:
+        timeout = int(timeout) if timeout is not None else 5
+    except (TypeError, ValueError):
+        timeout = 5
+    timeout = max(1, min(timeout, 300))
+    cwd = samples_dir if samples_dir else _cwd()
+    if not os.path.isdir(cwd):
+        return f"Error: samples_dir {cwd!r} is not a directory."
+
+    in_files = sorted(glob.glob(os.path.join(cwd, 'sample*.in')))
+    if not in_files:
+        return f"No sample*.in files found in {cwd}."
+
+    lines = []
+    counts = {}
+    for in_path in in_files:
+        name = os.path.basename(in_path)
+        exp_path = in_path[:-3] + '.out'
+        status, out, err, elapsed = _run_one(solution_cmd, in_path, cwd, timeout)
+        if status == 'TIMEOUT':
+            line = f"{name}: TIMEOUT (limit {timeout}s)"
+        elif status == 'CRASH':
+            tail = err.strip()[-MAX_STDERR_TAIL:] if err.strip() else '(no stderr)'
+            line = f"{name}: CRASH (exit code non-zero) stderr tail: {tail}"
+        elif not os.path.exists(exp_path):
+            status = 'NOEXP'
+            line = f"{name}: NOEXP (no matching {os.path.basename(exp_path)} file)"
+        else:
+            with open(exp_path, 'r', errors='replace') as f:
+                exp = f.read()
+            diff = _compare(out, exp)
+            if diff is None:
+                status = 'OK'
+                line = f"{name}: PASS"
+            else:
+                line = f"{name}: WRONG {diff}"
+                status = 'WRONG'
+        key = 'PASS' if status == 'OK' else status
+        counts[key] = counts.get(key, 0) + 1
+        lines.append(f"{line} [{elapsed:.2f}s]")
+
+    summary = ", ".join(f"{k}={v}" for k, v in sorted(counts.items()))
+    return f"Ran {len(in_files)} sample(s) with `{solution_cmd}` in {cwd}: {summary}\n" + "\n".join(lines)
