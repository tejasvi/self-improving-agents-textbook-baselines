+def _has_body(text):
+    """True if `text` has more than the starter stub (imports, signature-only defs, pass/...)."""
+    for raw in text.splitlines():
+        s = raw.strip()
+        if not s or s.startswith("#") or s.startswith("import ") or s.startswith("from ") \
+                or s == "pass" or s == "...":
+            continue
+        if s.startswith("class ") or s.startswith("def "):
+            # Signature-only lines are not body; one-liners like "def f(): return 1" are.
+            _, _, tail = s.partition(":")
+            if not tail.strip() or tail.strip() == "pass":
+                continue
+        return True
+    return False
+
+
+def _clip_text(s, n=3000):
+    s = s or ""
+    return s if len(s) <= n else s[: n // 2] + "\n... <truncated> ...\n" + s[-n // 2:]
 
