+import sys
+from tools import cross_check
+
+
+def _write(tmp_path, name, body):
+    p = tmp_path / name
+    p.write_text(body)
+    return f"{sys.executable} {p}"
+
+
+def test_schema_is_well_formed():
+    s = cross_check.tool_info()["input_schema"]
+    assert set(s) == {"type", "properties", "required"}
+    assert set(s["required"]) == {"solution_cmds", "generator_cmd"}
+    for name, prop in s["properties"].items():
+        assert "type" in prop and "description" in prop, name
+
+
+def test_agreement_and_disagreement(tmp_path):
+    gen = _write(tmp_path, "gen.py", "import sys\nprint(sys.argv[2])\nprint(sys.argv[1])\n")
+    same = _write(tmp_path, "same.py", "print(input(), input())\n")
+    other = _write(tmp_path, "other.py", "a=input(); b=input(); print(a, 'x' if b=='0' else b)\n")
+    res = cross_check.run_cross_check([same, same], gen, scales=[1, 5], seeds_per_scale=2, timeout=5,
+                                      cwd=str(tmp_path))
+    assert res["all_passed"] and res["passes"] == [4, 4]
+    res = cross_check.run_cross_check([same, other], gen, scales=[1, 5], seeds_per_scale=2, timeout=5,
+                                      cwd=str(tmp_path))
+    assert not res["all_passed"]
+    assert "disagree" in res["text"]
+    assert "--- output of" in res["text"]
+
+
+def test_timeout_and_crash_do_not_raise(tmp_path):
+    gen = _write(tmp_path, "gen.py", "print(1)\nprint(2)\n")
+    slow = _write(tmp_path, "slow.py", "import time; time.sleep(5)\n")
+    crash = _write(tmp_path, "crash.py", "raise SystemExit(3)\n")
+    res = cross_check.run_cross_check([slow, crash], gen, scales=[1], seeds_per_scale=1, timeout=1,
+                                      cwd=str(tmp_path))
+    assert res["error"] is None
+    assert not res["all_passed"]
+    txt = cross_check.tool_function([crash], "does_not_exist_gen", scales=[1], seeds_per_scale=1,
+                                    timeout=1)
+    assert isinstance(txt, str)
+
+
+def test_warns_when_largest_scale_is_small(tmp_path):
+    gen = _write(tmp_path, "gen.py", "print(1)\nprint(2)\n")
+    ok = _write(tmp_path, "ok.py", "print('Yes')\n")
+    txt = cross_check.tool_function([ok], gen, scales=[1, 2], seeds_per_scale=1, timeout=5)
+    assert "WARNING" in txt and "largest scale" in txt
