+"""Differential testing of several solutions against each other, a brute-force
+reference, or a checker. Reuses the process helpers of stress_test.py.
+"""
+import os
+import shutil
+import tempfile
+import time
+from collections import Counter
+
+try:
+    from tools.stress_test import _run, _clip, _cwd, _norm
+except ImportError:  # pragma: no cover
+    from stress_test import _run, _clip, _cwd, _norm
+
+MAX_SHOW = 1500
+DEFAULT_SCALES = [1, 2, 3, 5, 8]
+SKEW_THRESHOLD = 0.9
+SMALL_INPUT_TOKENS = 50  # below this, the largest scale is not considered exercised
+
+
+def tool_info():
+    return {
+        "name": "cross_check",
+        "description": """Differential testing: run several solutions on the same generated inputs and compare them.\n
+* `solution_cmds` is a list of shell commands (e.g. ["python3 solution.py", "python3 alt_solution.py"]); each reads one input on stdin and writes its answer to stdout.\n
+* `generator_cmd` is run as `<generator_cmd> <seed> <scale>` and must print one test input to stdout.\n
+* Every seed in range(seeds_per_scale) is run for every scale. Each run has a `timeout` in seconds; timeouts and crashes are reported, not raised.\n
+* Verdict: with `checker_cmd` (run as `<checker_cmd> input_file output_file [reference_output_file]`, exit code 0 = valid) each output is validated independently; this is the right choice when several answers are valid. With `reference_cmd` (a brute force) outputs must match its normalized output. Otherwise all solutions' normalized outputs must agree with each other.\n
+* Reports: per-solution pass counts, the first failure (truncated input plus every solution's output), the largest input size seen, the max runtime per solution, and the distribution of the first output token with a warning when one class is over 90% of the cases or when no test came close to the largest scale.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmds": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of shell commands, one per solution, each reading stdin and writing stdout. E.g. [\"python3 solution.py\", \"python3 alt_solution.py\"]."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command invoked as '<generator_cmd> seed scale' that prints one test input to stdout, e.g. 'python3 gen.py'."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "List of integer scales passed to the generator. Default [1, 2, 3, 5, 8]."
+                },
+                "seeds_per_scale": {
+                    "type": "integer",
+                    "description": "Number of seeds (0 .. seeds_per_scale-1) to run for each scale. Default 20."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each single run of the generator, a solution, the reference or the checker. Default 10."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command invoked as '<checker_cmd> input_file output_file [reference_output_file]'; exit code 0 means the output is valid."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Optional brute-force reference command reading stdin; its normalized output is the expected answer."
+                }
+            },
+            "required": ["solution_cmds", "generator_cmd"]
+        }
+    }
+
+
+def _input_size(text):
+    """(number of whitespace tokens, largest absolute integer token)."""
+    tokens = text.split()
+    max_int = 0
+    for t in tokens:
+        try:
+            v = abs(int(t))
+        except ValueError:
+            continue
+        if v > max_int:
+            max_int = v
+    return len(tokens), max_int
+
+
+def _public(info):
+    if info is None:
+        return None
+    return {k: v for k, v in info.items() if not k.startswith("_")}
+
+
+def _timed_run(cmd, cwd, timeout, stdin_path=None, args=()):
+    t0 = time.time()
+    st, out, err = _run(cmd, cwd, timeout, stdin_path=stdin_path, args=args)
+    return st, out, err, time.time() - t0
+
+
+def run_cross_check(solution_cmds, generator_cmd, scales=None, seeds_per_scale=20,
+                    timeout=10, checker_cmd=None, reference_cmd=None, cwd=None):
+    """Returns a dict: {'error', 'text', 'all_passed', 'passes', 'total', 'max_tokens',
+    'max_int', 'max_scale', 'max_scale_tokens', 'max_runtime', 'first_token_counts', 'first_failure'}.
+    Never raises."""
+    tmpdir = tempfile.mkdtemp(prefix="cross_")
+    try:
+        return _cross(solution_cmds, generator_cmd, scales, seeds_per_scale, timeout,
+                      checker_cmd, reference_cmd, tmpdir, cwd)
+    except Exception as e:
+        return {"error": f"cross_check failed internally: {type(e).__name__}: {e}"}
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def _cross(solution_cmds, generator_cmd, scales, seeds_per_scale, timeout,
+           checker_cmd, reference_cmd, tmpdir, cwd=None):
+    if isinstance(solution_cmds, str):
+        solution_cmds = [solution_cmds]
+    solution_cmds = [str(c) for c in (solution_cmds or []) if str(c).strip()]
+    if not solution_cmds or not generator_cmd:
+        return {"error": "solution_cmds (non-empty list) and generator_cmd are required."}
+    scales = [int(s) for s in scales] if scales else list(DEFAULT_SCALES)
+    try:
+        seeds_per_scale = int(seeds_per_scale) if seeds_per_scale is not None else 20
+    except (TypeError, ValueError):
+        seeds_per_scale = 20
+    seeds_per_scale = max(1, min(seeds_per_scale, 100000))
+    try:
+        timeout = int(timeout) if timeout else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    timeout = max(1, min(timeout, 300))
+    cwd = cwd if cwd and os.path.isdir(cwd) else _cwd()
+    mode = "checker" if checker_cmd else ("reference" if reference_cmd else "pairwise-agreement")
+
+    in_path = os.path.join(tmpdir, "input.txt")
+    out_paths = [os.path.join(tmpdir, f"out_{i}.txt") for i in range(len(solution_cmds))]
+    ref_path = os.path.join(tmpdir, "ref_out.txt")
+
+    n = len(solution_cmds)
+    max_scale = max(scales)
+    passes = [0] * n
+    max_runtime = [0.0] * n
+    total = 0
+    total_pass = 0
+    first_token_counts = Counter()
+    max_tokens = 0
+    max_int = 0
+    max_scale_tokens = 0   # largest input size seen at the largest scale
+    max_scale_tests = 0    # number of tests run at the largest scale
+    first_failure = None   # the smallest failing input (generator failures are reported last)
+
+    def consider_failure(info):
+        nonlocal first_failure
+        if info.get("input") is None:
+            key = (1, 0)
+        else:
+            key = (0, len(info["input"]))
+        if first_failure is None:
+            first_failure = info
+            first_failure["_key"] = key
+        elif key < first_failure["_key"]:
+            first_failure = info
+            first_failure["_key"] = key
+
+    for scale in scales:
+        for seed in range(seeds_per_scale):
+            total += 1
+            st, gen_out, gen_err, _ = _timed_run(generator_cmd, cwd, timeout, args=[seed, scale])
+            if st != "ok":
+                consider_failure(dict(kind=f"generator {st}", scale=scale, seed=seed, input=None,
+                                      outs=[], ref=None, info=gen_err))
+                continue
+            with open(in_path, "w") as f:
+                f.write(gen_out)
+            tok, mi = _input_size(gen_out)
+            max_tokens = max(max_tokens, tok)
+            max_int = max(max_int, mi)
+            if scale == max_scale:
+                max_scale_tests += 1
+                max_scale_tokens = max(max_scale_tokens, tok)
+
+            ref_text = None
+            if reference_cmd:
+                st, ro, re_, _ = _timed_run(reference_cmd, cwd, timeout, stdin_path=in_path)
+                if st != "ok":
+                    consider_failure(dict(kind=f"reference {st}", scale=scale, seed=seed,
+                                          input=gen_out, outs=[], ref=None, info=re_))
+                    continue
+                ref_text = ro
+                with open(ref_path, "w") as f:
+                    f.write(ro)
+
+            results = []
+            for i, cmd in enumerate(solution_cmds):
+                st, so, se, dt = _timed_run(cmd, cwd, timeout, stdin_path=in_path)
+                max_runtime[i] = max(max_runtime[i], dt)
+                results.append((st, so, se))
+                with open(out_paths[i], "w") as f:
+                    f.write(so)
+
+            ok_outs = [_norm(r[1]) for r in results if r[0] == "ok"]
+            if ok_outs:
+                first_token_counts[ok_outs[0][0] if ok_outs[0] else "<empty>"] += 1
+            # Consensus for pairwise mode: the most common normalized output.
+            consensus = None
+            if not checker_cmd and not reference_cmd and len(ok_outs) == n and n > 0:
+                cnt = Counter(tuple(o) for o in ok_outs)
+                top, top_c = cnt.most_common(1)[0]
+                if top_c > n / 2 or n == 1:
+                    consensus = list(top)
+
+            verdicts = []
+            reasons = []
+            for i, (st, so, se) in enumerate(results):
+                if st != "ok":
+                    verdicts.append(False)
+                    reasons.append(f"solution {i} {st}")
+                    continue
+                if checker_cmd:
+                    args = [in_path, out_paths[i]] + ([ref_path] if ref_text is not None else [])
+                    cst, co, ce, _ = _timed_run(checker_cmd, cwd, timeout, args=args)
+                    verdicts.append(cst == "ok")
+                    if cst != "ok":
+                        reasons.append(f"checker rejected solution {i} ({cst})")
+                elif ref_text is not None:
+                    good = _norm(so) == _norm(ref_text)
+                    verdicts.append(good)
+                    if not good:
+                        reasons.append(f"solution {i} differs from reference")
+                else:
+                    good = consensus is not None and _norm(so) == consensus
+                    verdicts.append(good)
+                    if not good:
+                        reasons.append(f"solution {i} disagrees with the others")
+
+            for i in range(n):
+                if verdicts[i]:
+                    passes[i] += 1
+            if all(verdicts):
+                total_pass += 1
+            else:
+                consider_failure(dict(kind="; ".join(reasons) or "failure", scale=scale, seed=seed,
+                                      input=gen_out, outs=[
+                                          dict(cmd=solution_cmds[i], status=r[0], output=r[1], err=r[2])
+                                          for i, r in enumerate(results)],
+                                      ref=ref_text, info=""))
+
+    lines = [f"Cross-check: mode={mode}, solutions={n}, scales={scales}, "
+             f"seeds_per_scale={seeds_per_scale}, timeout={timeout}s",
+             f"Total: {total_pass}/{total} tests fully passed"]
+    for i, cmd in enumerate(solution_cmds):
+        lines.append(f"  solution {i} [{cmd}]: {passes[i]}/{total} passed, "
+                     f"max runtime {max_runtime[i]:.2f}s")
+    lines.append(f"Max input size seen: {max_tokens} tokens, largest integer {max_int}; "
+                 f"at the largest scale ({max_scale}): {max_scale_tests} tests, up to {max_scale_tokens} tokens")
+    if max_scale_tests == 0:
+        lines.append(f"WARNING: no test at the largest scale ({max_scale}) was generated; "
+                     "max-size inputs were not exercised.")
+    elif max_scale_tokens < SMALL_INPUT_TOKENS or max_scale_tokens < 0.25 * max_tokens:
+        lines.append(f"WARNING: no test came close to the largest scale: the largest input at scale "
+                     f"{max_scale} has {max_scale_tokens} tokens (largest seen: {max_tokens}). "
+                     "Max-size inputs are not exercised; make the top scale produce near-maximal inputs.")
+    tot_cnt = sum(first_token_counts.values())
+    if tot_cnt:
+        dist = ", ".join(f"{k}: {v}" for k, v in first_token_counts.most_common(8))
+        lines.append(f"First output token distribution: {dist}")
+        top_tok, top_cnt = first_token_counts.most_common(1)[0]
+        if top_cnt / tot_cnt > SKEW_THRESHOLD:
+            lines.append(f"WARNING: answer class '{top_tok}' is {100.0 * top_cnt / tot_cnt:.0f}% of the "
+                         "cases; the generator should balance answer classes.")
+    else:
+        lines.append("First output token distribution: (no successful outputs)")
+
+    if first_failure is None:
+        lines.append("ALL PASSED")
+    else:
+        ff = first_failure
+        lines.append(f"FAILED ({ff['kind']}) at scale={ff['scale']} seed={ff['seed']} "
+                     "(smallest failing input found)")
+        inp = ff.get("input")
+        if inp is not None:
+            if len(inp) <= MAX_SHOW:
+                lines.append("--- input ---\n" + inp.rstrip())
+            else:
+                lines.append(f"--- input (truncated, {len(inp)} chars total) ---\n" + _clip(inp).rstrip())
+        for o in ff.get("outs", []):
+            lines.append(f"--- output of [{o['cmd']}] ({o['status']}) ---\n" + _clip(o['output']).rstrip())
+            if o.get("err") and o["status"] != "ok":
+                lines.append("stderr: " + _clip(o["err"]).rstrip())
+        if ff.get("ref") is not None:
+            lines.append("--- reference output ---\n" + _clip(ff["ref"]).rstrip())
+        if ff.get("info"):
+            lines.append("--- info ---\n" + _clip(ff["info"]).rstrip())
+    return {
+        "error": None,
+        "text": "\n".join(lines),
+        "all_passed": first_failure is None,
+        "passes": passes,
+        "total": total,
+        "total_pass": total_pass,
+        "max_tokens": max_tokens,
+        "max_int": max_int,
+        "max_scale": max_scale,
+        "max_scale_tests": max_scale_tests,
+        "max_scale_tokens": max_scale_tokens,
+        "max_runtime": max_runtime,
+        "first_token_counts": dict(first_token_counts),
+        "first_failure": _public(first_failure),
+    }
+
+
+def tool_function(solution_cmds, generator_cmd, scales=None, seeds_per_scale=20, timeout=10,
+                  checker_cmd=None, reference_cmd=None):
+    res = run_cross_check(solution_cmds, generator_cmd, scales=scales,
+                          seeds_per_scale=seeds_per_scale, timeout=timeout,
+                          checker_cmd=checker_cmd, reference_cmd=reference_cmd)
+    if res.get("error"):
+        return f"Error: {res['error']}"
+    return res["text"]
