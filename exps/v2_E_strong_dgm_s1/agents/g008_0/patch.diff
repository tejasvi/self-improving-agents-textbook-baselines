+    def _split_cases(inp, exp):
+        """
+        If inp is 'T' followed by T cases, return a list of (single_case_input, expected_lines) with the
+        expected output split by line; each single-case input gets the header '1'. Otherwise None.
+        Splitting needs one expected line per case when the expected output has T lines, or otherwise
+        the output is split into T equal line groups only when the counts divide evenly.
+        """
+        lines = inp.strip('\n').split('\n')
+        if not lines or not lines[0].strip().isdigit():
+            return None
+        t = int(lines[0].strip())
+        body = lines[1:]
+        if t <= 1 or t > len(body) or len(body) % t != 0:
+            return None
+        per = len(body) // t
+        out_lines = exp.strip('\n').split('\n') if exp.strip() else []
+        if len(out_lines) == t:
+            outs = [[ln] for ln in out_lines]
+        elif out_lines and len(out_lines) % t == 0:
+            k = len(out_lines) // t
+            outs = [out_lines[i * k:(i + 1) * k] for i in range(t)]
+        else:
+            return None
+        cases = []
+        for i in range(t):
+            single = '1\n' + '\n'.join(body[i * per:(i + 1) * per]) + '\n'
+            cases.append((single, '\n'.join(outs[i])))
+        return cases
