+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+# Harness used for class_method candidates: loads the file, builds Solution(),
+# evaluates the argument expression in the module globals and prints the result.
+_HARNESS = r'''
+import sys, json, importlib.util, os
+spec = json.loads(sys.stdin.read())
+sys.setrecursionlimit(10000)
+sys.path.insert(0, os.path.dirname(os.path.abspath(spec["path"])))
+mod_spec = importlib.util.spec_from_file_location("sol_under_test", spec["path"])
+mod = importlib.util.module_from_spec(mod_spec)
+mod_spec.loader.exec_module(mod)
+args = eval("(" + spec["expr"] + ",)", vars(mod))
+obj = mod.Solution()
+res = getattr(obj, spec["method"])(*args)
+print(res)
+'''
+
+MAX_CASES_PER_RUN = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_suite",
+        "description": """Run a candidate solution against a persistent test suite directory.
+* mode 'class_method' or 'stdin' runs the candidate (same meaning as bench_solution).
+* mode 'compare' runs two candidates (solution_path and other_path) on the same inputs and reports the first disagreement.
+* tests_dir contains optional cases.jsonl (one JSON object per line: {"args": "<python arg expression>", "expected": "<output>"} for class_method, or {"input": "<stdin text>", "expected": "<output>"} for stdin), optional gen.py (run as `python3 gen.py <seed>`, prints one input) and optional brute.py (reference solution, same mode and input format as the candidate; its output is the expected answer).
+* num_random: number of gen.py seeds to run (0..num_random-1). Ignored when there is no gen.py.
+* Output: pass/fail counts, the first failing inputs with expected and actual output (raw error text included), the smallest failing input found (for shrinking), and the slowest case time. Compare mode reports the first disagreement and the smallest disagreeing input.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the candidate solution Python file."},
+                "mode": {"type": "string", "description": "One of 'class_method', 'stdin', or 'compare'. In compare mode, the inputs are run as class_method if method_name is given, otherwise as stdin."},
+                "method_name": {"type": "string", "description": "Name of the Solution method (required for class_method mode; optional for compare)."},
+                "tests_dir": {"type": "string", "description": "Directory holding cases.jsonl, gen.py and brute.py (any may be missing)."},
+                "num_random": {"type": "integer", "description": "How many gen.py seeds to run (default 100)."},
+                "other_path": {"type": "string", "description": "Second candidate file, used only in compare mode."},
+                "max_report": {"type": "integer", "description": "Maximum number of failing inputs to print in full (default 5)."},
+                "timeout_s": {"type": "integer", "description": "Per-input hard timeout in seconds (default 5)."}
+            },
+            "required": ["solution_path", "mode", "tests_dir"]
+        }
+    }
+
+
+def _clip(s, n=400):
+    s = (s or '').strip()
+    return s if len(s) <= n else s[: n // 2] + " ... " + s[-n // 2:]
+
+
+def _run(cmd, stdin_text, cwd, timeout_s):
+    """Run a command in its own process group; returns (status, elapsed, stdout, stderr)."""
+    t0 = time.time()
+    try:
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, cwd=cwd, start_new_session=True)
+    except Exception as e:
+        return 'ERROR', time.time() - t0, '', f'failed to start: {e}'
+    try:
+        out, err = p.communicate(stdin_text, timeout=timeout_s)
+        el = time.time() - t0
+        if p.returncode != 0:
+            return 'ERROR', el, out or '', (err or '') + f'\n(exit code {p.returncode})'
+        return 'OK', el, out or '', err or ''
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'TIMEOUT', time.time() - t0, '', f'killed after {timeout_s}s'
+
+
+def _run_candidate(path, mode, method_name, payload, timeout_s):
+    """Run one candidate on one input. payload is an args expression (class_method) or stdin text."""
+    cwd = os.path.dirname(os.path.abspath(path))
+    if mode == 'class_method':
+        req = json.dumps({'path': os.path.abspath(path), 'method': method_name, 'expr': payload})
+        return _run([sys.executable, '-c', _HARNESS], req, cwd, timeout_s)
+    return _run([sys.executable, os.path.abspath(path)], payload, cwd, timeout_s)
+
+
+def _norm(s):
+    """Whitespace-insensitive comparison: strip each line's trailing spaces and the outer blank lines."""
+    if not isinstance(s, str):
+        s = str(s)
+    return '\n'.join(line.rstrip() for line in s.strip().splitlines())
+
+
+def _load_cases(tests_dir, mode):
+    """Return list of (source, payload, expected_or_None) from cases.jsonl."""
+    path = os.path.join(tests_dir, 'cases.jsonl')
+    cases = []
+    if not os.path.isfile(path):
+        return cases, None
+    with open(path) as f:
+        for lineno, line in enumerate(f, 1):
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                obj = json.loads(line)
+            except Exception as e:
+                return cases, f'cases.jsonl line {lineno} is not valid JSON: {e}'
+            key = 'args' if mode == 'class_method' else 'input'
+            if key not in obj:
+                key = 'args' if 'args' in obj else 'input'
+            if key not in obj:
+                return cases, f'cases.jsonl line {lineno} has no "args"/"input" field'
+            exp = obj.get('expected', None)
+            cases.append((f'cases.jsonl:{lineno}', str(obj[key]), None if exp is None else exp))
+    return cases, None
+
+
+def _gen_inputs(tests_dir, num_random, timeout_s):
+    """Run gen.py with seeds 0..num_random-1; returns (list of (source, payload), error_text)."""
+    gen = os.path.join(tests_dir, 'gen.py')
+    if not os.path.isfile(gen) or num_random <= 0:
+        return [], None
+    items = []
+    for seed in range(num_random):
+        status, _, out, err = _run([sys.executable, os.path.abspath(gen), str(seed)], '', tests_dir, timeout_s)
+        if status != 'OK':
+            return items, f'gen.py failed for seed {seed}: {_clip(err)}'
+        items.append((f'gen.py seed {seed}', out))
+    return items, None
+
+
+def _evaluate(solution_path, mode, method_name, tests_dir, num_random, timeout_s, max_report):
+    """Core evaluation. Returns a dict with counts, failures and timing."""
+    result = {'passed': 0, 'failed': 0, 'total': 0, 'max_time': 0.0, 'max_time_source': None,
+              'failures': [], 'smallest_failure': None, 'setup_error': None}
+    cases, err = _load_cases(tests_dir, mode)
+    if err:
+        result['setup_error'] = err
+        return result
+    gen_items, err = _gen_inputs(tests_dir, num_random, timeout_s)
+    if err:
+        result['setup_error'] = err
+        return result
+    brute = os.path.join(tests_dir, 'brute.py')
+    have_brute = os.path.isfile(brute)
+    items = [(s, p, e) for s, p, e in cases] + [(s, p, None) for s, p in gen_items]
+    items = items[:MAX_CASES_PER_RUN]
+    if not items:
+        result['setup_error'] = 'no test cases: add cases.jsonl or gen.py in ' + tests_dir
+        return result
+
+    for source, payload, expected in items:
+        result['total'] += 1
+        if expected is None:
+            if not have_brute:
+                result['total'] -= 1
+                continue
+            rs, _, rout, rerr = _run_candidate(brute, mode, method_name, payload, timeout_s)
+            if rs != 'OK':
+                # The reference itself failed on this input: report it, do not count the candidate.
+                result['total'] -= 1
+                result.setdefault('reference_errors', []).append(
+                    {'source': source, 'input': payload, 'error': _clip(rerr)})
+                continue
+            expected = rout
+        status, el, out, err = _run_candidate(solution_path, mode, method_name, payload, timeout_s)
+        if el > result['max_time']:
+            result['max_time'] = el
+            result['max_time_source'] = source
+        if status == 'OK' and _norm(out) == _norm(expected):
+            result['passed'] += 1
+            continue
+        result['failed'] += 1
+        fail = {'source': source, 'input': payload, 'expected': _clip(_norm(expected), 300),
+                'actual': _clip(out if status == 'OK' else (err or status), 300), 'status': status,
+                'time': round(el, 3)}
+        if status != 'OK':
+            fail['actual'] = f'{status}: ' + _clip(err or '', 300)
+        result['failures'].append(fail)
+        if result['smallest_failure'] is None or len(payload) < len(result['smallest_failure']['input']):
+            result['smallest_failure'] = fail
+    return result
+
+
+def _evaluate_compare(sol_a, sol_b, mode, method_name, tests_dir, num_random, timeout_s, max_report):
+    """Run two candidates on the same inputs; report disagreements (no reference needed)."""
+    result = {'total': 0, 'agree': 0, 'disagree': 0, 'first': None, 'smallest': None,
+              'max_time': 0.0, 'setup_error': None}
+    cases, err = _load_cases(tests_dir, mode)
+    gen_items, gerr = _gen_inputs(tests_dir, num_random, timeout_s)
+    if err or gerr:
+        result['setup_error'] = err or gerr
+        return result
+    items = [(s, p) for s, p, _ in cases] + gen_items
+    if not items:
+        result['setup_error'] = 'no inputs: add cases.jsonl or gen.py in ' + tests_dir
+        return result
+    for source, payload in items[:MAX_CASES_PER_RUN]:
+        result['total'] += 1
+        sa, ea, oa, era = _run_candidate(sol_a, mode, method_name, payload, timeout_s)
+        sb, eb, ob, erb = _run_candidate(sol_b, mode, method_name, payload, timeout_s)
+        result['max_time'] = max(result['max_time'], ea, eb)
+        ra = _norm(oa) if sa == 'OK' else f'{sa}: {_clip(era, 200)}'
+        rb = _norm(ob) if sb == 'OK' else f'{sb}: {_clip(erb, 200)}'
+        if ra == rb:
+            result['agree'] += 1
+            continue
+        result['disagree'] += 1
+        rec = {'source': source, 'input': payload, 'output_a': _clip(ra, 300), 'output_b': _clip(rb, 300)}
+        if result['first'] is None:
+            result['first'] = rec
+        if result['smallest'] is None or len(payload) < len(result['smallest']['input']):
+            result['smallest'] = rec
+    return result
+
+
+def _format_fail(i, f):
+    return (f"  [{i}] {f['source']} time={f.get('time', 0)}s status={f['status']}\n"
+            f"      input:    {_clip(f['input'], 300)!r}\n"
+            f"      expected: {f['expected']!r}\n"
+            f"      actual:   {f['actual']!r}")
+
+
+def _format_report(solution_path, mode, method_name, r, max_report):
+    if r['setup_error']:
+        return f"Error: {r['setup_error']}"
+    lines = [f"Suite run of {solution_path} ({mode}{', ' + method_name if method_name else ''})",
+             f"PASS {r['passed']}/{r['total']}  FAIL {r['failed']}  max_time {r['max_time']:.3f}s"
+             + (f" (on {r['max_time_source']})" if r['max_time_source'] else '')]
+    if r.get('reference_errors'):
+        lines.append(f"Reference (brute.py) errors on {len(r['reference_errors'])} inputs, e.g.:")
+        for e in r['reference_errors'][:2]:
+            lines.append(f"  input {_clip(e['input'], 120)!r}: {e['error']}")
+    if r['failures']:
+        lines.append(f"First {min(max_report, len(r['failures']))} failing inputs:")
+        for i, f in enumerate(r['failures'][:max_report]):
+            lines.append(_format_fail(i, f))
+        sm = r['smallest_failure']
+        lines.append("SMALLEST FAILING INPUT (shrink this first):")
+        lines.append(_format_fail('min', sm))
+    else:
+        lines.append("All tests passed." if r['total'] else "No tests ran.")
+    return "\n".join(lines)
+
+
+def _format_compare(sol_a, sol_b, r, max_report):
+    if r['setup_error']:
+        return f"Error: {r['setup_error']}"
+    lines = [f"Compare {sol_a} vs {sol_b}: agree {r['agree']}/{r['total']}, disagree {r['disagree']}, "
+             f"max_time {r['max_time']:.3f}s"]
+    if r['first']:
+        f = r['first']
+        lines.append(f"FIRST DISAGREEMENT ({f['source']}):\n  input: {_clip(f['input'], 300)!r}\n"
+                     f"  A: {f['output_a']!r}\n  B: {f['output_b']!r}")
+        s = r['smallest']
+        lines.append(f"SMALLEST DISAGREEING INPUT (shrink this first): {_clip(s['input'], 300)!r}\n"
+                     f"  A: {s['output_a']!r}\n  B: {s['output_b']!r}")
+    else:
+        lines.append("Candidates agree on all inputs.")
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, mode, tests_dir, method_name=None, num_random=100,
+                  other_path=None, max_report=5, timeout_s=5):
+    try:
+        num_random = max(0, min(int(num_random if num_random is not None else 100), 1000))
+        max_report = max(1, min(int(max_report or 5), 20))
+        timeout_s = max(1, min(int(timeout_s or 5), 60))
+    except Exception as e:
+        return f"Error: invalid numeric argument: {e}"
+    if mode not in ('class_method', 'stdin', 'compare'):
+        return "Error: mode must be 'class_method', 'stdin' or 'compare'."
+    if mode == 'class_method' and not method_name:
+        return "Error: method_name is required in class_method mode."
+    solution_path = os.path.abspath(str(solution_path))
+    tests_dir = os.path.abspath(str(tests_dir))
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isdir(tests_dir):
+        return f"Error: tests directory not found: {tests_dir}"
+    if mode == 'compare':
+        if not other_path or not os.path.isfile(str(other_path)):
+            return "Error: compare mode needs an existing other_path."
+        other = os.path.abspath(str(other_path))
+        base_mode = 'class_method' if method_name else 'stdin'
+        r = _evaluate_compare(solution_path, other, base_mode, method_name, tests_dir,
+                              num_random, timeout_s, max_report)
+        return _format_compare(solution_path, other, r, max_report)
+    r = _evaluate(solution_path, mode, method_name, tests_dir, num_random, timeout_s, max_report)
+    return _format_report(solution_path, mode, method_name, r, max_report)
+
+
+def evaluate_for_pipeline(solution_path, mode, method_name, tests_dir, num_random=100, timeout_s=5):
+    """Machine-readable summary used by coding_agent.py: score = (failures, max_time)."""
+    r = _evaluate(os.path.abspath(solution_path), mode, method_name, os.path.abspath(tests_dir),
+                  num_random, timeout_s, 5)
+    return r
+
+
+def evaluate_compare_for_pipeline(solution_path, other_path, mode, method_name, tests_dir,
+                                  num_random=100, timeout_s=5):
+    """Machine-readable compare summary used by coding_agent.py."""
+    base_mode = 'class_method' if method_name else 'stdin'
+    return _evaluate_compare(os.path.abspath(solution_path), os.path.abspath(other_path), base_mode,
+                             method_name, os.path.abspath(tests_dir), num_random, timeout_s, 5)
+
+
+if __name__ == '__main__':
+    # CLI used by coding_agent.py (prints one JSON line):
+    #   suite:   {"solution_path", "mode", "method_name", "tests_dir", "num_random", "timeout_s"}
+    #   compare: same keys plus "other_path"
+    args = json.loads(sys.argv[1]) if len(sys.argv) > 1 else {}
+    mode = args.get('mode', 'class_method')
+    if args.get('other_path'):
+        stats = evaluate_compare_for_pipeline(args['solution_path'], args['other_path'], mode,
+                                              args.get('method_name'), args['tests_dir'],
+                                              args.get('num_random', 100), args.get('timeout_s', 5))
+    else:
+        stats = evaluate_for_pipeline(args['solution_path'], mode, args.get('method_name'),
+                                      args['tests_dir'], args.get('num_random', 100), args.get('timeout_s', 5))
+    print(json.dumps(stats, default=str))
