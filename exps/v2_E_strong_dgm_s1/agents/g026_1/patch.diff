diff --git a/tools/stdin_layouts.py b/tools/stdin_layouts.py
new file mode 100644
index 0000000..a67008a
--- /dev/null
+++ b/tools/stdin_layouts.py
@@ -0,0 +1,76 @@
+import os
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_stdin_layouts",
+        "description": """Run a stdin/stdout Python program under several plausible non-interactive stdin layouts and report exit code, stdout, stderr and the last stdout line for each layout.
+Layouts built from the given pieces (each piece is joined with newlines):
+* 'header_only': header
+* 'header_replies': header + replies (only if replies given)
+* 'header_hidden': header + hidden_data (only if hidden_data given)
+* 'header_hidden_answer': header + hidden_data + answer_line (only if both given)
+* 'header_hidden_replies': header + hidden_data + replies (only if hidden_data and replies given)
+Use it for interactive-style problems that the grader may replay as a flat stdin file: compare each layout's last stdout line with the independently computed expected final answer. A layout that crashes or prints a wrong last line must be fixed in solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {"type": "string", "description": "Path to the Python program to run (relative to the working directory or absolute)."},
+                "header": {"type": "string", "description": "The header part of the input, e.g. 'N L R' (the first line(s) of the problem input)."},
+                "hidden_data": {"type": "string", "description": "Optional. The hidden data that follows the header, e.g. the array line."},
+                "answer_line": {"type": "string", "description": "Optional. A final answer line that may follow the hidden data."},
+                "replies": {"type": "string", "description": "Optional. Pre-recorded replies, one per line or space separated, that may follow the header."},
+                "timeout_s": {"type": "integer", "description": "Timeout in seconds per layout (default 10)."},
+            },
+            "required": ["program_path", "header"],
+        },
+    }
+
+
+def _layouts(header, hidden_data, answer_line, replies):
+    """Return an ordered list of (name, stdin_text) for the layouts that have their pieces."""
+    def join(*parts):
+        return "\n".join(p.strip("\n") for p in parts if p is not None and p.strip("\n") != "") + "\n"
+
+    out = [("header_only", join(header))]
+    if replies:
+        out.append(("header_replies", join(header, replies)))
+    if hidden_data:
+        out.append(("header_hidden", join(header, hidden_data)))
+        if answer_line:
+            out.append(("header_hidden_answer", join(header, hidden_data, answer_line)))
+        if replies:
+            out.append(("header_hidden_replies", join(header, hidden_data, replies)))
+    return out
+
+
+def _last_line(text):
+    lines = [ln for ln in (text or "").splitlines() if ln.strip()]
+    return lines[-1].strip() if lines else "(no output)"
+
+
+def tool_function(program_path, header, hidden_data="", answer_line="", replies="", timeout_s=10):
+    if not os.path.isfile(program_path):
+        return f"Error: program not found: {program_path}"
+    try:
+        timeout_s = int(timeout_s)
+    except (TypeError, ValueError):
+        timeout_s = 10
+    blocks = []
+    for name, text in _layouts(header or "", hidden_data or "", answer_line or "", replies or ""):
+        try:
+            p = subprocess.run(["python3", program_path], input=text, capture_output=True,
+                               text=True, timeout=timeout_s)
+            rc, out, err = p.returncode, p.stdout, p.stderr
+        except subprocess.TimeoutExpired:
+            rc, out, err = None, "", f"TIMEOUT after {timeout_s}s"
+        status = "OK" if rc == 0 else f"CRASH/TIMEOUT (exit {rc})"
+        block = [f"[{name}] {status}",
+                 f"  stdin: {text.strip()[:300]!r}",
+                 f"  last stdout line: {_last_line(out)!r}",
+                 f"  stdout: {out.strip()[:300]!r}"]
+        if rc != 0 and err:
+            block.append(f"  stderr: {err.strip()[-500:]}")
+        blocks.append("\n".join(block))
+    return "\n\n".join(blocks)
