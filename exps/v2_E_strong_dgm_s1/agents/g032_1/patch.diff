diff --git a/solution_alt.py b/solution_alt.py
new file mode 100644
index 0000000..91c47fb
--- /dev/null
+++ b/solution_alt.py
@@ -0,0 +1,14 @@
+# Independent alternative to solution.py. solution.py is a placeholder that
+# echoes stdin; this version copies stdin to stdout as raw bytes through the
+# binary buffers in one pass (no text decoding, no newline translation).
+import sys
+
+
+def main():
+    data = sys.stdin.buffer.read()
+    sys.stdout.buffer.write(data)
+    sys.stdout.buffer.flush()
+
+
+if __name__ == "__main__":
+    main()
