+#!/usr/bin/env python3
+"""Input generator: python3 gen.py SEED SCALE -> prints one valid input.
+
+Format: first line n, second line n integers in [-10^9, 10^9].
+SCALE 1-3: tiny; SCALE 1000: maximum-size (n=10^5), shape chosen by SEED.
+SCALE 5-100: medium (n 50-300) with small/large values,
+duplicate-heavy and edge-value cases.
+"""
+import random
+import sys
+
+
+def main():
+    seed = int(sys.argv[1]) if len(sys.argv) > 1 else 0
+    scale = int(sys.argv[2]) if len(sys.argv) > 2 else 1
+    rng = random.Random(seed * 1000003 + scale)
+    LIM = 10**9
+    if scale >= 1000:
+        # Maximum-size input (n at its upper bound), shape chosen by seed.
+        n = 10**5
+        shape = seed % 4
+        if shape == 0:     # random
+            vals = [rng.randint(-LIM, LIM) for _ in range(n)]
+        elif shape == 1:   # all equal, max magnitude
+            vals = [LIM] * n
+        elif shape == 2:   # sorted (worst case for naive sorting-based checks)
+            vals = sorted(rng.randint(-LIM, LIM) for _ in range(n))
+        else:              # reversed sorted, many duplicates
+            vals = sorted((rng.randint(-3, 3) for _ in range(n)), reverse=True)
+    elif scale <= 3:
+        n = rng.randint(1, 5)
+        vals = [rng.randint(-5, 5) for _ in range(n)]
+    else:
+        n = rng.randint(50, 300)
+        kind = rng.randrange(4)
+        if kind == 0:      # small values
+            vals = [rng.randint(-10, 10) for _ in range(n)]
+        elif kind == 1:    # large values
+            vals = [rng.randint(-LIM, LIM) for _ in range(n)]
+        elif kind == 2:    # duplicate-heavy
+            pool = [rng.randint(-LIM, LIM) for _ in range(3)]
+            vals = [rng.choice(pool) for _ in range(n)]
+        else:              # edge values
+            vals = [rng.choice([-LIM, LIM, 0, 1, -1]) for _ in range(n)]
+    print(n)
+    print(" ".join(map(str, vals)))
+
+
+if __name__ == "__main__":
+    main()
