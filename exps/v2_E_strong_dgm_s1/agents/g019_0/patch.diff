+    def _fallback_write_solution(self):
+        """
+        Tool-free fallback: asks the model for only the Python program in a fenced block and writes it
+        to solution.py. Falls back to a minimal valid placeholder if extraction fails.
+        chat_with_agent always attaches tools, so the LLM client is called directly here.
+        """
+        prompt = (
+            "Reply with ONLY the complete Python 3 program in one ```python fenced block, no explanation. "
+            f"Problem: {self.problem_statement}"
+        )
+        code = None
+        try:
+            client, client_model = create_client(self.code_model)
+            _, hist = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message="You are a competitive programmer.",
+                msg_history=[],
+            )
+            texts = []
+            for msg in hist or []:
+                if msg.get('role') == 'assistant':
+                    texts = _message_texts(msg)
+            text = "\n".join(texts)
+            m = re.search(r'```(?:python)?\n(.*?)```', text, re.DOTALL)
+            if m and m.group(1).strip():
+                code = m.group(1)
+        except Exception as e:
+            safe_log(f"Fallback LLM call failed: {e}")
+        path = os.path.join(self.git_tempdir, PRIMARY_NAME)
+        if code is not None:
+            with open(path, 'w') as f:
+                f.write(code)
+            safe_log("Fallback wrote solution.py from a tool-free reply.")
+        else:
+            existing = ''
+            if os.path.exists(path):
+                with open(path, 'r', errors='replace') as f:
+                    existing = f.read()
+            if not _has_code_lines(existing.splitlines()):
+                with open(path, 'w') as f:
+                    f.write(PLACEHOLDER_PROGRAM)
+                safe_log("Fallback extraction failed; wrote placeholder solution.py.")
+
