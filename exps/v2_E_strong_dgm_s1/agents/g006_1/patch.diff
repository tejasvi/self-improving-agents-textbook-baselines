+MUT_K = 3          # modulus used by the "compressed" mutation
+MAX_VARIANTS = 4   # at most this many mutated variants per generated input
+
+
+def _variants(inp, seed):
+    """Generic mutations of one input. The first line (header) is kept unchanged; every
+    integer token after it is transformed. Returns a list of (label, text).
+    No variant contains a value larger than the original maximum token value."""
+    lines = inp.split('\n')
+    if len(lines) < 2:
+        return []
+    header = lines[0]
+    body = '\n'.join(lines[1:])
+    matches = list(re.finditer(r'-?\d+', body))
+    if not matches:
+        return []
+    vals = [int(m.group()) for m in matches]
+    maxv = max(vals)
+    rng = random.Random(seed * 7919 + 17)
+
+    def rebuild(new_vals):
+        out = []
+        last = 0
+        for m, v in zip(matches, new_vals):
+            out.append(body[last:m.start()])
+            out.append(str(v))
+            last = m.end()
+        out.append(body[last:])
+        return header + '\n' + ''.join(out)
+
+    variants = []
+    # 1. compress into a small range: v % k + 1, clipped to the original maximum
+    if maxv >= 1:
+        comp = [min(v % MUT_K + 1, maxv) for v in vals]
+        if comp != vals:
+            variants.append((f"compressed (v % {MUT_K} + 1, clipped to {maxv})", rebuild(comp)))
+    # 2. only 2-4 distinct values of the original input
+    distinct = sorted(set(vals))
+    if len(distinct) >= 2:
+        k = rng.randint(2, min(4, len(distinct)))
+        pool = rng.sample(distinct, k)
+        few = [rng.choice(pool) for _ in vals]
+        if few != vals:
+            variants.append((f"only {k} distinct values {sorted(pool)}", rebuild(few)))
+    # 3. sorted
+    srt = sorted(vals)
+    if srt != vals:
+        variants.append(("sorted values", rebuild(srt)))
+    # 4. reversed
+    rev = vals[::-1]
+    if rev != vals:
+        variants.append(("reversed values", rebuild(rev)))
+    # every variant keeps the same token count and never exceeds the original maximum
+    variants = [(l, t) for l, t in variants if max(int(x) for x in re.findall(r'-?\d+', t.split('\n', 1)[1])) <= maxv]
+    return variants[:MAX_VARIANTS]
+
+
+def _classify(out):
+    toks = out.split()
+    if not toks:
+        return 'empty'
+    t = toks[0]
+    if t == '-1':
+        return '-1'
+    if re.fullmatch(r'[+-]?\d+(\.\d+)?', t):
+        return 'number'
+    if t.upper() in ('YES', 'NO'):
+        return 'YES/NO'
+    return 'other'
+
