+# Compares /dgm/solution.py against /tmp/notes/9797b2e2458b/oracle.jsonl.
+# Prints one line "AGREEMENT k/n", then up to 10 mismatches (input, expected, actual).
+import json, os, subprocess, sys
+
+ORACLE = "/tmp/notes/9797b2e2458b/oracle.jsonl"
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def same(a, b):
+    return a.split() == b.split()
+
+
+def main():
+    if not os.path.exists(ORACLE):
+        print("AGREEMENT 0/0")
+        print(f"oracle file missing: {ORACLE} (run dump_small.py first)")
+        return 0
+    with open(ORACLE) as f:
+        cases = [json.loads(line) for line in f if line.strip()]
+    n = len(cases)
+    k = 0
+    mismatches = []
+    for c in cases:
+        try:
+            r = subprocess.run([sys.executable, os.path.join(HERE, "solution.py")], input=c["input"],
+                               capture_output=True, text=True, timeout=5, cwd=HERE)
+            if r.returncode != 0:
+                actual = f"CRASH (exit {r.returncode}): {r.stderr.strip()[-300:]}"
+                ok = False
+            else:
+                actual = r.stdout
+                ok = same(actual, c["output"])
+        except subprocess.TimeoutExpired:
+            actual = "TIMEOUT (>5s)"
+            ok = False
+        if ok:
+            k += 1
+        elif len(mismatches) < 10:
+            mismatches.append((c["input"], c["output"], actual))
+    print(f"AGREEMENT {k}/{n}")
+    for inp, exp, act in mismatches:
+        print("--- input:\n" + inp.rstrip("\n"))
+        print("--- expected:\n" + exp.rstrip("\n"))
+        print("--- actual:\n" + str(act).rstrip("\n"))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
