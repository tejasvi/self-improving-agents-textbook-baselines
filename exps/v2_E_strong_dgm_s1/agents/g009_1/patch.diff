@@ -0,0 +1,35 @@
+# Writes /tmp/notes/9797b2e2458b/oracle.jsonl: lines {"input": ..., "output": ...} from brute.py.
+import json, os, random, subprocess, sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+OUT = "/tmp/notes/9797b2e2458b/oracle.jsonl"
+N_CASES = 300
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def main():
+    os.makedirs(os.path.dirname(OUT), exist_ok=True)
+    rng = random.Random(0)
+    seeds = [rng.randrange(10**9) for _ in range(N_CASES)]
+    written = 0
+    with open(OUT, "w") as f:
+        for seed in seeds:
+            gen = subprocess.run([sys.executable, os.path.join(HERE, "gen.py"), str(seed)],
+                                 capture_output=True, text=True, timeout=10)
+            if gen.returncode != 0:
+                sys.stderr.write(f"gen.py failed on seed {seed}: {gen.stderr.strip()}\n")
+                return 1
+            inp = gen.stdout
+            br = subprocess.run([sys.executable, os.path.join(HERE, "brute.py")], input=inp,
+                                capture_output=True, text=True, timeout=30)
+            if br.returncode != 0:
+                sys.stderr.write(f"brute.py failed on seed {seed}: {br.stderr.strip()}\n")
+                return 1
+            f.write(json.dumps({"input": inp, "output": br.stdout}) + "\n")
+            written += 1
+    print(f"wrote {written} cases to {OUT}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
