+def tool_info():
+    return {
+        "name": "resource_run",
+        "description": """Run a shell command under a memory limit and a time limit, and report its exit code, elapsed time and peak memory (RSS). Use it for scaling probes, e.g. `python3 solution.py < big_input.txt`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {"type": "string", "description": "The shell command to run."},
+                "memory_mb": {"type": "integer", "description": "Address-space limit in MB (default 2048)."},
+                "timeout": {"type": "integer", "description": "Wall-clock limit in seconds (default 10, max 60)."}
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _limiter(memory_mb):
+    def apply():
+        mem = memory_mb * 1024 * 1024
+        resource.setrlimit(resource.RLIMIT_AS, (mem, mem))
+    return apply
+
+
+def tool_function(command, memory_mb=2048, timeout=10):
+    memory_mb = max(16, min(int(memory_mb or 2048), 8192))
+    timeout = max(1, min(int(timeout or 10), 60))
+    t0 = time.monotonic()
+    try:
+        p = subprocess.run(['bash', '-c', command], capture_output=True, text=True, timeout=timeout,
+                           preexec_fn=_limiter(memory_mb), stdin=subprocess.DEVNULL, errors='replace')
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s (wall clock)."
+    dt = time.monotonic() - t0
+    ru = resource.getrusage(resource.RUSAGE_CHILDREN)
+    peak_mb = ru.ru_maxrss / 1024  # Linux reports KB
+    out = (p.stdout or '')[-4000:]
+    err = (p.stderr or '')[-2000:]
+    return (f"exit={p.returncode} elapsed={dt:.2f}s peak_rss={peak_mb:.0f}MB\n"
+            f"stdout:\n{out}\nstderr:\n{err}")
