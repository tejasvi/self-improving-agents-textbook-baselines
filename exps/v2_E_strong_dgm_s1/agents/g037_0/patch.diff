@@ -0,0 +1,187 @@
+import os
+import subprocess
+import tempfile
+import threading
+
+def tool_info():
+    return {
+        "name": "io_harness_test",
+        "description": """Run a solution program under three stdin/stdout harness modes and return the raw output of each mode.
+Use it for interactive problems, or for problems without sample inputs, to check that solution.py does not crash
+under the way the grader may feed stdin.
+Modes:
+(a) interactive: the solution runs with pipes; the judge_file's respond(query_line, state) supplies replies to each line the solution prints, and final(answer_line) is called on the last line.
+(b) static replay: stdin is read from static_stdin_file (a flattened input: header, extra data, responses).
+(c) header only: stdin is header_input followed by EOF.
+For each mode it reports stdout, stderr, exit code, whether a Traceback appeared, and whether it timed out.
+Output is raw; read it yourself. Do not treat a mode as passed unless its stdout is sensible and its stderr has no Traceback.
+judge_file format: a Python file defining respond(query_line: str, state: dict) -> str and final(answer_line: str) -> bool.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin, e.g. 'python3 solution.py'."
+                },
+                "header_input": {
+                    "type": "string",
+                    "description": "The first input line(s) of the problem, e.g. 'N L R', given before any other data."
+                },
+                "judge_file": {
+                    "type": "string",
+                    "description": "Optional path to a Python file defining respond(query_line, state) -> reply string and final(answer_line) -> bool, used for the interactive mode."
+                },
+                "static_stdin_file": {
+                    "type": "string",
+                    "description": "Optional path to a file with the flattened replay input (header, extra data, responses) used for the static replay mode."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each mode (default 10)."
+                }
+            },
+            "required": ["solution_cmd", "header_input"]
+        }
+    }
+
+
+def _clip(s, n=6000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _report(name, stdout, stderr, rc, timed_out):
+    tb = 'Traceback' in stderr or 'Traceback' in stdout
+    lines = [f"=== MODE {name} ===",
+             f"exit code: {rc}",
+             f"timed out: {timed_out}",
+             f"traceback: {tb}",
+             "--- stdout ---",
+             _clip(stdout.rstrip()) or "(empty)",
+             "--- stderr ---",
+             _clip(stderr.rstrip()) or "(empty)"]
+    return "\n".join(lines)
+
+
+def _run_static(solution_cmd, stdin_text, timeout):
+    try:
+        p = subprocess.run(['bash', '-c', solution_cmd], input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b'').decode(errors='replace')
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b'').decode(errors='replace')
+        return out, err, None, True
+
+
+def _run_interactive(solution_cmd, header_input, judge_path, timeout):
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("judge_mod_io_harness", judge_path)
+    judge = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(judge)
+    state = {}
+    proc = subprocess.Popen(['bash', '-c', solution_cmd], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, text=True, errors='replace', bufsize=1)
+    err_chunks = []
+
+    def _drain_err():
+        for line in proc.stderr:
+            err_chunks.append(line)
+    t = threading.Thread(target=_drain_err, daemon=True)
+    t.start()
+
+    transcript = []
+    timed_out = False
+    final_ok = None
+    try:
+        proc.stdin.write(header_input.rstrip('\n') + '\n')
+        proc.stdin.flush()
+        # Bounded number of exchanges; each round reads one line from the solution.
+        import select
+        import time
+        deadline = time.time() + timeout
+        for _ in range(100000):
+            remaining = deadline - time.time()
+            if remaining <= 0:
+                timed_out = True
+                break
+            ready, _, _ = select.select([proc.stdout], [], [], remaining)
+            if not ready:
+                timed_out = True
+                break
+            line = proc.stdout.readline()
+            if line == '':
+                break  # solution closed stdout (EOF)
+            line = line.rstrip('\n')
+            transcript.append(f"> {line}")
+            if final_ok is None:
+                # respond() returns a reply for queries; None/'' means the line is the final answer.
+                try:
+                    reply = judge.respond(line, state)
+                except Exception as e:
+                    transcript.append(f"< [judge respond raised {e!r}]")
+                    break
+                if reply is None or reply == '':
+                    final_ok = bool(judge.final(line)) if hasattr(judge, 'final') else None
+                    transcript.append(f"< [final accepted: {final_ok}]")
+                    break
+                transcript.append(f"< {reply}")
+                proc.stdin.write(str(reply).rstrip('\n') + '\n')
+                proc.stdin.flush()
+        try:
+            proc.stdin.close()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=max(1, deadline - time.time()))
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            proc.kill()
+            proc.wait()
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait()
+    t.join(timeout=2)
+    stdout_rest = proc.stdout.read() if proc.stdout else ''
+    stdout = "\n".join(transcript) + ("\n" + stdout_rest if stdout_rest else "")
+    stderr = ''.join(err_chunks)
+    return stdout, stderr, proc.returncode, timed_out, final_ok
+
+
+def tool_function(solution_cmd, header_input, judge_file=None, static_stdin_file=None, timeout=10):
+    timeout = max(1, min(int(timeout or 10), 120))
+    header = str(header_input).rstrip('\n')
+    sections = []
+
+    # (a) interactive mode via pipes and the judge
+    if judge_file:
+        if not os.path.isfile(judge_file):
+            sections.append(f"=== MODE interactive ===\nError: judge_file not found: {judge_file}")
+        else:
+            try:
+                out, err, rc, to, final_ok = _run_interactive(solution_cmd, header, judge_file, timeout)
+                sections.append(_report("interactive", out, err, rc, to) + f"\nfinal accepted: {final_ok}")
+            except Exception as e:
+                sections.append(f"=== MODE interactive ===\nHarness error: {e!r}")
+    else:
+        sections.append("=== MODE interactive ===\nSkipped: no judge_file given.")
+
+    # (b) static replay from a file
+    if static_stdin_file:
+        if not os.path.isfile(static_stdin_file):
+            sections.append(f"=== MODE static ===\nError: static_stdin_file not found: {static_stdin_file}")
+        else:
+            with open(static_stdin_file, 'r', errors='replace') as f:
+                data = f.read()
+            out, err, rc, to = _run_static(solution_cmd, data, timeout)
+            sections.append(_report("static", out, err, rc, to))
+    else:
+        sections.append("=== MODE static ===\nSkipped: no static_stdin_file given.")
+
+    # (c) header only, then EOF
+    out, err, rc, to = _run_static(solution_cmd, header + "\n", timeout)
+    sections.append(_report("header_only_eof", out, err, rc, to))
+
+    return "\n\n".join(sections)
