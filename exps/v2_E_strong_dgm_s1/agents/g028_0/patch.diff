+import heapq
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+_HARNESS = r'''
+import sys, json, importlib.util, os, io, itertools, random, signal, inspect, traceback, heapq
+spec = json.loads(sys.stdin.read())
+real_stdout = sys.stdout
+sys.setrecursionlimit(10000)
+
+def load(path, name):
+    sys.path.insert(0, os.path.dirname(os.path.abspath(path)))
+    ms = importlib.util.spec_from_file_location(name, path)
+    m = importlib.util.module_from_spec(ms)
+    ms.loader.exec_module(m)
+    return m
+
+def emit(obj):
+    real_stdout.write("@@RESULT@@" + json.dumps(obj, default=str) + "\n")
+    real_stdout.flush()
+
+class CaseTimeout(Exception):
+    pass
+
+def _on_alarm(signum, frame):
+    raise CaseTimeout("per-call timeout")
+
+signal.signal(signal.SIGALRM, _on_alarm)
+per_call = float(spec["per_call"])
+
+def call_with_limit(f, args):
+    sys.stdout = io.StringIO()
+    try:
+        signal.setitimer(signal.ITIMER_REAL, per_call)
+        try:
+            return ("ok", f(*args))
+        finally:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+    except BaseException as e:
+        return ("exc", type(e).__name__ + ": " + str(e)[:80])
+    finally:
+        sys.stdout = real_stdout
+
+try:
+    fast_mod = load(spec["fast_path"], "fast_under_test")
+    ref_mod = load(spec["ref_path"], "ref_under_test")
+except BaseException as e:
+    emit({"error": "failed to import module: " + type(e).__name__ + ": " + str(e)[:300]})
+    sys.exit(0)
+
+def resolve(mod, name):
+    if hasattr(mod, name):
+        return getattr(mod, name)
+    if hasattr(mod, "Solution") and hasattr(getattr(mod, "Solution"), name):
+        return getattr(mod.Solution(), name)
+    raise AttributeError(name)
+
+try:
+    fast_f = resolve(fast_mod, spec["fast_func"])
+    ref_f = resolve(ref_mod, spec["ref_func"])
+except AttributeError as e:
+    emit({"error": "function not found: " + str(e)[:300]})
+    sys.exit(0)
+
+# argument names: reference signature if available, plus a0, a1, ... aliases
+names = []
+try:
+    names = list(inspect.signature(ref_f).parameters.keys())
+except Exception:
+    names = []
+ranges = spec.get("arg_ranges")
+expr = spec.get("arg_expr")
+if not names or (ranges and len(names) != len(ranges)):
+    names = []
+max_cases = int(spec["max_cases"])
+mode = spec["mode"]
+rng = random.Random(12345)
+
+def norm(t):
+    return tuple(t) if isinstance(t, (tuple, list)) else (t,)
+
+def gen_cases():
+    if ranges:
+        if mode == "exhaustive":
+            domain = 1
+            for lo, hi in ranges:
+                domain *= max(0, hi - lo + 1)
+            it = itertools.product(*[range(lo, hi + 1) for lo, hi in ranges])
+            return (norm(t) for t in itertools.islice(it, max_cases)), domain
+        def rnd():
+            for _ in range(max_cases):
+                yield tuple(rng.randint(lo, hi) for lo, hi in ranges)
+        domain = 1
+        for lo, hi in ranges:
+            domain *= max(0, hi - lo + 1)
+        return rnd(), domain
+    pool = [norm(t) for t in itertools.islice(eval(expr, {"__builtins__": __builtins__}, {}), 2000000)]
+    if mode == "exhaustive" or len(pool) <= max_cases:
+        return iter(pool[:max_cases]), len(pool)
+    return (rng.choice(pool) for _ in range(max_cases)), len(pool)
+
+feats = spec.get("features") or []
+compiled = []
+for fe in feats:
+    try:
+        compiled.append((fe, compile(fe, "<feature>", "eval")))
+    except SyntaxError as e:
+        compiled.append((fe, None))
+
+def feature_env(args):
+    env = {}
+    for i, v in enumerate(args):
+        env["a%d" % i] = v
+        if i < 26:
+            env.setdefault(chr(ord("a") + i), v)  # a, b, c, ... aliases
+        if i < len(names):
+            env[names[i]] = v
+    return env
+
+cases = 0
+mism = 0
+heap = []  # heap of (-size, seq, payload): root is the largest kept size; keeps the 10 smallest
+seq = 0
+buckets = {fe: {} for fe, _ in compiled}
+gen, domain = gen_cases()
+for args in gen:
+    cases += 1
+    r_ref = call_with_limit(ref_f, args)
+    r_fast = call_with_limit(fast_f, args)
+    exp = r_ref[1] if r_ref[0] == "ok" else "EXC(" + r_ref[1] + ")"
+    got = r_fast[1] if r_fast[0] == "ok" else "EXC(" + r_fast[1] + ")"
+    bad = (r_ref[0] != "ok") or (r_fast[0] != "ok")
+    if not bad:
+        try:
+            bad = not bool(exp == got)
+        except Exception:
+            bad = True
+    if bad:
+        mism += 1
+        size = sum(abs(x) for x in args if isinstance(x, (int, float)) and not isinstance(x, bool))
+        diff = None
+        if (r_ref[0] == "ok" and r_fast[0] == "ok" and isinstance(exp, int) and isinstance(got, int)
+                and not isinstance(exp, bool) and not isinstance(got, bool)):
+            diff = got - exp
+        payload = [list(args), repr(exp)[:80], repr(got)[:80], diff]
+        seq += 1
+        if len(heap) < 10:
+            heapq.heappush(heap, (-size, seq, payload))
+        elif -heap[0][0] > size:
+            heapq.heapreplace(heap, (-size, seq, payload))
+    env = feature_env(args)
+    for fe, code in compiled:
+        if code is None:
+            key = "ERR"
+        else:
+            try:
+                key = repr(eval(code, {"__builtins__": __builtins__}, env))[:24]
+            except Exception:
+                key = "ERR"
+        b = buckets[fe].setdefault(key, [0, 0])
+        b[0] += 1
+        if bad:
+            b[1] += 1
+
+small = [h[2] for h in sorted(heap, key=lambda h: (-h[0], h[1]))]
+emit({"cases": cases, "domain": domain, "mismatches": mism, "names": names,
+      "smallest": small,
+      "features": {fe: buckets[fe] for fe, _ in compiled},
+      "feature_errors": [fe for fe, c in compiled if c is None]})
+'''
+
+
+def tool_info():
+    return {
+        "name": "compare_functions",
+        "description": """Test a candidate fast function against a reference function (e.g. brute.py) over many inputs, in an isolated subprocess.
+* Give fast_path/fast_func (the candidate, e.g. solution.py + 'solve') and ref_path/ref_func (the reference, e.g. brute.py + 'solve').
+* The domain is either arg_ranges (one [lo, hi] integer range per argument; exhaustive enumerates the product, random samples uniformly) or arg_expr (a Python expression yielding argument tuples or scalars, e.g. '[(n,k) for n in range(1,30) for k in range(n)]').
+* Exceptions in either function count as mismatches. Each call is limited to timeout_s seconds.
+* Returns a compact report (<3000 chars): cases run, mismatch count and rate, the 10 smallest counterexamples (args, expected, got, diff), and the mismatch rate per feature value.
+* Use features (Python expressions over argument names or a0, a1, ...; e.g. 'a%2', 'a==b') to see which input classes the candidate gets wrong.
+* Use it to test each closed-form hypothesis against brute.py, and work from the smallest counterexamples.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "fast_path": {"type": "string", "description": "Path to the candidate file (e.g. solution.py)."},
+                "fast_func": {"type": "string", "description": "Name of the candidate function or Solution method to test (e.g. 'solve')."},
+                "ref_path": {"type": "string", "description": "Path to the reference file (e.g. brute.py)."},
+                "ref_func": {"type": "string", "description": "Name of the reference function to compare against."},
+                "arg_ranges": {
+                    "type": "array",
+                    "items": {"type": "array", "items": {"type": "integer"}},
+                    "description": "One [lo, hi] integer range per argument, inclusive, e.g. [[1, 20], [0, 5]]. Use this or arg_expr."
+                },
+                "arg_expr": {"type": "string", "description": "Optional. A Python expression yielding argument tuples (or scalars for one argument). Use this instead of arg_ranges for structured domains."},
+                "mode": {"type": "string", "description": "'exhaustive' (enumerate the domain in order, up to max_cases) or 'random' (max_cases uniform samples)."},
+                "max_cases": {"type": "integer", "description": "Maximum number of cases to run (default 20000)."},
+                "features": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of Python expressions over the argument names (or a0, a1, ...), e.g. 'a%2' or 'a==b', used to bucket the mismatch rate."
+                },
+                "timeout_s": {"type": "integer", "description": "Time limit in seconds for each function call (default 10)."}
+            },
+            "required": ["fast_path", "fast_func", "ref_path", "ref_func", "mode"]
+        }
+    }
+
+
+MAX_OUT = 3000
+
+
+def _fmt_args(args):
+    return "(" + ", ".join(str(a) for a in args) + ")"
+
+
+def _format(res, fast_path, fast_func, ref_path, ref_func, mode):
+    lines = [f"compare_functions: fast={os.path.basename(fast_path)}:{fast_func} "
+             f"ref={os.path.basename(ref_path)}:{ref_func} mode={mode}"]
+    cases, mism = res["cases"], res["mismatches"]
+    rate = (100.0 * mism / cases) if cases else 0.0
+    dom = res.get("domain", 0)
+    trunc = f" (domain has {dom} points; truncated)" if dom > cases else ""
+    lines.append(f"cases run: {cases}{trunc}")
+    lines.append(f"mismatches: {mism} (rate {rate:.2f}%)")
+    if mism == 0:
+        lines.append("No mismatches found.")
+    else:
+        lines.append("Smallest counterexamples (args, expected, got, diff):")
+        for args, exp, got, diff in res["smallest"]:
+            lines.append(f"  {_fmt_args(args)} expected={exp} got={got} diff={diff}")
+    feats = res.get("features") or {}
+    if feats:
+        lines.append("Mismatch rate by feature value:")
+        for fe, table in feats.items():
+            items = sorted(table.items(), key=lambda kv: kv[0])
+            parts = []
+            for val, (n, b) in items[:12]:
+                parts.append(f"{val}->{100.0 * b / n:.1f}% (n={n})")
+            more = f" ...(+{len(items) - 12} more)" if len(items) > 12 else ""
+            lines.append(f"  {fe}: " + ", ".join(parts) + more)
+    if res.get("feature_errors"):
+        lines.append("Feature expressions with syntax errors: " + ", ".join(res["feature_errors"]))
+    out = "\n".join(lines)
+    if len(out) > MAX_OUT:
+        out = out[:MAX_OUT - 40] + "\n... (report truncated)"
+    return out
+
+
+def tool_function(fast_path, fast_func, ref_path, ref_func, mode, arg_ranges=None, arg_expr=None,
+                  max_cases=20000, features=None, timeout_s=10):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 10), 60))
+    except Exception:
+        timeout_s = 10
+    try:
+        max_cases = max(1, min(int(max_cases or 20000), 1000000))
+    except Exception:
+        max_cases = 20000
+    if mode not in ('exhaustive', 'random'):
+        return "Error: mode must be 'exhaustive' or 'random'."
+    fast_p = os.path.abspath(str(fast_path))
+    ref_p = os.path.abspath(str(ref_path))
+    for p in (fast_p, ref_p):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+    if not arg_ranges and not arg_expr:
+        return "Error: give arg_ranges (list of [lo, hi]) or arg_expr."
+    ranges = None
+    if arg_ranges:
+        try:
+            ranges = [[int(lo), int(hi)] for lo, hi in arg_ranges]
+        except Exception:
+            return "Error: arg_ranges must be a list of [lo, hi] integer pairs."
+        if not ranges:
+            return "Error: arg_ranges is empty."
+    feats = [str(f) for f in (features or [])]
+    spec = {"fast_path": fast_p, "fast_func": str(fast_func), "ref_path": ref_p, "ref_func": str(ref_func),
+            "arg_ranges": ranges, "arg_expr": str(arg_expr) if arg_expr else None, "mode": mode,
+            "max_cases": max_cases, "features": feats, "per_call": timeout_s}
+    # Overall limit: per-call limit times a generous factor, so a hung candidate cannot block the agent.
+    overall = min(300, timeout_s * 10 + 10)
+    t0 = time.time()
+    try:
+        p = subprocess.Popen([sys.executable, '-c', _HARNESS], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                             stderr=subprocess.PIPE, text=True, cwd=os.path.dirname(fast_p),
+                             start_new_session=True)
+    except Exception as e:
+        return f"Error: failed to start harness: {e}"
+    try:
+        out, err = p.communicate(json.dumps(spec), timeout=overall)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return (f"TIMEOUT: compare_functions killed after {overall}s (fast function too slow or hanging, "
+                f"or the domain is too large; lower max_cases or the ranges).")
+    res = None
+    for line in out.splitlines():
+        if line.startswith("@@RESULT@@"):
+            try:
+                res = json.loads(line[len("@@RESULT@@"):])
+            except Exception:
+                res = None
+    if res is None:
+        tail = ((err or '') + out)[-600:]
+        return f"Error: harness produced no result (exit {p.returncode}).\n{tail}"
