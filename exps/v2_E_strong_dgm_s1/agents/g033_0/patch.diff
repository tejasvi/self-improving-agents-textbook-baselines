@@ -0,0 +1,152 @@
+import os
+import subprocess
+import time
+
+MAX_SEEDS = 1000        # hard cap on seeds per call
+MAX_FAILURES = 5        # collect this many failing seeds, then report the shortest input
+REPORT_CLIP = 2000      # max chars of any raw input/output in a report
+
+
+def tool_info():
+    return {
+        "name": "stress_compare",
+        "description": """Stress-compare solution.py against an independent brute-force reference.\n
+* For each seed in 1..seeds it runs `python3 gen_path SEED`, feeds the generated input to brute_path and to solution_path, and compares their whitespace-split stdout.
+* Returns 'all N seeds passed' when every seed matches. Otherwise it returns the SMALLEST failing input (shortest input text among the first few failing seeds) with the brute output, the solution output, the solution stderr and exit code.
+* Helper failures are reported separately: if gen_path or brute_path crashes or times out, the report says 'helper script failed' and the solution is not blamed.
+* Use it after writing brute.py and gen.py (both Python files, reading stdin / writing stdout).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python program (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python program (reads stdin, writes stdout)."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the generator; it is run as `python3 gen_path SEED` and prints one input to stdout."
+                },
+                "seeds": {
+                    "type": "integer",
+                    "description": "Number of seeds to run (1..seeds). Capped at 1000."
+                },
+                "timeout_s": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each single run of the generator, brute and solution."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path", "seeds", "timeout_s"]
+        }
+    }
+
+
+def _clip(s):
+    s = s or ''
+    return s if len(s) <= REPORT_CLIP else s[:REPORT_CLIP] + "\n...(clipped)"
+
+
+def stress_check(solution_path, brute_path, gen_path, seeds=200, timeout_s=10,
+                 max_failures=MAX_FAILURES, budget_s=None):
+    """
+    Run gen -> brute -> solution for seeds 1..seeds.
+    Returns a dict:
+      status: 'ok' | 'mismatch' | 'helper_failed' | 'missing'
+      ran: number of seeds whose brute and solution both finished
+      failures: list of dicts (seed, input, brute_out, sol_out, sol_err, sol_rc, kind)
+      message: human-readable note (used for helper failures)
+    """
+    sol = os.path.abspath(solution_path)
+    brute = os.path.abspath(brute_path)
+    gen = os.path.abspath(gen_path)
+    for name, p in (('solution', sol), ('brute', brute), ('gen', gen)):
+        if not os.path.isfile(p):
+            return {'status': 'missing', 'ran': 0, 'failures': [],
+                    'message': f"{name} file not found: {p}"}
+    seeds = max(0, min(int(seeds), MAX_SEEDS))
+    timeout_s = max(1, int(timeout_s))
+    cwd = os.path.dirname(sol)
+    start = time.monotonic()
+    ran = 0
+    failures = []
+    for seed in range(1, seeds + 1):
+        if budget_s is not None and time.monotonic() - start > budget_s:
+            break
+        try:
+            g = subprocess.run(['python3', gen, str(seed)], cwd=os.path.dirname(gen),
+                               capture_output=True, text=True, timeout=timeout_s)
+        except subprocess.TimeoutExpired:
+            return {'status': 'helper_failed', 'ran': ran, 'failures': failures,
+                    'message': f"helper script failed: gen.py timed out on seed {seed} "
+                               f"(not counted against solution.py)."}
+        if g.returncode != 0:
+            return {'status': 'helper_failed', 'ran': ran, 'failures': failures,
+                    'message': f"helper script failed: gen.py crashed on seed {seed} "
+                               f"(exit {g.returncode}, not counted against solution.py).\n"
+                               f"stderr:\n{_clip(g.stderr[-REPORT_CLIP:])}"}
+        inp = g.stdout
+        try:
+            b = subprocess.run(['python3', brute], cwd=os.path.dirname(brute), input=inp,
+                               capture_output=True, text=True, timeout=timeout_s)
+        except subprocess.TimeoutExpired:
+            return {'status': 'helper_failed', 'ran': ran, 'failures': failures,
+                    'message': f"helper script failed: brute.py timed out on seed {seed} "
+                               f"(not counted against solution.py).\ninput:\n{_clip(inp)}"}
+        if b.returncode != 0:
+            return {'status': 'helper_failed', 'ran': ran, 'failures': failures,
+                    'message': f"helper script failed: brute.py crashed on seed {seed} "
+                               f"(exit {b.returncode}, not counted against solution.py; fix brute.py).\n"
+                               f"input:\n{_clip(inp)}\nbrute stderr:\n{_clip(b.stderr[-REPORT_CLIP:])}"}
+        ran += 1
+        try:
+            s = subprocess.run(['python3', sol], cwd=cwd, input=inp,
+                               capture_output=True, text=True, timeout=timeout_s)
+            s_out, s_err, s_rc, kind = s.stdout, s.stderr, s.returncode, None
+            if s_rc != 0:
+                kind = 'crash'
+            elif s_out.split() != b.stdout.split():
+                kind = 'wrong'
+        except subprocess.TimeoutExpired:
+            s_out, s_err, s_rc, kind = '', f"solution.py TIMED OUT (limit {timeout_s}s)", None, 'timeout'
+        if kind is not None:
+            failures.append({'seed': seed, 'input': inp, 'brute_out': b.stdout, 'sol_out': s_out,
+                             'sol_err': s_err, 'sol_rc': s_rc, 'kind': kind})
+            if len(failures) >= max_failures:
+                break
+    status = 'mismatch' if failures else 'ok'
+    return {'status': status, 'ran': ran, 'failures': failures, 'message': ''}
+
+
+def shortest_failure(result):
+    """The failing case with the shortest input text (earliest seed on ties), or None."""
+    fails = result.get('failures') or []
+    if not fails:
+        return None
+    return min(fails, key=lambda f: (len(f['input']), f['seed']))
+
+
+def format_failure(f):
+    kind_txt = {'wrong': 'WRONG ANSWER', 'crash': 'RUNTIME ERROR (non-zero exit)',
+                'timeout': 'TIME LIMIT EXCEEDED'}.get(f['kind'], f['kind'])
+    return (f"{kind_txt} on seed {f['seed']} (input length {len(f['input'])} chars).\n"
+            f"input:\n{_clip(f['input'])}"
+            f"brute (expected) output:\n{_clip(f['brute_out'])}\n"
+            f"solution (actual) output:\n{_clip(f['sol_out'])}\n"
+            f"solution stderr (exit {f['sol_rc']}):\n{_clip((f['sol_err'] or '')[-REPORT_CLIP:])}")
+
+
+def tool_function(solution_path, brute_path, gen_path, seeds, timeout_s):
+    res = stress_check(solution_path, brute_path, gen_path, seeds=seeds, timeout_s=timeout_s)
+    if res['status'] == 'missing':
+        return f"Error: {res['message']}"
+    if res['status'] == 'helper_failed':
+        return res['message']
+    if res['status'] == 'ok':
+        return f"all {res['ran']} seeds passed"
+    f = shortest_failure(res)
+    return (f"Stress MISMATCH: {len(res['failures'])} failing seed(s) among {res['ran']} run; "
+            f"smallest failing input shown below.\n" + format_failure(f) +
+            "\nNote: brute.py itself may be wrong; verify it against the statement.")
