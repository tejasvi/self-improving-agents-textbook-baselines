@@ -0,0 +1,158 @@
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+_GEN_EVAL = r'''
+import json, random, sys
+random.seed(12345)
+print(json.dumps([str(x) for x in (EXPR)]))
+'''
+
+
+def tool_info():
+    return {
+        "name": "perf_gate",
+        "description": """Performance gate for a stdin/stdout Python solution. Runs solution.py on several max-size inputs, each in an isolated subprocess with a hard time limit, and reports per-input wall times and status (OK / TIMEOUT / ERROR). For the slowest input it also returns the top 15 lines of `python -m cProfile -s cumtime` output (hot spots).
+* `max_params` is EITHER a path to a generator script (a Python file that prints a JSON array of input strings to stdout, e.g. random, all-equal and adversarial max-size inputs), OR a Python expression that evaluates to a list of input strings, e.g. `['5\\n' + ' '.join(['1']*200000)]`. Strings are used as raw stdin text.
+* `time_limit` is the per-input timeout in seconds (default 2).
+* Use it after correctness passes to detect slow solutions; it does not change any files.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the stdin/stdout Python solution file (solution.py)."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "Must be 'stdin' (the solution reads standard input and writes standard output)."
+                },
+                "max_params": {
+                    "type": "string",
+                    "description": "Either a path to a generator script that prints a JSON array of raw stdin strings, or a Python expression evaluating to a list of raw stdin strings."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Per-input hard timeout in seconds (default 2)."
+                }
+            },
+            "required": ["solution_path", "mode", "max_params"]
+        }
+    }
+
+
+def _clip(s, n=300):
+    s = (s or '').strip()
+    return s if len(s) <= n else s[: n // 2] + " ... " + s[-n // 2:]
+
+
+def _run(cmd, stdin_text, cwd, timeout_s):
+    t0 = time.time()
+    try:
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, cwd=cwd, start_new_session=True)
+    except Exception as e:
+        return 'ERROR', time.time() - t0, '', f'failed to start: {e}'
+    try:
+        out, err = p.communicate(stdin_text, timeout=timeout_s)
+        el = time.time() - t0
+        if p.returncode != 0:
+            return 'ERROR', el, out, (err or '') + f'\n(exit code {p.returncode})'
+        return 'OK', el, out, err
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'TIMEOUT', time.time() - t0, '', f'killed after {timeout_s}s'
+
+
+def _load_inputs(max_params, cwd):
+    """Return (inputs, error). max_params is a generator script path or a Python expression."""
+    if os.path.isfile(max_params):
+        try:
+            p = subprocess.run([sys.executable, os.path.abspath(max_params)], cwd=cwd,
+                               capture_output=True, text=True, timeout=120)
+        except subprocess.TimeoutExpired:
+            return None, "generator script timed out after 120s"
+        if p.returncode != 0:
+            return None, f"generator script failed (exit {p.returncode}): {_clip(p.stderr)}"
+        try:
+            data = json.loads(p.stdout)
+        except Exception as e:
+            return None, f"generator output is not a JSON array of strings: {e}; got: {_clip(p.stdout)}"
+    else:
+        script = _GEN_EVAL.replace('(EXPR)', '(' + max_params + ')')
+        try:
+            p = subprocess.run([sys.executable, '-c', script], cwd=cwd,
+                               capture_output=True, text=True, timeout=120)
+        except subprocess.TimeoutExpired:
+            return None, "expression evaluation timed out after 120s"
+        if p.returncode != 0:
+            return None, f"expression failed: {_clip(p.stderr)}"
+        data = json.loads(p.stdout)
+    if not isinstance(data, list) or not data:
+        return None, "no inputs produced (need a non-empty JSON list)"
+    return [str(x) for x in data], None
+
+
+def _profile(path, inp, cwd, n=15, timeout_s=10):
+    """Top-n lines of cProfile output sorted by cumtime for one input (bounded by timeout_s)."""
+    try:
+        p = subprocess.run([sys.executable, '-m', 'cProfile', '-s', 'cumtime', path],
+                           input=inp, cwd=cwd, capture_output=True, text=True, timeout=timeout_s)
+    except subprocess.TimeoutExpired:
+        return f"(profiling killed after {timeout_s}s: the input is too slow to profile fully; optimize the hot loops first)"
+    out = p.stdout or ''
+    idx = out.find('Ordered by')
+    if idx < 0:
+        return "(no cProfile output found) " + _clip(p.stderr)
+    lines = out[idx:].splitlines()
+    # lines[0] is the 'Ordered by' header; keep header + table lines (skip blanks)
+    body = [l for l in lines if l.strip()]
+    return "\n".join(body[:n + 1])
+
+
+def tool_function(solution_path, mode, max_params, time_limit=2):
+    try:
+        time_limit = max(0.1, min(float(time_limit or 2), 60.0))
+    except Exception:
+        time_limit = 2.0
+    path = os.path.abspath(str(solution_path))
+    if not os.path.isfile(path):
+        return f"Error: solution file not found: {path}"
+    if mode != 'stdin':
+        return "Error: mode must be 'stdin' for perf_gate."
+    if not max_params:
+        return "Error: max_params is required (generator script path or Python expression)."
+    cwd = os.path.dirname(path)
+
+    inputs, err = _load_inputs(str(max_params), cwd)
+    if err:
+        return f"Error: {err}"
+
+    rows = []
+    for i, inp in enumerate(inputs):
+        label = f"input#{i} len={len(inp)} head={inp[:20]!r}"
+        status, el, out, errtxt = _run([sys.executable, path], inp, cwd, time_limit)
+        rows.append((i, label, el, status, _clip(out, 80) if status == 'OK' else _clip(errtxt, 200)))
+
+    lines = [f"Perf gate for {path}, time_limit {time_limit}s per input, {len(rows)} inputs",
+             f"{'#':>3}  {'input':<50} {'time(s)':>8}  {'status':<8} output/error"]
+    for i, label, el, status, detail in rows:
+        lines.append(f"{i:>3}  {label:<50} {el:>8.3f}  {status:<8} {detail}")
+    slow = max(rows, key=lambda r: r[2])
+    lines.append(f"Slowest: #{slow[0]} took {slow[2]:.3f}s, status {slow[3]}")
+    n_bad = sum(1 for r in rows if r[3] != 'OK')
+    lines.append(f"Summary: {len(rows) - n_bad}/{len(rows)} OK" + ("" if n_bad == 0 else f", {n_bad} not OK (TIMEOUT/ERROR)"))
+    lines.append("")
+    lines.append(f"cProfile top {15} (cumtime) for slowest input #{slow[0]}:")
+    lines.append(_profile(path, inputs[slow[0]], cwd, n=15, timeout_s=min(10, max(3, int(time_limit * 3)))))
+    return "\n".join(lines)
