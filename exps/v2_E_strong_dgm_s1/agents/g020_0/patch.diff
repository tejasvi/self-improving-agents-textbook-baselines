+import json
+import random
+
+# Generic max-size stdin inputs for /dgm/solution.py (a stdin program).
+# Format assumed: first line n, second line n integers. Each input stays well under 5 MB.
+N = 200000
+MAXV = 10**9
+random.seed(12345)
+
+
+def make(arr):
+    return f"{len(arr)}\n" + " ".join(map(str, arr)) + "\n"
+
+
+inputs = [
+    make([random.randint(1, MAXV) for _ in range(N)]),          # random max-size
+    make([7] * N),                                               # all equal
+    make(list(range(1, N + 1))),                                 # sorted ascending
+    make(list(range(N, 0, -1))),                                 # reverse sorted
+    make([random.randint(1, 2) for _ in range(N)]),              # only 2 distinct values
+    make([i % 1000 + 1 for i in range(N)]),                      # many repeats, skewed pattern
+    make([MAXV - i for i in range(N)]),                          # maximum distinct large values
+]
+
+print(json.dumps(inputs))
