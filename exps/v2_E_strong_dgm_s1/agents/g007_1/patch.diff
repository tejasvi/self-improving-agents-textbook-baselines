+    def _canonical_mismatch(self):
+        """
+        Post-run exact check against brute.py (lexicographically-first reference).
+        Runs only when brute.py and gen.py exist in the repo and brute.py reproduces every sample*.out.
+        Returns None when there is nothing to report, otherwise a text report of the first/shortest
+        failing input with both outputs.
+        """
+        d = self.git_tempdir
+        if not (os.path.exists(os.path.join(d, 'brute.py')) and os.path.exists(os.path.join(d, 'gen.py'))):
+            return None
+        sample_ins = sorted(glob.glob(os.path.join(d, 'sample*.in')))
+        if not sample_ins:
+            return None
+        # brute.py must reproduce every sample answer, otherwise it is not the canonical reference.
+        for in_path in sample_ins:
+            out_path = in_path[:-3] + '.out'
+            if not os.path.exists(out_path):
+                continue
+            try:
+                with open(in_path) as f:
+                    res = subprocess.run("python3 brute.py", shell=True, cwd=d, stdin=f,
+                                         capture_output=True, text=True, timeout=10)
+                with open(out_path) as f:
+                    expected = f.read()
+            except Exception as e:
+                safe_log(f"Canonical check skipped (brute run failed on {in_path}): {e}")
+                return None
+            if res.returncode != 0 or res.stdout.split() != expected.split():
+                safe_log(f"Canonical check skipped: brute.py does not reproduce {os.path.basename(out_path)}.")
+                return None
+        from tools import stress_test
+        report = stress_test.tool_function(
+            solution_cmd=f"cd {d} && python3 {PRIMARY_NAME}",
+            generator_cmd=f"cd {d} && python3 gen.py",
+            reference_cmd=f"cd {d} && python3 brute.py",
+            scales=[1, 5, 8],
+            seeds_per_scale=100,
+            timeout=5,
+            require_exact=True,
+        )
+        if 'CANONICAL MISMATCH' in report:
+            return report
+        return None
+
