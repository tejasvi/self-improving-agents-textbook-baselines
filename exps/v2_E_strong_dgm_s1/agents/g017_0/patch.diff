+    def _score(self, result, cand_path):
+        """Score tuple for the candidate at cand_path, or None if it is not in the result."""
+        if result.get('error'):
+            return None, result['error']
+        for rec in result.get('ranking', []):
+            if os.path.abspath(rec['path']) == os.path.abspath(cand_path):
