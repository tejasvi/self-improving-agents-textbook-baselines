+import json
+import os
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from collections import Counter
+
+MAX_SHOW = 1500          # max characters shown for an input / output in the report
+MAX_DISAGREE_SHOWN = 3   # number of disagreeing inputs shown in the report
+POOL_LIMIT = 2000        # max number of pool files kept in the pool directory
+MAX_INPUT_BYTES = 200000  # inputs larger than this are not added to the pool
+
+
+def tool_info():
+    return {
+        "name": "evaluate_candidates",
+        "description": """Evaluate several candidate solutions of the same problem against sample tests, an optional shared pool of test inputs, an optional reference program and an optional checker.\n
+* `candidates` is a list of paths to candidate programs (python3 files reading stdin and writing stdout, e.g. 'cand_0/solution.py').\n
+* `samples_dir` is a directory with files sampleN.in and sampleN.out (expected outputs from the statement). Every candidate is compared with sampleN.out exactly (whitespace-normalized).\n
+* `pool_dir` (optional) is a directory of extra input files (*.in), the regression pool. Every candidate runs on every pool input. Inputs where candidates disagree or disagree with the reference/checker are listed in the report; the agent must keep such inputs in the pool so they stay as regression tests.\n
+* `reference_cmd` (optional) is a trusted slow program reading stdin; its output is the expected output for pool inputs.\n
+* `checker_cmd` (optional) is run as '<checker_cmd> input_file output_file' for pool inputs; exit code 0 means the output is valid.\n
+* `timeout` is the time limit in seconds for each single run.\n
+* Returns a ranked summary per candidate (samples passed, pool agreement with reference/checker, majority agreement, max runtime), pairwise disagreement counts and the first few disagreeing inputs (truncated).\n
+* For Solution-class tasks (LeetCode style), give `class_name`, `method_name` and `generator_file` (a python file defining gen(seed, scale) that returns a list of positional arguments). Then candidates are python files defining the class and the reference is `reference_file`; sample/pool inputs are replaced by gen(seed, scale) cases for the given `scales`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidates": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of paths to candidate solution files to compare."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing sampleN.in and sampleN.out files with the expected outputs from the statement. Use an empty string if there are none."
+                },
+                "pool_dir": {
+                    "type": "string",
+                    "description": "Optional directory of extra test input files (*.in). Disagreeing inputs are added to it. Use an empty string to skip the pool."
+                },
+                "new_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of new test inputs (full stdin contents, e.g. output of gen.py). They are added to the pool and evaluated; the ones that expose disagreement are saved into pool_dir as new *.in files. Use an empty list if none."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command of a trusted slow reference program reading stdin, e.g. 'python3 brute.py'. Use an empty string if none."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command invoked as '<checker_cmd> input_file output_file'; exit code 0 means valid. Use an empty string if none."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each single run of a candidate or reference. Default 5."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "For Solution-class tasks only: name of the class (default 'Solution'). Use an empty string for stdin programs."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "For Solution-class tasks only: name of the method to test. Use an empty string for stdin programs."
+                },
+                "generator_file": {
+                    "type": "string",
+                    "description": "For Solution-class tasks only: python file defining gen(seed, scale) returning the list of positional arguments. Use an empty string for stdin programs."
+                },
+                "reference_file": {
+                    "type": "string",
+                    "description": "For Solution-class tasks only: python file with the exact slow reference class (same class_name). Use an empty string to use the reference_cmd instead."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "For Solution-class tasks only: scales passed to gen(). Default [1, 2, 3]."
+                },
+                "seeds_per_scale": {
+                    "type": "integer",
+                    "description": "For Solution-class tasks only: number of seeds per scale. Default 20."
+                }
+            },
+            "required": ["candidates"]
+        }
+    }
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def _clip(s, n=MAX_SHOW):
+    if s is None:
+        return ""
+    s = str(s)
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters truncated> ...\n" + s[-n // 2:]
+
+
+def _norm(s):
+    return (s or "").split()
+
+
+def _run_stdin(cmd, input_text, cwd, timeout):
+    """Run a shell command with input_text on stdin.
+    Returns (status, stdout, stderr, elapsed) with status in ok/timeout/crash/error."""
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, shell=True, cwd=cwd, input=input_text.encode("utf-8"),
+                           capture_output=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return "timeout", "", f"timed out after {timeout} seconds", time.time() - t0
+    except Exception as e:
+        return "error", "", f"could not run: {e}", time.time() - t0
+    el = time.time() - t0
+    out = p.stdout.decode("utf-8", errors="replace")
+    err = p.stderr.decode("utf-8", errors="replace")
+    if p.returncode != 0:
+        return "crash", out, f"exit code {p.returncode}\n{err}", el
+    return "ok", out, err, el
+
+
+def _run_checker(checker_cmd, in_path, out_path, cwd, timeout):
+    """Returns True if the checker accepts the output."""
+    try:
+        p = subprocess.run(f"{checker_cmd} {in_path} {out_path}", shell=True, cwd=cwd,
+                           capture_output=True, timeout=timeout)
+        return p.returncode == 0
+    except Exception:
+        return False
+
+
+def _load_pool(pool_dir):
+    if not pool_dir or not os.path.isdir(pool_dir):
+        return []
+    names = sorted(f for f in os.listdir(pool_dir) if f.endswith(".in"))
+    res = []
+    for name in names:
+        try:
+            with open(os.path.join(pool_dir, name), "r", encoding="utf-8", errors="replace") as f:
+                res.append((name, f.read()))
+        except Exception:
+            continue
+    return res
+
+
+def _load_samples(samples_dir):
+    """Returns list of (name, input_text, expected_output_text) for sampleN.in / sampleN.out pairs."""
+    res = []
+    if not samples_dir or not os.path.isdir(samples_dir):
+        return res
+    names = sorted(f for f in os.listdir(samples_dir) if f.endswith(".in"))
+    for name in names:
+        base = name[:-3]
+        out_path = os.path.join(samples_dir, base + ".out")
+        if not os.path.isfile(out_path):
+            continue
+        try:
+            with open(os.path.join(samples_dir, name), "r", encoding="utf-8", errors="replace") as f:
+                inp = f.read()
+            with open(out_path, "r", encoding="utf-8", errors="replace") as f:
+                exp = f.read()
+        except Exception:
+            continue
+        res.append((base, inp, exp))
+    return res
+
+
+def _abs(path, cwd):
+    return path if os.path.isabs(path) else os.path.join(cwd, path)
+
+
+def _cwd():
+    try:
+        from tools import bash as _bash
+        cwd = _bash._STATE.get("cwd")
+        if cwd and os.path.isdir(cwd):
+            return cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+# ---------------------------------------------------------------------------
+# stdin-program evaluation
+# ---------------------------------------------------------------------------
+
+def _evaluate_stdin(cands, samples, pool, reference_cmd, checker_cmd, timeout, cwd, tmpdir):
+    """cands: list of (label, abs_path). samples: from _load_samples. pool: from _load_pool.
+    Returns a dict with per-candidate records and the list of new disagreement inputs."""
+    names = [c[0] for c in cands]
+    rec = {n: {"label": n, "path": p, "samples_passed": 0, "samples_total": len(samples),
+               "pool_total": 0, "ref_agree": 0, "ref_total": 0, "majority_agree": 0,
+               "crashes": 0, "timeouts": 0, "empty": 0, "max_time": 0.0, "failures": []}
+           for n, p in cands}
+
+    # samples: exact comparison against expected output (whitespace-normalized)
+    for name, inp, exp in samples:
+        for label, path in cands:
+            st, out, err, el = _run_stdin(f"python3 {shlex.quote(path)}", inp, cwd, timeout)
+            r = rec[label]
+            r["max_time"] = max(r["max_time"], el)
+            if st == "ok" and _norm(out) == _norm(exp):
+                r["samples_passed"] += 1
+            else:
+                if st == "timeout":
+                    r["timeouts"] += 1
+                elif st != "ok":
+                    r["crashes"] += 1
+                if st == "ok" and not out.strip():
+                    r["empty"] += 1
+                if len(r["failures"]) < 3:
+                    r["failures"].append({"where": "sample " + name, "input": inp, "expected": exp,
+                                          "actual": out, "info": st + ": " + _clip(err, 300)})
+
+    # pool: run every candidate, compare outputs
+    outputs = {}  # (pool_idx, label) -> (status, out)
+    new_disagree = []  # list of (pool_name, input_text, reason)
+    for idx, (name, inp) in enumerate(pool):
+        for label, path in cands:
+            st, out, err, el = _run_stdin(f"python3 {shlex.quote(path)}", inp, cwd, timeout)
+            outputs[(idx, label)] = (st, out, err)
+            r = rec[label]
+            r["max_time"] = max(r["max_time"], el)
+            r["pool_total"] += 1
+            if st == "timeout":
+                r["timeouts"] += 1
+            elif st != "ok":
+                r["crashes"] += 1
+            elif not out.strip():
+                r["empty"] += 1
+
+    ref_outs = {}
+    if reference_cmd:
+        for idx, (name, inp) in enumerate(pool):
+            st, out, err, el = _run_stdin(reference_cmd, inp, cwd, max(timeout, 30))
+            ref_outs[idx] = (st, out, err)
+
+    ref_ok = {}  # idx -> bool, expected output from reference or checker
+    for idx, (name, inp) in enumerate(pool):
+        in_path = os.path.join(tmpdir, f"pool_{idx}.in")
+        with open(in_path, "w") as f:
+            f.write(inp)
+        expected = None
+        if idx in ref_outs and ref_outs[idx][0] == "ok":
+            expected = ref_outs[idx][1]
+        ref_ok[idx] = expected
+        for label, path in cands:
+            st, out, err = outputs[(idx, label)]
+            r = rec[label]
+            if st != "ok":
+                if len(r["failures"]) < 3:
+                    r["failures"].append({"where": "pool " + name, "input": inp, "expected": expected or "",
+                                          "actual": out, "info": st + ": " + _clip(err, 300)})
+                continue
+            if expected is not None:
+                r["ref_total"] += 1
+                if _norm(out) == _norm(expected):
+                    r["ref_agree"] += 1
+                elif len(r["failures"]) < 3:
+                    r["failures"].append({"where": "pool " + name, "input": inp, "expected": expected,
+                                          "actual": out, "info": "differs from reference"})
+            elif checker_cmd:
+                out_path = os.path.join(tmpdir, f"pool_{idx}_{label}.out")
+                with open(out_path, "w") as f:
+                    f.write(out)
+                r["ref_total"] += 1
+                if _run_checker(checker_cmd, in_path, out_path, cwd, max(timeout, 30)):
+                    r["ref_agree"] += 1
+                elif len(r["failures"]) < 3:
+                    r["failures"].append({"where": "pool " + name, "input": inp, "expected": "",
+                                          "actual": out, "info": "checker rejects output"})
+
+    # majority agreement: for each pool input, count candidates whose normalized output equals the most common one
+    for idx, (name, inp) in enumerate(pool):
+        vals = {}
+        for label, _ in cands:
+            st, out, err = outputs[(idx, label)]
+            if st == "ok":
+                vals[label] = " ".join(_norm(out))
+            else:
+                vals[label] = None
+        counts = Counter(v for v in vals.values() if v is not None)
+        if counts:
+            top, _ = counts.most_common(1)[0]
+            for label, v in vals.items():
+                if v is not None and v == top:
+                    rec[label]["majority_agree"] += 1
+        # disagreement among candidates (or with reference/checker)
+        ok_vals = set(v for v in vals.values() if v is not None)
+        bad_ref = False
+        if ref_ok.get(idx) is not None:
+            want = " ".join(_norm(ref_ok[idx]))
+            bad_ref = any(v != want for v in ok_vals)
+        if len(ok_vals) > 1 or bad_ref:
+            new_disagree.append((name, inp, "reference/checker mismatch" if bad_ref else "candidates disagree"))
+
+    # pairwise disagreements (on pool inputs, both produced ok outputs and differ)
+    pairs = {}
+    for i in range(len(names)):
+        for j in range(i + 1, len(names)):
+            a, b = names[i], names[j]
+            cnt = 0
+            for idx in range(len(pool)):
+                sa, oa, _ = outputs[(idx, a)]
+                sb, ob, _ = outputs[(idx, b)]
+                if sa == "ok" and sb == "ok" and _norm(oa) != _norm(ob):
+                    cnt += 1
+            pairs[f"{a} vs {b}"] = cnt
+
+    return {"records": rec, "pairs": pairs, "pool_size": len(pool), "new_disagree": new_disagree,
+            "samples_total": len(samples), "outputs": outputs, "pool": pool, "ref_outs": ref_outs}
+
+
+# ---------------------------------------------------------------------------
+# Solution-class evaluation (reuses method_stress_test's runner)
+# ---------------------------------------------------------------------------
+
+def _evaluate_method(cands, class_name, method_name, generator_file, reference_file, scales,
+                     seeds_per_scale, timeout, cwd, tmpdir):
+    from tools import method_stress_test as mst
+    # One runner per candidate, comparing against the reference through method_stress_test.
+    records = {}
+    names = []
+    for label, path in cands:
+        names.append(label)
+        res = mst._run_all(method_name, reference_file, generator_file, path, class_name or "Solution",
+                           None, scales, seeds_per_scale, timeout, 0, tmpdir)
+        ok = isinstance(res, str) and res.startswith("method_stress_test:")
+        passed, total, max_t = 0, 0, 0.0
+        if ok:
+            first = res.splitlines()[0]
+            try:
+                frac = first.split(":", 1)[1].split("cases passed")[0].strip()
+                p_s, t_s = frac.split("/")
+                passed, total = int(p_s), int(t_s)
+            except Exception:
+                pass
+            for line in res.splitlines():
+                if "max time" in line:
+                    try:
+                        max_t = max(max_t, float(line.rsplit("max time", 1)[1].strip().rstrip("s")))
+                    except Exception:
+                        pass
+        records[label] = {"label": label, "path": path, "samples_passed": passed, "samples_total": total,
+                          "pool_total": total, "ref_agree": passed, "ref_total": total,
+                          "majority_agree": passed, "crashes": 0 if ok else 1, "timeouts": 0,
+                          "empty": 0, "max_time": max_t, "failures": [],
+                          "report": res if not ok else ""}
+        if ok and "ALL PASSED" not in res:
+            records[label]["failures"].append({"where": "generated case", "input": "",
+                                               "expected": "", "actual": "", "info": res})
+        if not ok:
+            records[label]["failures"].append({"where": "setup", "input": "", "expected": "",
+                                               "actual": "", "info": res})
+    return {"records": records, "pairs": {}, "pool_size": 0, "new_disagree": [],
+            "samples_total": 0, "outputs": {}, "pool": [], "ref_outs": {}}
+
+
+# ---------------------------------------------------------------------------
+# public API
+# ---------------------------------------------------------------------------
+
+def evaluate(candidates, samples_dir=None, pool_dir=None, reference_cmd=None, checker_cmd=None,
+             timeout=5, class_name=None, method_name=None, generator_file=None, reference_file=None,
+             scales=None, seeds_per_scale=20, new_inputs=None):
+    """Structured evaluation. Returns a dict with keys 'ranking' (list of record dicts sorted best first),
+    'pairs', 'new_disagree_files' and 'error' (None or a string). Never raises."""
+    try:
+        return _evaluate(candidates, samples_dir, pool_dir, reference_cmd, checker_cmd, timeout,
+                         class_name, method_name, generator_file, reference_file, scales, seeds_per_scale,
+                         new_inputs or [])
+    except Exception as e:
+        return {"ranking": [], "pairs": {}, "new_disagree_files": [], "error": f"{type(e).__name__}: {e}"}
+
+
+def score_tuple(rec):
+    """(samples_passed, ref_agreement, majority_agreement, -max_time): larger is better."""
+    return (rec["samples_passed"], rec["ref_agree"], rec["majority_agree"], -rec["max_time"])
+
+
+def _evaluate(candidates, samples_dir, pool_dir, reference_cmd, checker_cmd, timeout,
+              class_name, method_name, generator_file, reference_file, scales, seeds_per_scale, new_inputs):
+    if not candidates:
+        return {"ranking": [], "pairs": {}, "new_disagree_files": [], "error": "no candidates given"}
+    cwd = _cwd()
+    try:
+        timeout = max(1, min(int(timeout or 5), 300))
+    except Exception:
+        timeout = 5
+    cands = []
+    seen = set()
+    for i, c in enumerate(candidates):
+        p = _abs(str(c), cwd)
+        label = str(c)
+        if label in seen:
+            label = f"{label}#{i}"
+        seen.add(label)
+        cands.append((label, p))
+    tmpdir = tempfile.mkdtemp(prefix="evalcand_")
+    try:
+        if method_name:
+            if not generator_file:
+                return {"ranking": [], "pairs": {}, "new_disagree_files": [],
+                        "error": "generator_file is required for method_name"}
+            ref_file = _abs(reference_file, cwd) if reference_file else None
+            if not ref_file or not os.path.isfile(ref_file):
+                return {"ranking": [], "pairs": {}, "new_disagree_files": [],
+                        "error": "reference_file is required for method_name"}
+            gen = _abs(generator_file, cwd)
+            sc = [int(s) for s in (scales or [1, 2, 3])][:50]
+            spc = max(1, min(int(seeds_per_scale or 20), 2000))
+            res = _evaluate_method(cands, class_name, method_name, gen, ref_file, sc, spc, timeout, cwd, tmpdir)
+            new_files = []
+        else:
+            samples = _load_samples(_abs(samples_dir, cwd) if samples_dir else None)
+            # sample inputs are also checked against the reference/checker (they are not saved to the pool)
+            pool = [(f"{n}.in", inp) for n, inp, _ in samples] + _load_pool(_abs(pool_dir, cwd) if pool_dir else None)
+            n_old = len(pool)
+            for i, text in enumerate(new_inputs or []):
+                if isinstance(text, str) and text.strip():
+                    pool.append((f"new_{i:03d}.in", text))
+            res = _evaluate_stdin(cands, samples, pool, reference_cmd, checker_cmd, timeout, cwd, tmpdir)
+            new_files = _save_disagreements(res, pool, n_old, pool_dir, cwd)
+        ranking = sorted(res["records"].values(), key=score_tuple, reverse=True)
+        for r in ranking:
+            r["score"] = list(score_tuple(r))
+        return {"ranking": ranking, "pairs": res.get("pairs", {}), "new_disagree_files": new_files,
+                "error": None, "pool_size": res.get("pool_size", 0),
+                "samples_total": res.get("samples_total", 0),
+                "disagree_inputs": [(n, inp, why) for n, inp, why in res.get("new_disagree", [])]}
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def _save_disagreements(res, pool, n_old, pool_dir, cwd):
+    """Append disagreeing inputs that came from new_inputs to pool_dir as new *.in files.
+    Returns the list of saved file names."""
+    if not pool_dir:
+        return []
+    pdir = _abs(pool_dir, cwd)
+    os.makedirs(pdir, exist_ok=True)
+    existing = set(os.listdir(pdir))
+    texts = set()
+    for n in existing:
+        if n.endswith(".in"):
+            try:
+                with open(os.path.join(pdir, n), "r", encoding="utf-8", errors="replace") as f:
+                    texts.add(f.read())
+            except Exception:
+                pass
+    saved = []
+    k = 0
+    for idx, (name, inp) in enumerate(pool):
+        if idx < n_old:
+            continue
+        why = [w for (n2, _, w) in res.get("new_disagree", []) if n2 == name]
+        if not why or inp in texts or len(inp) > MAX_INPUT_BYTES:
+            continue
+        while f"disagree_{k:04d}.in" in existing:
+            k += 1
+        fname = f"disagree_{k:04d}.in"
+        with open(os.path.join(pdir, fname), "w", encoding="utf-8") as f:
+            f.write(inp)
+        existing.add(fname)
+        texts.add(inp)
+        saved.append(fname)
+    return saved
+
+
+def format_result(result, n_show=MAX_DISAGREE_SHOWN):
+    if result.get("error"):
+        return "Error: evaluate_candidates failed: " + str(result["error"])
+    lines = []
+    ranking = result.get("ranking", [])
+    lines.append("Ranking (best first). score = (samples_passed, ref_agree, majority_agree, -max_time)")
+    for i, r in enumerate(ranking):
+        lines.append(
+            f"{i + 1}. {r['label']}: score={tuple(round(x, 3) if isinstance(x, float) else x for x in r['score'])} "
+            f"samples {r['samples_passed']}/{r['samples_total']}, pool/ref agree {r['ref_agree']}/{r['ref_total']}, "
+            f"majority {r['majority_agree']}, crashes {r['crashes']}, timeouts {r['timeouts']}, "
+            f"empty {r['empty']}, max_time {r['max_time']:.3f}s"
+        )
+        if r.get("report"):
+            lines.append("   " + _clip(r["report"], 600).replace("\n", "\n   "))
+    if result.get("pairs"):
+        lines.append("Pairwise disagreements on pool inputs:")
+        for k, v in result["pairs"].items():
+            lines.append(f"  {k}: {v}")
+    if result.get("pool_size"):
+        lines.append(f"Pool size: {result['pool_size']} inputs; new disagreeing inputs saved: "
+                     f"{len(result.get('new_disagree_files', []))} {result.get('new_disagree_files', [])[:10]}")
+    dis = result.get("disagree_inputs", [])
+    if dis:
+        lines.append(f"Disagreeing pool inputs (candidates differ or reference/checker rejects): {len(dis)}")
+        for name, inp, why in dis[:n_show]:
+            lines.append(f"-- {name}: {why}\ninput:\n{_clip(inp, 300)}")
+    shown = 0
+    for r in ranking:
+        for f in r.get("failures", []):
+            if shown >= n_show:
+                break
+            shown += 1
+            lines.append(f"-- failure for {r['label']} ({f['where']}): {f['info']}")
+            if f.get("input"):
+                lines.append("input:\n" + _clip(f["input"], 400))
+            if f.get("expected"):
+                lines.append("expected:\n" + _clip(f["expected"], 300))
+            if f.get("actual"):
+                lines.append("actual:\n" + _clip(f["actual"], 300))
+    return "\n".join(lines)
+
+
+def tool_function(candidates, samples_dir="", pool_dir="", reference_cmd="", checker_cmd="", timeout=5,
+                  class_name="", method_name="", generator_file="", reference_file="", scales=None,
+                  seeds_per_scale=20, new_inputs=None):
+    if isinstance(candidates, str):
+        candidates = [candidates]
+    result = evaluate(candidates, samples_dir=samples_dir or None, pool_dir=pool_dir or None,
+                      reference_cmd=reference_cmd or None, checker_cmd=checker_cmd or None,
+                      timeout=timeout, class_name=class_name or None, method_name=method_name or None,
+                      generator_file=generator_file or None, reference_file=reference_file or None,
+                      scales=scales, seeds_per_scale=seeds_per_scale, new_inputs=new_inputs or [])
+    return _clip(format_result(result), 8000)
