+        if not scored:
+            prev = candidates[-1]
+            return (f"\n\n## Previous attempt\nAttempt {prev['k']} did not write a solution.py. "
+                    f"Write a complete solution this time.\n")
+        best = max(scored, key=lambda c: c['score'])
+        prev = candidates[-1]
+        code = self._read_file(prev['path'])
+        section = (
+            f"\n\n## Previous attempt\n"
+            f"Attempt {prev['k']} wrote {prev['path']}. Its code is below.\n"
+            f"```python\n{code}\n```\n"
+            f"Score tuple (samples_passed, ref_agreement, majority_agreement, -max_time) = {prev['score']}. "
+            f"Best so far is attempt {best['k']} with {best['score']}.\n\n"
+            f"Evaluation report:\n{prev['report']}\n\n"
+            f"The previous attempt has unresolved failures. Either fix the bug (re-check the statement, "
+            f"then compare with the failing inputs below) or switch to a fundamentally different algorithm "
+            f"if the earlier approach is wrong. Work in {self.git_tempdir}/cand_{k}/.\n"
+            f"For every disagreement below: re-read the statement, decide which output is right, "
+            f"save the failing input into the shared pool {os.path.join(self.git_tempdir, 'pool')}/ as a new *.in file so it stays as a regression test, "
+            f"and do not reuse the same flawed assumption that produced it.\n"
+        )
+        return section
+
+    def _read_file(self, path):
+        try:
+            with open(path, 'r', encoding='utf-8', errors='replace') as f:
+                return f.read()
+        except Exception as e:
+            return f"(could not read {path}: {e})"
+
+    def _select_best(self, candidates):
+        """Copy the best candidate to {git_tempdir}/solution.py (never a regressed edit).
+        All scored candidates are re-evaluated together against the final pool so that their score
+        tuples are comparable (majority agreement depends on the candidate set)."""
+        scored = [c for c in candidates if c['score'] is not None]
+        if not scored:
+            safe_log("No candidate could be scored; leaving solution.py untouched.")
+            return
+        final = self._evaluate(candidates_so_far=[c['path'] for c in scored],
+                               pool_dir=os.path.join(self.git_tempdir, 'pool'))
+        final_scores = {}
+        for rec in final.get('ranking', []):
+            final_scores[os.path.abspath(rec['path'])] = tuple(rec['score'])
+        for c in scored:
+            c['final_score'] = final_scores.get(os.path.abspath(c['path']), c['score'])
+        best = max(scored, key=lambda c: (c['final_score'], -c['k']))
+        safe_log("Final scores: " + ", ".join(f"attempt {c['k']}={c['final_score']}" for c in scored))
+        dst = os.path.join(self.git_tempdir, 'solution.py')
+        with open(best['path'], 'r', encoding='utf-8', errors='replace') as f:
+            text = f.read()
+        with open(dst, 'w', encoding='utf-8') as f:
+            f.write(text)
+        safe_log(f"Selected attempt {best['k']} with score {best['final_score']} -> {dst}")
