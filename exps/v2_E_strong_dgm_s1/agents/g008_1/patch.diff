diff --git a/tools/coverage_report.py b/tools/coverage_report.py
new file mode 100644
index 0000000..5f4c9fb
--- /dev/null
+++ b/tools/coverage_report.py
@@ -0,0 +1,210 @@
+import json
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+
+from tools.stress_test import _cwd
+
+RUN_TIMEOUT = 10
+MAX_LISTED = 200  # max unexecuted lines/branches listed
+
+
+def tool_info():
+    return {
+        "name": "coverage_report",
+        "description": """Report which lines of a source file were never executed when the solution runs on a set of inputs.\n
+* Runs `solution_cmd` once per file in `input_files` (each file is used as stdin), under `coverage run --branch` if the `coverage` module is installed, otherwise under `python3 -m trace --count`. The per-run results are merged.\n
+* Returns the percentage of executable lines covered and the list of unexecuted lines (with line numbers and source text). With `coverage` it also lists branches that were never taken.\n
+* Use it to find special-case branches that no test reaches, then write a small input that reaches each one.\n
+* `solution_cmd` must invoke python (e.g. 'python3 solution.py'); the python command is instrumented.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin, e.g. 'python3 solution.py'. Default 'python3 solution.py'."
+                },
+                "input_files": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Paths of input files; each one is fed to the solution on stdin in a separate run."
+                },
+                "source_file": {
+                    "type": "string",
+                    "description": "Path of the source file whose coverage is reported. Default 'solution.py'."
+                }
+            },
+            "required": ["input_files"]
+        }
+    }
+
+
+_PY_RE = re.compile(r'(^|\s)(python3?)(?=\s|$)')
+
+
+def _has_coverage(cwd):
+    try:
+        p = subprocess.run("python3 -c 'import coverage'", shell=True, cwd=cwd,
+                           stdin=subprocess.DEVNULL, capture_output=True, timeout=30)
+        return p.returncode == 0
+    except Exception:
+        return False
+
+
+def _instrument(solution_cmd, engine_args):
+    """Insert the instrumentation after the first `python`/`python3` token of the command."""
+    m = _PY_RE.search(solution_cmd)
+    if not m:
+        return None
+    head = solution_cmd[:m.end()]
+    tail = solution_cmd[m.end():]
+    return f"{head} {engine_args}{tail}"
+
+
+def _run_one(cmd, cwd, input_path):
+    """Run the instrumented command on one input. Returns '' on success, else a short reason."""
+    with open(input_path, 'rb') as f:
+        try:
+            p = subprocess.run(cmd, shell=True, cwd=cwd, stdin=f, capture_output=True,
+                               timeout=RUN_TIMEOUT)
+        except subprocess.TimeoutExpired:
+            return f'timed out after {RUN_TIMEOUT} seconds'
+        except Exception as e:
+            return f'could not run: {e}'
+    if p.returncode == 0:
+        return ''
+    err = p.stderr.decode('utf-8', errors='replace').strip()
+    return f'exit code {p.returncode}' + (f"\n{err[-400:]}" if err else '')
+
+
+def _source_lines(path):
+    with open(path, encoding='utf-8', errors='replace') as f:
+        return f.read().split('\n')
+
+
+def _report_trace(cwd, solution_cmd, input_files, source_file, tmpdir, src_abs):
+    pkl = os.path.join(tmpdir, 'counts.pkl')
+    covdir = os.path.join(tmpdir, 'cov')
+    os.makedirs(covdir, exist_ok=True)
+    cmd = _instrument(solution_cmd, f"-m trace --count --file={pkl} -C {covdir}")
+    if cmd is None:
+        return "Error: solution_cmd must invoke python (e.g. 'python3 solution.py')."
+    problems = []
+    for i, path in enumerate(input_files):
+        st = _run_one(cmd, cwd, path)
+        if st:
+            problems.append(f"input {i + 1} ({os.path.basename(path)}): {st}")
+    if not os.path.exists(pkl):
+        return "Error: no coverage data was recorded (the solution could not be run under trace).\n" + \
+            "\n".join(problems)
+    rep = f"python3 -m trace --report --missing --file={pkl} -C {covdir} {source_file}"
+    subprocess.run(rep, shell=True, cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True,
+                   timeout=60)
+    stem = os.path.splitext(os.path.basename(source_file))[0]
+    cover_path = os.path.join(covdir, stem + '.cover')
+    if not os.path.exists(cover_path):
+        return f"Error: trace produced no report for {source_file}.\n" + "\n".join(problems)
+
+    src = _source_lines(src_abs)
+    executed = 0
+    missing = []
+    with open(cover_path, encoding='utf-8', errors='replace') as f:
+        for lineno, raw in enumerate(f.read().split('\n'), start=1):
+            if raw.startswith('>>>>>>'):
+                missing.append(lineno)
+            elif re.match(r'^\s*\d+:', raw):
+                executed += 1
+    total = executed + len(missing)
+    pct = 100.0 * executed / total if total else 100.0
+    out = [f"Coverage (trace, line level; branch data unavailable): {pct:.1f}% of {total} executable lines "
+           f"executed over {len(input_files)} run(s)."]
+    out += _format_missing_lines(missing, src)
+    if problems:
+        out.append("Runs with problems:\n" + "\n".join(problems))
+    return "\n".join(out)
+
+
+def _format_missing_lines(missing, src):
+    if not missing:
+        return ["No unexecuted lines."]
+    out = [f"Unexecuted lines ({len(missing)}):"]
+    for n in missing[:MAX_LISTED]:
+        text = src[n - 1].rstrip() if 0 < n <= len(src) else ''
+        out.append(f"  line {n}: {text}")
+    if len(missing) > MAX_LISTED:
+        out.append(f"  ... {len(missing) - MAX_LISTED} more")
+    return out
+
+
+def _report_coverage(cwd, solution_cmd, input_files, source_file, tmpdir, src_abs):
+    data = os.path.join(tmpdir, 'cov.data')
+    cmd = _instrument(solution_cmd, f"-m coverage run --branch -a --data-file={data}")
+    if cmd is None:
+        return "Error: solution_cmd must invoke python (e.g. 'python3 solution.py')."
+    problems = []
+    for i, path in enumerate(input_files):
+        st = _run_one(cmd, cwd, path)
+        if st:
+            problems.append(f"input {i + 1} ({os.path.basename(path)}): {st}")
+    jpath = os.path.join(tmpdir, 'cov.json')
+    subprocess.run(f"python3 -m coverage json --data-file={data} -o {jpath}", shell=True, cwd=cwd,
+                   stdin=subprocess.DEVNULL, capture_output=True, timeout=60)
+    if not os.path.exists(jpath):
+        return "Error: coverage recorded no data.\n" + "\n".join(problems)
+    with open(jpath) as f:
+        report = json.load(f)
+    want = os.path.realpath(src_abs)
+    entry = None
+    for key, val in report.get('files', {}).items():
+        if os.path.realpath(os.path.join(cwd, key)) == want:
+            entry = val
+            break
+    if entry is None:
+        return f"Error: {source_file} was not executed under coverage.\n" + "\n".join(problems)
+    summ = entry.get('summary', {})
+    pct = summ.get('percent_covered', 100.0)
+    src = _source_lines(src_abs)
+    missing = sorted(entry.get('missing_lines', []))
+    out = [f"Coverage (coverage.py, branch tracking): {pct:.1f}% of {summ.get('num_statements', '?')} statements "
+           f"and {summ.get('num_branches', 0)} branches, over {len(input_files)} run(s)."]
+    out += _format_missing_lines(missing, src)
+    branches = entry.get('missing_branches', [])
+    if branches:
+        out.append(f"Branches never taken ({len(branches)}):")
+        for a, b in branches[:MAX_LISTED]:
+            where = 'exit' if b < 0 else f'line {b}'
+            text = src[a - 1].rstrip() if 0 < a <= len(src) else ''
+            out.append(f"  line {a} -> {where}: {text}")
+    if problems:
+        out.append("Runs with problems:\n" + "\n".join(problems))
+    return "\n".join(out)
+
+
+def tool_function(input_files=None, solution_cmd='python3 solution.py', source_file='solution.py'):
+    if isinstance(input_files, str):
+        input_files = [input_files]
+    if not input_files:
+        return "Error: input_files must list at least one input file."
+    if not solution_cmd:
+        solution_cmd = 'python3 solution.py'
+    if not source_file:
+        source_file = 'solution.py'
+    cwd = _cwd()
+    input_files = [p if os.path.isabs(p) else os.path.join(cwd, p) for p in input_files]
+    for p in input_files:
+        if not os.path.isfile(p):
+            return f"Error: input file not found: {p}"
+    src_abs = source_file if os.path.isabs(source_file) else os.path.join(cwd, source_file)
+    if not os.path.isfile(src_abs):
+        return f"Error: source file not found: {source_file}"
+    tmpdir = tempfile.mkdtemp(prefix="coverage_")
+    try:
+        if _has_coverage(cwd):
+            return _report_coverage(cwd, solution_cmd, input_files, source_file, tmpdir, src_abs)
+        return _report_trace(cwd, solution_cmd, input_files, source_file, tmpdir, src_abs)
+    except Exception as e:
+        return f"Error: coverage_report failed internally: {type(e).__name__}: {e}"
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
