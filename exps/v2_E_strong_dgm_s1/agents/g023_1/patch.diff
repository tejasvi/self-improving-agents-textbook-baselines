+import random
+import sys
+
+
+def main():
+    rng = random.Random(int(sys.argv[1]))
+    n = rng.randint(3, 8)
+    vals = [rng.randint(-5, 10) for _ in range(n)]
+    if rng.random() < 0.8:
+        i, j, k = sorted(rng.sample(range(n), 3))
+        x = vals[i] + vals[j] + vals[k]
+    else:
+        x = rng.randint(-15, 30)
+    print(n, x)
+    print(*vals)
+
+
+if __name__ == "__main__":
+    main()
