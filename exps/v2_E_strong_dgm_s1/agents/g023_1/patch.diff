@@ -0,0 +1,19 @@
+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    n, x = int(data[0]), int(data[1])
+    a = [int(v) for v in data[2:2 + n]]
+    # First triple in natural nested-loop order (i<j<k) whose sum is x.
+    for i in range(n):
+        for j in range(i + 1, n):
+            for k in range(j + 1, n):
+                if a[i] + a[j] + a[k] == x:
+                    print(a[i], a[j], a[k])
+                    return
+    print(-1)
+
+
+if __name__ == "__main__":
+    main()
