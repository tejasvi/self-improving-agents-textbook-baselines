+import random
+import sys
+
+# Max-size assumed: N = 3000, |A_i| <= 10^9, |X| <= 3*10^9 (adjust if the statement differs).
+N = 3000
+LIM = 10 ** 9
+
+
+def main():
+    seed = int(sys.argv[1])
+    rng = random.Random(seed)
+    shape = seed % 4
+    if shape == 0:  # all equal values
+        v = rng.randint(-LIM, LIM)
+        vals = [v] * N
+        x = 3 * v
+    elif shape == 1:  # random values, target from a real triple
+        vals = [rng.randint(-LIM, LIM) for _ in range(N)]
+        i, j, k = sorted(rng.sample(range(N), 3))
+        x = vals[i] + vals[j] + vals[k]
+    elif shape == 2:  # sorted or reverse-sorted, unreachable or late target
+        vals = sorted(rng.randint(-LIM, LIM) for _ in range(N))
+        if seed % 8 == 2:
+            vals.reverse()
+        x = rng.randint(-3 * LIM, 3 * LIM)
+    else:  # many distinct small values, skewed
+        vals = [rng.randint(0, 50) for _ in range(N - 10)] + [rng.randint(LIM // 2, LIM) for _ in range(10)]
+        rng.shuffle(vals)
+        i, j, k = sorted(rng.sample(range(N), 3))
+        x = vals[i] + vals[j] + vals[k]
+    print(N, x)
+    print(*vals)
+
+
+if __name__ == "__main__":
+    main()
