index 0000000..b24b4f5
--- /dev/null
+++ b/tools/scaling_probe.py
@@ -0,0 +1,259 @@
+import json
+import math
+import os
+import random
+import signal
+import subprocess
+import sys
+import time
+
+# Wall/measured time above this (seconds) at max_n (measured or extrapolated) fails the probe.
+LIMIT_S = 1.0
+# Points faster than this are too noisy to use for the growth-exponent fit.
+FIT_MIN_S = 0.02
+
+_HARNESS = r'''
+import sys, json, importlib.util, os, time
+spec = json.loads(sys.stdin.read())
+sys.setrecursionlimit(10000)
+sys.path.insert(0, os.path.dirname(os.path.abspath(spec["path"])))
+mod_spec = importlib.util.spec_from_file_location("sol_under_test", spec["path"])
+mod = importlib.util.module_from_spec(mod_spec)
+mod_spec.loader.exec_module(mod)
+g = dict(vars(mod))
+g["N"] = spec["n"]
+args = eval("(" + spec["expr"] + ",)", g)
+obj = mod.Solution()
+t0 = time.perf_counter()
+res = getattr(obj, spec["method"])(*args)
+dt = time.perf_counter() - t0
+sys.stderr.write("@@T %r\n" % dt)
+'''
+
+
+def tool_info():
+    return {
+        "name": "scaling_probe",
+        "description": """Adversarial scaling probe: runs a solution on built-in worst-case input families at sizes max_n/16, max_n/8, max_n/4, max_n/2 and max_n, each run in an isolated subprocess with a hard timeout.
+* Families for input_kind 'string': all-equal ('a'*n), single dominant letter plus random others, two-letter mix, sorted random letters, reverse-sorted random letters, random letters.
+* Families for input_kind 'int_array': all-equal [7]*n, single dominant value plus distinct values, two-value mix, range(n), reversed range, random values.
+* input_kind 'custom': only the family given by gen_expr is used.
+* mode 'class_method': solution.py defines `class Solution`; method_name is called with the generated argument(s) and only the method call itself is timed.
+* mode 'stdin': solution.py is a stdin/stdout program. gen_expr is REQUIRED: a Python expression using the variable N that evaluates to the full stdin text for size N (e.g. "'1\\n' + ' '.join(['5']*N) + '\\n'").
+* Prints a per-family table (family, size, time, status), the fitted growth exponent (log-log fit) and the extrapolated time at max_n for each family. Families whose time at max_n (measured or extrapolated) exceeds about 1 s, or that time out, are flagged.
+* The last line is 'VERDICT: PASS' or 'VERDICT: FAIL (...)'. A multiplicative O(n^2) behaviour in a count shows up as exponent near 2.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file."},
+                "mode": {"type": "string", "description": "Either 'class_method' (call Solution().method_name(...)) or 'stdin' (run the file as a program with stdin)."},
+                "method_name": {"type": "string", "description": "Name of the Solution method to call (required for class_method mode; ignored for stdin)."},
+                "max_n": {"type": "integer", "description": "The maximum size allowed by the statement constraints, e.g. 20000 for a string of length 2*10^4."},
+                "input_kind": {"type": "string", "description": "One of 'string' (single str argument), 'int_array' (single list of ints argument) or 'custom' (use gen_expr only)."},
+                "gen_expr": {"type": "string", "description": "Optional. Python expression using the variable N. Class mode: a comma-separated argument list (evaluated like the method arguments). Stdin mode: the full stdin text. Required for stdin mode and for input_kind 'custom'."},
+                "timeout_s": {"type": "integer", "description": "Hard timeout in seconds per run (default 5)."}
+            },
+            "required": ["solution_path", "mode", "max_n", "input_kind"]
+        }
+    }
+
+
+def _run_proc(cmd, stdin_text, cwd, timeout_s):
+    """Run cmd; returns (status, wall_seconds, stdout, stderr). status is OK, ERROR or TIMEOUT."""
+    t0 = time.perf_counter()
+    try:
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, cwd=cwd, start_new_session=True)
+    except Exception as e:
+        return 'ERROR', 0.0, '', f'failed to start: {e}'
+    try:
+        out, err = p.communicate(stdin_text, timeout=timeout_s)
+        el = time.perf_counter() - t0
+        if p.returncode != 0:
+            return 'ERROR', el, out or '', (err or '') + f'\n(exit code {p.returncode})'
+        return 'OK', el, out or '', err or ''
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'TIMEOUT', time.perf_counter() - t0, '', f'killed after {timeout_s}s'
+
+
+def _families(input_kind, n):
+    """Return list of (family_name, class_argument_expression_text) for built-in families of size n."""
+    rng = random.Random(12345)
+    letters = 'abcdefghijklmnopqrstuvwxyz'
+    if input_kind == 'string':
+        dom = list('a' * (n - n // 10) + ''.join(rng.choice('bcdefg') for _ in range(n // 10)))
+        rng.shuffle(dom)
+        dom = ''.join(dom)
+        rnd = ''.join(rng.choice(letters) for _ in range(n))
+        srt = ''.join(sorted(rnd))
+        return [
+            ('all_equal', repr('a' * n)),
+            ('single_dominant', repr(dom)),
+            ('two_letter_mix', repr(''.join(rng.choice('ab') for _ in range(n)))),
+            ('sorted', repr(srt)),
+            ('reverse_sorted', repr(srt[::-1])),
+            ('random', repr(rnd)),
+        ]
+    if input_kind == 'int_array':
+        dom = [7] * (n - n // 10) + [rng.randint(0, 10 ** 9) for _ in range(n // 10)]
+        rng.shuffle(dom)
+        return [
+            ('all_equal', repr([7] * n)),
+            ('single_dominant', repr(dom)),
+            ('two_value_mix', repr([rng.choice([1, 10 ** 9]) for _ in range(n)])),
+            ('sorted', repr(list(range(n)))),
+            ('reverse_sorted', repr(list(range(n))[::-1])),
+            ('random', repr([rng.randint(0, max(1, n)) for _ in range(n)])),
+        ]
+    return []
+
+
+def _fit(points):
+    """Least-squares slope and prediction function over (n, t) points with t > FIT_MIN_S. Returns (slope, a) or None."""
+    pts = [(math.log(n), math.log(t)) for n, t in points if n > 0 and t > FIT_MIN_S]
+    if len(pts) < 2:
+        return None
+    mx = sum(x for x, _ in pts) / len(pts)
+    my = sum(y for _, y in pts) / len(pts)
+    den = sum((x - mx) ** 2 for x, _ in pts)
+    if den <= 0:
+        return None
+    slope = sum((x - mx) * (y - my) for x, y in pts) / den
+    return slope, my - slope * mx
+
+
+def _sizes(max_n):
+    sizes = []
+    for d in (16, 8, 4, 2, 1):
+        s = max(1, max_n // d)
+        if s not in sizes:
+            sizes.append(s)
+    return sizes
+
+
+def tool_function(solution_path, mode, max_n, input_kind, method_name=None, gen_expr=None, timeout_s=5):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 5), 60))
+    except Exception:
+        timeout_s = 5
+    try:
+        max_n = int(max_n)
+    except Exception:
+        return "Error: max_n must be an integer."
+    if max_n < 2:
+        return "Error: max_n must be at least 2."
+    max_n = min(max_n, 2_000_000)
+    path = os.path.abspath(str(solution_path))
+    if not os.path.isfile(path):
+        return f"Error: solution file not found: {path}"
+    if mode not in ('class_method', 'stdin'):
+        return "Error: mode must be 'class_method' or 'stdin'."
+    if mode == 'class_method' and not method_name:
+        return "Error: method_name is required in class_method mode."
+    if input_kind not in ('string', 'int_array', 'custom'):
+        return "Error: input_kind must be 'string', 'int_array' or 'custom'."
+    if input_kind == 'custom' and not gen_expr:
+        return "Error: input_kind 'custom' needs gen_expr."
+    if mode == 'stdin' and not gen_expr:
+        return "Error: stdin mode needs gen_expr (a Python expression using N that yields the full stdin text)."
+    cwd = os.path.dirname(path)
+
+    # Build (family, size) -> input payload generator
+    def stdin_text_for(n):
+        try:
+            text = eval(gen_expr, {'N': n, 'random': random})
+        except Exception as e:
+            return None, f"gen_expr failed for N={n}: {e}"
+        return str(text), None
+
+    results = {}  # family -> list of (n, status, time, detail)
+    if input_kind == 'custom' or mode == 'stdin':
+        family_names = ['custom']
+    else:
+        family_names = [name for name, _ in _families(input_kind, 4)]
+
+    for fam in family_names:
+        results[fam] = []
+        stop = False
+        for n in _sizes(max_n):
+            if stop:
+                break
+            if mode == 'stdin':
+                text, err = stdin_text_for(n)
+                if err:
+                    results[fam].append((n, 'ERROR', 0.0, err))
+                    continue
+                status, el, out, errtxt = _run_proc([sys.executable, path], text, cwd, timeout_s)
+            else:
+                if input_kind == 'custom':
+                    expr = gen_expr
+                else:
+                    expr = dict(_families(input_kind, n))[fam]
+                payload = json.dumps({'path': path, 'method': method_name, 'expr': expr, 'n': n})
+                status, el, out, errtxt = _run_proc([sys.executable, '-c', _HARNESS], payload, cwd, timeout_s)
+                if status == 'OK':
+                    for ln in (errtxt or '').splitlines():
+                        if ln.startswith('@@T '):
+                            try:
+                                el = float(ln[4:])
+                            except ValueError:
+                                pass
+            detail = ''
+            if status == 'ERROR':
+                detail = (errtxt or '').strip().splitlines()[-1:] or ['']
+                detail = detail[0][:200]
+            results[fam].append((n, status, el, detail))
+            if status == 'TIMEOUT':
+                stop = True  # larger sizes of this family would only time out too
+
+    lines = [f"Scaling probe of {path} ({mode}{', ' + method_name if method_name else ''}), "
+             f"max_n={max_n}, input_kind={input_kind}, timeout {timeout_s}s per run, limit {LIMIT_S}s at max_n",
+             f"{'family':<18} {'size':>9} {'time(s)':>9}  status"]
+    failures = []
+    summary = []
+    for fam in family_names:
+        rows = results[fam]
+        for n, status, el, detail in rows:
+            lines.append(f"{fam:<18} {n:>9} {el:>9.3f}  {status}" + (f" {detail}" if status == 'ERROR' and detail else ''))
+        ok_pts = [(n, el) for n, status, el, _ in rows if status == 'OK']
+        timed_out = any(status == 'TIMEOUT' for _, status, _, _ in rows)
+        fit = _fit(ok_pts)
+        measured_max = next((el for n, status, el, _ in rows if n == max_n and status == 'OK'), None)
+        if fit is not None:
+            slope, a = fit
+            extrap = math.exp(a + slope * math.log(max_n))
+            fit_txt = f"exponent {slope:.2f}"
+        elif ok_pts:
+            n_last, t_last = ok_pts[-1]
+            extrap = t_last * (max_n / n_last)
+            slope = None
+            fit_txt = "exponent n/a (all runs < 0.02s); linear extrapolation"
+        else:
+            extrap = None
+            slope = None
+            fit_txt = "no successful run"
+        at_max = measured_max if measured_max is not None else extrap
+        flagged = timed_out or (at_max is not None and max(at_max, extrap or 0.0) > LIMIT_S)
+        est = f"{extrap:.3f}s" if extrap is not None else "n/a"
+        summary.append(f"  {fam:<18} {fit_txt}; extrapolated at max_n={max_n}: {est}"
+                       + (f"; measured at max_n: {measured_max:.3f}s" if measured_max is not None else "")
+                       + ("  <-- FLAG" if flagged else ""))
+        if flagged:
+            why = "timed out" if timed_out else f"extrapolated {est} > {LIMIT_S}s"
+            failures.append(f"{fam} ({why})")
+    lines.append("Growth per family:")
+    lines.extend(summary)
+    if failures:
+        lines.append("VERDICT: FAIL (" + "; ".join(failures) + "). Complexity is too high at max_n: "
+                     "derive a lower-complexity algorithm; pruning or early breaks do not fix this.")
+    else:
+        lines.append("VERDICT: PASS (all families within the limit at max_n).")
+    return "\n".join(lines)
