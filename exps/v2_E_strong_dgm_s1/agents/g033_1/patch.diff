new file mode 100644
index 0000000..502da40
--- /dev/null
+++ b/exact.py
@@ -0,0 +1,9 @@
+# Same algorithm as solution.py with no caps/prunes (there are none): one linear pass.
+import sys
+def solve(data):
+    n, lo, hi = int(data[0]), int(data[1]), int(data[2])
+    return sum(int(x) for x in data[3:3 + n] if lo <= int(x) <= hi)
+if __name__ == "__main__":
+    data = sys.stdin.read().split()
+    if data:
+        print(f"! {solve(data)}")
