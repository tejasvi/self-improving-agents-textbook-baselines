+import difflib
+import os
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "sample_diff",
+        "description": """Run a stdin/stdout Python program on each sample input and compare its stdout with the expected output exactly.
+* For each sample reports EXACT_MATCH, WHITESPACE_ONLY_DIFF (differs only in trailing whitespace / line endings), or DIFF with a unified diff of expected vs actual.
+* Also returns raw stderr for failing or crashing runs.
+* Ends with a summary line 'k/n samples match exactly'.
+* Use it to check that solution.py reproduces the sample outputs byte-for-byte, which matters even for problems that accept any valid answer.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (run as `python3 solution_path`)."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Sample inputs, one string per sample (raw stdin text). Parallel to expected_outputs."
+                },
+                "expected_outputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Expected sample outputs, one string per sample, in the same order as inputs."
+                },
+                "timeout_s": {
+                    "type": "integer",
+                    "description": "Hard timeout in seconds per sample (default 10)."
+                }
+            },
+            "required": ["solution_path", "inputs", "expected_outputs"]
+        }
+    }
+
+
+def _clip(s, n=2000):
+    return s if len(s) <= n else s[: n // 2] + "\n ... \n" + s[-n // 2:]
+
+
+def _run_one(solution_path, stdin_text, timeout_s):
+    try:
+        p = subprocess.run(
+            ["python3", solution_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout_s,
+            cwd=os.path.dirname(os.path.abspath(solution_path)) or None,
+        )
+        return p.returncode, p.stdout, p.stderr, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        return None, out, "", f"TIMEOUT after {timeout_s}s"
+    except Exception as e:
+        return None, "", "", f"failed to run: {e}"
+
+
+def tool_function(solution_path, inputs, expected_outputs, timeout_s=10):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 10), 120))
+    except Exception:
+        timeout_s = 10
+
+    if not isinstance(inputs, list) or not isinstance(expected_outputs, list):
+        return "ERROR: inputs and expected_outputs must be arrays of strings."
+    if len(inputs) != len(expected_outputs):
+        return f"ERROR: inputs ({len(inputs)}) and expected_outputs ({len(expected_outputs)}) must have the same length."
+    if not inputs:
+        return "ERROR: no samples provided."
+
+    path = os.path.abspath(str(solution_path))
+    if not os.path.isfile(path):
+        return f"ERROR: solution file not found: {path}"
+
+    n = len(inputs)
+    k = 0
+    lines = []
+    for i, (inp, exp) in enumerate(zip(inputs, expected_outputs), start=1):
+        inp = str(inp)
+        exp = str(exp)
+        t0 = time.time()
+        rc, out, err, special = _run_one(path, inp, timeout_s)
+        el = time.time() - t0
+        if special is None and rc != 0:
+            special = f"exit code {rc}"
+
+        if special is not None:
+            lines.append(f"Sample {i}: DIFF ({special}, {el:.2f}s)")
+            if out:
+                lines.append("Partial stdout:\n" + _clip(out.rstrip()))
+            if err:
+                lines.append("stderr:\n" + _clip(err.rstrip()))
+            continue
+
+        if out == exp:
+            k += 1
+            lines.append(f"Sample {i}: EXACT_MATCH ({el:.2f}s)")
+        elif [l.rstrip() for l in out.splitlines()] == [l.rstrip() for l in exp.splitlines()]:
+            lines.append(f"Sample {i}: WHITESPACE_ONLY_DIFF ({el:.2f}s)")
+        else:
+            diff = difflib.unified_diff(
+                exp.splitlines(keepends=False),
+                out.splitlines(keepends=False),
+                fromfile="expected",
+                tofile="actual",
+                lineterm="",
+            )
+            diff_text = _clip("\n".join(diff))
+            lines.append(f"Sample {i}: DIFF ({el:.2f}s)\n{diff_text}")
+        if err and err.strip():
+            lines.append("stderr:\n" + _clip(err.rstrip()))
+
+    lines.append(f"{k}/{n} samples match exactly")
+    return "\n".join(lines)
