+"""Alternative implementation of sample parsing for problem statements.
+
+Different algorithm from solution.py's line-by-line state machine:
+  1. Find every "Sample/Example Input|Output [N]" header with one regex over the whole text.
+  2. Each block is the text between consecutive headers (segment-based, not line-by-line).
+  3. Output blocks are truncated at the first blank line or prose/heading line.
+  4. Output blocks that still look like prose are dropped.
+
+Standalone: standard library only, no repo imports.
+Usage: python3 solution_alt.py < statement.txt   (prints the samples as JSON)
+"""
+import json
+import re
+import sys
+
+HEADER_RE = re.compile(
+    r"^[ \t]*(?:Sample|Example)[ \t]*(Input|Output)[ \t]*(\d*)[ \t]*:?[ \t]*$",
+    re.IGNORECASE | re.MULTILINE,
+)
+PROSE_LINE_RE = re.compile(
+    r"^\s*(#|The\s|the\s|Note|NOTE|Explanation|Output|Input|Constraints|Sample)",
+    re.IGNORECASE,
+)
+WORDY_RE = re.compile(r"[A-Za-z]{3,}\s+[A-Za-z]{2,}\s+[A-Za-z]{2,}")
+
+
+def _is_prose_line(line):
+    if PROSE_LINE_RE.match(line):
+        return True
+    return len(line.split()) > 6 and bool(WORDY_RE.search(line))
+
+
+def _truncate_output(block):
+    """Keep only the leading data lines of an output block."""
+    kept = []
+    for line in block.lstrip("\n").splitlines():
+        if not line.strip() or _is_prose_line(line):
+            break
+        kept.append(line.rstrip())
+    return "\n".join(kept).strip()
+
+
+def looks_like_prose(text):
+    if not text.strip():
+        return True
+    return any(_is_prose_line(l) for l in text.splitlines() if l.strip())
+
+
+def parse_samples(statement):
+    """Return a list of (input_text, expected_output_text) pairs, in statement order."""
+    headers = list(HEADER_RE.finditer(statement))
+    samples = []
+    for idx, h in enumerate(headers):
+        if h.group(1).lower() != "input":
+            continue
+        # Find the next header; it must be the matching Output header.
+        if idx + 1 >= len(headers):
+            break
+        nxt = headers[idx + 1]
+        if nxt.group(1).lower() != "output" or nxt.group(2) != h.group(2):
+            continue
+        inp = statement[h.end():nxt.start()].strip("\n")
+        inp = "\n".join(l.rstrip() for l in inp.splitlines()).strip()
+        # Output extends to the next header (or end of text).
+        end = headers[idx + 2].start() if idx + 2 < len(headers) else len(statement)
+        out = _truncate_output(statement[nxt.end():end])
+        if not inp or not out or looks_like_prose(out):
+            continue
+        samples.append((inp + "\n", out))
+    return samples
+
+
+def main():
+    statement = sys.stdin.read()
+    print(json.dumps(parse_samples(statement), indent=2))
+
+
+if __name__ == "__main__":
+    main()
