+    def _alt_prompt(self, approach_hint, prior_summaries=""):
+        prior = ""
+        if prior_summaries:
+            prior = ("\nFailure summaries of earlier candidates (avoid their mistakes):\n"
+                     f"<prior_candidates>\n{prior_summaries}\n</prior_candidates>\n")
+        return self._task_header() + (
+            f"\nSTEP 4 (ALTERNATIVE): Write an independent solution to {self.git_tempdir}/{{target}} "
