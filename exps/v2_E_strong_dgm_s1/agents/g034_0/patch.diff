+    def _has_source_edit(self):
+        """
+        Returns True if the repo diff (versus base_commit) contains added lines in at least one
+        non-helper, non-test file, and solution.py is not just the untouched starter stub.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+
+        # Split the diff into per-file blocks, keyed by the file path from the "diff --git" header.
+        blocks = {}
+        current = None
+        for line in diff.splitlines():
+            if line.startswith("diff --git"):
+                # Format: diff --git a/<path> b/<path>
+                parts = line.split(" b/")
+                path = parts[-1].strip() if len(parts) > 1 else line
+                current = path
+                blocks[current] = []
+            elif current is not None:
+                blocks[current].append(line)
+
+        def is_helper_or_test(path):
+            name = os.path.basename(path)
+            if name in ("brute.py", "gen.py", "checker.py"):
+                return True
+            if name.startswith("test") and name.endswith(".py"):
+                return True
+            if name.endswith("_test.py"):
+                return True
+            if "tests/" in path or path.startswith("tests/"):
+                return True
+            # Input / sample files
+            if name.startswith("input") or name.startswith("sample"):
+                return True
+            return False
+
+        has_added = False
+        for path, lines in blocks.items():
+            if is_helper_or_test(path):
+                continue
+            if any(l.startswith("+") and not l.startswith("+++") for l in lines):
+                has_added = True
+                break
+        if not has_added:
+            return False
+
+        # Stub check for solution.py: must not be only the starter stub (imports/defs/pass).
+        solution_path = os.path.join(self.git_tempdir, "solution.py")
+        if os.path.exists(solution_path):
