diff --git a/tools/bench.py b/tools/bench.py
new file mode 100644
index 0000000..b26df2b
--- /dev/null
+++ b/tools/bench.py
@@ -0,0 +1,112 @@
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+_HARNESS = r'''
+import sys, json, importlib.util, os
+spec = json.loads(sys.stdin.read())
+sys.setrecursionlimit(10000)
+sys.path.insert(0, os.path.dirname(os.path.abspath(spec["path"])))
+mod_spec = importlib.util.spec_from_file_location("sol_under_test", spec["path"])
+mod = importlib.util.module_from_spec(mod_spec)
+mod_spec.loader.exec_module(mod)
+args = eval("(" + spec["expr"] + ",)", vars(mod))
+obj = mod.Solution()
+res = getattr(obj, spec["method"])(*args)
+print(res)
+'''
+
+def tool_info():
+    return {
+        "name": "bench_solution",
+        "description": """Benchmark a solution file on a list of inputs, each run in an isolated subprocess with a hard timeout.\n
+* mode 'class_method': the file defines a `Solution` class; `method_name` is the method to call. Each entry in `inputs` is a comma-separated Python expression listing the method's arguments, e.g. `'a'*20000` or `[1]*100000, 5`. It is evaluated with the module's globals.
+* mode 'stdin': the file is a stdin/stdout program; each entry in `inputs` is the raw stdin text.
+* Returns a table with each input's label, wall time in seconds, status (OK / TIMEOUT / ERROR), and truncated output or error, plus the slowest case.
+* Use it to test adversarial max-size inputs (all-equal, all-distinct, skewed, sorted, maximum counts) and to check the worst-case runtime.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file."},
+                "mode": {"type": "string", "description": "Either 'class_method' (call Solution().method_name(...)) or 'stdin' (run the file as a program with stdin)."},
+                "method_name": {"type": "string", "description": "Name of the Solution method to call (required for class_method mode)."},
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of inputs. In class_method mode each is a comma-separated Python expression of the method arguments; in stdin mode each is the raw stdin text."
+                },
+                "timeout_s": {"type": "integer", "description": "Hard timeout in seconds per input (default 10)."}
+            },
+            "required": ["solution_path", "mode", "inputs"]
+        }
+    }
+
+def _clip(s, n=300):
+    s = s.strip()
+    return s if len(s) <= n else s[: n // 2] + " ... " + s[-n // 2:]
+
+def _run(cmd, stdin_text, cwd, timeout_s, env=None):
+    t0 = time.time()
+    try:
+        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             text=True, cwd=cwd, start_new_session=True, env=env)
+    except Exception as e:
+        return 'ERROR', time.time() - t0, '', f'failed to start: {e}'
+    try:
+        out, err = p.communicate(stdin_text, timeout=timeout_s)
+        el = time.time() - t0
+        if p.returncode != 0:
+            return 'ERROR', el, out, (err or '') + f'\n(exit code {p.returncode})'
+        return 'OK', el, out, err
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except Exception:
+            p.kill()
+        try:
+            p.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'TIMEOUT', time.time() - t0, '', f'killed after {timeout_s}s'
+
+def tool_function(solution_path, mode, inputs, method_name=None, timeout_s=10):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 10), 120))
+    except Exception:
+        timeout_s = 10
+    path = os.path.abspath(str(solution_path))
+    if not os.path.isfile(path):
+        return f"Error: solution file not found: {path}"
+    if mode not in ('class_method', 'stdin'):
+        return "Error: mode must be 'class_method' or 'stdin'."
+    if mode == 'class_method' and not method_name:
+        return "Error: method_name is required in class_method mode."
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    if not inputs:
+        return "Error: no inputs given."
+    cwd = os.path.dirname(path)
+    rows = []
+    for i, inp in enumerate(inputs):
+        inp = str(inp)
+        label = (inp.replace('\n', '\\n'))
+        label = label if len(label) <= 40 else label[:37] + '...'
+        if mode == 'class_method':
+            payload = json.dumps({'path': path, 'method': method_name, 'expr': inp})
+            status, el, out, err = _run([sys.executable, '-c', _HARNESS], payload, cwd, timeout_s)
+        else:
+            status, el, out, err = _run([sys.executable, path], inp, cwd, timeout_s)
+        detail = _clip(out) if status == 'OK' else _clip(err or 'no error text')
+        rows.append((i, label, el, status, detail))
+    lines = [f"Benchmark of {path} ({mode}{', ' + method_name if method_name else ''}), timeout {timeout_s}s per input",
+             f"{'#':>3}  {'input':<42} {'time(s)':>8}  {'status':<8} output/error"]
+    for i, label, el, status, detail in rows:
+        lines.append(f"{i:>3}  {label:<42} {el:>8.3f}  {status:<8} {detail}")
+    slow = max(rows, key=lambda r: r[2])
+    lines.append(f"Slowest: #{slow[0]} ({slow[1]}) took {slow[2]:.3f}s, status {slow[3]}")
+    n_bad = sum(1 for r in rows if r[3] != 'OK')
+    lines.append(f"Summary: {len(rows) - n_bad}/{len(rows)} OK" + ("" if n_bad == 0 else f", {n_bad} failed"))
+    return "\n".join(lines)
