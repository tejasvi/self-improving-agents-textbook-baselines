+    def _solution_written(self):
+        """
+        True iff solution.py exists, is non-empty, and appears as added lines in the diff
+        versus base_commit.
+        """
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        try:
+            if not os.path.isfile(path) or os.path.getsize(path) == 0:
+                return False
+        except OSError:
+            return False
+        try:
+            diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        except Exception:
+            return False
+        # Split the diff into per-file sections and look for solution.py with added lines
+        sections = re.split(r'(?m)^diff --git ', diff)
+        for sec in sections:
+            if not sec.strip():
+                continue
+            header = sec.split('\n', 1)[0]
+            if not re.search(r'(^|[ /])solution\.py( |$)', header):
+                continue
+            if any(line.startswith('+') and not line.startswith('+++') for line in sec.splitlines()):
+                return True
+        return False
+
+    def _last_assistant_text(self, msg_history):
+        """
+        Text of the last assistant message in msg_history (handles plain dicts,
+        content-block lists and SDK message objects).
+        """
+        for msg in reversed(msg_history or []):
+            role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+            if role != 'assistant':
+                continue
+            content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    text = block.get('text')
+                else:
+                    text = getattr(block, 'text', None)
+                if text:
+                    parts.append(text)
+            return "\n".join(parts)
+        return ''
+
+    def _extract_code_block(self, text):
+        m = re.search(r"```(?:python|py)?\s*\n(.*?)```", text or '', re.S)
+        return m.group(1) if m else None
+
