+# Independent alternative to solution.py. solution.py is a placeholder that
+# prints the number of whitespace-separated tokens on stdin. This version
+# computes the same count by streaming the input line by line and summing
+# per-line token counts, instead of splitting the whole input at once.
+import sys
+
+
+def count_tokens(stream):
+    total = 0
+    for line in stream:
+        total += len(line.split())
+    return total
+
+
+def main():
+    print(count_tokens(sys.stdin))
+
+
+if __name__ == "__main__":
+    main()
