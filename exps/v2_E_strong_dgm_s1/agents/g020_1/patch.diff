new file mode 100644
index 0000000..7706158
--- /dev/null
+++ b/tools/scale_check.py
@@ -0,0 +1,144 @@
+import glob
+import os
+import subprocess
+import time
+
+MAX_SHOW = 600  # max characters shown for expected/actual output per sample
+PASS_LINE = "SCALE GATE PASSED"
+FAIL_LINE = "SCALE GATE FAILED: solution does not scale or is wrong on a sample; change the algorithm, do not submit"
+
+
+def tool_info():
+    return {
+        "name": "scale_check",
+        "description": """Scale gate: run the solution on every sample input (including the huge ones) under a strict time limit and report per-sample results.\n
+* For each `sampleN.in` matching `samples_glob` (default 'sample*.in'), the solution command is run with stdin taken from the file and a time limit (default 2 seconds).\n
+* If a matching `sampleN.out` exists, stdout is compared with it token by token. Each sample is reported as 'sampleN: PASS <time>s', 'sampleN: WRONG' or 'sampleN: TIMEOUT (>Ns)', with elapsed times.\n
+* Run this after your first solution and after EVERY change of algorithm. The final line is 'SCALE GATE PASSED' or 'SCALE GATE FAILED'. If it fails, your brute force does not scale: derive a faster (closed-form or compressed) algorithm instead of submitting.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin and writing stdout, e.g. 'python3 solution.py'. Default 'python3 solution.py'."
+                },
+                "samples_glob": {
+                    "type": "string",
+                    "description": "Glob pattern (relative to the working directory) matching the sample input files, e.g. 'sample*.in'. Default 'sample*.in'."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each sample run. Default 2."
+                }
+            },
+            "required": []
+        }
+    }
+
+
+def _cwd(cwd=None):
+    if cwd and os.path.isdir(cwd):
+        return cwd
+    try:
+        from tools import bash as _bash
+        state_cwd = _bash._STATE.get('cwd')
+        if state_cwd and os.path.isdir(state_cwd):
+            return state_cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+def _clip(s, n=MAX_SHOW):
+    if s is None:
+        return ""
+    s = s.rstrip()
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters truncated> ...\n" + s[-n // 2:]
+
+
+def tool_function(solution_cmd='python3 solution.py', samples_glob='sample*.in', extra_inputs_glob=None, timeout=2):
+    try:
+        passed, text = run_scale_gate(
+            solution_cmd or 'python3 solution.py',
+            samples_glob or 'sample*.in',
+            timeout=int(timeout) if timeout else 2,
+            extra_inputs_glob=extra_inputs_glob,
+        )
+        return text
+    except Exception as e:
+        return f"Error: scale_check failed internally: {type(e).__name__}: {e}"
+
+
+def _kill_group(proc):
+    import signal
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except Exception:
+        try:
+            proc.kill()
+        except Exception:
+            pass
+    try:
+        proc.communicate(timeout=5)
+    except Exception:
+        pass
+
+
+def run_scale_gate(solution_cmd, samples_glob='sample*.in', timeout=2, cwd=None, extra_inputs_glob=None):
+    """Return (passed: bool, report: str). Used by the tool and by the forward() retry gate."""
+    timeout = max(1, min(int(timeout), 300))
+    cwd = _cwd(cwd)
+    pattern = samples_glob if os.path.isabs(samples_glob) else os.path.join(cwd, samples_glob)
+    in_files = sorted(glob.glob(pattern))
+    if extra_inputs_glob:
+        ep = extra_inputs_glob if os.path.isabs(extra_inputs_glob) else os.path.join(cwd, extra_inputs_glob)
+        in_files += [f for f in sorted(glob.glob(ep)) if f not in in_files]
+    if not in_files:
+        return False, f"Error: no files match '{samples_glob}' in {cwd}. Create sampleN.in/sampleN.out for ALL samples first.\n" + FAIL_LINE
+
+    lines = []
+    failed = 0
+    checked = 0
+    for in_path in in_files:
+        base = in_path[:-len('.in')] if in_path.endswith('.in') else in_path
+        out_path = base + '.out'
+        name = os.path.basename(base)
+        checked += 1
+        with open(in_path, 'rb') as fin:
+            start = time.time()
+            proc = subprocess.Popen(solution_cmd, shell=True, cwd=cwd, stdin=fin,
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                    start_new_session=True)
+            try:
+                out_b, err_b = proc.communicate(timeout=timeout)
+            except subprocess.TimeoutExpired:
+                _kill_group(proc)
+                failed += 1
+                lines.append(f"{name}: TIMEOUT (>{timeout}s)")
+                continue
+            elapsed = time.time() - start
+        actual = out_b.decode('utf-8', errors='replace')
+        err = err_b.decode('utf-8', errors='replace')
+        if proc.returncode != 0:
+            failed += 1
+            lines.append(f"{name}: WRONG (exit code {proc.returncode})\nstderr:\n{_clip(err)}")
+            continue
+        if os.path.isfile(out_path):
+            with open(out_path, 'r', encoding='utf-8', errors='replace') as f:
+                expected = f.read()
+            if actual.split() != expected.split():
+                failed += 1
+                lines.append(f"{name}: WRONG ({elapsed:.2f}s)\nexpected:\n{_clip(expected)}\nactual:\n{_clip(actual)}")
+                continue
+            lines.append(f"{name}: PASS {elapsed:.2f}s")
+        else:
+            lines.append(f"{name}: RAN {elapsed:.2f}s (no .out to compare)")
+
+    if failed == 0:
+        lines.append(f"{PASS_LINE} ({checked} inputs)")
+        return True, "\n".join(lines)
+    lines.append(f"{failed} of {checked} inputs failed.")
+    lines.append(FAIL_LINE)
+    return False, "\n".join(lines)
