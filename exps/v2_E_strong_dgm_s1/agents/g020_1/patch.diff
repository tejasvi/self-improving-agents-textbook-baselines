new file mode 100644
index 0000000..6ac35ff
--- /dev/null
+++ b/tools/table_diff.py
@@ -0,0 +1,103 @@
+import subprocess
+import os
+
+MAX_SHOW_CHARS = 300
+
+
+def tool_info():
+    return {
+        "name": "table_diff",
+        "description": """Compare a brute-force command with a candidate formula/algorithm over a list of parameter inputs, printing only a summary.\n
+* Each entry of `inputs` is fed to stdin of BOTH commands (one parameter tuple per entry, e.g. "3 5" or "12\\n4 7").\n
+* Outputs are compared token by token. Only the mismatch COUNT and the first `max_show` mismatching inputs are printed, so large tables never flood the context.\n
+* Use it to iterate on closed forms: write brute data to a file yourself if needed, and keep tool outputs short.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command of the slow, obviously-correct reference, reading one input from stdin, e.g. 'python3 brute.py'."
+                },
+                "candidate_cmd": {
+                    "type": "string",
+                    "description": "Shell command of the candidate formula/algorithm under test, reading one input from stdin, e.g. 'python3 solution.py'."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin inputs (one string per test parameter tuple). Use a grid of small parameters for the brute force."
+                },
+                "max_show": {
+                    "type": "integer",
+                    "description": "How many mismatching inputs to print in full. Default 5."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each single run. Default 5."
+                }
+            },
+            "required": ["brute_cmd", "candidate_cmd", "inputs"]
+        }
+    }
+
+
+def _cwd():
+    try:
+        from tools import bash as _bash
+        cwd = _bash._STATE.get('cwd')
+        if cwd and os.path.isdir(cwd):
+            return cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+def _run(cmd, data, cwd, timeout):
+    try:
+        p = subprocess.run(cmd, shell=True, cwd=cwd, input=data.encode(),
+                           capture_output=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return None, f"TIMEOUT(>{timeout}s)"
+    if p.returncode != 0:
+        return None, f"EXIT{p.returncode}: " + p.stderr.decode('utf-8', errors='replace')[-200:]
+    return p.stdout.decode('utf-8', errors='replace').split(), None
+
+
+def _short(s):
+    s = s.replace('\n', '\\n')
+    return s if len(s) <= MAX_SHOW_CHARS else s[:MAX_SHOW_CHARS] + '...'
+
+
+def tool_function(brute_cmd, candidate_cmd, inputs, max_show=5, timeout=5):
+    try:
+        if not isinstance(inputs, list) or not inputs:
+            return "Error: `inputs` must be a non-empty list of strings."
+        max_show = int(max_show) if max_show else 5
+        timeout = max(1, min(int(timeout) if timeout else 5, 60))
+        cwd = _cwd()
+        total = 0
+        mismatches = []
+        for inp in inputs:
+            total += 1
+            text = inp if inp.endswith('\n') else inp + '\n'
+            ref, ref_err = _run(brute_cmd, text, cwd, timeout)
+            if ref_err:
+                return f"Error: brute_cmd failed on input {_short(inp)}: {ref_err}"
+            cand, cand_err = _run(candidate_cmd, text, cwd, timeout)
+            if cand_err:
+                mismatches.append((inp, ref, None, cand_err))
+            elif cand != ref:
+                mismatches.append((inp, ref, cand, None))
+        if not mismatches:
+            return f"ALL MATCH ({total} inputs)"
+        lines = [f"{len(mismatches)} of {total} inputs MISMATCH. First {min(max_show, len(mismatches))}:"]
+        for inp, ref, cand, err in mismatches[:max_show]:
+            lines.append(f"input: {_short(inp)}")
+            lines.append(f"  brute:     {_short(' '.join(ref))}")
+            if err:
+                lines.append(f"  candidate: {err}")
+            else:
+                lines.append(f"  candidate: {_short(' '.join(cand))}")
+        return "\n".join(lines)
+    except Exception as e:
+        return f"Error: table_diff failed internally: {type(e).__name__}: {e}"
