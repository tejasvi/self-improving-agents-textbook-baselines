+_SAMPLE_HDR_RE = re.compile(
+    r'^[ \t#*>_-]*(?P<pre>(?:sample|example)\b[ \t]*)?(?P<kind>input|output)\b[ \t]*(?P<num>\d+)?'
+    r'[ \t*_]*(?P<colon>:)?[ \t*_]*(?P<rest>.*)$', re.I)
+_SAMPLE_EX_RE = re.compile(r'^[ \t#*>_-]*(?:sample|example)\b[ \t]*(?P<num>\d+)?[ \t*_:.-]*$', re.I)
+_SAMPLE_STOP_RE = re.compile(r'^[ \t#*>_-]*(?:##|constraints?\b|explanations?\b|notes?\b|sample\b|example\b)', re.I)
+
+def _parse_samples(text):
+    """
+    Parse 'Sample Input N' / 'Sample Output N' (also 'Input N', 'Example N' + 'Input:'/'Output:') blocks.
+    Returns {num: (input_text, output_text)} for every number that has both parts; blank lines
+    around each block are stripped. Blocks end at the next header, a Constraints/Explanation/Note/##
+    line, or (for outputs) the first blank line after content.
+    """
+    blocks = {}
+    cur = None            # (kind, num) while collecting block lines
+    ex_num = None         # number from the latest 'Example N' line
+    last_input = 0        # last input number seen (for unnumbered headers)
+    for raw in (text or '').splitlines():
+        line = raw.rstrip()
+        m = _SAMPLE_HDR_RE.match(line)
+        rest_txt = m.group('rest').strip() if m else ''
+        if m and (m.group('num') or m.group('pre') or m.group('colon') or
+                  (ex_num is not None and not rest_txt)) and (not rest_txt or m.group('colon') or m.group('num')):
+            kind = m.group('kind').lower()
+            if m.group('num'):
+                num = int(m.group('num'))
+            elif ex_num is not None:
+                num = ex_num
+            elif kind == 'input':
+                num = last_input + 1
+            else:
+                num = last_input or 1
+            if not m.group('num') and not m.group('pre') and ex_num is None and not m.group('colon'):
+                cur = None
+                continue
+            if kind == 'input':
+                last_input = num
+            blocks[num] = blocks.get(num, {'input': [], 'output': []})
+            blocks[num][kind] = []
+            cur = (kind, num)
+            rest = m.group('rest').strip()
+            if rest:
+                blocks[num][kind].append(rest)
+            continue
+        ex = _SAMPLE_EX_RE.match(line)
+        if ex:
+            ex_num = int(ex.group('num')) if ex.group('num') else (ex_num or 0) + 1
+            cur = None
+            continue
+        if cur is None:
+            continue
+        if _SAMPLE_STOP_RE.match(line):
+            cur = None
+            continue
+        kind, num = cur
+        if kind == 'output' and not line.strip() and any(s.strip() for s in blocks[num][kind]):
+            cur = None
+            continue
+        blocks[num][kind].append(line)
+    result = {}
+    for num, parts in blocks.items():
+        texts = []
+        for key in ('input', 'output'):
+            lines = parts[key]
+            while lines and not lines[0].strip():
+                lines = lines[1:]
+            while lines and not lines[-1].strip():
+                lines = lines[:-1]
+            texts.append('\n'.join(lines) + '\n' if lines else '')
+        if texts[0].strip() and texts[1].strip():
+            result[num] = (texts[0], texts[1])
+    return result
+
