+    def _extract_samples(self):
+        """
+        Parses self.problem_statement and writes sampleN.in / sampleN.out into git_tempdir.
+        Existing sample files are overwritten only for the numbers found in the statement.
+        Returns the number of samples written.
+        """
+        try:
+            found = _parse_samples(self.problem_statement)
+        except Exception as e:
+            safe_log(f"Sample extraction failed: {e}")
+            return 0
+        for num, (inp, out) in sorted(found.items()):
+            with open(os.path.join(self.git_tempdir, f"sample{num}.in"), 'w') as f:
+                f.write(inp)
+            with open(os.path.join(self.git_tempdir, f"sample{num}.out"), 'w') as f:
+                f.write(out)
+        safe_log(f"Extracted {len(found)} sample(s) from the problem statement.")
+        return len(found)
