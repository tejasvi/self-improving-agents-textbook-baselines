+    def _run_static_stdin(self):
+        """
+        For interactive statements: run solution.py on literal stdin files (no judge replies are sent).
+        Only the variant with extra data lines decides failure; the first-line-only variant is informational,
+        since a correct fallback to real interactive I/O cannot succeed without a judge.
+        Returns (failed, report).
+        """
+        variants = [
+            ("first line only", "3 1 5\n", False),
+            ("first line plus extra data lines", "3 1 5\n1 2 3\n", True),
+        ]
+        failed, parts = False, []
+        for label, inp, decisive in variants:
+            try:
+                p = subprocess.run(['python3', 'solution.py'], cwd=self.git_tempdir, input=inp,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                if decisive:
+                    failed = True
+                parts.append(f"Static stdin ({label}): TIMEOUT after {RUN_TIMEOUT_S}s on input:\n{inp}")
+                continue
+            crashed = p.returncode != 0 or 'Traceback' in (p.stderr or '')
+            if crashed and decisive:
+                failed = True
+            status = "CRASHED" if crashed else "ran without error"
+            parts.append(f"Static stdin ({label}): {status} (exit {p.returncode}).\n"
+                         f"input:\n{inp}stdout:\n{(p.stdout or '')[:REPORT_CLIP]}\n"
+                         f"stderr:\n{(p.stderr or '')[-REPORT_CLIP:]}")
+        header = ("Interactive statement: the harness runs solution.py on fixed stdin files, not a judge. "
+                  "Stress/oracle phase skipped.")
+        return failed, header + "\n" + "\n".join(parts)
+
