+import os
+import re
+import subprocess
+import shutil
+import tempfile
+
+DEFAULT_SCALES = [1, 2, 3, 5, 8]
+
+
+def tool_info():
+    return {
+        "name": "gen_coverage",
+        "description": """Summarize what a test generator actually produces, per scale, so you can check coverage.\n
+* For each scale it runs `<generator_cmd> <seed> <scale>` for several seeds and reports: input size in whitespace tokens (min / median / max), the number of distinct tokens (a rough proxy for distinct values), and, if a solver is given, the answer class per case.\n
+* Answer class: with `solution_cmd` plus `no_answer_token` (e.g. '-1') or `verdict_regex`, each case is counted as 'with answer' or 'no answer'. Without these, only input statistics are reported.\n
+* Use it to confirm that medium and large scales are really medium and large, and that both answer classes appear at every scale. A scale with 0% of one class needs planted cases of that class in the generator.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command invoked as '<generator_cmd> seed scale' that prints one test input to stdout, e.g. 'python3 gen.py'."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "List of integer scales to summarize. Default [1, 2, 3, 5, 8]."
+                },
+                "seeds_per_scale": {
+                    "type": "integer",
+                    "description": "Number of seeds (0 .. seeds_per_scale-1) to sample per scale. Default 30."
+                },
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Optional solver command reading stdin (e.g. 'python3 solution.py') used to get the answer class of each case."
+                },
+                "no_answer_token": {
+                    "type": "string",
+                    "description": "Optional sentinel printed for 'no answer', e.g. '-1'. Used with solution_cmd."
+                },
+                "verdict_regex": {
+                    "type": "string",
+                    "description": "Optional regular expression; if it matches the solver output the case is 'no answer'. Takes precedence over no_answer_token."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each single generator or solver run. Default 10."
+                }
+            },
+            "required": ["generator_cmd"]
+        }
+    }
+
+
+def _run(cmd, cwd, timeout, stdin_text=None, args=()):
+    full = cmd if not args else cmd + " " + " ".join(str(a) for a in args)
+    try:
+        p = subprocess.run(full, shell=True, cwd=cwd, input=(stdin_text or "").encode(),
+                           capture_output=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return None, f"timed out after {timeout} seconds"
+    except Exception as e:
+        return None, f"could not run: {e}"
+    if p.returncode != 0:
+        return None, f"exit code {p.returncode}: {p.stderr.decode('utf-8', 'replace')[-300:]}"
+    return p.stdout.decode('utf-8', errors='replace'), None
+
+
+def _cwd():
+    try:
+        from tools import bash as _bash
+        cwd = _bash._STATE.get('cwd')
+        if cwd and os.path.isdir(cwd):
+            return cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+def _median(xs):
+    ys = sorted(xs)
+    m = len(ys)
+    return ys[m // 2] if m % 2 else (ys[m // 2 - 1] + ys[m // 2]) / 2
+
+
+def tool_function(generator_cmd, scales=None, seeds_per_scale=30, solution_cmd=None,
+                  no_answer_token=None, verdict_regex=None, timeout=10):
+    if not generator_cmd:
+        return "Error: generator_cmd is required."
+    scales = [int(s) for s in (scales or DEFAULT_SCALES)]
+    try:
+        seeds_per_scale = max(1, min(int(seeds_per_scale or 30), 2000))
+    except Exception:
+        seeds_per_scale = 30
+    try:
+        timeout = max(1, min(int(timeout or 10), 300))
+    except Exception:
+        timeout = 10
+    cwd = _cwd()
+    classify = None
+    if verdict_regex:
+        pat = re.compile(verdict_regex)
+        classify = lambda out: 'no answer' if pat.search(out) else 'with answer'
+    elif no_answer_token:
+        tok = str(no_answer_token)
+        classify = lambda out: 'no answer' if out.split() == [tok] else 'with answer'
+
+    lines = [f"Generator coverage: generator={generator_cmd!r}, scales={scales}, seeds_per_scale={seeds_per_scale}"]
+    if solution_cmd and classify is None:
+        lines.append("Note: solution_cmd given without no_answer_token or verdict_regex; answer classes not reported.")
+    for scale in scales:
+        sizes, distinct, classes, errors = [], [], {}, []
+        for seed in range(seeds_per_scale):
+            out, err = _run(generator_cmd, cwd, timeout, args=[seed, scale])
+            if err is not None:
+                errors.append(f"seed {seed}: {err}")
+                continue
+            toks = out.split()
+            sizes.append(len(toks))
+            distinct.append(len(set(toks)))
+            if solution_cmd and classify is not None:
+                sol, serr = _run(solution_cmd, cwd, timeout, stdin_text=out)
+                if serr is not None:
+                    errors.append(f"solution on seed {seed}: {serr}")
+                    continue
+                c = classify(sol)
+                classes[c] = classes.get(c, 0) + 1
+        if not sizes:
+            lines.append(f"scale {scale}: no valid generated cases")
+        else:
+            lines.append(f"scale {scale}: tokens min={min(sizes)} median={_median(sizes)} max={max(sizes)}; "
+                         f"distinct tokens min={min(distinct)} median={_median(distinct)} max={max(distinct)} "
+                         f"(n={len(sizes)} cases)")
+            if classes:
+                total = sum(classes.values())
+                parts = ", ".join(f"{k}={v} ({100.0 * v / total:.0f}%)" for k, v in sorted(classes.items()))
+                lines.append(f"  answer classes: {parts}")
+                if len(classes) == 1:
+                    lines.append("  WARNING: only one answer class at this scale; add planted cases of the other class.")
+        for e in errors[:3]:
+            lines.append(f"  error: {e}")
+        if len(errors) > 3:
+            lines.append(f"  ... {len(errors) - 3} more errors")
+    return "\n".join(lines)
