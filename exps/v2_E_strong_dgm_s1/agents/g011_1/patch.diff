+def _schema_ok(node, path="root"):
+    # every object schema: 'type' present; 'required' only at object level and must list existing properties
+    if isinstance(node, dict):
+        if "type" in node and node["type"] == "object":
+            props = node.get("properties", {})
+            for r in node.get("required", []):
+                assert r in props, f"{path}: required {r} not in properties"
+            for k, v in props.items():
+                assert "type" in v and "description" in v, f"{path}.{k} lacks type/description"
+                _schema_ok(v, f"{path}.{k}")
+        assert "required" not in node or node.get("type") == "object", f"{path}: misplaced required"
+
+
+def test_stress_schema_valid():
+    from tools import stress_test, gen_coverage
+    _schema_ok(stress_test.tool_info()["input_schema"])
+    _schema_ok(gen_coverage.tool_info()["input_schema"])
+
+
+def test_stress_alt_disagreement_is_severe(tmp_path):
+    from tools import stress_test
+    import os
+    d = tmp_path
+    (d / "gen.py").write_text("import random,sys\nr=random.Random(int(sys.argv[1]))\n"
+                              "print(4, 10); print(*[r.randint(1,9) for _ in range(4)])\n")
+    # solution claims -1 always; alt is exact brute force over triples/pairs (checks 2-sums)
+    (d / "sol.py").write_text("print(-1)\n")
+    (d / "alt.py").write_text("import sys\nd=sys.stdin.read().split();n,x=int(d[0]),int(d[1]);a=list(map(int,d[2:2+n]))\n"
+                              "for i in range(n):\n for j in range(i+1,n):\n  if a[i]+a[j]==x: print(i+1,j+1); sys.exit()\nprint(-1)\n")
+    (d / "chk.py").write_text("import sys\nsys.exit(0)\n")  # weak checker accepts everything
+    out = stress_test.tool_function(f"python3 {d}/sol.py", f"python3 {d}/gen.py",
+                                    checker_cmd=f"python3 {d}/chk.py", alt_cmd=f"python3 {d}/alt.py",
+                                    no_answer_token="-1", scales=[1], seeds_per_scale=60, timeout=10)
+    # the weak checker accepts everything, so only the verdict-class comparison can catch the bug
+    assert "FIRST SEVERE VERDICT DISAGREEMENT (solution says none, alt says exists)" in out, out
+    assert "FAILED (verdict class disagreement)" in out
