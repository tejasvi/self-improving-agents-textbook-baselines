 # Placeholder solution file. The actual changes are applied to the coding agent repo in /dgm.
+# The requested harness changes live in /dgm/coding_agent.py (see its git diff).
+# ASSUMED CONTRACT (statement not available; edit if the real statement differs):
+#   stdin : "N L R", then N integers (the hidden array), tokens may be split across lines.
+#   stdout: "! S" where S = sum of array elements v with L <= v <= R.
+# Pure standard library. Single pass over the array, O(N) time, O(1) extra memory.
+import sys
+
+
+def solve(data):
+    n, lo, hi = int(data[0]), int(data[1]), int(data[2])
+    total = 0
+    for x in data[3:3 + n]:
+        v = int(x)
+        if lo <= v <= hi:
+            total += v
+    return total
+
+
+def main():
+    data = sys.stdin.read().split()
+    print(f"! {solve(data)}")
+
+
+if __name__ == "__main__":
+    main()
