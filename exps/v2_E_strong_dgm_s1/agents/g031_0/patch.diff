+def _non_stdlib_imports(code, local_dir=None):
+    """Top-level module names imported by code that are neither stdlib nor local .py files/packages in local_dir.
+    Returns [] when the code does not parse or when sys.stdlib_module_names is unavailable (Python < 3.10)."""
+    stdlib = set(getattr(sys, 'stdlib_module_names', ())) | STDLIB_EXTRA
+    if not stdlib:
+        return []
+    try:
+        tree = ast.parse(code or '')
+    except (SyntaxError, ValueError):
+        return []
+    local = {'solution'}
+    if local_dir and os.path.isdir(local_dir):
+        for fn in os.listdir(local_dir):
+            if fn.endswith('.py'):
+                local.add(fn[:-3])
+            elif os.path.isdir(os.path.join(local_dir, fn)):
+                local.add(fn)
+    found = []
+    for node in ast.walk(tree):
+        names = []
+        if isinstance(node, ast.Import):
+            names = [a.name for a in node.names]
+        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+            names = [node.module]
+        for name in names:
+            root = name.split('.')[0]
+            if root and root not in stdlib and root not in local and root not in found:
+                found.append(root)
+    return found
+
