+                continue
+            text = self._msg_text(msg.get('content', ''))
+            if text.strip() and msg.get('role') in ('assistant', 'user'):
+                items.append(text.strip())
+        notes = "\n---\n".join(item[-NOTES_CLIP:] for item in items[-NOTES_ITEMS:])
+        self._last_notes = notes[-NOTES_CLIP:] if notes else "(no earlier notes)"
