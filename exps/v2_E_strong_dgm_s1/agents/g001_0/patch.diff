+    def _has_primary_edit(self):
+        """
+        Return True only if solution.py exists, differs from the base commit,
+        has more than comments/whitespace, and compiles with py_compile.
+        Edits touching only other files (tests, brute.py, ...) do not count.
+        """
+        primary = 'solution.py'
+        path = os.path.join(self.git_tempdir, primary)
+        if not os.path.isfile(path):
+            return False
+        try:
+            with open(path, 'r', errors='replace') as f:
+                current = f.read()
+        except OSError:
+            return False
+
+        # Only count if the diff against the base commit touches solution.py
+        try:
+            diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        except Exception:
+            return False
+        changed = set()
+        for line in diff.splitlines():
+            if line.startswith('diff --git a/'):
+                parts = line.split(' b/', 1)
+                if len(parts) == 2:
+                    changed.add(parts[1].strip())
+        if primary not in changed:
+            return False
+
+        # Must differ from base content
+        base_result = subprocess.run(
+            ['git', '-C', self.git_tempdir, 'show', f'{self.base_commit}:{primary}'],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        base_content = base_result.stdout.decode(errors='replace') if base_result.returncode == 0 else None
+        if base_content is not None and base_content == current:
+            return False
+
+        # Must contain more than comments or whitespace
+        meaningful = [
+            ln for ln in current.splitlines()
+            if ln.strip() and not ln.strip().startswith('#')
+        ]
+        if not meaningful:
+            return False
+
+        # Must compile
+        compile_result = subprocess.run(
+            ['python3', '-m', 'py_compile', path],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        return compile_result.returncode == 0
+
