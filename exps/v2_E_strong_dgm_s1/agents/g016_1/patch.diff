+    def _extract_samples(self):
+        """
+        Parse (input, expected_output) pairs from self.problem_statement.
+        Primary format: 'Sample Input N' / 'Sample Output N'. Fallbacks: 'Input:' / 'Output:'
+        and 'Example N' blocks. Returns a list of (input, expected) tuples.
+        """
+        text = self.problem_statement or ''
+        samples = []
+        pattern = re.compile(
+            r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n\s*Sample Output|\n##|\Z)',
+            re.S,
+        )
+        for m in pattern.finditer(text):
+            samples.append((m.group(2).strip('\n') + '\n', m.group(3).strip()))
+        if samples:
+            return samples
+        # Fallback 1: 'Input:' / 'Output:' pairs (optionally numbered or in 'Example' blocks)
+        pattern2 = re.compile(
+            r'(?:^|\n)\s*Input:?\s*\n?(.*?)\n\s*Output:?\s*\n?(.*?)(?=\n\s*(?:Input:|Example|Explanation|Sample)|\n##|\Z)',
+            re.S | re.I,
+        )
+        for m in pattern2.finditer(text):
+            inp = m.group(1).strip('\n')
+            out = m.group(2).strip()
+            if inp.strip() and out:
+                samples.append((inp + '\n', out))
+        return samples
+
+    def _run_samples(self):
+        """
+        Run `python3 solution.py` on every sample input and compare whitespace-tokenized
+        stdout with the expected output. Returns a list of failure report strings.
+        """
+        failures = []
+        samples = self._extract_samples()
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+        if not samples:
+            return failures
+        if not os.path.isfile(sol_path):
+            for i, (inp, exp) in enumerate(samples, 1):
+                failures.append(f"Sample {i}: solution.py does not exist.\nInput:\n{inp}\nExpected:\n{exp}\n")
+            return failures
+        for i, (inp, exp) in enumerate(samples, 1):
+            try:
+                proc = subprocess.run(
+                    ['python3', 'solution.py'], input=inp, capture_output=True, text=True,
+                    timeout=10, cwd=self.git_tempdir,
+                )
+            except subprocess.TimeoutExpired:
+                failures.append(f"Sample {i}: TIMEOUT (>10s).\nInput:\n{inp}\nExpected:\n{exp}\n")
+                continue
+            except OSError as e:
+                failures.append(f"Sample {i}: could not run solution.py: {e}\nInput:\n{inp}\nExpected:\n{exp}\n")
+                continue
+            actual = proc.stdout
+            if actual.split() != exp.split():
+                stderr_tail = '\n'.join(proc.stderr.strip().splitlines()[-15:])
+                failures.append(
+                    f"Sample {i}: WRONG OUTPUT.\nInput:\n{inp}\nExpected:\n{exp}\n"
+                    f"Actual:\n{actual}\nStderr tail:\n{stderr_tail}\n"
+                )
+        return failures
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the last assistant message in msg_history ('' if none)."""
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content.strip()
+            parts = []
+            if isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict) and block.get('type') == 'text':
+                        parts.append(block.get('text', ''))
+                    elif isinstance(block, str):
+                        parts.append(block)
+            return '\n'.join(parts).strip()
+        return ''
