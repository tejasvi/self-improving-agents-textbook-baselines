+# Usage: python3 gen.py SEED SCALE
+# Prints one valid input: an integer n followed by n lines, each one integer.
+import random
+import sys
+
+
+def main():
+    seed = int(sys.argv[1])
+    scale = int(sys.argv[2])
+    rng = random.Random(seed)
+    if scale <= 3:
+        n = rng.randint(1, 5)
+        hi = rng.choice([3, 10])
+    else:
+        n = rng.randint(50, 300)
+        hi = rng.choice([10, 1000, 10**9])
+    mode = rng.randrange(4)
+    lines = [str(n)]
+    for i in range(n):
+        if mode == 0:
+            v = rng.randint(-hi, hi)
+        elif mode == 1:
+            v = rng.choice([0, 1, -1, hi, -hi])  # edge values
+        elif mode == 2:
+            v = rng.randint(0, 3)                # duplicate-heavy
+        else:
+            v = i
+        lines.append(str(v))
+    sys.stdout.write("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
