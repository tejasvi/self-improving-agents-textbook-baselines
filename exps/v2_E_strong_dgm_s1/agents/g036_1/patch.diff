index 0000000..2823f2c
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,220 @@
+import importlib.util
+import os
+import queue
+import subprocess
+import tempfile
+import threading
+
+MAX_SHOW = 1500  # max characters shown for a transcript
+MAX_LINES = 100000  # hard cap on solution output lines per game
+
+
+def tool_info():
+    return {
+        "name": "interactive_judge",
+        "description": """Test an INTERACTIVE solution against a judge written in Python.\n
+* `judge_script` is a path to a Python file defining `class Judge` with: `__init__(self, seed, scale)`, `initial_input() -> str` (text written to the solution's stdin first), `answer(query_line) -> str` (reply to one query line the solution printed; return '-1' for an invalid query), `check_final(line) -> bool` (called with the solution's final line starting with '!'; True means correct), and optional `query_limit(self) -> int` (max number of queries allowed).\n
+* `solution_cmd` is run as a subprocess; the judge's replies are written to its stdin, one reply per query line (the solution's stdout lines are the queries).\n
+* Runs every seed in range(seeds_per_scale) for every scale in `scales`. Each line read from the solution has a `timeout` (seconds); a solution that stops responding, exits early, prints an invalid query, or exceeds the query limit fails that run.\n
+* Returns a per-scale summary (passed / failed / max queries used vs limit) and the first failing transcript (clipped).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the interactive solution reading stdin and writing stdout, e.g. 'python3 solution.py'."
+                },
+                "judge_script": {
+                    "type": "string",
+                    "description": "Path to a Python file defining class Judge with __init__(self, seed, scale), initial_input() -> str, answer(query_line) -> str, check_final(line) -> bool, and optional query_limit() -> int."
+                },
+                "seeds_per_scale": {
+                    "type": "integer",
+                    "description": "Number of seeds (0 .. seeds_per_scale-1) to run for each scale. Default 20."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "List of integer scales passed to Judge(seed, scale). Default [1, 2, 3, 5, 8]."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each line the solution must produce. Default 5."
+                }
+            },
+            "required": ["solution_cmd", "judge_script"]
+        }
+    }
+
+
+def _load_judge_class(path):
+    spec = importlib.util.spec_from_file_location("judge_module_under_test", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load judge script {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    if not hasattr(module, "Judge"):
+        raise AttributeError("judge script does not define class Judge")
+    return module.Judge
+
+
+def _clip(text, limit=MAX_SHOW):
+    if len(text) <= limit:
+        return text
+    return text[:limit // 2] + f"\n... [{len(text) - limit} chars clipped] ...\n" + text[-limit // 2:]
+
+
+def _reader(stream, q):
+    """Push each line from the solution's stdout into q; push None at EOF."""
+    try:
+        for line in iter(stream.readline, ""):
+            q.put(line)
+    except (OSError, ValueError):
+        pass
+    q.put(None)
+
+
+def _run_one(solution_cmd, judge, timeout, cwd):
+    """Run one interactive game. Returns (ok, reason, transcript, queries)."""
+    transcript = []
+    queries = 0
+    limit = None
+    if hasattr(judge, "query_limit"):
+        try:
+            limit = int(judge.query_limit())
+        except Exception:
+            limit = None
+
+    err_file = tempfile.TemporaryFile(mode="w+")
+    proc = subprocess.Popen(solution_cmd, shell=True, cwd=cwd, stdin=subprocess.PIPE,
+                            stdout=subprocess.PIPE, stderr=err_file, text=True, bufsize=1)
+    q = queue.Queue()
+    t = threading.Thread(target=_reader, args=(proc.stdout, q), daemon=True)
+    t.start()
+
+    def finish(ok, reason):
+        try:
+            if proc.poll() is None:
+                proc.kill()
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+        err_file.seek(0)
+        err = err_file.read()
+        err_file.close()
+        if err.strip():
+            transcript.append(f"<stderr> {err.strip()[-800:]}")
+        return ok, reason, transcript, queries
+
+    try:
+        init = judge.initial_input()
+        if init:
+            transcript.append(f"> {init.rstrip()}")
+            proc.stdin.write(init if init.endswith("\n") else init + "\n")
+            proc.stdin.flush()
+    except (BrokenPipeError, OSError) as e:
+        return finish(False, f"could not write initial input ({type(e).__name__})")
+
+    for _ in range(MAX_LINES):
+        try:
+            line = q.get(timeout=timeout)
+        except queue.Empty:
+            return finish(False, f"no output line within {timeout}s (solution waits or loops)")
+        if line is None:
+            return finish(False, "solution ended (EOF on stdout) before answering with '!'")
+        s = line.strip()
+        transcript.append(f"< {s}")
+        if s == "":
+            continue
+        if s.startswith("!"):
+            try:
+                good = bool(judge.check_final(s))
+            except Exception as e:
+                return finish(False, f"check_final raised {type(e).__name__}: {e}")
+            if not good:
+                return finish(False, f"wrong final answer {s!r}")
+            return finish(True, "correct")
+        queries += 1
+        if limit is not None and queries > limit:
+            return finish(False, f"query limit exceeded: {queries} > {limit}")
+        try:
+            reply = str(judge.answer(s))
+        except Exception as e:
+            return finish(False, f"answer() raised {type(e).__name__}: {e}")
+        if reply.strip() == "-1":
+            return finish(False, f"invalid query {s!r} (judge replied -1)")
+        transcript.append(f"> {reply.rstrip()}")
+        try:
+            proc.stdin.write(reply.rstrip("\n") + "\n")
+            proc.stdin.flush()
+        except (BrokenPipeError, OSError):
+            return finish(False, "solution closed stdin before the game ended")
+    return finish(False, f"too many output lines (> {MAX_LINES}) without a final answer")
+
+
+def tool_function(solution_cmd, judge_script, seeds_per_scale=20, scales=None, timeout=5):
+    try:
+        seeds_per_scale = int(seeds_per_scale) if seeds_per_scale is not None else 20
+        timeout = int(timeout) if timeout is not None else 5
+        scales = list(scales) if scales else [1, 2, 3, 5, 8]
+        cwd = os.getcwd()
+        judge_path = judge_script if os.path.isabs(judge_script) else os.path.join(cwd, judge_script)
+        if not os.path.exists(judge_path):
+            return f"Error: judge script not found: {judge_path}"
+        try:
+            JudgeCls = _load_judge_class(judge_path)
+        except Exception as e:
+            return f"Error: failed to load judge script: {type(e).__name__}: {e}"
+
+        lines = []
+        first_fail = None
+        total_pass = total_run = 0
+        max_q_all = 0
+        limit_seen = None
+        for scale in scales:
+            passed = failed = 0
+            max_q = 0
+            for seed in range(seeds_per_scale):
+                try:
+                    judge = JudgeCls(seed, scale)
+                except Exception as e:
+                    return f"Error: Judge(seed={seed}, scale={scale}) raised {type(e).__name__}: {e}"
+                if limit_seen is None and hasattr(judge, "query_limit"):
+                    try:
+                        limit_seen = int(judge.query_limit())
+                    except Exception:
+                        limit_seen = None
+                try:
+                    ok, reason, transcript, queries = _run_one(solution_cmd, judge, timeout, cwd)
+                except Exception as e:
+                    ok, reason, transcript, queries = False, f"harness error {type(e).__name__}: {e}", [], 0
+                max_q = max(max_q, queries)
+                if ok:
+                    passed += 1
+                else:
+                    failed += 1
+                    if first_fail is None:
+                        first_fail = {"scale": scale, "seed": seed, "reason": reason,
+                                      "transcript": transcript, "queries": queries}
+            total_pass += passed
+            total_run += passed + failed
+            max_q_all = max(max_q_all, max_q)
+            lines.append(f"scale={scale}: passed {passed}/{passed + failed}, max queries used {max_q}")
+
+        lines.insert(0, f"Interactive judge: {total_pass}/{total_run} games passed"
+                        + (f"; query limit {limit_seen}" if limit_seen is not None else "")
+                        + f"; max queries used {max_q_all}")
+        if limit_seen is not None and max_q_all > limit_seen:
+            lines.append(f"WARNING: some games exceeded the query limit ({max_q_all} > {limit_seen})")
+        if first_fail is None:
+            lines.append("ALL PASSED")
+        else:
+            ff = first_fail
+            lines.append(f"FAILED at scale={ff['scale']} seed={ff['seed']}: {ff['reason']} "
+                         f"(queries={ff['queries']}"
+                         + (f", limit={limit_seen})" if limit_seen is not None else ")"))
+            lines.append("--- transcript (> judge reply, < solution line) ---\n"
+                         + _clip("\n".join(ff["transcript"])))
+        return "\n".join(lines)
+    except Exception as e:
+        return f"Error: interactive_judge failed internally: {type(e).__name__}: {e}"
