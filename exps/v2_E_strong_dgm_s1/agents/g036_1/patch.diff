@@ -0,0 +1,22 @@
+# Brute-force oracle for solution.py: counts whitespace-separated tokens on stdin
+# by scanning character by character (independent of str.split()).
+import sys
+
+
+def main():
+    data = sys.stdin.read()
+    count = 0
+    in_tok = False
+    for ch in data:
+        if ch.isspace():
+            in_tok = False
+        elif not in_tok:
+            in_tok = True
+            count += 1
+    if count == 0:
+        return
+    print(count)
+
+
+if __name__ == "__main__":
+    main()
