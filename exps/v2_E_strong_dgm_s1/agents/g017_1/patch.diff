+            f"Previous edit diff (may be empty):\n<prev_diff>\n{prev_diff}\n</prev_diff>\n\n"
+            f"Fix {self.git_tempdir}/solution.py using the editor tool so that it matches the expected outputs on "
+            "these inputs. Reason from the failing input and the expected output. Re-run the failing input after editing. "
+            "Do not reply without a tool call."
+        )
+
+    def _alt_prompt(self, approach_hint):
+        return self._task_header() + (
