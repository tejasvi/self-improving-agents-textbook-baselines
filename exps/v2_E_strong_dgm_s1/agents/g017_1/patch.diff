+            f"{self.git_tempdir}/solution.py (a Python program reading stdin, writing stdout, or the requested "
+            "method if the statement asks for a class). Do not analyze at length first. Do not reply without a tool call."
+        )
+
+    def _oracle_prompt(self):
+        return self._task_header() + (
