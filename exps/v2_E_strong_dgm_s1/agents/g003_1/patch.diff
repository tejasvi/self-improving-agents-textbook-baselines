+HELPER_PREFIXES = ('test_', 'brute', 'gen', 'checker', 'sample')
+HELPER_MARKERS = ('_test.', '.test.')
+PRIMARY_NAME = 'solution.py'
+
+def _is_helper_file(name):
+    base = os.path.basename(name).lower()
+    return base.startswith(HELPER_PREFIXES) or any(m in base for m in HELPER_MARKERS)
+
+def _split_patch_blocks(patch_str):
+    """Split a git diff into {filename: block_text}, keyed by the b/ path."""
+    blocks = {}
+    current = None
+    for line in patch_str.splitlines():
+        if line.startswith("diff --git"):
+            m = re.match(r"diff --git a/(.*) b/(.*)$", line)
+            current = m.group(2) if m else line
+            blocks[current] = [line]
+        elif current is not None:
+            blocks[current].append(line)
+    return {k: "\n".join(v) for k, v in blocks.items()}
+
+def _has_code_lines(lines):
+    for line in lines:
+        s = line.strip()
+        if s and not s.startswith('#'):
+            return True
+    return False
+
+def _is_degenerate_history(msg_history):
+    """True when every assistant reply is empty or '(no output)'."""
+    texts = []
+    for msg in msg_history or []:
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            texts.append(content)
+        elif isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    texts.append(block.get('text', ''))
+    return all((not t.strip()) or t.strip() == '(no output)' for t in texts)
