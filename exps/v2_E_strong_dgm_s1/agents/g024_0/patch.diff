+    def _run_checker(self, input_text, output_text):
+        """
+        Run checker.py INPUT_FILE OUTPUT_FILE on temp files. Returns (accepted, reason).
+        Crashes, timeouts and missing files are rejections with a reason.
+        """
+        checker = os.path.join(self.git_tempdir, 'checker.py')
+        if not os.path.isfile(checker):
+            return False, "checker.py missing."
+        tmp = tempfile.mkdtemp(prefix='checker_')
+        try:
+            in_path = os.path.join(tmp, 'input.txt')
+            out_path = os.path.join(tmp, 'output.txt')
+            with open(in_path, 'w') as f:
+                f.write(input_text)
+            with open(out_path, 'w') as f:
+                f.write(output_text)
+            try:
+                p = subprocess.run(['python3', checker, in_path, out_path], cwd=self.git_tempdir,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                return False, f"checker.py timed out (limit {RUN_TIMEOUT_S}s)."
+            msg = (p.stdout or '').strip() or (p.stderr or '').strip()[-REPORT_CLIP:]
+            if p.returncode == 0:
+                return True, msg or "OK"
+            return False, (msg[-REPORT_CLIP:] if msg else f"checker.py exit code {p.returncode}")
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+    def _judge(self, input_text, output_text, expected_text=None):
+        """
+        Return (ok, reason). If checker.py is trusted, the checker decides validity. Otherwise (or when no
+        checker is trusted) the output must equal expected_text token-by-token.
+        """
+        if getattr(self, '_checker_trusted', False):
+            return self._run_checker(input_text, output_text)
+        if expected_text is None:
+            return False, "no checker is trusted and no expected output is available."
+        if output_text.split() == expected_text.split():
+            return True, "matches expected output."
+        return False, "output differs from expected output (no trusted checker)."
+
+    def _check_checker(self):
+        """
+        Verify checker.py: it must accept every sample's expected output, accept brute.py's output on
+        gen.py seeds 1..CHECKER_CHECK_SEEDS, and reject a corrupted output. Returns (ok, report).
+        """
+        for name in ('checker.py', 'brute.py', 'gen.py'):
+            if not os.path.isfile(os.path.join(self.git_tempdir, name)):
+                return False, f"Checker check: {name} missing."
+        problems = []
+        if not self._is_class_task():
+            for idx, inp, exp in self._parse_samples():
+                ok, reason = self._run_checker(inp, exp)
+                if not ok:
+                    problems.append(f"sample {idx}: checker rejected the expected output: {reason}")
+                    break
+        checked, rejected_corrupt = 0, False
+        for seed in range(1, CHECKER_CHECK_SEEDS + 1):
+            try:
+                g = subprocess.run(['python3', 'gen.py', str(seed)], cwd=self.git_tempdir,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+                if g.returncode != 0:
+                    problems.append(f"gen.py failed on seed {seed} during checker check.")
+                    break
+                inp = g.stdout
+                b = subprocess.run(['python3', 'brute.py'], cwd=self.git_tempdir, input=inp,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                problems.append(f"gen.py or brute.py timed out on seed {seed} during checker check.")
+                break
+            if b.returncode != 0 or not b.stdout.strip():
+                continue  # brute failures are reported by _check_brute, not by the checker
+            ok, reason = self._run_checker(inp, b.stdout)
+            checked += 1
+            if not ok:
+                problems.append(f"seed {seed}: checker rejected brute.py's valid output: {reason}\n"
+                                f"input:\n{inp[:REPORT_CLIP]}\nbrute output:\n{b.stdout[:REPORT_CLIP]}")
+                break
+            if not rejected_corrupt:
+                bad = self._corrupt(b.stdout)
+                bad_ok, _ = self._run_checker(inp, bad)
+                if bad_ok:
+                    problems.append(f"seed {seed}: checker ACCEPTED a corrupted output:\n{bad[:REPORT_CLIP]}")
+                    break
+                rejected_corrupt = True
+        if not problems and not rejected_corrupt:
+            problems.append("Checker check: could not produce a corrupted output to test (no brute output).")
+        if problems:
+            return False, "Checker check FAILED:\n" + "\n".join(problems)
+        return True, f"Checker check passed: accepts samples and {checked} brute outputs, rejects corruption."
+
+    @staticmethod
+    def _corrupt(output_text):
+        """Deliberately wrong output: append a huge token, or flip a lone -1 / a number to -1."""
+        toks = output_text.split()
+        if toks and toks[0] != '-1':
+            return output_text.rstrip('\n') + '\n999999999\n'
+        return output_text.rstrip('\n') + ' 999999999\n'
