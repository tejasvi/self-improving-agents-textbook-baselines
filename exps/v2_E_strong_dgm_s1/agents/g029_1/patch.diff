+import os
+import subprocess
+import signal
+
+MAX_STDOUT_HEAD = 400
+MAX_STDERR_TAIL = 600
+
+
+def tool_info():
+    return {
+        "name": "io_modes_test",
+        "description": """Run solution.py under several stdin modes to check I/O robustness (grader-compatibility).\n
+* Modes: (a) the input exactly as given; (b) the input plus extra trailing lines (an extra line of space-separated integers and a final integer); (c) the input truncated after its first line, so further reads hit EOF; (d) the first line followed by lines of '0'.\n
+* For each mode it returns the exit code, the head of stdout and the tail of stderr, raw and unparsed. Runs with a non-zero exit code or a traceback are explicitly flagged.\n
+* Use it for any interactive or non-standard-format task before finishing, and fix any traceback it reveals.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin, e.g. 'python3 solution.py'."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "The base input text (the first line is used as the header for the truncated mode)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each run. Optional; default 5."
+                }
+            },
+            "required": ["solution_cmd", "input_text"]
+        }
+    }
+
+
+def _cwd():
+    try:
+        from tools import bash as _bash
+        cwd = _bash._STATE.get('cwd')
+        if cwd and os.path.isdir(cwd):
+            return cwd
+    except Exception:
+        pass
+    return os.getcwd()
+
+
+def _run(solution_cmd, stdin_text, cwd, timeout):
+    """Returns (exit_code or 'TIMEOUT', stdout, stderr)."""
+    proc = subprocess.Popen(
+        solution_cmd, shell=True, stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        cwd=cwd, start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(stdin_text.encode('utf-8'), timeout=timeout)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        proc.communicate()
+        return 'TIMEOUT', '', ''
+    return proc.returncode, out.decode('utf-8', errors='replace'), err.decode('utf-8', errors='replace')
+
+
+def _modes(input_text):
+    text = input_text if input_text.endswith('\n') else input_text + '\n'
+    lines = text.split('\n')
+    first = lines[0] if lines else ''
+    n_tokens = len(first.split())
+    # (b) extra trailing lines: a line of integers and a final integer
+    extra = text + "1 2 3\n0\n"
+    # (c) truncated after the first line
+    truncated = first + '\n'
+    # (d) first line followed by zeros (the number of further lines is the input's line count)
+    body_lines = max(1, len(lines) - 1)
+    zeros = first + '\n' + '\n'.join(['0'] * (body_lines * max(1, n_tokens))) + '\n'
+    return [
+        ("(a) input as given", text),
+        ("(b) input plus extra trailing lines", extra),
+        ("(c) input truncated after first line (EOF)", truncated),
+        ("(d) first line then all replies '0'", zeros),
+    ]
+
+
+def tool_function(solution_cmd, input_text, timeout=5):
+    if not solution_cmd:
+        return "Error: solution_cmd is required."
+    if input_text is None:
+        return "Error: input_text is required."
+    try:
+        timeout = int(timeout) if timeout is not None else 5
+    except (TypeError, ValueError):
+        timeout = 5
+    timeout = max(1, min(timeout, 300))
+    cwd = _cwd()
+    report = []
+    flagged = 0
+    for label, text in _modes(input_text):
+        code, out, err = _run(solution_cmd, text, cwd, timeout)
+        crashed = code == 'TIMEOUT' or code != 0 or 'Traceback' in err
+        if crashed:
+            flagged += 1
+        flag = " <-- FAILED (non-zero exit, timeout or traceback)" if crashed else ""
+        out_head = out[:MAX_STDOUT_HEAD] if out else '(empty)'
+        err_tail = err.strip()[-MAX_STDERR_TAIL:] if err.strip() else '(no stderr)'
+        report.append(f"== {label}: exit={code}{flag}")
+        report.append(f"stdout head: {out_head}")
+        report.append(f"stderr tail: {err_tail}")
+    report.append(f"Summary: {flagged} of 4 modes failed.")
+    return "\n".join(report)
