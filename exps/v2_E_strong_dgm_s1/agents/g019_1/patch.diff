+def simple_completion(msg, model=CLAUDE_MODEL, logging=print, max_retry=2):
+    """
+    Tool-free single-turn completion. Returns the reply text, or '' on failure.
+    Used for bootstrapping a solution without relying on tool calls.
+    """
+    try:
+        client, client_model = create_client(model)
+    except Exception as e:
+        logging(f"simple_completion: could not create client: {e}")
+        return ''
+    for attempt in range(max_retry + 1):
+        try:
+            if 'claude' in client_model:
+                response = client.messages.create(
+                    model=client_model,
+                    max_tokens=16000,
+                    messages=[{"role": "user", "content": [{"type": "text", "text": msg}]}],
+                )
+                text = ''.join((getattr(b, 'text', '') or '') for b in response.content
+                               if getattr(b, 'type', None) == 'text')
+            elif client_model.startswith('o3-'):
+                response = client.responses.create(
+                    model=client_model,
+                    input=[{"role": "user", "content": msg}],
+                )
+                text = getattr(response, 'output_text', '') or ''
+            else:
+                raise ValueError(f"Unsupported model: {client_model}")
+            return text
+        except Exception as e:
+            logging(f"simple_completion: attempt {attempt + 1} failed: {e}")
+    return ''
+
