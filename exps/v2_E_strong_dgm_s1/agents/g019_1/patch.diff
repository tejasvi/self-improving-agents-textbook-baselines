+    def _score_candidate(self, candidate_path, n_stress=100):
+        """
+        Score a candidate solution file. Score = (samples passed, stress seeds agreeing with brute.py).
+        Returns (score_tuple, feedback) where feedback describes the first failure (or '').
+        """
+        sample_ins = sorted(glob.glob(os.path.join(self.git_tempdir, 'sample*.in')))
+        samples = [(p, p[:-3] + '.out') for p in sample_ins if os.path.isfile(p[:-3] + '.out')]
+        sample_pass = 0
+        feedback = ''
+        for in_path, out_path in samples:
+            with open(in_path) as f:
+                inp = f.read()
+            with open(out_path) as f:
+                expected = f.read()
+            ok, got = self._run_program(['python3', candidate_path], inp)
+            if ok and got.split() == expected.split():
+                sample_pass += 1
+            elif not feedback:
