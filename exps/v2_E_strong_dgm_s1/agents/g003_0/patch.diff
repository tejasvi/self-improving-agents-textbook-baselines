@@ -0,0 +1,20 @@
+# ASSUMED CONTRACT (statement not available; edit if the real statement differs):
+#   stdin : "N L R", then N integers (the hidden array), tokens may be split across lines.
+#   stdout: "! S" where S = sum of array elements v with L <= v <= R.
+# Brute force: a single linear scan, no optimisation.
+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    n, lo, hi = int(data[0]), int(data[1]), int(data[2])
+    arr = [int(x) for x in data[3:3 + n]]
+    total = 0
+    for v in arr:
+        if lo <= v <= hi:
+            total += v
+    print(f"! {total}")
+
+
+if __name__ == "__main__":
+    main()
