+# Max-size valid inputs (ASSUMED contract, see brute.py). Constraints are guesses:
+# N = 2*10^5, values in [1, 10^9]. Adjust MAXN / MAXV to the real limits.
+# Usage: python3 gen_big.py SEED ; shape = seed % 4.
+import random
+import sys
+
+MAXN = 200000
+MAXV = 10**9
+
+
+def main():
+    seed = int(sys.argv[1])
+    rng = random.Random(seed)
+    n = MAXN
+    shape = seed % 4
+    if shape == 0:
+        v = rng.randint(1, MAXV)
+        arr = [v] * n
+    elif shape == 1:
+        arr = [rng.randint(1, MAXV) for _ in range(n)]
+    elif shape == 2:
+        arr = sorted(rng.randint(1, MAXV) for _ in range(n))
+        if rng.random() < 0.5:
+            arr.reverse()
+    else:
+        pool = [rng.randint(1, MAXV) for _ in range(50)]
+        arr = [rng.choice(pool) for _ in range(n)]
+    lo = rng.randint(1, MAXV // 2)
+    hi = rng.randint(lo, MAXV)
+    print(n, lo, hi)
+    print(*arr)
+
+
+if __name__ == "__main__":
+    main()
