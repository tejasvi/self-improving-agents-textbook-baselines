@@ -0,0 +1,57 @@
+import os
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_io_variants",
+        "description": """Run a stdin/stdout Python program on one input under several whitespace/layout variants and report crashes or differing outputs.
+Variants: 'original' (input as given), 'one_line' (all tokens joined on one line), 'one_token_per_line' (each token on its own line), 'trailing_ws' (extra spaces and blank lines appended), 'no_final_newline' (final newline removed).
+Use it to check that a solution does not depend on how the tokens are laid out (e.g. tokens split across lines or extra tokens in the stream), and to see whether a program crashes when all input is pre-supplied on stdin.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {"type": "string", "description": "Path to the Python program (relative to the working directory or absolute)."},
+                "input_text": {"type": "string", "description": "The raw stdin text to feed to the program."},
+                "timeout_s": {"type": "integer", "description": "Timeout in seconds per variant (default 10)."},
+            },
+            "required": ["program_path", "input_text"],
+        },
+    }
+
+
+def _variants(text):
+    toks = text.split()
+    return {
+        "original": text,
+        "one_line": " ".join(toks) + "\n",
+        "one_token_per_line": "\n".join(toks) + "\n",
+        "trailing_ws": text.rstrip("\n") + "   \n\n  \t\n",
+        "no_final_newline": text.rstrip("\n"),
+    }
+
+
+def tool_function(program_path, input_text, timeout_s=10):
+    if not os.path.isfile(program_path):
+        return f"Error: program not found: {program_path}"
+    try:
+        timeout_s = int(timeout_s)
+    except (TypeError, ValueError):
+        timeout_s = 10
+    results = {}
+    for name, variant in _variants(input_text or "").items():
+        try:
+            p = subprocess.run(["python3", program_path], input=variant, capture_output=True,
+                               text=True, timeout=timeout_s)
+            results[name] = (p.returncode, p.stdout, p.stderr)
+        except subprocess.TimeoutExpired:
+            results[name] = (None, "", f"TIMEOUT after {timeout_s}s")
+    base = results["original"][1].split()
+    lines = []
+    for name, (rc, out, err) in results.items():
+        status = "OK" if rc == 0 else f"CRASH/TIMEOUT (exit {rc})"
+        diff = "" if out.split() == base else "  OUTPUT DIFFERS from original"
+        lines.append(f"[{name}] {status}{diff}\n  stdout: {out.strip()[:300]!r}")
+        if rc != 0 and err:
+            lines.append(f"  stderr: {err.strip()[-500:]}")
+    return "\n".join(lines)
