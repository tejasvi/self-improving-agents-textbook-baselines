@@ -0,0 +1,26 @@
+import sys
+
+
+def solve(tokens):
+    """tokens: all whitespace-separated tokens of stdin.
+    Contract: N L R, then N array values; answer '! S' with S = sum of v with L <= v <= R.
+    Extra tokens (recorded judge replies, trailing data) are ignored."""
+    if len(tokens) < 3:
+        return 0
+    n, lo, hi = int(tokens[0]), int(tokens[1]), int(tokens[2])
+    total = 0
+    for tok in tokens[3:3 + n]:
+        v = int(tok)
+        if lo <= v <= hi:
+            total += v
+    return total
+
+
+def main():
+    tokens = sys.stdin.read().split()
+    sys.stdout.write(f"! {solve(tokens)}\n")
+    sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
