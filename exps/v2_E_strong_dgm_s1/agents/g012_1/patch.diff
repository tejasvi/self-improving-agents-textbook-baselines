+
+
+# Thread-local storage for logger instances
+thread_local = threading.local()
+
+def get_thread_logger():
+    """
+    Get the logger instance specific to the current thread.
+    Returns None if no logger has been set for this thread.
+    """
+    return getattr(thread_local, 'logger', None)
+
+def set_thread_logger(logger):
+    """
+    Set the logger instance for the current thread.
+    """
+    thread_local.logger = logger
+
+def setup_logger(log_file='./chat_history.md', level=logging.INFO):
+    """
+    Set up a logger with both file and console handlers.
+    """
+    # Create logger with a unique name based on thread ID
+    logger = logging.getLogger(f'AgenticSystem-{threading.get_ident()}')
+    logger.setLevel(level)
+    
+    # Remove existing handlers to avoid duplicates
+    logger.handlers = []
+    
+    # Create formatters
+    file_formatter = logging.Formatter('%(message)s')
+    
+    # Create and set up file handler
+    os.makedirs(os.path.dirname(log_file), exist_ok=True)
+    file_handler = RotatingFileHandler(log_file, maxBytes=10*1024*1024, backupCount=5)
+    file_handler.setLevel(level)
+    file_handler.setFormatter(file_formatter)
+    
+    # Add handlers to logger
+    logger.addHandler(file_handler)
+    
+    # Store logger in thread-local storage
+    set_thread_logger(logger)
+    
+    return logger
+
+def safe_log(message, level=logging.INFO):
+    """
+    Thread-safe logging function that ensures messages go to the correct logger.
+    """
+    logger = get_thread_logger()
+    if logger:
+        logger.log(level, message)
+    else:
+        print(f"Warning: No logger found for thread {threading.get_ident()}")
+
+class AgenticSystem:
+    def __init__(
+            self,
+            problem_statement,
+            git_tempdir,
+            base_commit,
+            chat_history_file='./chat_history.md',
+            test_description=None,
+            self_improve=False,
+            language='python'
+        ):
+        self.problem_statement = problem_statement
+        self.git_tempdir = git_tempdir
+        self.base_commit = base_commit
+        self.chat_history_file = chat_history_file
+        self.test_description = test_description
+        self.self_improve = self_improve
+        self.language = language
+
+        # Set the code model based on whether self-improvement is enabled
+        self.code_model = CLAUDE_MODEL if not self_improve else OPENAI_MODEL
+
+        # Initialize logger and store it in thread-local storage
+        self.logger = setup_logger(chat_history_file)
+        
+        # Clear the log file
+        with open(chat_history_file, 'w') as f:
+            f.write('')
+
+    def get_current_edits(self):
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        new_msg_history = [
+            {
+                "role": "user",
+                "content": [
+                    {
+                        "type": "text",
+                        "text": f"# Current Repo Edits\n{diff}",
+                    }
+                ],
+            }
+        ]
+        return new_msg_history
+
+    # ------------------------------------------------------------------
+    # Harness-side evaluation helpers
+    # ------------------------------------------------------------------
+
+    def _sol_path(self):
+        return os.path.join(self.git_tempdir, 'solution.py')
+
+    def _read_solution(self):
+        try:
+            with open(self._sol_path()) as f:
+                return f.read()
+        except OSError:
+            return None
+
+    def _snapshot(self, k):
+        """Copy solution.py to /tmp/attempts/<run>/attempt_k.py. Returns the snapshot path or None."""
+        if not os.path.isfile(self._sol_path()):
+            return None
+        snap_dir = os.path.join('/tmp/attempts', self._run_id)
+        os.makedirs(snap_dir, exist_ok=True)
+        dst = os.path.join(snap_dir, f'attempt_{k}.py')
+        shutil.copyfile(self._sol_path(), dst)
+        return dst
+
+    def _check_basic(self):
+        """solution.py exists, is non-empty and compiles. Returns (ok, message)."""
+        path = self._sol_path()
+        if not os.path.isfile(path):
+            return False, "solution.py does not exist."
+        if os.path.getsize(path) == 0 or not open(path).read().strip():
+            return False, "solution.py is empty."
+        try:
+            p = subprocess.run(['python3', '-m', 'py_compile', 'solution.py'], cwd=self.git_tempdir,
+                               capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+        except subprocess.TimeoutExpired:
+            return False, "py_compile timed out."
+        if p.returncode != 0:
+            return False, "solution.py does not compile:\n" + (p.stderr or p.stdout)[-REPORT_CLIP:]
+        return True, "solution.py exists, is non-empty and compiles."
+
+    def _is_class_task(self):
+        return re.search(r"\bclass\s+Solution\b", self.problem_statement or '') is not None
+
+    @staticmethod
+    def _clean_block(text):
+        lines = [ln for ln in text.splitlines() if not ln.strip().startswith('```')]
+        return '\n'.join(lines).strip('\n')
+
+    def _parse_samples(self):
+        """Extract (index, input, expected) from 'Sample Input N' / 'Sample Output N' blocks."""
+        pat = re.compile(
+            r"Sample Input\s*(\d+)\s*:?[ \t]*\n(.*?)\n[ \t]*Sample Output\s*\1\s*:?[ \t]*\n"
+            r"(.*?)(?=\n[ \t]*\n|\n[ \t]*```|\n[ \t]*Sample Input\s*\d+|\Z)",
+            re.S | re.I)
+        samples = []
+        for m in pat.finditer(self.problem_statement or ''):
+            inp = self._clean_block(m.group(2))
+            out = self._clean_block(m.group(3))
+            samples.append((int(m.group(1)), inp + '\n', out))
+        return samples
+
+    def _run_samples(self, script='solution.py'):
+        """
+        Run `script` (default solution.py) on each parsed sample. Returns (passed, total, timed_out, report).
+        For Solution-class tasks nothing is run; the report tells the agent to check samples itself.
+        """
+        if self._is_class_task():
+            return 0, 0, False, ("This is a Solution-class task, so the harness did not run the samples. "
+                                 "Check every sample yourself with a driver script that calls Solution.")
+        samples = self._parse_samples()
+        if not samples:
+            return 0, 0, False, "No 'Sample Input N' / 'Sample Output N' blocks were found in the statement."
+        passed, timed_out, parts = 0, False, []
+        for idx, inp, exp in samples:
+            try:
+                p = subprocess.run(['python3', script], cwd=self.git_tempdir, input=inp,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                timed_out = True
+                parts.append(f"Sample {idx}: TIMEOUT after {RUN_TIMEOUT_S}s\n"
+                             f"input:\n{inp[:REPORT_CLIP]}\nexpected:\n{exp[:REPORT_CLIP]}")
+                continue
+            actual = p.stdout
+            if actual.split() == exp.split():
+                passed += 1
+            else:
+                parts.append(f"Sample {idx}: FAILED\ninput:\n{inp[:REPORT_CLIP]}"
+                             f"expected:\n{exp[:REPORT_CLIP]}\nactual:\n{actual[:REPORT_CLIP]}"
+                             f"stderr:\n{(p.stderr or '')[-REPORT_CLIP:]}\n(exit code {p.returncode})")
+        report = f"Samples passed for {script}: {passed}/{len(samples)}."
+        if parts:
+            report += "\n" + "\n".join(parts)
+        return passed, len(samples), timed_out, report
+
+    def _is_stub(self):
+        """True if solution.py is missing or contains nothing but pass / docstrings / comments."""
+        src = self._read_solution()
+        if src is None or not src.strip():
+            return True
+        try:
+            tree = ast.parse(src)
+        except SyntaxError:
+            return False
+        return all(isinstance(n, ast.Pass) or (isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant))
+                   for n in tree.body)
+
+    def _check_brute(self):
+        """Verify brute.py on the samples and that gen.py runs. Returns (ok, report)."""
+        missing = [f for f in ('brute.py', 'gen.py') if not os.path.isfile(os.path.join(self.git_tempdir, f))]
+        if missing:
+            return False, f"Missing file(s): {', '.join(missing)}."
+        passed, total, timed_out, report = self._run_samples(script='brute.py')
+        try:
+            g = subprocess.run(['python3', 'gen.py', '1'], cwd=self.git_tempdir, capture_output=True,
+                               text=True, timeout=RUN_TIMEOUT_S)
+            gen_ok = g.returncode == 0 and bool(g.stdout.strip())
+            gen_msg = "gen.py seed 1 ok." if gen_ok else f"gen.py failed:\n{(g.stderr or '')[-REPORT_CLIP:]}"
+        except subprocess.TimeoutExpired:
+            gen_ok, gen_msg = False, f"gen.py timed out on seed 1 (limit {RUN_TIMEOUT_S}s)."
+        ok = passed == total and not timed_out and gen_ok
+        return ok, report + "\n" + gen_msg
+
+    def _run_stress(self):
+        """
+        If gen.py and brute.py exist, compare solution.py against brute.py on STRESS_SEEDS seeds.
+        Returns (mismatch_found, ran, report). Stops at the first mismatch.
+        """
+        gen = os.path.join(self.git_tempdir, 'gen.py')
+        brute = os.path.join(self.git_tempdir, 'brute.py')
+        if not (os.path.isfile(gen) and os.path.isfile(brute)):
+            return False, 0, "Stress skipped: gen.py and/or brute.py missing."
+        start = time.monotonic()
+        ran = 0
+        for seed in range(1, STRESS_SEEDS + 1):
+            if time.monotonic() - start > STRESS_BUDGET_S:
+                break
+            try:
+                g = subprocess.run(['python3', 'gen.py', str(seed)], cwd=self.git_tempdir,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                return True, ran, f"gen.py timed out on seed {seed}."
+            if g.returncode != 0:
+                return True, ran, f"gen.py failed on seed {seed}:\nstderr:\n{(g.stderr or '')[-REPORT_CLIP:]}"
+            inp = g.stdout
+            try:
+                b = subprocess.run(['python3', 'brute.py'], cwd=self.git_tempdir, input=inp,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+                b_out, b_err, b_rc = b.stdout, b.stderr, b.returncode
+            except subprocess.TimeoutExpired:
+                return True, ran, f"brute.py timed out on seed {seed}; input:\n{inp[:REPORT_CLIP]}"
+            try:
+                s = subprocess.run(['python3', 'solution.py'], cwd=self.git_tempdir, input=inp,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+                s_out, s_err, s_rc = s.stdout, s.stderr, s.returncode
+            except subprocess.TimeoutExpired:
+                return True, ran, (f"solution.py TIMED OUT on seed {seed} (limit {RUN_TIMEOUT_S}s).\n"
+                                   f"input:\n{inp[:REPORT_CLIP]}\nbrute output:\n{b_out[:REPORT_CLIP]}")
+            ran += 1
+            if b_rc != 0:
+                return True, ran, (f"brute.py crashed on seed {seed}; brute may be wrong.\n"
+                                   f"input:\n{inp[:REPORT_CLIP]}\nbrute stderr:\n{b_err[-REPORT_CLIP:]}")
+            if s_out.split() != b_out.split():
+                return True, ran, (f"MISMATCH on seed {seed}.\ninput:\n{inp[:REPORT_CLIP]}"
+                                   f"brute (expected) output:\n{b_out[:REPORT_CLIP]}\n"
+                                   f"solution.py (actual) output:\n{s_out[:REPORT_CLIP]}\n"
+                                   f"solution.py stderr (exit {s_rc}):\n{s_err[-REPORT_CLIP:]}\n"
+                                   f"Note: brute.py itself may be wrong; verify it against the statement.")
+        return False, ran, f"Stress: {ran} seeds run, no mismatch."
+
+    def _run_timing(self):
+        """Run solution.py on max-size inputs from gen_big.py. Returns (ok, report)."""
+        gen_big = os.path.join(self.git_tempdir, 'gen_big.py')
+        if not os.path.isfile(gen_big):
+            return False, "Timing skipped: gen_big.py missing (write it to test max-size inputs)."
+        lines, ok = [], True
+        for seed in range(4):
+            try:
+                g = subprocess.run(['python3', 'gen_big.py', str(seed)], cwd=self.git_tempdir,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                return False, f"gen_big.py timed out on seed {seed}."
+            if g.returncode != 0:
+                return False, f"gen_big.py failed on seed {seed}:\n{(g.stderr or '')[-REPORT_CLIP:]}"
+            t0 = time.monotonic()
+            try:
+                s = subprocess.run(['python3', 'solution.py'], cwd=self.git_tempdir, input=g.stdout,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                return False, f"solution.py TIMED OUT on max-size seed {seed} (limit {RUN_TIMEOUT_S}s)."
+            dt = time.monotonic() - t0
+            if s.returncode != 0:
+                ok = False
+                lines.append(f"seed {seed}: crashed in {dt:.2f}s, stderr:\n{(s.stderr or '')[-REPORT_CLIP:]}")
+            elif dt > TIME_LIMIT_S:
+                ok = False
+                lines.append(f"seed {seed}: SLOW {dt:.2f}s (soft limit {TIME_LIMIT_S}s)")
+            else:
+                lines.append(f"seed {seed}: ok {dt:.2f}s")
+        return ok, "Max-size timing:\n" + "\n".join(lines)
+
+    # ------------------------------------------------------------------
+    # Prompts
+    # ------------------------------------------------------------------
+
+    def _task_text(self):
+        return f"""I have uploaded a code repository in the directory {self.git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {self.git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+"""
+
+    def _method_text(self):
+        return """Work like a careful competitive programmer:
+1. Read the statement and constraints. Choose an algorithm whose complexity fits the limits; Python does roughly 10^7 simple operations per second, so aim for well under that.
+2. Write the solution in solution.py with the editor tool.
+3. Run it on every sample in the statement and compare with the expected outputs exactly. For a stdin program use `python3 solution.py < sample1.txt`; for a `Solution` class method write a small driver script that calls the method on the sample arguments (add `from typing import *` and any imports you need at the top of solution.py).
+4. Write a brute-force reference for small inputs and a random small-input generator, then run a stress test of a few hundred cases comparing solution.py with the brute force. Fix every mismatch.
+5. Adversarial performance check (do this after correctness passes):
+   a. Write the worst-case operation count of solution.py as a number at maximum constraints (e.g. n=2*10^5 with a nested loop gives about 4*10^10). Show the estimate.
+   b. List at least 5 adversarial max-size inputs, including inputs that defeat any pruning or early-break logic in your solution: all identical elements (e.g. `'a'*20000`), a single value repeated the maximum number of times, all distinct values, skewed sizes, sorted or reverse-sorted input, and inputs with maximum distinct values so that every loop runs to its maximum.
+   c. Generate them with Python expressions (e.g. `'a'*20000`, `list(range(200000))`) and time them with the bench_solution tool (or bash with `timeout 10 python3 solution.py < big.txt`).
+   d. If any case takes more than about 1s, or the estimated operation count is over about 5*10^7, throw away the heuristic approach and look for a lower-complexity formulation. Do not micro-optimize a bad algorithm.
+   e. Pruning/early-break heuristics do not count as a complexity guarantee; test inputs that defeat them.
+   f. Validate any optimized or pruned solution against a simple brute force on random small inputs, including the heuristic-heavy paths.
+6. Keep iterating until all checks pass. The final solution.py is what gets graded; helper files are ignored."""
+
+    def _retry_prompt(self, feedback, prev_code):
+        code = (prev_code or '')[:CODE_CLIP]
+        code_block = f"```python\n{code}\n```" if code.strip() else "(solution.py is currently missing or empty)"
+        return f"""{self._task_text()}
+You are on a retry. A previous attempt at this problem was judged by an independent harness. The best code so far is in {self._sol_path()}:
+
+{code_block}
+
+Harness report:
+{feedback}
+
+Diagnose the root cause first. If your algorithm is fundamentally wrong, derive a different one; do not just patch special cases.
+Then update solution.py with the editor tool, run the samples yourself (for a Solution class, use a driver script), and re-test with a brute-force stress test and max-size timing. Keep reasoning brief and never end your turn without having written the file. """ + BUDGET_LINE + """
+"""
+
+    def _oracle_prompt(self):
+        return ORACLE_TEMPLATE.format(d=self.git_tempdir, statement=self.problem_statement)
+
+    def _ask(self, prompt, msg_history=None):
+        """
+        One agent call. Pass the msg_history returned by the previous call in the same phase to continue
+        that conversation; None starts a fresh one. Returns the (new) msg_history; on error the history
+        passed in is returned unchanged.
+        """
+        history = msg_history if msg_history is not None else []
+        try:
+            new_history = chat_with_agent(prompt, model=self.code_model, msg_history=history, logging=safe_log)
+            return new_history if new_history is not None else history
+        except Exception as e:
+            safe_log(f"Agent call failed: {e!r}")
+            return history
+
+    def _ask_until_changed(self, prompt, before):
+        """
+        Call the agent; re-prompt (bounded) if solution.py is still missing, empty or unchanged.
+        Continuation calls reuse the message history of this phase instead of starting fresh.
+        """
+        history = None
+        for n in range(MAX_NUDGES + 1):
+            p = prompt if n == 0 else f"{NUDGE_LINE}\n\n{prompt}"
+            history = self._ask(p, history)
+            cur = self._read_solution()
+            if cur is not None and cur.strip() and cur != before:
+                return True
+            safe_log(f"solution.py missing/empty/unchanged after call {n + 1}; re-prompting.")
+        return False
+
+    def _brute_phase(self):
+        """
+        Phase 0: get brute.py and gen.py verified on the samples. Bounded retries; each retry continues
+        the same conversation and receives the harness report. Returns True if verified.
+        """
+        if self._is_class_task():
+            return False
+        report = "(none; this is the first call)"
+        history = None
+        for n in range(MAX_BRUTE_TRIES):
+            if n == 0:
+                prompt = BRUTE_FIRST_TEMPLATE.format(d=self.git_tempdir, statement=self.problem_statement,
+                                                     report=report)
+            else:
+                prompt = ("The harness checked brute.py and gen.py. Harness report:\n" + report +
+                          "\n\nFix brute.py (and gen.py if needed) so that brute.py matches every sample exactly, "
+                          "then run it on the samples yourself. Do not write solution.py yet. " + BUDGET_LINE)
+            history = self._ask(prompt, history)
+            ok, report = self._check_brute()
+            safe_log(f"Brute phase try {n}: ok={ok}\n{report}")
+            if ok:
+                return True
+        return False
+
+    # ------------------------------------------------------------------
+    # Main loop
+    # ------------------------------------------------------------------
+
+    def forward(self):
+        """
+        Phase 0 writes a verified brute.py / gen.py and seeds solution.py from brute.py if it is still a stub.
+        Then a bounded multi-attempt loop: each attempt is judged by the harness; the best snapshot wins.
+        Score = (samples_passed, stress_ok, no_timeout); ties go to the later attempt.
+        """
+        self._run_id = uuid.uuid4().hex[:12]
+        best = None  # (score, k, snapshot_path)
+        feedback = None
+        prev_code = self._read_solution()
+        class_task = self._is_class_task()
+
+        # Phase 0: brute-force ground truth first (stdin tasks only).
+        if not class_task:
+            brute_ok = self._brute_phase()
+            brute_path = os.path.join(self.git_tempdir, 'brute.py')
+            if os.path.isfile(brute_path) and self._is_stub():
+                shutil.copyfile(brute_path, self._sol_path())
+                safe_log("solution.py was a stub; seeded it from brute.py as a fallback.")
+            safe_log(f"Brute phase finished: verified={brute_ok}")
+            prev_code = self._read_solution()
+
+        def have(files):
+            return all(os.path.isfile(os.path.join(self.git_tempdir, f)) for f in files)
+
+        brute_ready = have(('brute.py', 'gen.py'))
+
+        for k in range(MAX_ATTEMPTS):
+            before = self._read_solution()
+            if k == 0:
+                if brute_ready and not class_task:
+                    intro = ALREADY_HAVE_ORACLE_LINE + "\n\n"
+                    tail = ("Derive the efficient algorithm and write solution.py. Run the samples. Then stress test "
+                            "solution.py against brute.py using the gen.py seeds (run both on seeds 1..200 and compare "
+                            "outputs). If there is a mismatch, minimize the failing input and trace it by hand against "
+                            "brute.py's output to find the wrong step. Then, if time permits, check max-size timing with "
+                            "gen_big.py.")
+                    prompt = self._task_text() + "\n" + intro + self._method_text() + "\n\n" + tail + " " + BUDGET_LINE
+                else:
+                    prompt = self._task_text() + "\n" + self._method_text() + "\n\n" + FIRST_DRAFT_LINE
+            else:
+                prompt = self._retry_prompt(feedback, prev_code)
+            changed = self._ask_until_changed(prompt, before)
+            if not changed:
+                safe_log(f"Attempt {k}: agent produced no solution.py change after {MAX_NUDGES + 1} calls.")
+
+            # Create missing test helpers BEFORE any check, so the samples and stress test judge the same
+            # solution.py that the harness snapshots (the oracle call may also touch solution.py).
+            if not class_task and not have(('brute.py', 'gen.py', 'gen_big.py')):
+                self._ask(self._oracle_prompt())
+
+            ok, basic_msg = self._check_basic()
+            if not ok:
+                score = (-1, False, False)
+                feedback = f"Basic check FAILED: {basic_msg}\nWrite solution.py now."
+                safe_log(f"Attempt {k} score={score}\n{feedback}")
+                prev_code = self._read_solution()
+                continue
+
+            passed, total, samples_timeout, sample_report = self._run_samples()
+            report_parts = [basic_msg, sample_report]
+            stress_mismatch = False
+            timing_ok = True
+            samples_all_pass = passed == total and not samples_timeout
+
+            if class_task:
+                # Solution-class tasks: the harness cannot run them; the agent checks samples itself.
+                pass
+            else:
+                # Oracle phase (already done above, before the checks) runs even if samples fail.
+                stress_mismatch, _, stress_report = self._run_stress()
+                report_parts.append(stress_report)
+                if samples_all_pass and not stress_mismatch:
+                    timing_ok, timing_report = self._run_timing()
+                    report_parts.append(timing_report)
+
+            if class_task:
+                score = (0, True, True)
+            else:
+                score = (passed, not stress_mismatch, not samples_timeout and timing_ok)
+            snap = self._snapshot(k)
+            safe_log(f"Attempt {k} score={score} snapshot={snap}\n" + "\n".join(report_parts))
+
+            # ">=" so a later attempt wins ties, but never loses to a better earlier one.
+            if snap is not None and (best is None or score >= best[0]):
+                best = (score, k, snap)
+            prev_code = self._read_solution()
+            feedback = "\n\n".join(p for p in report_parts if p)
+            if any("Traceback" in p for p in report_parts):
+                feedback += "\n\n" + CRASH_HINT
+
+            clean = class_task or (samples_all_pass and not stress_mismatch and timing_ok and not samples_timeout)
+            if clean:
+                break  # all harness checks passed for this attempt
+
+        if best is None:
+            safe_log("No valid solution.py was produced by any attempt.")
+            return
+        score, k, snap = best
+        shutil.copyfile(snap, self._sol_path())
+        safe_log(f"Final: restored attempt {k} with score {score} to solution.py")
+
+
+def main():
+    parser = argparse.ArgumentParser(description='Process repository with an agentic system.')
+    parser.add_argument('--problem_statement', required=True, help='The problem statement to process')
+    parser.add_argument('--git_dir', required=True, help='Path to git repository directory')
+    parser.add_argument('--base_commit', required=True, help='Base commit hash to compare against')
+    parser.add_argument('--chat_history_file', required=True, help='Path to chat history file')
+    parser.add_argument('--outdir', required=False, default="/dgm/", help='Output directory')
+    parser.add_argument('--test_description', default=None, required=False, help='Description of how to test the repository')
+    parser.add_argument('--self_improve', default=False, action='store_true', help='Whether to self-improve the repository or solving swe')
+    parser.add_argument('--language', required=False, default="python", choices=['cpp', 'java', 'python', 'go', 'rust', 'javascript'], help='Task\'s programming language')
+    args = parser.parse_args()
+
+    # Process the repository
+    agentic_system = AgenticSystem(
+        problem_statement=args.problem_statement,
+        git_tempdir=args.git_dir,
+        base_commit=args.base_commit,
+        chat_history_file=args.chat_history_file,
+        test_description=args.test_description,
+        self_improve=args.self_improve,
+        language=args.language,
+    )
+
+    # Run the agentic system to try to solve the problem
+    agentic_system.forward()
+
+    # Get code diff and save to model_patch.diff
+    model_patch = diff_versus_commit(args.git_dir, args.base_commit)
+    model_patch_outfile = os.path.join(args.outdir, 'model_patch.diff') if args.outdir else 'model_patch.diff'
+    with open(model_patch_outfile, 'w') as f:
+        f.write(model_patch)
+
+if __name__ == "__main__":
+    main()
