+    def _run_interactive_stress(self):
+        """
+        Interactive tasks: run judge.py (written by the oracle phase) against solution.py on tiny seeds, medium seeds
+        and a few max-size seeds. Each run is a live protocol test. Returns (mismatch, ran, report) where mismatch
+        means solution.py failed (wrong answer, query limit, invalid query, deadlock/timeout, crash).
+        A crash of judge.py itself is a helper failure and is not charged to the solution.
+        """
+        judge = os.path.join(self.git_tempdir, 'judge.py')
+        if not os.path.isfile(judge):
+            return False, 0, "Interactive judge test skipped: judge.py missing."
+        sol = self._sol_path()
+        start = time.monotonic()
+        ran = 0
+        plan = ([('tiny', s) for s in range(1, STRESS_SEEDS + 1)]
+                + [('medium', s) for s in range(1, STRESS_MEDIUM_SEEDS + 1)]
+                + [('max', s) for s in range(1, INTERACTIVE_MAX_SEEDS + 1)])
+        for size, seed in plan:
+            if time.monotonic() - start > STRESS_BUDGET_S:
+                return False, ran, f"Interactive judge: budget exhausted after {ran} cases (no failure found so far)."
+            try:
+                p = subprocess.run(['python3', 'judge.py', str(seed), size, sol], cwd=self.git_tempdir,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT_S)
+            except subprocess.TimeoutExpired:
+                return True, ran, (f"solution.py DEADLOCKED or ran past {RUN_TIMEOUT_S}s on seed {seed} ({size}) "
+                                   "under the live judge (for example it reads stdin to EOF before answering, or it waits "
+                                   "for input it never receives). Read line by line and flush each query.")
+            out = (p.stdout or '').strip().splitlines()
+            verdict = out[-1].strip() if out else ''
+            if p.returncode != 0 or not (verdict.startswith('OK') or verdict.startswith('FAIL')):
+                return False, ran, (f"helper script failed: judge.py crashed on seed {seed} ({size}) "
+                                    f"(exit {p.returncode}; not counted against solution.py).\n"
+                                    f"stderr:\n{(p.stderr or '')[-REPORT_CLIP:]}")
+            if verdict.startswith('FAIL'):
+                transcript = "\n".join(out[:-1])[-REPORT_CLIP:]
+                return True, ran, (f"Interactive judge FAILED on seed {seed} ({size}): {verdict[len('FAIL'):].strip()}\n"
+                                   f"judge transcript (clipped):\n{transcript}\n"
+                                   f"solution.py stderr (clipped):\n{(p.stderr or '')[-REPORT_CLIP:]}")
+            ran += 1  # one more live case passed
+        return False, ran, f"Interactive judge: {ran} live cases passed (tiny + medium + max)."
+
