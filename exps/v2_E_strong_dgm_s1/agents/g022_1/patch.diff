+import os
+import sys
+from tools import time_method
+
+def _write(path, text):
+    with open(path, "w") as f:
+        f.write(text)
+
+GEN = "def gen(scale, seed):\n    n = max(1, int(2000 * scale))\n    return ['a' * n]\n"
+
+def test_fast_method_reports_small_time(tmp_path):
+    sol = tmp_path / "solution.py"
+    _write(sol, "class Solution:\n    def count(self, s):\n        return len(s)\n")
+    gen = tmp_path / "perf_gen.py"
+    _write(gen, GEN)
+    rep = time_method.tool_function("count", str(gen), solution_file=str(sol), scales=[0.5, 1.0], seeds=1)
+    assert "PERF_AT_MAX:" in rep and "TIMEOUT" not in rep.split("PERF_AT_MAX:")[1]
+
+def test_slow_method_times_out(tmp_path):
+    sol = tmp_path / "solution.py"
+    _write(sol, "import time\nclass Solution:\n    def count(self, s):\n        time.sleep(30)\n")
+    gen = tmp_path / "perf_gen.py"
+    _write(gen, GEN)
+    rep = time_method.tool_function("count", str(gen), solution_file=str(sol), scales=[0.01, 1.0], seeds=1, timeout=1)
+    assert "PERF_AT_MAX: TIMEOUT" in rep
+
+def test_exception_reports_error(tmp_path):
+    sol = tmp_path / "solution.py"
+    _write(sol, "class Solution:\n    def count(self, s):\n        raise ValueError('x')\n")
+    gen = tmp_path / "perf_gen.py"
+    _write(gen, GEN)
+    rep = time_method.tool_function("count", str(gen), solution_file=str(sol), scales=[0.01], seeds=1)
+    assert "EXCEPTION" in rep and "PERF_AT_MAX: ERROR" in rep
+
+def test_perf_failures_gate(tmp_path):
+    from coding_agent import AgenticSystem
+    a = AgenticSystem.__new__(AgenticSystem)
+    a.git_tempdir = str(tmp_path)
+    _write(tmp_path / "solution.py", "class Solution:\n    def count(self, s):\n        return len(s)\n")
+    assert a._detect_method_name() == "count"
+    assert a._is_solution_class_task()
+    assert a._perf_gen_missing()
+    assert a._perf_failures() is None
+    _write(tmp_path / "perf_gen.py", GEN)
+    assert not a._perf_gen_missing()
+    assert a._perf_failures() is None
+    _write(tmp_path / "solution.py", "import time\nclass Solution:\n    def count(self, s):\n        time.sleep(30)\n")
+    rep = a._perf_failures()
+    assert rep is not None and "TIMEOUT" in rep
diff --git a/tools/time_method.py b/tools/time_method.py
new file mode 100644
index 0000000..9a1289e
--- /dev/null
+++ b/tools/time_method.py
@@ -0,0 +1,257 @@
+import json
+import math
+import os
+import subprocess
+import sys
+import tempfile
+
+DEFAULT_SCALES = [0.01, 0.05, 0.2, 0.5, 1.0]
+DEFAULT_SEEDS = 3
+DEFAULT_TIMEOUT = 10
+TARGET_SCALE = 1.0
+MIN_FIT_SECONDS = 1e-3  # points faster than this are dominated by noise and ignored for the exponent fit
+
+
+def tool_info():
+    return {
+        "name": "time_method",
+        "description": """Measure how the running time of a `Solution` class method grows with input size, and estimate its time at the maximum constraint (scale 1.0).\n
+* `solution_file` is a Python file defining class `class_name` (default Solution) with method `method_name`. The class is instantiated with no arguments.\n
+* `generator_file` is a Python file defining `gen(scale, seed)` (NOTE: scale comes FIRST) that returns a list/tuple of positional arguments for the method. scale 1.0 must mean the maximum constraint size; smaller scales mean proportionally smaller inputs. Write adversarial generators (all-equal values, all-distinct, skewed, random, sorted/reversed) and make sure the generated inputs satisfy the constraints.\n
+* For each scale and seed, arguments are generated, deep-copied, and the method is called in a subprocess with a per-call alarm timeout. Only the method call is timed.\n
+* The report gives the max time per scale, marks TIMEOUT (remaining larger scales are skipped), estimates the growth exponent from log-log slopes, and extrapolates the time at scale 1.0. The last line is `PERF_AT_MAX: <seconds | TIMEOUT | ERROR | unknown>`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_file": {
+                    "type": "string",
+                    "description": "Path to the Python file containing the solution class. Default 'solution.py'."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the class containing the method. Default 'Solution'."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to time."
+                },
+                "generator_file": {
+                    "type": "string",
+                    "description": "Path to a Python file defining gen(scale, seed) that returns a list of positional arguments for the method."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "number"},
+                    "description": "List of scales passed to gen(). Default [0.01, 0.05, 0.2, 0.5, 1.0]; 1.0 is the maximum constraint size."
+                },
+                "seeds": {
+                    "type": "integer",
+                    "description": "Number of seeds (0 .. seeds-1) per scale. Default 3."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each single call of the method. Default 10."
+                }
+            },
+            "required": ["method_name", "generator_file"]
+        }
+    }
+
+
+# Executed in a separate Python process. Writes the result JSON after every scale, so a hang
+# that kills the process still leaves partial results behind.
+_RUNNER = r'''
+import copy, importlib.util, json, os, signal, sys, time, traceback
+
+cfg = json.load(open(sys.argv[1]))
+RESULT = cfg["result_path"]
+
+class CaseTimeout(Exception):
+    pass
+
+def _alarm(signum, frame):
+    raise CaseTimeout()
+
+HAS_ALARM = hasattr(signal, "setitimer") and hasattr(signal, "SIGALRM")
+if HAS_ALARM:
+    signal.signal(signal.SIGALRM, _alarm)
+
+def load(path, tag):
+    d = os.path.dirname(os.path.abspath(path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec = importlib.util.spec_from_file_location("tm_" + tag, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+def write(obj):
+    tmp = RESULT + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f)
+    os.replace(tmp, RESULT)
+
+def main():
+    timeout = cfg["timeout"]
+    try:
+        sol_mod = load(cfg["solution_file"], "sol")
+        gen_mod = load(cfg["generator_file"], "gen")
+        obj = getattr(sol_mod, cfg["class_name"])()
+        fn = getattr(obj, cfg["method_name"])
+    except BaseException:
+        write({"setup_error": traceback.format_exc(), "entries": []})
+        return
+    entries = []
+    stop = False
+    for scale in cfg["scales"]:
+        entry = {"scale": scale, "times": [], "status": "ok", "info": ""}
+        entries.append(entry)
+        if stop:
+            entry["status"] = "skipped"
+            continue
+        for seed in range(cfg["seeds"]):
+            try:
+                args = gen_mod.gen(scale, seed)
+                args = list(args)
+            except BaseException:
+                entry["status"] = "gen_error"
+                entry["info"] = traceback.format_exc()
+                stop = True
+                break
+            call_args = copy.deepcopy(args)  # copy outside the timed region
+            status, info = "ok", ""
+            t0 = time.perf_counter()
+            if HAS_ALARM:
+                signal.setitimer(signal.ITIMER_REAL, timeout)
+            try:
+                fn(*call_args)
+            except CaseTimeout:
+                status, info = "timeout", "timed out after %s seconds" % timeout
+            except BaseException:
+                status, info = "exception", traceback.format_exc()
+            finally:
+                if HAS_ALARM:
+                    signal.setitimer(signal.ITIMER_REAL, 0)
+            elapsed = time.perf_counter() - t0
+            if status != "ok":
+                entry["status"] = status
+                entry["info"] = info[-2000:]
+                stop = True
+                break
+            entry["times"].append(elapsed)
+        write({"setup_error": "", "entries": entries})
+    write({"setup_error": "", "entries": entries, "done": True})
+
+main()
+'''
+
+
+def _fit_exponent(points):
+    """Least-squares slope of log(time) vs log(scale). points: list of (scale, seconds)."""
+    pts = [(math.log(s), math.log(t)) for s, t in points if s > 0 and t >= MIN_FIT_SECONDS]
+    if len(pts) < 2:
+        return None
+    n = len(pts)
+    mx = sum(x for x, _ in pts) / n
+    my = sum(y for _, y in pts) / n
+    sxx = sum((x - mx) ** 2 for x, _ in pts)
+    if sxx <= 0:
+        return None
+    sxy = sum((x - mx) * (y - my) for x, y in pts)
+    return sxy / sxx
+
+
+def _format_report(method_name, scales, seeds, timeout, data):
+    lines = [f"time_method report: {method_name}, seeds={seeds}, per-call timeout={timeout}s"]
+    if data.get("setup_error"):
+        lines.append("SETUP ERROR:\n" + data["setup_error"][-2000:])
+        lines.append("PERF_AT_MAX: ERROR")
+        return "\n".join(lines)
+    entries = data.get("entries", [])
+    points = []
+    timed_out = False
+    crashed = False
+    for e in entries:
+        s = e["scale"]
+        if e["status"] == "ok" and e["times"]:
+            t = max(e["times"])
+            points.append((s, t))
+            lines.append(f"scale {s}: max {t:.4f}s over {len(e['times'])} seed(s)")
+        elif e["status"] == "timeout":
+            timed_out = True
+            lines.append(f"scale {s}: TIMEOUT ({e['info']}); larger scales skipped")
+        elif e["status"] in ("exception", "gen_error"):
+            crashed = True
+            lines.append(f"scale {s}: {e['status'].upper()}\n{e['info']}")
+        elif e["status"] == "skipped":
+            lines.append(f"scale {s}: skipped")
+        if timed_out or crashed:
+            break
+    if not timed_out and not crashed and len(entries) < len(scales):
+        lines.append("(run incomplete: subprocess stopped early)")
+        timed_out = True
+
+    k = _fit_exponent(points)
+    if k is not None:
+        lines.append(f"growth exponent (log-log fit over measured scales): {k:.2f}")
+    if timed_out:
+        lines.append("estimated time at scale 1.0: TIMEOUT")
+        lines.append("PERF_AT_MAX: TIMEOUT")
+    elif crashed:
+        lines.append("PERF_AT_MAX: ERROR")
+    elif not points:
+        lines.append("PERF_AT_MAX: unknown")
+    else:
+        s_last, t_last = points[-1]
+        if s_last >= TARGET_SCALE:
+            est = t_last
+            lines.append(f"measured time at scale {s_last}: {est:.4f}s")
+        else:
+            # clamp the exponent to a plausible range; the fit on tiny inputs is noisy
+            kk = min(max(k if k is not None else 1.0, 1.0), 3.0)
+            est = t_last * (TARGET_SCALE / s_last) ** kk
+            lines.append(f"estimated time at scale 1.0: {est:.2f}s (extrapolated from scale {s_last} with exponent {kk:.2f})")
+        lines.append(f"PERF_AT_MAX: {est:.4f}")
+    return "\n".join(lines)
+
+
+def tool_function(method_name, generator_file, solution_file='solution.py', class_name='Solution',
+                  scales=None, seeds=DEFAULT_SEEDS, timeout=DEFAULT_TIMEOUT):
+    scales = [float(s) for s in (scales or DEFAULT_SCALES)]
+    seeds = max(1, int(seeds or DEFAULT_SEEDS))
+    timeout = max(1, int(timeout or DEFAULT_TIMEOUT))
+    solution_file = os.path.abspath(solution_file)
+    generator_file = os.path.abspath(generator_file)
+    for path in (solution_file, generator_file):
+        if not os.path.exists(path):
+            return f"Error: file not found: {path}\nPERF_AT_MAX: ERROR"
+    with tempfile.TemporaryDirectory() as td:
+        cfg_path = os.path.join(td, "cfg.json")
+        res_path = os.path.join(td, "result.json")
+        runner_path = os.path.join(td, "runner.py")
+        with open(cfg_path, "w") as f:
+            json.dump({
+                "solution_file": solution_file, "generator_file": generator_file,
+                "class_name": class_name, "method_name": method_name,
+                "scales": scales, "seeds": seeds, "timeout": timeout, "result_path": res_path,
+            }, f)
+        with open(runner_path, "w") as f:
+            f.write(_RUNNER)
+        # Upper bound on the total run time plus slack; the runner also enforces per-call alarms.
+        total_budget = len(scales) * seeds * timeout + 30
+        try:
+            subprocess.run([sys.executable, runner_path, cfg_path], stdin=subprocess.DEVNULL,
+                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=total_budget,
+                           cwd=os.path.dirname(solution_file))
+        except subprocess.TimeoutExpired:
+            pass  # partial results (if any) are still reported below
+        data = {}
+        if os.path.exists(res_path):
+            try:
+                with open(res_path) as f:
+                    data = json.load(f)
+            except Exception:
+                data = {}
+        if not data:
+            return "time_method report: no result (the runner produced no output, it may have hung in native code)\nPERF_AT_MAX: TIMEOUT"
+    return _format_report(method_name, scales, seeds, timeout, data)
