diff --git a/tools/interactive_check.py b/tools/interactive_check.py
new file mode 100644
index 0000000..ab88873
--- /dev/null
+++ b/tools/interactive_check.py
@@ -0,0 +1,171 @@
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+
+RUN_LIMIT_S = 10
+CLIP = 1500
+MAX_LIVE_LINES = 100000  # bound on lines read in live mode
+
+
+def tool_info():
+    return {
+        "name": "interactive_check",
+        "description": """Check a stdin/stdout Python program written for an interactive problem under several non-interactive layouts, so you can see layout-dependent failures.
+Runs the solution three ways:
+(a) live: header is sent first, then one data token is sent as the reply each time the program prints a line starting with '?'. Only meaningful if the program really speaks the query protocol.
+(b) flat: stdin = header + newline + data_tokens (the hidden data given all at once).
+(c) flat with expected: stdin = header + newline + data_tokens + newline + expected_answer (only if expected_answer is given).
+For each run it reports exit code, whether it crashed or timed out, the last line starting with '!' (the final answer), and whether that matches expected_answer. Full stdout and stderr are shown (clipped).
+Use it after writing solution.py to see whether the program prints a correct final '! ...' line in every layout.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file."},
+                "header": {"type": "string", "description": "The first line of input (e.g. the problem's N and other parameters), without trailing newline."},
+                "data_tokens": {"type": "string", "description": "Whitespace-separated tokens of hidden data / pre-recorded replies that follow the header."},
+                "expected_answer": {"type": "string", "description": "Optional expected final answer (text after '!'), used to check matches. Empty if unknown."},
+                "timeout_s": {"type": "integer", "description": "Timeout in seconds per run (default 10)."},
+            },
+            "required": ["solution_path", "header", "data_tokens"],
+        },
+    }
+
+
+def _clip(s, n=CLIP):
+    s = (s or "").strip()
+    return s if len(s) <= n else s[: n // 2] + " ... " + s[-n // 2:]
+
+
+def _last_bang(stdout):
+    last = None
+    for line in (stdout or "").splitlines():
+        if line.strip().startswith("!"):
+            last = line.strip()
+    return last
+
+
+def _matches(final, expected):
+    if final is None or not expected or not expected.strip():
+        return None
+    return final.lstrip("!").split() == expected.split()
+
+
+def _flat_run(cmd, cwd, stdin_text, timeout_s):
+    try:
+        p = subprocess.run(cmd, cwd=cwd, input=stdin_text, capture_output=True, text=True, timeout=timeout_s)
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err + f"\n(killed after {timeout_s}s)", None, True
+
+
+def _live_run(cmd, cwd, header, reply_tokens, timeout_s):
+    """Send header, then answer each '?' line with the next reply token. Returns (stdout, stderr, rc, timed_out)."""
+    with tempfile.TemporaryFile(mode="w+") as err_f:
+        try:
+            proc = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                    stderr=err_f, text=True, bufsize=1)
+        except OSError as e:
+            return "", f"failed to start: {e}", None, False
+        killed = {"flag": False}
+
+        def _kill():
+            killed["flag"] = True
+            try:
+                proc.kill()
+            except OSError:
+                pass
+
+        timer = threading.Timer(timeout_s, _kill)
+        timer.start()
+        out_lines = []
+        try:
+            proc.stdin.write(header + "\n")
+            proc.stdin.flush()
+            idx = 0
+            for _ in range(MAX_LIVE_LINES):
+                line = proc.stdout.readline()
+                if not line:
+                    break
+                out_lines.append(line.rstrip("\n"))
+                s = line.strip()
+                if s.startswith("!"):
+                    break
+                if s.startswith("?"):
+                    reply = reply_tokens[idx] if idx < len(reply_tokens) else "-1"
+                    idx += 1
+                    try:
+                        proc.stdin.write(reply + "\n")
+                        proc.stdin.flush()
+                    except OSError:
+                        break  # program already exited
+            try:
+                proc.stdin.close()
+            except OSError:
+                pass
+            rc = proc.wait(timeout=timeout_s + 5)
+        except (subprocess.TimeoutExpired, OSError):
+            try:
+                proc.kill()
+            except OSError:
+                pass
+            rc = None
+        finally:
+            timer.cancel()
+        if killed["flag"] and rc is None:
+            rc = None
+        err_f.seek(0)
+        err = err_f.read()
+        timed_out = killed["flag"]
+        if timed_out:
+            err += f"\n(killed after {timeout_s}s)"
+            rc = None
+        return "\n".join(out_lines), err, rc, timed_out
+
+
+def tool_function(solution_path, header, data_tokens, expected_answer="", timeout_s=10):
+    try:
+        timeout_s = max(1, min(int(timeout_s or 10), 120))
+    except (TypeError, ValueError):
+        timeout_s = 10
+    path = os.path.abspath(str(solution_path))
+    if not os.path.isfile(path):
+        return f"Error: solution file not found: {solution_path}"
+    cwd = os.path.dirname(path)
+    cmd = [sys.executable, path]
+    header = str(header or "").strip()
+    data = str(data_tokens or "").split()
+    expected = str(expected_answer or "").strip()
+
+    runs = []
+    # (a) live protocol with precomputed replies
+    out, err, rc, to = _live_run(cmd, cwd, header, data, timeout_s)
+    runs.append(("live (header, replies from data_tokens)", out, err, rc, to))
+    # (b) flat stdin: header + data
+    flat_b = header + "\n" + " ".join(data) + "\n"
+    out, err, rc, to = _flat_run(cmd, cwd, flat_b, timeout_s)
+    runs.append(("flat: header + data", out, err, rc, to))
+    # (c) flat stdin: header + data + expected
+    if expected:
+        flat_c = header + "\n" + " ".join(data) + "\n" + expected + "\n"
+        out, err, rc, to = _flat_run(cmd, cwd, flat_c, timeout_s)
+        runs.append(("flat: header + data + expected", out, err, rc, to))
+
+    rows = ["| layout | exit | crash? | final answer | matches expected? |", "|---|---|---|---|---|"]
+    details = []
+    for name, out, err, rc, to in runs:
+        final = _last_bang(out)
+        crashed = to or rc != 0
+        m = _matches(final, expected)
+        m_txt = "n/a (no expected answer)" if m is None else ("YES" if m else "NO")
+        rows.append(f"| {name} | {'timeout' if to else rc} | {'YES' if crashed else 'no'} | "
+                    f"{final if final is not None else '(no line starting with !)'} | {m_txt} |")
+        note = ""
+        if name.startswith("live") and to:
+            note = ("\nnote: the live run hung. A program that calls sys.stdin.read() before it queries never gets EOF "
+                    "in live mode; that is expected for read-all dual-mode code, so judge the flat layouts instead.")
+        details.append(f"--- {name} ---\nstdout:\n{_clip(out)}\nstderr:\n{_clip(err)}{note}")
+    return "\n".join(rows) + "\n\n" + "\n\n".join(details)
