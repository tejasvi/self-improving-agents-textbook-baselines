-# Placeholder solution file. The actual changes are applied to the coding agent repo in /dgm.
+# Matches the contract in brute.py by construction:
+#   stdin : "N L R" followed by N integers (tokens may be split across lines).
+#   stdout: "! S" where S = sum of array elements v with L <= v <= R.
+# Single pass over the values; O(N) time, O(1) extra memory.
+import sys
+
+
+def main():
+    data = sys.stdin.buffer.read().split()
+    n, lo, hi = int(data[0]), int(data[1]), int(data[2])
+    total = 0
+    for i in range(3, 3 + n):
+        v = int(data[i])
+        if lo <= v <= hi:
+            total += v
+    sys.stdout.write(f"! {total}\n")
+
+
+if __name__ == "__main__":
+    main()
