+def _nonstub_body(text):
+    """True if the source has at least one executable body line (not just imports/defs/pass)."""
+    for raw in text.splitlines():
+        s = raw.strip()
+        if not s or s.startswith("#") or s.startswith("import ") or s.startswith("from ") \
+                or s == "pass" or s == "...":
+            continue
+        if s.startswith("class ") or s.startswith("def "):
+            # Signature-only lines are not body; one-liners like "def f(): return 1" are.
+            _, _, tail = s.partition(":")
+            if not tail.strip() or tail.strip() == "pass":
+                continue
+        return True
+    return False
+
+
+def _assistant_text(msgs):
+    """Concatenated assistant text across the given messages."""
+    out = []
+    for m in msgs:
+        if m.get("role") != "assistant":
+            continue
+        parts = m.get("content")
+        if isinstance(parts, str):
+            out.append(parts)
+            continue
+        for b in parts or []:
+            t = b.get("text") if isinstance(b, dict) else getattr(b, "text", None)
+            if t:
+                out.append(t)
+    return "".join(out)
+
+
+def _reply_is_empty(msg_history, before_len):
+    """True if the messages added after before_len carry no real assistant text."""
+    return _assistant_text(msg_history[before_len:]).strip() in PROGRESS_NONE_REPLIES
