+    def _starter_names(self):
+        """Names of top-level defs/classes in the starter solution.py at base_commit."""
+        out = subprocess.run(["git", "-C", self.git_tempdir, "show", f"{self.base_commit}:solution.py"],
+                             capture_output=True, text=True, check=False)
+        if out.returncode != 0:
+            return set()
+        try:
+            tree = ast.parse(out.stdout)
+        except SyntaxError:
+            return set()
+        names = set()
+        for node in tree.body:
+            if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
+                names.add(node.name)
+                if isinstance(node, ast.ClassDef):
+                    names.update(m.name for m in node.body if isinstance(m, ast.FunctionDef))
+        return names
+
+    def _gate(self):
+        """
+        Deterministic check, no LLM: solution.py imports, defines the starter signature, is not a stub,
+        and passes any samples.json / samples.txt the agent saved. Returns a dict.
+        """
+        result = {"ok": False, "error": "", "samples_passed": 0, "samples_total": 0}
+        solution_path = os.path.join(self.git_tempdir, "solution.py")
+        if not os.path.exists(solution_path):
+            result["error"] = "solution.py does not exist"
+            return result
+        with open(solution_path) as f:
+            text = f.read()
+        if not _nonstub_body(text):
+            result["error"] = "solution.py is only the starter stub (no body)"
+            return result
+
+        # Syntax + starter-signature check without executing the module (stdin programs would block).
+        try:
+            tree = ast.parse(text)
+        except SyntaxError as e:
+            result["error"] = f"solution.py has a syntax error: {e}"
+            return result
+        defined = {n.name for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
+        missing = self._starter_names() - defined
+        if missing:
+            result["error"] = f"solution.py is missing starter definitions: {sorted(missing)}"
+            return result
+
+        # Run saved samples (stdin programs only; method-style samples are checked by the agent).
+        samples = []
