+        """Returns ('PASS'|'FAIL'|'MISSING', detail text) from STATUS.txt written by the agent."""
+        path = os.path.join(self.git_tempdir, "STATUS.txt")
+        if not os.path.exists(path):
+            return "MISSING", ""
+        with open(path) as f:
