+    def _agreement(self, cands, n_inputs=200):
+        """
+        Pairwise agreement on shared random inputs from gen.py (stdin programs only). Adds
+        cand['agreement'] = number of (input, other-candidate) pairs where outputs match.
+        Without gen.py, every candidate gets 0 and the latest successful attempt wins ties.
+        """
+        gen_path = os.path.join(self.git_tempdir, "gen.py")
+        valid = [c for c in cands if c["gate"]["ok"] and c["solution"] is not None]
+        if not os.path.exists(gen_path) or len(valid) < 2:
+            return
+        outputs = {}
+        with tempfile.TemporaryDirectory() as tmp:
+            shutil.copy(gen_path, os.path.join(tmp, "gen.py"))
+            inputs = []
+            for seed in range(n_inputs):
+                try:
+                    r = subprocess.run(["python3", "gen.py", str(seed), "3"], cwd=tmp,
+                                       capture_output=True, text=True, timeout=SAMPLE_TIMEOUT)
+                except subprocess.TimeoutExpired:
+                    continue
+                if r.returncode == 0 and r.stdout.strip():
+                    inputs.append(r.stdout)
+            for c in valid:
+                prog = os.path.join(tmp, f"cand{c['attempt']}.py")
+                with open(prog, "w") as f:
+                    f.write(c["solution"])
+                outs = []
+                for inp in inputs:
+                    try:
+                        r = subprocess.run(["python3", prog], cwd=tmp, input=inp,
+                                           capture_output=True, text=True, timeout=SAMPLE_TIMEOUT)
+                        outs.append(r.stdout.split() if r.returncode == 0 else None)
+                    except subprocess.TimeoutExpired:
+                        outs.append(None)
+                outputs[c["attempt"]] = outs
+        for c in valid:
+            mine = outputs.get(c["attempt"], [])
+            score = 0
+            for other in valid:
+                if other is c:
+                    continue
+                theirs = outputs.get(other["attempt"], [])
+                score += sum(1 for a, b in zip(mine, theirs) if a is not None and a == b)
+            c["agreement"] = score
+
+    def _score(self, cand):
+        """Higher is better: gate ok, STATUS PASS, sample passes, agreement with other candidates, later attempt."""
+        g = cand["gate"]
+        return (1 if g["ok"] else 0, 1 if cand["status"] == "PASS" else 0,
+                g["samples_passed"], cand.get("agreement", 0), cand["attempt"])
+
