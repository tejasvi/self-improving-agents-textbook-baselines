+MAX_EMPTY_RESPONSE_RETRIES = 3
+
+def get_claude_tool_uses(response):
+    """
+    Returns all tool_use blocks in a Claude response (not just the first one).
+    """
+    tool_uses = []
+    for block in response.content:
+        if getattr(block, 'type', None) == "tool_use":
+            tool_uses.append({
+                'tool_id': block.id,
+                'tool_name': block.name,
+                'tool_input': block.input,
+            })
+    return tool_uses
+
+def get_claude_text(response):
+    """
+    Returns the concatenated text of a Claude response ('' if there is none).
+    """
+    texts = [
+        block.text for block in response.content
+        if getattr(block, 'type', None) == "text" and block.text and block.text.strip()
+    ]
+    return "\n".join(texts).strip()
+
+def _append_user_content(msg_history, content_blocks):
+    """
+    Appends user content blocks, merging into the previous user message if there is one,
+    so that user and assistant turns keep alternating.
+    """
+    if msg_history and msg_history[-1]['role'] == 'user' and isinstance(msg_history[-1]['content'], list):
+        msg_history[-1]['content'].extend(content_blocks)
+    else:
+        msg_history.append({"role": "user", "content": list(content_blocks)})
+
