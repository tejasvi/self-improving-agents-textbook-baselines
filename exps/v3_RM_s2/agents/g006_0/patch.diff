@@ -22,6 +22,45 @@ def process_tool_call(tools_dict, tool_name, tool_input):
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def get_response_metadata(response, model=''):
+    """
+    Extracts the stop reason and token usage from a model response.
+    Returns a dict with 'stop_reason' and 'usage' (missing values are None).
+    """
+    stop_reason = None
+    usage = None
+    if 'claude' in model:
+        stop_reason = getattr(response, 'stop_reason', None)
+        u = getattr(response, 'usage', None)
+        if u is not None:
+            usage = {
+                'input_tokens': getattr(u, 'input_tokens', None),
+                'output_tokens': getattr(u, 'output_tokens', None),
+            }
+    elif model.startswith('o3-'):
+        stop_reason = getattr(response, 'status', None)
+        incomplete = getattr(response, 'incomplete_details', None)
+        if incomplete is not None and getattr(incomplete, 'reason', None):
+            stop_reason = f"{stop_reason} ({incomplete.reason})"
+        u = getattr(response, 'usage', None)
+        if u is not None:
+            usage = {
+                'input_tokens': getattr(u, 'input_tokens', None),
+                'output_tokens': getattr(u, 'output_tokens', None),
+                'total_tokens': getattr(u, 'total_tokens', None),
+            }
+    return {'stop_reason': stop_reason, 'usage': usage}
+
+def log_response_metadata(response, model='', logging=print):
+    """
+    Logs the stop reason and usage of a model response to the chat history.
+    """
+    try:
+        meta = get_response_metadata(response, model=model)
+        logging(f"Response metadata: stop_reason={meta['stop_reason']}, usage={meta['usage']}")
+    except Exception as e:
+        logging(f"Failed to log response metadata: {e!r}")
+
 @backoff.on_exception(
