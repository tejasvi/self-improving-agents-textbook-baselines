+# Errors that are considered transient and worth retrying with backoff.
+TRANSIENT_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
 )
+
+def _is_transient_error(e):
+    """
+    Returns True for errors that are likely to succeed on retry (rate limits, timeouts,
+    connection problems, 5xx / overloaded responses). Other errors (e.g. 4xx client errors,
+    unsupported model) are not retried.
+    """
+    if isinstance(e, TRANSIENT_ERRORS):
+        return True
+    status = getattr(e, 'status_code', None)
+    if isinstance(status, int) and (status == 429 or status == 408 or status >= 500):
+        return True
+    return False
