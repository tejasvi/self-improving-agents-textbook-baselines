+def log_response_metadata(response, model='', logging=print):
+    """
+    Logs the metadata (stop reason and token usage) of a model response to the chat history.
+    """
+    try:
+        if 'claude' in model:
+            stop_reason = getattr(response, 'stop_reason', None)
+            usage = getattr(response, 'usage', None)
+            usage_info = {
+                'input_tokens': getattr(usage, 'input_tokens', None),
+                'output_tokens': getattr(usage, 'output_tokens', None),
+            } if usage is not None else None
+        elif model.startswith('o3-'):
+            status = getattr(response, 'status', None)
+            incomplete = getattr(response, 'incomplete_details', None)
+            stop_reason = status
+            if incomplete is not None and getattr(incomplete, 'reason', None):
+                stop_reason = f"{status} ({incomplete.reason})"
+            usage = getattr(response, 'usage', None)
+            usage_info = {
+                'input_tokens': getattr(usage, 'input_tokens', None),
+                'output_tokens': getattr(usage, 'output_tokens', None),
+                'total_tokens': getattr(usage, 'total_tokens', None),
+            } if usage is not None else None
+        else:
+            return
+        logging(f"Response metadata: stop_reason={stop_reason}, usage={usage_info}")
+    except Exception as e:
+        logging(f"Failed to log response metadata: {str(e)}")
+
