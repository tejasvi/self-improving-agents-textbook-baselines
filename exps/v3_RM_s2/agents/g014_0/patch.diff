+def extract_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in a message history.
+    Handles both plain-string content and block-list content (dict or object blocks).
+    """
+    for msg in reversed(msg_history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role != 'assistant':
+            continue
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            return content
+        texts = []
+        for block in content or []:
+            if isinstance(block, dict):
+                text = block.get('text')
+            else:
+                text = getattr(block, 'text', None)
+            if text:
+                texts.append(text)
+        if texts:
+            return "\n".join(texts)
+    return ""
