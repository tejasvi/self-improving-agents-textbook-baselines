+    def run_tests(self):
+        """
+        Run the test commands for the task's language inside git_tempdir.
+        The commands run as one shell chain so shell state (cd, set -e) carries across steps.
+        Returns (passed, output) with raw output only. Returns (None, output) when there is no
+        test signal (no test commands for the language, or pytest collected no tests).
+        """
+        commands = TEST_COMMANDS.get(self.language)
+        if not commands:
+            return None, ''
+        script = ' && '.join(shlex.join(cmd) for cmd in commands)
+        header = f"$ {script}\n"
+        try:
+            result = subprocess.run(
+                ['sh', '-c', script], cwd=self.git_tempdir, capture_output=True, text=True,
+                timeout=TEST_TIMEOUT_SECONDS, check=False,
+            )
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            return False, f"{header}{out}\nTimed out after {TEST_TIMEOUT_SECONDS} seconds."
+        except OSError as e:
+            return False, f"{header}Failed to run test command: {e}"
+        output = f"{header}{result.stdout}{result.stderr}"
+        # pytest exit code 5 means no tests were collected: no signal either way
+        if self.language == 'python' and result.returncode == 5:
+            return None, output
+        return result.returncode == 0, output
+
+    def build_failed_attempts_block(self, failed_attempts):
