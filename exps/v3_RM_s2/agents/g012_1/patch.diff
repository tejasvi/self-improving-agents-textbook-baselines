index 0000000..282ffe9
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,117 @@
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python solution program on given test inputs and compare its standard output with the expected outputs.\n
+* The solution file is executed as `python <solution_path>` with each test's `input` written to standard input.\n
+* Each test's actual stdout is compared with `expected_output`. Comparison ignores leading/trailing whitespace and differences in line endings / trailing spaces on each line, but is otherwise exact (token sequence must match).\n
+* Returns a per-test PASS/FAIL summary. For failing tests it shows the input, expected output, actual output, stderr and whether it timed out or crashed, so you can diagnose the problem.\n
+* Use this to verify a solution against the sample tests from the problem statement and against your own additional tests (e.g. edge cases and brute-force comparisons written as separate inputs).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (a complete program that reads standard input and writes standard output)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text to feed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should print to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional per-test timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str):
+    return [line.split() for line in text.strip().splitlines() if line.strip()]
+
+
+def _run_one(solution_path: str, input_text: str, timeout: float):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, None, f"Timed out after {timeout} seconds"
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = 10) -> str:
+    try:
+        if not isinstance(test_cases, list) or not test_cases:
+            return "Error: `test_cases` must be a non-empty list of objects with 'input' and 'expected_output'."
+        try:
+            timeout = float(timeout) if timeout is not None else 10.0
+        except (TypeError, ValueError):
+            return f"Error: invalid timeout {timeout!r}."
+
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Test {idx}: FAIL (malformed test case; needs 'input' and 'expected_output')")
+                continue
+            input_text = str(case["input"])
+            expected = str(case["expected_output"])
+            stdout, stderr, returncode, problem = _run_one(solution_path, input_text, timeout)
+
+            if problem is None and returncode == 0 and _normalize(stdout) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+                continue
+
+            status = "FAIL"
+            details = []
+            if problem:
+                details.append(problem)
+            elif returncode != 0:
+                details.append(f"Runtime error (exit code {returncode})")
+            details.append(f"Input:\n{input_text}")
+            details.append(f"Expected output:\n{expected}")
+            details.append(f"Actual output:\n{stdout}")
+            if stderr:
+                details.append(f"Stderr:\n{stderr}")
+            reports.append(f"Test {idx}: {status}\n" + "\n".join(details))
+
+        summary = f"{passed}/{len(test_cases)} tests passed."
+        return summary + "\n\n" + "\n\n".join(reports)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    import json
+    print(json.dumps(tool_info(), indent=2)[:200])
+    print(tool_function(
+        "/tmp/_sol.py",
+        [{"input": "1 2\n", "expected_output": "3\n"}],
+    ))
