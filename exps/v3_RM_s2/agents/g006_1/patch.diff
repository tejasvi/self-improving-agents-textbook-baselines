diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..fde26a7
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,111 @@
+import anthropic
+import httpx
+import openai
+import pytest
+
+from utils.retry import call_with_retries, is_transient_error
+
+
+def _req():
+    return httpx.Request("POST", "http://example.invalid")
+
+
+def _resp(status):
+    return httpx.Response(status, request=_req())
+
+
+def _no_sleep(_):
+    pass
+
+
+def test_success_no_retry():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        return "ok"
+
+    assert call_with_retries(fn, sleep=_no_sleep, logging=None) == "ok"
+    assert calls["n"] == 1
+
+
+def test_transient_then_success():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise anthropic.RateLimitError("limited", response=_resp(429), body=None)
+        return "ok"
+
+    assert call_with_retries(fn, sleep=_no_sleep, logging=None) == "ok"
+    assert calls["n"] == 3
+
+
+def test_permanent_error_not_retried():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        raise anthropic.BadRequestError("bad", response=_resp(400), body=None)
+
+    with pytest.raises(anthropic.BadRequestError):
+        call_with_retries(fn, sleep=_no_sleep, logging=None)
+    assert calls["n"] == 1
+
+
+def test_bounded_attempts_on_persistent_transient_error():
+    calls = {"n": 0}
+    sleeps = []
+
+    def fn():
+        calls["n"] += 1
+        raise openai.APITimeoutError(request=_req())
+
+    with pytest.raises(openai.APITimeoutError):
+        call_with_retries(fn, max_retries=3, sleep=sleeps.append, logging=None)
+    assert calls["n"] == 4  # 1 initial + 3 retries
+    assert len(sleeps) == 3
+
+
+def test_backoff_grows_and_is_capped():
+    sleeps = []
+
+    def fn():
+        raise anthropic.InternalServerError("boom", response=_resp(500), body=None)
+
+    with pytest.raises(anthropic.InternalServerError):
+        call_with_retries(
+            fn, max_retries=6, base_delay=1.0, max_delay=4.0,
+            sleep=sleeps.append, logging=None,
+        )
+    # Pre-jitter delays are 1, 2, 4, 4, 4, 4; jitter adds up to 25%.
+    assert len(sleeps) == 6
+    assert 1.0 <= sleeps[0] <= 1.25
+    assert 2.0 <= sleeps[1] <= 2.5
+    assert 4.0 <= sleeps[2] <= 5.0
+    assert all(4.0 <= s <= 5.0 for s in sleeps[2:])
+
+
+def test_zero_retries_means_single_attempt():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        raise anthropic.RateLimitError("limited", response=_resp(429), body=None)
+
+    with pytest.raises(anthropic.RateLimitError):
+        call_with_retries(fn, max_retries=0, sleep=_no_sleep, logging=None)
+    assert calls["n"] == 1
+
+
+def test_is_transient_error_classification():
+    assert is_transient_error(anthropic.RateLimitError("x", response=_resp(429), body=None))
+    assert is_transient_error(openai.APIConnectionError(request=_req()))
+    assert is_transient_error(RuntimeError("x")) is False
+
+    class Fake(Exception):
+        status_code = 529
+
+    assert is_transient_error(Fake())
+    assert is_transient_error(anthropic.AuthenticationError("x", response=_resp(401), body=None)) is False
diff --git a/utils/retry.py b/utils/retry.py
new file mode 100644
index 0000000..d71a932
--- /dev/null
+++ b/utils/retry.py
@@ -0,0 +1,68 @@
+"""
+Retry helper with exponential backoff for transient LLM API failures.
+
+Only transient errors (rate limits, timeouts, connection errors, 5xx/overloaded)
+are retried. Permanent errors (bad request, auth, not found, etc.) are raised
+immediately. Attempts are bounded, so there is no unbounded loop.
+"""
+import random
+import time
+
+import anthropic
+import openai
+
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+
+TRANSIENT_ERROR_TYPES = (
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+)
+
+
+def is_transient_error(exc):
+    """Return True if the exception is likely to succeed when retried."""
+    if isinstance(exc, TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(exc, 'status_code', None)
+    return isinstance(status, int) and status in TRANSIENT_STATUS_CODES
+
+
+def call_with_retries(
+    fn,
+    *args,
+    max_retries=5,
+    base_delay=1.0,
+    max_delay=60.0,
+    logging=print,
+    sleep=time.sleep,
+    **kwargs,
+):
+    """
+    Call fn(*args, **kwargs), retrying transient failures with exponential backoff.
+
+    Makes at most `max_retries + 1` attempts. Non-transient exceptions propagate
+    immediately; after the final transient failure the last exception is raised.
+    """
+    if logging is None:
+        logging = print
+    for attempt in range(1, max_retries + 2):
+        try:
+            return fn(*args, **kwargs)
+        except Exception as e:
+            if not is_transient_error(e) or attempt > max_retries:
+                raise
+            delay = min(max_delay, base_delay * (2 ** (attempt - 1)))
+            delay += random.uniform(0, delay * 0.25)  # jitter
+            logging(
+                f"Transient API error ({type(e).__name__}: {e}); "
+                f"retry {attempt}/{max_retries} in {delay:.1f}s"
+            )
+            sleep(delay)
+    # Unreachable: the loop either returns or raises.
+    raise RuntimeError("call_with_retries: exhausted attempts")
