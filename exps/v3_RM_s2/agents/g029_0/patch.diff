+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n... [{omitted} characters truncated] ...\n{text[-half:]}"
+
+
+def read_bounded(f, max_bytes=MAX_OUTPUT_CHARS * 4):
+    """Read a temp file without loading huge outputs fully into memory.
+
+    Keeps the first and last max_bytes/2 bytes; the middle is dropped, and
+    truncate_output later marks the cut.
+    """
+    f.seek(0, os.SEEK_END)
+    size = f.tell()
+    half = max_bytes // 2
+    if size <= max_bytes:
+        f.seek(0)
+        return f.read().decode(errors="replace")
+    f.seek(0)
+    head = f.read(half)
+    f.seek(size - half)
+    tail = f.read(half)
+    return (head + b"\n... [output omitted] ...\n" + tail).decode(errors="replace")
+
+
