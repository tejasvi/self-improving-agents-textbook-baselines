+    def test_timeout_kills_command(self, monkeypatch):
+        """Long-running commands are killed after the timeout."""
+        import tools.bash as bash
+        monkeypatch.setattr(bash, "COMMAND_TIMEOUT", 1.0)
+        result = bash.tool_function("sleep 30")
+        assert "timed out" in result
+
+    def test_output_truncation(self):
+        """Very long output is truncated."""
+        result = tool_function("head -c 100000 /dev/zero | tr '\\0' 'a'")
+        assert "characters truncated" in result
+        assert len(result) < 20000
+
+    def test_truncate_output_helper(self):
+        assert truncate_output("short") == "short"
+        long = "x" * 50000
+        out = truncate_output(long, max_chars=1000)
+        assert "characters truncated" in out
+        assert len(out) < 1100
+
+    def test_background_process_does_not_block(self):
+        """A backgrounded child holding the output must not stall the call."""
+        import time
+        start = time.time()
+        result = tool_function("sleep 60 & echo 'started'")
+        assert "started" in result
+        assert time.time() - start < 10
+
+    def test_huge_output_is_bounded(self):
+        """Huge output is read in bounded form and truncated."""
+        result = tool_function("head -c 50000000 /dev/zero | tr '\\0' 'b'")
+        assert "truncated" in result or "omitted" in result
+        assert len(result) < 40000
