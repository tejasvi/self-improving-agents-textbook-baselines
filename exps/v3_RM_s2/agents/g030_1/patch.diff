+def _extract_text(content):
+    """Collect text from a message content value (str, list of dict/object blocks, or object)."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        texts = [t for t in (_extract_text(block) for block in content) if t]
+        return "\n".join(texts)
+    if isinstance(content, dict):
+        if content.get('type') == 'text' and isinstance(content.get('text'), str):
+            return content['text']
+        return ''
+    # SDK object blocks (e.g. Anthropic/OpenAI content items)
+    if getattr(content, 'type', None) in ('text', 'output_text') and isinstance(getattr(content, 'text', None), str):
+        return content.text
+    return ''
+
+def get_last_assistant_text(msg_history):
+    """Return the text of the last assistant message in msg_history (or '')."""
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict):
+            if msg.get('role') != 'assistant' and msg.get('type') != 'message':
+                continue
+            text = _extract_text(msg.get('content'))
+        else:
+            # Raw SDK response object (e.g. OpenAI Responses API) from the last turn
+            text = getattr(msg, 'output_text', None)
+            if not isinstance(text, str):
+                text = ''
+                for item in getattr(msg, 'output', None) or []:
+                    text += _extract_text(getattr(item, 'content', None))
+        if text:
+            return text
+    return ''
+
+def parse_verdict(text):
+    """Return True/False from the last line starting with a verdict marker, or None if absent."""
+    verdict = None
+    for line in text.splitlines():
+        line = line.strip().strip('*`').strip()
+        if line.startswith(PASS_MARKER):
+            verdict = True
+        elif line.startswith(FAIL_MARKER):
+            verdict = False
+    return verdict
+
