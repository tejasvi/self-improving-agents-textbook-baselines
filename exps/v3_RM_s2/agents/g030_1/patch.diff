+    def verify_examples(self):
+        """
+        Ask the agent to run the examples from the problem statement against the current
+        solution and report a verdict. Returns True if the examples pass.
+        """
+        verify_instruction = f"""Verify the current solution in {self.git_tempdir} against the examples in the problem statement below.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+1. Extract every example (input and expected output) from the problem statement.
+2. Run the solution on each example input exactly as the problem specifies (standard input for a program, or call the method of the given Solution class) and compare with the expected output.
+3. Do NOT modify any files in this step; only run and inspect.
+4. Finish your reply with exactly one of these lines:
+{PASS_MARKER}   (if every example matches)
+{FAIL_MARKER}   (if any example does not match, followed by a short description of the mismatch)"""
+        history = self._chat_with_retry(verify_instruction, [])
+        return parse_verdict(get_last_assistant_text(history)) is True
+
+    def run_attempts(self, max_attempts=MAX_ATTEMPTS):
+        """
+        Run the agent up to max_attempts times. Each attempt starts from the base commit.
+        The first attempt whose solution passes the problem examples is kept; if none pass,
+        the last attempt is kept. Returns the kept diff.
+        """
+        chosen_patch = None
+        for attempt in range(1, max_attempts + 1):
+            safe_log(f"=== Attempt {attempt}/{max_attempts} ===")
+            reset_to_commit(self.git_tempdir, self.base_commit)
+            try:
+                self.forward()
+            except Exception as e:
+                safe_log(f"Attempt {attempt} failed after retry: {e!r}.")
+            patch = diff_versus_commit(self.git_tempdir, self.base_commit)
+            chosen_patch = patch
+            try:
+                passed = self.verify_examples()
+            except Exception as e:
+                safe_log(f"Example verification failed with exception: {e!r}.")
+                passed = False
+            safe_log(f"Attempt {attempt} examples passed: {passed}")
+            if passed:
+                break
+
+        # Restore the chosen attempt's working tree
+        reset_to_commit(self.git_tempdir, self.base_commit)
+        if chosen_patch:
+            apply_patch(self.git_tempdir, chosen_patch)
+        return chosen_patch or ''
 
