+    def _repo_has_changes(self):
+        """
+        Return True if the repository differs from the base commit (tracked or untracked files).
+        """
+        repo = os.path.abspath(self.git_tempdir)
+        chat_log = os.path.abspath(self.chat_history_file)
+        changed = subprocess.run(
+            ["git", "-C", repo, "diff", "--name-only", self.base_commit],
+            capture_output=True, text=True, check=False,
+        ).stdout.splitlines()
+        untracked = subprocess.run(
+            ["git", "-C", repo, "ls-files", "--others", "--exclude-standard"],
+            capture_output=True, text=True, check=False,
+        ).stdout.splitlines()
+        for rel in changed + untracked:
+            # The chat history log is written inside the repo; it is not a code change.
+            if os.path.abspath(os.path.join(repo, rel)) == chat_log:
+                continue
+            return True
+        return False
