+async def _read_capped(stream, max_bytes=MAX_OUTPUT_CHARS):
+    """Read a stream to EOF, keeping only the first and last max_bytes/2 bytes.
+
+    Memory stays bounded no matter how much the process writes.
+    """
+    half = max_bytes // 2
+    head = bytearray()
+    tail = bytearray()
+    omitted = 0
+    while True:
+        chunk = await stream.read(READ_CHUNK)
+        if not chunk:  # EOF
+            break
+        if len(head) < half:
+            take = half - len(head)
+            head += chunk[:take]
+            chunk = chunk[take:]
+        if chunk:
+            tail += chunk
+            if len(tail) > half:
+                omitted += len(tail) - half
+                del tail[:len(tail) - half]
+    text = head.decode(errors="replace")
+    if omitted:
+        text += f"\n... [{omitted} bytes truncated] ...\n"
+    return text + tail.decode(errors="replace")
