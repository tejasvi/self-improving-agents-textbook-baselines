diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..c0363db
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,73 @@
+"""
+Shared retry helper for LLM API calls.
+
+Retries only transient failures (rate limits, timeouts, connection errors,
+5xx / 408 / 409 / 429 status codes) with exponential backoff. Non-transient
+errors (bad requests, auth errors, unsupported models, ...) are raised
+immediately.
+"""
+import random
+import time
+
+import anthropic
+import openai
+
+DEFAULT_MAX_RETRIES = 5
+DEFAULT_BASE_DELAY = 1.0
+DEFAULT_MAX_DELAY = 60.0
+
+_TRANSIENT_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+_TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+
+
+def is_transient_error(exc):
+    """Return True if the exception looks like a transient API failure."""
+    if isinstance(exc, _TRANSIENT_ERRORS):
+        return True
+    status = getattr(exc, "status_code", None)
+    if status is not None and status in _TRANSIENT_STATUS_CODES:
+        return True
+    return False
+
+
+def compute_backoff(attempt, base_delay=DEFAULT_BASE_DELAY, max_delay=DEFAULT_MAX_DELAY):
+    """Exponential backoff with jitter for the given 0-based attempt index."""
+    delay = min(max_delay, base_delay * (2 ** attempt))
+    return delay * (0.5 + random.random() * 0.5)
+
+
+def call_with_retry(
+    fn,
+    *args,
+    max_retries=DEFAULT_MAX_RETRIES,
+    base_delay=DEFAULT_BASE_DELAY,
+    max_delay=DEFAULT_MAX_DELAY,
+    logging=None,
+    **kwargs,
+):
+    """
+    Call `fn(*args, **kwargs)`, retrying transient failures up to `max_retries`
+    times with exponential backoff. The final exception is re-raised.
+    """
+    log = logging if logging is not None else print
+    last_exc = None
+    for attempt in range(max(0, max_retries) + 1):
+        try:
+            return fn(*args, **kwargs)
+        except Exception as e:
+            last_exc = e
+            if attempt >= max(0, max_retries) or not is_transient_error(e):
+                raise
+            delay = compute_backoff(attempt, base_delay, max_delay)
+            log(f"Transient API error ({e!r}); retry {attempt + 1}/{max_retries} in {delay:.1f}s.")
+            time.sleep(delay)
+    raise last_exc  # pragma: no cover - loop always returns or raises
