+# Errors that are worth retrying: rate limits, timeouts, connection problems and 5xx server errors.
+# Other errors (bad requests, auth failures, context overflows, ...) are raised immediately.
+TRANSIENT_API_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
 )
+
+API_MAX_RETRIES = 5
+API_BASE_DELAY = 2.0   # seconds
+API_MAX_DELAY = 60.0   # seconds
+
+def _backoff_delay(attempt):
+    """Exponential backoff with jitter for the given 0-based retry attempt."""
+    delay = min(API_MAX_DELAY, API_BASE_DELAY * (2 ** attempt))
+    return delay * random.uniform(0.5, 1.0)
+
+def _call_model_api(client, model, messages, tools, tool_choice):
+    if 'claude' in model:
+        return client.messages.create(
+            model=model,
+            messages=messages,
+            max_tokens=4096,
+            tool_choice=tool_choice,
+            tools=tools,
+        )
+    elif model.startswith('o3-'):
+        return client.responses.create(
+            model=model,
+            input=messages,
+            tool_choice=tool_choice,
+            tools=tools,
+            parallel_tool_calls=False
+        )
+    raise ValueError(f"Unsupported model: {model}")
+
