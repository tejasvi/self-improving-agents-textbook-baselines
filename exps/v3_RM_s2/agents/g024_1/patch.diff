+    def _read_output(self, out) -> str:
+        """Read at most max_output_chars characters from the captured output file.
+
+        Reads a bounded number of bytes (UTF-8 chars are at most 4 bytes), plus
+        one byte to detect that more output exists. Clips and marks if needed.
+        """
+        out.seek(0)
+        max_bytes = self._max_output_chars * MAX_UTF8_BYTES_PER_CHAR
+        raw = out.read(max_bytes + 1)
+        clipped = len(raw) > max_bytes
+        text = raw[:max_bytes].decode("utf-8", errors="replace")
+        if len(text) > self._max_output_chars:
+            text = text[: self._max_output_chars]
+            clipped = True
+        if clipped:
+            text += CLIP_MARKER
+        return text
