index 0000000..320acf3
--- /dev/null
+++ b/tests/test_bash_noninteractive.py
@@ -0,0 +1,53 @@
+import time
+from tools.bash import tool_function, BashSession
+
+
+def test_stdin_is_closed():
+    """A command that reads stdin gets EOF instead of hanging."""
+    result = tool_function("cat")
+    assert result == "(no output)"
+
+
+def test_timeout_kills_command():
+    """A command exceeding the timeout is killed and reported promptly."""
+    start = time.time()
+    result = BashSession(timeout=1).run("sleep 30")
+    assert time.time() - start < 10
+    assert "timed out" in result
+
+
+def test_timeout_kills_background_children():
+    """Children in the same process group are killed on timeout too."""
+    start = time.time()
+    result = BashSession(timeout=1).run("sleep 30 & sleep 30")
+    assert time.time() - start < 10
+    assert "timed out" in result
+
+
+def test_nonzero_exit_reports_code():
+    result = tool_function("echo hi; exit 3")
+    assert result.startswith("Error: exit code 3")
+    assert "hi" in result
+
+
+def test_large_output_is_truncated():
+    result = BashSession(max_output_chars=100).run("python3 -c \"print('x' * 5000)\"")
+    assert len(result) < 200
+    assert "<response clipped>" in result
+
+
+def test_output_within_limit_not_marked():
+    result = BashSession(max_output_chars=100).run("python3 -c \"print('x' * 50)\"")
+    assert "<response clipped>" not in result
+
+
+def test_multibyte_output_at_byte_cap_is_marked():
+    """Exactly max_chars 4-byte characters followed by more output must still be marked."""
+    cmd = "python3 -c \"import sys; sys.stdout.write('\\U0001F600' * 101)\""
+    result = BashSession(max_output_chars=100).run(cmd)
+    assert "<response clipped>" in result
+    assert result.count("\U0001F600") == 100
+
+
+def test_empty_output_placeholder():
+    assert tool_function("true") == "(no output)"
