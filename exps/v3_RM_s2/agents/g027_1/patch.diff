+
+
+def compact_openai_messages(messages, keep_recent=6, max_chars=2000):
+    """
+    OpenAI-style counterpart of compact_claude_messages. Truncates the output of
+    `function_call_output` items (and string `content` of plain dict messages) that are
+    older than the last `keep_recent` items. The user's task message is never truncated.
+    Non-dict items (e.g. SDK response objects) are kept as-is. The input is not modified.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for idx, item in enumerate(messages):
+        if idx >= cutoff or not isinstance(item, dict):
+            compacted.append(item)
+        elif item.get("type") == "function_call_output":
+            compacted.append({**item, "output": truncate_text(item.get("output"), max_chars)})
+        elif item.get("role") == "assistant" and isinstance(item.get("content"), str):
+            compacted.append({**item, "content": truncate_text(item["content"], max_chars)})
+        else:
+            compacted.append(item)
+    return compacted
