diff --git a/tools/run_solution_tests.py b/tools/run_solution_tests.py
new file mode 100644
index 0000000..e035c91
--- /dev/null
+++ b/tools/run_solution_tests.py
@@ -0,0 +1,128 @@
+import os
+import subprocess
+import sys
+
+MAX_DETAIL_LENGTH = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_solution_tests",
+        "description": """Run a Python solution program on given test inputs and compare its standard output with the expected outputs.\n
+* The solution file is executed as a standalone program: each test's `input` is fed to its standard input, and its standard output is captured.\n
+* A test passes if the actual stdout matches `expected_output` after ignoring leading/trailing whitespace on the whole output and trailing whitespace on each line.\n
+* For every test, the tool reports PASS or FAIL. For failures it shows the input, the expected output, the actual output, stderr, and the exit code or timeout reason.\n
+* Use this tool to check the examples from the problem statement and your own small and large test cases after writing or changing the solution.\n
+* Each test run is limited by `timeout_seconds` (default 10 seconds per test).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to execute, e.g. `/repo/solution.py`."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with the stdin `input` and the `expected_output` to compare against.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text to feed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should write to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Optional time limit in seconds for each individual test run. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text):
+    """Normalize output for comparison: strip trailing whitespace per line and surrounding blank lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    return "\n".join(lines).strip()
+
+
+def _truncate(text, limit=MAX_DETAIL_LENGTH):
+    if len(text) > limit:
+        return text[:limit] + "\n<response clipped>"
+    return text
+
+
+def _run_one(solution_path, cwd, test_input, timeout):
+    """Run the solution once. Returns (stdout, stderr, reason); reason is None on a clean exit."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, f"timed out after {timeout} seconds"
+    if proc.returncode != 0:
+        return proc.stdout, proc.stderr, f"exited with code {proc.returncode}"
+    return proc.stdout, proc.stderr, None
+
+
+def tool_function(solution_path, test_cases, timeout_seconds=10):
+    if not isinstance(solution_path, str) or not os.path.isfile(solution_path):
+        return f"Error: solution file '{solution_path}' does not exist."
+    if not solution_path.endswith(".py"):
+        return f"Error: solution file '{solution_path}' is not a Python (.py) file."
+    if not isinstance(test_cases, list) or len(test_cases) == 0:
+        return "Error: 'test_cases' must be a non-empty list of objects with 'input' and 'expected_output'."
+    try:
+        timeout = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Error: invalid timeout_seconds '{timeout_seconds}'."
+    if timeout <= 0:
+        return "Error: timeout_seconds must be positive."
+
+    solution_path = os.path.abspath(solution_path)
+    cwd = os.path.dirname(solution_path)
+
+    passed = 0
+    report = []
+    for idx, case in enumerate(test_cases, start=1):
+        if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+            report.append(f"Test {idx}: FAIL (malformed test case, must have 'input' and 'expected_output')")
+            continue
+        test_input = str(case["input"])
+        expected = str(case["expected_output"])
+
+        stdout, stderr, reason = _run_one(solution_path, cwd, test_input, timeout)
+        if reason is None and _normalize(stdout) == _normalize(expected):
+            passed += 1
+            report.append(f"Test {idx}: PASS")
+            continue
+
+        if reason is None:
+            reason = "output mismatch"
+        report.append(
+            f"Test {idx}: FAIL ({reason})\n"
+            f"--- input ---\n{_truncate(test_input)}\n"
+            f"--- expected output ---\n{_truncate(expected)}\n"
+            f"--- actual output ---\n{_truncate(stdout)}\n"
+            f"--- stderr ---\n{_truncate(stderr)}"
+        )
+
+    total = len(test_cases)
+    summary = f"Result: {passed}/{total} tests passed."
+    return summary + "\n\n" + "\n\n".join(report)
