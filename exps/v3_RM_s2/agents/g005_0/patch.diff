+# Context compaction: tool results older than the most recent KEEP_RECENT_TOOL_RESULTS
+# are shortened to OLD_TOOL_RESULT_CHARS (head and tail kept) before being sent to the model.
+KEEP_RECENT_TOOL_RESULTS = 4
+OLD_TOOL_RESULT_CHARS = 2000
+
+def _truncate_text(text, limit):
+    if not isinstance(text, str) or len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n... [{omitted} characters truncated to save context] ...\n{text[-half:]}"
+
+def _is_tool_result_msg(msg):
+    """Returns True if msg is a tool result in either Claude or OpenAI format."""
+    if not isinstance(msg, dict):
+        return False
+    if msg.get('type') == 'function_call_output':
+        return True
+    content = msg.get('content')
+    return isinstance(content, list) and any(
+        isinstance(b, dict) and b.get('type') == 'tool_result' for b in content
+    )
+
+def compact_messages(messages, keep_recent=None, old_limit=None):
+    """
+    Return a copy of messages where old tool results are truncated to save context.
+    The original message list and its dicts are not modified.
+    """
+    keep_recent = KEEP_RECENT_TOOL_RESULTS if keep_recent is None else keep_recent
+    old_limit = OLD_TOOL_RESULT_CHARS if old_limit is None else old_limit
+    result_idx = [i for i, m in enumerate(messages) if _is_tool_result_msg(m)]
+    old_idx = set(result_idx[:-keep_recent]) if keep_recent > 0 else set(result_idx)
+
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i not in old_idx:
+            compacted.append(msg)
+        elif msg.get('type') == 'function_call_output':
+            compacted.append({**msg, 'output': _truncate_text(msg.get('output'), old_limit)})
+        else:
+            new_blocks = []
+            for b in msg['content']:
+                if isinstance(b, dict) and b.get('type') == 'tool_result':
+                    b = {**b, 'content': _truncate_text(b.get('content'), old_limit)}
+                new_blocks.append(b)
+            compacted.append({**msg, 'content': new_blocks})
+    return compacted
+
