+++ b/tools/run_io_tests.py
@@ -0,0 +1,100 @@
+import subprocess
+import sys
+
+MAX_OUTPUT_CHARS = 2000
+TIMEOUT_SECONDS = 10.0
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python program on given standard-input test cases and compare its standard output with the expected output.\n
+* Each test case is run as `python3 <program_path>` with the case's `input` fed to stdin.\n
+* The actual stdout is compared with `expected_output`. Trailing whitespace on each line and leading/trailing blank lines are ignored.\n
+* For each case the tool reports PASS or FAIL. For failures it shows the actual stdout, stderr, and the exit code (or a timeout notice).\n
+* Use this tool to check a solution against the sample tests from the problem statement and your own additional cases.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {
+                    "type": "string",
+                    "description": "Path to the Python program to test (a file that reads stdin and writes stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with 'input' and 'expected_output' strings.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text to feed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should print to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                }
+            },
+            "required": ["program_path", "test_cases"]
+        }
+    }
+
+def _normalize(text: str) -> str:
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    return "\n".join(lines).strip("\n")
+
+def _truncate(text: str) -> str:
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+def _run_case(program_path: str, case_input: str, expected_output: str) -> tuple:
+    """Returns (passed, details_string)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, program_path],
+            input=case_input,
+            capture_output=True,
+            text=True,
+            timeout=TIMEOUT_SECONDS,
+        )
+    except subprocess.TimeoutExpired:
+        return False, f"Timed out after {TIMEOUT_SECONDS} seconds."
+
+    actual = _normalize(proc.stdout)
+    expected = _normalize(expected_output)
+    if proc.returncode == 0 and actual == expected:
+        return True, ""
+
+    details = [f"Exit code: {proc.returncode}"]
+    details.append(f"Actual stdout:\n{_truncate(proc.stdout)}")
+    details.append(f"Expected stdout:\n{_truncate(expected_output)}")
+    if proc.stderr:
+        details.append(f"Stderr:\n{_truncate(proc.stderr)}")
+    return False, "\n".join(details)
+
+def tool_function(program_path: str, test_cases: list) -> str:
+    """Run program_path on each test case and compare stdout with expected_output."""
+    try:
+        if not test_cases:
+            return "Error: No test cases provided."
+        results = []
+        passed_count = 0
+        for idx, case in enumerate(test_cases, start=1):
+            case_input = str(case.get("input") or "")
+            expected_output = str(case.get("expected_output") or "")
+            passed, details = _run_case(program_path, case_input, expected_output)
+            if passed:
+                passed_count += 1
+                results.append(f"Test {idx}: PASS")
+            else:
+                results.append(
+                    f"Test {idx}: FAIL\nInput:\n{_truncate(case_input)}\n{details}"
+                )
+        summary = f"{passed_count}/{len(test_cases)} test cases passed."
+        return summary + "\n\n" + "\n\n".join(results)
+    except Exception as e:
+        return f"Error: {str(e)}"
