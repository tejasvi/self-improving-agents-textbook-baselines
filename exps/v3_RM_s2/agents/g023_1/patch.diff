diff --git a/utils/common_utils.py b/utils/common_utils.py
index f0bc3aa..839f552 100644
--- a/utils/common_utils.py
+++ b/utils/common_utils.py
@@ -15,3 +15,44 @@ def load_json_file(file_path):
     """
     with open(file_path, 'r') as file:
         return json.load(file)
+
+
+CLIP_MARKER = "\n<response clipped>"
+
+def truncate_text(text, max_chars=10000):
+    """
+    Shorten long text to at most ~max_chars characters, keeping the head and the tail
+    (the tail often holds the most relevant part, e.g. error messages).
+    Non-string input is returned unchanged.
+    """
+    if not isinstance(text, str) or max_chars is None or len(text) <= max_chars:
+        return text
+    head = max_chars // 2
+    tail = max_chars - head
+    omitted = len(text) - head - tail
+    return f"{text[:head]}\n<... {omitted} characters omitted ...>\n{text[len(text) - tail:]}{CLIP_MARKER}"
+
+def compact_claude_messages(messages, keep_recent=6, max_chars=2000):
+    """
+    Return a copy of a Claude-style message list in which tool results and text blocks
+    older than the last `keep_recent` messages are truncated to `max_chars`.
+    User text blocks are kept intact, since they contain the task description.
+    The input list and its messages are not modified.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for idx, msg in enumerate(messages):
+        content = msg.get("content")
+        if idx >= cutoff or not isinstance(content, list):
+            compacted.append(msg)
+            continue
+        new_blocks = []
+        for block in content:
+            if isinstance(block, dict) and block.get("type") == "tool_result":
+                block = {**block, "content": truncate_text(block.get("content"), max_chars)}
+            elif isinstance(block, dict) and block.get("type") == "text" and msg.get("role") == "assistant":
+                # User text is never truncated: it carries the task / problem statement.
+                block = {**block, "text": truncate_text(block.get("text"), max_chars)}
+            new_blocks.append(block)
+        compacted.append({**msg, "content": new_blocks})
+    return compacted
