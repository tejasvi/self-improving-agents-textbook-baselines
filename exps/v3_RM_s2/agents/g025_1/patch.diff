+MAX_ATTEMPTS = 3
+EXAMPLE_TIMEOUT_SECONDS = 10
+
+
+def parse_examples(problem_statement):
+    """Extract (input, expected_output) pairs from 'Input:'/'Output:' blocks in the problem statement."""
+    pattern = re.compile(r"Input:?\s*\n(.*?)\n\s*Output:?\s*\n(.*?)(?=\n\s*Input:|\Z)", re.DOTALL)
+    examples = []
+    for m in pattern.finditer(problem_statement):
+        inp = m.group(1).strip("\n") + "\n"
+        out = m.group(2).strip()
+        if out:
+            examples.append((inp, out))
+    return examples
+
+
+def score_attempt(git_dir, problem_statement):
+    """Run every modified or new .py file in git_dir against the examples. Returns (passed, total)."""
+    examples = parse_examples(problem_statement)
+    if not examples:
+        return 0, 0
+    listing = subprocess.run(
+        ["git", "-C", git_dir, "ls-files", "-m", "-o", "--exclude-standard", "--", "*.py"],
+        capture_output=True, text=True, check=False,
+    )
+    files = [f for f in listing.stdout.split() if f]
+    if not files:
+        return 0, len(examples)
+    best = 0
+    for fname in files:
+        passed = 0
+        for inp, expected in examples:
+            try:
+                res = subprocess.run(
+                    ["python3", fname], input=inp, capture_output=True, text=True,
+                    cwd=git_dir, timeout=EXAMPLE_TIMEOUT_SECONDS, check=False,
+                )
+                if res.stdout.strip() == expected:
+                    passed += 1
+            except subprocess.TimeoutExpired:
+                pass
+        best = max(best, passed)
+    return best, len(examples)
+
