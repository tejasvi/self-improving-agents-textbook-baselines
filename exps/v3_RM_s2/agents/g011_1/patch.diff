diff --git a/tests/test_truncate.py b/tests/test_truncate.py
new file mode 100644
index 0000000..7aab37f
--- /dev/null
+++ b/tests/test_truncate.py
@@ -0,0 +1,55 @@
+from utils.truncate import truncate_text, trim_old_tool_results
+
+
+def test_short_text_unchanged():
+    assert truncate_text("hi", 10) == "hi"
+    assert truncate_text("x" * 50, 0) == "x" * 50  # 0 disables truncation
+
+
+def test_long_text_capped_and_keeps_head_and_tail():
+    s = "a" * 5000 + "b" * 5000
+    out = truncate_text(s, 1000)
+    assert len(out) <= 1000
+    assert out.startswith("aaaa") and out.endswith("bbbb")
+    assert "truncated" in out
+
+
+def _history(n, size):
+    h = [{"role": "user", "content": [{"type": "text", "text": "task"}]}]
+    for i in range(n):
+        h.append({"role": "assistant", "content": [{"type": "tool_use", "id": str(i)}]})
+        h.append({"role": "user", "content": [
+            {"type": "tool_result", "tool_use_id": str(i), "content": "z" * size}]})
+    return h
+
+
+def test_trim_old_tool_results_keeps_recent_and_original_intact():
+    h = _history(6, 5000)
+    t = trim_old_tool_results(h, keep_recent=2, old_max_chars=100)
+    results = [m["content"][0]["content"] for m in t
+               if m["content"][0].get("type") == "tool_result"]
+    assert [len(r) for r in results] == [100, 100, 100, 100, 5000, 5000]
+    # original is not modified
+    assert all(len(m["content"][0]["content"]) == 5000 for m in h
+               if m["content"][0].get("type") == "tool_result")
+
+
+def test_trim_handles_non_dict_blocks():
+    class Block:  # stands in for SDK objects
+        type = "text"
+    h = _history(3, 500) + [{"role": "assistant", "content": [Block()]}]
+    trim_old_tool_results(h, keep_recent=1, old_max_chars=50)
+
+
+def test_truncate_never_exceeds_limit_even_when_small():
+    s = "x" * 100
+    for m in [1, 5, 20, 28, 29, 30, 40, 60, 99, 100, 101]:
+        assert len(truncate_text(s, m)) <= m
+
+
+def test_trim_leaves_non_string_tool_results_untouched():
+    content = [{"type": "text", "text": "a"}]
+    h = [{"role": "user", "content": [{"type": "tool_result", "tool_use_id": "1", "content": content}]}]
+    h += _history(3, 5000)[1:]
+    t = trim_old_tool_results(h, keep_recent=0, old_max_chars=10)
+    assert t[0]["content"][0]["content"] == content
diff --git a/utils/truncate.py b/utils/truncate.py
new file mode 100644
index 0000000..92b6597
--- /dev/null
+++ b/utils/truncate.py
@@ -0,0 +1,69 @@
+import copy
+
+# Limits for keeping the agent's context small.
+MAX_TOOL_OUTPUT_CHARS = 10000   # max chars kept from a single tool result
+KEEP_RECENT_TOOL_RESULTS = 4    # number of most recent tool results kept intact
+OLD_TOOL_RESULT_CHARS = 1000    # max chars kept from older tool results
+
+
+def _marker(omitted):
+    return f"\n...[truncated {omitted} chars]...\n"
+
+
+def truncate_text(text, max_chars):
+    """
+    Keep the head and tail of `text` so the result is at most `max_chars` long,
+    with a marker stating how many chars were dropped. Text that already fits is
+    returned unchanged. If `max_chars` is too small to fit the marker, the text is
+    hard-cut to `max_chars`. A non-positive or None `max_chars` disables truncation.
+    """
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None or max_chars <= 0 or len(text) <= max_chars:
+        return text
+
+    # Find head/tail sizes such that the marker's omitted count matches what is dropped.
+    # The marker length depends only on the digits of the count, so this converges quickly.
+    omitted = len(text)
+    for _ in range(10):
+        marker = _marker(omitted)
+        keep = max_chars - len(marker)
+        if keep < 0:
+            # Marker does not fit within the budget; fall back to a plain cut.
+            return text[:max_chars]
+        head = keep // 2
+        tail = keep - head
+        new_omitted = len(text) - head - tail
+        if new_omitted == omitted:
+            break
+        omitted = new_omitted
+    else:
+        return text[:max_chars]
+
+    tail_part = text[len(text) - tail:] if tail > 0 else ""
+    return text[:head] + marker + tail_part
+
+
+def trim_old_tool_results(msg_history, keep_recent=KEEP_RECENT_TOOL_RESULTS,
+                          old_max_chars=OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of a Claude-style message history in which every string-valued
+    tool_result block except the `keep_recent` most recent ones is truncated to
+    `old_max_chars`. Non-string tool_result contents are left untouched.
+    The original history is not modified.
+    """
+    trimmed = copy.deepcopy(msg_history)
+    positions = []
+    for m_idx, msg in enumerate(trimmed):
+        content = msg.get('content')
+        if not isinstance(content, list):
+            continue
+        for b_idx, block in enumerate(content):
+            if isinstance(block, dict) and block.get('type') == 'tool_result':
+                positions.append((m_idx, b_idx))
+    cutoff = max(len(positions) - keep_recent, 0)
+    for m_idx, b_idx in positions[:cutoff]:
+        block = trimmed[m_idx]['content'][b_idx]
+        if isinstance(block.get('content'), str):
+            block['content'] = truncate_text(block['content'], old_max_chars)
+    return trimmed
