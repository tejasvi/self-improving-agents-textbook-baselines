+def _message_parts(msg):
+    """Return (role, content) for a dict or object message."""
+    if isinstance(msg, dict):
+        return msg.get('role'), msg.get('content')
+    return getattr(msg, 'role', None), getattr(msg, 'content', None)
+
+def _block_fields(block):
+    """Return (type, text-like payload) for a dict or object content block."""
+    if isinstance(block, dict):
+        return block.get('type'), block.get('text'), block.get('content')
+    return getattr(block, 'type', None), getattr(block, 'text', None), getattr(block, 'content', None)
+
+def _tail(text, max_chars):
+    text = str(text)
+    if len(text) <= max_chars:
+        return text
+    return "...[truncated]...\n" + text[-max_chars:]
+
+def summarize_attempt(msg_history, max_chars=4000, max_tool_results=20):
+    """
+    Build a compact text record of one finished attempt: the last assistant text
+    and the (tail-truncated) tool results, such as test runs and error output.
+    Never raises on unexpected message shapes; malformed entries are skipped.
+    The result is bounded in size (roughly max_chars for tool results plus the final text).
+    """
+    try:
+        history = list(msg_history or [])
+    except TypeError:
+        return ""
+
+    tool_results = []
+    for msg in history:
+        try:
+            role, content = _message_parts(msg)
+        except Exception:
+            continue
+        if role != 'user' or content is None:
+            continue
+        if isinstance(content, str):
+            # Text-only tool loop (e.g. OpenAI path) stores results as "Tool Used: ..." messages.
+            if content.startswith('Tool Used:'):
+                tool_results.append(content)
+            continue
+        try:
+            blocks = list(content)
+        except TypeError:
+            continue
+        for block in blocks:
+            try:
+                btype, _, result = _block_fields(block)
+            except Exception:
+                continue
+            if btype == 'tool_result' and result is not None:
+                tool_results.append(str(result))
+
+    per_result_chars = max(200, max_chars // max(1, min(len(tool_results), max_tool_results)))
+    kept = tool_results[-max_tool_results:]
+    parts = []
+    for i, result in enumerate(kept, 1):
+        parts.append(f"[tool result {i}]\n{_tail(result, per_result_chars)}")
+
+    final_text = extract_last_assistant_text(history)
+    parts.append(f"[final message of attempt]\n{_tail(final_text, max_chars)}" if final_text else "[final message of attempt]\n(none)")
+    return "\n\n".join(parts)
+
+def build_retry_context(attempt_summaries):
+    """
+    Format the records of earlier failed attempts as a retry-context section.
+    Returns an empty string when there are no earlier attempts.
+    """
+    if not attempt_summaries:
+        return ""
+    sections = []
+    for number, (changed, summary) in enumerate(attempt_summaries, 1):
+        status = "made file changes" if changed else "made NO file changes"
+        sections.append(f"## Earlier attempt {number} ({status})\n{summary}")
+    return (
+        "Context from earlier attempts at this task (most recent last). Their file edits may still be in the repository. "
+        "Use these records (including the test outputs) to avoid repeating the same mistakes, and continue from the current state of the files:\n\n"
+        + "\n\n".join(sections)
+    )
+
