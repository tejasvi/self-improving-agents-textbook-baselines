@@ -0,0 +1,94 @@
+import anthropic
+import openai
+import httpx
+import pytest
+
+from llm import call_with_retries, is_transient_api_error
+from llm_withtools import get_response_withtools
+
+
+def _anthropic_status_error(status):
+    req = httpx.Request("POST", "https://api.anthropic.com/v1/messages")
+    resp = httpx.Response(status, request=req)
+    return anthropic.APIStatusError("boom", response=resp, body=None)
+
+
+def test_transient_classification():
+    assert is_transient_api_error(anthropic.RateLimitError(
+        "x", response=httpx.Response(429, request=httpx.Request("POST", "https://x")), body=None))
+    assert is_transient_api_error(_anthropic_status_error(529))
+    assert is_transient_api_error(_anthropic_status_error(503))
+    assert not is_transient_api_error(_anthropic_status_error(400))
+    assert not is_transient_api_error(_anthropic_status_error(401))
+    assert not is_transient_api_error(ValueError("nope"))
+
+
+def test_retries_transient_then_succeeds():
+    calls = {"n": 0}
+    sleeps = []
+
+    def fn():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise _anthropic_status_error(529)
+        return "ok"
+
+    out = call_with_retries(fn, max_retries=5, logging=lambda *_: None, sleep=sleeps.append)
+    assert out == "ok"
+    assert calls["n"] == 3
+    assert len(sleeps) == 2
+    assert all(0 < s <= 60 for s in sleeps)
+
+
+def test_non_transient_raises_immediately():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        raise _anthropic_status_error(400)
+
+    with pytest.raises(anthropic.APIStatusError):
+        call_with_retries(fn, max_retries=5, logging=lambda *_: None, sleep=lambda s: None)
+    assert calls["n"] == 1
+
+
+def test_gives_up_after_max_retries():
+    calls = {"n": 0}
+
+    def fn():
+        calls["n"] += 1
+        raise openai.APITimeoutError(request=httpx.Request("POST", "https://x"))
+
+    with pytest.raises(openai.APITimeoutError):
+        call_with_retries(fn, max_retries=3, logging=lambda *_: None, sleep=lambda s: None)
+    assert calls["n"] == 4
+
+
+class _FakeClaude:
+    def __init__(self, errors):
+        self.errors = list(errors)
+        self.calls = 0
+        self.messages = self
+
+    def create(self, **kwargs):
+        self.calls += 1
+        if self.errors:
+            raise self.errors.pop(0)
+        return "response"
+
+
+def test_get_response_withtools_retries(monkeypatch):
+    monkeypatch.setattr("llm.time.sleep", lambda s: None)
+    client = _FakeClaude([_anthropic_status_error(429), _anthropic_status_error(500)])
+    out = get_response_withtools(client, "claude-3-5-sonnet-20241022", [], [], {"type": "auto"},
+                                 logging=lambda *_: None)
+    assert out == "response"
+    assert client.calls == 3
+
+
+def test_get_response_withtools_bad_request_not_retried():
+    client = _FakeClaude([_anthropic_status_error(400)])
+    with pytest.raises(anthropic.APIStatusError):
+        get_response_withtools(client, "claude-3-5-sonnet-20241022", [], [], {"type": "auto"},
+                               logging=lambda *_: None)
+    assert client.calls == 1
