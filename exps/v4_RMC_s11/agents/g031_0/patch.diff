+++ b/tools/run_tests.py
@@ -0,0 +1,122 @@
+import os
+import subprocess
+import sys
+import time
+
+MAX_OUTPUT_CHARS = 2000
+DEFAULT_TIMEOUT = 10.0
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python program on given test inputs and compare its outputs with the expected outputs.\n
+* The program at `solution_path` is executed with `python` once per test case, with the test case's `input` written to its standard input.\n
+* The actual stdout is compared with `expected_output` token by token (whitespace and line breaks are ignored), so formatting differences do not count as failures.\n
+* Returns a report listing each test case as PASS or FAIL. For failures it shows the input, expected output, actual output, and any stderr or error (e.g. runtime error or timeout).\n
+* Use it to check a solution against the sample tests from the problem statement and your own additional tests (including edge cases and small random cases).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python program (.py file) to test. The program must read from standard input and write to standard output."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run. Each item is an object with an 'input' string (fed to stdin) and an 'expected_output' string.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact text to write to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The expected standard output for this input."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional time limit in seconds for each test case. Defaults to 10 seconds."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+def _truncate(text: str) -> str:
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+def _run_case(solution_path: str, test_input: str, timeout: float):
+    """Run the program on one input. Returns (stdout, stderr, error_message, elapsed_seconds)."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "", "", f"Time limit exceeded (>{timeout}s)", time.time() - start
+    except Exception as e:
+        return "", "", f"Failed to execute program: {e}", time.time() - start
+    elapsed = time.time() - start
+    error = None
+    if proc.returncode != 0:
+        error = f"Runtime error (exit code {proc.returncode})"
+    return proc.stdout, proc.stderr, error, elapsed
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = None) -> str:
+    """Run the solution on each test case and compare its output with the expected output."""
+    try:
+        if timeout is None:
+            timeout = DEFAULT_TIMEOUT
+        timeout = float(timeout)
+        if timeout <= 0:
+            return "Error: timeout must be positive."
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: test_cases must be a non-empty list."
+        for i, case in enumerate(test_cases):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                return f"Error: test case {i + 1} must be an object with 'input' and 'expected_output'."
+
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file {solution_path} does not exist."
+
+        passed = 0
+        reports = []
+        for i, case in enumerate(test_cases):
+            test_input = str(case["input"])
+            expected = str(case["expected_output"])
+            stdout, stderr, error, elapsed = _run_case(solution_path, test_input, timeout)
+            ok = error is None and stdout.split() == expected.split()
+            if ok:
+                passed += 1
+                reports.append(f"Test case {i + 1}: PASS ({elapsed:.2f}s)")
+                continue
+            lines = [f"Test case {i + 1}: FAIL ({elapsed:.2f}s)"]
+            if error:
+                lines.append(f"Error: {error}")
+            lines.append(f"Input:\n{_truncate(test_input)}")
+            lines.append(f"Expected output:\n{_truncate(expected)}")
+            lines.append(f"Actual output:\n{_truncate(stdout)}")
+            if stderr:
+                lines.append(f"Stderr:\n{_truncate(stderr)}")
+            reports.append("\n".join(lines))
+
+        total = len(test_cases)
+        summary = f"Summary: {passed}/{total} test cases passed."
+        return "\n\n".join(reports) + "\n\n" + summary
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+if __name__ == "__main__":
+    print(tool_function("/bin/echo", [{"input": "", "expected_output": ""}]))
