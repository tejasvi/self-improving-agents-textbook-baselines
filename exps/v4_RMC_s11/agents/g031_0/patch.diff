@@ -0,0 +1,54 @@
+import os
+from tools.run_tests import tool_function, tool_info
+
+ADD_PROG = "import sys\na, b = map(int, sys.stdin.read().split())\nprint(a + b)\n"
+
+def _write(tmp_path, code):
+    p = tmp_path / "sol.py"
+    p.write_text(code)
+    return str(p)
+
+def test_info_schema():
+    info = tool_info()
+    assert info["name"] == "run_tests"
+    schema = info["input_schema"]
+    assert set(schema["required"]) == {"solution_path", "test_cases"}
+    assert schema["properties"]["test_cases"]["items"]["required"] == ["input", "expected_output"]
+
+def test_all_pass(tmp_path):
+    path = _write(tmp_path, ADD_PROG)
+    cases = [{"input": "1 2\n", "expected_output": "3\n"}, {"input": "5 5", "expected_output": "10"}]
+    result = tool_function(path, cases)
+    assert "2/2" in result
+    assert "FAIL" not in result
+
+def test_mismatch_reported(tmp_path):
+    path = _write(tmp_path, ADD_PROG)
+    result = tool_function(path, [{"input": "1 2", "expected_output": "4"}])
+    assert "FAIL" in result
+    assert "Expected output" in result and "Actual output" in result
+    assert "0/1" in result
+
+def test_whitespace_insensitive(tmp_path):
+    path = _write(tmp_path, "print('1  2\\n3')\n")
+    result = tool_function(path, [{"input": "", "expected_output": "1 2 3"}])
+    assert "1/1" in result
+
+def test_runtime_error(tmp_path):
+    path = _write(tmp_path, "raise ValueError('boom')\n")
+    result = tool_function(path, [{"input": "", "expected_output": "x"}])
+    assert "Runtime error" in result and "boom" in result
+
+def test_timeout(tmp_path):
+    path = _write(tmp_path, "import time\ntime.sleep(5)\n")
+    result = tool_function(path, [{"input": "", "expected_output": ""}], timeout=0.5)
+    assert "Time limit exceeded" in result
+
+def test_missing_file(tmp_path):
+    result = tool_function(os.path.join(str(tmp_path), "nope.py"), [{"input": "", "expected_output": ""}])
+    assert result.startswith("Error")
+
+def test_invalid_cases(tmp_path):
+    path = _write(tmp_path, ADD_PROG)
+    assert tool_function(path, []).startswith("Error")
+    assert tool_function(path, [{"input": "1"}]).startswith("Error")
