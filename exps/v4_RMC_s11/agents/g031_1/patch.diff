diff --git a/utils/truncate.py b/utils/truncate.py
new file mode 100644
index 0000000..97ddb8f
--- /dev/null
+++ b/utils/truncate.py
@@ -0,0 +1,116 @@
+"""
+Helpers to keep the agent's context small by truncating long tool outputs and
+old conversation turns. Only string fields are rewritten; message structure
+(roles, block types, tool_use_id pairing) is always preserved.
+"""
+import copy
+import os
+import tempfile
+
+DEFAULT_MAX_CHARS = 8000
+DEFAULT_OLD_TURN_MAX_CHARS = 2000
+DEFAULT_KEEP_LAST_N = 6
+
+
+def truncate_text(text, max_chars=DEFAULT_MAX_CHARS, full_output_path=None):
+    """
+    Keep the head and tail of `text` so that the result is at most roughly
+    `max_chars` characters, inserting a marker that reports how many characters
+    were removed. Returns the text unchanged when it already fits.
+    """
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None or max_chars < 0 or len(text) <= max_chars:
+        return text
+
+    marker_template = "\n... [truncated {removed} characters{where}] ...\n"
+    where = f"; full output saved to {full_output_path}" if full_output_path else ""
+    # Reserve room for the marker itself (its length depends on the removed count,
+    # so compute with a generous upper bound).
+    reserve = len(marker_template.format(removed=len(text), where=where)) + 8
+    budget = max(max_chars - reserve, 0)
+    head_len = budget // 2
+    tail_len = budget - head_len
+    removed = len(text) - head_len - tail_len
+    marker = marker_template.format(removed=removed, where=where)
+    tail = text[len(text) - tail_len:] if tail_len > 0 else ""
+    return text[:head_len] + marker + tail
+
+
+def save_full_output(text, prefix="tool_output_"):
+    """
+    Write the full text to a temporary file and return its path, or None if the
+    write fails. Used so the agent can still reach the complete output.
+    """
+    try:
+        fd, path = tempfile.mkstemp(prefix=prefix, suffix=".txt")
+        with os.fdopen(fd, "w") as f:
+            f.write(text if isinstance(text, str) else str(text))
+        return path
+    except Exception:
+        return None
+
+
+def truncate_tool_result(text, max_chars=DEFAULT_MAX_CHARS):
+    """
+    Truncate a tool result, saving the complete output to a file first if it
+    is too long so the agent can still inspect it.
+    """
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    path = save_full_output(text)
+    return truncate_text(text, max_chars=max_chars, full_output_path=path)
+
+
+def _truncate_block_text(block, max_chars):
+    """Truncate string payloads of a dict content block in place (on a copy)."""
+    if not isinstance(block, dict):
+        # SDK objects are left untouched; they are not the bulk of the context.
+        return block
+    block = dict(block)
+    if block.get("type") == "text" and isinstance(block.get("text"), str):
+        block["text"] = truncate_text(block["text"], max_chars=max_chars)
+    elif block.get("type") == "tool_result":
+        content = block.get("content")
+        if isinstance(content, str):
+            block["content"] = truncate_text(content, max_chars=max_chars)
+        elif isinstance(content, list):
+            new_items = []
+            for item in content:
+                if isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str):
+                    item = dict(item)
+                    item["text"] = truncate_text(item["text"], max_chars=max_chars)
+                new_items.append(item)
+            block["content"] = new_items
+    return block
+
+
+def truncate_msg_history(
+    msg_history,
+    keep_last_n=DEFAULT_KEEP_LAST_N,
+    max_chars=DEFAULT_OLD_TURN_MAX_CHARS,
+):
+    """
+    Return a new message list where every message except the last `keep_last_n`
+    has its long string content truncated. Messages are never added or removed,
+    and tool_use / tool_result blocks keep their ids, so pairing is intact.
+    The input list is not modified.
+    """
+    if not msg_history:
+        return []
+    cutoff = max(len(msg_history) - max(keep_last_n, 0), 0)
+    result = []
+    for idx, msg in enumerate(msg_history):
+        if idx >= cutoff or not isinstance(msg, dict):
+            result.append(msg)
+            continue
+        new_msg = dict(msg)
+        content = msg.get("content")
+        if isinstance(content, str):
+            new_msg["content"] = truncate_text(content, max_chars=max_chars)
+        elif isinstance(content, list):
+            new_msg["content"] = [_truncate_block_text(b, max_chars) for b in content]
+        result.append(new_msg)
+    return copy.copy(result)
