@@ -0,0 +1,108 @@
+import subprocess
+import sys
+from pathlib import Path
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python solution file on given test inputs and compare its standard output with the expected outputs.\n
+* Each test case has an 'input' (fed to the program's standard input) and an 'expected_output'.\n
+* Outputs are compared token by token (whitespace-insensitive), so trailing spaces and newlines do not matter.\n
+* For every test case, the result reports PASS or FAIL, plus the actual output, stderr, or timeout information on failure.\n
+* The solution file must be an absolute path to a Python file that reads from standard input and writes to standard output.\n
+* Use this tool to check a solution against the problem's sample tests and your own edge-case and random tests.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to run, e.g. `/repo/solution.py`."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with 'input' and 'expected_output' strings.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Expected standard output of the program."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+MAX_REPORT_CHARS = 2000
+
+def _clip(text: str) -> str:
+    if len(text) > MAX_REPORT_CHARS:
+        return text[:MAX_REPORT_CHARS] + "\n<response clipped>"
+    return text
+
+def run_solution(solution_path: str, input_text: str, timeout: float):
+    """Run the solution once. Returns (stdout, stderr, returncode, timed_out)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text.encode(),
+            capture_output=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "", "", None, True
+    return (proc.stdout.decode(errors="replace"),
+            proc.stderr.decode(errors="replace"),
+            proc.returncode,
+            False)
+
+def outputs_match(actual: str, expected: str) -> bool:
+    """Compare outputs token by token, ignoring whitespace differences."""
+    return actual.split() == expected.split()
+
+def check_test_case(solution_path: str, index: int, case: dict, timeout: float) -> tuple:
+    """Run one test case. Returns (passed, report_text)."""
+    stdout, stderr, returncode, timed_out = run_solution(solution_path, case["input"], timeout)
+    if timed_out:
+        return False, f"Test {index}: FAIL (timed out after {timeout}s)"
+    if returncode != 0:
+        return False, f"Test {index}: FAIL (exit code {returncode})\nstderr:\n{_clip(stderr)}"
+    if outputs_match(stdout, case["expected_output"]):
+        return True, f"Test {index}: PASS"
+    return False, (f"Test {index}: FAIL (wrong output)\n"
+                   f"expected:\n{_clip(case['expected_output'])}\n"
+                   f"actual:\n{_clip(stdout)}")
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = 10) -> str:
+    path = Path(solution_path)
+    if not path.is_absolute():
+        return f"Error: solution_path must be an absolute path, got {solution_path}"
+    if not path.is_file():
+        return f"Error: solution file {solution_path} does not exist"
+    if not test_cases:
+        return "Error: no test cases provided"
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        return f"Error: invalid timeout {timeout}"
+
+    reports = []
+    passed = 0
+    for i, case in enumerate(test_cases, start=1):
+        ok, report = check_test_case(solution_path, i, case, timeout)
+        passed += ok
+        reports.append(report)
+    reports.append(f"Summary: {passed}/{len(test_cases)} tests passed")
+    return "\n".join(reports)
