+    def _snapshot_repo(self):
+        """Copy the working tree (excluding .git) to a temp dir and return its path."""
+        snap_dir = tempfile.mkdtemp(prefix="attempt_snapshot_")
+        for entry in os.listdir(self.git_tempdir):
+            if entry == ".git":
+                continue
+            src_path = os.path.join(self.git_tempdir, entry)
