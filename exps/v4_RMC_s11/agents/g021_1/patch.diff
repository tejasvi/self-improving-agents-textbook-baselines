+    @staticmethod
+    def _examples_passed(transcript):
+        """Return True if the last EXAMPLES_PASSED marker in the transcript says yes."""
+        matches = EXAMPLES_PASSED_RE.findall("\n".join(transcript))
+        return bool(matches) and matches[-1].lower() == "yes"
