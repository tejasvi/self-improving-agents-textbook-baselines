index 0000000..2e22285
--- /dev/null
+++ b/tools/check_io.py
@@ -0,0 +1,137 @@
+import os
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "check_io",
+        "description": """Run a Python solution script on given stdin inputs and compare its stdout with expected outputs.\n
+* Each test case runs `python <solution_file>` with the case's `input` fed to standard input (in its own process, with a timeout).
+* Output comparison ignores trailing whitespace on each line and leading/trailing blank lines, otherwise it is exact.
+* The result reports PASS/FAIL per case, with the expected output, the actual output, and stderr (truncated) for failing cases, plus a summary.
+* Use it after writing the solution to check the examples from the problem statement and any extra cases you derive (edge cases, brute-force comparisons, timing with large inputs).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_file": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a standalone program that reads stdin and writes stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run against the solution.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "name": {
+                                "type": "string",
+                                "description": "Short label for the test case, e.g. 'sample 1' or 'n=1 edge case'."
+                            },
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text to feed to the solution's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected standard output of the solution for this input."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional per-test-case timeout in seconds. Defaults to 10."
+                }
+            },
+            "required": ["solution_file", "test_cases"]
+        }
+    }
+
+
+MAX_DIFF_CHARS = 2000
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[-1] == "":
+        lines.pop()
+    while lines and lines[0] == "":
+        lines.pop(0)
+    return "\n".join(lines)
+
+
+def _truncate(text):
+    if len(text) > MAX_DIFF_CHARS:
+        return text[:MAX_DIFF_CHARS] + "\n...[truncated]"
+    return text
+
+
+def tool_function(solution_file: str, test_cases: list, timeout: float = 10) -> str:
+    if not os.path.isfile(solution_file):
+        return f"Error: solution file not found: {solution_file}"
+    if not isinstance(test_cases, list) or not test_cases:
+        return "Error: test_cases must be a non-empty list."
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    cwd = os.path.dirname(os.path.abspath(solution_file))
+    abs_solution = os.path.abspath(solution_file)
+    reports = []
+    passed = 0
+
+    for idx, case in enumerate(test_cases, start=1):
+        if not isinstance(case, dict):
+            reports.append(f"Case {idx}: FAIL (malformed test case, expected an object)")
+            continue
+        name = case.get("name") or f"case {idx}"
+        stdin_text = case.get("input", "")
+        expected = case.get("expected_output", "")
+        if stdin_text is None:
+            stdin_text = ""
+        if not stdin_text.endswith("\n") and stdin_text != "":
+            stdin_text += "\n"
+
+        try:
+            proc = subprocess.run(
+                [sys.executable, abs_solution],
+                input=stdin_text,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                cwd=cwd,
+            )
+        except subprocess.TimeoutExpired:
+            reports.append(f"[{name}] FAIL: timed out after {timeout} seconds")
+            continue
+        except Exception as e:
+            reports.append(f"[{name}] FAIL: could not run solution: {e}")
+            continue
+
+        actual = proc.stdout
+        if proc.returncode != 0:
+            reports.append(
+                f"[{name}] FAIL: exit code {proc.returncode}\n"
+                f"stderr:\n{_truncate(proc.stderr)}\n"
+                f"stdout:\n{_truncate(actual)}"
+            )
+            continue
+
+        if _normalize(actual) == _normalize(str(expected)):
+            passed += 1
+            reports.append(f"[{name}] PASS")
+        else:
+            reports.append(
+                f"[{name}] FAIL: output mismatch\n"
+                f"input:\n{_truncate(str(stdin_text))}\n"
+                f"expected:\n{_truncate(_normalize(str(expected)))}\n"
+                f"actual:\n{_truncate(_normalize(actual))}\n"
+                f"stderr:\n{_truncate(proc.stderr)}"
+            )
+
+    total = len(test_cases)
+    summary = f"Summary: {passed}/{total} test cases passed."
+    return "\n".join(reports) + "\n" + summary
