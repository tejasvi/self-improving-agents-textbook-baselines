+def truncate_output(text, limit=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of very long output, dropping the middle."""
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return (
+        text[:half]
+        + f"\n... [output truncated: {omitted} characters omitted] ...\n"
+        + text[-half:]
+    )
