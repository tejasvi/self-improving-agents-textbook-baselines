+def truncate_text(text, max_chars=10000):
+    """
+    Truncate a string to at most roughly max_chars characters, keeping the
+    beginning and the end of the text (where errors and summaries usually are).
+    """
+    text = str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    head = max_chars // 2
+    tail = max_chars - head
+    omitted = len(text) - head - tail
+    return f"{text[:head]}\n<... {omitted} characters truncated ...>\n{text[-tail:] if tail > 0 else ''}"
+
+
+def truncate_old_tool_results(messages, keep_recent=4, max_chars=1000):
+    """
+    Return a new message list in which tool_result contents located in older
+    turns (all but the last `keep_recent` messages) are truncated to max_chars.
+    Messages are not mutated; the original list is left intact.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    new_messages = []
+    for i, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if i >= cutoff or not isinstance(content, list):
+            new_messages.append(msg)
+            continue
+        new_content = []
+        for block in content:
+            if isinstance(block, dict) and block.get('type') == 'tool_result':
+                block = dict(block)
+                block['content'] = truncate_text(block.get('content', ''), max_chars)
+            new_content.append(block)
+        new_messages.append({**msg, 'content': new_content})
+    return new_messages
