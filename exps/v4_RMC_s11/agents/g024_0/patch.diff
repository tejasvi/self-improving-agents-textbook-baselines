+    def run_agent_with_retry(self, instruction):
+        """
+        Run one agent conversation. If it raises, retry once from the last good
+        state: the repository keeps the edits made before the failure, so the retry
+        is told about the current diff and continues from there. If the retry also
+        fails, log it and return so the caller still evaluates the repo with the tests.
+        """
+        try:
+            return chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+        except Exception as e:
+            safe_log(f"Agent run raised an exception: {type(e).__name__}: {e}. Retrying once from the last good state.", level=logging.WARNING)
+
+        current_diff = truncate_text(str(diff_versus_commit(self.git_tempdir, self.base_commit)))
+        retry_instruction = (
+            instruction
+            + "\n\nNote: a previous run of this conversation was interrupted by an error. "
+            "The repository currently contains the edits made before the interruption "
+            "(diff versus base commit below). Check their state, continue from there, and re-verify.\n\n"
+            f"Current repo edits:\n{current_diff}"
+        )
+        try:
+            return chat_with_agent(retry_instruction, model=self.code_model, msg_history=[], logging=safe_log)
+        except Exception as e:
+            safe_log(f"Retry also raised an exception: {type(e).__name__}: {e}. Proceeding to test the current repo state.", level=logging.ERROR)
+            return None
+
