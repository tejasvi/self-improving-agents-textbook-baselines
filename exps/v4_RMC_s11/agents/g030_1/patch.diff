+MAX_OUTPUT_CHARS = 16000  # total characters returned for stdout / stderr each
+COMMAND_TIMEOUT = 120.0  # seconds per command
+
+
+def truncate_output(text, limit=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of very long output, marking the omitted middle."""
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return (
+        text[:half]
+        + f"\n... [truncated {omitted} characters] ...\n"
+        + text[-half:]
+    )
