index 0000000..8eaba29
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,134 @@
+import os
+import subprocess
+import sys
+
+MAX_DETAIL_CHARS = 2000
+DEFAULT_TIMEOUT = 10.0
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python solution program on given test inputs and compare its stdout with the expected outputs.\n
+* Each test case is run as `python3 <solution_path>` with the case's `input` fed to stdin.\n
+* Output is compared token by token (whitespace-insensitive), so trailing spaces and blank lines do not matter.\n
+* Returns a per-case PASS/FAIL report. For failing cases it shows the actual output, the expected output, stderr and the exit status, and reports timeouts.\n
+* Use it to check the solution against the examples in the problem statement and against your own extra test cases (including edge cases and small brute-force comparisons).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a complete program that reads stdin and writes stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item has the stdin 'input' and the 'expected_output' to compare against.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Expected text the program should write to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-test-case time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_DETAIL_CHARS:
+        return text[:MAX_DETAIL_CHARS] + f"\n... [truncated {len(text) - MAX_DETAIL_CHARS} chars]"
+    return text
+
+
+def _run_case(solution_path, cwd, stdin_text, timeout):
+    """Run the solution once. Returns (status, stdout, stderr, returncode)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+        return "ok", proc.stdout, proc.stderr, proc.returncode
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return "timeout", out, err, None
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = None) -> str:
+    try:
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: 'test_cases' must be a non-empty list of objects with 'input' and 'expected_output'."
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if timeout is None:
+            timeout = DEFAULT_TIMEOUT
+        timeout = float(timeout)
+        if timeout <= 0:
+            return "Error: 'timeout' must be positive."
+
+        solution_path = os.path.abspath(solution_path)
+        cwd = os.path.dirname(solution_path)
+
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Case {idx}: FAIL (malformed test case; needs 'input' and 'expected_output')")
+                continue
+            stdin_text = str(case["input"])
+            expected = str(case["expected_output"])
+
+            status, stdout, stderr, rc = _run_case(solution_path, cwd, stdin_text, timeout)
+
+            if status == "timeout":
+                reports.append(
+                    f"Case {idx}: FAIL (timeout after {timeout}s)\n"
+                    f"--- stdout (partial) ---\n{_truncate(stdout)}\n"
+                    f"--- stderr ---\n{_truncate(stderr)}"
+                )
+                continue
+
+            if rc != 0:
+                reports.append(
+                    f"Case {idx}: FAIL (runtime error, exit code {rc})\n"
+                    f"--- input ---\n{_truncate(stdin_text)}\n"
+                    f"--- stderr ---\n{_truncate(stderr)}"
+                )
+                continue
+
+            if stdout.split() == expected.split():
+                passed += 1
+                reports.append(f"Case {idx}: PASS")
+            else:
+                reports.append(
+                    f"Case {idx}: FAIL (wrong answer)\n"
+                    f"--- input ---\n{_truncate(stdin_text)}\n"
+                    f"--- expected ---\n{_truncate(expected)}\n"
+                    f"--- actual ---\n{_truncate(stdout)}\n"
+                    f"--- stderr ---\n{_truncate(stderr)}"
+                )
+
+        total = len(test_cases)
+        summary = f"Summary: {passed}/{total} test cases passed."
+        return summary + "\n\n" + "\n\n".join(reports)
+    except Exception as e:
+        return f"Error running tests: {e}"
