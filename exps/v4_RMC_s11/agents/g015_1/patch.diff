@@ -0,0 +1,42 @@
+import tempfile, os
+from pathlib import Path
+import pytest
+from tools.run_tests import tool_function, tool_info
+
+SUM_SOLUTION = "a, b = map(int, input().split())\nprint(a + b)\n"
+
+@pytest.fixture
+def sol_path():
+    with tempfile.TemporaryDirectory() as d:
+        p = Path(d) / "sol.py"
+        p.write_text(SUM_SOLUTION)
+        yield str(p)
+
+def test_info_schema():
+    info = tool_info()
+    assert info["name"] == "run_tests"
+    assert info["input_schema"]["required"] == ["solution_path", "test_cases"]
+
+def test_all_pass(sol_path):
+    r = tool_function(sol_path, [{"input": "1 2", "expected_output": "3"}])
+    assert "1/1 test cases passed" in r
+
+def test_wrong_answer(sol_path):
+    r = tool_function(sol_path, [{"input": "2 2", "expected_output": "5"}])
+    assert "0/1" in r and "wrong answer" in r and "actual" in r
+
+def test_whitespace_insensitive(sol_path):
+    r = tool_function(sol_path, [{"input": "1 2", "expected_output": "3\n\n"}])
+    assert "1/1" in r
+
+def test_runtime_error(sol_path):
+    r = tool_function(sol_path, [{"input": "x", "expected_output": "1"}])
+    assert "runtime error" in r
+
+def test_timeout(sol_path):
+    Path(sol_path).write_text("import time\ntime.sleep(5)\n")
+    r = tool_function(sol_path, [{"input": "", "expected_output": ""}], timeout=0.5)
+    assert "timeout" in r
+
+def test_missing_file():
+    assert "not found" in tool_function("/nonexistent/x.py", [{"input": "", "expected_output": ""}])
diff --git a/tools/run_tests.py b/tools/run_tests.py
