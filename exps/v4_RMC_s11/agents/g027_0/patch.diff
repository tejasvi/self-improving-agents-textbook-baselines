+MAX_ATTEMPTS = 3
+
+def run_example_checks(git_dname, timeout=600):
+    """
+    Return True if the repository's test suite passes (exit code 0), or if
+    no tests are present. Returns False on failure or timeout.
+    """
+    test_dir = os.path.join(git_dname, 'tests')
+    if not os.path.isdir(test_dir):
+        return True
+    try:
+        result = subprocess.run(
+            ["python", "-m", "pytest", "-q"],
+            cwd=git_dname, capture_output=True, text=True, timeout=timeout, check=False,
+        )
+    except subprocess.TimeoutExpired:
+        return False
+    return result.returncode == 0
+
