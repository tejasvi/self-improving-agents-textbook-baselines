+def _is_transient_error(e):
+    """
+    Returns True if the exception looks like a transient API failure worth retrying
+    (rate limits, timeouts, connection problems, 408/409/429 and 5xx responses).
+    """
+    if isinstance(e, TRANSIENT_ERRORS):
+        return True
+    status = getattr(e, 'status_code', None)
+    if status is None:
+        status = getattr(getattr(e, 'response', None), 'status_code', None)
+    if isinstance(status, int) and (status in (408, 409, 429) or status >= 500):
+        return True
+    return False
+
+def call_with_retries(fn, logging=print, max_retries=5, base_delay=2.0, max_delay=60.0):
+    """
+    Calls fn() and retries on transient API errors with exponential backoff and jitter.
+    Non-transient errors are raised immediately. Makes at most max_retries + 1 attempts.
+    """
+    logging = logging or print
+    for attempt in range(max_retries + 1):
+        try:
+            return fn()
+        except Exception as e:
+            if not _is_transient_error(e) or attempt >= max_retries:
+                raise
+            delay = min(max_delay, base_delay * (2 ** attempt)) * random.uniform(0.5, 1.0)
+            logging(f"Transient API error ({type(e).__name__}: {e}); retry {attempt + 1}/{max_retries} in {delay:.1f}s")
+            time.sleep(delay)
+    raise RuntimeError("unreachable")
+
