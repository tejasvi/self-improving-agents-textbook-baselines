diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..7e61282
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,44 @@
+"""
+Helpers for deciding whether a model API error is transient (worth retrying
+with exponential backoff) or permanent (should be raised immediately).
+"""
+import anthropic
+import openai
+
+# HTTP status codes that indicate a transient server-side or throttling condition.
+TRANSIENT_STATUS_CODES = {408, 409, 425, 429, 500, 502, 503, 504, 529}
+
+# Exception types that are transient regardless of status code.
+TRANSIENT_ERROR_TYPES = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+
+
+def is_transient_api_error(e):
+    """
+    Return True if the exception `e` from a model API call is transient and the
+    call should be retried with backoff; False otherwise (e.g. bad request,
+    authentication failure, unsupported model).
+    """
+    if isinstance(e, TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(e, 'status_code', None)
+    if status is None:
+        status = getattr(getattr(e, 'response', None), 'status_code', None)
+    if isinstance(status, int) and status in TRANSIENT_STATUS_CODES:
+        return True
+    return False
+
+
+def should_giveup(e):
+    """
+    `backoff` giveup predicate: retry only transient errors.
+    """
+    return not is_transient_api_error(e)
