+
+
+def compare_outputs(actual, expected, tol=1e-6):
+    """
+    Token-by-token comparison. Lines must match in count and tokens must match in count per line.
+    Two tokens match exactly if their strings are equal. Otherwise, if both parse as floats they match
+    when abs(a-b) <= tol*max(1, abs(b)). Other tokens must be equal.
+    Returns dict: match (bool), exact (bool, whitespace-normalised equality), max_dev (largest float
+    deviation seen among float tokens, 0.0 if none), float_only (match but not exact).
+    """
+    a_lines, e_lines = _normalise(actual), _normalise(expected)
+    result = {'match': False, 'exact': a_lines == e_lines, 'max_dev': 0.0, 'float_only': False}
+    if len(a_lines) != len(e_lines):
+        return result
+    for al, el in zip(a_lines, e_lines):
+        at, et = al.split(), el.split()
+        if len(at) != len(et):
+            return result
+        for x, y in zip(at, et):
+            if x == y:
+                continue
+            fx, fy = _float_or_none(x), _float_or_none(y)
+            if fx is None or fy is None:
+                return result
+            dev = abs(fx - fy)
+            if not dev <= tol * max(1.0, abs(fy)):  # also rejects nan
+                result['max_dev'] = max(result['max_dev'], dev) if dev == dev else float('inf')
+                return result
+            result['max_dev'] = max(result['max_dev'], dev)
+    result['match'] = True
+    result['float_only'] = not result['exact']
+    return result
+
+
+def outputs_match(actual, expected, tol=1e-6):
+    """True if actual matches expected: exact tokens, floats within abs-or-rel tolerance tol."""
+    return compare_outputs(actual, expected, tol)['match']
+
