+# tests/gen.py, tools/solution_check.py and tests/test_scoring_selection.py.
+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    # Without a problem-specific algorithm, echo the first token as a fallback.
+    print(data[0])
+
+
+if __name__ == "__main__":
+    main()
