+# First-draft draft: generic counterexample shrinker (format-agnostic).
+# Intended to be moved into tools/solution_check.py as shrink_failure().
+
+import subprocess
+import sys
+
+
+def _run(path, input_text, timeout):
+    try:
+        p = subprocess.run(
+            [sys.executable, path],
+            input=input_text, capture_output=True, text=True, timeout=timeout,
+        )
+        return p.returncode, p.stdout.strip()
+    except subprocess.TimeoutExpired:
+        return -1, ''
+
+
+def _differs(solution_path, brute_path, text, timeout):
+    """True if brute succeeds and solution crashes or differs from brute."""
+    b_rc, b_out = _run(brute_path, text, timeout)
+    if b_rc != 0:
+        return False, None, None
+    s_rc, s_out = _run(solution_path, text, timeout)
+    if s_rc != 0 or s_out != b_out:
+        return True, s_out, b_out
+    return False, s_out, b_out
+
+
+def _candidates(lines):
+    # 1) delete single lines (tail first, then middle)
+    for i in range(len(lines) - 1, -1, -1):
+        yield lines[:i] + lines[i + 1:]
+    # 2) lower / halve integer tokens
+    for i, line in enumerate(lines):
+        toks = line.split()
+        for j, tok in enumerate(toks):
+            if tok.lstrip('-').isdigit():
+                v = int(tok)
+                for nv in sorted({1, v // 2, v - 1}):
+                    if 1 <= nv < v:
+                        nt = toks[:]
+                        nt[j] = str(nv)
+                        yield lines[:i] + [' '.join(nt)] + lines[i + 1:]
+
+
+def shrink_failure(solution_path, brute_path, input_text, timeout, max_rounds=200, strict=True):
+    lines = [l for l in input_text.split('\n') if l.strip() != '']
+    fails, s_out, b_out = _differs(solution_path, brute_path, '\n'.join(lines) + '\n', timeout)
+    if not fails:
+        return input_text, s_out, b_out
+    rounds = 0
+    improved = True
+    while improved and rounds < max_rounds:
+        improved = False
+        for cand in _candidates(lines):
+            rounds += 1
+            if rounds >= max_rounds:
+                break
+            if not cand:
+                continue
+            text = '\n'.join(cand) + '\n'
+            ok, so, bo = _differs(solution_path, brute_path, text, timeout)
+            if ok:
+                lines, s_out, b_out = cand, so, bo
+                improved = True
+                break
+    return '\n'.join(lines) + '\n', s_out, b_out
