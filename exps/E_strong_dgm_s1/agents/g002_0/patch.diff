+    # ------------------------------------------------------------------
+    # Framework-side objective evaluation (no LLM verdicts involved)
+    # ------------------------------------------------------------------
+    def _corpus_dir(self):
+        return os.path.join(self.attempts_dir, CORPUS_DIRNAME)
+
+    @staticmethod
+    def _py_cmd(path):
+        if path.endswith('.py'):
+            return [sys.executable, path]
+        return [os.path.abspath(path)]
+
+    @staticmethod
+    def _run_cmd(cmd, stdin_bytes, timeout):
+        """Run a command. Returns dict(ok, rc, out, elapsed)."""
+        t0 = time.time()
+        try:
+            p = subprocess.run(cmd, input=stdin_bytes, capture_output=True, timeout=timeout)
+            return {'ok': p.returncode == 0, 'rc': p.returncode,
+                    'out': p.stdout.decode('utf-8', errors='replace'), 'elapsed': time.time() - t0}
+        except subprocess.TimeoutExpired:
+            return {'ok': False, 'rc': 'TIMEOUT', 'out': '', 'elapsed': float(EVAL_RUN_TIMEOUT)}
+        except OSError as e:
+            return {'ok': False, 'rc': f'OSERROR {e}', 'out': '', 'elapsed': 0.0}
+
+    @staticmethod
+    def _norm(s):
+        return ' '.join((s or '').split())
+
+    def _find_reference_tools(self):
+        """Latest checker/brute written by the agent in the scratch dirs (newest attempt first)."""
+        checker, brute = None, None
+        for k in range(MAX_ATTEMPTS - 1, -1, -1):
+            d = os.path.join(self.attempts_dir, f'scratch_{k}')
+            if checker is None and os.path.isfile(os.path.join(d, 'checker.py')):
+                checker = os.path.join(d, 'checker.py')
+            if brute is None and os.path.isfile(os.path.join(d, 'brute.py')):
+                brute = os.path.join(d, 'brute.py')
+        return checker, brute
+
