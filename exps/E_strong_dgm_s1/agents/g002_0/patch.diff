+        """
+        Run every saved attempt_<i>.py on every corpus input.
+        Reference: last checker (with brute output as 3rd arg if a brute exists), else last brute,
+        else the majority output among attempts. Returns a dict with per-attempt scores and a text matrix.
+        """
+        corpus = self._corpus_dir()
+        inputs = []
+        if os.path.isdir(corpus):
+            for name in sorted(os.listdir(corpus)):
+                p = os.path.join(corpus, name)
+                if os.path.isfile(p):
+                    inputs.append(p)
+        inputs = inputs[:MAX_CORPUS_INPUTS]
+
+        attempts = []  # (index, path)
+        for k in range(MAX_ATTEMPTS):
+            p = os.path.join(self.attempts_dir, f'attempt_{k}.py')
+            if os.path.isfile(p):
+                attempts.append((k, p))
+
+        checker, brute = self._find_reference_tools()
+        mode = 'checker' if checker else ('brute' if brute else 'majority')
+        tmpdir = tempfile.mkdtemp(prefix='corpus_eval_')
+        # cells[input][k] = (status, elapsed) where status in OK / MISMATCH / CRASH
+        cells = {}
+        scores = {k: {'bad': 0, 'max_time': 0.0, 'bad_inputs': []} for k, _ in attempts}
+        skipped = []
+        try:
+            for inp in inputs:
+                with open(inp, 'rb') as f:
+                    data = f.read()
+                ref_out = None
+                if brute:
+                    b = self._run_cmd(self._py_cmd(brute), data, EVAL_RUN_TIMEOUT)
+                    if not b['ok']:
+                        skipped.append(os.path.basename(inp))
+                        continue
+                    ref_out = b['out']
+                runs = {}
+                for k, p in attempts:
+                    runs[k] = self._run_cmd(self._py_cmd(p), data, EVAL_RUN_TIMEOUT)
+                    scores[k]['max_time'] = max(scores[k]['max_time'], runs[k]['elapsed'])
+                if not checker and not brute:
+                    counts = {}
+                    for k in runs:
+                        if runs[k]['ok']:
+                            h = self._norm(runs[k]['out'])
+                            counts[h] = counts.get(h, 0) + 1
+                    ref_out = max(counts, key=counts.get) if counts else None
+                for k in runs:
+                    r = runs[k]
+                    if not r['ok']:
+                        status = 'CRASH'
+                        good = False
+                    elif checker:
+                        out_file = os.path.join(tmpdir, f'out_{k}.txt')
+                        with open(out_file, 'w', encoding='utf-8', errors='replace') as f:
+                            f.write(r['out'])
+                        in_path = os.path.abspath(inp)
+                        args = [sys.executable, checker, in_path, out_file]
+                        if ref_out is not None:
+                            bf = os.path.join(tmpdir, 'brute_out.txt')
+                            with open(bf, 'w', encoding='utf-8', errors='replace') as f:
+                                f.write(ref_out)
+                            args.append(bf)
+                        c = self._run_cmd(args, b'', EVAL_RUN_TIMEOUT)
+                        good = c['ok']
+                        status = 'OK' if good else 'MISMATCH'
+                    else:
+                        good = ref_out is not None and self._norm(r['out']) == self._norm(ref_out)
+                        status = 'OK' if good else 'MISMATCH'
+                    cells[(os.path.basename(inp), k)] = (status, r['elapsed'])
+                    if not good:
+                        scores[k]['bad'] += 1
+                        scores[k]['bad_inputs'].append(os.path.basename(inp))
+        finally:
+            shutil.rmtree(tmpdir, ignore_errors=True)
