+                "input_files": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of input file paths to feed to every solution. Use this or input_dir."
+                },
+                "input_dir": {
+                    "type": "string",
+                    "description": "Optional directory; all regular files directly inside it are used as inputs (sorted by name). Used in addition to input_files if both are given."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional checker for problems with multiple valid answers: `checker <input_file> <solution_output_file> [<brute_output_file>]`, exit 0 = accepted."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional brute-force reference program; its output on each input is the reference for exact-match agreement."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each solution, brute and checker run (default 10)."
+                }
+            },
+            "required": ["solution_paths"]
+        }
+    }
+
+
+def _cmd(path):
+    if path.endswith(".py"):
+        return [sys.executable, path]
+    return [os.path.abspath(path)]
+
+
+def _run(cmd, data, timeout, args=None):
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd + (args or []), input=data, capture_output=True, timeout=timeout)
+        return {
+            "timeout": False,
+            "rc": p.returncode,
+            "stdout": p.stdout.decode("utf-8", errors="replace"),
+            "stderr": p.stderr.decode("utf-8", errors="replace"),
+            "elapsed": time.time() - t0,
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode("utf-8", errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return {"timeout": True, "rc": None, "stdout": out, "stderr": err, "elapsed": time.time() - t0}
+
+
+def _norm_hash(s):
+    return hashlib.sha1(" ".join(s.split()).encode("utf-8")).hexdigest()[:10]
+
+
+def _tail(s, n=400):
+    s = (s or "").strip()
+    return s if len(s) <= n else "..." + s[-n:]
+
+
+def _gather_inputs(input_files, input_dir):
+    paths = list(input_files or [])
+    if input_dir:
+        if not os.path.isdir(input_dir):
+            return None, f"Error: input_dir not found: {input_dir}"
+        for name in sorted(os.listdir(input_dir)):
+            p = os.path.join(input_dir, name)
+            if os.path.isfile(p):
+                paths.append(p)
+    # de-duplicate, keep order
+    seen, uniq = set(), []
+    for p in paths:
+        ap = os.path.abspath(p)
+        if ap not in seen:
+            seen.add(ap)
+            uniq.append(p)
+    return uniq, None
+
+
+def tool_function(solution_paths, input_files=None, input_dir=None, checker_path=None,
+                  brute_path=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else 10), MAX_TIMEOUT))
+    except (TypeError, ValueError):
+        timeout = 10
+    if isinstance(solution_paths, str):
+        solution_paths = [solution_paths]
+    solution_paths = list(solution_paths or [])
+    if not solution_paths:
+        return "Error: no solution_paths given."
+    if len(solution_paths) > MAX_SOLUTIONS:
+        return f"Error: too many solutions (max {MAX_SOLUTIONS})."
+
+    for p in solution_paths:
+        if not os.path.isfile(p):
+            return f"Error: solution file not found: {p}"
+    for label, p in [("checker", checker_path), ("brute", brute_path)]:
+        if p and not os.path.isfile(p):
+            return f"Error: {label} file not found: {p}"
+
+    inputs, err = _gather_inputs(input_files, input_dir)
+    if err:
+        return err
+    if not inputs:
+        return "Error: no input files given (use input_files and/or input_dir)."
+    for p in inputs:
+        if not os.path.isfile(p):
+            return f"Error: input file not found: {p}"
+    if len(inputs) > MAX_INPUTS:
+        return f"Error: too many inputs (max {MAX_INPUTS}); split the corpus."
+
+    names = [f"S{i}:{os.path.basename(p)}" for i, p in enumerate(solution_paths)]
+    tmpdir = tempfile.mkdtemp(prefix="compare_solutions_")
+    rows = []           # dicts per (solution, input)
+    max_time = {n: 0.0 for n in names}
+    disagreeing = []
+    try:
+        for inp in inputs:
+            with open(inp, "rb") as f:
+                data = f.read()
+            label = os.path.basename(inp)
+
+            ref_out = None
+            brute_hash = None
+            if brute_path:
+                b = _run(_cmd(brute_path), data, timeout)
+                if b["timeout"] or b["rc"] != 0:
+                    rows.append({"input": label, "solution": "BRUTE", "rc": "TIMEOUT" if b["timeout"] else b["rc"],
+                                 "time": b["elapsed"], "hash": "-", "agree": "BRUTE-FAILED",
+                                 "stderr": _tail(b["stderr"])})
+                    disagreeing.append(label)
+                    continue
+                ref_out = b["stdout"]
+                brute_hash = _norm_hash(ref_out)
+
+            outs = {}
+            cur = {}  # solution name -> row dict for this input
+            for i, sp in enumerate(solution_paths):
+                name = names[i]
+                r = _run(_cmd(sp), data, timeout)
+                outs[name] = r
+                max_time[name] = max(max_time[name], r["elapsed"])
+                ok_run = (not r["timeout"]) and r["rc"] == 0
+                rc_str = "TIMEOUT" if r["timeout"] else str(r["rc"])
+                h = _norm_hash(r["stdout"]) if ok_run else "-"
+                row = {"input": label, "solution": name, "rc": rc_str,
+                       "time": r["elapsed"], "hash": h, "stderr": _tail(r["stderr"])}
+                if checker_path:
+                    if not ok_run:
+                        row["agree"] = "REJECT(run failed)"
+                    else:
+                        # write solution output to a file for checker
+                        out_file = os.path.join(tmpdir, f"out_{i}.txt")
+                        with open(out_file, "w", encoding="utf-8", errors="replace") as f:
+                            f.write(r["stdout"])
+                        args = [inp, out_file]
+                        if ref_out is not None:
+                            bf = os.path.join(tmpdir, "brute_out.txt")
+                            with open(bf, "w", encoding="utf-8", errors="replace") as f:
+                                f.write(ref_out)
+                            args.append(bf)
+                        c = _run(_cmd(checker_path), b"", timeout, args=args)
+                        accepted = (not c["timeout"]) and c["rc"] == 0
+                        row["agree"] = "ACCEPT" if accepted else "REJECT"
+                        if not accepted:
+                            row["checker_out"] = _tail(c["stdout"] + "\n" + c["stderr"])
+                elif ref_out is not None:
+                    if not ok_run:
+                        row["agree"] = "FAILED-RUN"
+                    else:
+                        row["agree"] = "AGREE" if h == brute_hash else "DIFF"
+                rows.append(row)
+                cur[name] = row
+
+            # Disagreement among solutions / with reference
+            if checker_path:
+                bad = [n for n in names if cur[n]["agree"] != "ACCEPT"]
+                if bad:
+                    disagreeing.append(f"{label} (not accepted by checker: {', '.join(bad)})")
+            elif brute_path:
+                bad = [n for n in names if cur[n]["agree"] != "AGREE"]
+                if bad:
+                    disagreeing.append(f"{label} (differs from brute: {', '.join(bad)})")
+            else:
+                hashes = {}
+                for n in names:
+                    r = outs[n]
+                    hashes[n] = _norm_hash(r["stdout"]) if ((not r["timeout"]) and r["rc"] == 0) else "FAILED"
+                base = hashes[names[0]]
+                for n in names:
+                    cur[n]["agree"] = "SAME" if hashes[n] == base else "DIFF"
+                if len(set(hashes.values())) > 1:
+                    disagreeing.append(label)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    lines = []
+    lines.append(f"Compared {len(solution_paths)} solution(s) on {len(inputs)} input(s); timeout={timeout}s.")
+    lines.append("")
+    lines.append(f"{'input':<28} {'solution':<28} {'exit':<10} {'time(s)':>8} {'hash':<12} agree")
+    for r in rows:
+        lines.append(f"{r['input'][:28]:<28} {r['solution'][:28]:<28} {str(r['rc'])[:10]:<10} "
+                     f"{r['time']:>8.3f} {r['hash']:<12} {r.get('agree', '-')}")
+    lines.append("")
+    lines.append("Max runtime per solution:")
+    for n in names:
+        lines.append(f"  {n}: {max_time[n]:.3f}s")
+    lines.append("")
+    if disagreeing:
+        lines.append(f"DISAGREEING INPUTS ({len(disagreeing)}):")
+        for d in disagreeing:
+            lines.append(f"  {d}")
+    else:
+        lines.append("No disagreements: all solutions agree on every input.")
+    failing = [r for r in rows if r.get("stderr") and r["rc"] not in (0, "0")]
+    if failing:
+        lines.append("")
+        lines.append("Raw stderr tails of non-zero/timeout runs:")
+        for r in failing[:20]:
+            lines.append(f"  [{r['solution']} on {r['input']} rc={r['rc']}] {_tail(r['stderr'], 300)!r}")
+    lines.append("")
+    lines.append("Solution key: " + "; ".join(f"{n} = {p}" for n, p in zip(names, solution_paths)))
+    return "\n".join(lines)
