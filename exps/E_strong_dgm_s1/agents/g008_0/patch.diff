+    def _best_candidate_entry(self):
+        """Best (score, path, report) over cands/*.py, scoring files not yet in self.scores. None if no cands."""
+        if not hasattr(self, 'scores'):
+            self.scores = {}
+        if not os.path.isdir(self.cands_dir):
+            return None
+        entries = []
+        for name in sorted(os.listdir(self.cands_dir)):
+            path = os.path.join(self.cands_dir, name)
+            if not (name.endswith('.py') and os.path.isfile(path)):
+                continue
+            if path not in self.scores:
+                self.scores[path] = self._score_candidate(path)
+            score, rep = self.scores[path]
+            entries.append((score, path, rep))
+        return self._pick_best(entries) if entries else None
+
+    def _harness_fallback_solution(self):
