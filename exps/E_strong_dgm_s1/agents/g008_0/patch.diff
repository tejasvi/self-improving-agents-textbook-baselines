@@ -0,0 +1,91 @@
+import json
+import os
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+
+BRUTE = "a, b = map(int, input().split())\nprint(a + b)\n"
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode == 'max':\n"
+       "    print(10**9, 10**9)\n"
+       "else:\n"
+       "    print(random.randint(0, 9), random.randint(0, 9))\n")
+SAMPLES = [{"input": "1 2\n", "output": "3\n"}, {"input": "5 5\n", "output": "10\n"}]
+# Imperfect but non-empty: right on samples, wrong on larger inputs.
+IMPERFECT = "a, b = map(int, input().split())\nprint(a + b if a < 3 else a * b)\n"
+
+
+def _git(repo, *args):
+    subprocess.run(["git", "-C", str(repo), *args], check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _make_repo(tmp_path):
+    repo = tmp_path / "repo"
+    (repo / "tests").mkdir(parents=True)
+    (repo / "cands").mkdir()
+    (repo / "tests" / "brute.py").write_text(BRUTE)
+    (repo / "tests" / "gen.py").write_text(GEN)
+    (repo / "tests" / "samples.json").write_text(json.dumps(SAMPLES))
+    (repo / "solution.py").write_text("# placeholder\n")
+    _git(repo, "init", "-q")
+    _git(repo, "config", "user.email", "t@example.com")
+    _git(repo, "config", "user.name", "t")
+    _git(repo, "add", "solution.py")
+    _git(repo, "commit", "-qm", "base")
+    commit = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"],
+                            stdout=subprocess.PIPE, check=True).stdout.decode().strip()
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(repo)
+    agent.base_commit = commit
+    agent.brute_path = str(repo / "tests" / "brute.py")
+    agent.gen_path = str(repo / "tests" / "gen.py")
+    agent.samples_path = str(repo / "tests" / "samples.json")
+    agent.cands_dir = str(repo / "cands")
+    agent.solution_path = str(repo / "solution.py")
+    agent._init_pipeline(budget_seconds=600)
+    return repo, agent
+
+
+def test_fallback_copies_imperfect_candidate_and_primary_edit_true(tmp_path):
+    repo, agent = _make_repo(tmp_path)
+    (repo / "cands" / "cand_1.py").write_text(IMPERFECT)
+    assert agent._has_primary_edit() is False  # placeholder solution.py
+    assert agent._harness_fallback_solution() is True
+    assert (repo / "solution.py").read_text() == IMPERFECT
+    assert agent._has_primary_edit() is True
+
+
+def test_fallback_uses_cached_scores_and_picks_best(tmp_path):
+    repo, agent = _make_repo(tmp_path)
+    (repo / "cands" / "cand_1.py").write_text(IMPERFECT)
+    (repo / "cands" / "cand_2.py").write_text(BRUTE)
+    good = str(repo / "cands" / "cand_2.py")
+    agent.scores = {good: ((2, 5, 1), "RESULT: OK")}  # cached; cand_1 gets scored fresh
+    assert agent._harness_fallback_solution() is True
+    assert (repo / "solution.py").read_text() == BRUTE
+
+
+def test_fallback_skips_when_no_cands(tmp_path):
+    repo, agent = _make_repo(tmp_path)
+    assert agent._harness_fallback_solution() is False
+    assert (repo / "solution.py").read_text() == "# placeholder\n"
+
+
+def test_identical_to_base_solution_is_no_edit(tmp_path):
+    repo, agent = _make_repo(tmp_path)
+    (repo / "main.py").write_text("print(1)\n")  # some other primary file changed
+    assert agent._has_primary_edit() is False
+    assert agent._solution_is_base_placeholder() is True
+
+
+def test_real_solution_edit_is_not_placeholder(tmp_path):
+    repo, agent = _make_repo(tmp_path)
+    (repo / "solution.py").write_text(IMPERFECT)
+    assert agent._solution_is_base_placeholder() is False
+    assert agent._has_primary_edit() is True
