+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from utils.candidate_select import select_best, pick_and_copy
+
+# Problem used in tests: read n, print sum of the n numbers that follow.
+CORRECT = "n = int(input())\nprint(sum(map(int, input().split())))\n"
+WRONG = "n = int(input())\nprint(sum(map(int, input().split())) + 1)\n"   # always off by one
+SLOW = "import time\nn = int(input())\ntime.sleep(0.5)\nprint(sum(map(int, input().split())))\n"
+CRASH = "n = int(input())\nraise SystemExit(3)\n"
+
+BRUTE = "n = int(input())\nprint(sum(map(int, input().split())))\n"
+GEN = """import random, sys
+seed = int(sys.argv[1]); mode = sys.argv[2] if len(sys.argv) > 2 else 'small'
+random.seed(seed)
+n = random.randint(1, 5) if mode == 'small' else random.randint(50, 60)
+print(n)
+print(' '.join(str(random.randint(-10**9, 10**9)) for _ in range(n)))
+"""
+SAMPLES = [("3\n1 2 3\n", "6\n")]
+
+
+def _write(tmp_path, name, text):
+    p = tmp_path / name
+    p.write_text(text)
+    return str(p)
+
+
+def test_correct_beats_wrong_and_crash(tmp_path):
+    cands = [_write(tmp_path, 'wrong.py', WRONG), _write(tmp_path, 'crash.py', CRASH),
+             _write(tmp_path, 'good.py', CORRECT)]
+    brute = _write(tmp_path, 'brute.py', BRUTE)
+    gen = _write(tmp_path, 'gen.py', GEN)
+    best, scores = select_best(cands, SAMPLES, brute_path=brute, gen_path=gen,
+                               small_seeds=5, large_seeds=2, time_limit=5.0)
+    assert best == cands[2]
+    assert scores[cands[2]][0] == 1          # passes the sample
+    assert scores[cands[0]][0] == 0          # wrong answer fails the sample
+    assert scores[cands[0]] < scores[cands[2]]
+
+
+def test_sample_failure_outranks_majority(tmp_path):
+    # Two wrong candidates agree with each other on the large inputs, but the
+    # correct one passes the sample, so it must still win on the first criterion.
+    cands = [_write(tmp_path, 'w1.py', WRONG), _write(tmp_path, 'w2.py', WRONG),
+             _write(tmp_path, 'good.py', CORRECT)]
+    best, _ = select_best(cands, SAMPLES, time_limit=5.0)
+    assert best == cands[2]
+
+
+def test_tie_prefers_earlier_candidate(tmp_path):
+    cands = [_write(tmp_path, 'a.py', CORRECT), _write(tmp_path, 'b.py', CORRECT)]
+    best, _ = select_best(cands, SAMPLES, time_limit=5.0)
+    assert best == cands[0]
+
+
+def test_slow_candidate_loses_on_time(tmp_path):
+    cands = [_write(tmp_path, 'slow.py', SLOW), _write(tmp_path, 'fast.py', CORRECT)]
+    best, scores = select_best(cands, SAMPLES, time_limit=0.1)
+    assert best == cands[1]
+    assert scores[cands[0]][3] < scores[cands[1]][3]
+
+
+def test_no_candidates_returns_none(tmp_path):
+    best, scores = select_best([str(tmp_path / 'missing.py')], SAMPLES)
+    assert best is None and scores == {}
+
+
+def test_pick_and_copy_writes_winner(tmp_path):
+    good = _write(tmp_path, 'good.py', CORRECT)
+    wrong = _write(tmp_path, 'wrong.py', WRONG)
+    dest = tmp_path / 'solution.py'
+    dest.write_text(WRONG)
+    best, _ = pick_and_copy([str(dest), wrong, good], str(dest), samples=SAMPLES, time_limit=5.0)
+    assert best == good
+    assert dest.read_text() == CORRECT
+
+
+def test_budget_stops_pool_generation(tmp_path):
+    cands = [_write(tmp_path, 'good.py', CORRECT)]
+    brute = _write(tmp_path, 'brute.py', BRUTE)
+    gen = _write(tmp_path, 'gen.py', GEN)
+    # A clock that is already past the budget: no generated inputs, samples still counted.
+    ticks = iter([0.0] + [100.0] * 1000)
+    best, scores = select_best(cands, SAMPLES, brute_path=brute, gen_path=gen,
+                               small_seeds=5, large_seeds=5, time_limit=5.0,
+                               budget_seconds=1.0, clock=lambda: next(ticks))
+    assert best == cands[0]
+    assert scores[cands[0]][1] == 0  # no brute-agreement checks ran
