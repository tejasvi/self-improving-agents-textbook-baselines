+BRUTE = GOOD
+GEN = "import random, sys\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(1, 3))\nprint(1, 2, 3)\n"
+
+
+def _git(repo, *args):
+    subprocess.run(["git", "-C", str(repo), *args], check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _make_repo(tmp_path):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    _git(repo, "config", "user.email", "t@example.com")
+    _git(repo, "config", "user.name", "t")
+    (repo / "solution.py").write_text("# placeholder\n")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-qm", "base")
+    commit = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"],
+                            stdout=subprocess.PIPE, check=True).stdout.decode().strip()
+    tdir = repo / "tests_agent"
+    tdir.mkdir()
+    (tdir / "sample_1.in").write_text("3\n1 2 3\n")
+    (tdir / "sample_1.out").write_text("6\n")
+    (tdir / "brute.py").write_text(BRUTE)
+    (tdir / "gen.py").write_text(GEN)
+    return repo, commit
+
+
+def _fake_check(solution_path, inputs=None, expected_outputs=None, brute_path=None,
+                gen_path=None, num_tests=200, timeout=10):
+    """Stands in for tools.solution_check: judges by the file contents (no subprocess)."""
+    code = open(solution_path).read()
+    if inputs is not None:
+        if "BUGGY" in code:
+            return "[input 0] FAIL: output differs from expected\nRESULT: FAILED"
+        return f"1/{len(inputs)} passed, max time 0.000 s\nRESULT: OK"
+    if "ADVBUG" in code and brute_path and "brute_adv" in brute_path:
+        return "WRONG ANSWER on seed 0\nRESULT: FAILED (stress: 0/100 seeds ran before failure)"
+    if "BUGGY" in code:
+        return "WRONG ANSWER on seed 0\nRESULT: FAILED (stress: 0/200 seeds ran before failure)"
+    n = num_tests
+    return f"stress: {n}/{n} passed, max time 0.000 s\nRESULT: OK"
+
+
+def _kind(msg):
+    if "independent adversarial tester" in msg:
+        return "adversary"
+    if "# Reflection attempt" in msg:
+        return "repair"
+    return "main"
+
+
+class FakeChat:
+    """Scripted chat. script(fake, kind, n) writes files; n counts sessions of that kind."""
+
+    def __init__(self, repo, script):
+        self.repo = repo
+        self.script = script
+        self.prompts = []
+        self.kinds = []
+        self.counts = {}
+
+    def __call__(self, msg, model=None, msg_history=None, logging=print, **kw):
+        kind = _kind(msg)
+        n = self.counts.get(kind, 0)
+        self.counts[kind] = n + 1
+        self.prompts.append(msg)
+        self.kinds.append(kind)
+        self.script(self, kind, n)
+        return []
+
+
+def _solution(repo):
+    return (repo / "solution.py").read_text()
+
+
+def _agent(repo, commit, monkeypatch, script):
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(repo)
+    agent.base_commit = commit
+    agent.code_model = "fake"
+    agent.problem_statement = "sum the numbers"
+    agent.logger = None
+    fake = FakeChat(repo, script)
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake)
+    monkeypatch.setattr(coding_agent, "solution_check_tool", _fake_check)
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+    return agent, fake
+
+
+def _write_sol(fake, text):
+    (fake.repo / "solution.py").write_text(text)
+
+
+def test_first_attempt_passes_no_repair(tmp_path, monkeypatch):
+    repo, commit = _make_repo(tmp_path)
+    agent, fake = _agent(repo, commit, monkeypatch,
+                         lambda f, kind, n: _write_sol(f, GOOD))
+    agent.forward()
+    assert fake.kinds == ["main", "adversary"]  # no repair when verification passes
+    assert os.listdir(repo / "attempts") == ["sol_0.py"]  # only the final candidate copy
+
+
+def test_failed_verification_repaired_with_context(tmp_path, monkeypatch):
+    repo, commit = _make_repo(tmp_path)
+
+    def script(fake, kind, n):
+        if kind == "main":
+            _write_sol(fake, BUGGY)
+        elif kind == "repair":
+            _write_sol(fake, GOOD)
+
+    agent, fake = _agent(repo, commit, monkeypatch, script)
+    agent.forward()
+    # main session, one repair session, then the adversary session on the repaired code
+    assert fake.kinds == ["main", "repair", "adversary"]
+    repair = fake.prompts[1]
+    assert "# Reflection attempt 1" in repair
+    assert "BUGGY" in repair                       # previous code included
+    assert "RESULT: FAILED" in repair              # raw failing report included
+    assert "root cause" in repair.lower()
+    assert (repo / "attempts" / "sol_0.py").read_text() == BUGGY
+    assert _solution(repo) == GOOD
+
+
+def test_repair_rounds_are_bounded(tmp_path, monkeypatch):
+    repo, commit = _make_repo(tmp_path)
+    agent, fake = _agent(repo, commit, monkeypatch,
+                         lambda f, kind, n: _write_sol(f, BUGGY))
+    agent.forward()
+    K = coding_agent.AgenticSystem.MAX_REPAIR_ROUNDS
+    assert K == 3
+    assert fake.kinds.count("repair") == K       # exactly K repairs, never more
+    assert fake.kinds[0] == "main"
+    # every failing candidate is kept: main + repairs before the final one, plus the final copy
+    assert sorted(os.listdir(repo / "attempts")) == ["sol_0.py", "sol_1.py", "sol_2.py", "sol_3.py"]
+
+
+def test_selection_picks_good_candidate_over_buggy(tmp_path, monkeypatch):
+    repo, commit = _make_repo(tmp_path)
+
+    def script(fake, kind, n):
+        # Main session: buggy. First repair: good. Later repairs: still buggy.
+        if kind == "main":
+            _write_sol(fake, BUGGY)
+        elif kind == "repair":
+            _write_sol(fake, GOOD if n == 0 else BUGGY)
+
+    agent, fake = _agent(repo, commit, monkeypatch, script)
+    agent.forward()
+    assert _solution(repo) == GOOD
+
+
+def test_adversarial_failure_triggers_one_repair(tmp_path, monkeypatch):
+    repo, commit = _make_repo(tmp_path)
+    adv = repo / "tests_agent" / "adversarial"
+    adv.mkdir()
+    (adv / "brute_adv.py").write_text(BRUTE)
+    (adv / "gen_adv.py").write_text(GEN)
+
+    def script(fake, kind, n):
+        if kind == "adversary":
+            return  # adversary only reports; it does not edit solution.py
+        if kind == "main":
+            _write_sol(fake, ADV_BUG)  # passes verification but fails the adversary
+        else:
+            _write_sol(fake, GOOD)
+
+    agent, fake = _agent(repo, commit, monkeypatch, script)
+    agent.forward()
+    assert fake.kinds == ["main", "adversary", "repair"]
+    assert _solution(repo) == GOOD
