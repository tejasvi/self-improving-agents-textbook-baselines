+"""Candidate selection for competitive-programming solutions.
+
+Every candidate is a stdin/stdout Python program. Candidates are run on a pool of
+inputs:
+  * samples (input, expected output) -> counted as "samples passed";
+  * small generated inputs (gen.py seed small) with the brute force as oracle
+    -> counted as "brute agreement";
+  * large generated inputs (gen.py seed large) with no oracle -> majority agreement
+    among candidates and runtime.
+Candidates are ranked by the tuple
+  (samples passed, brute agreement, majority agreement, -(runs over time limit or failing)).
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+RUN_TIMEOUT = 10.0
+
+
+def _norm(s):
+    lines = [line.rstrip() for line in (s or '').replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _run_py(path, args, stdin_text, cwd, timeout):
+    """Run `python -I path args` in cwd. Returns (ok, stdout, elapsed)."""
+    t0 = time.monotonic()
+    try:
+        p = subprocess.run([sys.executable, '-I', path] + list(args), input=stdin_text,
+                           capture_output=True, text=True, timeout=timeout, cwd=cwd,
+                           errors='replace')
+    except subprocess.TimeoutExpired:
+        return False, '', time.monotonic() - t0
+    el = time.monotonic() - t0
+    ok = p.returncode == 0 and not p.stderr.strip()
+    return ok, p.stdout, el
+
+
+def _gen_input(gen_path, seed, mode, cwd):
+    ok, out, _ = _run_py(gen_path, [str(seed), mode], '', cwd, RUN_TIMEOUT)
+    return out if ok and out.strip() else None
+
+
+def _brute_output(brute_path, inp, cwd):
+    ok, out, _ = _run_py(brute_path, [], inp, cwd, RUN_TIMEOUT)
+    return out if ok else None
+
+
+def select_best(candidates, samples, brute_path=None, gen_path=None,
+                small_seeds=20, large_seeds=10, time_limit=2.0,
+                budget_seconds=None, clock=time.monotonic):
+    """Score candidate solution files and return (best_path, scores).
+
+    candidates: list of paths; earlier entries win ties.
+    samples: list of (input_text, expected_output_text) pairs.
+    brute_path / gen_path: optional trusted brute force and generator. gen is called as
+        `python gen.py <seed> <mode>` with mode in {'small', 'large'}.
+    budget_seconds: optional overall wall-clock budget; pool generation stops when exceeded.
+    Returns (best_path or None, {path: (samples, brute, majority, -slow_or_failed)}).
+    """
+    cands = [c for c in candidates if c and os.path.isfile(c)]
+    if not cands:
+        return None, {}
+    tmpdir = tempfile.mkdtemp(prefix='select_')
+    t_start = clock()
+
+    def out_of_budget():
+        return budget_seconds is not None and clock() - t_start > budget_seconds
+
+    try:
+        # Private copies so the run is isolated from the repo.
+        local = []
+        for i, c in enumerate(cands):
+            dst = os.path.join(tmpdir, f'_cand{i}.py')
+            shutil.copyfile(c, dst)
+            local.append(dst)
+        brute_local = gen_local = None
+        if brute_path and os.path.isfile(brute_path):
+            brute_local = os.path.join(tmpdir, '_brute.py')
+            shutil.copyfile(brute_path, brute_local)
+        if gen_path and os.path.isfile(gen_path):
+            gen_local = os.path.join(tmpdir, '_gen.py')
+            shutil.copyfile(gen_path, gen_local)
+
+        # Pool entries: (kind, input_text, expected_output_or_None)
+        pool = [('sample', s_in, s_out) for s_in, s_out in samples]
+        if brute_local and gen_local:
+            for seed in range(small_seeds):
+                if out_of_budget():
+                    break
+                inp = _gen_input(gen_local, seed, 'small', tmpdir)
+                if inp is None:
+                    continue
+                exp = _brute_output(brute_local, inp, tmpdir)
+                if exp is not None:
+                    pool.append(('small', inp, exp))
+            for seed in range(large_seeds):
+                if out_of_budget():
+                    break
+                inp = _gen_input(gen_local, seed, 'large', tmpdir)
+                if inp is not None:
+                    pool.append(('large', inp, None))
+
+        # Run every candidate on every pool input.
+        # outputs[i][j] = normalised stdout, or None if the run failed.
+        outputs = [[None] * len(pool) for _ in cands]
+        slow = [0] * len(cands)
+        for i, path in enumerate(local):
+            for j, (_, inp, _) in enumerate(pool):
+                ok, out, el = _run_py(path, [], inp, tmpdir, RUN_TIMEOUT)
+                if el > time_limit or not ok:
+                    slow[i] += 1
+                outputs[i][j] = _norm(out) if ok else None
+
+        scores = {}
+        for i, c in enumerate(cands):
+            samples_ok = brute_ok = 0
+            for j, (kind, _, exp) in enumerate(pool):
+                if exp is None or outputs[i][j] is None:
+                    continue
+                if outputs[i][j] == _norm(exp):
+                    if kind == 'sample':
+                        samples_ok += 1
+                    elif kind == 'small':
+                        brute_ok += 1
+            majority = 0
+            for j, (kind, _, exp) in enumerate(pool):
+                if kind != 'large' or outputs[i][j] is None:
+                    continue
+                majority += sum(1 for k in range(len(cands))
+                                if k != i and outputs[k][j] == outputs[i][j])
+            scores[c] = (samples_ok, brute_ok, majority, -slow[i])
+
+        best = max(cands, key=lambda c: (scores[c], -cands.index(c)))
+        return best, scores
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def pick_and_copy(candidates, dest, **kwargs):
+    """Run select_best and copy the winner to dest. Returns (best, scores)."""
+    best, scores = select_best(candidates, **kwargs)
+    if best is not None and os.path.abspath(best) != os.path.abspath(dest):
+        shutil.copyfile(best, dest)
+    return best, scores
