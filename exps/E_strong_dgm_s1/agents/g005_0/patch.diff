+import os
+import subprocess
+import sys
+import tempfile
+import shutil
+
+
+def tool_info():
+    return {
+        "name": "layout_fuzz",
+        "description": """Run a Python solution on several alternative stdin layouts of the SAME logical test and return a raw table.
+
+* Use it to check the I/O contract: each layout is a complete stdin text. Typical layouts: a live-style input (only the data a live judge would send), a transcript-style input (the data plus pre-recorded responses already on stdin), an input where all tokens are on one line, and an input with extra trailing tokens.
+* Each layout may be an object with 'stdin' (required) and 'expected_output' (optional), or a plain string used as stdin.
+* The solution is run with `python3 -I`, with the layout fed to stdin and the given timeout per run.
+* Returns, per layout: index, exit code (or TIMEOUT), stdout head, stderr tail, and, if expected_output was given, whether stdout matches it (whitespace-insensitive).
+* Errors are NOT parsed; read the raw output and fix the solution accordingly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (e.g. solution.py)."
+                },
+                "layouts": {
+                    "type": "array",
+                    "description": "List of alternative stdin layouts for the same logical test. Each item is an object with 'stdin' (string, the full stdin text) and optional 'expected_output' (string), or a plain string holding the stdin text.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "stdin": {
+                                "type": "string",
+                                "description": "Complete stdin text for this layout."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Optional expected stdout for this layout."
+                            }
+                        },
+                        "required": ["stdin"]
+                    }
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 5)."
+                }
+            },
+            "required": ["solution_path", "layouts"]
+        }
+    }
+
+
+def _clip(s, n):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _tail(s, n):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return f"<{len(s) - n} earlier chars>..." + s[-n:]
+
+
+def _norm(s):
+    return ' '.join((s or '').split())
+
+
+def tool_function(solution_path, layouts=None, timeout=5):
+    try:
+        timeout = max(1, min(int(timeout or 5), 120))
+    except (TypeError, ValueError):
+        timeout = 5
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not layouts:
+        return "Error: no layouts given."
+
+    # Normalize every layout into (stdin_text, expected_or_None)
+    items = []
+    for i, lay in enumerate(layouts):
+        if isinstance(lay, str):
+            items.append((lay, None))
+        elif isinstance(lay, dict):
+            if 'stdin' not in lay:
+                return f"Error: layout {i} has no 'stdin' key."
+            exp = lay.get('expected_output')
+            items.append((str(lay['stdin']), None if exp is None else str(exp)))
+        else:
+            return f"Error: layout {i} must be an object or a string."
+
+    tmpdir = tempfile.mkdtemp(prefix='layout_fuzz_')
+    lines = []
+    try:
+        # Copy the solution so that the run does not depend on the working directory.
+        with open(solution_path, 'rb') as f:
+            code = f.read()
+        path = os.path.join(tmpdir, 'solution_under_test.py')
+        with open(path, 'wb') as f:
+            f.write(code)
+
+        for i, (text, expected) in enumerate(items):
+            try:
+                p = subprocess.run([sys.executable, '-I', path], input=text.encode('utf-8'),
+                                   capture_output=True, timeout=timeout, cwd=tmpdir)
+                rc = str(p.returncode)
+                out = p.stdout.decode('utf-8', errors='replace')
+                err = p.stderr.decode('utf-8', errors='replace')
+            except subprocess.TimeoutExpired as e:
+                rc = f'TIMEOUT({timeout}s)'
+                o = e.stdout or b''
+                r = e.stderr or b''
+                out = o.decode('utf-8', errors='replace') if isinstance(o, bytes) else str(o)
+                err = r.decode('utf-8', errors='replace') if isinstance(r, bytes) else str(r)
+            if expected is None:
+                match = 'n/a (no expected_output)'
+            else:
+                match = 'MATCH' if _norm(out) == _norm(expected) else 'DIFF'
+            lines.append(
+                f"layout={i} | stdin_tokens={len(text.split())} | exit={rc} | expected={match}\n"
+                f"  stdout(head): {_clip(out.strip(), 300)!r}\n"
+                f"  stderr(tail): {_tail(err.strip(), 800)!r}"
+            )
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    return "\n".join(lines)
