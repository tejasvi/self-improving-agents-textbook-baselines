+    def _primary_file_changed(self):
+        """
+        Return True if solution.py in git_tempdir differs from the base commit and contains
+        more than comments or whitespace.
+        """
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        try:
+            with open(path, 'r') as f:
+                current = f.read()
+        except OSError:
+            return False
+
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "show", f"{self.base_commit}:solution.py"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        base = result.stdout.decode(errors='replace') if result.returncode == 0 else None
+
+        if base is not None and current == base:
+            return False
+
+        meaningful = [
+            line for line in current.splitlines()
+            if line.strip() and not line.strip().startswith('#')
+        ]
+        return len(meaningful) > 0
+
