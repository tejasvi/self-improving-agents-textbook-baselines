+                lines.pop()
+            out_lines = [l for l in out.replace('\r\n', '\n').split('\n') if l.strip() != '']
+            try:
+                t = int(lines[0].strip()) if lines else 0
+            except ValueError:
+                t = 0
+            rest = lines[1:]
+            if t > 1 and len(out_lines) == t and rest and len(rest) % t == 0:
+                g = len(rest) // t
+                split = [("1\n" + "\n".join(rest[k * g:(k + 1) * g]) + "\n", out_lines[k] + "\n")
+                         for k in range(t)]
+            if split is None:
+                result.append((inp, out))
+            else:
+                result.extend(split)
+        return result
