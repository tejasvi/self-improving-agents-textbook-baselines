@@ -0,0 +1,83 @@
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+
+# Brute for: T cases, each "K" -> prints K*K. Refuses huge K like a real brute would.
+BRUTE_REFUSES_HUGE = (
+    "import sys\n"
+    "data = sys.stdin.read().split()\n"
+    "t = int(data[0])\n"
+    "for k in range(t):\n"
+    "    v = int(data[1 + k])\n"
+    "    if v > 1000:\n"
+    "        print('TOO LARGE', file=sys.stderr)\n"
+    "        sys.exit(1)\n"
+    "    print(v * v)\n"
+)
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "print(3)\n"
+       "for _ in range(3):\n"
+       "    print(random.randint(1, 9))\n")
+
+
+def _agent(tmp_path, brute, samples):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(brute)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(samples))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+def test_split_multi_case():
+    pairs = [("2\n3\n4\n", "9\n16\n")]
+    assert coding_agent.AgenticSystem._split_samples(pairs) == [
+        ("1\n3\n", "9\n"), ("1\n4\n", "16\n")]
+
+
+def test_split_single_case_unchanged():
+    pairs = [("5\n1 2 3 4 5\n", "15\n")]
+    assert coding_agent.AgenticSystem._split_samples(pairs) == pairs
+
+
+def test_split_non_numeric_first_line_unchanged():
+    pairs = [("hello world\n1 2\n", "3\n")]
+    assert coding_agent.AgenticSystem._split_samples(pairs) == pairs
+
+
+def test_split_output_line_count_mismatch_unchanged():
+    pairs = [("2\n3\n4\n", "9\n")]  # T=2 but only one output line
+    assert coding_agent.AgenticSystem._split_samples(pairs) == pairs
+
+
+def test_validator_accepts_brute_rejecting_huge_sample(tmp_path):
+    samples = [{"input": "1\n3\n", "output": "9\n"},
+               {"input": "1\n100000\n", "output": "10000000000\n"}]  # brute refuses this one
+    agent, _ = _agent(tmp_path, BRUTE_REFUSES_HUGE, samples)
+    ok, report = agent._validate_tests()
+    assert ok, report
+    assert agent.sample_only == {1}
+    assert agent.brute_verified == {0}
+    assert not agent.validation_fatal
+
+
+def test_validator_rejects_wrong_brute_and_names_sample(tmp_path):
+    samples = [{"input": "1\n3\n", "output": "9\n"},
+               {"input": "1\n4\n", "output": "17\n"}]  # brute prints 16
+    agent, _ = _agent(tmp_path, BRUTE_REFUSES_HUGE, samples)
+    ok, report = agent._validate_tests()
+    assert not ok
+    assert "sample 2" in report
+    assert "WRONG" in report
+    assert len(agent.wrong_samples) == 1
+    assert not agent.validation_fatal
