+    def _split_samples(pairs):
+        """
+        Best-effort split of multi-case samples. A sample whose first line is an integer T, whose output has
+        exactly T lines and whose remaining input lines divide evenly into T groups becomes T single-case
+        samples (first line '1'). Anything else is kept unchanged.
