+def _parse_float(tok):
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def _to_tol(v):
+    """Coerce a tolerance argument to a non-negative float (invalid/None -> 0.0)."""
+    try:
+        t = float(v) if v is not None else 0.0
+    except (TypeError, ValueError):
+        return 0.0
+    if t != t or t < 0:  # NaN or negative
+        return 0.0
+    return t
+
+
+def compare_outputs(a, b, rel_tol=0.0, abs_tol=0.0):
+    """Tolerance-aware comparison of two whitespace-tokenized outputs.
+
+    Returns (ok, errs, reason):
+      ok      -- True if the outputs match.
+      errs    -- list of (abs_err, rel_err) for every token pair where both tokens parse as floats.
+      reason  -- short description of the first mismatch ('' when ok).
+    With rel_tol == abs_tol == 0 the comparison is exact (string equality per token).
+    Otherwise, tokens that both parse as floats are accepted when
+    abs(x - y) <= max(abs_tol, rel_tol * abs(y)); other tokens must be equal strings.
+    """
+    rel_tol = _to_tol(rel_tol)
+    abs_tol = _to_tol(abs_tol)
+    exact = rel_tol == 0 and abs_tol == 0
+    ta = (a or "").split()
+    tb = (b or "").split()
+    if len(ta) != len(tb):
+        return False, [], f"token count differs (solution {len(ta)} vs brute {len(tb)})"
+    ok = True
+    reason = ""
+    errs = []
+    for idx, (x, y) in enumerate(zip(ta, tb), start=1):
+        fx = _parse_float(x)
+        fy = _parse_float(y)
+        if fx is not None and fy is not None:
+            ae = abs(fx - fy)
+            if ae != ae:  # NaN involved
+                re_ = float("inf")
+            elif fy != 0:
+                re_ = ae / abs(fy)
+            else:
+                re_ = 0.0 if ae == 0 else float("inf")
+            errs.append((ae, re_))
+            if exact:
+                good = (x == y)
+            else:
+                good = (x == y) or (ae <= max(abs_tol, rel_tol * abs(fy)))
+        else:
+            good = (x == y)
+        if not good and ok:
+            ok = False
+            if fx is not None and fy is not None and not exact:
+                reason = (f"token {idx}: solution {x} vs brute {y}, abs error {errs[-1][0]:.3e}, "
+                          f"rel error {errs[-1][1]:.3e} exceeds tolerance "
+                          f"(rel_tol={rel_tol:g}, abs_tol={abs_tol:g})")
+            else:
+                reason = f"token {idx}: solution {x!r} vs brute {y!r} differ"
+    return ok, errs, reason
+
+
+def outputs_match(a, b, rel_tol=0.0, abs_tol=0.0):
+    """True if outputs a and b match under the given tolerances (see compare_outputs)."""
+    return compare_outputs(a, b, rel_tol, abs_tol)[0]
+
+
+class MaxErr:
+    """Tracks the largest absolute and relative float error seen, with the seed that produced it."""
+
+    def __init__(self):
+        self.abs_val = None
+        self.abs_seed = None
+        self.rel_val = None
+        self.rel_seed = None
+        self.count = 0
+
+    def update(self, seed, errs):
+        for ae, re_ in errs:
+            self.count += 1
+            if self.abs_val is None or ae > self.abs_val:
+                self.abs_val, self.abs_seed = ae, seed
+            if self.rel_val is None or re_ > self.rel_val:
+                self.rel_val, self.rel_seed = re_, seed
+
+    def line(self):
+        if self.count == 0:
+            return "max_err: no float tokens compared"
+        return (f"max_err over {self.count} float tokens: max abs error {self.abs_val:.3e} (seed {self.abs_seed}), "
+                f"max rel error {self.rel_val:.3e} (seed {self.rel_seed})")
+
