+import os
+import re
+import time
+
+from tools.stress_test import _run, _cmd, _describe, _clip
+
+MAX_TESTS = 100000
+MAX_TIME_LIMIT = 60.0
+STRESS_RUN_TIMEOUT = 10
+STAGE_NAMES = ["samples", "stress", "timing"]
+
+
+def tool_info():
+    return {
+        "name": "check_solution",
+        "description": """Deterministic verification gate for a stdin/stdout solution. It runs three stages in order and returns a raw report (no error parsing):
+
+(1) samples: runs solution_path on each sample input and compares the whitespace-normalized stdout with the expected output.
+(2) stress: for seeds 0..num_tests-1 runs `gen_path <seed>` to get an input, then compares solution_path and brute_path outputs on it (whitespace-normalized). Reports the first mismatch with the input, expected output and actual output.
+(3) timing: runs solution_path on max_input_path (a maximum-size input) and reports runtime and PASS/FAIL against time_limit seconds.
+
+A stage that is missing its inputs is reported as MISSING and counts as not passed. The report ends with 'STAGES_PASSED: n/3' and 'GATE: PASS' or 'GATE: FAIL (first failing stage: X)'.
+Use it after every edit to solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout), e.g. solution.py."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference program (reads stdin, writes stdout). Needed for the stress stage."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator, run as `gen.py <seed>`; it prints one valid test input to stdout. Needed for the stress stage."
+                },
+                "sample_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Sample inputs. Each item is either a file path (its contents are used) or the literal input text."
+                },
+                "sample_outputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Expected outputs for the sample inputs, in the same order. Each item is either a file path or the literal expected text."
+                },
+                "max_input_path": {
+                    "type": "string",
+                    "description": "Path to a file holding a maximum-size valid input. Used for the timing stage."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random seeds for the stress stage (default 300)."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Time limit in seconds for the timing stage (default 2.0)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _load_text(item):
+    """A string is a file path if it names an existing file, otherwise literal text."""
+    if isinstance(item, str) and os.path.isfile(item):
+        with open(item, "r", encoding="utf-8", errors="replace") as f:
+            return f.read()
+    return "" if item is None else str(item)
+
+
+def _norm(s):
+    return " ".join((s or "").split())
+
+
+def _stage_samples(sol_cmd, sample_inputs, sample_outputs):
+    if not sample_inputs:
+        return False, "samples: MISSING (no sample_inputs given)"
+    if not sample_outputs or len(sample_outputs) != len(sample_inputs):
+        n_out = len(sample_outputs or [])
+        return False, (f"samples: FAIL (sample_inputs has {len(sample_inputs)} items but "
+                       f"sample_outputs has {n_out}; they must match)")
+    blocks = []
+    ok_count = 0
+    for i, (raw_in, raw_out) in enumerate(zip(sample_inputs, sample_outputs), start=1):
+        data_in = _load_text(raw_in)
+        if data_in and not data_in.endswith("\n"):
+            data_in += "\n"
+        expected = _load_text(raw_out)
+        r = _run(sol_cmd, data_in.encode("utf-8"), STRESS_RUN_TIMEOUT)
+        if r["timeout"]:
+            blocks.append(f"sample {i}: TIMEOUT after {r['elapsed']:.2f}s\n  input: {_clip(data_in, 1000)!r}")
+            continue
+        if r["rc"] != 0:
+            blocks.append(f"sample {i}: NON-ZERO EXIT {r['rc']}\n  input: {_clip(data_in, 1000)!r}\n"
+                          f"  stderr: {_clip(r['stderr'], 1500)!r}")
+            continue
+        if _norm(r["stdout"]) != _norm(expected):
+            blocks.append(f"sample {i}: WRONG ANSWER\n  input: {_clip(data_in, 1000)!r}\n"
+                          f"  expected: {_clip(expected.strip(), 1000)!r}\n"
+                          f"  actual: {_clip(r['stdout'].strip(), 1000)!r}")
+            continue
+        ok_count += 1
+    total = len(sample_inputs)
+    if ok_count == total:
+        return True, f"samples: PASS ({ok_count}/{total} samples matched)"
+    return False, (f"samples: FAIL ({ok_count}/{total} samples matched)\n" + "\n".join(blocks))
+
+
+def _stage_stress(sol_cmd, brute_path, gen_path, num_tests):
+    if not brute_path or not os.path.isfile(brute_path):
+        return False, f"stress: MISSING (brute_path not found: {brute_path})"
+    if not gen_path or not os.path.isfile(gen_path):
+        return False, f"stress: MISSING (gen_path not found: {gen_path})"
+    brute_cmd = _cmd(brute_path)
+    gen_cmd = _cmd(gen_path)
+    passes = 0
+    for k in range(num_tests):
+        seed = k
+        g = _run(gen_cmd + [str(seed)], b"", STRESS_RUN_TIMEOUT)
+        if g["timeout"] or g["rc"] != 0:
+            status = f"TIMEOUT after {STRESS_RUN_TIMEOUT}s" if g["timeout"] else f"exit={g['rc']}"
+            return False, (f"stress: FAIL (GENERATOR FAILED at seed {seed} ({status}) after {passes} passing tests)\n"
+                           f"--- generator stderr ---\n{_clip(g['stderr'])}")
+        data = g["stdout"].encode("utf-8")
+        sol = _run(sol_cmd, data, STRESS_RUN_TIMEOUT)
+        brute = _run(brute_cmd, data, STRESS_RUN_TIMEOUT)
+        if brute["timeout"] or brute["rc"] != 0:
+            return False, (f"stress: FAIL (BRUTE FORCE FAILED at seed {seed} after {passes} passing tests; "
+                           f"fix brute.py)\n--- input ---\n{_clip(g['stdout'])}\n" + _describe("brute", brute))
+        same = (not sol["timeout"] and sol["rc"] == 0 and _norm(sol["stdout"]) == _norm(brute["stdout"]))
+        if not same:
+            return False, (f"stress: FAIL (MISMATCH at seed {seed}, test {k + 1} of {num_tests}, "
+                           f"after {passes} passing tests)\n--- input ---\n{_clip(g['stdout'])}\n"
+                           + _describe("solution", sol) + _describe("brute", brute))
+        passes += 1
+    return True, f"stress: PASS ({passes}/{num_tests} random tests matched brute force)"
+
+
+def _stage_timing(sol_cmd, max_input_path, time_limit):
+    if not max_input_path or not os.path.isfile(max_input_path):
+        return False, f"timing: MISSING (max_input_path not found: {max_input_path})"
+    with open(max_input_path, "rb") as f:
+        data = f.read()
+    run_timeout = max(5.0, 5.0 * time_limit)
+    r = _run(sol_cmd, data, run_timeout)
+    if r["timeout"]:
+        return False, (f"timing: FAIL (TIMEOUT: no finish within {run_timeout:.1f}s on {max_input_path}; "
+                       f"time limit is {time_limit:.2f}s)")
+    if r["rc"] != 0:
+        return False, (f"timing: FAIL (NON-ZERO EXIT {r['rc']} on max input)\n"
+                       f"--- stderr ---\n{_clip(r['stderr'], 1500)}")
+    elapsed = r["elapsed"]
+    if elapsed > time_limit:
+        return False, (f"timing: FAIL (runtime {elapsed:.2f}s > limit {time_limit:.2f}s on {max_input_path}; "
+                       f"the solution must be optimized)")
+    return True, f"timing: PASS (runtime {elapsed:.2f}s <= limit {time_limit:.2f}s on {max_input_path})"
+
+
+def tool_function(solution_path, brute_path=None, gen_path=None, sample_inputs=None, sample_outputs=None,
+                  max_input_path=None, num_tests=300, time_limit=2.0):
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}\nSTAGES_PASSED: 0/3\nGATE: FAIL (first failing stage: samples)"
+    try:
+        num_tests = max(1, min(int(num_tests if num_tests is not None else 300), MAX_TESTS))
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        time_limit = float(time_limit if time_limit is not None else 2.0)
+        time_limit = max(0.1, min(time_limit, MAX_TIME_LIMIT))
+    except (TypeError, ValueError):
+        time_limit = 2.0
+
+    sol_cmd = _cmd(solution_path)
+    sample_inputs = list(sample_inputs or [])
+    sample_outputs = list(sample_outputs or [])
+
+    results = []
+    results.append(_stage_samples(sol_cmd, sample_inputs, sample_outputs))
+    results.append(_stage_stress(sol_cmd, brute_path, gen_path, num_tests))
+    results.append(_stage_timing(sol_cmd, max_input_path, time_limit))
+
+    lines = ["=== check_solution report ==="]
+    passed = 0
+    first_fail = None
+    for idx, (ok, text) in enumerate(results, start=1):
+        lines.append(f"[stage {idx}/3] {text}")
+        if ok:
+            passed += 1
+        elif first_fail is None:
+            first_fail = STAGE_NAMES[idx - 1]
+    lines.append(f"STAGES_PASSED: {passed}/3")
+    if first_fail is None:
+        lines.append("GATE: PASS (all stages passed)")
+    else:
+        lines.append(f"GATE: FAIL (first failing stage: {first_fail})")
+    return "\n".join(lines)
