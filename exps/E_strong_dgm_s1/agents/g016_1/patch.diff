+    def _send(self, msg, history):
+        """Send msg; if the reply is empty or truncated, re-prompt with 'continue' (bounded)."""
+        for _ in range(MAX_CONTINUES + 1):
+            history = chat_with_agent(msg, model=self.code_model, msg_history=history, logging=safe_log)
+            text = self._last_text(history).strip()
+            if len(text) >= MIN_REPLY_CHARS:
+                return history
+            safe_log("Empty or truncated reply; re-prompting with 'continue'.")
+            msg = self._continue_text()
+        return history
+
+    @staticmethod
+    def _parse_gate(report):
+        """Return (stages_passed, first_failing_stage or None) from a check_solution report."""
+        m = re.search(r"STAGES_PASSED:\s*(\d+)/3", report or "")
+        passed = int(m.group(1)) if m else 0
+        m2 = re.search(r"first failing stage:\s*(\w+)", report or "")
+        failed = m2.group(1) if m2 else None
+        return passed, failed
+
