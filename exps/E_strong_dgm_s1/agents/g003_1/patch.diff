+def _weak_verdict(outputs, num_tests):
+    """Return (stats_line, weak_flag) for a list of normalised brute outputs."""
+    counts = Counter('\n'.join(o) for o in outputs)
+    total = sum(counts.values())
+    distinct = len(counts)
+    top_frac = (max(counts.values()) / total) if total else 0.0
+    stats = f"brute output stats: distinct={distinct}, top_frac={top_frac:.2f}"
+    weak = num_tests >= 100 and total > 0 and (distinct < 5 or top_frac > 0.7)
+    return stats, weak
+
