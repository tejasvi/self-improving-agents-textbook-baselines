+def run_stress(solution_path, brute_path, gen_path, seeds, modes=None, timeout=10, budget=_STRESS_BUDGET):
+    """
+    Compare solution against brute on generated inputs for every (mode, seed) pair.
+    Runs all cases (does not stop at the first failure) unless the wall-clock budget is hit.
+    Returns dict: total (planned cases), ran, passed, crashed, max_time, budget_hit,
+                  first_failure (raw report text or None), first_failure_kind (or None).
+    """
+    seeds = list(seeds)
+    modes = [None] if not modes else list(modes)
+    cases = [(m, s) for m in modes for s in seeds]
+    result = {'total': len(cases), 'ran': 0, 'passed': 0, 'crashed': 0, 'max_time': 0.0,
+              'budget_hit': False, 'first_failure': None, 'first_failure_kind': None}
+    if not cases:
+        return result
+    tmpdir = _tmp_with({'_sol.py': solution_path, '_brute.py': brute_path, '_gen.py': gen_path})
+    try:
+        t_start = time.monotonic()
+        for mode, seed in cases:
+            if time.monotonic() - t_start > budget:
+                result['budget_hit'] = True
+                break
+            result['ran'] += 1
+            kind, detail, el = _one_case(tmpdir, seed, mode, timeout)
+            result['max_time'] = max(result['max_time'], el)
+            if kind == 'ok':
+                result['passed'] += 1
+                continue
+            if kind == 'crash':
+                result['crashed'] += 1
+            if result['first_failure'] is None:
+                result['first_failure'] = detail
+                result['first_failure_kind'] = kind
+        return result
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
