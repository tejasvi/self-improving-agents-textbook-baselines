+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+
+BRUTE = "a, b = map(int, input().split())\nprint(a + b)\n"
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode == 'max':\n"
+       "    print(10**9, 10**9)\n"
+       "else:\n"
+       "    print(random.randint(0, 9), random.randint(0, 9))\n")
+SAMPLES = [{"input": "1 2\n", "output": "3\n"}, {"input": "5 5\n", "output": "10\n"}]
+
+
+def _agent(tmp_path, samples=SAMPLES):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(BRUTE)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(samples))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+CORRECT = BRUTE
+WRONG_SAMPLES_ONLY = "a, b = map(int, input().split())\nprint(a + b if (a, b) == (1, 2) else 0)\n"
+CRASHING = "a, b = map(int, input().split())\nprint(a + b)\nraise SystemExit(1)\n"
+WRONG_ALL = "a, b = map(int, input().split())\nprint(a + b + 1)\n"
+
+
+def _write(root, name, src):
+    p = root / "cands" / name
+    p.write_text(src)
+    return str(p)
+
+
+def test_perfect_candidate_scores_top(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(_write(root, "good.py", CORRECT))
+    assert score[0] == 2 and score[2] == 1 and score[1] > 0
+    assert rep.splitlines()[-1] == "RESULT: OK"
+
+
+def test_scores_order_candidates_and_pick_highest(tmp_path):
+    agent, root = _agent(tmp_path)
+    cands = {
+        "crash.py": CRASHING,
+        "wrong.py": WRONG_ALL,
+        "good.py": CORRECT,
+    }
+    entries = []
+    for name, src in cands.items():
+        score, rep = agent._score_candidate(_write(root, name, src))
+        entries.append((score, str(root / "cands" / name), rep))
+    best = agent._pick_best(entries)
+    assert best[1].endswith("good.py")
+    by_name = {os.path.basename(p): s for s, p, _ in entries}
+    assert by_name["good.py"] > by_name["wrong.py"]
+    assert by_name["good.py"][2] == 1
+    assert by_name["crash.py"][2] == 0
+    assert by_name["wrong.py"][0] == 0
+
+
+def test_partial_sample_credit_counts(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(_write(root, "partial.py", WRONG_SAMPLES_ONLY))
+    assert score[0] == 1  # (1, 2) matches the sample; (5, 5) does not
+    assert score[2] == 1  # no crash, just wrong answers
+    assert "RESULT: FAILED" in rep
+
+
+def test_pick_best_ties_keep_earliest_and_empty_is_none(tmp_path):
+    assert coding_agent.AgenticSystem._pick_best([]) is None
+    entries = [((2, 5, 1), "a.py", ""), ((2, 5, 1), "b.py", "")]
+    assert coding_agent.AgenticSystem._pick_best(entries)[1] == "a.py"
+
+
+def test_missing_candidate_scores_zero(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(str(root / "cands" / "nope.py"))
+    assert score == (0, 0, 0)
+    assert "not found" in rep
+
+
+def test_run_stress_reports_first_failure_and_counts(tmp_path):
+    root = tmp_path
+    (root / "good.py").write_text(CORRECT)
+    (root / "brute.py").write_text(BRUTE)
+    (root / "gen.py").write_text(GEN)
+    (root / "wrong.py").write_text(WRONG_ALL)
+    res = solution_check.run_stress(str(root / "wrong.py"), str(root / "brute.py"), str(root / "gen.py"),
+                                    range(3), modes=['small'], timeout=10)
+    assert res['total'] == 3 and res['passed'] == 0 and res['first_failure_kind'] == 'wrong'
+    assert "WRONG ANSWER" in res['first_failure']
+    ok = solution_check.run_stress(str(root / "good.py"), str(root / "brute.py"), str(root / "gen.py"),
+                                   range(3), modes=['small', 'edge'], timeout=10)
+    assert ok['total'] == 6 and ok['passed'] == 6 and ok['first_failure'] is None
+
+
+def test_generator_mode_is_optional(tmp_path):
+    (tmp_path / "gen.py").write_text(GEN)
+    text, err = solution_check.generate_input(str(tmp_path / "gen.py"), 3)
+    assert text is not None and err == ''
+    text, err = solution_check.generate_input(str(tmp_path / "gen.py"), 0, 'max')
+    assert text.strip() == "1000000000 1000000000"
+
+
+def test_pick_best_works_with_harness_report_last_line(tmp_path):
+    agent, root = _agent(tmp_path)
+    assert agent._is_perfect_report("x\nRESULT: OK")
+    assert not agent._is_perfect_report("x\nRESULT: FAILED")
+    assert not agent._is_perfect_report("")
