+def run_plain(solution_path, inputs, expected_outputs=None, timeout=10):
+    """
+    Run the solution on fixed inputs.
+    Returns dict: passed, total, max_time, crashed (timeouts / nonzero exit / stderr), report (failure text).
+    """
+    tmpdir = _tmp_with({'_sol.py': solution_path})
+    try:
+        passed, max_t, crashed = 0, 0.0, 0
+        blocks = []
+        for i, inp in enumerate(inputs):
+            status, out, err, rc, el = _run([sys.executable, '-I', '_sol.py'], tmpdir, inp, timeout)
+            max_t = max(max_t, el)
+            problems = []
+            if status == 'timeout':
+                problems.append("timeout")
+            if rc != 0:
+                problems.append(f"exit code {rc}")
+            if err.strip():
+                problems.append("stderr is not empty")
+            if _solution_crashed(status, rc, err):
+                crashed += 1
+            if expected_outputs is not None and i < len(expected_outputs) and status == 'ok':
+                if _normalise(out) != _normalise(expected_outputs[i]):
