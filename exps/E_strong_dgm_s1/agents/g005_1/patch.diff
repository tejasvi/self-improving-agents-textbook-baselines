+def _one_case(tmpdir, seed, mode, timeout):
+    """
+    Evaluate one stress case in tmpdir (containing _sol.py, _brute.py, _gen.py).
+    Returns (kind, detail, elapsed) where kind is ok | gen | brute | crash | wrong.
+    """
+    label = f"seed {seed}" + ("" if mode is None else f" mode {mode}")
+    gst, gen_out, gerr, grc, _ = _run([sys.executable, '-I', '_gen.py', *_gen_args(seed, mode)], tmpdir, '', timeout)
+    if gst != 'ok' or grc != 0:
+        return 'gen', f"generator failed on {label}\n" + _fmt_run("gen", gst, gen_out, gerr, grc, 0.0), 0.0
+    test_in = gen_out
