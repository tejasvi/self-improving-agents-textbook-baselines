new file mode 100644
index 0000000..2b108d7
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,178 @@
+import os
+import re
+import subprocess
+import time
+
+MAX_SHOW = 2000
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution on every sample test in a folder and compare its output with the expected output.\n
+* `samples_dir` is a folder containing pairs `sampleN.in` / `sampleN.out` (N = 1, 2, ...). Save every sample from the statement this way first.
+* `solution_cmd` is the shell command reading stdin and writing stdout (e.g. `python3 solution.py`). It is run once per sample with stdin taken from the `.in` file.
+* `cwd` is an optional working directory for the command (use an absolute path, e.g. the repository directory).
+* `rel_tol` is the relative/absolute tolerance used for the numeric comparison of each token (default 1e-6).
+* For each sample it reports PASS (exact match after whitespace normalization), NUMERIC MATCH ONLY (numbers agree within rel_tol but the text differs, e.g. different number of decimals), or FAIL, together with the expected and actual output.
+* A NUMERIC MATCH ONLY result is NOT acceptable: graders may compare text strictly. Print floating-point answers with at least as many significant digits as the expected output shows (use decimal/Fraction or high-precision formatting) and rerun until every sample is an exact PASS.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command running the solution (reads stdin, writes stdout), e.g. 'python3 solution.py'."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Folder containing sampleN.in and sampleN.out files (N = 1, 2, ...)."
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Optional working directory to run solution_cmd in (absolute path recommended). Defaults to the current directory."
+                },
+                "rel_tol": {
+                    "type": "number",
+                    "description": "Tolerance for the numeric comparison of tokens (default 1e-6). Only used to detect NUMERIC MATCH ONLY cases."
+                }
+            },
+            "required": ["solution_cmd", "samples_dir"]
+        }
+    }
+
+
+def _clip(s, n=MAX_SHOW):
+    if s is None:
+        return ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _norm(s):
+    return "\n".join(line.rstrip() for line in s.strip().splitlines())
+
+
+def _tokens(s):
+    return s.split()
+
+
+def _to_float(tok):
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def _numeric_match(expected, actual, rel_tol):
+    """Token-by-token comparison: numeric tokens within tolerance, others must be equal."""
+    et, at = _tokens(expected), _tokens(actual)
+    if len(et) != len(at):
+        return False
+    for e, a in zip(et, at):
+        if e == a:
+            continue
+        ef, af = _to_float(e), _to_float(a)
+        if ef is None or af is None:
+            return False
+        if abs(ef - af) > max(rel_tol, rel_tol * abs(ef)):
+            return False
+    return True
+
+
+def _decimal_count(s):
+    """Maximum number of digits after the decimal point among tokens of s."""
+    best = 0
+    for tok in _tokens(s):
+        m = re.fullmatch(r"[+-]?\d*\.(\d+)(?:[eE][+-]?\d+)?", tok)
+        if m:
+            best = max(best, len(m.group(1)))
+    return best
+
+
+def _run_one(solution_cmd, stdin_text, cwd, timeout=20):
+    start = time.time()
+    try:
+        p = subprocess.run(solution_cmd, shell=True, input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, cwd=cwd, errors="replace")
+        return p.returncode, p.stdout, p.stderr, time.time() - start, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ""
+        err = e.stderr if isinstance(e.stderr, str) else ""
+        return None, out, err, time.time() - start, True
+
+
+def tool_function(solution_cmd, samples_dir, cwd=None, rel_tol=1e-6):
+    try:
+        rel_tol = float(rel_tol if rel_tol is not None else 1e-6)
+    except (TypeError, ValueError):
+        return "Error: rel_tol must be a number."
+    if cwd is not None and not os.path.isdir(cwd):
+        return f"Error: cwd is not a directory: {cwd}"
+    if not os.path.isdir(samples_dir):
+        return f"Error: samples_dir is not a directory: {samples_dir}"
+
+    indices = []
+    for name in os.listdir(samples_dir):
+        m = re.fullmatch(r"sample(\d+)\.in", name)
+        if m and os.path.isfile(os.path.join(samples_dir, f"sample{m.group(1)}.out")):
+            indices.append(int(m.group(1)))
+    if not indices:
+        return f"Error: no sampleN.in / sampleN.out pairs found in {samples_dir}."
+    indices.sort()
+
+    lines = []
+    all_strict = True
+    any_numeric_only = False
+    for i in indices:
+        with open(os.path.join(samples_dir, f"sample{i}.in")) as f:
+            stdin_text = f.read()
+        with open(os.path.join(samples_dir, f"sample{i}.out")) as f:
+            expected = f.read()
+
+        rc, out, err, elapsed, to = _run_one(solution_cmd, stdin_text, cwd)
+        lines.append(f"=== sample {i} ===")
+        if to:
+            all_strict = False
+            lines.append(f"FAIL: timed out after {elapsed:.1f}s")
+            if err:
+                lines.append("stderr:\n" + _clip(err, 800))
+            continue
+        if rc != 0:
+            all_strict = False
+            lines.append(f"FAIL: solution exited with code {rc}")
+            if err:
+                lines.append("stderr:\n" + _clip(err, 1200))
+            continue
+
+        strict = _norm(out) == _norm(expected)
+        if strict:
+            lines.append(f"PASS (exact match, {elapsed:.2f}s)")
+        else:
+            numeric = _numeric_match(expected, out, rel_tol)
+            all_strict = False
+            if numeric:
+                any_numeric_only = True
+                exp_dec, got_dec = _decimal_count(expected), _decimal_count(out)
+                lines.append(
+                    "NUMERIC MATCH ONLY: output text differs from expected "
+                    f"(expected has {exp_dec} decimals, got {got_dec}); "
+                    "graders may compare strictly, increase printed precision"
+                )
+            else:
+                lines.append("FAIL: output differs from expected")
+            if err:
+                lines.append("stderr:\n" + _clip(err, 800))
+        lines.append("--- expected ---")
+        lines.append(_clip(_norm(expected)) or "(empty)")
+        lines.append("--- actual ---")
+        lines.append(_clip(_norm(out)) or "(empty)")
+
+    summary = []
+    if all_strict:
+        summary.append(f"ALL {len(indices)} SAMPLES PASSED (exact match).")
+    else:
+        summary.append(f"NOT ALL SAMPLES PASSED EXACTLY ({len(indices)} samples checked).")
+        if any_numeric_only:
+            summary.append("WARNING: some samples match only numerically. Fix the printed precision/format so the text matches the expected output.")
+    return "\n".join(summary + [""] + lines)
