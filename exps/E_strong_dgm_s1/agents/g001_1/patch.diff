+    @staticmethod
+    def _is_helper_file(path):
+        """True for test files and helper scripts (brute force, generators, tests dirs)."""
+        parts = path.replace('\\', '/').split('/')
+        base = parts[-1]
+        if any(part in ('tests', 'test') for part in parts[:-1]):
+            return True
+        if base.startswith('test_') or base.endswith('_test.py') or base.endswith('.spec.js') or base.endswith('.test.js'):
+            return True
+        if base in ('brute.py', 'gen.py', 'conftest.py'):
+            return True
+        return False
+
+    def _has_primary_edit(self):
+        """
+        True if at least one changed file is a primary source file (not a test/helper file).
+        If solution.py exists in the repo, it must also contain non-comment code.
+        """
+        try:
+            changed = self._changed_files()
+        except Exception:
+            return False
+        primary = [f for f in changed if not self._is_helper_file(f)]
+        if not primary:
+            return False
+        solution_path = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.exists(solution_path):
+            with open(solution_path, 'r', encoding='utf-8', errors='replace') as f:
+                has_code = any(
+                    line.strip() and not line.strip().startswith('#')
+                    for line in f
+                )
+            if not has_code:
+                return False
+        return True
