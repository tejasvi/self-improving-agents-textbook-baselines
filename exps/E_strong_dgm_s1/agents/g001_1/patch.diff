+import os
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+
+
+def _git(repo, *args):
+    subprocess.run(["git", "-C", str(repo), *args], check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def _make_repo(tmp_path):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    _git(repo, "config", "user.email", "t@example.com")
+    _git(repo, "config", "user.name", "t")
+    (repo / "solution.py").write_text("# placeholder\n")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-qm", "base")
+    commit = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"],
+                            stdout=subprocess.PIPE, check=True).stdout.decode().strip()
+    return repo, commit
+
+
+def _agent(repo, commit):
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(repo)
+    agent.base_commit = commit
+    return agent
+
+
+def test_has_primary_edit_no_diff(tmp_path):
+    repo, commit = _make_repo(tmp_path)
+    assert _agent(repo, commit)._has_primary_edit() is False
+
+
+def test_has_primary_edit_only_test_and_helper_files(tmp_path):
+    repo, commit = _make_repo(tmp_path)
+    (repo / "brute.py").write_text("print(1)\n")
+    (repo / "gen.py").write_text("print(2)\n")
+    (repo / "test_foo.py").write_text("def test_x(): pass\n")
+    (repo / "tests").mkdir()
+    (repo / "tests" / "check.py").write_text("x = 1\n")
+    assert _agent(repo, commit)._has_primary_edit() is False
+
+
+def test_has_primary_edit_solution_changed(tmp_path):
+    repo, commit = _make_repo(tmp_path)
+    (repo / "solution.py").write_text("print(int(input()) * 2)\n")
+    assert _agent(repo, commit)._has_primary_edit() is True
+
+
+def test_has_primary_edit_placeholder_only_comments_is_false(tmp_path):
+    repo, commit = _make_repo(tmp_path)
+    (repo / "solution.py").write_text("# still a placeholder\n# more comments\n")
+    assert _agent(repo, commit)._has_primary_edit() is False
+
+
+def test_has_primary_edit_other_source_file(tmp_path):
+    repo, commit = _make_repo(tmp_path)
+    (repo / "solution.py").write_text("print('hi')\n")
+    (repo / "main.py").write_text("print('hi')\n")
+    assert _agent(repo, commit)._has_primary_edit() is True
