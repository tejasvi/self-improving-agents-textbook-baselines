+import os
+import subprocess
+import sys
+import time
+
+MAX_SEEDS = 2000
+MAX_TIMEOUT = 60
+CLIP = 6000
+
+
+def tool_info():
+    return {
+        "name": "small_table",
+        "description": """Tabulate a program's answers on many small inputs, to discover formulas and DP structure.
+
+* For each seed in [seed_start, seed_start + num_seeds): runs `generator_path <seed> <tier>` to get one input (the seed is argv[1], the tier argv[2]; use tier 1 for small inputs), feeds that input to `program_path` (e.g. the brute force), and records the input and the output.
+* Prints a compact table with one line per seed: the input (whitespace collapsed, clipped) and the output (whitespace collapsed, clipped). Duplicate inputs are shown once with a count.
+* Errors and timeouts are printed raw for each seed; the table keeps going.
+* Use it on brute.py with gen.py to print brute-force answers for all small inputs before hypothesising a formula.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {
+                    "type": "string",
+                    "description": "Path to the program to tabulate (reads stdin, writes stdout), e.g. the brute force brute.py."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the input generator, run as `generator <seed> <tier>`; it prints one valid input to stdout."
+                },
+                "num_seeds": {
+                    "type": "integer",
+                    "description": "How many seeds to tabulate (default 50, max 2000)."
+                },
+                "seed_start": {
+                    "type": "integer",
+                    "description": "First seed value (default 0)."
+                },
+                "tier": {
+                    "type": "integer",
+                    "description": "Size tier passed as argv[2] to the generator (default 1, small inputs)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for the generator and the program (default 10)."
+                }
+            },
+            "required": ["program_path", "generator_path"]
+        }
+    }
+
+
+def _cmd(path):
+    if path.endswith(".py"):
+        return [sys.executable, path]
+    return [os.path.abspath(path)]
+
+
+def _run(cmd, data, timeout):
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, timeout=timeout)
+        return {
+            "timeout": False,
+            "rc": p.returncode,
+            "stdout": p.stdout.decode("utf-8", errors="replace"),
+            "stderr": p.stderr.decode("utf-8", errors="replace"),
+        }
+    except subprocess.TimeoutExpired:
+        return {"timeout": True, "rc": None, "stdout": "", "stderr": ""}
+
+
+def _one_line(s, n):
+    s = " ".join((s or "").split())
+    return s if len(s) <= n else s[:n] + "...<clipped>"
+
+
+def tool_function(program_path, generator_path, num_seeds=50, seed_start=0, tier=1, timeout=10):
+    for label, p in [("program", program_path), ("generator", generator_path)]:
+        if not p or not os.path.isfile(p):
+            return f"Error: {label} file not found: {p}"
+    try:
+        num_seeds = max(1, min(int(num_seeds if num_seeds is not None else 50), MAX_SEEDS))
+    except (TypeError, ValueError):
+        num_seeds = 50
+    try:
+        seed_start = int(seed_start if seed_start is not None else 0)
+    except (TypeError, ValueError):
+        seed_start = 0
+    try:
+        tier = int(tier if tier is not None else 1)
+    except (TypeError, ValueError):
+        tier = 1
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else 10), MAX_TIMEOUT))
+    except (TypeError, ValueError):
+        timeout = 10
+
+    prog_cmd = _cmd(program_path)
+    gen_cmd = _cmd(generator_path)
+    entries = []      # one per distinct input, in first-seen order
+    by_key = {}
+    errors = []
+    t0 = time.time()
+    for k in range(num_seeds):
+        seed = seed_start + k
+        g = _run(gen_cmd + [str(seed), str(tier)], b"", timeout)
+        if g["timeout"] or g["rc"] != 0:
+            status = "TIMEOUT" if g["timeout"] else f"exit={g['rc']}"
+            errors.append(f"seed {seed}: GENERATOR FAILED ({status})")
+            continue
+        inp = g["stdout"]
+        key = " ".join(inp.split())
+        if key in by_key:
+            by_key[key]["count"] += 1
+            continue
+        r = _run(prog_cmd, inp.encode("utf-8"), timeout)
+        if r["timeout"]:
+            out = "TIMEOUT"
+        elif r["rc"] != 0:
+            out = f"ERROR exit={r['rc']} stderr={_one_line(r['stderr'], 200)}"
+        else:
+            out = _one_line(r["stdout"], 300)
+        entry = {"seed": seed, "count": 1, "input": _one_line(inp, 300), "output": out}
+        by_key[key] = entry
+        entries.append(entry)
+
+    lines = [f"small_table: {num_seeds} seeds from {seed_start}, tier {tier} "
+             f"({time.time() - t0:.1f}s), {len(entries)} distinct inputs",
+             "seed [xCount] | input -> output"]
+    for e in entries:
+        cnt = f" x{e['count']}" if e["count"] > 1 else ""
+        lines.append(f"{e['seed']}{cnt} | {e['input']} -> {e['output']}")
+    lines.extend(errors)
+    text = "\n".join(lines)
+    if len(text) > CLIP:
+        text = text[:CLIP] + f"\n...<{len(text) - CLIP} more chars>"
+    return text
