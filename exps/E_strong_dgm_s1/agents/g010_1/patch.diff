+import os
+import pytest
+
+pytest.importorskip("llm_withtools")
+import coding_agent
+from coding_agent import AgenticSystem
+
+
+def _make_system(tmp_path):
+    # Bypass __init__ (which sets up logging and needs git); only git_tempdir is used by the helper.
+    sys_obj = AgenticSystem.__new__(AgenticSystem)
+    sys_obj.git_tempdir = str(tmp_path)
+    return sys_obj
+
+
+def test_solution_ready_missing(tmp_path):
+    assert _make_system(tmp_path)._solution_ready() is False
+
+
+def test_solution_ready_empty_or_whitespace(tmp_path):
+    (tmp_path / "solution.py").write_text("")
+    assert _make_system(tmp_path)._solution_ready() is False
+    (tmp_path / "solution.py").write_text("   \n\t\n")
+    assert _make_system(tmp_path)._solution_ready() is False
+
+
+def test_solution_ready_syntax_error(tmp_path):
+    (tmp_path / "solution.py").write_text("def f(:\n")
+    assert _make_system(tmp_path)._solution_ready() is False
+
+
+def test_solution_ready_valid(tmp_path):
+    (tmp_path / "solution.py").write_text("print(1)\n")
+    assert _make_system(tmp_path)._solution_ready() is True
