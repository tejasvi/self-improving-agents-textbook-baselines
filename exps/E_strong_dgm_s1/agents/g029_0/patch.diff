index 42b5599..04a9edf 100644
--- a/tools/stress_test.py
+++ b/tools/stress_test.py
@@ -6,6 +6,62 @@ import time
 MAX_TESTS = 100000
 MAX_TIMEOUT = 60
 CLIP = 4000
+DEFAULT_FLOAT_TOL = 1e-6
+
+
+FLOAT_MARKERS = ('.', 'e', 'inf', 'nan')
+
+
+def _is_float_token(tok):
+    low = tok.lower()
+    return any(m in low for m in FLOAT_MARKERS)
+
+
+def _fmt_err(x):
+    return "0" if x == 0 else f"{x:.2e}"
+
+
+def _same(actual, expected, tol):
+    """Token-wise comparison of two outputs.
+
+    Both outputs are split into whitespace tokens; the token counts must match.
+    A token pair that differs as text is accepted only if both tokens parse as float,
+    one of them contains '.', 'e', 'inf' or 'nan', and |a-b| <= tol*max(1,|b|).
+    Every other token must be identical.
+    Returns (ok, max_rel_err, all_exact, reason). max_rel_err is over the float pairs
+    that differed as text (0 if none); all_exact is True when every token matched as text.
+    """
+    a_toks = (actual or "").split()
+    e_toks = (expected or "").split()
+    if len(a_toks) != len(e_toks):
+        return False, 0.0, False, (f"token count differs (solution {len(a_toks)} tokens, "
+                                   f"expected {len(e_toks)} tokens)")
+    max_rel = 0.0
+    all_exact = True
+    for i, (x, y) in enumerate(zip(a_toks, e_toks)):
+        if x == y:
+            continue
+        all_exact = False
+        try:
+            fx = float(x)
+            fy = float(y)
+        except ValueError:
+            return False, max_rel, False, f"token {i + 1}: {x!r} != {y!r} (not numeric)"
+        if not (_is_float_token(x) or _is_float_token(y)):
+            return False, max_rel, False, f"token {i + 1}: {x!r} != {y!r} (integer/text must match exactly)"
+        if fx == fy:
+            rel = 0.0
+        else:
+            rel = abs(fx - fy) / max(1.0, abs(fy))
+        max_rel = max(max_rel, rel)
+        if not (rel <= tol):
+            return False, max_rel, False, (f"token {i + 1}: {x!r} vs expected {y!r}, "
+                                           f"rel err {_fmt_err(rel)} > float_tol {tol:g}")
+    return True, max_rel, all_exact, ""
+
+
+def _exact_note(all_exact):
+    return "all tokens matched exactly" if all_exact else "float tokens matched only within tolerance"
 
 
