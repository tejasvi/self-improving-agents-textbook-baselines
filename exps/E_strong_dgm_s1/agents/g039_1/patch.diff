+def _run_checker(tmpdir, inp_text, out_text, brute_text, timeout):
+    """Run the user checker `_checker.py in out [brute_out]` in tmpdir.
+
+    Returns (ok, message). ok is True only for exit code 0 without a timeout."""
+    with open(os.path.join(tmpdir, '_in.txt'), 'w', encoding='utf-8', errors='replace', newline='') as f:
+        f.write(inp_text)
+    with open(os.path.join(tmpdir, '_out.txt'), 'w', encoding='utf-8', errors='replace', newline='') as f:
+        f.write(out_text)
+    cmd = [sys.executable, '-I', '_checker.py', '_in.txt', '_out.txt']
+    if brute_text is not None:
+        with open(os.path.join(tmpdir, '_bout.txt'), 'w', encoding='utf-8', errors='replace', newline='') as f:
