index 9d2f6a3..fe114a1 100644
--- a/tests/test_tools.py
+++ b/tests/test_tools.py
@@ -114,3 +114,41 @@ def test_solution_check_format_mismatch_levels(tmp_path):
     assert solution_check.classify("60.000\n", "60\n") == 'close'
     assert solution_check.classify("61\n", "60\n") == 'wrong'
     assert solution_check.classify("1 2\n", "1\n") == 'wrong'
+
+
+def test_solution_check_checker_any_valid(tmp_path):
+    # toy problem: print any even number in [2, 1000]
+    from tools import solution_check
+    checker = tmp_path / "check.py"
+    checker.write_text(
+        "import sys\n"
+        "v = open(sys.argv[2]).read().split()\n"
+        "if len(v) != 1 or not v[0].isdigit() or int(v[0]) % 2 != 0 or not (2 <= int(v[0]) <= 1000):\n"
+        "    print('bad answer: %r' % (v,))\n"
+        "    sys.exit(1)\n"
+        "print('ok', v[0])\n")
+    two = tmp_path / "two.py"
+    two.write_text("print(2)\n")
+    four = tmp_path / "four.py"
+    four.write_text("print(4)\n")
+    three = tmp_path / "three.py"
+    three.write_text("print(3)\n")
+    out = solution_check.tool_function(str(two), inputs=[""], expected_outputs=["x\n"], checker_path=str(checker))
+    assert "RESULT: OK" in out
+    out = solution_check.tool_function(str(four), inputs=[""], checker_path=str(checker))
+    assert "RESULT: OK" in out
+    out = solution_check.tool_function(str(three), inputs=[""], expected_outputs=["2\n"], checker_path=str(checker))
+    assert "RESULT: FAILED" in out and "bad answer: ['3']" in out and "checker rejected" in out
+    gen = tmp_path / "gen_even.py"
+    gen.write_text("import random, sys\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(1, 9))\n")
+    # stress with checker only
+    assert "RESULT: OK" in solution_check.tool_function(str(four), gen_path=str(gen), checker_path=str(checker), num_tests=20)
+    out = solution_check.tool_function(str(three), gen_path=str(gen), checker_path=str(checker), num_tests=20)
+    assert "RESULT: FAILED" in out and "CHECKER REJECTED" in out
+    # stress with checker plus brute (brute prints its own valid answer; checker gets it as 3rd arg)
+    brute = tmp_path / "brute_even.py"
+    brute.write_text("print(2)\n")
+    assert "RESULT: OK" in solution_check.tool_function(str(four), brute_path=str(brute), gen_path=str(gen),
+                                                        checker_path=str(checker), num_tests=20)
+    # without checker/brute the stress request is rejected
+    assert "Error" in solution_check.tool_function(str(four), gen_path=str(gen), num_tests=5)
