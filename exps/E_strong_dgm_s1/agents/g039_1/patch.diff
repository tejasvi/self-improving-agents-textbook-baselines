+        cmd.append('_bout.txt')
+    st, cout, cerr, crc, _ = _run(cmd, tmpdir, '', timeout)
+    text = (cout + ("\n" + cerr if cerr.strip() else "")).strip()
+    if st != 'ok':
+        return False, f"checker TIMED OUT\n{_clip(text)}".rstrip()
+    body = _clip(text) if text else "(no output)"
+    return crc == 0, f"checker message (exit code {crc}):\n{body}"
