+#!/usr/bin/env python3
+# PLACEHOLDER generator for the stand-in problem "sum of n integers".
+# Usage: python gen.py <seed> [small|edge|max]
+import random
+import sys
+
+
+def main():
+    seed = int(sys.argv[1])
+    mode = sys.argv[2] if len(sys.argv) > 2 else 'small'
+    random.seed(seed)
+    if mode == 'edge':
+        n = random.choice([1, 2])
+        vals = [random.choice([-10**9, 0, 10**9, 1, -1]) for _ in range(n)]
+    elif mode == 'max':
+        n = 200000
+        vals = [random.randint(-10**9, 10**9) for _ in range(n)]
+    else:
+        n = random.randint(1, 10)
+        vals = [random.randint(-100, 100) for _ in range(n)]
+    print(n)
+    print(" ".join(map(str, vals)))
+
+
+if __name__ == "__main__":
+    main()
