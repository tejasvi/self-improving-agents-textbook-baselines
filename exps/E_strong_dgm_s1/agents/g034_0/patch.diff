+#!/usr/bin/env python3
+# PLACEHOLDER reference for a stand-in problem: "print the sum of n integers".
+# Input: first line n, second line n integers. Output: their sum.
+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    n = int(data[0])
+    total = 0
+    for i in range(n):
+        total += int(data[1 + i])
+    print(total)
+
+
+if __name__ == "__main__":
+    main()
