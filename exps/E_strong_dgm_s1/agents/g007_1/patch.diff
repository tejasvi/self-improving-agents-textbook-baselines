index 0000000..2f00391
--- /dev/null
+++ b/tests/test_portability.py
@@ -0,0 +1,107 @@
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+
+# Problem: read n and m, print n! mod m.
+BRUTE = "n, m = map(int, input().split())\nr = 1\nfor i in range(1, n + 1):\n    r = r * i % m\nprint(r)\n"
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode == 'max':\n"
+       "    print(10**5, 10**9 + 7)\n"
+       "else:\n"
+       "    print(random.randint(0, 30), random.choice([7, 13, 1000000007]))\n")
+SAMPLES = [{"input": "5 7\n", "output": "1\n"}, {"input": "4 13\n", "output": "11\n"}]
+
+POW3 = ("n, m = map(int, input().split())\n"
+        "r = 1\n"
+        "for i in range(1, n + 1):\n"
+        "    r = r * i % m\n"
+        "print(pow(r, 1, m))\n")
+MODPOW = ("def modpow(b, e, m):\n"
+          "    res = 1\n"
+          "    b %= m\n"
+          "    while e:\n"
+          "        if e & 1:\n"
+          "            res = res * b % m\n"
+          "        b = b * b % m\n"
+          "        e >>= 1\n"
+          "    return res\n\n"
+          "n, m = map(int, input().split())\n"
+          "r = 1\n"
+          "for i in range(1, n + 1):\n"
+          "    r = r * i % m\n"
+          "print(modpow(r, 1, m))\n")
+NUMPY = "import numpy as np\nn, m = map(int, input().split())\nprint(1)\n"
+
+
+def _agent(tmp_path):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(BRUTE)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(SAMPLES))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+def _write(root, name, src):
+    p = root / "cands" / name
+    p.write_text(src)
+    return str(p)
+
+
+def test_lint_flags_three_arg_pow_and_numpy():
+    assert any("pow() with 3 arguments" in f for f in solution_check.lint_portability(POW3))
+    assert any("pow() with 3 arguments" in f
+               for f in solution_check.lint_portability("print(pow(2, 3, mod=5))\n"))
+    assert any("'numpy'" in f for f in solution_check.lint_portability(NUMPY))
+    assert any("'numpy'" in f for f in solution_check.lint_portability("from numpy import array\n"))
+    assert solution_check.lint_portability(MODPOW) == []
+    assert solution_check.lint_portability("import collections\nprint(pow(2, 3))\n") == []
+
+
+def test_lint_flags_builtin_shadowing():
+    assert any("shadows a Python builtin" in f for f in solution_check.lint_portability("list = [1]\n"))
+
+
+def test_strict_mode_rejects_three_arg_pow(tmp_path):
+    sol = tmp_path / "sol.py"
+    sol.write_text("print(pow(2, 3, 5))\n")
+    res = solution_check.run_plain(str(sol), ["\n"], None, strict=True)
+    assert res['crashed'] == 1 and "pow expected 2 arguments" in res['report']
+    lax = solution_check.run_plain(str(sol), ["\n"], None, strict=False)
+    assert lax['crashed'] == 0
+
+
+def test_three_arg_pow_candidate_is_not_perfect(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(_write(root, "pow3.py", POW3))
+    assert "pow() with 3 arguments" in rep
+    assert score[2] == 0
+    assert rep.splitlines()[-1] == "RESULT: FAILED"
+    assert not agent._is_perfect_report(rep)
+
+
+def test_numpy_candidate_is_not_perfect(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(_write(root, "np.py", NUMPY))
+    assert "'numpy'" in rep and score[2] == 0
+    assert not agent._is_perfect_report(rep)
+
+
+def test_modpow_candidate_is_perfect(tmp_path):
+    agent, root = _agent(tmp_path)
+    score, rep = agent._score_candidate(_write(root, "modpow.py", MODPOW))
+    assert score[2] == 1 and score[0] == len(SAMPLES)
+    assert "LINT" not in rep
+    assert rep.splitlines()[-1] == "RESULT: OK"
+    assert agent._is_perfect_report(rep)
