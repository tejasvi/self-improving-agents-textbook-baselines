+def lint_portability(src):
+    """
+    Static scan for constructs the grader may reject. Returns a list of finding strings (empty = clean):
+      - pow() called with 3 positional args or a `mod=` keyword (grader rejects 3-arg pow)
+      - imports whose top-level module is not in the standard library
+      - builtin-shadowing bindings (see _builtin_shadow_warnings)
+    """
+    try:
+        tree = ast.parse(src)
+    except SyntaxError as e:
+        return [f"syntax error at line {e.lineno}: {e.msg}"]
+    findings = []
+    for node in ast.walk(tree):
+        line = getattr(node, 'lineno', '?')
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 'pow':
+            if len(node.args) == 3 or any(kw.arg == 'mod' for kw in node.keywords):
+                findings.append(f"line {line}: pow() with 3 arguments is rejected by the grader "
+                                f"(TypeError: pow expected 2 arguments, got 3); use a modpow(b, e, m) helper with a loop")
+        elif isinstance(node, ast.Import):
+            for alias in node.names:
+                top = alias.name.split('.')[0]
+                if top not in sys.stdlib_module_names:
+                    findings.append(f"line {line}: import of non-standard module '{top}' "
+                                    f"(only the Python standard library is available)")
+        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+            top = node.module.split('.')[0]
+            if top not in sys.stdlib_module_names:
+                findings.append(f"line {line}: import of non-standard module '{top}' "
+                                f"(only the Python standard library is available)")
+    findings.extend(_builtin_shadow_warnings(src))
+    return sorted(set(findings))
+
+
+# Strict mode: the solution runs under a bootstrap that makes builtins.pow accept 2 arguments only,
+# so a 3-argument pow() fails here the same way it fails in the grader.
+_PORTABLE_BOOTSTRAP = """import builtins, operator, runpy, sys
+def _pow2(a, b, *rest):
+    if rest:
+        raise TypeError(f"pow expected 2 arguments, got {2 + len(rest)}")
+    return operator.pow(a, b)
+builtins.pow = _pow2
+sys.argv = ['_sol.py']
+runpy.run_path('_sol.py', run_name='__main__')
+"""
+
+
+def _portable_runner(tmpdir):
+    """Write the strict-mode bootstrap into tmpdir and return the command that runs _sol.py through it."""
+    with open(os.path.join(tmpdir, '_bootstrap.py'), 'w') as f:
+        f.write(_PORTABLE_BOOTSTRAP)
+    return [sys.executable, '-I', '_bootstrap.py']
+
+
