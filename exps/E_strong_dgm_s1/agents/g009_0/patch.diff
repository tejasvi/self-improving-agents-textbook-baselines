diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..3034bd8
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,87 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress test: compares a solution against a brute-force reference on generated inputs.
+
+* `generator_cmd` is a shell command that takes an integer seed as its first argument (argv[1]) and prints ONE test input to stdout, e.g. `python3 gen.py`.
+* For seeds 1..num_tests: the generator is run with the seed, then `solution_cmd` and `brute_cmd` are each run with that input on stdin (e.g. `python3 solution.py`, `python3 brute.py`).
+* Compare mode 'exact' compares stdout after stripping leading/trailing whitespace; mode 'tokens' compares whitespace-separated tokens.
+* On the first mismatch it returns the seed, the input, and both raw outputs (stdout and stderr). Errors are not parsed; read the raw output.
+* If all tests agree it returns 'All N tests matched'.
+* Each run is limited by `timeout` seconds; a timeout is reported raw as a mismatch with the raw outputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {"type": "string", "description": "Shell command that runs the solution under test, reading stdin, e.g. `python3 solution.py`."},
+                "brute_cmd": {"type": "string", "description": "Shell command that runs the brute-force reference, reading stdin, e.g. `python3 brute.py`."},
+                "generator_cmd": {"type": "string", "description": "Shell command that takes a seed as its first argument and prints one test input to stdout, e.g. `python3 gen.py`."},
+                "num_tests": {"type": "integer", "description": "Number of seeds to test (default 300)."},
+                "compare_mode": {"type": "string", "enum": ["exact", "tokens"], "description": "'exact' compares stripped stdout exactly (default); 'tokens' compares whitespace-separated tokens."},
+                "timeout": {"type": "integer", "description": "Per-run time limit in seconds (default 10)."}
+            },
+            "required": ["solution_cmd", "brute_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _run(cmd, stdin_text, timeout):
+    try:
+        p = subprocess.run(cmd, shell=True, input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return out, err, None, True
+
+
+def _clip(s, n=4000):
+    s = s or ''
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _same(a, b, mode):
+    if mode == 'tokens':
+        return a.split() == b.split()
+    return a.strip() == b.strip()
+
+
+def tool_function(solution_cmd, brute_cmd, generator_cmd, num_tests=300, compare_mode='exact', timeout=10):
+    try:
+        num_tests = max(1, min(int(num_tests or 300), 100000))
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    mode = 'tokens' if compare_mode == 'tokens' else 'exact'
+
+    for seed in range(1, num_tests + 1):
+        gen_out, gen_err, gen_rc, gen_to = _run(f"{generator_cmd} {seed}", None, timeout)
+        if gen_to or gen_rc != 0:
+            return (f"Generator failed on seed {seed} (exit code {gen_rc}, timed out={gen_to}).\n"
+                    f"STDOUT:\n{_clip(gen_out)}\nSTDERR:\n{_clip(gen_err)}")
+        test_input = gen_out
+
+        sol_out, sol_err, sol_rc, sol_to = _run(solution_cmd, test_input, timeout)
+        brute_out, brute_err, brute_rc, brute_to = _run(brute_cmd, test_input, timeout)
+
+        sol_ok = not sol_to and sol_rc == 0
+        brute_ok = not brute_to and brute_rc == 0
+        if sol_ok and brute_ok and _same(sol_out, brute_out, mode):
+            continue
+
+        return (f"MISMATCH on seed {seed}.\n"
+                f"INPUT:\n{_clip(test_input)}\n"
+                f"SOLUTION OUTPUT (exit code {sol_rc}, timed out={sol_to}):\n{_clip(sol_out)}\n"
+                f"SOLUTION STDERR:\n{_clip(sol_err)}\n"
+                f"BRUTE OUTPUT (exit code {brute_rc}, timed out={brute_to}):\n{_clip(brute_out)}\n"
+                f"BRUTE STDERR:\n{_clip(brute_err)}")
+
+    return f"All {num_tests} tests matched"
