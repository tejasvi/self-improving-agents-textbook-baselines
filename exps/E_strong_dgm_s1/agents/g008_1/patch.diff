@@ -0,0 +1,52 @@
+"""Tolerant output comparison shared by the testing tools and the framework.
+
+Outputs are compared token by token (whitespace-separated). Two tokens match when
+both parse as floats and abs(x - y) <= tol * max(1, abs(y)), or when they are
+string-equal. Token counts must match.
+"""
+import math
+
+
+def _as_float(tok):
+    """Parse a token as a finite float, or return None (NaN, inf and non-numeric tokens are not numbers)."""
+    try:
+        x = float(tok)
+    except (TypeError, ValueError):
+        return None
+    if math.isnan(x) or math.isinf(x):
+        return None
+    return x
+
+
+def outputs_equal_detail(a, b, tol=1e-6):
+    """Compare two output strings token by token.
+
+    Returns (equal, max_dev):
+      - equal: True when the outputs match under the tolerant comparison.
+      - max_dev: the largest relative deviation abs(x-y)/max(1,abs(y)) over numeric token pairs
+        seen up to the verdict (0.0 when every pair is identical). None when the outputs are not
+        comparable (token counts differ, or a non-numeric pair is not string-equal).
+    """
+    ta = (a or "").split()
+    tb = (b or "").split()
+    if len(ta) != len(tb):
+        return False, None
+    max_dev = 0.0
+    for p, q in zip(ta, tb):
+        if p == q:
+            continue
+        x = _as_float(p)
+        y = _as_float(q)
+        if x is None or y is None:
+            return False, None
+        dev = abs(x - y) / max(1.0, abs(y))
+        if dev > max_dev:
+            max_dev = dev
+        if abs(x - y) > tol * max(1.0, abs(y)):
+            return False, max_dev
+    return True, max_dev
+
+
+def outputs_equal(a, b, tol=1e-6):
+    """True if outputs a and b match under the tolerant token comparison."""
+    return outputs_equal_detail(a, b, tol)[0]
