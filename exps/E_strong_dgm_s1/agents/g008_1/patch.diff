+"""Append-only protection for the shared corpus directory.
+
+The corpus is shared by all attempts. Agents may add files, but must not delete or overwrite them.
+The framework keeps a private backup copy (outside the agent's reach by convention) and, after each
+agent phase, restores any file that went missing or changed, then backs up newly added files.
+"""
+import hashlib
+import os
+import shutil
+
+
+def _sha1(path):
+    h = hashlib.sha1()
+    with open(path, 'rb') as f:
+        for chunk in iter(lambda: f.read(1 << 16), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def snapshot(directory):
+    """Return {filename: sha1} for the regular files directly inside directory ({} if absent)."""
+    result = {}
+    if not os.path.isdir(directory):
+        return result
+    for name in sorted(os.listdir(directory)):
+        path = os.path.join(directory, name)
+        if os.path.isfile(path):
+            result[name] = _sha1(path)
+    return result
+
+
+def sync_backup(directory, backup_dir):
+    """Copy files from directory that are not yet in backup_dir. Returns the list of copied names."""
+    os.makedirs(backup_dir, exist_ok=True)
+    copied = []
+    for name, _ in snapshot(directory).items():
+        dst = os.path.join(backup_dir, name)
+        if not os.path.exists(dst):
+            shutil.copyfile(os.path.join(directory, name), dst)
+            copied.append(name)
+    return copied
+
+
+def restore(directory, backup_dir, before):
+    """Compare the directory with the 'before' snapshot. Restore every file that is missing or
+    altered from backup_dir. Returns a list of (name, reason) with reason 'missing', 'altered'
+    or 'unrestorable' (no backup copy exists, so the file stays as it is)."""
+    now = snapshot(directory)
+    events = []
+    for name, digest in before.items():
+        if now.get(name) == digest:
+            continue
+        reason = 'missing' if name not in now else 'altered'
+        src = os.path.join(backup_dir, name)
+        if not os.path.isfile(src) or _sha1(src) != digest:
+            events.append((name, 'unrestorable'))
+            continue
+        os.makedirs(directory, exist_ok=True)
+        shutil.copyfile(src, os.path.join(directory, name))
+        events.append((name, reason))
+    return events
