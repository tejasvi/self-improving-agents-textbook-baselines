@@ -0,0 +1,175 @@
+import os
+import sys
+
+from utils.compare_utils import outputs_equal, outputs_equal_detail
+from utils import corpus_guard
+
+
+# ---------- outputs_equal ----------
+
+def test_equal_within_tolerance():
+    # relative difference ~1e-12, well inside 1e-6
+    assert outputs_equal("4896.720444101133580\n", "4896.720444101135399\n")
+    assert outputs_equal("1.0000001", "1.0")          # abs diff 1e-7 <= 1e-6*max(1,1)
+    assert outputs_equal("0.0000001", "0.0")          # abs diff 1e-7 <= 1e-6*max(1,0)
+
+
+def test_differ_beyond_tolerance():
+    assert not outputs_equal("1.0001", "1.0")         # abs diff 1e-4 > 1e-6
+    assert not outputs_equal("1000.5", "1000.0")      # rel diff 5e-4 > 1e-6
+    assert not outputs_equal("-3", "3")
+
+
+def test_custom_tolerance():
+    assert outputs_equal("1.001", "1.0", tol=1e-2)
+    assert not outputs_equal("1.001", "1.0", tol=1e-4)
+
+
+def test_token_count_mismatch():
+    assert not outputs_equal("1 2 3", "1 2")
+    assert not outputs_equal("1 2", "1 2 3")
+    assert not outputs_equal("", "1")
+    assert outputs_equal("1 2", "1\n2\n")             # whitespace layout does not matter
+
+
+def test_non_numeric_tokens_need_exact_equality():
+    assert outputs_equal("YES", "YES\n")
+    assert not outputs_equal("YES", "NO")
+    assert not outputs_equal("1 YES", "1 NO")
+    assert not outputs_equal("abc 1.0", "abd 1.0")
+
+
+def test_mixed_numeric_and_non_numeric():
+    assert outputs_equal("Case 1: 2.5000001", "Case 1: 2.5")
+    assert not outputs_equal("Case 1: 2.5", "Case 2: 2.5")
+    assert not outputs_equal("x 2.5", "x 2.6")
+
+
+def test_nan_and_inf_are_not_treated_as_numbers():
+    assert not outputs_equal("nan", "0")
+    assert outputs_equal("inf", "inf")                # identical string tokens still match
+    assert not outputs_equal("inf", "1e308")
+
+
+def test_detail_reports_max_deviation():
+    eq, dev = outputs_equal_detail("1.0 2.0", "1.0 2.0")
+    assert eq and dev == 0.0
+    eq, dev = outputs_equal_detail("1.0000005", "1.0")
+    assert eq and 4e-7 < dev < 6e-7
+    eq, dev = outputs_equal_detail("1.5", "1.0")
+    assert not eq and abs(dev - 0.5) < 1e-12
+    eq, dev = outputs_equal_detail("1 2", "1 2 3")
+    assert not eq and dev is None
+
+
+# ---------- corpus guard ----------
+
+def test_corpus_restore_missing_and_altered(tmp_path):
+    corpus = str(tmp_path / "corpus")
+    backup = str(tmp_path / ".corpus_backup")
+    os.makedirs(corpus)
+    for name, body in [("sample_1.txt", "1\n"), ("fail_seed3.txt", "2\n"), ("max_a1_1.txt", "3\n")]:
+        with open(os.path.join(corpus, name), "w") as f:
+            f.write(body)
+    corpus_guard.sync_backup(corpus, backup)
+    before = corpus_guard.snapshot(corpus)
+    assert set(before) == {"sample_1.txt", "fail_seed3.txt", "max_a1_1.txt"}
+
+    # simulate an agent deleting one file and overwriting another, and adding a new file
+    os.remove(os.path.join(corpus, "sample_1.txt"))
+    with open(os.path.join(corpus, "fail_seed3.txt"), "w") as f:
+        f.write("tampered\n")
+    with open(os.path.join(corpus, "new_a1_1.txt"), "w") as f:
+        f.write("new\n")
+
+    events = corpus_guard.restore(corpus, backup, before)
+    assert dict(events) == {"sample_1.txt": "missing", "fail_seed3.txt": "altered"}
+    with open(os.path.join(corpus, "sample_1.txt")) as f:
+        assert f.read() == "1\n"
+    with open(os.path.join(corpus, "fail_seed3.txt")) as f:
+        assert f.read() == "2\n"
+    # newly added files are kept (append-only), and become part of the backup afterwards
+    assert os.path.isfile(os.path.join(corpus, "new_a1_1.txt"))
+    assert corpus_guard.sync_backup(corpus, backup) == ["new_a1_1.txt"]
+
+
+def test_corpus_restore_no_changes_is_noop(tmp_path):
+    corpus = str(tmp_path / "corpus")
+    backup = str(tmp_path / ".corpus_backup")
+    os.makedirs(corpus)
+    with open(os.path.join(corpus, "a.txt"), "w") as f:
+        f.write("x")
+    corpus_guard.sync_backup(corpus, backup)
+    before = corpus_guard.snapshot(corpus)
+    assert corpus_guard.restore(corpus, backup, before) == []
+
+
+def test_corpus_restore_reports_unrestorable_when_no_backup(tmp_path):
+    corpus = str(tmp_path / "corpus")
+    backup = str(tmp_path / ".corpus_backup")
+    os.makedirs(corpus)
+    with open(os.path.join(corpus, "a.txt"), "w") as f:
+        f.write("x")
+    before = corpus_guard.snapshot(corpus)     # no backup taken
+    os.remove(os.path.join(corpus, "a.txt"))
+    assert corpus_guard.restore(corpus, backup, before) == [("a.txt", "unrestorable")]
+    assert not os.path.exists(os.path.join(corpus, "a.txt"))
+
+
+def test_snapshot_of_missing_dir_is_empty(tmp_path):
+    assert corpus_guard.snapshot(str(tmp_path / "nope")) == {}
+
+
+# ---------- stress_test integration ----------
+
+def _write(path, text, mode=0o755):
+    with open(path, "w") as f:
+        f.write(text)
+    os.chmod(path, mode)
+
+
+def test_stress_test_tolerant_pass_and_exact_mode(tmp_path):
+    from tools import stress_test
+    gen = tmp_path / "gen.py"
+    _write(str(gen), "import sys\nprint(float(sys.argv[1]) + 0.5)\n")
+    ref = tmp_path / "ref.py"
+    _write(str(ref), "import sys\nx=float(sys.stdin.read())\nprint(f'{x:.12f}')\n")
+    sol = tmp_path / "sol.py"
+    _write(str(sol), "import sys\nx=float(sys.stdin.read())\nprint(f'{x*(1+1e-12):.18f}')\n")
+
+    out = stress_test.tool_function(str(sol), str(gen), brute_path=str(ref), num_tests=5)
+    assert out.startswith("PASS")
+    assert "Max numeric deviation" in out
+
+    out = stress_test.tool_function(str(sol), str(gen), brute_path=str(ref), num_tests=5, exact=True)
+    assert "MISMATCH" in out
+    assert "Exact mode" in out
+
+
+def test_stress_test_saves_only_real_failures(tmp_path):
+    from tools import stress_test
+    gen = tmp_path / "gen.py"
+    _write(str(gen), "import sys\nprint(float(sys.argv[1]) + 0.5)\n")
+    ref = tmp_path / "ref.py"
+    _write(str(ref), "import sys\nx=float(sys.stdin.read())\nprint(f'{x:.12f}')\n")
+    # noisy solution: passes everywhere
+    noisy = tmp_path / "noisy.py"
+    _write(str(noisy), "import sys\nx=float(sys.stdin.read())\nprint(f'{x+1e-10:.12f}')\n")
+    corpus = tmp_path / "corpus"
+    out = stress_test.tool_function(str(noisy), str(gen), brute_path=str(ref), num_tests=5,
+                                    save_failures_dir=str(corpus))
+    assert out.startswith("PASS")
+    assert not corpus.exists() or not os.listdir(str(corpus))
+
+    # genuinely wrong solution: every test saved, names fail_seed<N>.txt
+    bad = tmp_path / "bad.py"
+    _write(str(bad), "import sys\nx=float(sys.stdin.read())\nprint(f'{x+0.25:.12f}')\n")
+    out = stress_test.tool_function(str(bad), str(gen), brute_path=str(ref), num_tests=3,
+                                    save_failures_dir=str(corpus))
+    assert out.startswith("MISMATCH")
+    assert sorted(os.listdir(str(corpus))) == ["fail_seed0.txt", "fail_seed1.txt", "fail_seed2.txt"]
+    # a second run never overwrites: the new files get a suffix
+    stress_test.tool_function(str(bad), str(gen), brute_path=str(ref), num_tests=1,
+                              save_failures_dir=str(corpus))
+    names = sorted(os.listdir(str(corpus)))
+    assert "fail_seed0_1.txt" in names and len(names) == 4
