new file mode 100644
index 0000000..0959b2a
--- /dev/null
+++ b/tests/test_multi_compare.py
@@ -0,0 +1,91 @@
+import json
+import os
+
+from tools import multi_compare
+
+GEN = "import random, sys\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(1, 50), random.randint(1, 50))\n"
+GOOD = "a, b = map(int, input().split())\nprint(a + b)\n"
+WRONG = "a, b = map(int, input().split())\nprint(a + b + (1 if a == 7 else 0))\n"
+
+
+def _write(tmp_path, name, text):
+    p = tmp_path / name
+    p.write_text(text)
+    return str(p)
+
+
+def test_schema_valid():
+    info = multi_compare.tool_info()
+    assert info["name"] == "multi_compare"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert "required" in schema and "required" not in schema["properties"]
+    for name, prop in schema["properties"].items():
+        assert "type" in prop and "description" in prop, name
+        assert set(prop) <= {"type", "description", "items"}, name
+    assert set(schema["required"]) <= set(schema["properties"])
+
+
+def test_all_agree_with_oracle(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    c1 = _write(tmp_path, "c1.py", GOOD)
+    c2 = _write(tmp_path, "c2.py", GOOD)
+    orc = _write(tmp_path, "oracle.py", GOOD)
+    out = multi_compare.tool_function([c1, c2], [g], oracle_path=orc, num_tests=20)
+    assert "agreement 20/20" in out
+    assert "no disagreements" in out
+
+
+def test_one_wrong_candidate_detected(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    good = _write(tmp_path, "good.py", GOOD)
+    bad = _write(tmp_path, "bad.py", WRONG)
+    orc = _write(tmp_path, "oracle.py", GOOD)
+    out = multi_compare.tool_function([good, bad], [g], oracle_path=orc, num_tests=100)
+    assert f"{good}: agreement 100/100" in out
+    assert f"{bad}: agreement" in out and f"{bad}: agreement 100/100" not in out
+    assert "disagreeing inputs" in out
+
+
+def test_majority_reference_without_oracle(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    good1 = _write(tmp_path, "g1.py", GOOD)
+    good2 = _write(tmp_path, "g2.py", GOOD)
+    bad = _write(tmp_path, "bad.py", WRONG)
+    out = multi_compare.tool_function([good1, good2, bad], [g], num_tests=100)
+    assert "against majority" in out
+    assert f"{bad}: agreement" in out and f"{bad}: agreement 100/100" not in out
+
+
+def test_corpus_saved(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    good = _write(tmp_path, "good.py", GOOD)
+    bad = _write(tmp_path, "bad.py", WRONG)
+    orc = _write(tmp_path, "oracle.py", GOOD)
+    corpus = tmp_path / "corpus"
+    out = multi_compare.tool_function([good, bad], [g], oracle_path=orc, num_tests=100, corpus_dir=str(corpus))
+    files = sorted(os.listdir(corpus))
+    assert files and all(f.endswith(".json") for f in files)
+    rec = json.loads((corpus / files[0]).read_text())
+    assert rec["agrees"][good] is True and rec["agrees"][bad] is False
+    assert "a + b" not in rec["input"]  # input is raw stdin text
+    assert rec["size"] == len(rec["input"].split())
+    assert "saved" in out
+
+
+def test_samples_and_stderr_reported(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    crash = _write(tmp_path, "crash.py", "a, b = map(int, input().split())\nprint(a // 0)\n")
+    out = multi_compare.tool_function([crash], [g], num_tests=5,
+                                      sample_inputs=["1 2\n", "3 4\n"], sample_outputs=["3\n", None])
+    assert "samples passed 0/2" in out
+    assert "ZeroDivisionError" in out
+
+
+def test_oracle_failure_is_skipped_not_blamed(tmp_path):
+    g = _write(tmp_path, "gen.py", GEN)
+    good = _write(tmp_path, "good.py", GOOD)
+    crash_oracle = _write(tmp_path, "oracle.py", "raise SystemExit(3)\n")
+    res = multi_compare.compare_candidates([good], [g], oracle_path=crash_oracle, num_tests=10)
+    assert res["compared"] == 0 and res["skipped"] == 10
+    assert res["disagreements"] == []
