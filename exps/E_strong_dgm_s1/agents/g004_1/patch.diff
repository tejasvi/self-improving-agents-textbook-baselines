+    def forward(self):
+        """
+        The forward function for the AgenticSystem.
+        Pipeline: cand_0 (first attempt) + K-1 fresh candidates -> oracle session -> multi_compare
+        -> bounded arbitration -> select best -> review rounds with snapshot/restore fallback.
+        """
+        task = f"""I have uploaded a code repository in the directory {self.git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {self.git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+"""
+        self._oracle_path = None
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+
+        # (a) First attempt (cand_0), then K-1 fresh-context candidates.
+        init_edit = chat_with_agent(f"{task}\n{CANDIDATE_METHOD}", model=self.code_model,
+                                    msg_history=[], logging=safe_log)
+        for attempt in range(3):
+            if self._has_primary_edit():
+                break
+            safe_log(f"No primary source edit detected; retry {attempt + 1}/3")
+            chat_with_agent(RETRY_PROMPT_TMPL.format(task=task, sol=sol_path),
+                            model=self.code_model, msg_history=[], logging=safe_log)
+        cands_dir = self._cands_dir()
+        if os.path.isfile(sol_path):
+            _write_text(os.path.join(cands_dir, 'cand_0.py'), _read_text(sol_path))
+        summary = _last_assistant_text(init_edit)
+        for k in range(1, NUM_CANDIDATES):
+            self._attempt(task, str(k), HINTS[(k - 1) % len(HINTS)])
+        cand_paths = sorted(os.path.join(cands_dir, f) for f in os.listdir(cands_dir)
+                            if f.startswith('cand_') and f.endswith('.py'))
+        safe_log(f"Candidates: {[os.path.basename(p) for p in cand_paths]}")
+
+        # Snapshot of the solution for the fallback.
+        passed, _ = _verify_solution(self.git_tempdir)
+        safe_log(f"Initial verification passed={passed}")
+
+        # (b) oracle + generators.
+        oracle_path = self._write_oracle(task)
+        self._oracle_path = oracle_path
+
+        # (d) compare, then bounded arbitration (at most MAX_ARBITRATION rounds).
+        result = self._verify_candidates(cand_paths, oracle_path) if cand_paths else None
+        if result is not None:
+            safe_log(f"Multi-compare: compared={result['compared']} agree={result['agree']}")
+            for round_no in range(1, MAX_ARBITRATION + 1):
+                if not result['disagreements']:
+                    break
+                self._arbitrate(task, cand_paths, oracle_path, result, round_no)
+                result = self._verify_candidates(cand_paths, oracle_path)
+                safe_log(f"After arbitration {round_no}: agree={result['agree']}")
+
+        # (e) select the best candidate and copy it to solution.py.
+        if result is not None:
+            best = self._select_best(cand_paths, result)
+            if best is not None:
+                _write_text(sol_path, _read_text(best))
+                safe_log(f"Selected {best}")
+
+        # Review rounds get the hard-test corpus and the oracle path; snapshot/restore fallback.
+        self._review_rounds(task, sol_path, summary)
+
+
+# Module-level prompts and knobs for the multi-candidate pipeline.
+NUM_CANDIDATES = 3          # cand_0 (first attempt) + (NUM_CANDIDATES - 1) fresh attempts
+MAX_ARBITRATION = 2         # bounded arbitration rounds
+HINTS = [
+    "Use a different formulation than the direct DP: think about a combinatorial or matrix/generating-function view, or an invariant.",
+    "Use a different formulation than the direct DP and the generating function: simulate the process directly with a smarter data structure, or derive the answer from a decomposition of the process.",
+    "Use a different formulation than the three above: think about the problem from the answer side (count or characterise the outcomes), and verify it with a statement-literal brute force.",
+]
