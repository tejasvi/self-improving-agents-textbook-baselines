@@ -0,0 +1,48 @@
+import os
+import coding_agent as ca
+
+GOOD = "a, b = map(int, input().split())\nprint(a + b)\n"
+WRONG = "a, b = map(int, input().split())\nprint(a - b)\n"
+GEN = "import random, sys\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(1, 9), random.randint(1, 9))\n"
+ORACLE = GOOD
+
+
+def test_pipeline_selects_correct_candidate(tmp_path, monkeypatch):
+    """Fake LLM: the first attempt writes a wrong solution, later attempts write the right one."""
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls.append(msg[:60])
+        d = str(tmp_path)
+        if 'oracle.py' in msg and 'NOT to solve' in msg:
+            (tmp_path / 'oracle.py').write_text(ORACLE)
+            (tmp_path / 'gen_small.py').write_text(GEN)
+            (tmp_path / 'gen_medium.py').write_text(GEN)
+            return []
+        if 'ARBITRATION' in msg or 'ADVERSARIAL' in msg:
+            return []
+        if "attempt '" in msg:
+            label = msg.split("attempt '")[1].split("'")[0]
+            code = GOOD if label in ('1',) else WRONG
+            (tmp_path / 'cands').mkdir(exist_ok=True)
+            (tmp_path / 'cands' / f'cand_{label}.py').write_text(code)
+            return []
+        # first attempt: writes solution.py (wrong)
+        (tmp_path / 'solution.py').write_text(WRONG)
+        return []
+
+    monkeypatch.setattr(ca, 'chat_with_agent', fake_chat)
+    monkeypatch.setattr(ca, '_verify_solution', lambda d, num_tests=200: (False, 'stub'))
+    agent = ca.AgenticSystem.__new__(ca.AgenticSystem)
+    agent.problem_statement = 'add two numbers'
+    agent.git_tempdir = str(tmp_path)
+    agent.base_commit = 'x'
+    agent.code_model = 'm'
+    agent.logger = None
+    agent._has_primary_edit = lambda: True
+    agent.forward()
+
+    assert open(tmp_path / 'solution.py').read() == GOOD
+    assert (tmp_path / 'cands' / 'cand_0.py').read_text() == WRONG
+    # no unbounded loop: at most 1 first attempt + oracle + (K-1) attempts + arbitration rounds + review rounds
+    assert len(calls) <= 1 + 1 + (ca.NUM_CANDIDATES - 1) + ca.MAX_ARBITRATION + 2
diff --git a/tools/multi_compare.py b/tools/multi_compare.py
new file mode 100644
index 0000000..3d015b3
--- /dev/null
+++ b/tools/multi_compare.py
@@ -0,0 +1,290 @@
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from collections import Counter
+
+# Runs several candidate solutions on generated inputs and compares them with an
+# oracle (if given) or with the majority output. Every run uses `python -I`, like
+# solution_check. Disagreeing inputs are saved as JSON files in corpus_dir.
+
+_MAX_STREAM = 2000
+_STRESS_BUDGET = 200.0
+_MAX_SHOWN = 3
+
+
+def tool_info():
+    return {
+        "name": "multi_compare",
+        "description": """Cross-check several candidate Python solutions on generated inputs.\n
+* Each candidate and the optional oracle run in isolated mode (`python -I`) on the input produced by `python gen.py <seed>` for seeds 0..num_tests-1.\n
+* If oracle_path is given, each candidate is scored by agreement with the oracle. Otherwise each candidate is scored by agreement with the majority output.\n
+* Reports per-candidate agreement counts, the smallest disagreeing inputs with every output (raw stderr included), and whether each candidate passes the given sample inputs.\n
+* Disagreeing inputs are saved as JSON files in corpus_dir (if given) so they can be reused as hard tests.\n
+* Pass gen_paths as a list; seeds are split across the generators (each generator is called with every seed).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidate_paths": {"type": "array", "items": {"type": "string"}, "description": "Paths to candidate Python solution files (each reads stdin and writes stdout)."},
+                "gen_paths": {"type": "array", "items": {"type": "string"}, "description": "Paths to generator programs; each is called as `python gen.py <seed>` and prints one input."},
+                "oracle_path": {"type": "string", "description": "Optional path to the trusted oracle program. If omitted, the majority output is used as reference."},
+                "num_tests": {"type": "integer", "description": "Number of seeds per generator (default 100)."},
+                "timeout": {"type": "integer", "description": "Per-run time limit in seconds (default 10)."},
+                "corpus_dir": {"type": "string", "description": "Optional directory where disagreeing inputs are saved as JSON files."},
+                "sample_inputs": {"type": "array", "items": {"type": "string"}, "description": "Optional sample inputs from the statement; candidates are checked against sample_outputs on these."},
+                "sample_outputs": {"type": "array", "items": {"type": "string"}, "description": "Expected outputs for sample_inputs, same order. A None or empty entry means run only (no comparison)."}
+            },
+            "required": ["candidate_paths", "gen_paths"]
+        }
+    }
+
+
+def _clip(s, n=_MAX_STREAM):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _normalise(s):
+    lines = [line.rstrip() for line in (s or '').replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _run(path, cwd, stdin_text, timeout):
+    """Run `python -I <path>` with stdin. Returns dict(status, out, err, rc, time)."""
+    t0 = time.monotonic()
+    try:
+        p = subprocess.run([sys.executable, '-I', path], input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, cwd=cwd, errors='replace')
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {'status': 'timeout', 'out': out, 'err': err, 'rc': None, 'time': time.monotonic() - t0}
+    return {'status': 'ok', 'out': p.stdout, 'err': p.stderr, 'rc': p.returncode, 'time': time.monotonic() - t0}
+
+
+def _gen_input(gen_path, seed, cwd, timeout):
+    """Run the generator; returns input text or None on failure."""
+    try:
+        p = subprocess.run([sys.executable, '-I', gen_path, str(seed)], input='', capture_output=True,
+                           text=True, timeout=timeout, cwd=cwd, errors='replace')
+    except subprocess.TimeoutExpired:
+        return None
+    if p.returncode != 0 or p.stderr.strip():
+        return None
+    return p.stdout
+
+
+def _fmt_raw(label, r):
+    head = f"{label}: status={r['status']} exit_code={r['rc']}"
+    body = _clip(r['out']).rstrip() or '(empty)'
+    out = f"{head}\nstdout:\n{body}"
+    if r['err'].strip():
+        out += "\nSTDERR (raw):\n" + _clip(r['err']).rstrip()
+    return out
+
+
+def _size(text):
+    return len(text.split())
+
+
+def _check_samples(path, cwd, sample_inputs, sample_outputs, timeout):
+    """Return (passed, total, problems) for the candidate on the sample inputs."""
+    total = len(sample_inputs or [])
+    passed, problems = 0, []
+    for i, inp in enumerate(sample_inputs or []):
+        r = _run(path, cwd, inp, timeout)
+        exp = sample_outputs[i] if sample_outputs is not None and i < len(sample_outputs) else None
+        bad = []
+        if r['status'] != 'ok':
+            bad.append('timeout')
+        if r['rc'] not in (0, None):
+            bad.append(f"exit code {r['rc']}")
+        if r['err'].strip():
+            bad.append('stderr not empty')
+        if exp is not None and exp.strip() and r['status'] == 'ok' and _normalise(r['out']) != _normalise(exp):
+            bad.append('output differs from expected')
+        if bad:
+            msg = f"sample {i}: {', '.join(bad)}"
+            if r['err'].strip():
+                msg += "\nSTDERR (raw):\n" + _clip(r['err'], 1000).rstrip()
+            problems.append(msg)
+        else:
+            passed += 1
+    return passed, total, problems
+
+
+def _result_key(r):
+    """Comparable key for one run: ('ok', normalised stdout) or ('fail', status)."""
+    if r['status'] != 'ok' or r['rc'] != 0 or r['err'].strip():
+        return ('fail', r['status'])
+    return ('ok', _normalise(r['out']))
+
+
+def tool_function(candidate_paths, gen_paths, oracle_path=None, num_tests=100, timeout=10,
+                  corpus_dir=None, sample_inputs=None, sample_outputs=None):
+    res = compare_candidates(candidate_paths, gen_paths, oracle_path=oracle_path, num_tests=num_tests,
+                             timeout=timeout, corpus_dir=corpus_dir, sample_inputs=sample_inputs,
+                             sample_outputs=sample_outputs)
+    return res['report']
+
+
+def compare_candidates(candidate_paths, gen_paths, oracle_path=None, num_tests=100, timeout=10,
+                       corpus_dir=None, sample_inputs=None, sample_outputs=None):
+    """Structured version of tool_function. Returns a dict with keys:
+    report (str), error (str or None), compared (int), agree {path: int},
+    samples {path: (passed, total)}, disagreements (list of dicts with size, seed, gen,
+    input, outputs {path: (status, stdout-or-status)}), reference ('oracle'|'majority')."""
+    empty = {'report': '', 'error': None, 'compared': 0, 'agree': {}, 'samples': {}, 'times': {}, 'max_size': -1,
+             'disagreements': [], 'reference': 'oracle' if oracle_path else 'majority'}
+
+    def fail(msg):
+        d = dict(empty)
+        d['error'] = msg
+        d['report'] = msg
+        return d
+
+    try:
+        num_tests = max(0, int(num_tests if num_tests is not None else 100))
+        timeout = max(1, int(timeout or 10))
+    except (TypeError, ValueError) as e:
+        return fail(f"Error: invalid numeric argument: {e}")
+    if isinstance(candidate_paths, str):
+        candidate_paths = [candidate_paths]
+    if isinstance(gen_paths, str):
+        gen_paths = [gen_paths]
+    if not candidate_paths:
+        return fail("Error: no candidate_paths given.")
+    if not gen_paths:
+        return fail("Error: no gen_paths given.")
+    for p in list(candidate_paths) + list(gen_paths) + ([oracle_path] if oracle_path else []):
+        if not os.path.isfile(p):
+            return fail(f"Error: file not found: {p}")
+
+    tmpdir = tempfile.mkdtemp(prefix='multicmp_')
+    try:
+        # Copy every program into the temp dir under a stable name.
+        names = [f"_cand{i}.py" for i in range(len(candidate_paths))]
+        for src, dst in zip(candidate_paths, names):
+            shutil.copyfile(src, os.path.join(tmpdir, dst))
+        gen_names = [f"_gen{i}.py" for i in range(len(gen_paths))]
+        for src, dst in zip(gen_paths, gen_names):
+            shutil.copyfile(src, os.path.join(tmpdir, dst))
+        if oracle_path:
+            shutil.copyfile(oracle_path, os.path.join(tmpdir, '_oracle.py'))
+
+        report = []
+        # ---- samples ----
+        sample_summary = {}
+        if sample_inputs:
+            for cp, name in zip(candidate_paths, names):
+                ok, total, probs = _check_samples(os.path.join(tmpdir, name), tmpdir,
+                                                  sample_inputs, sample_outputs, timeout)
+                sample_summary[cp] = (ok, total)
+                if probs:
+                    report.append(f"[{cp}] sample problems: " + '; '.join(probs))
+
+        # ---- generated inputs ----
+        agree = {n: 0 for n in names}
+        compared = 0
+        disagreements = []   # (size, seed, gen_name, input_text, outputs dict name->key)
+        max_size, times_at_max = -1, {}
+        skipped, oracle_errors = 0, []
+        t_start = time.monotonic()
+        stopped = False
+        for gname in gen_names:
+            for seed in range(num_tests):
+                if time.monotonic() - t_start > _STRESS_BUDGET:
+                    stopped = True
+                    break
+                inp = _gen_input(os.path.join(tmpdir, gname), seed, tmpdir, timeout)
+                if inp is None:
+                    report.append(f"generator {gname} failed on seed {seed}; skipped")
+                    continue
+                keys, raws = {}, {}
+                for name in names:
+                    raws[name] = _run(os.path.join(tmpdir, name), tmpdir, inp, timeout)
+                    keys[name] = _result_key(raws[name])
+                oracle_raw = None
+                if oracle_path:
+                    oracle_raw = _run(os.path.join(tmpdir, '_oracle.py'), tmpdir, inp, timeout)
+                    ref = _result_key(oracle_raw)
+                    if ref[0] == 'fail':
+                        # The oracle itself failed (too slow or crashed): this input cannot be judged.
+                        skipped += 1
+                        if oracle_errors is not None and len(oracle_errors) < 2:
+                            oracle_errors.append(f"seed {seed} ({gname}): " + _fmt_raw('oracle', oracle_raw))
+                        continue
+                else:
+                    ref_key, _ = Counter(keys.values()).most_common(1)[0]
+                    ref = ref_key
+                compared += 1
+                if _size(inp) >= max_size:
+                    max_size = _size(inp)
+                    times_at_max = {name: raws[name]['time'] for name in names}
+                for name in names:
+                    if keys[name] == ref:
+                        agree[name] += 1
+                if any(keys[n] != ref for n in names):
+                    disagreements.append((_size(inp), seed, gname, inp, keys, ref, raws, oracle_raw))
+            if stopped:
+                break
+
+        reference = 'oracle' if oracle_path else 'majority'
+        report.append(f"compared {compared} inputs against {reference}")
+        if skipped:
+            report.append(f"skipped {skipped} inputs where the oracle failed (timeout/crash); first oracle failures:\n" + "\n".join(oracle_errors))
+        for cp, name in zip(candidate_paths, names):
+            s = f"{cp}: agreement {agree[name]}/{compared}"
+            if cp in sample_summary:
+                s += f", samples passed {sample_summary[cp][0]}/{sample_summary[cp][1]}"
+            report.append(s)
+        if stopped:
+            report.append(f"Time budget of {_STRESS_BUDGET:.0f}s reached; stopped early.")
+
+        # ---- corpus ----
+        disagreements.sort(key=lambda d: (d[0], d[1], d[2]))
+        if corpus_dir and disagreements:
+            os.makedirs(corpus_dir, exist_ok=True)
+            for size, seed, gname, inp, keys, ref, raws, _orc in disagreements:
+                fname = f"hard_{gname[:-3]}_{seed}.json"
+                record = {
+                    'gen': gname, 'seed': seed, 'input': inp, 'size': size,
+                    'reference': reference,
+                    'outputs': {cp: keys[name][1] for cp, name in zip(candidate_paths, names)},
+                    'agrees': {cp: keys[name] == ref for cp, name in zip(candidate_paths, names)},
+                }
+                with open(os.path.join(corpus_dir, fname), 'w', encoding='utf-8') as f:
+                    json.dump(record, f, indent=2)
+            report.append(f"saved {len(disagreements)} disagreeing inputs to {corpus_dir}")
+
+        # ---- shown disagreements ----
+        if disagreements:
+            report.append(f"{len(disagreements)} disagreeing inputs; smallest {min(_MAX_SHOWN, len(disagreements))}:")
+            for size, seed, gname, inp, keys, ref, raws, orc in disagreements[:_MAX_SHOWN]:
+                lines = [f"--- {gname} seed {seed} (size {size}) input:", _clip(inp).rstrip()]
+                for cp, name in zip(candidate_paths, names):
+                    lines.append(_fmt_raw(cp, raws[name]))
+                if orc is not None:
+                    lines.append(_fmt_raw('oracle', orc))
+                report.append("\n".join(lines))
+        elif compared:
+            report.append("no disagreements")
+        result = dict(empty)
+        result.update({'report': "\n\n".join(report), 'compared': compared,
+                       'agree': {cp: agree[name] for cp, name in zip(candidate_paths, names)},
+                       'samples': sample_summary,
+                       'times': {cp: times_at_max.get(name) for cp, name in zip(candidate_paths, names)},
+                       'max_size': max_size, 'skipped': skipped,
+                       'disagreements': [
+                           {'size': d[0], 'seed': d[1], 'gen': d[2], 'input': d[3],
+                            'outputs': {cp: d[4][name] for cp, name in zip(candidate_paths, names)}}
+                           for d in disagreements]})
+        return result
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
