+def test_solution_check_format_mismatch_levels(tmp_path):
+    from tools import solution_check
+    sol = tmp_path / "sol.py"
+    sol.write_text("print('60')\n")
+    out = solution_check.tool_function(str(sol), inputs=[""], expected_outputs=["60.000\n"])
+    assert "FORMAT MISMATCH (numerically close)" in out and "RESULT: FORMAT_MISMATCH" in out
+    assert "RESULT: OK" not in out and "RESULT: FAILED" not in out
+    # identical text -> OK
+    assert "RESULT: OK" in solution_check.tool_function(str(sol), inputs=[""], expected_outputs=["60\n"])
+    # 'close' vs 'wrong'
+    wrong = tmp_path / "wrong.py"
+    wrong.write_text("print('61')\n")
+    out = solution_check.tool_function(str(wrong), inputs=[""], expected_outputs=["60\n"])
+    assert "RESULT: FAILED" in out and "RESULT: FORMAT_MISMATCH" not in out
+    # tolerance is respected: a small relative difference is close, a large one is wrong
+    approx = tmp_path / "approx.py"
+    approx.write_text("print('45037.07231489528')\n")
+    out = solution_check.tool_function(str(approx), inputs=[""], expected_outputs=["45037.072314895291\n"])
+    assert "RESULT: FORMAT_MISMATCH" in out
+    out = solution_check.tool_function(str(approx), inputs=[""], expected_outputs=["45037.072314895291\n"],
+                                       float_tol=0.0)
+    assert "RESULT: FAILED" in out
+    # classify directly
+    assert solution_check.classify("60\n", "60\n") == 'exact'
+    assert solution_check.classify("60.000\n", "60\n") == 'close'
+    assert solution_check.classify("61\n", "60\n") == 'wrong'
+    assert solution_check.classify("1 2\n", "1\n") == 'wrong'
