+def _is_float_token(tok):
+    try:
+        return math.isfinite(float(tok))
+    except ValueError:
+        return False
+
+
+def classify(out, expected, float_tol=1e-6):
+    """Classify a stdin-mode output against the expected text.
+
+    Returns 'exact' (token-wise equal), 'close' (same token count, every pair parses as a
+    finite float and is within float_tol absolute or relative, but the text differs) or 'wrong'.
+    """
+    got, exp = out.split(), expected.split()
+    if got == exp:
+        return 'exact'
+    if len(got) != len(exp):
+        return 'wrong'
+    for g, e in zip(got, exp):
+        if g == e:
+            continue
+        if not (_is_float_token(g) and _is_float_token(e)):
+            return 'wrong'
+        fg, fe = float(g), float(e)
+        diff = abs(fg - fe)
+        if diff > float_tol and diff > float_tol * max(abs(fg), abs(fe)):
+            return 'wrong'
+    return 'close'
+
+
+def _token_format(tok):
+    """(decimal digit count, is_integer_form) for a numeric token."""
+    if 'e' in tok.lower():
+        mant = tok.lower().split('e')[0]
+        decimals = len(mant.split('.')[1]) if '.' in mant else 0
+        return decimals, False
+    if '.' in tok:
+        return len(tok.split('.')[1]), False
+    return 0, True
+
+
+def _format_mismatch_report(i, out, expected):
+    got_toks, exp_toks = out.split(), expected.split()
+    lines = [f"[input {i}] FORMAT MISMATCH (numerically close)",
+             "got:      " + " ".join(got_toks)[:_MAX_STREAM],
+             "expected: " + " ".join(exp_toks)[:_MAX_STREAM]]
+    for g, e in zip(got_toks, exp_toks):
+        if g == e:
+            continue
+        gd, gi = _token_format(g)
+        ed, ei = _token_format(e)
+        lines.append(f"  token {g!r} vs {e!r}: decimal digits got={gd} expected={ed}; "
+                     f"integer-form got={gi} expected={ei}")
+    lines.append("The real grader may compare text exactly or with tighter tolerance. "
+                 "Match the sample format: print the same number of decimals/significant digits as the "
+                 "expected output (use repr/%.20f/Decimal for long decimals) and print integers without "
+                 "a decimal point if the sample does.")
+    return "\n".join(lines)
+
