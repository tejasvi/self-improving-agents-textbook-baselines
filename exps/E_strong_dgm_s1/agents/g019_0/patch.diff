+import glob
+import os
+import subprocess
+import sys
+
+MAX_SHOWN_FAILURES = 3
+MAX_TEXT = 1500
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a solution against sample tests and against a brute-force reference on random generated inputs, and return a raw report.
+
+* Sample tests: every `*.in` file in `sample_dir` is fed to the solution on stdin and its stdout is compared with the matching `*.out` file (whitespace-normalised).
+* Stress tests: the generator `gen_path` is run as `python3 gen_path SEED` for SEED = 0..num_cases-1; the same generated input is fed to both `brute_path` and `solution_path`, and the outputs are compared (whitespace-normalised).
+* If `brute_path` is omitted, stress tests only check that the solution runs without crashing or timing out.
+* Each run has its own time limit `timeout` (seconds).
+* The report gives pass/fail counts, the first 3 failing inputs with expected and actual output and stderr, and the maximum runtime of the solution. Errors are NOT parsed; read the raw text and fix the code accordingly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional path to a trusted brute-force Python reference program (reads stdin, writes stdout)."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Optional path to a random input generator. It is run as `python3 gen_path SEED` and must print one test input to stdout."
+                },
+                "sample_dir": {
+                    "type": "string",
+                    "description": "Optional directory containing sample pairs `*.in` and `*.out`."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random stress cases (seeds 0..num_cases-1). Default 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_TEXT):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _run(cmd, stdin_text, timeout, cwd):
+    """Run a command. Returns (status, stdout, stderr, elapsed) where status is
+    'ok', 'timeout', 'crash' (nonzero exit) or 'error' (could not start)."""
+    import time
+    start = time.time()
+    try:
+        p = subprocess.run(cmd, input=stdin_text.encode("utf-8"), capture_output=True,
+                           timeout=timeout, cwd=cwd)
+    except subprocess.TimeoutExpired as e:
+        el = time.time() - start
+        out = e.stdout.decode("utf-8", errors="replace") if isinstance(e.stdout, bytes) else ""
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else ""
+        return "timeout", out, err, el
+    except OSError as e:
+        return "error", "", str(e), 0.0
+    el = time.time() - start
+    out = p.stdout.decode("utf-8", errors="replace")
+    err = p.stderr.decode("utf-8", errors="replace")
+    if p.returncode != 0:
+        return "crash", out, err, el
+    return "ok", out, err, el
+
+
+def _same(a, b):
+    return a.split() == b.split()
+
+
+def _clamp_int(v, lo, hi, default):
+    try:
+        v = int(v)
+    except (TypeError, ValueError):
+        return default
+    return max(lo, min(hi, v))
+
+
+def evaluate(solution_path, brute_path=None, gen_path=None, sample_dir=None,
+             num_cases=200, timeout=10):
+    """Run all checks and return a structured dict (used for scoring as well as reporting)."""
+    solution_path = os.path.abspath(solution_path)
+    num_cases = _clamp_int(num_cases, 0, 2000, 200)
+    timeout = _clamp_int(timeout, 1, 60, 10)
+    cwd = os.path.dirname(solution_path) or None
+    result = {
+        "error": None,
+        "samples_total": 0, "samples_passed": 0, "sample_failures": [],
+        "stress_total": 0, "stress_passed": 0, "stress_failures": [],
+        "timeouts": 0, "crashes": 0, "max_time": 0.0,
+    }
+    if not os.path.isfile(solution_path):
+        result["error"] = f"solution file not found: {solution_path}"
+        return result
+
+    def sol(inp):
+        status, out, err, el = _run([sys.executable, solution_path], inp, timeout, cwd)
+        result["max_time"] = max(result["max_time"], el)
+        if status == "timeout":
+            result["timeouts"] += 1
+        elif status == "crash":
+            result["crashes"] += 1
+        return status, out, err
+
+    # 1. Samples
+    if sample_dir:
+        if not os.path.isdir(sample_dir):
+            result["error"] = f"sample_dir not found: {sample_dir}"
+        for in_path in sorted(glob.glob(os.path.join(sample_dir, "*.in"))):
+            out_path = in_path[:-3] + ".out"
+            if not os.path.isfile(out_path):
+                continue
+            with open(in_path, "r", encoding="utf-8", errors="replace") as f:
+                inp = f.read()
+            with open(out_path, "r", encoding="utf-8", errors="replace") as f:
+                expected = f.read()
+            result["samples_total"] += 1
+            status, out, err = sol(inp)
+            if status == "ok" and _same(out, expected):
+                result["samples_passed"] += 1
+            else:
+                result["sample_failures"].append({
+                    "label": os.path.basename(in_path), "input": inp, "expected": expected,
+                    "actual": out, "stderr": err, "status": status,
+                })
+
+    # 2. Stress tests
+    if gen_path and os.path.isfile(gen_path) and num_cases > 0:
+        gen_abs = os.path.abspath(gen_path)
+        brute_abs = os.path.abspath(brute_path) if brute_path else None
+        for seed in range(num_cases):
+            gstat, inp, gerr, _ = _run([sys.executable, gen_abs, str(seed)], "", timeout, cwd)
+            if gstat != "ok":
+                result["error"] = (result["error"] or "") + f"generator failed on seed {seed}: {gstat} {gerr[-300:]}\n"
+                break
+            result["stress_total"] += 1
+            if brute_abs and os.path.isfile(brute_abs):
+                bstat, expected, berr, _ = _run([sys.executable, brute_abs], inp, timeout, cwd)
+                if bstat != "ok":
+                    result["error"] = (result["error"] or "") + (
+                        f"brute_path failed on seed {seed} ({bstat}): {berr[-300:]}\n")
+                    break
+                status, out, err = sol(inp)
+                if status == "ok" and _same(out, expected):
+                    result["stress_passed"] += 1
+                else:
+                    result["stress_failures"].append({
+                        "label": f"seed {seed}", "input": inp, "expected": expected,
+                        "actual": out, "stderr": err, "status": status,
+                    })
+            else:
+                status, out, err = sol(inp)
+                if status == "ok":
+                    result["stress_passed"] += 1
+                else:
+                    result["stress_failures"].append({
+                        "label": f"seed {seed}", "input": inp, "expected": None,
+                        "actual": out, "stderr": err, "status": status,
+                    })
+    return result
+
+
+def _format_failure(f):
+    head = f"--- failing case {f['label']} (status: {f['status']}) ---\n"
+    parts = [head, f"input:\n{_clip(f['input'], 600)}\n"]
+    if f["expected"] is not None:
+        parts.append(f"expected output:\n{_clip(f['expected'], 400)}\n")
+    parts.append(f"actual output:\n{_clip(f['actual'], 400)}\n")
+    if f["stderr"]:
+        parts.append(f"stderr:\n{_clip(f['stderr'][-600:], 600)}\n")
+    return "".join(parts)
+
+
+def format_report(r):
+    lines = []
+    if r["error"]:
+        lines.append(f"Error: {r['error'].strip()}")
+    lines.append(f"Samples: {r['samples_passed']}/{r['samples_total']} passed")
+    lines.append(f"Stress: {r['stress_passed']}/{r['stress_total']} passed")
+    lines.append(f"Timeouts: {r['timeouts']}, crashes: {r['crashes']}")
+    lines.append(f"Max runtime: {r['max_time']:.3f}s")
+    failures = r["sample_failures"] + r["stress_failures"]
+    if failures:
+        lines.append(f"\nFirst {min(MAX_SHOWN_FAILURES, len(failures))} of {len(failures)} failing cases:")
+        for f in failures[:MAX_SHOWN_FAILURES]:
+            lines.append(_format_failure(f))
+    elif r["samples_total"] + r["stress_total"] == 0:
+        lines.append("\nNothing was tested (no samples or stress cases ran).")
+    else:
+        lines.append("\nAll checks passed.")
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, brute_path=None, gen_path=None, sample_dir=None,
+                  num_cases=200, timeout=10):
+    r = evaluate(solution_path, brute_path=brute_path, gen_path=gen_path,
+                 sample_dir=sample_dir, num_cases=num_cases, timeout=timeout)
+    return format_report(r)
