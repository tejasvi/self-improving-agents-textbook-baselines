diff --git a/tools/solution_check.py b/tools/solution_check.py
new file mode 100644
index 0000000..21d5cc0
--- /dev/null
+++ b/tools/solution_check.py
@@ -0,0 +1,205 @@
+import ast
+import builtins
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+# Grader-style checker for stdin-based Python solutions.
+# The solution is copied into a fresh temp dir as _sol.py and run with `python -I`
+# (isolated mode: no cwd / user site on sys.path, no PYTHON* env vars), so the
+# result mirrors how a grader would execute it.
+
+_MAX_STREAM = 4000        # chars of stdout/stderr kept per run
+_STRESS_BUDGET = 240.0    # total wall-clock seconds allowed for stress mode
+
+
+def tool_info():
+    return {
+        "name": "solution_check",
+        "description": """Grader-style checker for a stdin-based Python solution.\n
+* Copies the solution into a fresh temp directory as `_sol.py` and runs it with `python -I` (isolated mode) using only the provided stdin, so it behaves like the real grader.\n
+* Without brute_path/gen_path: runs every entry of `inputs` and reports stdout, stderr, exit code and elapsed time. If `expected_outputs` is given, compares each output (whitespace-normalised) with the matching expected output.\n
+* With brute_path and gen_path (stress mode): for seeds 0..num_tests-1, runs `python gen.py <seed>` to make an input, then runs both the brute-force reference and the solution on it. Stops at the first mismatch, runtime error (nonzero exit) or timeout and prints the input and both outputs.\n
+* Any stderr is shown verbatim. A nonzero exit code or any stderr output is a failure.\n
+* Pass the same solution file again after every edit; the check always uses the current contents.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the Python solution file (reads stdin, writes stdout)."},
+                "inputs": {"type": "array", "items": {"type": "string"}, "description": "Stdin contents to run the solution on, one string per run (e.g. each sample input, or a max-size input)."},
+                "expected_outputs": {"type": "array", "items": {"type": "string"}, "description": "Expected stdout for each entry of `inputs`, in the same order. Compared whitespace-normalised."},
+                "brute_path": {"type": "string", "description": "Path to a trusted brute-force Python reference program (stress mode, needs gen_path)."},
+                "gen_path": {"type": "string", "description": "Path to a random input generator; it is called as `python gen.py <seed>` and prints one test input to stdout (stress mode, needs brute_path)."},
+                "num_tests": {"type": "integer", "description": "Number of random seeds to try in stress mode (default 200)."},
+                "timeout": {"type": "integer", "description": "Per-run time limit in seconds (default 10)."}
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clip(s, n=_MAX_STREAM):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _normalise(s):
+    lines = [line.rstrip() for line in s.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def _builtin_shadow_warnings(src):
+    """Cheap AST scan: warn when the source binds a name that is a Python builtin."""
+    try:
+        tree = ast.parse(src)
+    except SyntaxError as e:
+        return [f"syntax error at line {e.lineno}: {e.msg}"]
+    names = set(dir(builtins))
+    found = []
+    for node in ast.walk(tree):
+        name, line = None, getattr(node, 'lineno', '?')
+        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store):
+            name = node.id
+        elif isinstance(node, (ast.FunctionDef, ast.ClassDef)):
+            name = node.name
+        elif isinstance(node, ast.arg):
+            name = node.arg
+        if name in names:
+            found.append(f"line {line}: '{name}' shadows a Python builtin")
+    return sorted(set(found))
+
+
+def _run(cmd, cwd, stdin_text, timeout):
+    """Run a command; returns (status, stdout, stderr, rc, elapsed). status in ok|timeout."""
+    t0 = time.monotonic()
+    try:
+        p = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True,
+                           timeout=timeout, cwd=cwd, errors='replace')
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return 'timeout', out, err, None, time.monotonic() - t0
+    return 'ok', p.stdout, p.stderr, p.returncode, time.monotonic() - t0
+
+
+def _fmt_run(label, status, out, err, rc, elapsed):
+    lines = [f"--- {label}: status={status} exit_code={rc} time={elapsed:.3f}s"]
+    if status == 'timeout':
+        lines.append("TIMED OUT")
+    lines.append("stdout:\n" + (_clip(out).rstrip() or "(empty)"))
+    if err.strip():
+        lines.append("STDERR (raw):\n" + _clip(err).rstrip())
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, inputs=None, expected_outputs=None, brute_path=None, gen_path=None,
+                  num_tests=200, timeout=10):
+    try:
+        timeout = max(1, int(timeout or 10))
+        num_tests = max(0, int(num_tests if num_tests is not None else 200))
+    except (TypeError, ValueError) as e:
+        return f"Error: invalid numeric argument: {e}"
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    stress = bool(brute_path) or bool(gen_path)
+    if stress and not (brute_path and gen_path):
+        return "Error: stress mode needs both brute_path and gen_path."
+    if not stress and not inputs:
+        return "Error: provide `inputs` (for a plain check) or brute_path + gen_path (for stress mode)."
+    for p in (brute_path, gen_path):
+        if p and not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+
+    with open(solution_path, 'r', errors='replace') as f:
+        src = f.read()
+    warnings = _builtin_shadow_warnings(src)
+
+    tmpdir = tempfile.mkdtemp(prefix='solcheck_')
+    try:
+        shutil.copyfile(solution_path, os.path.join(tmpdir, '_sol.py'))
+        report = []
+        if warnings:
+            report.append("WARNING (builtin shadowing, can break in the grader):\n  " + "\n  ".join(warnings))
+
+        # ---- plain mode: fixed inputs ----
+        if inputs:
+            passed, max_t, failed = 0, 0.0, False
+            for i, inp in enumerate(inputs):
+                status, out, err, rc, el = _run([sys.executable, '-I', '_sol.py'], tmpdir, inp, timeout)
+                max_t = max(max_t, el)
+                problems = []
+                if status == 'timeout':
+                    problems.append("timeout")
+                if rc != 0:
+                    problems.append(f"exit code {rc}")
+                if err.strip():
+                    problems.append("stderr is not empty")
+                if expected_outputs is not None and i < len(expected_outputs) and status == 'ok':
+                    if _normalise(out) != _normalise(expected_outputs[i]):
+                        problems.append("output differs from expected")
+                if problems:
+                    failed = True
+                    report.append(f"[input {i}] FAIL: {', '.join(problems)}\n"
+                                  f"input:\n{_clip(inp).rstrip()}\n"
+                                  + _fmt_run(f"solution on input {i}", status, out, err, rc, el))
+                    if expected_outputs is not None and i < len(expected_outputs):
+                        report.append("expected:\n" + _clip(expected_outputs[i]).rstrip())
+                else:
+                    passed += 1
+            report.append(f"{passed}/{len(inputs)} passed, max time {max_t:.3f} s")
+            if failed:
+                report.append("RESULT: FAILED")
+            elif not warnings:
+                report.append("RESULT: OK")
+
+        # ---- stress mode: brute vs solution on generated inputs ----
+        if stress:
+            shutil.copyfile(brute_path, os.path.join(tmpdir, '_brute.py'))
+            shutil.copyfile(gen_path, os.path.join(tmpdir, '_gen.py'))
+            t_start = time.monotonic()
+            ran, max_t, mismatch = 0, 0.0, None
+            for seed in range(num_tests):
+                if time.monotonic() - t_start > _STRESS_BUDGET:
+                    report.append(f"Stress budget of {_STRESS_BUDGET:.0f}s reached; stopped early.")
+                    break
+                gst, gen_out, gerr, grc, _ = _run([sys.executable, '-I', '_gen.py', str(seed)], tmpdir, '', timeout)
+                if gst != 'ok' or grc != 0:
+                    mismatch = f"generator failed on seed {seed}\n" + _fmt_run("gen", gst, gen_out, gerr, grc, 0.0)
+                    break
+                test_in = gen_out
+                bst, bout, berr, brc, _ = _run([sys.executable, '-I', '_brute.py'], tmpdir, test_in, timeout)
+                if bst != 'ok' or brc != 0 or berr.strip():
+                    mismatch = (f"brute-force reference failed on seed {seed} (fix the brute/gen, not the solution)\n"
+                                f"input:\n{_clip(test_in).rstrip()}\n"
+                                + _fmt_run("brute", bst, bout, berr, brc, 0.0))
+                    break
+                sst, sout, serr, src_rc, el = _run([sys.executable, '-I', '_sol.py'], tmpdir, test_in, timeout)
+                max_t = max(max_t, el)
+                ran += 1
+                if sst == 'timeout' or src_rc != 0 or serr.strip():
+                    why = 'timeout' if sst == 'timeout' else (f'exit code {src_rc}' if src_rc != 0 else 'stderr not empty')
+                    mismatch = (f"solution FAILED on seed {seed}: {why}\ninput:\n{_clip(test_in).rstrip()}\n"
+                                + _fmt_run("solution", sst, sout, serr, src_rc, el)
+                                + "\n" + _fmt_run("brute (expected)", bst, bout, berr, brc, 0.0))
+                    break
+                if _normalise(sout) != _normalise(bout):
+                    mismatch = (f"WRONG ANSWER on seed {seed}\ninput:\n{_clip(test_in).rstrip()}\n"
+                                + _fmt_run("solution", sst, sout, serr, src_rc, el)
+                                + "\n" + _fmt_run("brute (expected)", bst, bout, berr, brc, 0.0))
+                    break
+            if mismatch:
+                report.append(mismatch)
+                report.append(f"RESULT: FAILED (stress: {ran}/{num_tests} seeds ran before failure)")
+            else:
+                report.append(f"stress: {ran}/{num_tests} passed, max time {max_t:.3f} s")
+                if not warnings:
+                    report.append("RESULT: OK")
+        return "\n\n".join(report)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
