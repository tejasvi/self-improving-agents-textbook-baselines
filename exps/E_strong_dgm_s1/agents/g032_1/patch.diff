+def test_solution_check_pow3_blocked_and_modpow_ok(tmp_path):
+    from tools import solution_check
+    pow_sol = tmp_path / "pow_sol.py"
+    pow_sol.write_text("a, b = map(int, input().split())\nprint(pow(a, b, 7))\n")
+    modpow_sol = tmp_path / "modpow_sol.py"
+    modpow_sol.write_text(
+        "def modpow(b, e, m):\n"
+        "    r = 1 % m\n"
+        "    b %= m\n"
+        "    for i in range(e.bit_length()):\n"
+        "        if (e >> i) & 1:\n"
+        "            r = r * b % m\n"
+        "        b = b * b % m\n"
+        "    return r\n"
+        "a, b = map(int, input().split())\n"
+        "print(modpow(a, b, 7))\n")
+    out = solution_check.tool_function(str(pow_sol), inputs=["2 10\n"], expected_outputs=["2\n"])
+    assert "WARNING" in out and "pow" in out
+    assert "RESULT: OK" not in out
+    out = solution_check.tool_function(str(modpow_sol), inputs=["2 10\n"], expected_outputs=["2\n"])
+    assert "WARNING" not in out
+    assert "RESULT: OK" in out
+
+def test_solution_check_strict_pow_runtime_in_class_mode(tmp_path):
+    from tools import solution_check
+    sol = tmp_path / "psol.py"
+    sol.write_text("class Solution:\n    def f(self, a, b):\n        return pow(a, b, 7)\n")
+    out = solution_check.tool_function(str(sol), method="f", args_list=["[2, 10]"], expected_outputs=["2"])
+    assert "RESULT: OK" not in out
+    assert "strict-mode failure" in out
