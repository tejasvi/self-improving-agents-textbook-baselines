+++ b/tests/brute.py
@@ -0,0 +1,34 @@
+import json
+import sys
+
+
+def main():
+    # Input: line 1 = JSON string `word`, line 2 = integer k.
+    lines = sys.stdin.read().split("\n")
+    word = json.loads(lines[0])
+    k = int(lines[1].strip())
+    n = len(word)
+    count = 0
+    # Exhaustive enumeration of every substring, checked directly from the definition.
+    for i in range(n):
+        for j in range(i + 1, n + 1):
+            sub = word[i:j]
+            if len(sub) % k != 0:
+                continue
+            freq = {}
+            for ch in sub:
+                freq[ch] = freq.get(ch, 0) + 1
+            if any(v != k for v in freq.values()):
+                continue
+            ok = True
+            for p in range(len(sub) - 1):
+                if abs(ord(sub[p]) - ord(sub[p + 1])) > 2:
+                    ok = False
+                    break
+            if ok:
+                count += 1
+    print(count)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/checker.py b/tests/checker.py
new file mode 100644
index 0000000..f5afd6d
--- /dev/null
+++ b/tests/checker.py
@@ -0,0 +1,120 @@
+import json
+import sys
+
+
+def read_text(path):
+    with open(path, "r") as f:
+        return f.read()
+
+
+def normalise(text):
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def fast_count(word, k):
+    """Independent O(26 * n) sliding-window count, used for large inputs.
+
+    For each number of distinct letters d, a window of length d*k is valid iff
+    exactly d letters appear in it and each of them appears exactly k times.
+    Windows are only considered inside maximal segments where adjacent letters
+    differ by at most 2 in alphabet order.
+    """
+    n = len(word)
+    codes = [ord(c) - 97 for c in word]
+    total = 0
+    # Split into maximal segments where neighbouring letters differ by <= 2.
+    segments = []
+    start = 0
+    for i in range(1, n + 1):
+        if i == n or abs(codes[i] - codes[i - 1]) > 2:
+            segments.append((start, i))
+            start = i
+    for lo, hi in segments:
+        for d in range(1, 27):
+            length = d * k
+            if length > hi - lo:
+                break
+            freq = [0] * 26
+            nonzero = 0  # letters with freq > 0 in the window
+            eqk = 0      # letters with freq == k in the window
+            for idx in range(lo, hi):
+                c = codes[idx]
+                if freq[c] == 0:
+                    nonzero += 1
+                freq[c] += 1
+                if freq[c] == k:
+                    eqk += 1
+                elif freq[c] == k + 1:
+                    eqk -= 1
+                if idx - length >= lo:
+                    old = codes[idx - length]
+                    if freq[old] == k:
+                        eqk -= 1
+                    elif freq[old] == k + 1:
+                        eqk += 1
+                    freq[old] -= 1
+                    if freq[old] == 0:
+                        nonzero -= 1
+                if idx - lo + 1 >= length and nonzero == d and eqk == d:
+                    total += 1
+    return total
+
+
+def reference_count_small(word, k):
+    """Exhaustive enumeration of every substring, checked from the definition.
+
+    Inlined here (not a subprocess call to brute.py) so the checker works when
+    copied to a temp directory on its own.
+    """
+    n = len(word)
+    count = 0
+    for i in range(n):
+        for j in range(i + 1, n + 1):
+            sub = word[i:j]
+            if len(sub) % k != 0:
+                continue
+            freq = {}
+            for ch in sub:
+                freq[ch] = freq.get(ch, 0) + 1
+            if any(v != k for v in freq.values()):
+                continue
+            ok = True
+            for p in range(len(sub) - 1):
+                if abs(ord(sub[p]) - ord(sub[p + 1])) > 2:
+                    ok = False
+                    break
+            if ok:
+                count += 1
+    return count
+
+
+def main():
+    if len(sys.argv) != 3:
+        print("usage: checker.py <input_file> <output_file>")
+        return 2
+    inp = read_text(sys.argv[1])
+    out = read_text(sys.argv[2])
+
+    lines = inp.split("\n")
+    word = json.loads(lines[0])
+    k = int(lines[1].strip())
+
+    if len(word) <= 300:
+        # Small input: exhaustive enumeration reference (independent of efficient solutions).
+        want = [str(reference_count_small(word, k))]
+    else:
+        # Large input: independent sliding-window method (enumeration is infeasible here).
+        want = [str(fast_count(word, k))]
+
+    got = normalise(out)
+    if got != want:
+        print("mismatch: expected %r, got %r" % (want[:5], got[:5]))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
