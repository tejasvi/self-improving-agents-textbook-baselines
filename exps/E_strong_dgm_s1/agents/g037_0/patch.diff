+import json
+import sys
+
+
+def count_segment(seg, k, alpha_size, ids):
+    # Count substrings of seg where every distinct char appears exactly k times.
+    # For each distinct-count m, use a fixed-length window of length m*k.
+    n = len(seg)
+    total = 0
+    max_m = min(alpha_size, n // k)
+    for m in range(1, max_m + 1):
+        length = m * k
+        freq = [0] * alpha_size
+        distinct = 0
+        good = 0  # number of chars whose frequency is exactly k
+        for r in range(n):
+            c = ids[r]
+            f = freq[c] + 1
+            freq[c] = f
+            if f == 1:
+                distinct += 1
+            if f == k:
+                good += 1
+            elif f == k + 1:
+                good -= 1
+            if r >= length:
+                c = ids[r - length]
+                f = freq[c]
+                if f == k:
+                    good -= 1
+                elif f == k + 1:
+                    good += 1
+                f -= 1
+                freq[c] = f
+                if f == 0:
+                    distinct -= 1
+            if r >= length - 1 and distinct == m and good == m:
+                total += 1
+    return total
+
+
+def main():
+    data = sys.stdin.read().split("\n")
+    word = json.loads(data[0])
+    k = int(data[1].strip())
+    n = len(word)
+    if k <= 0:
+        print(0)
+        return
+    # Map characters to small integer ids.
+    alphabet = {}
+    for ch in word:
+        if ch not in alphabet:
+            alphabet[ch] = len(alphabet)
+    all_ids = [alphabet[ch] for ch in word]
+    alpha_size = len(alphabet)
+
+    total = 0
+    start = 0
+    for i in range(1, n + 1):
+        if i == n or abs(ord(word[i]) - ord(word[i - 1])) > 2:
+            total += count_segment(word[start:i], k, alpha_size, all_ids[start:i])
+            start = i
+    print(total)
+
+
+if __name__ == "__main__":
+    main()
