@@ -0,0 +1,57 @@
+import json
+import sys
+
+
+class Solution:
+    def countCompleteSubstrings(self, word: str, k: int) -> int:
+        n = len(word)
+        codes = [ord(c) - 97 for c in word]
+        total = 0
+        # Split into maximal blocks where adjacent characters differ by at most 2.
+        start = 0
+        while start < n:
+            end = start + 1
+            while end < n and abs(codes[end] - codes[end - 1]) <= 2:
+                end += 1
+            block = codes[start:end]
+            m = len(block)
+            # A valid substring with d distinct letters has length d*k.
+            for d in range(1, 27):
+                length = d * k
+                if length > m:
+                    break
+                cnt = [0] * 26
+                good = 0   # letters with count exactly k
+                bad = 0    # letters with count greater than k
+                for i in range(m):
+                    c = block[i]
+                    cnt[c] += 1
+                    if cnt[c] == k:
+                        good += 1
+                    elif cnt[c] == k + 1:
+                        good -= 1
+                        bad += 1
+                    if i >= length:
+                        o = block[i - length]
+                        if cnt[o] == k:
+                            good -= 1
+                        elif cnt[o] == k + 1:
+                            bad -= 1
+                        cnt[o] -= 1
+                        if cnt[o] == k:
+                            good += 1
+                    if i >= length - 1 and bad == 0 and good == d:
+                        total += 1
+            start = end
+        return total
+
+
+def main():
+    lines = sys.stdin.read().split("\n")
+    word = json.loads(lines[0])
+    k = int(lines[1].strip())
+    print(Solution().countCompleteSubstrings(word, k))
+
+
+if __name__ == "__main__":
+    main()
