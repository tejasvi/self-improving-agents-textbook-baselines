+++ b/tests/gen.py
@@ -0,0 +1,83 @@
+import json
+import random
+import sys
+
+
+def make_word(rng, n, alphabet):
+    return "".join(rng.choice(alphabet) for _ in range(n))
+
+
+def make_block_word(rng, n, k):
+    # Builds words with long runs of exact k-blocks so that answers are non-trivial.
+    letters = "abcdefghijklmnopqrstuvwxyz"
+    out = []
+    total = 0
+    while total < n:
+        c = rng.choice(letters[: rng.randint(2, 6)])
+        run = k * rng.randint(1, 3)
+        out.append(c * run)
+        total += run
+    return "".join(out)[:n]
+
+
+def gen_one(rng, mode):
+    if mode == "edge":
+        choice = rng.randint(0, 4)
+        if choice == 0:
+            word, k = "a", 1
+        elif choice == 1:
+            word, k = "a" * rng.randint(1, 10), 1
+        elif choice == 2:
+            word, k = "a" * rng.randint(1, 12), rng.randint(2, 12)
+        elif choice == 3:
+            word, k = "ab", 2
+        else:
+            word = "".join(rng.choice("abcde") for _ in range(rng.randint(1, 12)))
+            k = rng.randint(1, 4)
+        return word, k
+
+    if mode == "max":
+        n = 10 ** 5
+        word = make_block_word(rng, n, 1)
+        return word, 1
+
+    if mode == "medium":
+        n = rng.choice([rng.randint(50, 150), rng.randint(150, 500)])
+        k = rng.randint(1, 5)
+        if rng.random() < 0.5:
+            word = make_block_word(rng, n, k)
+        else:
+            word = make_word(rng, n, "abcdefghijklmnopqrstuvwxyz"[: rng.randint(2, 8)])
+        return word, k
+
+    # small (default): sizes vary a lot across seeds.
+    size_roll = rng.random()
+    if size_roll < 0.2:
+        n = rng.randint(1, 5)
+    elif size_roll < 0.8:
+        n = rng.randint(5, 40)
+    else:
+        n = rng.randint(40, 120)
+    k = rng.randint(1, 4)
+    if rng.random() < 0.5:
+        word = make_block_word(rng, n, k)
+    else:
+        word = make_word(rng, n, "abcdefghijklmnopqrstuvwxyz"[: rng.randint(2, 6)])
+    return word, k
+
+
+def main():
+    seed = int(sys.argv[1])
+    mode = sys.argv[2] if len(sys.argv) > 2 else "small"
+    rng = random.Random(seed)
+    random.seed(seed)
+    word, k = gen_one(rng, mode)
+    if mode == "max":
+        # Word is at most 10^5 characters; k between 1 and 10^5.
+        k = rng.randint(1, 3)
+    print(json.dumps(word))
+    print(k)
+
+
+if __name__ == "__main__":
+    main()
