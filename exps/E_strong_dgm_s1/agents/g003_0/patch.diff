+def test_forward_empty_reply_retry_and_best_restore(tmp_path, monkeypatch):
+    """
+    Mocked LLM, keyed on prompt content. Attempt 0 writes a wrong (but fast) solution, attempt 1 is
+    empty so the minimal retry runs and writes the correct one. The best snapshot must be restored.
+    """
