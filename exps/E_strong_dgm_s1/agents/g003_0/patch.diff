+    (tmp_path / "max_gen.py").write_text("print(5)\n")
+    good = "print(int(input()) * 2)\n"
+    bad = "print(int(input()) * 3)\n"
+    messages = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=None):
+        assert msg_history == []           # every call is a fresh context
+        messages.append(msg)
+        sol = tmp_path / "solution.py"
+        if "Write a draft solution.py" in msg:
+            sol.write_text(bad)            # attempt 0: wrong answer on the sample
+        elif "Call the editor tool now" in msg:
+            sol.write_text(good)           # minimal retry: correct solution
+        return []                          # attempt replies are empty
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+    agent = AgenticSystem.__new__(AgenticSystem)
+    agent.git_tempdir = str(tmp_path)
+    agent.problem_statement = "Sample Input 1:\n3\nSample Output 1:\n6\n"
+    agent.code_model = "m"
+    agent.forward()
+    # Attempt 0 is wrong on the sample; the retry prompt for attempt 1 must carry the failure.
+    retry_prompts = [m for m in messages if "This is attempt 2 of" in m]
+    assert retry_prompts, messages
+    assert "output differs from expected" in retry_prompts[0]
+    assert any("Call the editor tool now" in m for m in messages)
