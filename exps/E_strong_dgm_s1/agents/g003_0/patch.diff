+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from coding_agent import AgenticSystem
+
+
+STATEMENT = """Sample Input 1:
+3
+1 2 3
+Sample Output 1:
+6
+Explanation: the sum is 6.
+
+Sample Input 2:
+```
+5
+```
+Sample Output 2:
+```
+10
+```
+"""
+
+
+def test_extract_samples_plain_and_fenced():
+    samples = AgenticSystem._extract_samples(STATEMENT)
+    assert samples == [("3\n1 2 3\n", "6"), ("5\n", "10")]
+
+
+def test_extract_samples_none():
+    assert AgenticSystem._extract_samples("no samples here") == []
+    assert AgenticSystem._extract_samples("") == []
+
+
+def test_score_orders_samples_then_stress_then_max():
+    report_ok = ("2/2 passed, max time 0.1 s\nstress: 200/200 passed, max time 0.1 s\n"
+                 "MAX-SIZE CHECK: OK time=0.5s\nRESULT: OK")
+    report_no_max = "2/2 passed, max time 0.1 s\nstress: 200/200 passed, max time 0.1 s\nRESULT: OK"
+    report_stress_fail = ("2/2 passed, max time 0.1 s\nWRONG ANSWER on seed 3\n"
+                          "RESULT: FAILED (stress: 3/200 seeds ran before failure)")
+    report_samples_fail = "1/2 passed, max time 0.1 s\nRESULT: FAILED (plain)"
+    s_ok = AgenticSystem._score_from_report(report_ok)
+    s_nomax = AgenticSystem._score_from_report(report_no_max)
+    s_stress = AgenticSystem._score_from_report(report_stress_fail)
+    s_samples = AgenticSystem._score_from_report(report_samples_fail)
+    assert s_ok == (2, 1, 1)
+    assert s_nomax == (2, 1, 0)
+    assert s_stress == (2, 0, 0)
+    assert s_samples == (1, 0, 0)
+    assert s_ok > s_nomax > s_stress
+    assert s_stress > s_samples
+
+
+def test_score_on_garbage_is_zero():
+    assert AgenticSystem._score_from_report("") == (0, 0, 0)
+    assert AgenticSystem._score_from_report("some crash text") == (0, 0, 0)
+
+
+def test_is_complete():
+    assert AgenticSystem._is_complete((2, 1, 1), 2)
+    assert not AgenticSystem._is_complete((2, 1, 0), 2)
+    assert not AgenticSystem._is_complete((1, 1, 1), 2)
+    assert not AgenticSystem._is_complete((0, 0, 0), 0)
+    assert AgenticSystem._is_complete((0, 1, 1), 0)  # no samples: stress + max decide
+
+
+def test_pick_best_keeps_highest_and_earliest_on_tie():
+    best = None
+    best = AgenticSystem._pick_best(best, ((1, 0, 0), "a"))
+    best = AgenticSystem._pick_best(best, ((2, 0, 0), "b"))
+    best = AgenticSystem._pick_best(best, ((2, 0, 0), "c"))  # tie: keep earlier
+    best = AgenticSystem._pick_best(best, ((0, 1, 1), "d"))
+    assert best == ((2, 0, 0), "b")
+
+
+def test_run_validation_on_toy_solution(tmp_path):
+    (tmp_path / "solution.py").write_text("n = int(input())\nprint(sum(map(int, input().split())))\n")
+    (tmp_path / "brute.py").write_text("n = int(input())\nprint(sum(map(int, input().split())))\n")
+    (tmp_path / "gen.py").write_text("import random, sys\nrandom.seed(int(sys.argv[1]))\n"
+                                     "n = random.randint(1, 5)\nprint(n)\nprint(*[random.randint(0, 9) for _ in range(n)])\n")
+    (tmp_path / "max_gen.py").write_text("print(200000)\nprint(*([7] * 200000))\n")
+    agent = AgenticSystem.__new__(AgenticSystem)
+    agent.git_tempdir = str(tmp_path)
+    agent.problem_statement = "Sample Input 1:\n3\n1 2 3\nSample Output 1:\n6\n"
+    report, score = agent._run_validation()
+    assert score == (1, 1, 1), report
+    assert "RESULT: OK" in report
+
+
+def test_run_validation_detects_wrong_solution(tmp_path):
+    (tmp_path / "solution.py").write_text("n = int(input())\nprint(sum(map(int, input().split())) + 1)\n")
+    agent = AgenticSystem.__new__(AgenticSystem)
+    agent.git_tempdir = str(tmp_path)
