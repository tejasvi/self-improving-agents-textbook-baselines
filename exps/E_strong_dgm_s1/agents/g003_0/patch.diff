+    @staticmethod
+    def _sample_body(block):
+        """Clean one sample block: use the first ``` fenced body if present, else the raw lines."""
+        fence = re.search(r'```[^\n]*\n(.*?)```', block, re.S)
+        body = fence.group(1) if fence else block
+        out = []
+        for line in body.splitlines():
+            if not fence and out and (not line.strip() or _PROSE_RE.match(line)):
+                break
+            out.append(line.rstrip())
+        return '\n'.join(out).strip('\n')
+
+    @classmethod
+    def _extract_samples(cls, problem_statement):
+        """
+        Parse 'Sample Input k' / 'Sample Output k' blocks into a list of (input, expected_output).
+        Input is returned with a trailing newline; expected output is stripped.
+        """
+        samples = []
+        for m in cls._SAMPLE_RE.finditer(problem_statement or ''):
+            inp = cls._sample_body(m.group(2))
+            out = cls._sample_body(m.group(3))
+            if inp.strip():
+                samples.append((inp + '\n', out))
+        return samples
 
