+"""Standalone helpers for the coding agent's task-format handling.
+
+Implements:
+  A. detect_mode(source, statement) -> (mode, method_name)
+  C. method_runner_script(method_name) -> bootstrap source for JSON method calls
+  E. ensure_solution_file(src, method_name) -> cleaned solution source
+     and has_primary_edit(base_src, new_src) -> bool
+"""
+import ast
+import json
+
+
+def detect_mode(source, statement=""):
+    """Return ('method', method_name) for a class-method task, else ('stdin', None).
+
+    method mode: a `class Solution` with a method whose body is only pass/docstring,
+    or the statement says 'standard input' / 'do not read'.
+    """
+    method_name = None
+    stub_found = False
+    try:
+        tree = ast.parse(source or "")
+    except SyntaxError:
+        tree = None
+    if tree is not None:
+        for node in tree.body:
+            if isinstance(node, ast.ClassDef) and node.name == "Solution":
+                for item in node.body:
+                    if isinstance(item, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                        body = item.body
+                        if item.name.startswith("__"):
+                            continue
+                        only_pass = all(
+                            isinstance(s, ast.Pass)
+                            or (isinstance(s, ast.Expr)
+                                and isinstance(getattr(s, "value", None), ast.Constant)
+                                and isinstance(s.value.value, str))
+                            for s in body
+                        )
+                        if only_pass:
+                            method_name = item.name
+                            stub_found = True
+                            break
+                if stub_found:
+                    break
+    stmt = (statement or "").lower()
+    if stub_found:
+        return "method", method_name
+    if tree is not None and any(
+        isinstance(n, ast.ClassDef) and n.name == "Solution" for n in tree.body
+    ) and ("standard input" in stmt or "do not read" in stmt):
+        # Class exists but no stub detected: take the first public method.
+        for node in tree.body:
+            if isinstance(node, ast.ClassDef) and node.name == "Solution":
+                for item in node.body:
+                    if isinstance(item, ast.FunctionDef) and not item.name.startswith("_"):
+                        return "method", item.name
+    return "stdin", None
+
+
+def method_runner_script(method_name):
+    """Bootstrap: import _sol.py, build Solution(), read JSON kwargs on stdin,
+    call the method, print json.dumps(result)."""
+    return (
+        "import json, sys\n"
+        "sys.setrecursionlimit(1000000)\n"
+        "from _sol import Solution\n"
+        "def _main():\n"
+        "    kwargs = json.loads(sys.stdin.read() or '{}')\n"
+        f"    res = getattr(Solution(), {method_name!r})(**kwargs)\n"
+        "    sys.stdout.write(json.dumps(res) + '\\n')\n"
+        "if __name__ == '__main__':\n"
+        "    _main()\n"
+    )
+
+
+def strip_stdin_driver(src):
+    """Remove top-level `if __name__ == '__main__':` blocks and `_main` functions."""
+    tree = ast.parse(src)
+    keep = []
+    for node in tree.body:
+        if isinstance(node, ast.If):
+            test = ast.unparse(node.test) if hasattr(ast, "unparse") else ""
+            if "__name__" in test and "__main__" in test:
+                continue
+        if isinstance(node, ast.FunctionDef) and node.name == "_main":
+            continue
+        keep.append(node)
+    tree.body = keep
+    out = ast.unparse(tree) if hasattr(ast, "unparse") else src
+    if "from typing import *" not in out:
+        out = "from typing import *\n" + out
+    return out + "\n"
+
+
+def ensure_solution_file(src, method_name):
+    """Clean candidate source and verify it. Returns (ok, cleaned_src, report)."""
+    try:
+        cleaned = strip_stdin_driver(src)
+    except SyntaxError as e:
+        return False, src, f"syntax error: {e}"
+    ns = {}
+    try:
+        exec(compile(cleaned, "solution.py", "exec"), ns)
+    except Exception as e:  # noqa: BLE001
+        return False, cleaned, f"import failed: {type(e).__name__}: {e}"
+    cls = ns.get("Solution")
+    if cls is None:
+        return False, cleaned, "no class Solution"
+    fn = getattr(cls, method_name, None)
+    if fn is None:
+        return False, cleaned, f"Solution.{method_name} missing"
+    try:
+        fn_src = ast.get_source_segment(cleaned, ast.parse(cleaned))  # noqa: F841
+    except Exception:  # noqa: BLE001
+        pass
+    for node in ast.walk(ast.parse(cleaned)):
+        if isinstance(node, ast.FunctionDef) and node.name == method_name:
+            if all(isinstance(s, ast.Pass) for s in node.body):
+                return False, cleaned, f"Solution.{method_name} is a pass-only stub"
+    return True, cleaned, "ok"
+
+
+def has_primary_edit(base_src, new_src):
+    """solution.py must parse and differ from the base."""
+    if not new_src or new_src.strip() == (base_src or "").strip():
+        return False
+    try:
+        ast.parse(new_src)
+    except SyntaxError:
+        return False
+    return True
+
+
+if __name__ == "__main__":
+    stub = "from typing import *\nclass Solution:\n    def twoSum(self, nums: List[int], target: int) -> List[int]:\n        pass\n"
+    print(detect_mode(stub, "Do not read from standard input."))
+    good = "class Solution:\n    def twoSum(self, nums, target):\n        return [0, 1]\n\nif __name__ == '__main__':\n    print(1)\n"
+    print(ensure_solution_file(good, "twoSum"))
+    print(has_primary_edit(stub, good))
+    print(json.dumps(method_runner_script("twoSum"))[:80])
