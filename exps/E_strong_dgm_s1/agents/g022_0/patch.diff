+                if text is not None:
+                    inputs.append(text)
+        runs_a = solution_check.run_capture(path_a, inputs, timeout=TIME_LIMIT)
+        runs_b = solution_check.run_capture(path_b, inputs, timeout=TIME_LIMIT)
+        problems = []
+        for idx, inp in enumerate(inputs):
+            ok_a, out_a = runs_a[idx]
