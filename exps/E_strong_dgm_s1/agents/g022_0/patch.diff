+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+
+# Problem with many valid answers: print any pair a <= b with a + b == n (a, b >= 0), or "impossible".
+# Brute: prints the first valid pair. Checker accepts any valid pair (or "impossible" iff none exists).
+BRUTE = ("n = int(input())\n"
+         "for a in range(n + 1):\n"
+         "    if 2 * a <= n + 0 and a <= n - a:\n"
+         "        print(a, n - a)\n"
+         "        break\n"
+         "else:\n"
+         "    print('impossible')\n")
+CHECK = ("import sys\n"
+         "inp = open(sys.argv[1]).read().split()\n"
+         "out = open(sys.argv[2]).read().split()\n"
+         "ref = open(sys.argv[3]).read().split()\n"
+         "n = int(inp[0])\n"
+         "if out == ['impossible']:\n"
+         "    ok = ref == ['impossible']\n"
+         "    print('impossible accepted' if ok else 'said impossible but a pair exists')\n"
+         "    sys.exit(0 if ok else 1)\n"
+         "if len(out) != 2:\n"
+         "    print('expected two integers, got', out); sys.exit(1)\n"
+         "a, b = int(out[0]), int(out[1])\n"
+         "if a < 0 or b < 0 or a + b != n:\n"
+         "    print('pair does not sum to n:', a, b); sys.exit(1)\n"
+         "print('valid pair'); sys.exit(0)\n")
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "print(random.randint(0, 9))\n")
+SAMPLES = [{"input": "4\n", "output": "0 4\n"}, {"input": "7\n", "output": "0 7\n"}]
+
+GOOD_OTHER = "n = int(input())\nprint(n, 0)\n"       # different valid answer
+BAD_SUM = "n = int(input())\nprint(n, 1)\n"          # invalid answer
+CRASH = "n = int(input())\nprint(n, 0)\nraise SystemExit(3)\n"
+
+
+def _write(tmp_path, name, src):
+    p = tmp_path / name
+    p.write_text(src)
+    return str(p)
+
+
+def _agent(tmp_path, samples=SAMPLES, checker=True):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(BRUTE)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(samples))
+    if checker:
+        (root / "tests" / "check.py").write_text(CHECK)
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+def test_checker_accepts_valid_alternative_and_rejects_invalid(tmp_path):
+    check = _write(tmp_path, "check.py", CHECK)
+    ok, msg = solution_check.run_checker(check, "4\n", "1 3\n", "0 4\n")
+    assert ok, msg
+    ok, msg = solution_check.run_checker(check, "4\n", "1 2\n", "0 4\n")
+    assert not ok and "does not sum" in msg
+
+
+def test_run_plain_with_checker_accepts_other_valid_answer(tmp_path):
+    good = _write(tmp_path, "good.py", GOOD_OTHER)
+    check = _write(tmp_path, "check.py", CHECK)
+    res = solution_check.run_plain(good, ["4\n"], ["0 4\n"], timeout=10, checker_path=check)
+    assert res['passed'] == 1, res['report']
+    # Without a checker the same output would be rejected as a text mismatch only if it differs,
+    # so exact comparison is still in force for plain runs.
+    res = solution_check.run_plain(good, ["4\n"], ["0 4\n"], timeout=10)
+    assert res['passed'] == 0
+
+
+def test_run_plain_with_checker_rejects_invalid_and_shows_message(tmp_path):
+    bad = _write(tmp_path, "bad.py", BAD_SUM)
+    check = _write(tmp_path, "check.py", CHECK)
+    res = solution_check.run_plain(bad, ["4\n"], ["0 4\n"], timeout=10, checker_path=check)
+    assert res['passed'] == 0
+    assert "checker rejected the output" in res['report']
+    assert "does not sum to n" in res['report']
+
+
+def test_stress_with_checker_passes_alternative_and_fails_invalid(tmp_path):
+    check = _write(tmp_path, "check.py", CHECK)
+    gen = _write(tmp_path, "gen.py", GEN)
+    brute = _write(tmp_path, "brute.py", BRUTE)
+    good = _write(tmp_path, "good.py", GOOD_OTHER)
+    bad = _write(tmp_path, "bad.py", BAD_SUM)
+    st = solution_check.run_stress(good, brute, gen, range(10), checker_path=check)
+    assert st['first_failure'] is None and st['passed'] == 10, st['first_failure']
+    st = solution_check.run_stress(bad, brute, gen, range(10), checker_path=check)
+    assert st['first_failure_kind'] == 'wrong'
+    assert "WRONG ANSWER" in st['first_failure']
+    assert "does not sum to n" in st['first_failure']
+
+
+def test_stress_with_checker_still_catches_crash(tmp_path):
+    check = _write(tmp_path, "check.py", CHECK)
+    gen = _write(tmp_path, "gen.py", GEN)
+    brute = _write(tmp_path, "brute.py", BRUTE)
+    crash = _write(tmp_path, "crash.py", CRASH)
+    st = solution_check.run_stress(crash, brute, gen, range(3), checker_path=check)
+    assert st['first_failure_kind'] == 'crash'
+
+
+def test_validate_checker_accepts_samples_and_rejects_mutations(tmp_path):
+    agent, root = _agent(tmp_path)
+    problems = []
+    agent._validate_checker(agent._load_samples(), problems)
+    assert problems == [], problems
+
+
+def test_validate_checker_flags_checker_that_rejects_sample(tmp_path):
+    rejecting = "import sys\nsys.exit(1)\n"
+    agent, root = _agent(tmp_path)
+    (root / "tests" / "check.py").write_text(rejecting)
+    problems = []
+    agent._validate_checker(agent._load_samples(), problems)
+    assert any("must accept" in p for p in problems)
+
+
+def test_validate_checker_flags_checker_that_accepts_mutated_outputs(tmp_path):
+    accept_all = "import sys\nsys.exit(0)\n"
+    agent, root = _agent(tmp_path)
+    (root / "tests" / "check.py").write_text(accept_all)
+    problems = []
+    agent._validate_checker(agent._load_samples(), problems)
+    assert any("accepts a mutated output" in p for p in problems)
+
+
+def test_verdict_distribution_ignores_numeric_answers(tmp_path):
+    # Numeric first tokens carry no verdict; a constant numeric first token must not be rejected.
+    agent, root = _agent(tmp_path)
+    problems = []
+    agent._verdict_distribution(problems)
+    assert problems == [], problems
+
+
+def test_mutate_output_always_differs():
+    for text in ["0 4\n", "Yes\n", "No\n", "impossible\n", ""]:
+        assert agent_mutate(text) != text
+
+
+def agent_mutate(text):
+    return coding_agent.AgenticSystem._mutate_output(text)
+
+
+def test_validate_tests_passes_with_checker(tmp_path):
+    agent, root = _agent(tmp_path)
+    ok, report = agent._validate_tests()
+    assert ok, report
+
+
+def test_validate_tests_rejects_degenerate_generator(tmp_path):
+    # Generator always prints a 'No' instance; the verdict distribution check must reject it.
+    degenerate_gen = ("import sys\n"
+                      "print('No')\n")
+    degenerate_brute = "print('No')\n"
+    agent, root = _agent(tmp_path, checker=False)
+    (root / "tests" / "gen.py").write_text(degenerate_gen)
+    (root / "tests" / "brute.py").write_text(degenerate_brute)
+    (root / "tests" / "samples.json").write_text(json.dumps([{"input": "x\n", "output": "No\n"}]))
+    ok, report = agent._validate_tests()
+    assert not ok
+    assert "degenerate" in report and "'No'" in report
+    assert "Distribution over seeds" in report
+
+
+def test_verdict_distribution_accepts_balanced_generator(tmp_path):
+    balanced_brute = ("import sys\n"
+                      "n = int(sys.stdin.read())\n"
+                      "print('Yes' if n % 2 else 'No')\n")
+    gen = ("import random, sys\n"
+           "random.seed(int(sys.argv[1]))\n"
+           "print(random.randint(0, 99))\n")
+    agent, root = _agent(tmp_path, checker=False)
+    (root / "tests" / "brute.py").write_text(balanced_brute)
+    (root / "tests" / "gen.py").write_text(gen)
+    problems = []
+    agent._verdict_distribution(problems)
+    assert problems == [], problems
