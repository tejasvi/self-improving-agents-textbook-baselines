+++ b/solution.py
@@ -0,0 +1,13 @@
+import sys
+
+
+def main():
+    # Tolerant token reader: read all of stdin, consume tokens by index, never crash.
+    tokens = sys.stdin.read().split()
+    a = int(tokens[0]) if len(tokens) > 0 and tokens[0].lstrip('+-').isdigit() else 0
+    b = int(tokens[1]) if len(tokens) > 1 and tokens[1].lstrip('+-').isdigit() else 0
+    print(a + b)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_sample_gate.py b/tests/test_sample_gate.py
new file mode 100644
index 0000000..bcaad32
--- /dev/null
+++ b/tests/test_sample_gate.py
@@ -0,0 +1,221 @@
+import os
+import subprocess
+import sys
+from unittest import mock
+
+import pytest
+
+import coding_agent as ca
+from coding_agent import AgenticSystem, _parse_samples
+
+
+STATEMENT_SI = """Solve it.
+Sample Input 1
+3
+Sample Output 1
+4
+Sample Input 2
+1 2
+Sample Output 2
+3
+"""
+
+STATEMENT_IO = """Problem.
+Input:
+3
+Expected output:
+4
+"""
+
+STATEMENT_NONE = "No examples here, just a description."
+
+CORRECT = "n = int(input())\nprint(n + 1)\n"
+PLACEHOLDER = "def solve_case():\n    # placeholder: to be replaced\n    return 0\n\nprint(solve_case())\n"
+WRONG = "n = int(input())\nprint(n + 2)\n"
+COMPILE_ERR = "def broken(:\n    pass\n"
+
+
+def make_system(tmp_path, statement):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    # no base commit file: the base is treated as the empty stub
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    subprocess.run(["git", "-C", str(repo), "-c", "user.email=a@b", "-c", "user.name=t",
+                    "commit", "-q", "--allow-empty", "-m", "base"], check=True)
+    base = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True,
+                          text=True, check=True).stdout.strip()
+    log = tmp_path / "chat" / "chat_history.md"
+    log.parent.mkdir()
+    return AgenticSystem(statement, str(repo), base, chat_history_file=str(log)), repo
+
+
+def write_solution(repo, text):
+    (repo / "solution.py").write_text(text)
+
+
+# ---------- _parse_samples ----------
+
+def test_parse_sample_input_output_blocks():
+    pairs = _parse_samples(STATEMENT_SI)
+    assert pairs == [("3\n", "4\n"), ("1 2\n", "3\n")]
+
+
+def test_parse_input_expected_output_blocks():
+    assert _parse_samples(STATEMENT_IO) == [("3\n", "4\n")]
+
+
+def test_parse_crlf_and_multiline():
+    text = "Sample Input 1\r\n1 2\r\n3\r\nSample Output 1\r\n6\r\n"
+    assert _parse_samples(text) == [("1 2\n3\n", "6\n")]
+
+
+def test_parse_unparseable_returns_empty():
+    assert _parse_samples(STATEMENT_NONE) == []
+    assert _parse_samples("Sample Input 1\n3\n") == []   # no output block
+    assert _parse_samples("") == []
+    assert _parse_samples(None) == []
+
+
+# ---------- _sample_report ----------
+
+def test_sample_report_pass(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, CORRECT)
+    assert sys_._sample_report() == (1, 1, '')
+
+
+def test_sample_report_wrong_output_text(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, WRONG)
+    passed, total, text = sys_._sample_report()
+    assert (passed, total) == (0, 1)
+    assert "fails sample 1" in text and "expected: 4" in text and "actual: 5" in text
+
+
+def test_sample_report_no_samples(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_NONE)
+    write_solution(repo, WRONG)
+    assert sys_._sample_report() == (0, 0, '')
+
+
+# ---------- _solution_is_written ----------
+
+def test_written_pass_case(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, CORRECT)
+    assert sys_._solution_is_written() is True
+
+
+def test_placeholder_is_not_written(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, PLACEHOLDER)
+    assert sys_._solution_is_written() is False
+
+
+def test_wrong_output_is_not_written(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, WRONG)
+    assert sys_._solution_is_written() is False
+
+
+def test_compile_error_is_not_written(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_NONE)
+    write_solution(repo, COMPILE_ERR)
+    assert sys_._solution_is_written() is False
+
+
+def test_unparseable_samples_fall_back_to_existing_checks(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_NONE)
+    write_solution(repo, WRONG)            # wrong, but no samples to check against
+    assert sys_._solution_is_written() is True
+    write_solution(repo, PLACEHOLDER)      # placeholder marker still rejected
+    assert sys_._solution_is_written() is False
+
+
+# ---------- _ensure_written with a mocked chat_with_agent ----------
+
+def _fake_chat(repo, actions):
+    """Mock chat_with_agent: each call applies the next action (a callable on repo) and returns a history."""
+    calls = []
+
+    def fake(msg, model=None, msg_history=None, logging=None):
+        calls.append(msg)
+        idx = len(calls) - 1
+        if idx < len(actions):
+            actions[idx](repo)
+        return [{"role": "assistant", "content": [{"type": "text", "text": "ok"}]}]
+    return fake, calls
+
+
+def _write(text):
+    return lambda repo: write_solution(repo, text)
+
+
+def _noop(repo):
+    return None
+
+
+def test_ensure_written_reprompts_with_failing_sample(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, WRONG)
+    fake, calls = _fake_chat(repo, [_write(CORRECT)])
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written([{"role": "assistant", "content": "done"}], "ctx")
+    assert written is True
+    assert len(calls) == 1
+    assert "fails sample 1" in calls[0]
+    assert "No code has been written" not in calls[0]
+
+
+def test_ensure_written_rejects_placeholder_then_accepts(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, PLACEHOLDER)
+    fake, calls = _fake_chat(repo, [_noop, _write(CORRECT)])
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written([{"role": "assistant", "content": "done"}], "ctx")
+    assert written is True
+    assert len(calls) == 2
+    assert "fails sample 1" in calls[0]   # placeholder prints 0, so the failing sample is quoted
+
+
+def test_placeholder_marker_reprompt_when_samples_pass_or_absent(tmp_path):
+    # no samples parsed: the placeholder marker itself triggers the re-prompt
+    sys_, repo = make_system(tmp_path, STATEMENT_NONE)
+    write_solution(repo, PLACEHOLDER)
+    fake, calls = _fake_chat(repo, [_write(CORRECT)])
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written(None, "ctx")
+    assert written is True
+    assert "placeholder" in calls[0].lower()
+
+
+def test_ensure_written_budget_exhausted(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, WRONG)
+    fake, calls = _fake_chat(repo, [_noop] * 20)
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written(None, "ctx")
+    assert written is False
+    assert len(calls) == ca.MAX_WRITE_RETRIES
+
+
+def test_blank_reply_counts_as_failure(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_IO)
+    write_solution(repo, CORRECT)          # file is already good, but the reply was blank
+    blank_history = [{"role": "assistant", "content": [{"type": "text", "text": "   "}]}]
+    fake, calls = _fake_chat(repo, [_noop])
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written(blank_history, "ctx")
+    assert written is True
+    assert len(calls) == 1
+    assert calls[0].startswith("Your last reply was empty") or "Your last reply was empty" in calls[0]
+
+
+def test_no_samples_no_reprompt_when_written(tmp_path):
+    sys_, repo = make_system(tmp_path, STATEMENT_NONE)
+    write_solution(repo, WRONG)
+    fake, calls = _fake_chat(repo, [])
+    with mock.patch.object(ca, 'chat_with_agent', side_effect=fake):
+        written, _ = sys_._ensure_written([{"role": "assistant", "content": "x"}], "ctx")
+    assert written is True
+    assert calls == []
