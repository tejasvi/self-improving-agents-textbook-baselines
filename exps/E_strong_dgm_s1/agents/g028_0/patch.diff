+def _parse_samples(statement):
+    """Extract (input, expected_output) sample pairs from a problem statement.
+
+    Recognised forms (case-insensitive, flexible whitespace, CRLF tolerated):
+      'Sample Input k' ... 'Sample Output k'   (the k is optional)
+      'Input:' ... 'Expected output:'          (also 'Output:')
+    Returns a list of (input_text, output_text) tuples, in statement order. Returns [] when no
+    complete pair is found; never raises on malformed text."""
+    try:
+        text = (statement or '').replace('\r\n', '\n').replace('\r', '\n')
+        pairs = []
+        sample_re = re.compile(
+            r'sample\s+input\s*\d*\s*:?[ \t]*\n(?P<inp>.*?)'
+            r'sample\s+output\s*\d*\s*:?[ \t]*\n(?P<out>.*?)'
+            r'(?=sample\s+input|\Z)', re.IGNORECASE | re.DOTALL)
+        for m in sample_re.finditer(text):
+            pairs.append((m.group('inp'), m.group('out')))
+        if not pairs:
+            io_re = re.compile(
+                r'input\s*:[ \t]*\n(?P<inp>.*?)'
+                r'(?:expected\s+output|output)\s*:[ \t]*\n(?P<out>.*?)'
+                r'(?=\n\s*input\s*:|\Z)', re.IGNORECASE | re.DOTALL)
+            for m in io_re.finditer(text):
+                pairs.append((m.group('inp'), m.group('out')))
+        cleaned = []
+        for inp, out in pairs:
+            inp = inp.strip('\n')
+            out = out.strip('\n')
+            if inp.strip() and out.strip():
+                cleaned.append((inp.rstrip() + '\n', out.rstrip() + '\n'))
+        return cleaned
+    except Exception:
+        return []
+
