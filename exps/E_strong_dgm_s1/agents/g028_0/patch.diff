+import sys
+# Brute for the contract's layout: T cases, each with two ints; answer = per-case sum, one per line.
+t = sys.stdin.read().split()
+T = int(t[0]); out = []
+for i in range(T):
+    out.append(str(int(t[1+2*i]) + int(t[2+2*i])))
+print("\n".join(out))
