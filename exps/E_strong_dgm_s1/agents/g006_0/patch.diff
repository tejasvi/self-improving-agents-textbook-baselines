@@ -0,0 +1,180 @@
+import os
+import re
+import subprocess
+import sys
+import time
+
+CLIP = 4000
+DEFAULT_TIMEOUT = 10
+MAX_TIMEOUT = 60
+
+# "Sample Input 1", "Example Output 2", "**Sample Input**", etc. on their own line.
+HEADER_RE = re.compile(
+    r'^[ \t#*_`]*(?:Sample|Example)\s+(Input|Output)\s*(\d*)[ \t*_`:]*$',
+    re.IGNORECASE | re.MULTILINE)
+
+# Fallback labels: "Input:", "Output:", "**Input:**" at the start of a line.
+LABEL_RE = re.compile(
+    r'^[ \t#*_`]*(Input|Output)[ \t*_`]*:[ \t*_`]*',
+    re.IGNORECASE | re.MULTILINE)
+
+STOP_RE = re.compile(r'^\s*(?:Explanation|Note)\b', re.IGNORECASE)
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Check solution.py against the sample inputs/outputs written in the problem statement file.
+
+* Parses 'Sample Input N' / 'Sample Output N' blocks from the statement (falls back to 'Example', 'Input:' and 'Output:' patterns).
+* Runs `python3 solution.py` on each sample input and compares its stdout with the expected sample output (whitespace-normalized).
+* Returns a raw table per sample: sample id, exact match yes/no, expected output and actual output (plus exit code and stderr).
+* The final line is `SAMPLES: MATCH_ALL` when every sample matches, or `SAMPLES: MISMATCH(<ids>)` listing the failing sample ids.
+* Output is not interpreted beyond the MATCH/MISMATCH flag; read the raw tables yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout), e.g. solution.py."
+                },
+                "problem_statement_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the problem statement with the sample input/output blocks."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "problem_statement_path"]
+        }
+    }
+
+
+def _clean_block(body):
+    """Strip code fences, cut at an Explanation/Note paragraph, and trim surrounding blank lines."""
+    lines = []
+    for line in body.split("\n"):
+        if STOP_RE.match(line):
+            break
+        if line.strip().startswith("```"):
+            continue
+        lines.append(line.rstrip())
+    return "\n".join(lines).strip("\n").strip()
+
+
+def parse_samples(text):
+    """Return a list of (sample_id, input_text, output_text) parsed from the statement text."""
+    text = text or ""
+    ins, outs, order = {}, {}, []
+
+    matches = list(HEADER_RE.finditer(text))
+    if matches:
+        seq = 0
+        for i, m in enumerate(matches):
+            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
+            body = _clean_block(text[m.end():end])
+            kind = m.group(1).lower()
+            if m.group(2):
+                sid = m.group(2)
+            else:
+                seq += 1
+                sid = str(seq)
+            if kind == "input":
+                if sid not in ins:
+                    order.append(sid)
+                ins[sid] = body
+            else:
+                outs[sid] = body
+    if not any(k in outs for k in ins):
+        # Fallback: "Input:" / "Output:" label pairs in order.
+        ins, outs, order = {}, {}, []
+        matches = list(LABEL_RE.finditer(text))
+        n_in = 0
+        for i, m in enumerate(matches):
+            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
+            body = _clean_block(text[m.end():end])
+            if m.group(1).lower() == "input":
+                n_in += 1
+                sid = str(n_in)
+                order.append(sid)
+                ins[sid] = body
+            else:
+                outs[str(n_in)] = body
+
+    return [(sid, ins[sid], outs[sid]) for sid in order if sid in outs]
+
+
+def _norm(s):
+    return " ".join((s or "").split())
+
+
+def _clip(s, n=CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _run_sample(sol_path, inp, timeout):
+    t0 = time.time()
+    data = (inp + "\n").encode("utf-8")
+    try:
+        p = subprocess.run([sys.executable, os.path.abspath(sol_path)], input=data,
+                           capture_output=True, timeout=timeout,
+                           cwd=os.path.dirname(os.path.abspath(sol_path)))
+        return {
+            "timeout": False,
+            "rc": p.returncode,
+            "stdout": p.stdout.decode("utf-8", errors="replace"),
+            "stderr": p.stderr.decode("utf-8", errors="replace"),
+            "elapsed": time.time() - t0,
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode("utf-8", errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return {"timeout": True, "rc": None, "stdout": out, "stderr": err, "elapsed": time.time() - t0}
+
+
+def tool_function(solution_path, problem_statement_path, timeout=DEFAULT_TIMEOUT):
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else DEFAULT_TIMEOUT), MAX_TIMEOUT))
+    except (TypeError, ValueError):
+        timeout = DEFAULT_TIMEOUT
+
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not problem_statement_path or not os.path.isfile(problem_statement_path):
+        return f"Error: problem statement file not found: {problem_statement_path}"
+    with open(problem_statement_path, "r", encoding="utf-8", errors="replace") as f:
+        text = f.read()
+
+    samples = parse_samples(text)
+    if not samples:
+        return ("No samples found in the statement file (looked for 'Sample Input N'/'Sample Output N', "
+                "'Example' and 'Input:'/'Output:' blocks). Read the statement manually.\n"
+                "SAMPLES: MATCH_ALL")
+
+    blocks = []
+    mismatched = []
+    for sid, inp, expected in samples:
+        r = _run_sample(solution_path, inp, timeout)
+        if r["timeout"]:
+            status = f"TIMEOUT after {r['elapsed']:.2f}s"
+        else:
+            status = f"exit={r['rc']}, time={r['elapsed']:.2f}s"
+        match = (not r["timeout"]) and r["rc"] == 0 and _norm(r["stdout"]) == _norm(expected)
+        if not match:
+            mismatched.append(sid)
+        blocks.append(
+            f"=== Sample {sid}: {'MATCH' if match else 'MISMATCH'} (exact match yes/no: {'yes' if match else 'no'}) ===\n"
+            f"--- input ---\n{_clip(inp)}\n"
+            f"--- expected output ---\n{_clip(expected)}\n"
+            f"--- actual output ({status}) ---\n{_clip(r['stdout'])}\n"
+            f"--- stderr ---\n{_clip(r['stderr'], 1500)}\n"
+        )
+
+    summary = "SAMPLES: MATCH_ALL" if not mismatched else f"SAMPLES: MISMATCH({','.join(mismatched)})"
+    header = f"Parsed {len(samples)} sample(s) from {problem_statement_path}; running {solution_path}.\n"
+    return header + "\n".join(blocks) + "\n" + summary
