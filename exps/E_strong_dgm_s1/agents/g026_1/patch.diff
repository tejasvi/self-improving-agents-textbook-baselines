diff --git a/tests/test_coding_agent.py b/tests/test_coding_agent.py
index 0cce56b..27b3c37 100644
--- a/tests/test_coding_agent.py
+++ b/tests/test_coding_agent.py
@@ -32,3 +32,43 @@ def test_solution_ready_syntax_error(tmp_path):
 def test_solution_ready_valid(tmp_path):
     (tmp_path / "solution.py").write_text("print(1)\n")
     assert _make_system(tmp_path)._solution_ready() is True
+
+
+def test_stub_not_ready(tmp_path):
+    sys_obj = _make_system(tmp_path)
+    sys_obj._write_stub()
+    assert (tmp_path / "solution.py").read_text() == coding_agent.STUB_CONTENT
+    assert sys_obj._solution_ready() is False
+
+
+def test_write_stub_does_not_overwrite(tmp_path):
+    (tmp_path / "solution.py").write_text("print(2)\n")
+    _make_system(tmp_path)._write_stub()
+    assert (tmp_path / "solution.py").read_text() == "print(2)\n"
+
+
+def test_real_code_ready_after_stub(tmp_path):
+    sys_obj = _make_system(tmp_path)
+    sys_obj._write_stub()
+    (tmp_path / "solution.py").write_text("import sys\nprint(sum(map(int, sys.stdin.read().split())))\n")
+    assert sys_obj._solution_ready() is True
+
+
+def test_made_tool_call_empty_text_turns(tmp_path):
+    history = [
+        {"role": "user", "content": [{"type": "text", "text": "task"}]},
+        {"role": "assistant", "content": [{"type": "text", "text": "(no output)"}]},
+        {"role": "user", "content": [{"type": "text", "text": "cut off"}]},
+        {"role": "assistant", "content": [{"type": "text", "text": ""}]},
+    ]
+    assert _make_system(tmp_path)._made_tool_call(history) is False
+    assert _make_system(tmp_path)._made_tool_call([]) is False
+
+
+def test_made_tool_call_with_tool_use(tmp_path):
+    history = [
+        {"role": "user", "content": [{"type": "text", "text": "task"}]},
+        {"role": "assistant", "content": [
+            {"type": "tool_use", "id": "t1", "name": "editor", "input": {}}]},
+    ]
+    assert _make_system(tmp_path)._made_tool_call(history) is True
