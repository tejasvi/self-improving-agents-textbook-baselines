+def run_checked(solution_path, gen_path, checker_path, seeds, modes=('medium', 'max'), timeout=10,
+                budget=_STRESS_BUDGET, strict=True):
+    """
+    Run the solution on generated inputs for each (mode, seed) WITHOUT a brute force; every output is judged
+    by the checker (`python _checker.py input output`). Crashes/timeouts also count as failures.
+    Returns dict: total, ran, passed, crashed, max_time, budget_hit, first_failure (raw text or None).
+    """
+    seeds = list(seeds)
+    modes = [None] if not modes else list(modes)
+    cases = [(m, s) for m in modes for s in seeds]
+    result = {'total': len(cases), 'ran': 0, 'passed': 0, 'crashed': 0, 'max_time': 0.0,
+              'budget_hit': False, 'first_failure': None}
+    if not cases:
+        return result
+    tmpdir = _tmp_with({'_sol.py': solution_path, '_gen.py': gen_path, '_checker.py': checker_path})
+    try:
+        sol_cmd = _portable_runner(tmpdir) if strict else [sys.executable, '-I', '_sol.py']
+        t_start = time.monotonic()
+        for mode, seed in cases:
+            if time.monotonic() - t_start > budget:
+                result['budget_hit'] = True
+                break
+            result['ran'] += 1
+            label = f"seed {seed} mode {mode}"
+            gst, gout, gerr, grc, _ = _run([sys.executable, '-I', '_gen.py', *_gen_args(seed, mode)], tmpdir, '', timeout)
+            if gst != 'ok' or grc != 0:
+                detail = f"generator failed on {label}\n" + _fmt_run("gen", gst, gout, gerr, grc, 0.0)
+                kind = 'gen'
+                el = 0.0
+            else:
+                sst, sout, serr, src_rc, el = _run(sol_cmd, tmpdir, gout, timeout)
+                result['max_time'] = max(result['max_time'], el)
+                if _solution_crashed(sst, src_rc, serr):
+                    why = 'timeout' if sst == 'timeout' else (f'exit code {src_rc}' if src_rc != 0 else 'stderr not empty')
+                    kind = 'crash'
+                    detail = (f"solution FAILED on {label}: {why}\ninput:\n{_clip(gout).rstrip()}\n"
+                              + _fmt_run("solution", sst, sout, serr, src_rc, el))
+                else:
+                    ok, msg = _check_output(tmpdir, gout, sout, timeout)
+                    kind = 'ok' if ok else 'wrong'
+                    detail = ('' if ok else
+                              f"CHECKER REJECTED on {label}\ninput:\n{_clip(gout).rstrip()}\n"
+                              + _fmt_run("solution", sst, sout, serr, src_rc, el) + "\n" + msg)
+            if kind == 'ok':
+                result['passed'] += 1
+                continue
+            if kind == 'crash':
+                result['crashed'] += 1
+            if result['first_failure'] is None:
+                result['first_failure'] = detail
+        return result
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
