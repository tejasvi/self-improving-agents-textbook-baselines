+    def _has_real_edit(self):
+        """
+        Return True only if the repo diff versus base_commit touches at least one
+        non-helper file (not tests, brute.py, gen.py, sample files) and, for
+        stdin-style tasks (solution.py exists in base commit), solution.py is no
+        longer just the placeholder.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        if not diff or not diff.strip():
+            safe_log("[edit-check] empty diff")
+            return False
+
+        changed = []
+        for line in diff.splitlines():
+            if line.startswith("diff --git "):
+                parts = line.split()
+                # format: diff --git a/<path> b/<path>
+                if len(parts) >= 4:
+                    b_path = parts[3]
+                    if b_path.startswith("b/"):
+                        b_path = b_path[2:]
+                    changed.append(b_path)
+
+        def is_helper(path):
+            norm = path.replace("\\", "/")
+            base = os.path.basename(norm)
+            if base.startswith("test_") or base.endswith("_test.py"):
+                return True
+            if "tests/" in norm or norm.startswith("tests/"):
+                return True
+            if base in ("brute.py", "gen.py"):
+                return True
+            if base.startswith("sample") and base.endswith(".txt"):
+                return True
+            return False
+
+        real_files = [f for f in changed if not is_helper(f)]
+        if not real_files:
+            safe_log(f"[edit-check] only helper/test files changed: {changed}")
+            return False
+
+        # Stdin-style task: solution.py is part of the base commit, so it must be
+        # written beyond the placeholder.
+        base_has_solution = subprocess.run(
+            ["git", "-C", self.git_tempdir, "cat-file", "-e", f"{self.base_commit}:solution.py"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).returncode == 0
+        if base_has_solution:
+            sol_path = os.path.join(self.git_tempdir, "solution.py")
+            if not os.path.isfile(sol_path):
+                safe_log("[edit-check] solution.py missing")
+                return False
+            with open(sol_path, encoding="utf-8", errors="replace") as f:
+                content = f.read()
+            code_lines = [
+                l for l in content.splitlines()
+                if l.strip() and not l.strip().startswith("#")
+            ]
+            if "Write your solution here" in content and not code_lines:
+                safe_log("[edit-check] solution.py still placeholder")
+                return False
+
+        safe_log(f"[edit-check] real edit found in: {real_files}")
+        return True
+
