@@ -0,0 +1,134 @@
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+
+# Problem for these tests: print a + b for "a b" input. Generator: small random pairs, medium/adversarial larger.
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode in ('medium', 'adversarial', 'max'):\n"
+       "    print(random.randint(10**6, 10**9), random.randint(10**6, 10**9))\n"
+       "else:\n"
+       "    print(random.randint(0, 9), random.randint(0, 9))\n")
+BRUTE = "a, b = map(int, input().split())\nprint(a + b)\n"
+ORACLE_OK = "a, b = map(int, input().split())\nprint(a + b)\n"
+ORACLE_WRONG_MEDIUM = ("a, b = map(int, input().split())\n"
+                       "print(a + b if a < 10**6 else a + b + 1)\n")  # agrees with brute on small inputs only
+CHECKER = ("import sys\n"
+           "inp = open(sys.argv[1]).read().split()\n"
+           "out = open(sys.argv[2]).read().split()\n"
+           "exp = str(sum(map(int, inp)))\n"
+           "if out != [exp]:\n"
+           "    print('expected', exp, 'got', out)\n"
+           "    sys.exit(1)\n")
+SAMPLES = [{"input": "1 2\n", "output": "3\n"}]
+
+
+def _agent(tmp_path, oracle=ORACLE_OK, mode="unique"):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(BRUTE)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(SAMPLES))
+    (root / "tests" / "checker.py").write_text(CHECKER)
+    (root / "tests" / "oracle.py").write_text(oracle)
+    (root / "tests" / "mode.txt").write_text(mode + "\n")
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+def _write(root, name, src):
+    p = root / "cands" / name
+    p.write_text(src)
+    return str(p)
+
+
+def test_oracle_disagreeing_with_brute_is_rejected(tmp_path):
+    agent, root = _agent(tmp_path, oracle="a, b = map(int, input().split())\nprint(a * b)\n")
+    problems = agent._validate_oracle(agent._load_samples())
+    assert any("disagrees with tests/brute.py" in p for p in problems)
+
+
+def test_agreeing_oracle_has_no_oracle_problems(tmp_path):
+    agent, root = _agent(tmp_path)
+    assert agent._validate_oracle(agent._load_samples()) == []
+
+
+def test_mutants_are_rejected_by_oracle_scoring(tmp_path):
+    agent, root = _agent(tmp_path)
+    problems = agent._mutant_check(agent._answer_kind())
+    assert problems == []  # the correct oracle + checker reject all three mutants
+
+
+def test_mutant_accepted_by_weak_oracle_is_reported(tmp_path):
+    # A checker that accepts any output (no comparison) plus an oracle is the 'weak checker' case:
+    # for a multi-answer design the checker judges, so a permissive checker must trigger the mutant report.
+    agent, root = _agent(tmp_path)
+    (root / "tests" / "checker.py").write_text("import sys\nsys.exit(0)\n")
+    (root / "tests" / "mode.txt").write_text("multi\n")
+    problems = agent._mutant_check(agent._answer_kind())
+    assert any("accepts a trivial wrong program" in p for p in problems)
+
+
+def test_unverified_is_not_counted_as_verified(tmp_path):
+    # Checker that always reports the inconclusive marker: every case must be unverified, none verified.
+    root = tmp_path / "r"
+    (root / "tests").mkdir(parents=True)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "checker.py").write_text(
+        "import sys\nprint('too large to verify (OK_UNVERIFIED)')\nsys.exit(1)\n")
+    sol = root / "sol.py"
+    sol.write_text(ORACLE_OK)
+    res = solution_check.run_vs_oracle(str(sol), str(sol), str(root / "tests" / "gen.py"),
+                                       range(3), modes=['medium'], timeout=10, strict=True,
+                                       checker_path=str(root / "tests" / "checker.py"))
+    assert res['verified'] == 0
+    assert res['unverified'] == 3
+    assert res['total'] == 0
+
+
+def test_perfect_requires_verified_medium_minimum(tmp_path, monkeypatch):
+    agent, root = _agent(tmp_path)
+    good = _write(root, "good.py", ORACLE_OK)
+    real = solution_check.run_vs_oracle
+
+    def few(*a, **kw):
+        res = real(*a, **kw)
+        res['verified'] = res['passed'] = 5          # below MIN_VERIFIED_MEDIUM
+        return res
+    monkeypatch.setattr(solution_check, "run_vs_oracle", few)
+    score, rep = agent._score_candidate(good)
+    assert score[3] == 5
+    assert rep.splitlines()[-1] == "RESULT: FAILED"
+
+
+def test_perfect_requires_no_slow_adversarial(tmp_path, monkeypatch):
+    agent, root = _agent(tmp_path)
+    good = _write(root, "good.py", ORACLE_OK)
+    real = solution_check.run_vs_oracle
+
+    def slow(*a, **kw):
+        res = real(*a, **kw)
+        res['slow'] = 1
+        return res
+    monkeypatch.setattr(solution_check, "run_vs_oracle", slow)
+    score, rep = agent._score_candidate(good)
+    assert rep.splitlines()[-1] == "RESULT: FAILED"
+
+
+def test_wrong_on_medium_candidate_is_not_perfect(tmp_path):
+    agent, root = _agent(tmp_path)
+    wrong = _write(root, "cap.py", ORACLE_WRONG_MEDIUM)
+    score, rep = agent._score_candidate(wrong)
+    assert score[0] == 1           # samples and small stress still pass
+    assert score[4] == 1
+    assert rep.splitlines()[-1] == "RESULT: FAILED"
+    assert "medium/adversarial input FAILED" in rep
