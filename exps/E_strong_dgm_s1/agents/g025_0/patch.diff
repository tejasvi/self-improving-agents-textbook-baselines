+def _one_oracle_case(tmpdir, seed, mode, timeout, sol_cmd, checker_path):
+    """
+    One medium/adversarial case for run_vs_oracle. Returns (kind, detail, elapsed), kind in
+    ok | gen | brute | crash | wrong | inconclusive.
+      - checker_path given (multi-answer): the checker alone judges the solution's output.
+      - no checker (unique answer): the solution's output must equal the oracle's output (normalised).
+    The oracle is the tmpdir's _brute.py and must succeed; if it does not, kind='brute' (harness fault).
+    """
+    label = f"seed {seed} mode {mode}"
+    gst, gen_out, gerr, grc, _ = _run([sys.executable, '-I', '_gen.py', *_gen_args(seed, mode)], tmpdir, '', timeout)
+    if gst != 'ok' or grc != 0:
+        return 'gen', f"generator failed on {label}\n" + _fmt_run("gen", gst, gen_out, gerr, grc, 0.0), 0.0
+    test_in = gen_out
+    bst, bout, berr, brc, bel = _run([sys.executable, '-I', '_brute.py'], tmpdir, test_in, timeout)
+    if bst != 'ok' or brc != 0 or berr.strip():
+        return 'brute', (f"oracle failed on {label}\ninput:\n{_clip(test_in).rstrip()}\n"
+                         + _fmt_run("oracle", bst, bout, berr, brc, bel)), bel
+    sst, sout, serr, src_rc, el = _run(sol_cmd, tmpdir, test_in, timeout)
+    if _solution_crashed(sst, src_rc, serr):
+        why = 'timeout' if sst == 'timeout' else (f'exit code {src_rc}' if src_rc != 0 else 'stderr not empty')
+        return 'crash', (f"solution FAILED on {label}: {why}\ninput:\n{_clip(test_in).rstrip()}\n"
+                         + _fmt_run("solution", sst, sout, serr, src_rc, el)), el
+    if checker_path:
+        verdict, msg = _check_verdict(tmpdir, test_in, sout, timeout)
+        if verdict == 'inconclusive':
+            return 'inconclusive', msg, el
+        if verdict == 'wrong':
+            return 'wrong', (f"WRONG ANSWER on {label} (checker rejected the solution's output)\n"
+                             f"input:\n{_clip(test_in).rstrip()}\n"
+                             + _fmt_run("solution", sst, sout, serr, src_rc, el) + "\n" + msg), el
+        return 'ok', '', el
+    if _normalise(sout) != _normalise(bout):
+        return 'wrong', (f"WRONG ANSWER on {label} (differs from the oracle)\ninput:\n{_clip(test_in).rstrip()}\n"
+                         + _fmt_run("solution", sst, sout, serr, src_rc, el)
+                         + "\n" + _fmt_run("oracle (expected)", bst, bout, berr, brc, bel)), el
+    return 'ok', '', el
+
+
+def run_vs_oracle(solution_path, oracle_path, gen_path, seeds, modes=None, timeout=10, budget=_STRESS_BUDGET,
+                  strict=True, checker_path=None, slow_limit=None):
+    """
+    Like run_stress, but the reference is an exact polynomial-time oracle (tests/oracle.py) that is run on
+    medium / adversarial inputs. Judging:
+      - checker_path given (multi-answer problem): the checker judges the solution's output.
+      - otherwise (unique answer): the solution's output must equal the oracle's output (whitespace-normalised).
+    Counts:
+      verified   cases judged ok by the reference (the only ones that count as verified)
+      unverified checker inconclusive (not a pass, not a failure; excluded from total)
+      crashed    solution crash / timeout / nonzero exit / stderr
+      wrong      solution output differs from the oracle (or is rejected by the checker)
+      slow       verified cases whose solution run took longer than slow_limit (performance failure)
+      oracle_failed  the oracle itself crashed or timed out (harness fault, reported as a failure)
+    Returns dict: total, ran, verified, passed (== verified), unverified, crashed, slow, oracle_failed,
+                  max_time, budget_hit, first_failure, first_slow.
+    """
+    seeds = list(seeds)
+    modes = [None] if not modes else list(modes)
+    cases = [(m, s) for m in modes for s in seeds]
+    result = {'total': len(cases), 'ran': 0, 'verified': 0, 'passed': 0, 'unverified': 0, 'crashed': 0,
+              'wrong': 0, 'slow': 0, 'oracle_failed': 0, 'max_time': 0.0, 'budget_hit': False,
+              'first_failure': None, 'first_slow': None}
+    if not cases:
+        return result
+    files = {'_sol.py': solution_path, '_brute.py': oracle_path, '_gen.py': gen_path}
+    if checker_path:
+        files['_checker.py'] = checker_path
+    tmpdir = _tmp_with(files)
+    try:
+        sol_cmd = _portable_runner(tmpdir) if strict else None
+        t_start = time.monotonic()
+        for mode, seed in cases:
+            if time.monotonic() - t_start > budget:
+                result['budget_hit'] = True
+                break
+            result['ran'] += 1
+            kind, detail, el = _one_oracle_case(tmpdir, seed, mode, timeout, sol_cmd, checker_path)
+            result['max_time'] = max(result['max_time'], el)
+            if kind == 'ok':
+                result['verified'] += 1
+                result['passed'] += 1
+                if slow_limit is not None and el > slow_limit:
+                    result['slow'] += 1
+                    if result['first_slow'] is None:
+                        result['first_slow'] = (f"SLOW on mode {mode} seed {seed}: {el:.3f}s "
+                                                f"(limit {slow_limit:.3f}s)\n" + detail)
+                continue
+            if kind == 'inconclusive':
+                result['unverified'] += 1
+                continue
+            if kind == 'brute':
+                result['oracle_failed'] += 1
+                detail = ("ORACLE FAILED (tests/oracle.py crashed or timed out; fix the oracle, not the solution)\n"
+                          + detail)
+            if kind in ('crash', 'gen'):
+                result['crashed'] += 1
+            if kind == 'wrong':
+                result['wrong'] += 1
+            if result['first_failure'] is None:
+                result['first_failure'] = detail
+        result['total'] -= result['unverified']
+        return result
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
