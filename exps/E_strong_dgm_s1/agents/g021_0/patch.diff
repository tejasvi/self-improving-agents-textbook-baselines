+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from tools import perf_probe  # noqa: E402
+
+FAST_CLASS = """from typing import *
+class Solution:
+    def makeStringGood(self, s: str) -> int:
+        return len(s) - max(s.count(c) for c in set(s))
+"""
+
+QUADRATIC_CLASS = """from typing import *
+class Solution:
+    def makeStringGood(self, s: str) -> int:
+        c = 0
+        for i in range(len(s)):
+            for j in range(len(s)):
+                if s[i] != s[j]:
+                    c += 1
+        return c
+"""
+
+SUM_STDIN = """import sys
+print(sum(int(x) for x in sys.stdin.read().split()))
+"""
+
+HANG_STDIN = """import time
+time.sleep(30)
+"""
+
+
+def _write(tmp_path, name, text):
+    p = tmp_path / name
+    p.write_text(text)
+    return str(p)
+
+
+def test_tool_info_schema_is_flat_and_valid():
+    info = perf_probe.tool_info()
+    assert info["name"] == "perf_probe"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert set(schema["required"]) <= set(schema["properties"])
+    for key, prop in schema["properties"].items():
+        assert "type" in prop and "description" in prop, key
+        assert prop["type"] in ("string", "integer", "number", "array"), key
+        assert set(prop) <= {"type", "description", "items"}, key
+    assert "items" in schema["properties"]["input_files"]
+
+
+def test_class_mode_fast_case_is_not_flagged(tmp_path):
+    sol = _write(tmp_path, "sol.py", FAST_CLASS)
+    out = perf_probe.tool_function(sol, "class", class_method="makeStringGood",
+                                   call_snippet="Solution().makeStringGood('a'*N)", n=20000,
+                                   timeout=5, budget=2.0)
+    assert "No TIMEOUT/SLOW flags" in out
+    assert "stdout(head): '0'" in out
+
+
+def test_class_mode_quadratic_case_times_out(tmp_path):
+    sol = _write(tmp_path, "sol.py", QUADRATIC_CLASS)
+    out = perf_probe.tool_function(sol, "class", class_method="makeStringGood",
+                                   call_snippet="Solution().makeStringGood('a'*N)", n=20000,
+                                   timeout=1, budget=0.5)
+    assert "TIMEOUT" in out
+    assert "FLAGGED" in out
+
+
+def test_class_mode_slow_flag_against_budget(tmp_path):
+    sol = _write(tmp_path, "sol.py", FAST_CLASS)
+    out = perf_probe.tool_function(sol, "class", class_method="makeStringGood",
+                                   call_snippet="Solution().makeStringGood('ab'*N)", n=2000000,
+                                   timeout=10, budget=0.000001)
+    assert "SLOW" in out
+
+
+def test_class_mode_requires_snippet_and_n(tmp_path):
+    sol = _write(tmp_path, "sol.py", FAST_CLASS)
+    assert "Error" in perf_probe.tool_function(sol, "class", call_snippet="", n=5)
+    assert "Error" in perf_probe.tool_function(sol, "class", call_snippet="1", n=None)
+
+
+def test_stdin_mode_fast_case(tmp_path):
+    sol = _write(tmp_path, "sol.py", SUM_STDIN)
+    inp = _write(tmp_path, "in.txt", "1 2 3\n")
+    out = perf_probe.tool_function(sol, "stdin", input_files=[inp], timeout=5, budget=2.0)
+    assert "stdout(head): '6'" in out
+    assert "No TIMEOUT/SLOW flags" in out
+
+
+def test_stdin_mode_timeout_case(tmp_path):
+    sol = _write(tmp_path, "sol.py", HANG_STDIN)
+    inp = _write(tmp_path, "in.txt", "1\n")
+    out = perf_probe.tool_function(sol, "stdin", input_files=[inp], timeout=1)
+    assert "TIMEOUT" in out
+    assert "FLAGGED" in out
+
+
+def test_stdin_mode_missing_files_and_bad_mode(tmp_path):
+    sol = _write(tmp_path, "sol.py", SUM_STDIN)
+    assert "not found" in perf_probe.tool_function(sol, "stdin", input_files=[str(tmp_path / "nope.txt")])
+    assert "needs at least one" in perf_probe.tool_function(sol, "stdin", input_files=[])
+    assert "mode must be" in perf_probe.tool_function(sol, "bogus", input_files=[])
