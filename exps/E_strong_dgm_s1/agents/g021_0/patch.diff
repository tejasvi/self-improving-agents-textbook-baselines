--- /dev/null
+++ b/tools/perf_probe.py
@@ -0,0 +1,240 @@
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_TIMEOUT = 60
+MAX_REPEAT = 10
+MAX_INPUT_FILES = 50
+DEFAULT_BUDGET = 1.0  # seconds; runtimes above this are flagged SLOW
+CLIP = 1500
+
+_CLASS_DRIVER = '''from typing import *
+import sys
+import time
+sys.setrecursionlimit(10000)
+sys.path.insert(0, {sol_dir!r})
+import importlib.util as _ilu
+_spec = _ilu.spec_from_file_location("solution_under_test", {sol_path!r})
+_mod = _ilu.module_from_spec(_spec)
+_spec.loader.exec_module(_mod)
+Solution = _mod.Solution
+N = {n}
+_expr = {snippet!r}
+for _ in range({repeat}):
+    _t0 = time.time()
+    _res = eval(_expr, globals())
+    _el = time.time() - _t0
+    print("RESULT " + repr(_res)[:200] + " ELAPSED " + repr(_el), flush=True)
+'''
+
+
+def tool_info():
+    return {
+        "name": "perf_probe",
+        "description": """Run a solution against adversarial inputs in a subprocess with a hard timeout and report raw per-case runtimes.
+
+Two modes:
+* mode="stdin": feeds each file in input_files to the solution (python3 solution.py < file). Use this for programs that read standard input.
+* mode="class": for a `Solution` class method. The tool writes a driver that does `from typing import *`, imports `Solution` from solution_path, sets the constant N to the given integer, and evaluates call_snippet (a Python expression, e.g. `Solution().makeStringGood('a'*N)`), timing it. Use n (the max-size value) inside the snippet via N. Pass class_method for the method name, which is only used as a label in the report.
+
+Each case is reported with its raw runtime. A case is flagged TIMEOUT if it exceeds `timeout` seconds (hard kill), and SLOW if its runtime is above `budget` seconds. Errors are reported raw (exit code and stderr tail).
+Errors are NOT parsed; read the raw output and interpret it yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file, e.g. solution.py."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "Either 'stdin' (run input_files through stdin) or 'class' (call a Solution method via call_snippet)."
+                },
+                "class_method": {
+                    "type": "string",
+                    "description": "Class mode only: name of the Solution method being probed (used as a label in the report)."
+                },
+                "call_snippet": {
+                    "type": "string",
+                    "description": "Class mode only: Python expression that builds and calls the method, using the constant N for the size, e.g. Solution().makeStringGood('a'*N)."
+                },
+                "n": {
+                    "type": "integer",
+                    "description": "Class mode only: the size value bound to N in the snippet (use the maximum constraint)."
+                },
+                "input_files": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Stdin mode only: paths to input files, one case per file."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard time limit per case in seconds (default 2)."
+                },
+                "budget": {
+                    "type": "number",
+                    "description": "Runtime budget in seconds; runs above it are flagged SLOW (default 1.0)."
+                },
+                "repeat": {
+                    "type": "integer",
+                    "description": "Class mode only: number of timed repetitions of the snippet per case (default 1, max 10)."
+                }
+            },
+            "required": ["solution_path", "mode"]
+        }
+    }
+
+
+def _clip(s, n=CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _as_int(value, default, lo, hi):
+    try:
+        v = int(value)
+    except (TypeError, ValueError):
+        return default
+    return max(lo, min(v, hi))
+
+
+def _as_float(value, default):
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return default
+    return v if v > 0 else default
+
+
+def _flags(elapsed, timed_out, budget):
+    flags = []
+    if timed_out:
+        flags.append("TIMEOUT")
+    elif elapsed is not None and elapsed > budget:
+        flags.append("SLOW")
+    return flags
+
+
+def _run(cmd, stdin_bytes, timeout, cwd):
+    """Run cmd with a hard timeout. Returns (rc, stdout, stderr, elapsed, timed_out)."""
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=stdin_bytes, capture_output=True, timeout=timeout, cwd=cwd)
+        return (p.returncode, p.stdout.decode("utf-8", errors="replace"),
+                p.stderr.decode("utf-8", errors="replace"), time.time() - t0, False)
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode("utf-8", errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return ("TIMEOUT", out, err, float(timeout), True)
+
+
+def _format_case(label, rc, out, err, elapsed, timed_out, budget):
+    flags = _flags(elapsed, timed_out, budget)
+    head = f"case={label} | runtime={elapsed:.3f}s | exit={rc}"
+    if flags:
+        head += " | " + ",".join(flags)
+    lines = [head]
+    if out.strip():
+        lines.append(f"  stdout(head): {_clip(out.strip(), 300)!r}")
+    if err.strip():
+        lines.append(f"  stderr(tail): {_clip(err.strip()[-600:], 600)!r}")
+    return "\n".join(lines), flags
+
+
+def tool_function(solution_path, mode, class_method=None, call_snippet=None, n=None,
+                  input_files=None, timeout=2, budget=DEFAULT_BUDGET, repeat=1):
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    solution_path = os.path.abspath(solution_path)
+    timeout = _as_int(timeout, 2, 1, MAX_TIMEOUT)
+    budget = _as_float(budget, DEFAULT_BUDGET)
+    mode = (mode or "").strip().lower()
+
+    if mode == "stdin":
+        files = list(input_files or [])
+        if not files:
+            return "Error: mode 'stdin' needs at least one entry in input_files."
+        if len(files) > MAX_INPUT_FILES:
+            return f"Error: too many input files ({len(files)} > {MAX_INPUT_FILES})."
+        for p in files:
+            if not os.path.isfile(p):
+                return f"Error: input file not found: {p}"
+        cases = []
+        for p in files:
+            with open(p, "rb") as f:
+                data = f.read()
+            cases.append((os.path.basename(p), data))
+        tmpdir = tempfile.mkdtemp(prefix="perf_probe_")
+        try:
+            body = []
+            flagged = []
+            for label, data in cases:
+                rc, out, err, el, to = _run([sys.executable, solution_path], data, timeout, tmpdir)
+                text, flags = _format_case(label, rc, out, err, el, to, budget)
+                body.append(text)
+                if flags or (rc != 0):
+                    flagged.append(f"{label}({'/'.join(flags) or 'exit ' + str(rc)})")
+        finally:
+            shutil.rmtree(tmpdir, ignore_errors=True)
+        return _summary("stdin", body, flagged, budget, timeout)
+
+    if mode == "class":
+        if not call_snippet or not str(call_snippet).strip():
+            return "Error: mode 'class' needs call_snippet, e.g. Solution().makeStringGood('a'*N)."
+        size = _as_int(n, 0, 0, 10 ** 9)
+        if size <= 0:
+            return "Error: mode 'class' needs a positive integer n (the size bound to N)."
+        repeat = _as_int(repeat, 1, 1, MAX_REPEAT)
+        label = class_method or "Solution"
+        driver_src = _CLASS_DRIVER.format(
+            sol_dir=os.path.dirname(solution_path), sol_path=solution_path,
+            n=size, snippet=str(call_snippet), repeat=repeat)
+        tmpdir = tempfile.mkdtemp(prefix="perf_probe_")
+        try:
+            driver = os.path.join(tmpdir, "driver.py")
+            with open(driver, "w", encoding="utf-8") as f:
+                f.write(driver_src)
+            rc, out, err, el, to = _run([sys.executable, "-I", driver], b"", timeout, tmpdir)
+        finally:
+            shutil.rmtree(tmpdir, ignore_errors=True)
+        results = [ln for ln in out.splitlines() if ln.startswith("RESULT ")]
+        body = []
+        flagged = []
+        if to:
+            text, flags = _format_case(f"{label}(N={size})", "TIMEOUT", out, err, el, True, budget)
+            body.append(text)
+            flagged.append(f"{label}(N={size}: TIMEOUT)")
+        else:
+            for i, ln in enumerate(results):
+                parts = ln.split(" ELAPSED ")
+                try:
+                    case_el = float(parts[1])
+                except (IndexError, ValueError):
+                    case_el = el
+                text, flags = _format_case(f"{label}(N={size}) rep{i + 1}", rc, parts[0][len("RESULT "):],
+                                           err, case_el, False, budget)
+                body.append(text)
+                if flags:
+                    flagged.append(f"{label}(N={size} rep{i + 1}: {'/'.join(flags)})")
+            if rc != 0 or not results:
+                text, _ = _format_case(f"{label}(N={size})", rc, out, err, el, False, budget)
+                body.append(text)
+                flagged.append(f"{label}(N={size}: exit {rc})")
+        return _summary("class", body, flagged, budget, timeout)
+
+    return "Error: mode must be 'stdin' or 'class'."
+
+
+def _summary(mode, body, flagged, budget, timeout):
+    lines = [f"perf_probe mode={mode} budget={budget:.2f}s timeout={timeout}s"]
+    lines.extend(body)
+    if flagged:
+        lines.append("FLAGGED: " + "; ".join(flagged))
+    else:
+        lines.append("No TIMEOUT/SLOW flags: all cases within budget.")
+    return "\n".join(lines)
