+"""Maximum subarray sum (toy problem matching brute.py / gen.py).
+
+Input:  first line n, second line n integers.
+Output: maximum sum of a non-empty contiguous subarray.
+
+Also keeps the helper functions _is_interactive(statement) and _has_code(text)
+importable (they do not print anything when imported).
+"""
+
+INTERACTIVE_KEYWORDS = ("interactive", "judge", "flush")
+
+
+def _is_interactive(problem_statement):
+    if not problem_statement:
+        return False
+    text = str(problem_statement).lower()
+    return any(kw in text for kw in INTERACTIVE_KEYWORDS)
+
+
+def _has_code(text):
+    """Return True if the given file contents contain non-empty code."""
+    if text is None:
+        return False
+    return bool(str(text).strip())
+
+
+def max_subarray(a):
+    best = cur = a[0]
+    for x in a[1:]:
+        cur = max(x, cur + x)
+        if cur > best:
+            best = cur
+    return best
+
+
+def main():
+    import sys
+
+    data = sys.stdin.read().split()
+    n = int(data[0])
+    a = [int(x) for x in data[1:1 + n]]
+    print(max_subarray(a))
+
+
+if __name__ == "__main__":
+    main()
