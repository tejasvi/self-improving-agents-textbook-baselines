+# PLACEHOLDER brute-force reference (toy problem: maximum subarray sum).
+# Input:  first line n, second line n integers.
+# Output: the maximum sum of a non-empty contiguous subarray.
+# Exhaustive: checks every (i, j) pair.
+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    n = int(data[0])
+    a = [int(x) for x in data[1:1 + n]]
+    best = None
+    for i in range(n):
+        s = 0
+        for j in range(i, n):
+            s += a[j]
+            if best is None or s > best:
+                best = s
+    print(best)
+
+
+if __name__ == "__main__":
+    main()
