+import os
+import sys
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from tools import canonical_match as cm  # noqa: E402
+
+GEN = """import sys,random
+r=random.Random(int(sys.argv[1]))
+n=r.randint(1,6)
+print(n)
+print(*[r.randint(1,3) for _ in range(n)])
+"""
+
+BRUTE_MIN = """import sys
+d=sys.stdin.read().split(); n=int(d[0]); a=list(map(int,d[1:1+n]))
+for i in range(n):
+    for j in range(i+1,n):
+        if a[i]==a[j]:
+            print(i+1,j+1); sys.exit()
+print(-1)
+"""
+
+BRUTE_MAX = """import sys
+d=sys.stdin.read().split(); n=int(d[0]); a=list(map(int,d[1:1+n]))
+best=None
+for i in range(n):
+    for j in range(i+1,n):
+        if a[i]==a[j]: best=(i+1,j+1)
+print(*best) if best else print(-1)
+"""
+
+# valid but non-canonical: scans j descending
+SOL_LAST = """import sys
+d=sys.stdin.read().split(); n=int(d[0]); a=list(map(int,d[1:1+n]))
+for j in range(n-1,0,-1):
+    for i in range(j-1,-1,-1):
+        if a[i]==a[j]:
+            print(i+1,j+1); sys.exit()
+print(-1)
+"""
+
+
+@pytest.fixture
+def files(tmp_path):
+    paths = {}
+    for name, text in [("gen.py", GEN), ("brute_min.py", BRUTE_MIN), ("brute_max.py", BRUTE_MAX),
+                       ("sol_last.py", SOL_LAST)]:
+        p = tmp_path / name
+        p.write_text(text)
+        paths[name] = str(p)
+    return paths
+
+
+def test_identical_solution_matches_every_seed(files):
+    out = cm.tool_function(files["brute_min.py"], files["brute_min.py"], files["gen.py"], num_tests=50)
+    assert out.splitlines()[0] == "CANONICAL_MATCH: 50/50"
+    assert "No mismatches" in out
+
+
+def test_mismatch_count_and_first_mismatch_report(files):
+    out = cm.tool_function(files["sol_last.py"], files["brute_min.py"], files["gen.py"], num_tests=100)
+    first = out.splitlines()[0]
+    assert first.startswith("CANONICAL_MATCH: ")
+    k, n = map(int, first.split(": ")[1].split("/"))
+    assert n == 100 and 0 <= k < 100
+    assert f"MISMATCH_COUNT: {100 - k} of 100" in out
+    # first mismatch block shows the input and both outputs
+    assert "First mismatch at seed" in out
+    assert "--- input ---" in out
+    assert "--- solution output" in out and "--- brute (canonical) output" in out
+
+
+def test_mismatch_seed_is_actually_first_divergence(files):
+    out = cm.tool_function(files["sol_last.py"], files["brute_min.py"], files["gen.py"], num_tests=100)
+    seed = int(out.split("First mismatch at seed ")[1].split(" ")[0])
+    # independently check: seeds before it all agree
+    import subprocess
+    for s in range(0, seed):
+        data = subprocess.run([sys.executable, files["gen.py"], str(s)], capture_output=True, text=True).stdout
+        a = subprocess.run([sys.executable, files["sol_last.py"]], input=data, capture_output=True, text=True).stdout
+        b = subprocess.run([sys.executable, files["brute_min.py"]], input=data, capture_output=True, text=True).stdout
+        assert a.split() == b.split()
+
+
+def test_alt_brute_rates_reported(files):
+    # solution == lex-largest brute, so its ALT_MATCH for that brute must be full,
+    # while the canonical (lex-smallest) rate must be below full.
+    out = cm.tool_function(files["brute_max.py"], files["brute_min.py"], files["gen.py"], num_tests=60,
+                           alt_brute_paths=[files["brute_max.py"]])
+    line = [l for l in out.splitlines() if l.startswith("ALT_MATCH ")]
+    assert len(line) == 1 and line[0].endswith("/60")
+    assert line[0].rsplit(": ", 1)[1] == "60/60"
+    first = int(out.splitlines()[0].split(": ")[1].split("/")[0])
+    assert first < 60
+
+
+def test_missing_file_is_reported(files):
+    out = cm.tool_function("/nonexistent.py", files["brute_min.py"], files["gen.py"])
+    assert out.startswith("Error: solution file not found")
+
+
+def test_brute_failure_is_not_counted_as_match(tmp_path, files):
+    bad = tmp_path / "bad.py"
+    bad.write_text("import sys\nsys.exit(3)\n")
+    out = cm.tool_function(files["brute_min.py"], str(bad), files["gen.py"], num_tests=5)
+    assert out.startswith("CANONICAL_MATCH: INCOMPLETE")
+
+
+def test_forward_parser_reads_canonical_field():
+    from coding_agent import AgenticSystem as A
+    assert A._canonical_match("CANONICAL_MATCH: 1000/1000") == "MATCH"
+    assert A._canonical_match("CANONICAL_MATCH: 999/1000") == "MISMATCH"
+    assert A._canonical_match("CANONICAL_MATCH: n/a (unique answer)") is None
+    assert A._canonical_match("no field here") is None
+
+
+def test_tool_is_loaded_by_registry():
+    from tools import load_all_tools
+    names = [t["name"] for t in load_all_tools(logging=print)]
+    assert "canonical_match" in names
