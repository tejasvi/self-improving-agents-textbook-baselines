index 0000000..e5b9635
--- /dev/null
+++ b/tools/canonical_match.py
@@ -0,0 +1,195 @@
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_TESTS = 100000
+MAX_TIMEOUT = 60
+CLIP = 2000
+
+
+def tool_info():
+    return {
+        "name": "canonical_match",
+        "description": """Measure EXACT agreement (whitespace-normalized) between a solution and a canonical brute force over many seeds, for problems where the statement says "print any valid answer".
+
+* For each seed i in [seed_start, seed_start + num_tests): runs `generator_path i` to get one input, then runs `solution_path` and `brute_path` on it and compares their whitespace-normalized stdout exactly.
+* The brute force must print the canonical answer: the lexicographically smallest valid answer, or the first one found in natural nested-loop order.
+* Reports `CANONICAL_MATCH: k/n` (k = seeds where the outputs were identical, n = seeds run), the first mismatching seed with its input and both outputs, and the total mismatch count. Does NOT stop at the first mismatch.
+* Optional `alt_brute_paths`: other brute forces (for example a lex-largest brute). For each one the match rate is reported as `ALT_MATCH <path>: k/n`, so you can see which canonical order the solution follows.
+* A checker-only pass is NOT sufficient: the hidden grader likely compares against a reference output, so this exact comparison is required.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout), e.g. solution.py."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the canonical brute-force reference (reads stdin, writes stdout). It must print the lexicographically smallest / first-found valid answer."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the input generator. It is run as `generator <seed>` and must print one test input to stdout. Use small value ranges and many duplicates."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to run (use at least 1000 for multi-answer problems; default 1000)."
+                },
+                "seed_start": {
+                    "type": "integer",
+                    "description": "First seed value (default 0)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for the generator, solution and brute force (default 10)."
+                },
+                "alt_brute_paths": {
+                    "type": "array",
+                    "description": "Optional alternative brute-force programs (e.g. a lex-largest or a different nested-loop order). Each gets its own ALT_MATCH rate.",
+                    "items": {
+                        "type": "string",
+                        "description": "Path to one alternative brute-force program."
+                    }
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _cmd(path):
+    if path.endswith(".py"):
+        return [sys.executable, path]
+    return [os.path.abspath(path)]
+
+
+def _clip(s, n=CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _run(cmd, data, timeout):
+    """Run a command with stdin=data. Returns a dict with raw results."""
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, timeout=timeout)
+        return {
+            "timeout": False,
+            "rc": p.returncode,
+            "stdout": p.stdout.decode("utf-8", errors="replace"),
+            "stderr": p.stderr.decode("utf-8", errors="replace"),
+            "elapsed": time.time() - t0,
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode("utf-8", errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return {"timeout": True, "rc": None, "stdout": out, "stderr": err, "elapsed": time.time() - t0}
+
+
+def _norm(s):
+    return " ".join((s or "").split())
+
+
+def _same_output(a, b):
+    """Exact whitespace-normalized equality of two raw outputs."""
+    return _norm(a) == _norm(b)
+
+
+def _describe(name, r):
+    if r["timeout"]:
+        status = f"TIMEOUT after {r['elapsed']:.2f}s"
+    else:
+        status = f"exit={r['rc']}, time={r['elapsed']:.2f}s"
+    return (
+        f"--- {name} output ({status}) ---\n{_clip(r['stdout'])}\n"
+        f"--- {name} stderr ---\n{_clip(r['stderr'])}\n"
+    )
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=1000, seed_start=0,
+                  timeout=10, alt_brute_paths=None):
+    for label, p in [("solution", solution_path), ("brute", brute_path), ("generator", generator_path)]:
+        if not p or not os.path.isfile(p):
+            return f"Error: {label} file not found: {p}"
+    alt_brute_paths = list(alt_brute_paths or [])
+    for p in alt_brute_paths:
+        if not os.path.isfile(p):
+            return f"Error: alt brute file not found: {p}"
+    try:
+        num_tests = int(num_tests)
+        seed_start = int(seed_start)
+        timeout = int(timeout)
+    except (TypeError, ValueError):
+        return "Error: num_tests, seed_start and timeout must be integers."
+    if num_tests <= 0:
+        return "Error: num_tests must be positive."
+    num_tests = min(num_tests, MAX_TESTS)
+    timeout = max(1, min(timeout, MAX_TIMEOUT))
+
+    sol_cmd = _cmd(solution_path)
+    brute_cmd = _cmd(brute_path)
+    gen_cmd = _cmd(generator_path)
+    alt_cmds = [(p, _cmd(p)) for p in alt_brute_paths]
+    alt_ok = [0] * len(alt_cmds)
+
+    k_ok = 0
+    n_run = 0
+    mismatches = 0
+    first_mismatch = None  # text block
+    brute_error = None
+    for k in range(num_tests):
+        seed = seed_start + k
+        g = _run(gen_cmd + [str(seed)], b"", timeout)
+        if g["timeout"] or g["rc"] != 0:
+            status = f"TIMEOUT after {timeout}s" if g["timeout"] else f"exit={g['rc']}"
+            brute_error = (f"GENERATOR FAILED at seed {seed} ({status}) after {n_run} seeds.\n"
+                           f"--- generator stderr ---\n{_clip(g['stderr'])}")
+            break
+        data = g["stdout"].encode("utf-8")
+        n_run += 1
+
+        brute = _run(brute_cmd, data, timeout)
+        if brute["timeout"] or brute["rc"] != 0:
+            brute_error = (f"BRUTE FORCE FAILED at seed {seed} after {n_run - 1} seeds.\n"
+                           f"--- input ---\n{_clip(g['stdout'])}\n" + _describe("brute", brute))
+            break
+
+        sol = _run(sol_cmd, data, timeout)
+        sol_ok = (not sol["timeout"]) and sol["rc"] == 0
+        same = sol_ok and _same_output(sol["stdout"], brute["stdout"])
+        if same:
+            k_ok += 1
+        else:
+            mismatches += 1
+            if first_mismatch is None:
+                first_mismatch = (
+                    f"First mismatch at seed {seed} (run {n_run} of {num_tests}).\n"
+                    f"--- input ---\n{_clip(g['stdout'])}\n"
+                    + _describe("solution", sol)
+                    + _describe("brute (canonical)", brute)
+                )
+
+        for idx, (p, cmd) in enumerate(alt_cmds):
+            alt = _run(cmd, data, timeout)
+            if (not alt["timeout"]) and alt["rc"] == 0 and sol_ok and _same_output(sol["stdout"], alt["stdout"]):
+                alt_ok[idx] += 1
+
+    lines = []
+    if brute_error is not None:
+        lines.append("CANONICAL_MATCH: INCOMPLETE (brute or generator failed; fix the reference first)")
+        lines.append(brute_error)
+    else:
+        lines.append(f"CANONICAL_MATCH: {k_ok}/{n_run}")
+    lines.append(f"MISMATCH_COUNT: {mismatches} of {n_run} seeds (seeds {seed_start}..{seed_start + num_tests - 1})")
+    for idx, (p, _) in enumerate(alt_cmds):
+        lines.append(f"ALT_MATCH {p}: {alt_ok[idx]}/{n_run}")
+    if first_mismatch is not None:
+        lines.append(first_mismatch)
+    elif brute_error is None:
+        lines.append("No mismatches: solution agrees with the canonical brute force on every seed.")
+    return "\n".join(lines)
