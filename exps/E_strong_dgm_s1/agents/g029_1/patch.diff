+
+def _json_equal(a, b):
+    """Structural equality of two JSON values; floats compared with a small tolerance."""
+    if isinstance(a, float) or isinstance(b, float):
+        if isinstance(a, (int, float)) and isinstance(b, (int, float)) and not isinstance(a, bool) and not isinstance(b, bool):
+            return abs(a - b) <= 1e-6 * max(1.0, abs(a), abs(b))
+        return False
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(_json_equal(x, y) for x, y in zip(a, b))
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(_json_equal(a[k], b[k]) for k in a)
+    return a == b
+
+
+def _parse_args_list(args_list):
+    """Decode JSON-encoded positional-argument lists. Returns (calls, error)."""
+    calls = []
+    for i, item in enumerate(args_list):
+        try:
+            val = json.loads(item)
+        except (TypeError, ValueError) as e:
+            return None, f"args_list[{i}] is not valid JSON: {e}"
+        if not isinstance(val, list):
+            return None, f"args_list[{i}] must be a JSON list of positional arguments"
+        calls.append(val)
+    return calls, None
+
+
+def _run_calls(modname, method, calls, tmpdir, timeout):
+    """Run the runner for `calls`. Returns (status, results, times, problem, stderr, rc, elapsed, stdout)."""
+    st, out, err, rc, el = _run([sys.executable, '-I', '_runner.py', modname, method],
+                                tmpdir, json.dumps(calls), timeout)
+    if st != 'ok':
