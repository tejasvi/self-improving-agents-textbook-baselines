+                        + _fmt_run("solution", sst, sout, serr, src_rc, el))
+            break
+        max_t = max(max_t, stimes[0])
+        if stimes[0] > time_limit:
+            mismatch = (f"TLE on seed {seed}: {stimes[0]:.3f}s > time_limit {time_limit}s\nargs:\n{_clip(test_in).rstrip()}\n"
+                        + f"solution result: {_clip(json.dumps(sres[0]), 800)}")
+            break
+        if not _json_equal(sres[0], bres[0]):
