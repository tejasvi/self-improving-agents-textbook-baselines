+                        f"solution result: {_clip(json.dumps(sres[0]), 800)}\n"
+                        f"brute result (expected): {_clip(json.dumps(bres[0]), 800)}")
+            break
+    report = []
+    if mismatch:
+        report.append(mismatch)
+        report.append(f"RESULT: FAILED (stress: {ran}/{num_tests} seeds ran before failure)")
+    else:
+        report.append(f"stress: {ran}/{num_tests} passed, max time {max_t:.3f} s (time_limit {time_limit}s)")
+        if budget_note:
+            report.append(budget_note)
+        if not warnings:
+            report.append("RESULT: OK")
+    return "\n".join(report)
+
+
+def _class_tool(solution_path, method, args_list, expected_outputs, brute_method_path, gen_args_path,
+                num_tests, time_limit, timeout):
+    with open(solution_path, 'r', errors='replace') as f:
