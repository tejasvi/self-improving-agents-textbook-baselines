+mod = importlib.import_module(modname)
+target = mod.Solution() if hasattr(mod, 'Solution') else mod
+fn = getattr(target, method)
+real_out = sys.stdout
+results, times = [], []
+for args in calls:
+    sys.stdout = io.StringIO()
+    try:
+        t0 = time.perf_counter()
+        res = fn(*args)
+        el = time.perf_counter() - t0
+    finally:
+        sys.stdout = real_out
+    results.append(res)
+    times.append(el)
+real_out.write('\\n' + json.dumps({'results': results, 'times': times}, default=repr) + '\\n')
