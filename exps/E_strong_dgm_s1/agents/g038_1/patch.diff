+def _read(path):
+    try:
+        with open(path, 'r', errors='replace') as f:
+            return f.read()
+    except OSError:
+        return ''
+
+
+def _has_code(text):
+    """True if text has at least one non-comment, non-blank line."""
+    return any(l.strip() and not l.strip().startswith('#') for l in text.splitlines())
+
+
+def _sample_pairs(tests_dir):
+    """Return sorted (sample_X.txt, expected_X.txt) pairs that both exist in tests_dir."""
+    pairs = []
+    try:
+        names = os.listdir(tests_dir)
+    except OSError:
+        return pairs
+    for name in sorted(names):
+        if name.startswith('sample_') and name.endswith('.txt'):
+            suffix = name[len('sample_'):]
+            expected = 'expected_' + suffix
+            if expected in names:
+                pairs.append((name, expected))
+    return pairs
 
