+_INCONCLUSIVE_MARKERS = ('too large to verify', 'cannot verify', 'no reference', 'ok_unverified')
+
+
+def classify_checker(rc, text):
+    """
+    Classify a checker run. Returns 'ok', 'wrong' or 'inconclusive'.
+    'inconclusive' = harness limitation (checker cannot verify this input, or crashed with a traceback),
+    not a solution fault. Genuine rejections (nonzero exit with a normal message) stay 'wrong'.
+    """
+    low = (text or '').lower()
+    if rc == 0:
+        return 'ok'
+    if any(m in low for m in _INCONCLUSIVE_MARKERS):
+        return 'inconclusive'
+    if 'traceback (most recent call last)' in low:
+        return 'inconclusive'
+    return 'wrong'
+
+
