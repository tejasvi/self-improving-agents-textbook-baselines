@@ -0,0 +1,124 @@
+import json
+import os
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+from tests.test_scoring_selection import _agent, BRUTE, GEN, CHECKER, SAMPLES
+
+CORRECT = "a, b = map(int, input().split())\nprint(a + b)\n"
+WRONG = "a, b = map(int, input().split())\nprint(a - b)\n"
+
+
+def _ag(tmp_path):
+    agent, root = _agent(tmp_path)
+    agent.code_model = "test-model"
+    return agent, root
+
+
+def _git(repo, *args):
+    subprocess.run(["git", "-C", str(repo), *args], check=True,
+                   stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def test_checkpoint_copies_only_on_improvement(tmp_path):
+    agent, root = _agent(tmp_path)
+    cand = root / "cands" / "cand_1.py"
+    cand.write_text(WRONG)
+    assert agent._checkpoint(str(cand), (1, 0, 0, 0)) is True
+    assert (root / "solution.py").read_text() == WRONG
+    cand.write_text(CORRECT)
+    assert agent._checkpoint(str(cand), (1, 0, 0, 0)) is False  # equal: not copied
+    assert (root / "solution.py").read_text() == WRONG
+    assert agent._checkpoint(str(cand), (0, 0, 0, 0)) is False  # worse: not copied
+    assert (root / "solution.py").read_text() == WRONG
+    assert agent._checkpoint(str(cand), (2, 0, 0, 0)) is True  # better: copied
+    assert (root / "solution.py").read_text() == CORRECT
+
+
+def test_has_primary_edit_true_after_first_scored_candidate(tmp_path):
+    agent, root = _agent(tmp_path)
+    subprocess.run(["git", "-C", str(root), "init", "-q"], check=True)
+    _git(root, "config", "user.email", "t@example.com")
+    _git(root, "config", "user.name", "t")
+    (root / "solution.py").write_text("# placeholder\n")
+    _git(root, "add", "-A")
+    _git(root, "commit", "-qm", "base")
+    commit = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"],
+                            stdout=subprocess.PIPE, check=True).stdout.decode().strip()
+    agent.base_commit = commit
+    assert agent._has_primary_edit() is False
+    cand = root / "cands" / "cand_1.py"
+    cand.write_text(WRONG)  # imperfect candidate, scored below
+    score, _ = agent._score_candidate(str(cand))
+    agent._checkpoint(str(cand), score)
+    assert agent._has_primary_edit() is True
+
+
+def test_continuation_stops_on_unchanged_file(tmp_path, monkeypatch):
+    agent, root = _ag(tmp_path)
+    out = root / "cands" / "cand_1.py"
+    out.write_text(WRONG)
+    calls = []
+    monkeypatch.setattr(coding_agent, "chat_with_agent", lambda *a, **k: calls.append(1))
+    # score never changes and the file is never edited -> the loop must stop after the first identical round
+    monkeypatch.setattr(agent, "_score_candidate", lambda p: ((0, 0, 0, 0), "same report"))
+    agent._run_to_completion("task", str(out), max_rounds=5)
+    assert len(calls) == 2  # initial session + one continuation; then stall detected
+
+
+def test_continuation_stops_on_identical_report(tmp_path, monkeypatch):
+    agent, root = _ag(tmp_path)
+    out = root / "cands" / "cand_1.py"
+    out.write_text(WRONG)
+    calls = []
+
+    def fake_chat(prompt, **k):
+        calls.append(1)
+        out.write_text(WRONG + f"# edit {len(calls)}\n")  # file changes every round
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    monkeypatch.setattr(agent, "_score_candidate", lambda p: ((0, 0, 0, 0), "identical report"))
+    agent._run_to_completion("task", str(out), max_rounds=5)
+    assert len(calls) == 2
+
+
+def test_continuation_stops_when_score_does_not_improve(tmp_path, monkeypatch):
+    agent, root = _ag(tmp_path)
+    out = root / "cands" / "cand_1.py"
+    out.write_text(WRONG)
+    calls = []
+
+    def fake_chat(prompt, **k):
+        calls.append(1)
+        out.write_text(WRONG + f"# edit {len(calls)}\n")
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    scores = iter([((1, 0, 0, 0), "r1"), ((1, 0, 0, 0), "r2"), ((2, 0, 0, 0), "r3")])
+    monkeypatch.setattr(agent, "_score_candidate", lambda p: next(scores))
+    agent._run_to_completion("task", str(out), max_rounds=5)
+    assert len(calls) == 2  # round 1 did not improve on the initial score -> stop
+
+
+def test_too_large_to_verify_is_inconclusive_and_does_not_lower_score(tmp_path):
+    checker = tmp_path / "checker.py"
+    checker.write_text("import sys\nprint('case 1: N=438 too large to verify')\nsys.exit(1)\n")
+    verdict, msg = solution_check.check_verdict_pair(str(checker), "438\n", "1\n")
+    assert verdict == 'inconclusive'
+    assert "unverified" in msg
+    assert solution_check.classify_checker(1, "cannot verify this") == 'inconclusive'
+    assert solution_check.classify_checker(1, "expected 3 got 4") == 'wrong'
+
+    root = tmp_path / "r"
+    root.mkdir()
+    (root / "good.py").write_text(CORRECT)
+    (root / "brute.py").write_text(BRUTE)
+    (root / "gen.py").write_text(GEN)
+    (root / "checker.py").write_text(checker.read_text())
+    res = solution_check.run_stress(str(root / "good.py"), str(root / "brute.py"), str(root / "gen.py"),
+                                    range(3), modes=['small'], timeout=10, checker_path=str(root / "checker.py"))
+    assert res['passed'] == 0 and res['unverified'] == 3 and res['first_failure'] is None
+    assert res['total'] == 0  # all unverified: excluded from the planned total, so no failure either
