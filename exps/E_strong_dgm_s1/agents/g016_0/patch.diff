+import os
+from tools import perf_audit, stress_test
+
+HERE = os.path.dirname(__file__)
+
+
+def _write(tmp_path, name, code):
+    p = tmp_path / name
+    p.write_text(code)
+    return str(p)
+
+
+def test_quadratic_on_constant_is_timeout(tmp_path):
+    quad = _write(tmp_path, "quad.py",
+                  "import sys\ns=sys.stdin.read().split()[0]\n"
+                  "c=0\nfor i in range(len(s)):\n    for j in range(len(s)):\n        c += s[i]==s[j]\nprint(c)\n")
+    out = perf_audit.tool_function(quad, {"type": "string", "n": 3000}, timeout=2, shapes=["constant"])
+    assert "TIMEOUT" in out
+
+
+def test_class_solution_is_audited_without_wrapper(tmp_path):
+    cls = _write(tmp_path, "cls.py",
+                 "from collections import Counter\nclass Solution:\n"
+                 "    def solve(self, s: str) -> int:\n        return max(Counter(s).values())\n")
+    out = perf_audit.tool_function(cls, {"type": "string", "n": 2000}, timeout=5, entry="solve",
+                                   shapes=["constant", "dominant_rare"])
+    assert "class Solution.solve" in out and "TIMEOUTS: 0/2" in out
+
+
+def test_stress_test_wraps_class_solution(tmp_path):
+    cls = _write(tmp_path, "cls.py",
+                 "class Solution:\n    def solve(self, s: str) -> int:\n        return len(s)\n")
+    brute = _write(tmp_path, "brute.py",
+                   "class Solution:\n    def solve(self, s: str) -> int:\n        return sum(1 for _ in s)\n")
+    gen = _write(tmp_path, "gen.py",
+                 "import sys\nprint('s = \"' + 'ab' * int(sys.argv[1]) + '\"')\n")
+    out = stress_test.tool_function(cls, brute_path=brute, generator_path=gen, num_tests=5, entry="solve")
+    assert "PASS" in out
