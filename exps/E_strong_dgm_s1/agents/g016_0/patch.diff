+class Solution:
+    def solve(self, s: str) -> int:
+        # fast on random strings, quadratic on constant strings
+        best = 0
+        n = len(s)
+        for i in range(n):
+            cnt = {}
+            for j in range(i, n):
+                cnt[s[j]] = cnt.get(s[j], 0) + 1
+                if cnt[s[j]] > best:
+                    best = cnt[s[j]]
+        return best
