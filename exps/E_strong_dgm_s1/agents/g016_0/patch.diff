index 0000000..29352d0
--- /dev/null
+++ b/tools/perf_audit.py
@@ -0,0 +1,374 @@
+import os
+import random
+import shutil
+import string
+import subprocess
+import sys
+import tempfile
+import time
+
+from utils.solution_wrap import is_class_style, wrap_class_solution
+
+MAX_N = 2000000
+MAX_TIMEOUT = 60
+MAX_SHAPES_TIMEOUT_TOTAL = 900
+CLIP = 600
+
+STRING_SHAPES = ["constant", "two_values", "dominant_rare", "sorted_asc", "sorted_desc",
+                 "alternating", "power_law", "all_distinct", "periodic"]
+INT_SHAPES = ["constant", "two_values", "dominant_rare", "sorted_asc", "sorted_desc",
+              "alternating", "power_law", "all_distinct", "periodic", "near_max"]
+GRAPH_SHAPES = ["path", "star", "dense", "random_tree"]
+
+
+def tool_info():
+    return {
+        "name": "perf_audit",
+        "description": """Worst-case performance audit: run a solution on structured adversarial max-size inputs and report raw runtimes.
+
+* Built-in shape generators (chosen from `size_params.type`):
+  - "string": constant, two_values, dominant_rare (one letter with huge count plus a few rare letters), sorted_asc, sorted_desc, alternating, power_law (geometric letter frequencies), all_distinct (as many distinct letters as possible), periodic.
+  - "int_array": the same shapes on integers in [1, max] (plus near_max: values close to max).
+  - "graph": path, star, dense (random edges, up to 200000 edges), random_tree. Graph input is n followed by the edge list.
+* `mode="class"` (or auto-detected for `class Solution` files without stdin handling): the method `entry` (default: first public method) is called in a subprocess with one literal per argument line, so no wrapper is needed. Arguments are generated as: string -> one literal, int_array -> one list literal, graph -> n then the edge list.
+* `mode="stdin"`: the file is run as a stdin program. The input format is: an int -> one line; a string -> one line; an int array -> a line with its length and a line with the elements; an edge list -> a line with the edge count and one line per edge.
+* `generator_path`: if given, it is run as `generator <shape>` for every shape name in `shapes` and its output is used as the input (use this when the input format is special).
+* Every run has a hard `timeout` in seconds (TIMEOUT is reported if exceeded). Returns a raw table: shape, n, seconds, status (OK / TIMEOUT / EXIT <code>), and a stderr tail, followed by the slowest shape. No interpretation of errors.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (stdin program or class Solution file)."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "One of 'auto' (default: class mode if the file is a class Solution without stdin handling, else stdin), 'stdin', or 'class'."
+                },
+                "size_params": {
+                    "type": "object",
+                    "description": "Input template and maximum constraints. Keys: 'type' ('string', 'int_array' or 'graph'), 'n' (maximum size, e.g. 200000), 'alphabet' (string only, default 26), 'max' (int_array only, maximum value, e.g. 1000000000), 'm' (graph only, max edges, default 200000).",
+                    "properties": {
+                        "type": {
+                            "type": "string",
+                            "description": "Input kind: 'string', 'int_array' or 'graph'."
+                        },
+                        "n": {
+                            "type": "integer",
+                            "description": "Maximum size n (number of characters, array elements or graph nodes)."
+                        },
+                        "alphabet": {
+                            "type": "integer",
+                            "description": "Alphabet size for string inputs (default 26)."
+                        },
+                        "max": {
+                            "type": "integer",
+                            "description": "Maximum element value for int_array inputs."
+                        },
+                        "m": {
+                            "type": "integer",
+                            "description": "Maximum number of edges for graph inputs (default 200000)."
+                        }
+                    },
+                    "required": ["type", "n"]
+                },
+                "entry": {
+                    "type": "string",
+                    "description": "Method name of class Solution to call (class mode). Default: the first public method."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Optional generator run as `generator <shape>`; its stdout is the input for that shape."
+                },
+                "shapes": {
+                    "type": "array",
+                    "description": "Optional list of shape names to run. Default: all built-in shapes for the input type.",
+                    "items": {
+                        "type": "string",
+                        "description": "A shape name, e.g. dominant_rare."
+                    }
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard time limit per run in seconds (default 5)."
+                }
+            },
+            "required": ["solution_path", "size_params"]
+        }
+    }
+
+
+# ----------------------------------------------------------------------
+# Input generation. Each generator returns a list of (kind, value) args where
+# kind is 'int', 'str' or 'list' (list of ints) or 'edges' (list of pairs).
+# ----------------------------------------------------------------------
+
+def _letters(alphabet):
+    return string.ascii_lowercase[:alphabet]
+
+
+def _string_arg(shape, n, alphabet, rng):
+    L = _letters(alphabet)
+    if shape == "constant":
+        s = L[0] * n
+    elif shape == "two_values":
+        s = "".join(rng.choice(L[:2]) for _ in range(n))
+    elif shape == "dominant_rare":
+        k = max(1, n // 100)
+        chars = [L[0]] * n
+        for _ in range(k):
+            chars[rng.randrange(n)] = rng.choice(L)
+        s = "".join(chars)
+    elif shape == "sorted_asc":
+        s = "".join(sorted(rng.choice(L) for _ in range(n)))
+    elif shape == "sorted_desc":
+        s = "".join(sorted((rng.choice(L) for _ in range(n)), reverse=True))
+    elif shape == "alternating":
+        s = "".join(L[i % 2] for i in range(n))
+    elif shape == "power_law":
+        weights = [1.0 / (i + 1) ** 2 for i in range(len(L))]
+        s = "".join(rng.choices(L, weights=weights, k=n))
+    elif shape == "all_distinct":
+        s = "".join(L[i % len(L)] for i in range(n))
+    elif shape == "periodic":
+        s = "".join(L[i % min(3, len(L))] for i in range(n))
+    else:
+        return None
+    return [("str", s)]
+
+
+def _int_arg(shape, n, maxv, rng):
+    if shape == "constant":
+        a = [1] * n
+    elif shape == "two_values":
+        a = [rng.choice((1, maxv)) for _ in range(n)]
+    elif shape == "dominant_rare":
+        a = [1] * n
+        for _ in range(max(1, n // 100)):
+            a[rng.randrange(n)] = rng.randint(1, maxv)
+    elif shape == "sorted_asc":
+        a = sorted(rng.randint(1, maxv) for _ in range(n))
+    elif shape == "sorted_desc":
+        a = sorted((rng.randint(1, maxv) for _ in range(n)), reverse=True)
+    elif shape == "alternating":
+        a = [1 if i % 2 == 0 else maxv for i in range(n)]
+    elif shape == "power_law":
+        vals = [max(1, maxv // (i + 1) ** 2) for i in range(64)]
+        a = [rng.choice(vals[:1 + int(rng.random() ** 3 * 64)]) for _ in range(n)]
+    elif shape == "all_distinct":
+        if n <= maxv:
+            a = rng.sample(range(1, maxv + 1), n)
+        else:
+            a = [(i % maxv) + 1 for i in range(n)]
+    elif shape == "periodic":
+        pat = [1, 2, 3]
+        a = [pat[i % 3] % maxv + 1 for i in range(n)]
+    elif shape == "near_max":
+        a = [maxv - rng.randrange(min(1000, maxv)) for _ in range(n)]
+    else:
+        return None
+    return [("list", a)]
+
+
+def _graph_args(shape, n, m_cap, rng):
+    n = max(2, n)
+    if shape == "path":
+        edges = [[i, i + 1] for i in range(n - 1)]
+    elif shape == "star":
+        edges = [[0, i] for i in range(1, n)]
+    elif shape == "random_tree":
+        edges = [[rng.randrange(i), i] for i in range(1, n)]
+    elif shape == "dense":
+        target = min(m_cap, n * (n - 1) // 2)
+        seen = set()
+        edges = []
+        for _ in range(20 * target + 100):  # bounded attempts; may yield fewer edges
+            if len(edges) >= target:
+                break
+            u, v = rng.randrange(n), rng.randrange(n)
+            if u == v:
+                continue
+            key = (min(u, v), max(u, v))
+            if key in seen:
+                continue
+            seen.add(key)
+            edges.append([u, v])
+    else:
+        return None
+    return [("int", n), ("edges", edges)]
+
+
+def _make_args(size_params, shape, rng):
+    typ = str(size_params.get("type", "")).strip()
+    n = int(size_params.get("n", 1000))
+    n = max(1, min(n, MAX_N))
+    if typ == "string":
+        alphabet = int(size_params.get("alphabet", 26) or 26)
+        alphabet = max(1, min(alphabet, 26))
+        return _string_arg(shape, n, alphabet, rng)
+    if typ == "int_array":
+        maxv = int(float(size_params.get("max", 10 ** 9)))
+        maxv = max(1, maxv)
+        return _int_arg(shape, n, maxv, rng)
+    if typ == "graph":
+        m_cap = int(size_params.get("m", 200000) or 200000)
+        n = min(n, 200000)
+        return _graph_args(shape, n, m_cap, rng)
+    raise ValueError(f"unknown size_params.type {typ!r}; use 'string', 'int_array' or 'graph'")
+
+
+def _effective_n(size_params):
+    """The n actually used by _make_args (default 1000, clamped to MAX_N)."""
+    try:
+        return max(1, min(int(size_params.get("n", 1000)), MAX_N))
+    except (TypeError, ValueError):
+        return 1000
+
+
+def _shape_list(size_params, shapes):
+    typ = str(size_params.get("type", "")).strip()
+    if shapes:
+        return [str(s) for s in shapes]
+    if typ == "string":
+        return STRING_SHAPES
+    if typ == "int_array":
+        return INT_SHAPES
+    if typ == "graph":
+        return GRAPH_SHAPES
+    return []
+
+
+def _render_class(args):
+    """One Python literal per argument line (read by the class driver)."""
+    return "\n".join(repr(val) for _, val in args) + "\n"
+
+
+def _render_stdin(args):
+    """Classic competitive-programming layout (see tool description)."""
+    lines = []
+    for kind, val in args:
+        if kind == "int" or kind == "str":
+            lines.append(str(val))
+        elif kind == "list":
+            lines.append(str(len(val)))
+            lines.append(" ".join(str(x) for x in val))
+        elif kind == "edges":
+            lines.append(str(len(val)))
+            lines.extend(f"{u} {v}" for u, v in val)
+    return "\n".join(lines) + "\n"
+
+
+def _clip(s, n=CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[-n:]
+
+
+def _tail(s, n=300):
+    s = (s or "").strip()
+    return s if len(s) <= n else "..." + s[-n:]
+
+
+def _run_one(cmd, data, timeout, cwd):
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, timeout=timeout, cwd=cwd)
+        elapsed = time.time() - t0
+        err = p.stderr.decode("utf-8", errors="replace")
+        status = "OK" if p.returncode == 0 else f"EXIT {p.returncode}"
+        return status, elapsed, err
+    except subprocess.TimeoutExpired as e:
+        err = e.stderr.decode("utf-8", errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return "TIMEOUT", time.time() - t0, err
+
+
+def tool_function(solution_path, mode="auto", size_params=None, generator_path=None,
+                  timeout=5, entry=None, shapes=None):
+    if isinstance(mode, dict):  # called as tool_function(path, size_params) positionally
+        mode, size_params = (size_params if isinstance(size_params, str) else "auto"), mode
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not isinstance(size_params, dict):
+        return "Error: `size_params` must be an object with at least `type` and `n`."
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else 5), MAX_TIMEOUT))
+    except (TypeError, ValueError):
+        timeout = 5
+    mode = (mode or "auto").strip().lower()
+    if mode not in ("auto", "stdin", "class"):
+        return f"Error: mode must be 'auto', 'stdin' or 'class' (got {mode!r})."
+    if generator_path and not os.path.isfile(generator_path):
+        return f"Error: generator file not found: {generator_path}"
+
+    with open(solution_path, "r", encoding="utf-8", errors="replace") as f:
+        code = f.read()
+    class_mode = mode == "class" or (mode == "auto" and is_class_style(code))
+    tmpdir = tempfile.mkdtemp(prefix="perf_audit_")
+    try:
+        run_path = os.path.join(tmpdir, "solution_run.py")
+        if class_mode:
+            try:
+                wrapped, method = wrap_class_solution(code, entry)
+            except ValueError as e:
+                return f"Error: {e}"
+            render = _render_class
+            label_mode = f"class Solution.{method}"
+        else:
+            wrapped = code
+            render = _render_stdin
+            label_mode = "stdin program"
+        with open(run_path, "w", encoding="utf-8") as f:
+            f.write(wrapped)
+
+        rows = []
+        if generator_path:
+            shape_names = _shape_list(size_params, shapes) or ["constant"]
+            for shape in shape_names:
+                gen_cmd = [sys.executable, generator_path, str(shape)] if generator_path.endswith(".py") \
+                    else [os.path.abspath(generator_path), str(shape)]
+                try:
+                    gp = subprocess.run(gen_cmd, capture_output=True, timeout=timeout, cwd=tmpdir)
+                except subprocess.TimeoutExpired:
+                    rows.append((shape, "-", float(timeout), "GEN TIMEOUT", ""))
+                    continue
+                if gp.returncode != 0:
+                    rows.append((shape, "-", 0.0, f"GEN EXIT {gp.returncode}",
+                                 _tail(gp.stderr.decode("utf-8", errors="replace"))))
+                    continue
+                data = gp.stdout
+                status, elapsed, err = _run_one([sys.executable, run_path], data, timeout, tmpdir)
+                rows.append((shape, f"{len(data)} bytes", elapsed, status, _tail(err)))
+        else:
+            if not isinstance(size_params.get("type"), str):
+                return "Error: size_params.type is required ('string', 'int_array' or 'graph')."
+            shape_names = _shape_list(size_params, shapes)
+            if not shape_names:
+                return f"Error: unknown size_params.type {size_params.get('type')!r}."
+            for shape in shape_names:
+                rng = random.Random(shape)
+                try:
+                    args = _make_args(size_params, shape, rng)
+                except ValueError as e:
+                    return f"Error: {e}"
+                if args is None:
+                    rows.append((shape, "-", 0.0, "SKIPPED (shape not defined for this type)", ""))
+                    continue
+                n_val = _effective_n(size_params)
+                data = render(args).encode("utf-8")
+                status, elapsed, err = _run_one([sys.executable, run_path], data, timeout, tmpdir)
+                rows.append((shape, str(n_val), elapsed, status, _tail(err)))
+
+        lines = [f"perf_audit: {label_mode}, timeout={timeout}s, source={solution_path}"]
+        lines.append(f"{'shape':<16}{'n':<14}{'seconds':>9}  {'status':<12} stderr(tail)")
+        for shape, n_txt, secs, status, err in rows:
+            lines.append(f"{shape:<16}{str(n_txt):<14}{secs:>9.3f}  {status:<12} {_clip(err.replace(chr(10), ' | '), 200)}")
+        timed = [r for r in rows if not r[3].startswith("SKIPPED") and not r[3].startswith("GEN")]
+        if timed:
+            slow = max(timed, key=lambda r: (r[3] == "TIMEOUT", r[2]))
+            lines.append(f"SLOWEST: {slow[0]} at {slow[2]:.3f}s ({slow[3]})")
+        n_timeout = sum(1 for r in rows if r[3] == "TIMEOUT")
+        lines.append(f"TIMEOUTS: {n_timeout}/{len(rows)}")
+        return "\n".join(lines)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
diff --git a/utils/solution_wrap.py b/utils/solution_wrap.py
new file mode 100644
index 0000000..45dc21d
--- /dev/null
+++ b/utils/solution_wrap.py
@@ -0,0 +1,111 @@
+"""Helpers for class-style `Solution` files (no stdin handling).
+
+A class-style file defines `class Solution` and never reads stdin. Tools that run
+programs as stdin scripts can wrap such a file with a stdin/stdout driver:
+
+* every non-empty stdin line is one positional argument, either a Python literal
+  (`[1, 2]`, `"acab"`, `5`) or an assignment (`s = "acab"`, the name is ignored);
+  other lines are passed as raw stripped strings;
+* the first public method of `Solution` (or the one named by `entry`) is called;
+* the result is printed: bool -> true/false, None -> nothing, a list of lists ->
+  one row per line, other lists/tuples -> space separated, anything else -> str().
+"""
+import ast
+import re
+
+_CLASS_RE = re.compile(r'^\s*class\s+Solution\b', re.M)
+_STDIN_RE = re.compile(r'sys\.stdin|\binput\s*\(|\bstdin\b')
+
+WRAPPER_TEMPLATE = '''
+
+# ---- auto-generated stdin/stdout driver for class Solution (method: __METHOD__) ----
+def _dgm_parse(_tok):
+    import ast as _ast
+    _tok = _tok.strip()
+    if "=" in _tok:
+        _name, _rhs = _tok.split("=", 1)
+        if _name.strip().isidentifier() and not _rhs.startswith("="):
+            _tok = _rhs.strip()
+    try:
+        return _ast.literal_eval(_tok)
+    except Exception:
+        return _tok
+
+
+def _dgm_render(_res):
+    if isinstance(_res, bool):
+        return "true" if _res else "false"
+    if _res is None:
+        return ""
+    if isinstance(_res, (list, tuple)):
+        if _res and all(isinstance(_x, (list, tuple)) for _x in _res):
+            return "\\n".join(_dgm_render(_x) for _x in _res)
+        return " ".join(_dgm_render(_x) for _x in _res)
+    return str(_res)
+
+
+if __name__ == "__main__":
+    import sys as _dgm_sys
+    _dgm_lines = [_l for _l in _dgm_sys.stdin.read().split("\\n") if _l.strip()]
+    _dgm_args = [_dgm_parse(_l) for _l in _dgm_lines]
+    _dgm_res = getattr(Solution(), "__METHOD__")(*_dgm_args)
+    _dgm_out = _dgm_render(_dgm_res)
+    if _dgm_out:
+        print(_dgm_out)
+'''
+
+
+def is_class_style(code):
+    """True if the code defines `class Solution` and does not read stdin."""
+    return bool(_CLASS_RE.search(code or "")) and not _STDIN_RE.search(code or "")
+
+
+def find_methods(code):
+    """Public method names of `class Solution`, in definition order ([] if none/unparsable)."""
+    try:
+        tree = ast.parse(code or "")
+    except SyntaxError:
+        return []
+    for node in tree.body:
+        if isinstance(node, ast.ClassDef) and node.name == "Solution":
+            return [f.name for f in node.body
+                    if isinstance(f, ast.FunctionDef) and not f.name.startswith("_")]
+    return []
+
+
+def wrap_class_solution(code, entry=None):
+    """Return (wrapped_code, method_name). Raises ValueError if no method can be found."""
+    methods = find_methods(code)
+    method = entry or (methods[0] if methods else None)
+    if not method or not method.isidentifier():
+        raise ValueError("cannot find a public method of class Solution to call")
+    return code + WRAPPER_TEMPLATE.replace("__METHOD__", method), method
+
+
+def prepare_code(code, entry=None):
+    """Wrap class-style code with the driver; leave other code untouched."""
+    if is_class_style(code) or (entry and _CLASS_RE.search(code or "")):
+        wrapped, _ = wrap_class_solution(code, entry)
+        return wrapped
+    return code
+
+
+def runnable_copy(path, dest_dir, entry=None):
+    """Return a path that can be run as a stdin/stdout program.
+
+    Class-style files are written (wrapped) into dest_dir and that copy's path is
+    returned; any other file is returned unchanged. Raises ValueError if a
+    class-style file has no callable method.
+    """
+    import os
+    with open(path, "r", encoding="utf-8", errors="replace") as f:
+        code = f.read()
+    if not is_class_style(code):
+        return path
+    wrapped, _ = wrap_class_solution(code, entry)
+    out = os.path.join(dest_dir, "wrapped_" + os.path.basename(path))
+    if not out.endswith(".py"):
+        out += ".py"
+    with open(out, "w", encoding="utf-8") as f:
+        f.write(wrapped)
+    return out
