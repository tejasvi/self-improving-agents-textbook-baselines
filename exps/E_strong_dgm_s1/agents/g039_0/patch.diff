+import json
+import re
 import sys
 
+# Standalone sample extractor: reads a problem statement from stdin and
+# prints a JSON list of {"input": ..., "output": ...} sample pairs.
+
+PRIMARY = re.compile(
+    r'Sample Input\s*(\d+)\s*(.*?)\s*Sample Output\s*\1\s*(.*?)(?=Sample Input|\Z)',
+    re.S | re.I,
+)
+FALLBACK = re.compile(
+    r'Input:?\s*\n(.*?)\n\s*Output:?\s*\n(.*?)(?=\n\s*Input:?\s*\n|\Z)',
+    re.S | re.I,
+)
+
+
+def parse_samples(text):
+    pairs = []
+    for m in PRIMARY.finditer(text):
+        pairs.append((m.group(2).strip() + "\n", m.group(3).strip() + "\n"))
+    if not pairs:
+        for m in FALLBACK.finditer(text):
+            pairs.append((m.group(1).strip() + "\n", m.group(2).strip() + "\n"))
+    return pairs
+
 
