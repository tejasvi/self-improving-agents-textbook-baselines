+    def _parse_samples(self):
+        """Extract (input, output) sample pairs from the problem statement.
+
+        Primary pattern: 'Sample Input k' / 'Sample Output k' blocks. Fallback: 'Example' blocks
+        with 'Input:'/'Output:' labels. Returns a list of (in_text, out_text); empty if none parse.
+        """
+        text = self.problem_statement or ""
+        pairs = []
+        pat = re.compile(r"Sample Input\s*(\d+)\s*(.*?)\s*Sample Output\s*\1\s*(.*?)(?=Sample Input|\Z)", re.S)
+        for m in pat.finditer(text):
+            out_txt = re.split(r"\n\s*\n", m.group(3).strip(), maxsplit=1)[0]
+            pairs.append((m.group(2).strip() + "\n", out_txt.strip() + "\n"))
+        if not pairs:
+            pat2 = re.compile(r"Input:?\s*\n(.*?)\n\s*Output:?\s*\n(.*?)(?=\n\s*(?:Input:|Example|Explanation|Note)|\Z)", re.S)
+            for m in pat2.finditer(text):
+                i_txt = m.group(1).strip()
+                o_txt = re.split(r"\n\s*\n", m.group(2).strip(), maxsplit=1)[0].strip()
+                if i_txt and o_txt:
+                    pairs.append((i_txt + "\n", o_txt + "\n"))
+        if not pairs:
+            return []
+        os.makedirs(self.scratch_dir, exist_ok=True)
