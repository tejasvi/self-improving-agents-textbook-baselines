diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..362ed65
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,175 @@
+import json
+import os
+import subprocess
+import sys
+
+_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if _ROOT not in sys.path:
+    sys.path.insert(0, _ROOT)
+from utils.compare_utils import outputs_equal  # noqa: E402
+
+MAX_TIMEOUT = 60
+MAX_SAMPLES = 200
+CLIP = 1500
+STDERR_TAIL = 600
+
+# Driver executed in a subprocess for method mode. It imports the solution module by path,
+# calls Solution().<method>(*args) with the JSON-parsed arguments and prints the JSON-encoded result.
+_METHOD_DRIVER = r'''
+import importlib.util, json, sys
+path, method, args_json = sys.argv[1], sys.argv[2], sys.argv[3]
+spec = importlib.util.spec_from_file_location("solution_under_test", path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+args = json.loads(args_json)
+if not isinstance(args, list):
+    raise TypeError("sample input must be a JSON array of positional arguments")
+result = getattr(mod.Solution(), method)(*args)
+print(json.dumps(result))
+'''
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution against a JSON file of sample tests and return a raw per-sample table.
+
+* The samples file is a JSON list of objects: [{"input": ..., "expected_output": ...}, ...].
+* mode='stdin' (default): the "input" string is fed to the solution program on stdin, and its stdout is compared with "expected_output".
+* mode='method': the "input" string must be a JSON array of positional arguments. The solution file is imported, `Solution().<method_name>(*args)` is called, and the JSON-encoded return value is compared with "expected_output" (also JSON-encoded).
+* Comparison is tolerant on whitespace and numeric tokens (same rule as the stress tests).
+* Each sample is reported as one row: PASS, FAIL (wrong output), ERROR (nonzero exit or exception), or TIMEOUT. Each row shows the expected output, the actual output, and the tail of stderr.
+* The result is a raw table with no error parsing; read it and reason about the failing rows yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file (e.g. solution.py)."
+                },
+                "samples_path": {
+                    "type": "string",
+                    "description": "Path to a JSON file holding a list of {\"input\": str, \"expected_output\": str} objects."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "'stdin' (default) to run the file as a program, or 'method' to call Solution.<method_name>."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the Solution method to call (required in method mode)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "samples_path"]
+        }
+    }
+
+
+def _clip(s, n=CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars>"
+
+
+def _tail(s, n=STDERR_TAIL):
+    s = (s or "").strip()
+    if len(s) <= n:
+        return s
+    return f"...<{len(s) - n} earlier chars>" + s[-n:]
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a command. Returns (rc, stdout, stderr) or ('TIMEOUT', '', '') / ('OSERROR', '', msg)."""
+    try:
+        p = subprocess.run(cmd, input=stdin_text.encode('utf-8'), capture_output=True, timeout=timeout)
+        return p.returncode, p.stdout.decode('utf-8', errors='replace'), p.stderr.decode('utf-8', errors='replace')
+    except subprocess.TimeoutExpired:
+        return 'TIMEOUT', '', ''
+    except OSError as e:
+        return 'OSERROR', '', str(e)
+
+
+def _load_samples(samples_path):
+    try:
+        with open(samples_path, 'r', encoding='utf-8') as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        return None, f"Error: could not read samples file {samples_path}: {e}"
+    if not isinstance(data, list):
+        return None, "Error: samples file must contain a JSON list of {input, expected_output} objects."
+    samples = []
+    for item in data:
+        if not isinstance(item, dict):
+            samples.append({'input': '', 'expected_output': '', 'bad': 'sample entry is not an object'})
+            continue
+        samples.append({
+            'input': str(item.get('input', '')),
+            'expected_output': str(item.get('expected_output', '')),
+        })
+    return samples, None
+
+
+def _run_one(solution_path, sample, mode, method_name, timeout):
+    """Returns (status, actual, stderr) for one sample. status is PASS/FAIL/ERROR/TIMEOUT."""
+    if 'bad' in sample:
+        return 'ERROR', '', sample['bad']
+    if mode == 'method':
+        rc, out, err = _run(
+            [sys.executable, '-c', _METHOD_DRIVER, os.path.abspath(solution_path), method_name, sample['input']],
+            '', timeout)
+    else:
+        if solution_path.endswith('.py'):
+            cmd = [sys.executable, solution_path]
+        else:
+            cmd = [os.path.abspath(solution_path)]
+        rc, out, err = _run(cmd, sample['input'], timeout)
+    if rc == 'TIMEOUT':
+        return 'TIMEOUT', out, err
+    if rc != 0:
+        return 'ERROR', out, err
+    ok = outputs_equal(out, sample['expected_output'])
+    return ('PASS' if ok else 'FAIL'), out, err
+
+
+def tool_function(solution_path, samples_path, mode='stdin', method_name=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else 10), MAX_TIMEOUT))
+    except (TypeError, ValueError):
+        timeout = 10
+    mode = (mode or 'stdin').strip().lower()
+    if mode not in ('stdin', 'method'):
+        return f"Error: mode must be 'stdin' or 'method', got {mode!r}."
+    if mode == 'method' and not method_name:
+        return "Error: method_name is required in method mode."
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not samples_path or not os.path.isfile(samples_path):
+        return f"Error: samples file not found: {samples_path}"
+
+    samples, err = _load_samples(samples_path)
+    if err:
+        return err
+    if not samples:
+        return "Error: samples file contains no samples."
+    if len(samples) > MAX_SAMPLES:
+        return f"Error: too many samples (max {MAX_SAMPLES})."
+
+    lines = [f"run_samples: mode={mode} solution={solution_path} samples={len(samples)} timeout={timeout}s"]
+    counts = {}
+    for i, sample in enumerate(samples, 1):
+        status, actual, stderr = _run_one(solution_path, sample, mode, method_name, timeout)
+        counts[status] = counts.get(status, 0) + 1
+        lines.append(f"=== sample {i}: {status} ===")
+        lines.append(f"input: {_clip(sample['input'], 400)!r}")
+        lines.append(f"expected: {_clip(sample['expected_output'])!r}")
+        lines.append(f"actual: {_clip(actual)!r}")
+        if stderr.strip():
+            lines.append(f"stderr: {_tail(stderr)!r}")
+    summary = ', '.join(f"{k}={v}" for k, v in sorted(counts.items()))
+    lines.append(f"SUMMARY: {len(samples)} samples: {summary}")
+    return "\n".join(lines)
