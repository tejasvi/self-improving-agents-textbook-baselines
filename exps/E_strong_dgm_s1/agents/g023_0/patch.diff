+def run_compare(path_a, path_b, gen_path, seeds, modes=None, timeout=10, budget=_STRESS_BUDGET):
+    """
+    Differential test: run two solutions on the same generated inputs (every (mode, seed) pair).
+    Crashes (timeout / nonzero exit / stderr) are counted per side and are not treated as a
+    disagreement; a disagreement means both produced output and the outputs differ (whitespace-normalised).
+    Returns dict:
+      total, ran, agreed, crashed_a, crashed_b, gen_failed, budget_hit,
+      per_mode: {mode: {'cases', 'max_time_a', 'max_time_b', 'crash_a', 'crash_b'}}
+      disagreement: None or {'mode', 'seed', 'input', 'out_a', 'out_b', 'time_a', 'time_b'} (first one only)
+    """
+    seeds = list(seeds)
+    modes = [None] if not modes else list(modes)
+    cases = [(m, s) for m in modes for s in seeds]
+    result = {'total': len(cases), 'ran': 0, 'agreed': 0, 'crashed_a': 0, 'crashed_b': 0,
+              'gen_failed': 0, 'budget_hit': False, 'disagreement': None,
+              'per_mode': {str(m): {'cases': 0, 'max_time_a': 0.0, 'max_time_b': 0.0,
+                                    'crash_a': 0, 'crash_b': 0} for m in modes}}
+    if not cases:
+        return result
+    tmpdir = _tmp_with({'_a.py': path_a, '_b.py': path_b, '_gen.py': gen_path})
+    try:
+        t_start = time.monotonic()
+        for mode, seed in cases:
+            if time.monotonic() - t_start > budget:
+                result['budget_hit'] = True
+                break
+            result['ran'] += 1
+            pm = result['per_mode'][str(mode)]
+            pm['cases'] += 1
+            gst, test_in, gerr, grc, _ = _run([sys.executable, '-I', '_gen.py', *_gen_args(seed, mode)],
+                                              tmpdir, '', timeout)
+            if gst != 'ok' or grc != 0 or not test_in.strip():
+                result['gen_failed'] += 1
+                continue
+            ast_, aout, aerr, arc, at = _run([sys.executable, '-I', '_a.py'], tmpdir, test_in, timeout)
+            bst, bout, berr, brc, bt = _run([sys.executable, '-I', '_b.py'], tmpdir, test_in, timeout)
+            pm['max_time_a'] = max(pm['max_time_a'], at)
+            pm['max_time_b'] = max(pm['max_time_b'], bt)
+            a_crash = _solution_crashed(ast_, arc, aerr)
+            b_crash = _solution_crashed(bst, brc, berr)
+            if a_crash:
+                result['crashed_a'] += 1
+                pm['crash_a'] += 1
+            if b_crash:
+                result['crashed_b'] += 1
+                pm['crash_b'] += 1
+            if a_crash or b_crash:
+                continue
+            if _normalise(aout) == _normalise(bout):
+                result['agreed'] += 1
+            elif result['disagreement'] is None:
+                result['disagreement'] = {'mode': mode, 'seed': seed, 'input': test_in,
+                                          'out_a': aout, 'out_b': bout, 'time_a': at, 'time_b': bt}
+        return result
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
