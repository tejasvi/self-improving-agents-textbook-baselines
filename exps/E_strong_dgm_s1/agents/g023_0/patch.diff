+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from tools import solution_check
+
+GOOD = "a, b = map(int, input().split())\nprint(a + b)\n"
+ALSO_GOOD = "x, y = map(int, input().split())\nprint(y + x)\n"
+WRONG = "a, b = map(int, input().split())\nprint(a + b + 1)\n"
+CRASH = "a, b = map(int, input().split())\nprint(a + b)\nraise SystemExit(3)\n"
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode == 'max':\n"
+       "    print(10**9, 10**9)\n"
+       "elif mode == 'adv':\n"
+       "    print(-10**9, -10**9)\n"
+       "else:\n"
+       "    print(random.randint(0, 9), random.randint(0, 9))\n")
+
+
+def _write(tmp_path, name, src):
+    p = tmp_path / name
+    p.write_text(src)
+    return str(p)
+
+
+def test_run_compare_agreement(tmp_path):
+    a = _write(tmp_path, "a.py", GOOD)
+    b = _write(tmp_path, "b.py", ALSO_GOOD)
+    g = _write(tmp_path, "gen.py", GEN)
+    res = solution_check.run_compare(a, b, g, range(3), modes=['mid', 'adv'], timeout=10)
+    assert res['disagreement'] is None
+    assert res['agreed'] == 6 and res['crashed_a'] == 0 and res['crashed_b'] == 0
+    assert set(res['per_mode']) == {'mid', 'adv'}
+    assert res['per_mode']['adv']['cases'] == 3
+
+
+def test_run_compare_reports_first_disagreement(tmp_path):
+    a = _write(tmp_path, "a.py", GOOD)
+    b = _write(tmp_path, "b.py", WRONG)
+    g = _write(tmp_path, "gen.py", GEN)
+    res = solution_check.run_compare(a, b, g, range(2), modes=['mid'], timeout=10)
+    d = res['disagreement']
+    assert d is not None and d['mode'] == 'mid' and d['seed'] == 0
+    assert d['input'].strip() and d['out_a'].strip() != d['out_b'].strip()
+    assert d['time_a'] >= 0 and d['time_b'] >= 0
+
+
+def test_run_compare_crash_is_not_disagreement(tmp_path):
+    a = _write(tmp_path, "a.py", GOOD)
+    c = _write(tmp_path, "c.py", CRASH)
+    g = _write(tmp_path, "gen.py", GEN)
+    res = solution_check.run_compare(a, c, g, range(2), modes=['max'], timeout=10)
+    assert res['disagreement'] is None
+    assert res['crashed_b'] == 2 and res['crashed_a'] == 0
+    assert res['per_mode']['max']['crash_b'] == 2
+
+
+def test_generator_validation_covers_all_modes(tmp_path):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(GOOD)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps([{"input": "1 2\n", "output": "3\n"}]))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    ok, msg = agent._validate_tests()
+    assert ok, msg
+    assert "generator modes" in msg and "adv" in coding_agent.GEN_MODES and "mid" in coding_agent.GEN_MODES
+
+
+def test_generator_missing_mode_fails_validation(tmp_path):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "tests" / "brute.py").write_text(GOOD)
+    (root / "tests" / "gen.py").write_text("import sys\nif sys.argv[2:3] == ['adv']:\n    raise SystemExit(2)\nprint(1, 2)\n")
+    (root / "tests" / "samples.json").write_text(json.dumps([{"input": "1 2\n", "output": "3\n"}]))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent._init_pipeline(budget_seconds=600)
+    ok, msg = agent._validate_tests()
+    assert not ok and "'adv'" in msg
+
+
+def test_perfect_score_requires_cross_and_no_crash():
+    stress = {'total': 10, 'budget_hit': False}
+    P = coding_agent.AgenticSystem._is_perfect_score
+    assert P((2, 10, 1, 1), 2, stress)
+    assert not P((2, 10, 0, 1), 2, stress)   # cross-check failed
+    assert not P((2, 10, 1, 0), 2, stress)   # crash / adv too slow
+    assert not P((1, 10, 1, 1), 2, stress)   # sample failure
+    assert not P((2, 9, 1, 1), 2, stress)    # stress failure
+    assert not P((2, 10, 1, 1), 2, {'total': 10, 'budget_hit': True})
+
+
+def test_is_perfect_report_after_mark_result():
+    rep = "samples: 2/2 passed\nRESULT: OK"
+    assert coding_agent.AgenticSystem._is_perfect_report(rep)
+    marked = coding_agent.AgenticSystem._mark_result(rep, False)
+    assert not coding_agent.AgenticSystem._is_perfect_report(marked)
+    assert marked.count("RESULT:") == 1
+
+
+def test_coverage_summary():
+    cov = coding_agent.AgenticSystem._coverage_summary(["3\n1 2\n", "3\n1 2\n", "10\n"])
+    assert cov['count'] == 3 and cov['distinct'] == 2 and cov['n_min'] == 3 and cov['n_max'] == 10
