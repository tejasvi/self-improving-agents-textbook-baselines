+import sys
+
+# PLACEHOLDER brute force. The problem statement (Roulettes) was not available
+# when this file was written, so the input format below is an ASSUMPTION that
+# mirrors the placeholder solution.py: first integer t, then t test cases.
+# Replace the body with an exhaustive solution once the statement is known.
+
+
+def solve_case(tokens, pos):
+    # Assumed format: one integer n followed by n integers.
+    n = int(tokens[pos])
+    arr = [int(x) for x in tokens[pos + 1:pos + 1 + n]]
+    return 0, pos + 1 + n
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    t = int(data[0])
+    pos = 1
+    out = []
+    for _ in range(t):
+        ans, pos = solve_case(data, pos)
+        out.append(str(ans))
+    sys.stdout.write("\n".join(out) + ("\n" if out else ""))
+
+
+if __name__ == "__main__":
+    main()
