+def _as_float(tok):
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def _outputs_match(got, expected, tol):
+    """
+    Compare two outputs token by token. Returns 'exact' (same text after whitespace normalisation),
+    'tolerant' (texts differ, but every differing token pair is numeric and satisfies
+    |a-b| <= tol*max(1,|b|)), or 'differ'. Line counts and per-line token counts must match.
+    """
+    if _normalise(got) == _normalise(expected):
+        return 'exact'
+    g_lines = [line.split() for line in _normalise(got)]
+    e_lines = [line.split() for line in _normalise(expected)]
+    if len(g_lines) != len(e_lines):
+        return 'differ'
+    tolerant = False
+    for gl, el in zip(g_lines, e_lines):
+        if len(gl) != len(el):
+            return 'differ'
+        for a, b in zip(gl, el):
+            if a == b:
+                continue
+            x, y = _as_float(a), _as_float(b)
+            if x is None or y is None or not math.isfinite(x) or not math.isfinite(y):
+                return 'differ'
+            if abs(x - y) <= tol * max(1.0, abs(y)):
+                tolerant = True
+            else:
+                return 'differ'
+    return 'tolerant' if tolerant else 'exact'
+
