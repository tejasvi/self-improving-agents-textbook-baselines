+import sys
+from typing import List
+
+
+def modpow(base, exp, mod):
+    result = 1 % mod
+    base %= mod
+    while exp > 0:
+        if exp & 1:
+            result = result * base % mod
+        base = base * base % mod
+        exp >>= 1
+    return result
+
+
+def _count_prefix(n):
+    """For x in [0, n): C = total popcount, W = total sum of set-bit positions."""
+    C = 0
+    W = 0
+    for b in range(n.bit_length()):
+        full = n >> (b + 1)
+        rem = n & ((1 << (b + 1)) - 1)
+        cnt = full * (1 << b) + max(0, rem - (1 << b))
+        C += cnt
+        W += b * cnt
+    return C, W
+
+
+def _locate(p):
+    """1-indexed position p in big_nums -> (x, j): element p is the j-th
+    (1-indexed) set bit of x."""
+    lo, hi = 1, 1 << 60
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if _count_prefix(mid + 1)[0] >= p:
+            hi = mid
+        else:
+            lo = mid + 1
+    x = lo
+    j = p - _count_prefix(x)[0]
+    return x, j
+
+
+def _exp_prefix(P):
+    """Sum of exponents of the first P elements of big_nums."""
+    if P <= 0:
+        return 0
+    x, j = _locate(P)
+    total = _count_prefix(x)[1]
+    b = 0
+    taken = 0
+    while taken < j:
+        if (x >> b) & 1:
+            total += b
+            taken += 1
+        b += 1
+    return total
+
+
+def solve_queries(queries):
+    res = []
+    for L, R, m in queries:
+        e = _exp_prefix(R) - _exp_prefix(L - 1)
+        res.append(modpow(2, e, m))
+    return res
+
+
+class Solution:
+    def findProductsOfElements(self, queries: List[List[int]]) -> List[int]:
+        return solve_queries(queries)
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    q = int(data[0])
+    queries = []
+    idx = 1
+    for _ in range(q):
+        L = int(data[idx]); R = int(data[idx + 1]); m = int(data[idx + 2])
+        idx += 3
+        queries.append((L, R, m))
+    print("\n".join(str(v) for v in solve_queries(queries)))
+
+
+if __name__ == "__main__":
+    main()
