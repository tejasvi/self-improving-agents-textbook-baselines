+def modpow(base, exp, mod):
+    # Portable modular exponentiation (no 3-argument builtin pow).
+    result = 1 % mod
+    base %= mod
+    while exp > 0:
+        if exp & 1:
+            result = result * base % mod
+        base = base * base % mod
+        exp >>= 1
+    return result
+
+
+def _count_prefix(n):
+    """Return (C, W): C = sum of popcount(x) and W = sum of bit-position sums
+    of set bits over x in [0, n)."""
+    C = 0
+    W = 0
+    for b in range(n.bit_length()):
+        full = n >> (b + 1)
+        rem = n & ((1 << (b + 1)) - 1)
+        cnt = full * (1 << b) + max(0, rem - (1 << b))
+        C += cnt
+        W += b * cnt
+    return C, W
+
+
+def _locate(p):
+    """Given 1-indexed position p in big_nums, return (x, j): position p is the
+    j-th (1-indexed) element of powerful(x)."""
+    lo, hi = 1, 1 << 60
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if _count_prefix(mid + 1)[0] >= p:
+            hi = mid
+        else:
+            lo = mid + 1
+    x = lo
+    j = p - _count_prefix(x)[0]
+    return x, j
+
+
+def _exp_prefix(P):
+    """Sum of exponents of the first P elements of big_nums."""
+    if P <= 0:
+        return 0
+    x, j = _locate(P)
+    _, W = _count_prefix(x)
+    total = W
+    # add exponents of the first j set bits of x (ascending)
+    b = 0
+    taken = 0
+    while taken < j:
+        if (x >> b) & 1:
+            total += b
+            taken += 1
+        b += 1
+    return total
+
+
+class Solution:
+    def findProductsOfElements(self, queries: List[List[int]]) -> List[int]:
+        res = []
+        for L, R, m in queries:
+            e = _exp_prefix(R) - _exp_prefix(L - 1)
+            res.append(modpow(2, e, m))
+        return res
