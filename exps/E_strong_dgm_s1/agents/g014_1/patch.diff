@@ -0,0 +1,72 @@
+import sys
+
+
+def modpow(base, exp, mod):
+    result = 1 % mod
+    base %= mod
+    while exp > 0:
+        if exp & 1:
+            result = result * base % mod
+        base = base * base % mod
+        exp >>= 1
+    return result
+
+
+def _prefix(n):
+    """For all x in [0, n): C = total popcount, W = total sum of set-bit positions."""
+    C = 0
+    W = 0
+    for b in range(n.bit_length()):
+        full = n >> (b + 1)
+        rem = n & ((1 << (b + 1)) - 1)
+        cnt = full * (1 << b) + max(0, rem - (1 << b))
+        C += cnt
+        W += b * cnt
+    return C, W
+
+
+def _exp_prefix(P):
+    """Sum of exponents of the first P elements of big_nums (1-indexed prefix)."""
+    if P <= 0:
+        return 0
+    # smallest x with C(x+1) >= P, i.e. element P lies in powerful(x)
+    lo, hi = 1, 1 << 62
+    while lo < hi:
+        mid = (lo + hi) // 2
+        if _prefix(mid + 1)[0] >= P:
+            hi = mid
+        else:
+            lo = mid + 1
+    x = lo
+    C_before, W_before = _prefix(x)
+    j = P - C_before  # 1-indexed set bit of x
+    total = W_before
+    b = 0
+    while j > 0:
+        if (x >> b) & 1:
+            total += b
+            j -= 1
+        b += 1
+    return total
+
+
+def solve_queries(queries):
+    out = []
+    for L, R, m in queries:
+        e = _exp_prefix(R) - _exp_prefix(L - 1)
+        out.append(modpow(2, e, m))
+    return out
+
+
+def main():
+    data = sys.stdin.read().split()
+    q = int(data[0])
+    queries = []
+    for i in range(q):
+        L, R, m = int(data[1 + 3 * i]), int(data[2 + 3 * i]), int(data[3 + 3 * i])
+        queries.append((L, R, m))
+    print("\n".join(str(v) for v in solve_queries(queries)))
+
+
+if __name__ == "__main__":
+    main()
