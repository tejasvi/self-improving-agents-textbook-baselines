@@ -0,0 +1,24 @@
+import sys
+
+
+def max_subarray_sum(nums):
+    # Kadane's algorithm: maximum sum of a non-empty contiguous subarray.
+    best = cur = nums[0]
+    for x in nums[1:]:
+        cur = max(x, cur + x)
+        if cur > best:
+            best = cur
+    return best
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    n = int(data[0])
+    nums = list(map(int, data[1:1 + n]))
+    print(max_subarray_sum(nums))
+
+
+if __name__ == "__main__":
+    main()
