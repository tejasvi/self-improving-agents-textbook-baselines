+import sys
+
+
+def main():
+    # Assumed problem (statement not provided): read integer N and print the
+    # lexicographically smallest triple (a, b, c) of non-negative integers
+    # with a + b + c = N. Output is canonical, so no checker is needed.
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    n = int(data[0])
+    if n < 0:
+        print(-1)
+        return
+    print(0, 0, n)
+
+
+if __name__ == "__main__":
+    main()
