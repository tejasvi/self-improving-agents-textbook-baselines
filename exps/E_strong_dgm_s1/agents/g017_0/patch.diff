index 0000000..e6115c9
--- /dev/null
+++ b/tests/test_harness_tolerance.py
@@ -0,0 +1,106 @@
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+
+BRUTE_SMALL_ONLY = (
+    "import sys\n"
+    "a, b = map(int, input().split())\n"
+    "if a > 100:\n"
+    "    while True:\n"
+    "        pass\n"
+    "print(a + b)\n"
+)
+GEN = ("import random, sys\n"
+       "random.seed(int(sys.argv[1]))\n"
+       "mode = sys.argv[2] if len(sys.argv) > 2 else 'small'\n"
+       "if mode == 'max':\n"
+       "    print(10**9, 10**9)\n"
+       "else:\n"
+       "    print(random.randint(0, 9), random.randint(0, 9))\n")
+SAMPLES = [{"input": "1 2\n", "output": "3\n"},
+           {"input": "5 5\n", "output": "10\n"},
+           {"input": "1000 1\n", "output": "1001\n"}]
+
+
+def _agent(tmp_path, brute=BRUTE_SMALL_ONLY, samples=SAMPLES):
+    root = tmp_path / "repo"
+    (root / "tests").mkdir(parents=True)
+    (root / "cands").mkdir()
+    (root / "tests" / "brute.py").write_text(brute)
+    (root / "tests" / "gen.py").write_text(GEN)
+    (root / "tests" / "samples.json").write_text(json.dumps(samples))
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(root)
+    agent.problem_statement = "add two numbers"
+    agent.code_model = "test"
+    agent._init_pipeline(budget_seconds=600)
+    return agent, root
+
+
+def test_validate_accepts_brute_timing_out_on_big_sample(tmp_path, monkeypatch):
+    # Brute loops forever on a=1000 (big sample) but solves the small ones.
+    monkeypatch.setattr(coding_agent, "TIME_LIMIT", 1)
+    agent, _ = _agent(tmp_path)
+    ok, report = agent._validate_tests()
+    assert ok, report
+    assert agent.big_sample_idx == [2]
+
+
+def test_validate_rejects_wrong_output(tmp_path):
+    wrong = "a, b = map(int, input().split())\nprint(a + b + 1)\n"
+    agent, _ = _agent(tmp_path, brute=wrong)
+    ok, _ = agent._validate_tests()
+    assert not ok
+
+
+def test_ensure_file_creates_on_second_call(tmp_path, monkeypatch):
+    agent, root = _agent(tmp_path)
+    target = root / "cands" / "cand_x.py"
+    calls = []
+
+    def fake_chat(prompt, model=None, msg_history=None, logging=None):
+        calls.append(prompt)
+        if len(calls) == 2:
+            target.write_text("print(1)\n")
+        return ""
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    assert agent._ensure_file(str(target), max_retries=3) is True
+    assert len(calls) == 2
+
+
+def test_ensure_file_gives_up_after_bounded_retries(tmp_path, monkeypatch):
+    agent, root = _agent(tmp_path)
+    calls = []
+    monkeypatch.setattr(coding_agent, "chat_with_agent",
+                        lambda *a, **k: calls.append(1) or "")
+    assert agent._ensure_file(str(root / "cands" / "none.py"), max_retries=3) is False
+    assert len(calls) == 3
+
+
+def test_score_candidate_gives_sample_credit_without_brute(tmp_path):
+    agent, root = _agent(tmp_path)
+    os.remove(root / "tests" / "brute.py")
+    cand = root / "cands" / "good.py"
+    cand.write_text("a, b = map(int, input().split())\nprint(a + b)\n")
+    score, rep = agent._score_candidate(str(cand))
+    assert score[0] == 3
+    assert agent._is_perfect_report(rep) is False
+
+
+def test_finalize_writes_stub_when_no_candidates(tmp_path, monkeypatch):
+    agent, root = _agent(tmp_path)
+    (root / "solution.py").write_text("# placeholder\n")
+    monkeypatch.setattr(coding_agent, "chat_with_agent", lambda *a, **k: "")
+    agent._finalize = lambda p: None  # no best candidate path in this scenario
+    agent.base_commit = None
+    # emulate the finalization tail of forward()
+    agent._ensure_file(agent.solution_path, max_retries=1)
+    if not agent._has_code(agent.solution_path):
+        with open(agent.solution_path, "w") as f:
+            f.write("import sys\ndata = sys.stdin.read()\n")
+    assert agent._has_code(agent.solution_path)
