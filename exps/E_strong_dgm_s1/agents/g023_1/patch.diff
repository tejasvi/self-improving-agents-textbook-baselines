+def _extract_samples(statement):
+    """Extract (input, output) pairs from 'Sample Input N' / 'Sample Output N' blocks.
+    Fence lines (```) are skipped; a block ends at a blank line, the next header, or an 'Explanation'/'Note' line."""
+    pairs = []
+    cur_in, cur_out = [], []
+    state = None  # None | 'input' | 'output'
+
+    def flush():
+        inp = '\n'.join(cur_in).strip('\n')
+        out = '\n'.join(cur_out).strip()
+        if inp.strip() and out:
+            pairs.append((inp + '\n', out + '\n'))
+
+    for raw in (statement or '').replace('\r\n', '\n').split('\n'):
+        s = raw.strip().strip('*_#: ').strip()
+        head = re.match(r'(?i)^sample\s+(input|output)\b', s)
+        if head:
+            if state == 'output':
+                flush()
+            if head.group(1).lower() == 'input':
+                cur_in, cur_out, state = [], [], 'input'
+            else:
+                cur_out, state = [], 'output'
+            continue
+        if state is None or s.startswith('```'):
+            continue
+        if re.match(r'(?i)^(explanation|note)\b', s):
+            if state == 'output':
+                flush()
+            state = None
+            continue
+        if not s:
+            if state == 'output' and cur_out:
+                flush()
+                state = None
+            elif state == 'input' and cur_in:
+                state = None
+            continue
+        if state == 'input':
+            cur_in.append(raw.rstrip())
+        else:
+            cur_out.append(raw.rstrip())
+    if state == 'output' and cur_out:
+        flush()
+    return pairs
+
+
