+import math
+import os
+import signal
+import subprocess
+import sys
+
+# Fit closed-form candidates against a program's outputs on a parameter grid.
+# Each grid entry is a stdin string for the program. var_names bind the whitespace-separated
+# tokens of that input (in order) to names; the program's output is available as `out`.
+# Expressions are evaluated in a restricted namespace (math helpers, integer helpers, no builtins).
+
+_MAX_ROWS = 300
+_SHOW_ROWS = 60
+_MAX_COUNTEREXAMPLES = 5
+_EVAL_SECONDS = 2
+
+
+def tool_info():
+    return {
+        "name": "formula_fit",
+        "description": """Fit closed-form formulas against a program's outputs over a parameter grid.\n
+* Runs the program (python3 -I) once per entry of `param_grid` (each entry is the full stdin text of one test).\n
+* Prints a compact table of inputs and outputs.\n
+* Binds `var_names` to the whitespace-separated tokens of each input (in order, integers when possible) and binds `out` to the program's output (an integer when possible).\n
+* Evaluates each expression in `expressions` on every row (math module functions, comb, perm, gcd, lcm, isqrt, factorial, abs, min, max, sum, pow, divmod, range, len, int, round; no other builtins). An expression matches a row when its value equals `out`.\n
+* Reports the match count per expression and the first 5 counterexamples (input, output, expression value).\n
+Use it to test a hypothesis such as '2**n - 1' or 'n*(n+1)//2' against brute-force data before writing solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {
+                    "type": "string",
+                    "description": "Path to the Python program that reads stdin and writes the answer to stdout (for example the brute force)."
+                },
+                "param_grid": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin strings, one per test (for example '3\\n' or '2 5\\n'). At most 300 entries."
+                },
+                "expressions": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Python expressions over the variable names (and `out`) that should equal the program's output, for example 'n*(n+1)//2'."
+                },
+                "var_names": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Names for the whitespace-separated tokens of each input, in order, for example ['n'] or ['n', 'k']."
+                }
+            },
+            "required": ["program_path", "param_grid", "expressions"]
+        }
+    }
+
+
+def _allowed_names():
+    ns = {}
+    for name in dir(math):
+        if not name.startswith('_'):
+            ns[name] = getattr(math, name)
+    for name in ('abs', 'min', 'max', 'sum', 'len', 'range', 'int', 'round', 'pow', 'divmod',
+                 'bool', 'sorted', 'all', 'any', 'float'):
+        ns[name] = __builtins__[name] if isinstance(__builtins__, dict) else getattr(__builtins__, name)
+    ns['comb'] = math.comb
+    ns['perm'] = math.perm
+    ns['isqrt'] = math.isqrt
+    ns['gcd'] = math.gcd
+    ns['lcm'] = math.lcm
+    return ns
+
+
+def _parse_value(text):
+    text = text.strip()
+    try:
+        return int(text)
+    except ValueError:
+        return text
+
+
+class _EvalTimeout(Exception):
+    pass
+
+
+def _on_alarm(signum, frame):
+    raise _EvalTimeout()
+
+
+def _eval_expr(code, env):
+    """Evaluate compiled code in env; returns (value, error_string_or_None)."""
+    use_alarm = hasattr(signal, 'SIGALRM') and hasattr(signal, 'setitimer')
+    old = None
+    try:
+        if use_alarm:
+            old = signal.signal(signal.SIGALRM, _on_alarm)
+            signal.setitimer(signal.ITIMER_REAL, _EVAL_SECONDS)
+        return eval(code, env), None
+    except _EvalTimeout:
+        return None, 'evaluation timed out'
+    except Exception as e:  # noqa: BLE001 - report any evaluation error as a mismatch
+        return None, f"{type(e).__name__}: {e}"
+    finally:
+        if use_alarm:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+            if old is not None:
+                signal.signal(signal.SIGALRM, old)
+
+
+def _run_program(program_path, stdin_text, timeout):
+    try:
+        proc = subprocess.run([sys.executable, '-I', program_path], input=stdin_text,
+                              capture_output=True, text=True, timeout=timeout,
+                              cwd=os.path.dirname(os.path.abspath(program_path)) or None)
+    except subprocess.TimeoutExpired:
+        return None, 'TIMEOUT'
+    if proc.returncode != 0:
+        err = (proc.stderr or '').strip().splitlines()
+        return None, f"ERROR(rc={proc.returncode}): {err[-1] if err else ''}"
+    return proc.stdout.strip(), None
+
+
+def tool_function(program_path, param_grid, expressions, var_names=None, timeout=10):
+    if not program_path or not os.path.isfile(program_path):
+        return f"Error: program not found: {program_path}"
+    if not isinstance(param_grid, list) or not param_grid:
+        return "Error: param_grid must be a non-empty list of input strings."
+    if not isinstance(expressions, list) or not expressions:
+        return "Error: expressions must be a non-empty list of Python expressions."
+    var_names = list(var_names or [])
+    if len(param_grid) > _MAX_ROWS:
+        return f"Error: param_grid has {len(param_grid)} rows; the limit is {_MAX_ROWS}."
+    try:
+        timeout = max(1, int(timeout or 10))
+    except (TypeError, ValueError) as e:
+        return f"Error: invalid timeout: {e}"
+
+    compiled = []
+    for expr in expressions:
+        try:
+            compiled.append((expr, compile(str(expr), '<expr>', 'eval')))
+        except SyntaxError as e:
+            return f"Error: expression {expr!r} has a syntax error: {e.msg}"
+
+    # Run the program on every grid entry.
+    rows = []
+    for inp in param_grid:
+        inp_text = str(inp)
+        if inp_text and not inp_text.endswith('\n'):
+            inp_text += '\n'
+        out, err = _run_program(program_path, inp_text, timeout)
+        rows.append({'input': inp_text, 'out_text': out if err is None else err, 'error': err})
+
+    # Evaluate expressions per row.
+    base = _allowed_names()
+    stats = {expr: {'matches': 0, 'counter': []} for expr, _ in compiled}
+    evaluated = 0
+    for row in rows:
+        tokens = row['input'].split()
+        env = dict(base)
+        env['__builtins__'] = {}
+        for i, name in enumerate(var_names):
+            if i < len(tokens):
+                env[name] = _parse_value(tokens[i])
+        row_out = _parse_value(row['out_text']) if row['error'] is None else None
+        env['out'] = row_out
+        for expr, code in compiled:
+            if row['error'] is not None:
+                if len(stats[expr]['counter']) < _MAX_COUNTEREXAMPLES:
+                    stats[expr]['counter'].append((row['input'], row['out_text'], 'skipped (program failed)'))
+                continue
+            value, err = _eval_expr(code, env)
+            if err is None and value == row_out:
+                stats[expr]['matches'] += 1
+            elif len(stats[expr]['counter']) < _MAX_COUNTEREXAMPLES:
+                stats[expr]['counter'].append((row['input'], row['out_text'], err if err else repr(value)))
+        if row['error'] is None:
+            evaluated += 1
+
+    lines = [f"program: {program_path}  rows: {len(rows)}  program-ok rows: {evaluated}"]
+    lines.append("")
+    lines.append("table (input -> output):")
+    shown = rows[:_SHOW_ROWS]
+    for row in shown:
+        inp = row['input'].strip().replace('\n', ' | ') or '(empty)'
+        lines.append(f"  {inp:<30} -> {row['out_text'][:60]}")
+    if len(rows) > _SHOW_ROWS:
+        lines.append(f"  ... ({len(rows) - _SHOW_ROWS} more rows not shown)")
+    lines.append("")
+    for expr, _ in compiled:
+        st = stats[expr]
+        lines.append(f"expression: {expr}  matches: {st['matches']}/{len(rows)}")
+        if st['matches'] < len(rows):
+            lines.append(f"  first counterexamples (up to {_MAX_COUNTEREXAMPLES}):")
+            for inp, out_text, value in st['counter']:
+                lines.append(f"    input={inp.strip()!r} output={out_text!r} expression_value={value}")
+    return "\n".join(lines)
