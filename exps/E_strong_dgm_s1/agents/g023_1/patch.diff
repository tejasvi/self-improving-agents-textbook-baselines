+import os
+import shutil
+import coding_agent as ca
+from tools import formula_fit
+
+STMT = "Sum two numbers.\nSample Input 1\n1 2\nSample Output 1\n3\n"
+GEN_MAX = "print(10**16, 10**16)\n"
+
+
+def _agent(tmp_path):
+    a = ca.AgenticSystem.__new__(ca.AgenticSystem)
+    a.problem_statement = STMT
+    a.git_tempdir = str(tmp_path)
+    a.code_model = 'm'
+    return a
+
+
+def _gate(tmp_path, src):
+    (tmp_path / 'solution.py').write_text(src)
+    (tmp_path / 'gen_max.py').write_text(GEN_MAX)
+    return _agent(tmp_path)._perf_gate()
+
+
+def test_gate_accepts_fast_solution(tmp_path):
+    ok, rep = _gate(tmp_path, "a, b = map(int, input().split())\nprint(a + b)\n")
+    assert ok, rep
+
+
+def test_gate_rejects_exponential_solution(tmp_path):
+    src = ("n = int(input().split()[0])\n"
+           "def f(k):\n    return 1 if k == 0 else f(k - 1) + f(k - 1)\n"
+           "print(f(n) % 7)\n")
+    ok, rep = _gate(tmp_path, src)
+    assert not ok
+    assert 'TIMED OUT' in rep or 'rc' in rep or 'exit code' in rep
+
+
+def test_gate_rejects_sleeping_solution(tmp_path, monkeypatch):
+    monkeypatch.setattr(ca, 'PERF_TIMEOUT', 1)
+    src = "import time\na, b = map(int, input().split())\nprint(a + b)\ntime.sleep(10)\n"
+    ok, rep = _gate(tmp_path, src)
+    assert not ok
+    assert 'TIMED OUT' in rep
+
+
+def test_gate_rejects_wrong_sample(tmp_path):
+    ok, rep = _gate(tmp_path, "a, b = map(int, input().split())\nprint(a - b)\n")
+    assert not ok
+
+
+def test_gate_fails_without_solution(tmp_path):
+    ok, rep = _agent(tmp_path)._perf_gate()
+    assert not ok
+
+
+def test_extract_samples():
+    st = ("Blah\nSample Input 1\n```\n3\n1 2 3\n```\nSample Output 1\n```\n6\n```\n"
+          "Explanation: x\nSample Input 2\n5\nSample Output 2\n10\n")
+    assert ca._extract_samples(st) == [("3\n1 2 3\n", "6\n"), ("5\n", "10\n")]
+    assert ca._extract_samples("no samples") == []
+
+
+def test_formula_fit_identifies_correct_formula(tmp_path):
+    prog = tmp_path / 'brute.py'
+    prog.write_text("n = int(input())\nprint(n * (n + 1) // 2)\n")
+    grid = [f"{n}\n" for n in range(1, 8)]
+    out = formula_fit.tool_function(str(prog), grid, ["n*(n+1)//2", "n*n"], var_names=["n"])
+    assert "expression: n*(n+1)//2  matches: 7/7" in out
+    assert "expression: n*n  matches:" in out and "matches: 7/7" not in out.split("expression: n*n")[1]
+
+
+def test_formula_fit_reports_counterexamples(tmp_path):
+    prog = tmp_path / 'brute.py'
+    prog.write_text("n = int(input())\nprint(2 ** n)\n")
+    grid = [f"{n}\n" for n in range(0, 10)]
+    out = formula_fit.tool_function(str(prog), grid, ["2*n"], var_names=["n"])
+    # 2**n == 2*n only at n=1 (2==2) and n=2 (4==4)
+    assert "expression: 2*n  matches: 2/10" in out
+    assert "first counterexamples" in out
+    # the first counterexample is n=0 (output 1, expression value 0)
+    assert "input='0' output='1' expression_value=0" in out
+    assert out.count("input=") == 5
+
+
+def test_tool_schemas_are_valid():
+    from tools import load_all_tools
+    for tool in load_all_tools(logging=lambda *_: None):
+        info = tool['info']
+        schema = info['input_schema']
+        assert schema['type'] == 'object'
+        assert isinstance(schema['properties'], dict)
+        assert set(schema['required']) <= set(schema['properties'])
+        for name, prop in schema['properties'].items():
+            assert 'type' in prop and 'description' in prop, (tool['name'], name)
+            assert 'required' not in prop and 'properties' not in prop or prop.get('type') == 'object'
+        assert 'required' not in schema['properties']
+    names = [t['info']['name'] for t in load_all_tools(logging=lambda *_: None)]
+    assert 'formula_fit' in names
+
+
+def test_recovery_restores_snapshot_when_gate_still_fails(tmp_path, monkeypatch):
+    sol = tmp_path / 'solution.py'
+    sol.write_text("print('brute')\n")
+    a = _agent(tmp_path)
+
+    def writer(msg, hist, max_continues=2):
+        # the recovery session writes a new solution that still fails the gate
+        sol.write_text("print('new but slow')\n")
+        return []
+
+    monkeypatch.setattr(a, '_chat_continue', writer)
+    monkeypatch.setattr(a, '_perf_gate', lambda: (False, 'still slow'))
+    ok, _ = a._recover_efficiency('task', str(sol), 'gate failed')
+    assert not ok
+    assert sol.read_text() == "print('brute')\n"
+
+
+def test_chat_continue_continues_same_history(tmp_path, monkeypatch):
+    calls = []
+    empty = [{'role': 'user', 'content': 'x'}, {'role': 'assistant', 'content': [{'type': 'text', 'text': ''}]}]
+    full = empty[:1] + [{'role': 'assistant', 'content': [{'type': 'text', 'text': 'done'}]}]
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls.append((msg, list(msg_history or [])))
+        return empty if len(calls) == 1 else full
+
+    monkeypatch.setattr(ca, 'chat_with_agent', fake_chat)
+    a = _agent(tmp_path)
+    out = a._chat_continue('write it', [])
+    assert len(calls) == 2
+    assert calls[1][0].startswith('continue, write files')
+    assert calls[1][1] == empty  # continued from the history returned by the first call
+    assert out == full
