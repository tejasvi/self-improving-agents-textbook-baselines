@@ -0,0 +1,91 @@
+import os
+import signal
+import subprocess
+
+TAIL_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_suite",
+        "description": """Run the test suite in a tests directory against a candidate solution and report the raw output.
+
+* Executes `bash run_tests.sh <solution_path>` with the tests directory as working directory, under a hard time limit (the whole process group is killed on timeout).
+* Returns the tail of stdout and stderr and the exit code. Output is NOT parsed: read the raw PASS/FAIL lines and failing-case details yourself.
+* Exit code 0 normally means all cases passed, but trust the printed PASS/FAIL lines.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate solution file to test (e.g. /work/repo/solution.py).",
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Directory containing run_tests.sh (e.g. /work/tests).",
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard time limit in seconds for the whole suite (default 300, max 900).",
+                },
+            },
+            "required": ["solution_path", "tests_dir"],
+        },
+    }
+
+
+def _tail(s, n=TAIL_CHARS):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return f"<{len(s) - n} earlier chars clipped>...\n" + s[-n:]
+
+
+def run_suite_raw(solution_path, tests_dir, timeout=300):
+    """Run run_tests.sh and return (returncode, full_stdout, full_stderr, timed_out).
+
+    Used by the orchestrator for scoring; the agent-facing tool wraps this without parsing.
+    """
+    try:
+        timeout = max(1, min(int(timeout or 300), 900))
+    except (TypeError, ValueError):
+        timeout = 300
+    script = os.path.join(tests_dir, "run_tests.sh")
+    if not os.path.isfile(script):
+        return 127, "", f"run_tests.sh not found in {tests_dir}", False
+    p = subprocess.Popen(
+        ["bash", script, os.path.abspath(solution_path)],
+        cwd=tests_dir,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        errors="replace",
+        start_new_session=True,
+    )
+    try:
+        out, err = p.communicate(timeout=timeout)
+        return p.returncode, out or "", err or "", False
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(p.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        out, err = p.communicate()
+        return (p.returncode if p.returncode is not None else -9), out or "", err or "", True
+
+
+def tool_function(solution_path, tests_dir, timeout=300):
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isdir(tests_dir):
+        return f"Error: tests directory not found: {tests_dir}"
+    rc, out, err, timed_out = run_suite_raw(solution_path, tests_dir, timeout)
+    lines = [f"exit code: {rc}"]
+    if timed_out:
+        lines.append(f"Error: suite timed out after {timeout} seconds and was killed.")
+    lines.append("STDOUT (tail):")
+    lines.append(_tail(out.rstrip()) or "(empty)")
+    lines.append("STDERR (tail):")
+    lines.append(_tail(err.rstrip()) or "(empty)")
+    return "\n".join(lines)
