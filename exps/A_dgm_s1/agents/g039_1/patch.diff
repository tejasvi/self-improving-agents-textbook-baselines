+TEST_LIKE_MARKERS = ("stress_test", "stress", "test", "assert", "brute")
+
+
+def _message_texts(msg):
+    """Return the plain text fragments of a message (string content, text blocks, tool_result blocks)."""
+    texts = []
+    content = msg.get('content') if isinstance(msg, dict) else None
+    if isinstance(content, str):
+        texts.append(content)
+    elif isinstance(content, list):
+        for block in content:
+            if isinstance(block, str):
+                texts.append(block)
+            elif isinstance(block, dict):
+                if block.get('type') == 'tool_result':
+                    inner = block.get('content')
+                    if isinstance(inner, str):
+                        texts.append(inner)
+                    elif isinstance(inner, list):
+                        texts.extend(str(x.get('text', x)) if isinstance(x, dict) else str(x) for x in inner)
+                elif 'text' in block and block.get('text') is not None:
+                    texts.append(str(block.get('text')))
+    return "\n".join(texts)
+
+
+def _tool_result_text(msg):
+    """
+    Return the text of a user message that carries a tool result, or None if it is not one.
+    Handles native 'tool_result' blocks and the 'Tool Result:' text form used by the fallback path.
+    """
+    if not isinstance(msg, dict) or msg.get('role') != 'user':
+        return None
+    content = msg.get('content')
+    if isinstance(content, list) and any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content):
+        return _message_texts(msg)
+    text = _message_texts(msg)
+    if "Tool Result" in text:
+        return text
+    return None
+
+
+def _last_test_failed(msg_history):
+    """
+    True if the most recent test-like tool result in the history contains a failure marker
+    (AssertionError, Traceback, FAILED, mismatch, ...). Only user 'Tool Result' messages are scanned.
+    """
+    if not msg_history:
+        return False
+    for msg in reversed(msg_history):
+        if not isinstance(msg, dict) or msg.get('role') != 'user':
+            continue
+        text = _tool_result_text(msg)
+        if text is None:
+            continue
+        if not any(m.lower() in text.lower() for m in TEST_LIKE_MARKERS):
+            continue
+        return any(m in text for m in TEST_FAILURE_MARKERS)
+    return False
+
+
+def _last_tool_result_text(msg_history):
+    """Return the text of the most recent test-like 'Tool Result' message (or '')."""
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'user':
+            continue
+        text = _tool_result_text(msg)
+        if text is None:
+            continue
+        if any(m.lower() in text.lower() for m in TEST_LIKE_MARKERS):
+            return text
+    return ""
+
