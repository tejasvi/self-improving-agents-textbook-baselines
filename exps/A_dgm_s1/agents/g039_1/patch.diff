diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..af86928
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,155 @@
+import json
+import subprocess
+import sys
+
+# Compares a solution against a brute-force reference over many seeded random inputs.
+# All work happens in ONE fresh Python process: the solution, brute force and generator
+# modules are loaded with importlib, and raw results/tracebacks are printed verbatim.
+
+_RUNNER = r'''
+import importlib.util, json, random, sys, traceback
+
+def _load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+def _resolve(module, class_name, method_name):
+    if class_name:
+        obj = getattr(module, class_name)()
+        return getattr(obj, method_name)
+    return getattr(module, method_name)
+
+def _show(value):
+    try:
+        return json.dumps(value, default=repr)
+    except Exception:
+        return repr(value)
+
+solution_path, class_name, method_name, brute_path, generator_path, num_cases, seed = sys.argv[1:8]
+num_cases = int(num_cases)
+seed = int(seed)
+try:
+    sol_mod = _load(solution_path, "solution_under_test")
+    brute_mod = _load(brute_path, "brute_force_reference")
+    gen_mod = _load(generator_path, "input_generator")
+    solution = _resolve(sol_mod, class_name, method_name)
+    if hasattr(brute_mod, "brute"):
+        brute = brute_mod.brute
+    else:
+        brute = _resolve(brute_mod, class_name, method_name)
+    gen = gen_mod.gen
+except BaseException:
+    print("SETUP ERROR (could not load modules):\n" + traceback.format_exc())
+    sys.exit(2)
+
+rng = random.Random(seed)
+for case_idx in range(num_cases):
+    try:
+        args = list(gen(rng))
+    except BaseException:
+        print(f"GENERATOR ERROR on case {case_idx}:\n" + traceback.format_exc())
+        sys.exit(2)
+    try:
+        expected = brute(*args)
+    except BaseException:
+        print(f"BRUTE FORCE ERROR on case {case_idx} with input args={_show(args)}:\n" + traceback.format_exc())
+        sys.exit(2)
+    try:
+        actual = solution(*args)
+    except BaseException:
+        print(f"EXCEPTION in solution on case {case_idx}\nINPUT args={_show(args)}\n"
+              f"EXPECTED={_show(expected)}\nTRACEBACK:\n" + traceback.format_exc())
+        sys.exit(1)
+    if _show(actual) != _show(expected):
+        print(f"MISMATCH on case {case_idx} (case {case_idx + 1} of {num_cases})\n"
+              f"INPUT args={_show(args)}\nEXPECTED={_show(expected)}\nACTUAL={_show(actual)}")
+        sys.exit(1)
+print(f"all {num_cases} cases passed")
+'''
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference on many random inputs.\n
+* solution_path: Python file containing the solution. class_name: optional class (e.g. 'Solution'); leave empty for a module-level function.\n
+* method_name: the solution method/function to test. brute_path: Python file with a brute-force reference, exposing either a `brute(*args)` function or the same method name.\n
+* generator_path: Python file exposing `gen(rng)` where rng is a random.Random instance; it returns the list of positional arguments for one test case. Keep generated inputs small so the brute force is fast.\n
+* num_cases: how many random cases to run (default 300). timeout: total time limit in seconds (default 60).\n
+* Returns 'all N cases passed' on success. On failure returns the first failing input with the expected and actual outputs, or the raw traceback if the solution raised, or a timeout message.\n
+* Write the brute force first, then this tool; any mismatch is a real counterexample.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python file containing the solution."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Class to instantiate (e.g. 'Solution'). Empty string for a module-level function."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the solution method or function to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the Python file with the brute-force reference (a `brute(*args)` function, or the same method name)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the Python file exposing gen(rng) that returns the list of positional arguments for one random case."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random cases to run (default 300)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Total time limit in seconds for the whole run (default 60)."
+                }
+            },
+            "required": ["solution_path", "method_name", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _to_int(value, default):
+    try:
+        return int(value) if value is not None and value != "" else default
+    except Exception:
+        return default
+
+
+def tool_function(solution_path, method_name, brute_path, generator_path,
+                  class_name="", num_cases=300, timeout=60, seed=12345):
+    num_cases = _to_int(num_cases, 300)
+    timeout = _to_int(timeout, 60)
+    if num_cases <= 0:
+        return "Error: num_cases must be positive."
+    if timeout <= 0:
+        timeout = 60
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", _RUNNER, solution_path, class_name or "", method_name,
+             brute_path, generator_path, str(num_cases), str(seed)],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return f"TIMEOUT: stress test did not finish within {timeout} seconds (possibly an infinite loop or too slow).\nSTDOUT:\n{out}\nSTDERR:\n{err}"
+
+    parts = []
+    out = proc.stdout.strip()
+    err = proc.stderr.strip()
+    parts.append(f"STDOUT:\n{out}" if out else "STDOUT: (empty)")
+    if err:
+        parts.append(f"STDERR:\n{err}")
+    parts.append(f"Exit code: {proc.returncode}")
+    return "\n".join(parts)
