+def _is_empty_assistant_message(msg):
+    """
+    Return True if an assistant message carries no content: empty/whitespace text only, no tool_use blocks.
+    """
+    content = msg.get('content')
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ''
+    if isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict):
+                btype = block.get('type')
+                text = block.get('text')
+            else:
+                btype = getattr(block, 'type', None)
+                text = getattr(block, 'text', None)
+            if btype == 'tool_use':
+                return False
+            if btype != 'text':
+                return False
+            if isinstance(text, str) and text.strip() != '':
+                return False
+        return True
+    return False
+
+def _sanitize_history(msg_history):
+    """
+    Return a copy of the message history with trailing empty assistant messages removed.
+    Never returns None; an empty input yields an empty list.
+    """
+    history = list(msg_history or [])
+    for _ in range(len(history)):
+        if not history:
+            break
+        last = history[-1]
+        if isinstance(last, dict) and last.get('role') == 'assistant' and _is_empty_assistant_message(last):
+            history.pop()
+        else:
+            break
+    return history
+
+def _find_target_file(git_tempdir, problem_statement):
+    """
+    Determine the main source file to edit, returned as an absolute path under git_tempdir.
+    1. A filename mentioned in backticks in the problem statement that exists in the repo.
+    2. Otherwise the only non-test tracked source file.
+    3. Otherwise solution.py in the repo root.
+    """
+    default = os.path.abspath(os.path.join(git_tempdir, 'solution.py'))
+    for name in re.findall(r'`(\w+\.(?:py|go|rs|js|cpp|java))`', problem_statement or ''):
+        if os.path.isfile(os.path.join(git_tempdir, name)):
+            return os.path.abspath(os.path.join(git_tempdir, name))
+    try:
+        result = subprocess.run(
+            ["git", "-C", git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        tracked = result.stdout.decode(errors='replace').splitlines()
+    except Exception:
+        tracked = []
+    candidates = [
+        p for p in tracked
+        if not _is_test_path(p) and re.search(r'\.(py|go|rs|js|cpp|java)$', p)
+    ]
+    if len(candidates) == 1:
+        return os.path.abspath(os.path.join(git_tempdir, candidates[0]))
+    return default
+
