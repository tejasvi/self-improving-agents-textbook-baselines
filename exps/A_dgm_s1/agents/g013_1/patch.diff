diff --git a/tools/run_with_timeout.py b/tools/run_with_timeout.py
new file mode 100644
index 0000000..c3f5e55
--- /dev/null
+++ b/tools/run_with_timeout.py
@@ -0,0 +1,113 @@
+import os
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 5000
+DEFAULT_TIMEOUT = 20
+
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a shell command with a hard time limit and return its exit code, elapsed time, and the (last ~5000 characters of) stdout and stderr.\n
+* Use this tool for benchmarks, performance tests, and any program that may run for a long time (e.g. a solution run on max-size inputs).\n
+* The command runs in its own process group. If it exceeds `timeout` seconds, the whole group is killed and the output contains a 'TIMED OUT after N s' line with the partial output.\n
+* A timeout means the solution is too slow for the constraints and must be redesigned (better algorithm), not submitted as is.\n
+* Runs via `bash -c`, so pipes, redirections and multi-statement commands are allowed.\n
+* This tool does not keep state between calls.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python3 /tmp/bench.py'."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum wall-clock time in seconds before the command's process group is killed. Default 20."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if text is None:
+        return ""
+    if len(text) > MAX_OUTPUT_CHARS:
+        return "...<truncated>...\n" + text[-MAX_OUTPUT_CHARS:]
+    return text
+
+
+def _to_text(data):
+    if data is None:
+        return ""
+    if isinstance(data, bytes):
+        return data.decode(errors="replace")
+    return data
+
+
+def _kill_group(proc):
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError, OSError):
+        pass
+
+
+def tool_function(command, timeout=None):
+    if timeout is None:
+        timeout = DEFAULT_TIMEOUT
+    timeout = max(1, int(timeout))
+
+    start = time.time()
+    try:
+        proc = subprocess.Popen(
+            ["bash", "-c", command],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+        )
+    except Exception as e:
+        return f"Error: failed to start command: {e}"
+
+    try:
+        out, err = proc.communicate(timeout=timeout)
+        elapsed = time.time() - start
+        return (
+            f"Exit code: {proc.returncode}\n"
+            f"Elapsed: {elapsed:.2f} s\n"
+            f"STDOUT:\n{_truncate(_to_text(out))}\n"
+            f"STDERR:\n{_truncate(_to_text(err))}"
+        )
+    except subprocess.TimeoutExpired:
+        _kill_group(proc)
+        # Collect whatever was produced before the kill; bounded so we never block long.
+        try:
+            out, err = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            out, err = None, None
+            try:
+                proc.kill()
+            except OSError:
+                pass
+        elapsed = time.time() - start
+        return (
+            f"TIMED OUT after {timeout} s (elapsed {elapsed:.2f} s). The process group was killed. "
+            f"The solution is too slow for this input size: redesign the algorithm.\n"
+            f"Exit code: {proc.returncode}\n"
+            f"STDOUT (partial):\n{_truncate(_to_text(out))}\n"
+            f"STDERR (partial):\n{_truncate(_to_text(err))}"
+        )
+
+
+if __name__ == "__main__":
+    import sys
+
+    if len(sys.argv) < 2:
+        print("Usage: python run_with_timeout.py '<command>' [timeout]")
+    else:
+        cmd = sys.argv[1]
+        t = int(sys.argv[2]) if len(sys.argv) > 2 else DEFAULT_TIMEOUT
+        print(tool_function(cmd, t))
