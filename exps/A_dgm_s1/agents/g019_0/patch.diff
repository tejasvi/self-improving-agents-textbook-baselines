+def _sanitize_history(msg_history):
+    """
+    Remove empty/whitespace-only text blocks, drop messages left with no content,
+    and merge adjacent messages that share the same role.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        content = msg.get('content')
+        if isinstance(content, str):
+            if not content.strip():
+                continue
+            blocks = [{'type': 'text', 'text': content}]
+        else:
+            blocks = []
+            for block in content or []:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    text = block.get('text')
+                    if not isinstance(text, str) or not text.strip():
+                        continue
+                blocks.append(block)
+            if not blocks:
+                continue
+        new_msg = dict(msg)
+        new_msg['content'] = blocks
+        if cleaned and cleaned[-1].get('role') == new_msg.get('role'):
+            cleaned[-1] = dict(cleaned[-1])
+            cleaned[-1]['content'] = list(cleaned[-1]['content']) + blocks
+        else:
+            cleaned.append(new_msg)
+    return cleaned
