+    def _fallback_write_code(self, target):
+        """
+        Ask for the complete file in one fenced python block (no tools), extract the
+        last block with a regex, and write it to the target file directly.
+        """
+        if not target:
+            return False
+        stub = self._read_target_text(target)
+        prompt = (
+            "Write the complete solution file for the problem below.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            f"Target file: {target}\n"
+            f"Current content of the file:\n```python\n{stub}\n```\n\n"
+            "Output the entire file content as a single ```python fenced block and nothing else. "
+            "If the optimal solution is not obvious, write a simple correct baseline first. "
+            "It must be a complete, runnable implementation (no placeholders, no 'pass')."
+        )
+        try:
+            msg_history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        except Exception as e:
+            safe_log(f"_fallback_write_code: chat failed: {e}", level=logging.ERROR)
+            return False
+        text = ''
+        for msg in reversed(_sanitize_history(msg_history)):
+            if msg.get('role') != 'assistant':
+                continue
+            for block in msg.get('content', []):
+                if isinstance(block, dict) and isinstance(block.get('text'), str):
+                    text += block['text'] + '\n'
+            if text.strip():
+                break
+        matches = re.findall(r"```python\s*\n(.*?)```", text, flags=re.DOTALL)
+        if not matches:
+            safe_log("_fallback_write_code: no ```python block found", level=logging.WARNING)
+            return False
+        code = matches[-1]
+        try:
+            with open(os.path.join(self.git_tempdir, target), 'w') as f:
+                f.write(code)
+        except Exception as e:
+            safe_log(f"_fallback_write_code: write failed: {e}", level=logging.ERROR)
+            return False
+        return True
