+    def _find_target_file(self):
+        """
+        Pick the primary source file to implement: prefer a file named in the problem
+        statement, then stub-like files (tiny, or containing 'pass' / 'Write your solution here').
+        Tests, specs, conftest, READMEs and docs are skipped.
+        """
+        try:
+            out = subprocess.run(
+                ['git', 'ls-files'], cwd=self.git_tempdir,
+                capture_output=True, text=True, check=False,
+            ).stdout
+        except Exception as e:
+            safe_log(f"_find_target_file: git ls-files failed: {e}", level=logging.WARNING)
+            return None
+        files = []
+        for path in out.splitlines():
+            lower = path.lower()
+            segments = lower.split('/')
+            filename = segments[-1]
+            if any(kw in lower for kw in ('test', 'spec', 'conftest')):
+                continue
+            if filename.startswith('readme') or filename.endswith(('.md', '.rst', '.txt')):
+                continue
+            if any(seg in ('docs', 'doc') for seg in segments[:-1]):
+                continue
+            files.append(path)
+        if not files:
+            return None
+
+        # A filename explicitly mentioned in the problem statement wins.
+        for path in files:
+            name = path.split('/')[-1]
+            if name and name in (self.problem_statement or ''):
+                return path
+
+        def score(path):
+            full = os.path.join(self.git_tempdir, path)
+            try:
+                with open(full, 'r', errors='ignore') as f:
+                    text = f.read()
+            except Exception:
+                return (2, 0, path)
+            stubby = ('pass' in text.split() or 'Write your solution here' in text
+                      or 'your code here' in text.lower() or len(text.strip()) < 200)
+            return (0 if stubby else 1, len(text), path)
+
+        return sorted(files, key=score)[0]
+
