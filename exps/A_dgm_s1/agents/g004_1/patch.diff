+def _message_has_tool_use(msg):
+    content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+    if not isinstance(content, list):
+        return False
+    for block in content:
+        btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+        if btype == 'tool_use':
+            return True
+    return False
+
+def _message_text(msg):
+    content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return ''
+    parts = []
+    for block in content:
+        if isinstance(block, dict):
+            text = block.get('text')
+        else:
+            text = getattr(block, 'text', None)
+        if isinstance(text, str):
+            parts.append(text)
+    return ''.join(parts)
+
+def _last_assistant_is_empty(msg_history):
+    """
+    True if the last assistant message has no non-whitespace text and no tool_use block.
+    """
+    if not msg_history:
+        return False
+    for msg in reversed(msg_history):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role == 'assistant':
+            return (not _message_text(msg).strip()) and (not _message_has_tool_use(msg))
+    return False
+
+def _sanitize_history(msg_history):
+    """
+    Remove trailing empty assistant messages so retries do not condition on empty output.
+    Returns [] if nothing meaningful remains.
+    """
+    history = list(msg_history or [])
+    for _ in range(len(history)):
+        if not _last_assistant_is_empty(history):
+            break
+        history.pop()
+    return history
+
