+    def _find_solution_file(self):
+        """
+        Locate the solution file: solution.py, else the sole non-test .py file, else None.
+        """
+        candidates = []
+        for root, dirs, files in os.walk(self.git_tempdir):
+            dirs[:] = [d for d in dirs if d not in ('.git', '__pycache__')]
+            for name in files:
+                if name.endswith('.py'):
+                    rel = os.path.relpath(os.path.join(root, name), self.git_tempdir)
+                    candidates.append(rel)
+        for rel in candidates:
+            if os.path.basename(rel) == 'solution.py':
+                return rel
+        source = [c for c in candidates if self._is_source_path(c)]
+        if len(source) == 1:
+            return source[0]
+        return None
+
+    def _direct_fallback(self):
+        """
+        Final fallback: ask the model directly (no tools) for the full Python solution and write it.
+        """
+        prompt = (
+            f"{self.problem_statement}\n\n"
+            "Return ONLY the complete Python solution in a single ```python code block. "
+            "No explanation."
+        )
+        try:
+            client, client_model = create_client(self.code_model)
+            content, _ = get_response_from_llm(
+                prompt, client=client, model=client_model,
+                system_message="You are an expert competitive programmer.",
+                msg_history=[], temperature=0.0,
+            )
+        except Exception as e:
+            safe_log(f"[forward] direct fallback LLM call failed: {e}")
+            return False
+        match = re.search(r"```python\s*\n(.*?)```", content or '', re.DOTALL)
+        if not match:
+            safe_log("[forward] direct fallback: no ```python block in response")
+            return False
+        code = match.group(1)
+        rel = self._find_solution_file()
+        if rel is None:
+            rel = 'solution.py'
+        path = os.path.join(self.git_tempdir, rel)
+        os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
+        with open(path, 'w') as f:
+            f.write(code)
+        safe_log(f"[forward] direct fallback wrote {rel}")
+        return True
 
