diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..78f1675
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,175 @@
+import math
+import re
+import subprocess
+import sys
+from decimal import Decimal
+
+_NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+_INT_TOKEN_RE = re.compile(r'^[+-]?\d+$')
+_TIMEOUT_SECONDS = 10
+_REL_TOL = 1e-6
+_ABS_TOL = 1e-6
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a Python solution on one sample input and compare its stdout with the expected sample output, checking text format as well as numbers.\n
+* Runs `sys.executable solution_path` with `input_text` on stdin (timeout about 10 seconds).
+* Reports 'EXACT MATCH' when stripped stdout equals the stripped expected output.
+* Reports 'NUMERICALLY OK BUT TEXT DIFFERS' when every token matches numerically (tolerance 1e-6) but the text differs. In that case it lists which output formatters (repr, fixed decimals, exact Decimal expansion, integer) reproduce the expected text exactly, and suggests switching the solution's print to one of them.
+* Reports 'WRONG' otherwise, together with the raw stdout and stderr.
+* Run it once for every sample in the problem statement.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution program to run."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "The exact sample input text to feed to the solution on stdin."
+                },
+                "expected_output": {
+                    "type": "string",
+                    "description": "The exact expected sample output text from the problem statement."
+                }
+            },
+            "required": ["solution_path", "input_text", "expected_output"]
+        }
+    }
+
+
+def _run_solution(solution_path, input_text):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=_TIMEOUT_SECONDS,
+        )
+    except subprocess.TimeoutExpired as e:
+        err = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return None, '', err + f"\nTIMEOUT after {_TIMEOUT_SECONDS} seconds"
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+def _close(a, b):
+    if a == b:
+        return True
+    if math.isnan(a) or math.isnan(b):
+        return False
+    return abs(a - b) <= max(_ABS_TOL, _REL_TOL * abs(b))
+
+
+def _to_float(tok):
+    if not _NUM_RE.match(tok):
+        return None
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def _decimals_of(tok):
+    """Number of digits after the decimal point in a numeric token (0 if none)."""
+    if '.' in tok:
+        frac = tok.split('.', 1)[1]
+        m = re.match(r'^\d*', frac)
+        return len(m.group(0)) if m else 0
+    return 0
+
+
+def _formatters(value, k):
+    """Candidate renderings of a float value. k = expected number of decimals."""
+    out = {
+        'repr(float)': repr(value),
+        f'"%.{k}f"': '%.*f' % (k, value),
+        'format(Decimal(x), "f") [exact binary expansion]': format(Decimal(value), 'f'),
+    }
+    if value == value and not math.isinf(value) and float(value).is_integer():
+        out['str(int)'] = str(int(value))
+    return out
+
+
+def _format_candidates(produced_tokens, expected_tokens):
+    """
+    For each formatter name, check whether it reproduces every expected token exactly.
+    Returns list of names that reproduce all tokens.
+    """
+    if len(produced_tokens) != len(expected_tokens):
+        return []
+    names = None
+    per_token_ok = {}
+    for p_tok, e_tok in zip(produced_tokens, expected_tokens):
+        value = _to_float(p_tok)
+        if value is None:
+            return []
+        k = _decimals_of(e_tok)
+        cands = _formatters(value, k)
+        for name, text in cands.items():
+            per_token_ok.setdefault(name, True)
+            if text != e_tok:
+                per_token_ok[name] = False
+        if names is None:
+            names = set(cands.keys())
+        else:
+            names &= set(cands.keys())
+    if names is None:
+        return []
+    return [n for n in names if per_token_ok.get(n)]
+
+
+def tool_function(solution_path, input_text, expected_output):
+    rc, stdout, stderr = _run_solution(solution_path, input_text)
+    if rc is None:
+        return f"WRONG\n{stderr}".rstrip()
+    if rc != 0:
+        return f"WRONG (exit code {rc})\nstdout:\n{stdout}\nstderr:\n{stderr}"
+
+    got = stdout.strip()
+    exp = expected_output.strip()
+    if got == exp:
+        return "EXACT MATCH"
+
+    got_tokens = got.split()
+    exp_tokens = exp.split()
+    raw = f"stdout:\n{stdout}\nexpected:\n{expected_output}"
+
+    if len(got_tokens) != len(exp_tokens):
+        return f"WRONG (token count differs: got {len(got_tokens)}, expected {len(exp_tokens)})\n{raw}"
+
+    numerically_ok = True
+    for g, e in zip(got_tokens, exp_tokens):
+        if g == e:
+            continue
+        gv = _to_float(g)
+        ev = _to_float(e)
+        if gv is None or ev is None or not _close(gv, ev):
+            numerically_ok = False
+            break
+
+    if not numerically_ok:
+        return f"WRONG\n{raw}"
+
+    lines = [
+        "NUMERICALLY OK BUT TEXT DIFFERS",
+        raw,
+        "Expected tokens and their decimal counts:",
+    ]
+    for e in exp_tokens:
+        lines.append(f"  {e!r}: decimals={_decimals_of(e)}, has_decimal_point={'.' in e}, integral_form={bool(_INT_TOKEN_RE.match(e))}")
+
+    matches = _format_candidates(got_tokens, exp_tokens)
+    if matches:
+        lines.append("Formatters that reproduce the expected text exactly:")
+        for name in sorted(matches):
+            lines.append(f"  - {name}")
+        lines.append(f"HINT: switch the solution's print to the formatter '{sorted(matches)[0]}' "
+                     "(the expected sample text must be matched exactly, not just numerically).")
+    else:
+        lines.append("No tested formatter reproduces the expected text exactly. "
+                     "Only accept this difference if the expected text cannot be reproduced by any reasonable formatter.")
+    return "\n".join(lines)
