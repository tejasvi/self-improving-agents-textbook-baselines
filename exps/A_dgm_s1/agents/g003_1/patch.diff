+    # Substrings (lowercased) that mark a changed file as test/scratch rather than primary source.
+    NON_SOURCE_MARKERS = ('test', 'tests', 'spec', 'brute', 'gen', 'scratch', 'conftest')
+
+    def _get_changed_files(self):
+        """
+        Return the repo-relative paths changed versus base_commit, including untracked files.
+        """
+        diff_result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        untracked_result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        files = diff_result.stdout.decode(errors='replace').splitlines()
+        files += untracked_result.stdout.decode(errors='replace').splitlines()
+        # Deduplicate while preserving order
+        seen = set()
+        changed = []
+        for f in files:
+            f = f.strip()
+            if f and f not in seen:
+                seen.add(f)
+                changed.append(f)
+        return changed
+
+    def _has_source_edit(self):
+        """
+        True if at least one changed file is not test/scratch-like and not under /tmp.
+        """
+        for path in self._get_changed_files():
+            if path.startswith('/tmp'):
+                continue
+            lowered = path.lower()
+            if any(marker in lowered for marker in self.NON_SOURCE_MARKERS):
+                continue
+            return True
+        return False
+
