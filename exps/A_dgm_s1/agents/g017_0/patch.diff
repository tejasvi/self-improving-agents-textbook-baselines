+def _read_target(git_tempdir, target):
+    """
+    Return the current text of target (relative to git_tempdir), or '' if it cannot be read.
+    """
+    if not target or target == 'the solution source file':
+        return ''
+    try:
+        with open(os.path.join(git_tempdir, target), encoding='utf-8', errors='ignore') as fh:
+            return fh.read()
+    except OSError:
+        return ''
+
+_TYPING_NAMES = ['List', 'Optional', 'Dict', 'Tuple', 'Set']
+
+def _ensure_typing_imports(path):
+    """
+    If the file at path uses List[/Optional[/Dict[/Tuple[/Set[ without importing them from typing,
+    prepend a 'from typing import ...' line. Returns True if the file was modified.
+    """
+    try:
+        with open(path, encoding='utf-8') as fh:
+            text = fh.read()
+    except OSError as e:
+        safe_log(f"_ensure_typing_imports failed to read {path}: {e!r}")
+        return False
+    missing = []
+    for name in _TYPING_NAMES:
+        if not re.search(r'\b' + name + r'\[', text):
+            continue
+        already = False
+        for m in re.finditer(r'^\s*from\s+typing\s+import\s+(.*)$', text, re.M):
+            names = [n.strip().split(' as ')[0].strip() for n in m.group(1).split(',')]
+            if name in names or '*' in names or '(' in m.group(1):
+                already = True
+        if not already:
+            missing.append(name)
+    if not missing:
+        return False
+    line = f"from typing import {', '.join(missing)}\n"
+    try:
+        with open(path, 'w', encoding='utf-8') as fh:
+            fh.write(line + text)
+    except OSError as e:
+        safe_log(f"_ensure_typing_imports failed to write {path}: {e!r}")
+        return False
+    safe_log(f"Prepended '{line.strip()}' to {path}.")
+    return True
+
