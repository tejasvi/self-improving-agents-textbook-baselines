+def _block_is_empty(block):
+    """
+    Return True if a content block carries no meaningful text (empty text block).
+    Handles both dict blocks and SDK block objects.
+    """
+    if isinstance(block, dict):
+        btype = block.get('type')
+        text = block.get('text')
+    else:
+        btype = getattr(block, 'type', None)
+        text = getattr(block, 'text', None)
+    if btype == 'text':
+        return not (text and str(text).strip())
+    return False
+
+def _sanitize_history(msg_history):
+    """
+    Return a copy of msg_history without messages whose content is empty or only has empty text blocks.
+    Trailing assistant messages are dropped so that the history ends with a user message.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            if not content.strip():
+                continue
+            new_msg = dict(msg)
+        elif isinstance(content, list):
+            kept = [b for b in content if not _block_is_empty(b)]
+            if not kept:
+                continue
+            new_msg = dict(msg)
+            new_msg['content'] = kept
+        else:
+            if content is None:
+                continue
+            new_msg = dict(msg)
+        cleaned.append(new_msg)
+    while cleaned and cleaned[-1].get('role') != 'user':
+        cleaned.pop()
+    return cleaned
+
+def _read_file_safely(path):
+    try:
+        with open(path, 'r', encoding='utf-8', errors='replace') as f:
+            return f.read()
+    except OSError:
+        return None
+
+def _find_target_files(git_tempdir, max_files=3):
     """
-    return any(not _is_test_path(p) for p in _changed_files(diff))
+    Return a list of (relative_path, content) for candidate source files in the repo:
+    tracked, non-test, non-doc source files. Files named solution.py or containing `class Solution` come first.
+    """
+    result = subprocess.run(
+        ["git", "-C", git_tempdir, "ls-files"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    candidates = []
+    for path in result.stdout.decode(errors='replace').splitlines():
+        if path.startswith('.git') or _is_test_path(path) or _is_doc_path(path):
+            continue
+        if not path.endswith(SOURCE_EXTS):
+            continue
+        candidates.append(path)
+
+    scored = []
+    for idx, path in enumerate(candidates):
+        full = os.path.join(git_tempdir, path)
+        content = _read_file_safely(full)
+        if content is None:
+            continue
+        if os.path.basename(path) == 'solution.py':
+            score = 0
+        elif 'class Solution' in content:
+            score = 1
+        else:
+            score = 2
+        scored.append((score, -idx, path, content))
+    scored.sort()
+    return [(path, content) for _, _, path, content in scored[:max_files]]
+
+def _extract_code_block(text):
+    """
+    Return the last fenced code block in text, or None.
+    """
+    blocks = re.findall(r'```[a-zA-Z0-9_+-]*\n(.*?)```', text or '', re.DOTALL)
+    return blocks[-1] if blocks else None
+
+def _last_assistant_text(msg_history):
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        for b in content or []:
+            text = b.get('text') if isinstance(b, dict) else getattr(b, 'text', None)
+            if text:
+                return text
+    return ''
 
