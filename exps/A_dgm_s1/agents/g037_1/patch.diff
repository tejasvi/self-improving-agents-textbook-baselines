+DOC_EXTS = ('.md', '.txt', '.rst')
+SOURCE_EXTS = ('.py', '.go', '.rs', '.js', '.cpp', '.cc', '.h', '.hpp', '.java', '.ts')
+
+def _is_doc_path(path):
+    """
+    Return True if the path is a documentation file (README, markdown, text, rst).
+    """
+    norm = path.replace('\\', '/').lower()
+    return norm.endswith(DOC_EXTS) or norm.split('/')[-1].startswith('readme')
