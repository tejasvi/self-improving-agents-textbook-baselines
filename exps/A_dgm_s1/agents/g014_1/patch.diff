+def _sanitize_history(msg_history):
+    """
+    Return a copy of msg_history without assistant messages whose text is empty or
+    whitespace-only and that contain no tool_use blocks. Handles string and list-of-block content.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            content = msg.get('content')
+            if isinstance(content, str):
+                if not content.strip():
+                    continue
+            elif isinstance(content, list):
+                has_tool_use = any(
+                    isinstance(b, dict) and b.get('type') == 'tool_use' for b in content
+                )
+                if not has_tool_use:
+                    text = "\n".join(
+                        b['text'] for b in content
+                        if isinstance(b, dict) and b.get('type') == 'text' and isinstance(b.get('text'), str)
+                    )
+                    if not text.strip():
+                        continue
+        cleaned.append(msg)
+    return cleaned
+
+def _guess_target_file(git_tempdir):
+    """
+    Guess the file the agent should edit using `git ls-files`.
+    Prefers solution.py, then a non-test .py file containing 'class Solution' or a stub 'pass',
+    then the first non-test .py file. Returns None if nothing is found.
+    """
+    try:
+        result = subprocess.run(
+            ["git", "-C", git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        files = result.stdout.decode().splitlines()
+    except Exception as e:
+        safe_log(f"_guess_target_file failed: {e}")
+        return None
+    py_files = [f for f in files if f.endswith('.py') and not _is_test_path(f)]
+    if not py_files:
+        return None
+    for f in py_files:
+        if f.split('/')[-1] == 'solution.py':
+            return f
+    for f in py_files:
+        try:
+            with open(os.path.join(git_tempdir, f), encoding='utf-8', errors='ignore') as fh:
+                text = fh.read()
+        except OSError:
+            continue
+        if 'class Solution' in text or re.search(r'^\s*pass\s*$', text, re.M):
+            return f
+    return py_files[0]
+
+def _fallback_extract_code(text):
+    """
+    Return the content of the last fenced ```python block in text, or None.
+    """
+    blocks = re.findall(r'```python[^\n]*\n(.*?)```', text or '', re.S)
+    return blocks[-1] if blocks else None
