+    def _changed_files(self):
+        """
+        Return repo-relative paths changed versus the base commit, including untracked files.
+        """
+        cmd = ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"]
+        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        if result.returncode != 0:
+            safe_log(f"git status failed: {result.stderr.decode(errors='replace')}")
+            return []
+        paths = []
+        # Also include files changed in commits made by the agent since base_commit.
+        committed = subprocess.run(["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        if committed.returncode == 0:
+            paths.extend(l.strip() for l in committed.stdout.decode(errors='replace').splitlines() if l.strip())
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            if ' -> ' in path:  # rename: keep the new path
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                paths.append(path)
+        return sorted(set(paths))
+
+    def _has_source_edit(self):
+        """
+        True if at least one changed file is a non-test path.
+        """
+        return any(not _is_test_path(p) for p in self._changed_files())
+
+    def _find_target_hint(self):
+        """
+        Guess the file the agent should write its solution to, using the repo's top level only.
+        """
+        try:
+            entries = sorted(os.listdir(self.git_tempdir))
+        except OSError:
+            return "solution.py (or the main file the problem's entry point requires)"
+        placeholders = []
+        named = []
+        for name in entries:
+            if name == '.git':
+                continue
+            full = os.path.join(self.git_tempdir, name)
+            if not os.path.isfile(full):
+                continue
+            if name in ('solution.py', 'main.py'):
+                named.append(name)
+            try:
+                if os.path.getsize(full) <= 4096:
+                    with open(full, 'r', errors='replace') as f:
+                        content = f.read().lower()
+                    if any(m in content for m in PLACEHOLDER_MARKERS):
+                        placeholders.append(name)
+            except OSError:
+                continue
+        if placeholders:
+            return ", ".join(placeholders) + " (contains placeholder text)"
+        if named:
+            return ", ".join(named)
+        return "the main source file required by the problem's entry point"
+
