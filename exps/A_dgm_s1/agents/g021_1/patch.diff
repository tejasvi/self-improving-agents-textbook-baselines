+def _is_test_path(path):
+    """
+    Return True if a repo-relative path looks like a test file: it contains 'test',
+    'spec' or 'conftest' (case-insensitive), or its filename starts with 'test_'.
+    """
+    norm = path.replace('\\', '/').lower()
+    name = norm.rsplit('/', 1)[-1]
+    if name.startswith('test_'):
+        return True
+    return 'test' in norm or 'spec' in norm or 'conftest' in norm
