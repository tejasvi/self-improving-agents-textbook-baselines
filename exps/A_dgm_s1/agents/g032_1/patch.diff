+    def _changed_paths(self):
+        """
+        Return the set of paths changed versus base_commit, including untracked files.
+        Uses NUL-separated git output so quoted or unusual names (spaces, unicode) are kept intact.
+        """
+        paths = set()
+        for cmd in (
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", "-z", self.base_commit],
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard", "-z"],
+        ):
+            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            for raw in result.stdout.decode(errors="replace").split("\0"):
+                if raw:
+                    paths.add(raw)
+        return paths
+
+    def _meaningful_patch(self):
+        """
+        Return True if the repo has any change versus base_commit that touches at least one
+        file that is not test-like or scratch-like.
+        """
+        # Match whole name tokens (e.g. 'gen.py', 'test_x.py', 'brute_force.py') so that
+        # names like 'coding_agent.py' are not misclassified by a substring match on 'gen'.
+        test_token = re.compile(r'(^|[_.\-])(tests?|specs?|brute|gen|scratch)([_.\-]|$)', re.IGNORECASE)
+        test_dir = re.compile(r'(^|/)tests?/')
+        changed = self._changed_paths()
+        for path in changed:
+            if test_dir.search(path):
+                continue
+            basename = path.rsplit('/', 1)[-1]
+            if not test_token.search(basename):
+                return True
+        return False
+
