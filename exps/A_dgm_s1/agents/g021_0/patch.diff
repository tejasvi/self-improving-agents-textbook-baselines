+    @staticmethod
+    def _is_non_source_path(path):
+        """True for test/spec/conftest/docs/README/markdown-like files."""
+        lower = path.lower()
+        segments = lower.split('/')
+        filename = segments[-1]
+        for kw in ('test', 'spec', 'conftest'):
+            if kw in lower:
+                return True
+        if filename.startswith('readme') or filename.endswith(('.md', '.rst', '.txt')):
+            return True
+        if any(seg in ('docs', 'doc') for seg in segments[:-1]):
+            return True
+        return False
+
+    def _find_target_files(self, max_files=50, max_bytes=200 * 1024):
+        """
+        List git-tracked, non-test source files in git_tempdir and rank them.
+        Files with placeholder text (stubs), preferred names, and small files rank first.
+        Returns a list of (path, content) tuples, best candidate first.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        paths = result.stdout.decode(errors='replace').splitlines()
+        placeholder_re = re.compile(r"Write your solution here|TODO|\bpass\b", re.IGNORECASE)
+        preferred_names = ('solution.py', 'main.py', 'solve.py', 'answer.py')
+        candidates = []
+        for path in paths[:20000]:  # bounded scan over tracked files; each read is size-capped
+            if not path or self._is_non_source_path(path):
+                continue
+            full = os.path.join(self.git_tempdir, path)
+            try:
+                if not os.path.isfile(full) or os.path.getsize(full) > max_bytes:
+                    continue
+                with open(full, 'r', encoding='utf-8') as f:
+                    content = f.read()
+            except (OSError, UnicodeDecodeError):
+                continue
+            is_placeholder = bool(placeholder_re.search(content))
+            is_preferred = os.path.basename(path).lower() in preferred_names
+            key = (0 if is_placeholder else 1, 0 if is_preferred else 1, len(content))
+            candidates.append((key, path, content))
+        candidates.sort(key=lambda c: c[0])
+        return [(path, content) for _, path, content in candidates[:max_files]]
+
+    @staticmethod
+    def _is_empty_content(content):
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return content.strip() == ''
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict):
+                    btype = block.get('type')
+                    text = block.get('text')
+                else:
+                    btype = getattr(block, 'type', None)
+                    text = getattr(block, 'text', None)
+                if btype == 'text':
+                    if text is not None and str(text).strip():
+                        return False
+                else:
+                    return False  # tool_use or other non-text block is real content
+            return True
+        return False
+
+    def _sanitize_history(self, msg_history):
+        """
+        Return a copy of msg_history without trailing assistant messages whose content
+        is empty or whitespace-only text, so that a follow-up is not conditioned on an
+        empty reply. Non-empty messages (including tool results) are never removed.
+        """
+        history = list(msg_history or [])
+        for _ in range(len(history)):
+            if not history:
+                break
+            last = history[-1]
+            if last.get('role') == 'assistant' and self._is_empty_content(last.get('content')):
+                history.pop()
+            else:
+                break
+        return history
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        for m in reversed(msg_history or []):
+            if m.get('role') != 'assistant':
+                continue
+            content = m.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                parts = []
+                for block in content:
+                    if isinstance(block, dict):
+                        text = block.get('text')
+                    else:
+                        text = getattr(block, 'text', None)
+                    if text:
+                        parts.append(str(text))
+                return "\n".join(parts)
+            return ""
+        return ""
