+    def _patch_status(self):
+        """
+        Classify the current diff against base_commit.
+        Returns 'empty' (no changes), 'tests_only' (only test/spec/conftest/docs files changed),
+        or 'ok' (at least one non-test source file changed).
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                parts = line.split(' ')
+                if len(parts) >= 4:
+                    path = parts[2]
+                    if path.startswith('a/'):
+                        path = path[2:]
+                    files.append(path)
+        if not files:
+            return 'empty'
+
+        def is_non_source(path):
+            lower = path.lower()
+            segments = lower.split('/')
+            filename = segments[-1]
+            for kw in ('test', 'spec', 'conftest'):
+                if kw in lower:
+                    return True
+            if filename.startswith('readme') or filename.endswith(('.md', '.rst', '.txt')):
+                return True
+            if any(seg in ('docs', 'doc') for seg in segments[:-1]):
+                return True
+            return False
+
+        if all(is_non_source(f) for f in files):
+            return 'tests_only'
+        return 'ok'
+
