diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..544de26
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,109 @@
+import re
+import subprocess
+import sys
+import time
+
+# Extracts 'Sample Input k' / 'Sample Output k' pairs from a problem statement and runs
+# the solution file as a fresh Python subprocess on each sample.
+
+_SAMPLE_RE = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n\s*Explanation|\Z)',
+    re.DOTALL,
+)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Extract all 'Sample Input k' / 'Sample Output k' pairs from the problem statement and run the solution file on each sample.\n
+* Runs `python solution_path` as a fresh subprocess with each sample input on stdin, with a timeout.\n
+* For each sample reports PASS or FAIL, the exact stdout, stderr, the expected output and the elapsed time.\n
+* If outputs differ, the result is marked FAIL with a note that alternate valid answers may exist; check the logic before assuming the solution is wrong.\n
+* Use this after writing or changing the solution to verify it against the examples in the problem statement.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file (a complete program reading stdin)."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the 'Sample Input k' and 'Sample Output k' blocks."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each sample run (default 10)."
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+
+def _norm(text):
+    return [line.rstrip() for line in (text or '').strip().splitlines()]
+
+
+def _extract_samples(problem_statement):
+    samples = []
+    for m in _SAMPLE_RE.finditer(problem_statement or ''):
+        samples.append((m.group(1), m.group(2).strip('\n') + '\n', m.group(3).strip()))
+    return samples
+
+
+def tool_function(solution_path, problem_statement, timeout=10):
+    try:
+        timeout = int(timeout) if timeout else 10
+    except Exception:
+        timeout = 10
+    samples = _extract_samples(problem_statement)
+    if not samples:
+        return ("No 'Sample Input k' / 'Sample Output k' pairs found in the problem statement. "
+                "Write your own small test inputs and check the outputs by hand.")
+
+    parts = []
+    passed = 0
+    for idx, sample_in, expected in samples:
+        start = time.time()
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=sample_in,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            elapsed = time.time() - start
+            stdout = proc.stdout
+            stderr = proc.stderr.strip()
+            ok = _norm(stdout) == _norm(expected) and proc.returncode == 0
+            if ok:
+                passed += 1
+                status = "PASS"
+            else:
+                status = "FAIL"
+                if proc.returncode != 0:
+                    status += f" (exit code {proc.returncode})"
+                elif _norm(stdout) != _norm(expected):
+                    status += " (outputs differ; alternate valid answers possible, verify the logic)"
+            parts.append(
+                f"Sample {idx}: {status}\n"
+                f"  elapsed: {elapsed:.3f}s\n"
+                f"  input:\n{sample_in}"
+                f"  actual stdout:\n{stdout.rstrip()}\n"
+                f"  expected output:\n{expected}\n"
+                f"  stderr:\n{stderr if stderr else '(empty)'}"
+            )
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+            parts.append(
+                f"Sample {idx}: FAIL (TIMEOUT after {timeout}s)\n"
+                f"  partial stdout:\n{out}\n"
+                f"  expected output:\n{expected}"
+            )
+        except Exception as e:
+            parts.append(f"Sample {idx}: FAIL (could not run: {e})")
+
+    summary = f"{passed}/{len(samples)} samples passed."
+    return summary + "\n\n" + "\n\n".join(parts)
diff --git a/tools/stress_run.py b/tools/stress_run.py
new file mode 100644
index 0000000..610730c
--- /dev/null
+++ b/tools/stress_run.py
@@ -0,0 +1,81 @@
+import subprocess
+import sys
+import time
+
+# Generates a large stdin with a Python snippet and times the solution on it.
+
+
+def tool_info():
+    return {
+        "name": "stress_run",
+        "description": """Time the solution on a large generated input.\n
+* input_generator_code is a Python snippet run in a fresh process; it must write the complete stdin for the solution to stdout (e.g. using print or sys.stdout.write). Build a max-size input from the problem's constraints.\n
+* The solution file is then run as `python solution_path` with that generated input on stdin, under a timeout.\n
+* Reports the elapsed time and the first lines of output, or TIMEOUT if the time limit is exceeded.\n
+* Use this to check that the solution fits the time limit on worst-case inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file (a complete program reading stdin)."
+                },
+                "input_generator_code": {
+                    "type": "string",
+                    "description": "Python code that prints the max-size test input to stdout, e.g. 'import random\\nn=10**6\\nprint(n)\\nprint(*[random.randint(1,10**9) for _ in range(n)])'."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the solution run (default 10)."
+                }
+            },
+            "required": ["solution_path", "input_generator_code"]
+        }
+    }
+
+
+def tool_function(solution_path, input_generator_code, timeout=10):
+    try:
+        timeout = int(timeout) if timeout else 10
+    except Exception:
+        timeout = 10
+    try:
+        gen = subprocess.run(
+            [sys.executable, "-c", input_generator_code],
+            capture_output=True,
+            text=True,
+            timeout=max(timeout, 30),
+        )
+    except subprocess.TimeoutExpired:
+        return "Error: input generator timed out."
+    if gen.returncode != 0:
+        return f"Error: input generator failed (exit code {gen.returncode}):\n{gen.stderr.strip()}"
+    data = gen.stdout
+    size_note = f"Generated input: {len(data)} characters, {data.count(chr(10))} lines."
+
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=data,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        return (f"{size_note}\nTIMEOUT: solution did not finish within {timeout}s. "
+                f"The algorithm is likely too slow for max constraints; use a more efficient algorithm.\n"
+                f"Partial stdout:\n{out[:500]}")
+    elapsed = time.time() - start
+    out_lines = proc.stdout.splitlines()
+    preview = "\n".join(out_lines[:10])
+    if len(out_lines) > 10:
+        preview += f"\n... ({len(out_lines) - 10} more lines)"
+    stderr = proc.stderr.strip()
+    return (
+        f"{size_note}\n"
+        f"Elapsed: {elapsed:.3f}s (limit {timeout}s), exit code {proc.returncode}\n"
+        f"STDOUT preview:\n{preview if preview else '(empty)'}\n"
+        f"STDERR:\n{stderr[-2000:] if stderr else '(empty)'}"
+    )
