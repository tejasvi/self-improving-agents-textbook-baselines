+def _block_text(block):
+    """
+    Return the text of a content block (dict or SDK object), or '' if it has none.
+    """
+    if isinstance(block, dict):
+        if block.get("type") != "text":
+            return ""
+        text = block.get("text")
+    else:
+        if getattr(block, "type", None) != "text":
+            return ""
+        text = getattr(block, "text", None)
+    return text if isinstance(text, str) else ""
+
+
+def _message_text(msg):
+    """
+    Return the concatenated text of a message's content (string or list of blocks).
+    """
+    content = msg.get("content") if isinstance(msg, dict) else None
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "".join(_block_text(b) for b in content)
+    return ""
+
+
+def _is_empty_assistant_turn(msg):
+    """
+    Return True if msg is an assistant turn with no tool calls and only empty/whitespace text.
+    """
+    if not isinstance(msg, dict) or msg.get("role") != "assistant":
+        return False
+    content = msg.get("content")
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ""
+    if isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict):
+                btype = block.get("type")
+            else:
+                btype = getattr(block, "type", None)
+            if btype != "text":
+                return False  # e.g. tool_use blocks: a real turn
+        return _message_text(msg).strip() == ""
+    return False
+
+
+def _strip_empty_assistant_turns(msg_history):
+    """
+    Return a copy of msg_history with trailing empty assistant turns removed.
+    """
+    history = list(msg_history or [])
+    for _ in range(len(history)):
+        if history and _is_empty_assistant_turn(history[-1]):
+            history.pop()
+        else:
+            break
+    return history
+
+
+def _extract_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message that has non-empty text, or ''.
+    """
+    for msg in reversed(list(msg_history or [])):
+        if isinstance(msg, dict) and msg.get("role") == "assistant":
+            text = _message_text(msg)
+            if text.strip():
+                return text
+    return ""
+
+
+CODE_BLOCK_RE = re.compile(r"```[ \t]*(?:python|py)?[ \t]*\n(.*?)```", re.DOTALL)
+
+
+def _extract_last_code_block(text):
+    """
+    Return the content of the last fenced code block in text, or None.
+    """
+    matches = CODE_BLOCK_RE.findall(text or "")
+    if not matches:
+        return None
+    code = matches[-1]
+    return code if code.strip() else None
+
