index 0000000..f692342
--- /dev/null
+++ b/tools/portability_check.py
@@ -0,0 +1,189 @@
+import ast
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+CANDIDATE_INTERPRETERS = [
+    'python3', 'python', 'pypy3', 'python3.8', 'python3.9',
+    'python3.10', 'python3.11', 'python3.12',
+]
+
+NON_STDLIB_MODULES = {'numpy', 'scipy', 'sortedcontainers'}
+
+_RISKY_PATTERNS = [
+    (re.compile(r'\bmath\s*\.\s*lcm\b'), 'math.lcm (Python 3.9+)'),
+    (re.compile(r':='), 'walrus operator (Python 3.8+)'),
+    (re.compile(r'^\s*match\s+.+:\s*$', re.MULTILINE), 'match statement (Python 3.10+)'),
+    (re.compile(r'\bfunctools\s*\.\s*cache\b'), 'functools.cache (Python 3.9+)'),
+    (re.compile(r'@\s*cache\b'), 'cache decorator (possibly functools.cache, Python 3.9+)'),
+]
+
+
+def tool_info():
+    return {
+        "name": "portability_check",
+        "description": """Checks a Python solution for environment-specific failures.\n
+* Copies the solution to a temporary directory as `_sol.py` and runs it with `-I` (isolated mode) from a different working directory, feeding `sample_input` on stdin.\n
+* Runs the same program on every other Python interpreter found on PATH (python3, python, pypy3, python3.8 .. python3.12), reporting return code, stdout and raw stderr for each.\n
+* Scans the source for risky constructs: 3-argument pow, math.lcm, walrus operator, match statements, functools.cache, and non-stdlib imports (numpy, scipy, sortedcontainers).\n
+* Also checks that the sample output ends with a newline and contains no obvious debug prints.\n
+* Returns raw output as plain text; interpret the results yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to check."
+                },
+                "sample_input": {
+                    "type": "string",
+                    "description": "Sample input to feed on stdin. Optional; defaults to empty input."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _run(cmd, cwd, stdin_text, timeout):
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            cmd, cwd=cwd, input=stdin_text, capture_output=True, text=True, timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, time.time() - start
+    except subprocess.TimeoutExpired as e:
+        err = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return None, '', err + f"\nTIMEOUT after {timeout} seconds", time.time() - start
+    except OSError as e:
+        return None, '', f"Failed to launch: {e}", 0.0
+
+
+def _interpreter_version(path):
+    try:
+        proc = subprocess.run([path, '-c', 'import sys; print(sys.version.split()[0])'],
+                              capture_output=True, text=True, timeout=20)
+        return proc.stdout.strip() or proc.stderr.strip()
+    except Exception as e:
+        return f"unknown ({e})"
+
+
+def _discover_interpreters():
+    """Return a list of distinct real interpreter paths found on PATH."""
+    found = []
+    seen_real = set()
+    for name in CANDIDATE_INTERPRETERS:
+        path = shutil.which(name)
+        if not path:
+            continue
+        real = os.path.realpath(path)
+        if real in seen_real:
+            continue
+        seen_real.add(real)
+        found.append(path)
+    return found
+
+
+def _static_scan(source):
+    findings = []
+    for pattern, label in _RISKY_PATTERNS:
+        if pattern.search(source):
+            findings.append(f"risky construct: {label}")
+
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        findings.append(f"syntax error at line {e.lineno}: {e.msg}")
+        return findings
+
+    stdlib = getattr(sys, 'stdlib_module_names', None)
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            func = node.func
+            if isinstance(func, ast.Name) and func.id == 'pow' and len(node.args) == 3:
+                findings.append(f"risky construct: 3-argument pow at line {node.lineno}")
+            if isinstance(func, ast.Attribute) and func.attr == 'lcm':
+                if isinstance(func.value, ast.Name) and func.value.id == 'math':
+                    findings.append(f"risky construct: math.lcm at line {node.lineno}")
+        if isinstance(node, ast.Import):
+            names = [a.name for a in node.names]
+        elif isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
+            names = [node.module]
+        else:
+            continue
+        for name in names:
+            top = name.split('.')[0]
+            if top in NON_STDLIB_MODULES:
+                findings.append(f"non-stdlib import: {name} at line {node.lineno}")
+            elif stdlib is not None and top not in stdlib:
+                findings.append(f"possibly non-stdlib import: {name} at line {node.lineno}")
+    return findings
+
+
+def _output_checks(stdout):
+    notes = []
+    if stdout and not stdout.endswith('\n'):
+        notes.append("sample output does not end with a newline")
+    for line in stdout.splitlines():
+        s = line.strip()
+        if s.startswith('DEBUG') or s.startswith('debug:') or s.startswith('print(debug'):
+            notes.append(f"possible debug print in output: {line!r}")
+            break
+    return notes
+
+
+def tool_function(solution_path, sample_input='', timeout_seconds=10):
+    timeout_seconds = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    sample_input = sample_input or ''
+
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    with open(solution_path, 'r') as f:
+        source = f.read()
+
+    sections = []
+    tmpdir = tempfile.mkdtemp(prefix='portability_')
+    try:
+        sol_copy = os.path.join(tmpdir, '_sol.py')
+        shutil.copyfile(solution_path, sol_copy)
+        run_cwd = tempfile.mkdtemp(prefix='portability_cwd_', dir=tmpdir)
+
+        # Static scan
+        findings = _static_scan(source)
+        sections.append("== Static scan ==")
+        sections.extend(findings if findings else ["no risky constructs found"])
+
+        # Run under sys.executable
+        interpreters = [sys.executable] + [p for p in _discover_interpreters()
+                                           if os.path.realpath(p) != os.path.realpath(sys.executable)]
+        overall_notes = []
+        for idx, interp in enumerate(interpreters):
+            version = _interpreter_version(interp)
+            label = "current interpreter (sys.executable)" if idx == 0 else "interpreter on PATH"
+            code, out, err, elapsed = _run([interp, '-I', sol_copy], run_cwd, sample_input, timeout_seconds)
+            sections.append(f"== Run: {label} ==")
+            sections.append(f"path: {interp}")
+            sections.append(f"version: {version}")
+            sections.append(f"return code: {code}")
+            sections.append(f"elapsed: {elapsed:.3f}s")
+            sections.append("stdout:")
+            sections.append(out.rstrip('\n') if out else "(empty)")
+            sections.append("stderr:")
+            sections.append(err.rstrip('\n') if err else "(empty)")
+            if code == 0:
+                for note in _output_checks(out):
+                    overall_notes.append(f"[{interp}] {note}")
+        sections.append("== Output checks ==")
+        sections.extend(overall_notes if overall_notes else ["no output issues found"])
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    return "\n".join(sections)
