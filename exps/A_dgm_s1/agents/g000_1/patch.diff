+def _changed_files(diff_str):
+    """
+    Return the list of file paths touched by a git diff string, parsed from
+    'diff --git a/X b/X' header lines.
+    """
+    files = []
+    for line in (diff_str or '').splitlines():
+        if line.startswith('diff --git '):
+            parts = line.split(' ')
+            # Format: diff --git a/<path> b/<path>
+            if len(parts) >= 4 and parts[2].startswith('a/'):
+                path = parts[2][2:]
+                if path not in files:
+                    files.append(path)
+    return files
+
+def _is_test_path(path):
+    """
+    Return True if the path looks like a test file or lives in a test directory.
+    """
+    norm = path.replace('\\', '/')
+    base = norm.split('/')[-1]
+    if re.match(r'^test_.*\.py$', base) or re.match(r'^.*_test\.py$', base):
+        return True
+    if base.endswith('_test.go') or base.endswith('.spec.js'):
+        return True
+    if re.search(r'(^|/)tests?/', norm):
+        return True
+    return False
+
+def _has_source_edit(diff):
+    """
+    Return True if at least one changed file in the diff is not a test file.
+    """
+    return any(not _is_test_path(p) for p in _changed_files(diff))
+
