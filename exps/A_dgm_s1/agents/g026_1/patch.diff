+def _is_empty_reply(msg_history):
+    """
+    Return True when the last assistant message has no non-whitespace text and no tool_use block.
+    """
+    if _last_assistant_text(msg_history).strip():
+        return False
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            content = msg.get('content')
+            if isinstance(content, list):
+                for block in content:
+                    btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+                    if btype == 'tool_use':
+                        return False
+            break
+    return True
+
+def _extract_code(reply):
+    """
+    Extract Python code from a model reply. Takes the largest non-empty fenced block (fences are paired
+    line by line); otherwise accepts the whole reply if it looks like Python and parses with ast.parse.
+    Returns None if nothing usable is found.
+    """
+    text = reply or ''
+    lines = text.split('\n')
+    blocks = []
+    skip_until = -1
+    for i, line in enumerate(lines):
+        if i <= skip_until:
+            continue
+        opener = line.strip()
+        if opener.startswith('```') and opener[3:].strip() in ('', 'python', 'py'):
+            close = None
+            for j in range(i + 1, len(lines)):
+                if lines[j].strip().startswith('```'):
+                    close = j
+                    break
+            if close is not None:
+                body = '\n'.join(lines[i + 1:close]) + '\n'
+                if body.strip():
+                    blocks.append(body)
+                skip_until = close
+    if blocks:
+        return max(blocks, key=len)
+    stripped = text.strip()
+    if stripped and any(tok in stripped for tok in ('import', 'def ', 'input(', 'print(')):
+        try:
+            ast.parse(stripped)
+            return stripped
+        except SyntaxError:
+            return None
+    return None
+
