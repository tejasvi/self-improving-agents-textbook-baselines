+def _digest_history(msg_history, max_chars=6000):
+    """
+    Summarize what the earlier conversation learned: the most recent non-empty assistant text
+    blocks and the 'Tool Result:' user blocks, truncated to max_chars. Handles string and
+    list-of-block content.
+    """
+    assistant_texts = []
+    tool_results = []
+    for msg in msg_history or []:
+        if not isinstance(msg, dict):
+            continue
+        role = msg.get('role')
+        content = msg.get('content')
+        if isinstance(content, str):
+            blocks = [{'type': 'text', 'text': content}]
+        elif isinstance(content, list):
+            blocks = [b if isinstance(b, dict) else {'type': 'text', 'text': str(b)} for b in content]
+        else:
+            continue
+        for b in blocks:
+            text = b.get('text') if b.get('type') == 'text' else None
+            if not isinstance(text, str) or not text.strip():
+                continue
+            if role == 'assistant':
+                assistant_texts.append(text.strip())
+            elif role == 'user' and text.lstrip().startswith('Tool Result:'):
+                tool_results.append(text.strip())
+    recent = assistant_texts[-3:]
+    recent_results = tool_results[-3:]
+    parts = []
+    if recent:
+        parts.append("Recent agent notes:\n" + "\n---\n".join(recent))
+    if recent_results:
+        parts.append("Recent tool results:\n" + "\n---\n".join(recent_results))
+    digest = "\n\n".join(parts)
+    if len(digest) > max_chars:
+        digest = digest[:max_chars] + "\n...[truncated]"
+    return digest
+
