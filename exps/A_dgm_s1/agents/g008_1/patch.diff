diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..e8780b1
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,130 @@
+import difflib
+import os
+import subprocess
+import sys
+import time
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution program on sample test cases taken from the problem statement and compare its stdout with the expected output.\n
+* Each sample is fed to `solution_path` via stdin (Python files run with the current interpreter; other files are executed directly).\n
+* Each sample gets one status: EXACT_MATCH (actual stdout is identical to expected output), WHITESPACE_MATCH (same tokens when split on whitespace, but not exact), or MISMATCH (different tokens, non-zero exit, or timeout).\n
+* For every non-exact sample a unified diff of expected vs. actual output is shown. If the program crashed or timed out, its raw stderr is shown too.\n
+* Ends with a summary line such as '2/4 exact matches'.\n
+* Use this to check the program against every sample in the problem statement. Pass the samples exactly as given in the statement.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program to run."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Sample test cases from the problem statement.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact stdin content for this sample."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected stdout content for this sample."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each sample run. Default 10."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _command(path):
+    if path.endswith('.py'):
+        return [sys.executable, path]
+    return [path]
+
+
+def _run(cmd, stdin_text, timeout):
+    """Returns (returncode, stdout, stderr). returncode is None on timeout."""
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr
+    except subprocess.TimeoutExpired as e:
+        stdout = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+        stderr = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return None, stdout, stderr + f"\nTIMEOUT after {timeout} seconds"
+
+
+def _classify(expected, actual, returncode):
+    if returncode != 0:
+        return "MISMATCH"
+    if actual == expected:
+        return "EXACT_MATCH"
+    if actual.split() == expected.split():
+        return "WHITESPACE_MATCH"
+    return "MISMATCH"
+
+
+def tool_function(solution_path, samples, timeout_seconds=10):
+    timeout_seconds = float(timeout_seconds)
+
+    if not os.path.exists(solution_path):
+        return f"Error: file not found: {solution_path}"
+    if not isinstance(samples, list) or not samples:
+        return "Error: 'samples' must be a non-empty list of {input, expected} objects."
+
+    lines = []
+    exact = 0
+    total = len(samples)
+    for idx, sample in enumerate(samples, start=1):
+        if not isinstance(sample, dict) or 'input' not in sample or 'expected' not in sample:
+            lines.append(f"Sample {idx}: MISMATCH (malformed sample; needs 'input' and 'expected')")
+            continue
+        sample_input = str(sample['input'])
+        expected = str(sample['expected'])
+
+        returncode, actual, stderr = _run(_command(solution_path), sample_input, timeout_seconds)
+        status = _classify(expected, actual, returncode) if returncode is not None else "MISMATCH"
+        if status == "EXACT_MATCH":
+            exact += 1
+            lines.append(f"Sample {idx}: EXACT_MATCH")
+            continue
+
+        lines.append(f"Sample {idx}: {status}")
+        if returncode is None:
+            lines.append("Program timed out.")
+        elif returncode != 0:
+            lines.append(f"Program exited with return code {returncode}.")
+        diff = difflib.unified_diff(
+            expected.splitlines(keepends=True),
+            actual.splitlines(keepends=True),
+            fromfile=f"sample {idx} expected",
+            tofile=f"sample {idx} actual",
+        )
+        diff_text = ''.join(diff)
+        if diff_text:
+            lines.append(diff_text.rstrip('\n'))
+        else:
+            lines.append("(no line-level difference; only trailing whitespace/newlines or spacing within lines differ)")
+        if stderr.strip():
+            lines.append(f"stderr:\n{stderr.rstrip()}")
+
+    lines.append(f"{exact}/{total} exact matches")
+    return "\n".join(lines)
