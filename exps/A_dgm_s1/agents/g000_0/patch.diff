diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..98e47a2
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,147 @@
+import os
+import re
+import subprocess
+import sys
+import time
+
+_INT_RE = re.compile(r'^[+-]?\d+$')
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress test between a solution and a brute-force reference.\n
+* Runs the generator once per seed i in range(num_tests) as `generator_path i` (seed is passed as argv[1]); the generator must print a test input to stdout.\n
+* Feeds that input via stdin to both `solution_path` and `brute_path` and compares their stdout token by token.\n
+* Numeric tokens are compared with absolute/relative tolerance `float_tolerance` (when > 0); all other tokens must match exactly.\n
+* Stops at the first mismatch, crash, or timeout and returns the failing input, both outputs, and stderr.\n
+* Otherwise returns 'All N tests passed' together with the maximum observed runtime.\n
+* Python files (.py) are run with the current Python interpreter; other files are executed directly, so they must be executable.\n
+* Keep generated inputs small so the brute force finishes quickly. Put scratch files outside the repository (e.g. /tmp).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference program."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator. It is called as `generator_path <seed>` and prints one test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0..num_tests-1). Default 200."
+                },
+                "float_tolerance": {
+                    "type": "number",
+                    "description": "Absolute/relative tolerance for numeric tokens. Use 0 for exact comparison. Default 1e-6."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _command(path, args):
+    if path.endswith('.py'):
+        return [sys.executable, path] + args
+    return [path] + args
+
+
+def _tokens_match(a, b, float_tolerance):
+    if a == b:
+        return True
+    if float_tolerance and float_tolerance > 0 and not (_INT_RE.match(a) and _INT_RE.match(b)):
+        try:
+            x = float(a)
+            y = float(b)
+        except ValueError:
+            return False
+        if x != x or y != y:  # NaN
+            return False
+        if x == y:
+            return True
+        return abs(x - y) <= max(float_tolerance, float_tolerance * abs(y))
+    return False
+
+
+def _outputs_match(out_a, out_b, float_tolerance):
+    ta = out_a.split()
+    tb = out_b.split()
+    if len(ta) != len(tb):
+        return False
+    return all(_tokens_match(x, y, float_tolerance) for x, y in zip(ta, tb))
+
+
+def _run(cmd, stdin_text, timeout):
+    """Returns (returncode, stdout, stderr, elapsed) or (None, '', message, elapsed) on timeout."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, time.time() - start
+    except subprocess.TimeoutExpired as e:
+        stderr = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return None, '', stderr + f"\nTIMEOUT after {timeout} seconds", time.time() - start
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, float_tolerance=1e-6, timeout_seconds=10):
+    num_tests = int(num_tests)
+    float_tolerance = float(float_tolerance)
+    timeout_seconds = float(timeout_seconds)
+
+    for path in (solution_path, brute_path, generator_path):
+        if not os.path.exists(path):
+            return f"Error: file not found: {path}"
+
+    max_runtime = 0.0
+    for i in range(num_tests):
+        # Generate input
+        gen_code, gen_out, gen_err, _ = _run(_command(generator_path, [str(i)]), '', timeout_seconds)
+        if gen_code != 0:
+            return (f"Generator failed on seed {i} (return code {gen_code}).\n"
+                    f"stderr:\n{gen_err}")
+        test_input = gen_out
+
+        # Run solution
+        sol_code, sol_out, sol_err, sol_time = _run(_command(solution_path, []), test_input, timeout_seconds)
+        max_runtime = max(max_runtime, sol_time)
+        if sol_code is None or sol_code != 0:
+            reason = "TIMEOUT" if sol_code is None else f"crashed with return code {sol_code}"
+            return (f"Test {i} FAILED: solution {reason}.\n"
+                    f"Input:\n{test_input}\n"
+                    f"Solution output:\n{sol_out}\n"
+                    f"Solution stderr:\n{sol_err}")
+
+        # Run brute force
+        br_code, br_out, br_err, _ = _run(_command(brute_path, []), test_input, timeout_seconds)
+        if br_code is None or br_code != 0:
+            reason = "TIMEOUT" if br_code is None else f"crashed with return code {br_code}"
+            return (f"Test {i} could not be checked: brute force {reason}. "
+                    f"Reduce input size in the generator or fix the brute force.\n"
+                    f"Input:\n{test_input}\n"
+                    f"Brute output:\n{br_out}\n"
+                    f"Brute stderr:\n{br_err}")
+
+        if not _outputs_match(sol_out, br_out, float_tolerance):
+            return (f"Test {i} FAILED: output mismatch.\n"
+                    f"Input:\n{test_input}\n"
+                    f"Solution output:\n{sol_out}\n"
+                    f"Brute output:\n{br_out}\n"
+                    f"Solution stderr:\n{sol_err}")
+
+    return f"All {num_tests} tests passed. Max solution runtime: {max_runtime:.3f} seconds."
