+    # ----- patch guard helpers -----
+    TEST_LIKE_KEYWORDS = ('test', 'tests', 'brute', 'gen', 'sample', 'stress')
+
+    def _current_diff(self):
+        return str(diff_versus_commit(self.git_tempdir, self.base_commit))
+
+    def _get_changed_files(self, diff=None):
+        """Parse the file paths from `diff --git a/X b/X` header lines."""
+        if diff is None:
+            diff = self._current_diff()
+        files = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(\S+) b/(\S+)', line)
+            if m:
+                files.append(m.group(2))
+        return files
+
+    def _is_test_like(self, path):
+        lowered = path.lower()
+        return any(kw in lowered for kw in self.TEST_LIKE_KEYWORDS)
+
+    def _has_source_edit(self):
+        """True if the diff is non-empty and touches at least one non-test-like file."""
+        diff = self._current_diff()
+        if not diff.strip():
+            return False
+        changed = self._get_changed_files(diff)
+        return any(not self._is_test_like(f) for f in changed)
+
+    @staticmethod
+    def _is_empty_assistant_message(msg):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            return False
+        content = msg.get('content')
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return not content.strip()
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict):
+                    btype = block.get('type')
+                    if btype == 'text' and str(block.get('text', '')).strip():
+                        return False
+                    if btype not in (None, 'text'):
+                        return False  # tool_use etc. counts as content
+                elif block is not None:
+                    return False
+            return True
+        return False
+
+    def _history_is_unusable(self, msg_history):
+        if not msg_history:
+            return True
+        return self._is_empty_assistant_message(msg_history[-1])
