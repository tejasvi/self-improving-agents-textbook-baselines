+    def _has_meaningful_patch(self):
+        """
+        Check whether the current repo diff touches a primary source file with at least
+        one added, non-blank, non-comment line. Returns (bool, diff_summary).
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        if not diff.strip():
+            return False, 'no changes'
+
+        # Split the diff into per-file blocks
+        blocks = []
+        current_path = None
+        current_lines = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                if current_path is not None:
+                    blocks.append((current_path, current_lines))
+                parts = line.split(' ')
+                current_path = parts[-1][2:] if parts[-1].startswith('b/') else parts[-1]
+                current_lines = []
+            elif current_path is not None:
+                current_lines.append(line)
+        if current_path is not None:
+            blocks.append((current_path, current_lines))
+
+        changed_files = [path for path, _ in blocks]
+        summary = 'changed files: ' + ', '.join(changed_files) if changed_files else 'no changes'
+
+        def is_ignored(path):
+            lower = path.lower()
+            base = os.path.basename(lower)
+            if 'test' in lower or 'tests/' in lower or 'spec' in lower:
+                return True
+            if base in ('brute.py', 'gen.py') or '/tmp' in lower:
+                return True
+            if base.startswith('readme') or base.endswith('.md'):
+                return True
+            return False
+
+        for path, lines in blocks:
+            if is_ignored(path):
+                continue
+            for line in lines:
+                if not line.startswith('+') or line.startswith('+++'):
+                    continue
+                content = line[1:].strip()
+                if not content:
+                    continue
+                if content.startswith('#') or content.startswith('//') or content.startswith('/*') or content.startswith('*'):
+                    continue
+                return True, summary
+        return False, summary
+
