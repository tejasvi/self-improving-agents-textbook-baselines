diff --git a/tools/compare_solutions.py b/tools/compare_solutions.py
new file mode 100644
index 0000000..09d7e28
--- /dev/null
+++ b/tools/compare_solutions.py
@@ -0,0 +1,77 @@
+import os
+import sys
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+if _HERE not in sys.path:
+    sys.path.insert(0, _HERE)
+import stress_test as _stress  # noqa: E402
+
+
+def tool_info():
+    return {
+        "name": "compare_solutions",
+        "description": """Compare a solution against an independent reference program on generated inputs.\n
+* Runs the generator once per seed in seed_offset..seed_offset+num_tests-1 as `generator_path <seed> <gen_args...>`.\n
+* Feeds each input to both `solution_path` and `reference_path` and compares stdout token by token (numeric tolerance `float_tolerance`).\n
+* Stops at the first disagreement, crash, or timeout and reports the failing input and both outputs.\n
+* Otherwise reports how many tests passed, the seed range, max input size, and the max runtime of each program.\n
+* Use `reference_path` as a slower but simpler polynomial-time implementation (it may get a longer timeout via `timeout`).\n
+* Keep scratch files outside the repository (e.g. /tmp/scratch).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program to test."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the reference program (independent, simple, polynomial-time or exhaustive)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator. Called as `generator_path <seed> <gen_args...>` and prints one test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of tests to run. Default 200."
+                },
+                "seed_offset": {
+                    "type": "integer",
+                    "description": "First seed value. Default 0. Use different offsets (e.g. 1000) for new seed ranges."
+                },
+                "gen_args": {
+                    "type": "string",
+                    "description": "Extra arguments appended after the seed, e.g. a mode name such as 'tiny', 'medium', 'boundary' or 'max'. Default empty."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the solution and generator runs. Default 10."
+                },
+                "reference_timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the reference program runs. Default: same as timeout."
+                },
+                "float_tolerance": {
+                    "type": "number",
+                    "description": "Absolute/relative tolerance for numeric tokens. Use 0 for exact comparison. Default 1e-6."
+                }
+            },
+            "required": ["solution_path", "reference_path", "generator_path"]
+        }
+    }
+
+
+def tool_function(solution_path, reference_path, generator_path, num_tests=200, seed_offset=0,
+                  gen_args='', timeout=10, reference_timeout=None, float_tolerance=1e-6):
+    return _stress.tool_function(
+        solution_path=solution_path,
+        brute_path=reference_path,
+        generator_path=generator_path,
+        num_tests=num_tests,
+        float_tolerance=float_tolerance,
+        timeout_seconds=timeout,
+        seed_offset=seed_offset,
+        gen_args=gen_args,
+        brute_timeout_seconds=reference_timeout,
+    )
