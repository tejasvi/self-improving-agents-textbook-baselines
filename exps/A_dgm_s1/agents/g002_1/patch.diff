+def _last_assistant_text(msg_history):
+    """
+    Return the concatenated text of the last assistant message in a message history.
+    Handles both string content and list-of-block content.
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and isinstance(block.get('text'), str):
+                        parts.append(block['text'])
+                elif isinstance(block, str):
+                    parts.append(block)
+            return "\n".join(parts)
+        return ""
+    return ""
+
+def _admits_incomplete_verification(reply_text):
+    """
+    Return True if the agent's reply says the stress test (or timing test) was skipped / not run,
+    or that a sample still mismatches textually.
+    """
+    text = (reply_text or '').lower()
+    skip_pattern = r"(skip|not (been )?(run|performed|executed|done)|did not (run|perform|execute)|didn't (run|perform)|haven't (run|performed)|have not (run|performed)|without running|not yet (run|performed))"
+    for sentence in re.split(r'[.\n;]', text):
+        if re.search(r'stress|brute|random|timing|timed|max(imum)? constraint', sentence) and re.search(skip_pattern, sentence):
+            return True
+    if re.search(r'mismatch(es|ed)?\s+(remain|still)|still (mismatch|differ)|exact_match["\']?\s*:\s*false', text):
+        return True
+    return False
