@@ -0,0 +1,130 @@
+import difflib
+import json
+import math
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution program against a list of sample test cases and report the raw results.\n
+* Each case is run as `python3 <solution_path>` with the case's `input` written to stdin.\n
+* For every case the tool returns the actual stdout, whether it matches the expected output exactly (trailing newlines ignored), whether it matches after whitespace normalization, whether it matches numerically (every token equal or floats within relative tolerance 1e-9), and a unified diff between the actual and expected raw text.\n
+* Use it to check the solution against all samples from the problem statement. Exact-match failures must be fixed even if they are only formatting differences (e.g. number of decimal digits).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run with python3."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of sample test cases. Each item is an object with string fields 'input' (text fed to stdin) and 'expected' (expected stdout text).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text to feed to the program's standard input."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Expected standard output text for this input."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-case timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "cases"]
+        }
+    }
+
+
+def _numeric_match(actual, expected, rel_tol=1e-9):
+    a_tokens = actual.split()
+    e_tokens = expected.split()
+    if len(a_tokens) != len(e_tokens):
+        return False
+    for a, e in zip(a_tokens, e_tokens):
+        if a == e:
+            continue
+        try:
+            fa = float(a)
+            fe = float(e)
+        except ValueError:
+            return False
+        if not math.isclose(fa, fe, rel_tol=rel_tol, abs_tol=0.0):
+            return False
+    return True
+
+
+def _run_one(solution_path, input_text, timeout):
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        return out, "", None, f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return "", "", None, f"Failed to run: {e}"
+
+
+def tool_function(solution_path, cases, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    results = []
+    for idx, case in enumerate(cases or []):
+        input_text = str(case.get("input", ""))
+        expected = str(case.get("expected", ""))
+        actual, stderr, returncode, error = _run_one(solution_path, input_text, timeout)
+
+        act_s = actual.rstrip("\n")
+        exp_s = expected.rstrip("\n")
+        exact = act_s == exp_s
+        ws_match = " ".join(act_s.split()) == " ".join(exp_s.split())
+        numeric = _numeric_match(act_s, exp_s)
+        diff = "".join(difflib.unified_diff(
+            (exp_s + "\n").splitlines(keepends=True),
+            (act_s + "\n").splitlines(keepends=True),
+            fromfile="expected",
+            tofile="actual",
+        ))
+
+        result = {
+            "case": idx,
+            "actual_output": actual,
+            "exact_match": exact,
+            "whitespace_normalized_match": ws_match,
+            "numeric_match": numeric,
+            "diff": diff,
+        }
+        if returncode is not None:
+            result["returncode"] = returncode
+        if stderr:
+            result["stderr"] = stderr[-2000:]
+        if error:
+            result["error"] = error
+        results.append(result)
+
+    summary = {
+        "total": len(results),
+        "exact_passed": sum(1 for r in results if r["exact_match"]),
+        "whitespace_passed": sum(1 for r in results if r["whitespace_normalized_match"]),
+        "numeric_passed": sum(1 for r in results if r["numeric_match"]),
+    }
+    return json.dumps({"summary": summary, "results": results}, indent=2)
