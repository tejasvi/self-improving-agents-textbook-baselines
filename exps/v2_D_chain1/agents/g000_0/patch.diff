+    def _last_assistant_text(self, msg_history):
+        """Extract the text of the last assistant message in a message history."""
+        for message in reversed(msg_history or []):
+            if not isinstance(message, dict) or message.get("role") != "assistant":
+                continue
+            content = message.get("content")
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = []
+                for block in content:
+                    if isinstance(block, dict) and block.get("type") == "text":
+                        texts.append(str(block.get("text", "")))
+                    elif hasattr(block, "text"):
+                        texts.append(str(block.text))
+                if texts:
+                    return "\n".join(texts)
+        return ""
+
+    def _edits_text(self):
+        """Return the current repo diff as plain text."""
+        parts = []
+        for message in self.get_current_edits():
+            for block in message.get("content", []):
+                if isinstance(block, dict) and "text" in block:
+                    parts.append(block["text"])
+        return "\n".join(parts)
