+import os
+
+from utils.run_utils import run_python_file, truncate
+
+
+def tool_info():
+    return {
+        "name": "run_solution",
+        "description": """Run a Python file in a fresh subprocess with a hard timeout and return its exit code, elapsed time, and (truncated) stdout/stderr.
+
+* mode 'stdin' (default): the file is run as a program; `input` is passed to its standard input.
+* mode 'method': the file is run as a program as well, but `input` is passed to it as the single command-line argument. Use this only when the file itself expects an argument.
+* Timeouts are reported as a clean message instead of hanging the shell.
+* Use this to run the examples from the problem statement and any other single test input against a solution.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python file to run, e.g. /repo/solution.py."
+                },
+                "input": {
+                    "type": "string",
+                    "description": "Text fed to the program's standard input (or passed as argv[1] in 'method' mode). Defaults to empty."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard time limit in seconds before the process is killed. Defaults to 10."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["stdin", "method"],
+                    "description": "'stdin' to pipe `input` to standard input (default), or 'method' to pass `input` as argv[1]."
+                }
+            },
+            "required": ["path"]
+        }
+    }
+
+
+def tool_function(path, input="", timeout=10, mode="stdin"):
+    if not os.path.isfile(path):
+        return f"Error: file not found: {path}"
+    try:
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    if mode == "method":
+        result = run_python_file(path, stdin_text="", timeout=timeout, args=[input or ""])
+    else:
+        result = run_python_file(path, stdin_text=input or "", timeout=timeout)
+
+    if result["status"] == "timeout":
+        return (
+            f"TIMEOUT: process killed after {timeout} seconds (elapsed {result['elapsed']:.2f}s).\n"
+            f"stdout (partial):\n{truncate(result['stdout'])}\n"
+            f"stderr (partial):\n{truncate(result['stderr'])}"
+        )
+    if result["status"] == "error":
+        return f"Error: could not start process: {result.get('message', '')}"
+    return (
+        f"exit code: {result['returncode']}\n"
+        f"elapsed: {result['elapsed']:.2f}s\n"
+        f"stdout:\n{truncate(result['stdout'])}\n"
+        f"stderr:\n{truncate(result['stderr'])}"
+    )
