@@ -0,0 +1,121 @@
+"""Shared helpers for running Python solution files in a fresh subprocess.
+
+Used by the run_solution / stress_test tools and by the verification harness
+in coding_agent.py. Every run is hard-limited by a timeout so a hanging
+program can never block the caller.
+"""
+import subprocess
+import sys
+import time
+
+MAX_STREAM_CHARS = 3000
+
+
+def truncate(text, limit=MAX_STREAM_CHARS):
+    """Cap a string at `limit` characters, marking the cut."""
+    if text is None:
+        return ""
+    if len(text) > limit:
+        return text[:limit] + f"\n<truncated {len(text) - limit} chars>"
+    return text
+
+
+def run_python_file(path, stdin_text="", timeout=10, args=None):
+    """Run `python <path> [args...]` with `stdin_text` on stdin.
+
+    Returns a dict with keys:
+      - status: "ok" | "timeout" | "error"
+      - returncode: int or None
+      - stdout, stderr: str (untruncated)
+      - elapsed: float seconds
+      - message: str, only set when status == "error"
+    """
+    cmd = [sys.executable, path] + list(args or [])
+    start = time.monotonic()
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        return {
+            "status": "timeout",
+            "returncode": None,
+            "stdout": e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or ""),
+            "stderr": e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or ""),
+            "elapsed": time.monotonic() - start,
+        }
+    except OSError as e:
+        return {
+            "status": "error",
+            "returncode": None,
+            "stdout": "",
+            "stderr": "",
+            "elapsed": time.monotonic() - start,
+            "message": str(e),
+        }
+    return {
+        "status": "ok",
+        "returncode": proc.returncode,
+        "stdout": proc.stdout,
+        "stderr": proc.stderr,
+        "elapsed": time.monotonic() - start,
+    }
+
+
+def tokens_equal(a, b):
+    """Compare two outputs token-wise, ignoring whitespace differences."""
+    return (a or "").split() == (b or "").split()
+
+
+def run_samples(solution_path, samples_path, timeout=10):
+    """Run every {input, output} sample in `samples_path` against `solution_path`.
+
+    Returns (all_passed, report) where report is a plain-text summary listing
+    each failing sample with its input, expected output and actual output.
+    """
+    import json
+
+    try:
+        with open(samples_path) as f:
+            samples = json.load(f)
+    except (OSError, ValueError) as e:
+        return False, f"Could not load {samples_path}: {e}"
+    if not isinstance(samples, list) or not samples:
+        return False, f"{samples_path} must contain a non-empty JSON list of {{input, output}} objects."
+
+    lines = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        if not isinstance(sample, dict) or "input" not in sample or "output" not in sample:
+            lines.append(f"Sample {idx}: malformed (needs 'input' and 'output' keys).")
+            continue
+        sample_input = str(sample["input"])
+        expected = str(sample["output"])
+        result = run_python_file(solution_path, stdin_text=sample_input, timeout=timeout)
+        if result["status"] == "timeout":
+            lines.append(f"Sample {idx}: TIMEOUT after {timeout}s.\ninput:\n{truncate(sample_input)}\nexpected:\n{truncate(expected)}")
+        elif result["status"] != "ok" or result["returncode"] != 0:
+            lines.append(
+                f"Sample {idx}: RUNTIME ERROR (exit {result['returncode']}).\n"
+                f"input:\n{truncate(sample_input)}\nstderr:\n{truncate(result['stderr'])}"
+            )
+        elif tokens_equal(result["stdout"], expected):
+            passed += 1
+        else:
+            lines.append(
+                f"Sample {idx}: WRONG ANSWER.\ninput:\n{truncate(sample_input)}\n"
+                f"expected:\n{truncate(expected)}\nactual:\n{truncate(result['stdout'])}"
+            )
+
+    total = len(samples)
+    all_passed = passed == total and all(
+        isinstance(s, dict) and "input" in s and "output" in s for s in samples
+    )
+    header = f"Samples passed: {passed}/{total}"
+    if all_passed:
+        return True, header + " (ALL SAMPLES PASSED)"
+    return False, header + "\n" + "\n\n".join(lines)
