+import json
+import os
+import time
+
+import pytest
+
+from tools.run_solution import tool_function as run_solution
+from tools.stress_test import tool_function as stress_test, tool_info as stress_info
+from tools.run_solution import tool_info as run_info
+from utils.run_utils import run_python_file, run_samples, tokens_equal, truncate
+
+
+@pytest.fixture
+def workdir(tmp_path):
+    return tmp_path
+
+
+def write(path, text):
+    path.write_text(text)
+    return str(path)
+
+
+def test_schemas_are_well_formed():
+    for info in (run_info(), stress_info()):
+        schema = info["input_schema"]
+        assert schema["type"] == "object"
+        assert "required" not in schema["properties"]
+        for name, prop in schema["properties"].items():
+            assert "type" in prop and "description" in prop, name
+        assert set(schema["required"]) <= set(schema["properties"])
+
+
+def test_run_solution_echoes_stdin(workdir):
+    p = write(workdir / "sol.py", "import sys\nprint(sum(map(int, sys.stdin.read().split())))\n")
+    out = run_solution(path=p, input="1 2 3")
+    assert "exit code: 0" in out
+    assert "6" in out
+
+
+def test_run_solution_reports_timeout_cleanly(workdir):
+    p = write(workdir / "hang.py", "import time\ntime.sleep(60)\n")
+    start = time.monotonic()
+    out = run_solution(path=p, input="", timeout=1)
+    assert time.monotonic() - start < 20
+    assert out.startswith("TIMEOUT")
+
+
+def test_run_solution_reports_nonzero_exit(workdir):
+    p = write(workdir / "bad.py", "raise SystemExit(3)\n")
+    out = run_solution(path=p)
+    assert "exit code: 3" in out
+
+
+def test_run_solution_missing_file():
+    assert run_solution(path="/nonexistent/x.py").startswith("Error")
+
+
+def test_run_solution_method_mode_passes_argv(workdir):
+    p = write(workdir / "argv.py", "import sys\nprint(sys.argv[1].upper())\n")
+    out = run_solution(path=p, input="abc", mode="method")
+    assert "ABC" in out
+
+
+def test_truncate_caps_long_output():
+    s = truncate("x" * 5000)
+    assert len(s) < 3100 and "truncated" in s
+
+
+def test_tokens_equal_ignores_whitespace():
+    assert tokens_equal("1 2\n3\n", "1  2 3")
+    assert not tokens_equal("1 2", "1 3")
+
+
+def test_stress_all_passed(workdir):
+    sol = write(workdir / "sol.py", "print(int(input())*2)\n")
+    # brute: doubling via addition, deliberately different code path
+    brute = write(workdir / "brute.py", "x = int(input())\nprint(x + x)\n")
+    gen = write(workdir / "gen.py", "import sys, random\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(0, 100))\n")
+    out = stress_test(solution_path=sol, brute_path=brute, generator_path=gen, iterations=10, timeout=5)
+    assert out == "ALL PASSED after 10 iterations"
+
+
+def test_stress_reports_first_mismatch(workdir):
+    sol = write(workdir / "sol.py", "x = int(input())\nprint(x * 2 + (1 if x > 50 else 0))\n")
+    brute = write(workdir / "brute.py", "x = int(input())\nprint(x * 2)\n")
+    gen = write(workdir / "gen.py", "import sys, random\nrandom.seed(int(sys.argv[1]))\nprint(random.randint(0, 100))\n")
+    out = stress_test(solution_path=sol, brute_path=brute, generator_path=gen, iterations=50, timeout=5)
+    assert out.startswith("FAILED on seed")
+    assert "expected output" in out and "actual output" in out
+
+
+def test_stress_reports_timeout(workdir):
+    sol = write(workdir / "sol.py", "import time\ntime.sleep(60)\n")
+    brute = write(workdir / "brute.py", "print(1)\n")
+    gen = write(workdir / "gen.py", "print(1)\n")
+    out = stress_test(solution_path=sol, brute_path=brute, generator_path=gen, iterations=3, timeout=1)
+    assert "timed out" in out
+
+
+def test_run_samples_reports_wrong_answer(workdir):
+    sol = write(workdir / "sol.py", "print(int(input()) + 1)\n")
+    samples = write(workdir / "samples.json", json.dumps([
+        {"input": "1\n", "output": "2\n"},
+        {"input": "5\n", "output": "5\n"},
+    ]))
+    ok, report = run_samples(sol, samples)
+    assert not ok
+    assert "Samples passed: 1/2" in report
+    assert "expected" in report and "actual" in report
+
+
+def test_run_samples_all_pass(workdir):
+    sol = write(workdir / "sol.py", "print(int(input()) + 1)\n")
+    samples = write(workdir / "samples.json", json.dumps([{"input": "1", "output": "2"}]))
+    ok, report = run_samples(sol, samples)
+    assert ok
+
+
+def test_run_samples_bad_file(workdir):
+    sol = write(workdir / "sol.py", "print(1)\n")
+    ok, report = run_samples(sol, str(workdir / "missing.json"))
