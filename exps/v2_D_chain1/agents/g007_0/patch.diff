+++ b/tools/stress_test.py
@@ -0,0 +1,123 @@
+import os
+import time
+
+from utils.run_utils import run_python_file, tokens_equal, truncate
+
+# Total wall-clock budget for one stress_test call. The bash tool gives up
+# after 120s, so stay comfortably below that.
+TOTAL_BUDGET_SECONDS = 100.0
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test: compare a solution against a brute-force reference on generated inputs.
+
+* For seed i in 0..iterations-1 it runs `python <generator_path> <i>` to produce an input on stdout.
+* It runs the brute-force program and the solution on that input, each with `timeout` seconds.
+* Outputs are compared token-wise, ignoring whitespace differences.
+* Returns 'ALL PASSED after N iterations' if every case matches, otherwise the first failing case with its input, expected output, and actual output.
+* Stops early if the total run time approaches about 100 seconds and reports how many iterations completed.
+* The generator must accept the seed as argv[1].""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file under test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python brute-force reference solution."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python random generator. It is called as `python generator.py <seed>` and must print one test input to stdout."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random cases to test (seeds 0 to iterations-1)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-program time limit in seconds for the generator, brute force, and solution on each case."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _fail_report(seed, reason, case_input, expected, actual):
+    return (
+        f"FAILED on seed {seed}: {reason}\n"
+        f"input:\n{truncate(case_input)}\n"
+        f"expected output:\n{truncate(expected)}\n"
+        f"actual output:\n{truncate(actual)}"
+    )
+
+
+def tool_function(solution_path, brute_path, generator_path, iterations=100, timeout=10):
+    for name, p in (("solution_path", solution_path), ("brute_path", brute_path), ("generator_path", generator_path)):
+        if not os.path.isfile(p):
+            return f"Error: {name} not found: {p}"
+    try:
+        iterations = int(iterations) if iterations is not None else 100
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError):
+        return "Error: iterations and timeout must be integers."
+    if iterations <= 0:
+        return "Error: iterations must be a positive integer."
+    if timeout <= 0:
+        return "Error: timeout must be a positive integer."
+
+    start = time.monotonic()
+    completed = 0
+    for seed in range(iterations):
+        remaining = TOTAL_BUDGET_SECONDS - (time.monotonic() - start)
+        if remaining <= 0:
+            return (
+                f"STOPPED (time budget of {TOTAL_BUDGET_SECONDS:.0f}s reached): "
+                f"no failures in {completed} of {iterations} iterations."
+            )
+        per_run = min(timeout, max(1, int(remaining)))
+
+        gen = run_python_file(generator_path, timeout=per_run, args=[str(seed)])
+        if gen["status"] != "ok" or gen["returncode"] != 0:
+            reason = "generator timed out" if gen["status"] == "timeout" else f"generator failed (exit {gen['returncode']})"
+            return _fail_report(seed, reason, "", "", gen["stderr"])
+        case_input = gen["stdout"]
+
+        remaining = TOTAL_BUDGET_SECONDS - (time.monotonic() - start)
+        if remaining <= 0:
+            return (
+                f"STOPPED (time budget of {TOTAL_BUDGET_SECONDS:.0f}s reached): "
+                f"no failures in {completed} of {iterations} iterations."
+            )
+        per_run = min(timeout, max(1, int(remaining)))
+
+        brute = run_python_file(brute_path, stdin_text=case_input, timeout=per_run)
+        if brute["status"] != "ok" or brute["returncode"] != 0:
+            reason = "brute force timed out" if brute["status"] == "timeout" else f"brute force crashed (exit {brute['returncode']})"
+            return _fail_report(seed, reason, case_input, brute["stdout"], brute["stderr"])
+        expected = brute["stdout"]
+
+        remaining = TOTAL_BUDGET_SECONDS - (time.monotonic() - start)
+        if remaining <= 0:
+            return (
+                f"STOPPED (time budget of {TOTAL_BUDGET_SECONDS:.0f}s reached): "
+                f"no failures in {completed} of {iterations} iterations."
+            )
+        per_run = min(timeout, max(1, int(remaining)))
+
+        sol = run_python_file(solution_path, stdin_text=case_input, timeout=per_run)
+        if sol["status"] == "timeout":
+            return _fail_report(seed, f"solution timed out after {per_run}s", case_input, expected, sol["stdout"])
+        if sol["status"] != "ok" or sol["returncode"] != 0:
+            return _fail_report(seed, f"solution crashed (exit {sol['returncode']})", case_input, expected, sol["stderr"] or sol["stdout"])
+        if not tokens_equal(sol["stdout"], expected):
+            return _fail_report(seed, "output mismatch", case_input, expected, sol["stdout"])
+
+        completed += 1
+
+    return f"ALL PASSED after {completed} iterations"
