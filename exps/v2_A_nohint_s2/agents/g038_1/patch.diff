-def _message_text(msg):
-    """
-    Extract plain text from a chat history entry (Claude-style content blocks,
-    OpenAI-style objects, or plain strings).
-    """
-    if isinstance(msg, dict):
-        content = msg.get('content')
-        if isinstance(content, str):
-            return content
-        if isinstance(content, list):
-            parts = []
-            for block in content:
-                if isinstance(block, dict) and isinstance(block.get('text'), str):
-                    parts.append(block['text'])
-                elif isinstance(getattr(block, 'text', None), str):
-                    parts.append(block.text)
-            return "\n".join(parts)
-        return str(msg)
-    output_text = getattr(msg, 'output_text', None)
-    if isinstance(output_text, str):
-        return output_text
-    return str(msg)
-
-def _extract_last_python_block(msg_history):
-    """
-    Return the content of the last ```python fenced block in the history, or None.
-    """
-    pattern = re.compile(r'```python[ \t]*\n(.*?)```', re.DOTALL)
-    for msg in reversed(msg_history):
-        matches = pattern.findall(_message_text(msg))
-        if matches:
-            return matches[-1]
-    return None
-
-def _last_assistant_is_empty(history):
-    """
-    Return True if the last assistant message has no text and no tool_use blocks
-    (or there is no assistant message at all).
-    """
-    for msg in reversed(history or []):
-        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
-        if role != 'assistant':
-            continue
-        if _message_text(msg).strip():
-            return False
-        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
-        if isinstance(content, list):
-            for block in content:
-                btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
-                if btype == 'tool_use':
-                    return False
-        return True
-    return True
-
-FAILURE_KEYWORDS = ('timeout', 'timed out', 'exit 124', 'fail', 'tle', 'too slow', 'not complete', 'exit code')
-
-def _turn_ended_without_action(history):
-    """
-    Return True if the last assistant message contains no tool_use block.
-    """
-    for msg in reversed(history or []):
-        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
-        if role != 'assistant':
-            continue
-        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
-        if isinstance(content, list):
-            for block in content:
-                btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
-                if btype == 'tool_use':
-                    return False
-        return True
-    return True
-
-def _last_output_has_failure(history):
-    """
-    Return True if the last non-empty message (tool output or assistant text) mentions a failure keyword.
-    """
-    for msg in reversed(history or []):
-        lowered = _message_text(msg).lower()
-        if not lowered.strip():
-            continue
-        return any(re.search(r'(?<![a-z])' + re.escape(k) + r'(?![a-z])', lowered) for k in FAILURE_KEYWORDS)
-    return False
-
-def _turn_text_signals_unfinished(history):
-    """
-    Return True if the last assistant turn has no tool call and its text says work is still pending.
-    """
-    if not _turn_ended_without_action(history):
-        return False
-    for msg in reversed(history or []):
-        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
-        if role == 'assistant':
-            lowered = _message_text(msg).lower()
-            return any(k in lowered for k in ("i'll", "i will", "will rewrite", "need to fix", "not complete", "timed out", "let me"))
-    return False
-
-def _last_test_passed(history):
-    """
-    Return True if the last message mentions a pass marker for both the examples and the timing test.
-    """
-    for msg in reversed(history or []):
-        lowered = _message_text(msg).lower()
-        if not lowered.strip():
-            continue
-        return ('pass' in lowered and 'ok elapsed' in lowered) or ('all examples pass' in lowered and 'stress' in lowered)
-    return False
