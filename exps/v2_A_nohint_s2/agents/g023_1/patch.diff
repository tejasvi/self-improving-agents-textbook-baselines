-def _heading_key(paragraph):
-    """Return a normalized heading key if the paragraph is a headed section title, else None."""
-    first = paragraph.strip().splitlines()[0].strip()
-    if first.startswith("#"):
-        key = first.lstrip("#").strip()
-    else:
-        key = first
-    key = key.strip("*_: \t").strip().lower()
-    if first.startswith("#") or key in _HEADING_WORDS:
-        return key or None
-    return None
-
-def _normalize_statement(text):
-    """
-    Remove exact-duplicate paragraphs and repeated headed sections from a problem statement.
-    Paragraphs are separated by blank lines. If the result is too short, the original text is kept.
-    """
-    if not text:
-        return text
-    paragraphs = [p for p in re.split(r"\n\s*\n", text) if p.strip()]
-    seen_paragraphs = set()
-    seen_headings = set()
-    kept = []
-    skipping = False
-    for para in paragraphs:
-        norm = re.sub(r"\s+", " ", para).strip()
-        heading = _heading_key(para)
-        if heading is not None:
-            if heading in seen_headings:
-                skipping = True
-                continue
-            seen_headings.add(heading)
-            skipping = False
-        elif skipping:
-            continue
-        if norm in seen_paragraphs:
-            continue
-        seen_paragraphs.add(norm)
-        kept.append(para.strip("\n"))
-    result = "\n\n".join(kept).strip()
-    if len(result) < 40 or len(result) < 0.3 * len(text.strip()):
-        return text
-    return result
-
-def _content_blocks(msg):
-    """Return the content blocks of a message as a list (empty if none)."""
-    content = msg.get("content")
-    if content is None:
-        return []
-    if isinstance(content, str):
-        return [{"type": "text", "text": content}] if content.strip() else []
-    return list(content)
-
-def _block_type(block):
-    if isinstance(block, dict):
-        return block.get("type")
-    return getattr(block, "type", None)
-
-def _last_assistant_block_types(msg_history):
-    """Return the content-block types of the last assistant message (empty list if none)."""
-    for msg in reversed(msg_history or []):
-        if msg.get("role") == "assistant":
-            return [str(_block_type(b)) for b in _content_blocks(msg)]
-    return []
