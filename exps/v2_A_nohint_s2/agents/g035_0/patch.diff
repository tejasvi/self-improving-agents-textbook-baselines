+def _sanitize_history(msg_history):
+    """
+    Remove assistant messages whose content is empty (or only empty text blocks),
+    and drop empty text blocks from the remaining messages.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        content = msg.get("content")
+        if isinstance(content, str):
+            if msg.get("role") == "assistant" and not content.strip():
+                continue
+            cleaned.append(msg)
+            continue
+        if not isinstance(content, list):
+            if msg.get("role") == "assistant":
+                continue
+            cleaned.append(msg)
+            continue
+        new_blocks = []
+        for block in content:
+            if isinstance(block, dict) and block.get("type") == "text" and not str(block.get("text", "")).strip():
+                continue
+            new_blocks.append(block)
+        if msg.get("role") == "assistant" and not new_blocks:
+            continue
+        new_msg = dict(msg)
+        new_msg["content"] = new_blocks
+        cleaned.append(new_msg)
+    return cleaned
+
+
+def _last_assistant_text(msg_history):
+    """Return the text of the last assistant message in msg_history ('' if none)."""
+    for msg in reversed(msg_history or []):
+        if msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            return "\n".join(
+                str(b.get("text", "")) for b in content
+                if isinstance(b, dict) and b.get("type") == "text"
+            )
+        return ""
+    return ""
+
+
+def _extract_python_block(text):
+    """Extract the first ```python fenced block from text, or None."""
+    match = re.search(r"```python[ \t]*\n(.*?)```", text or "", re.DOTALL)
+    if match:
+        return match.group(1)
+    return None
+
+
+def _extract_samples(problem_statement):
+    """
+    Extract (input, expected_output) pairs from 'Sample Input N' / 'Sample Output N' sections.
+    Each section body is its first paragraph (up to the next blank line), so trailing
+    notes after a sample are not included.
+    """
+    text = problem_statement or ""
+    header = re.compile(r"(Sample Input|Sample Output)\s*(\d+)\s*:?[ \t]*\n", re.IGNORECASE)
+    headers = list(header.finditer(text))
+
+    def first_paragraph(start_pos, idx):
+        end_pos = headers[idx + 1].start() if idx + 1 < len(headers) else len(text)
+        body = text[start_pos:end_pos].lstrip("\n")
+        para = re.split(r"\n[ \t]*\n", body, maxsplit=1)[0]
+        return para.strip("\n")
+
+    inputs, outputs = {}, {}
+    for i, m in enumerate(headers):
+        kind = m.group(1).lower()
+        num = int(m.group(2))
+        body = first_paragraph(m.end(), i)
+        if kind == "sample input":
+            inputs[num] = body
+        else:
+            outputs[num] = body
+
+    samples = []
+    for num in sorted(inputs):
+        if num in outputs:
+            samples.append((inputs[num] + "\n", outputs[num].strip()))
+    return samples
+
+
+def _run_samples(target_path, samples, cwd, timeout=10):
+    """
+    Run the Python program at target_path on each sample input.
+    Returns a list of mismatch descriptions (empty if all pass).
+    """
+    mismatches = []
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        try:
+            result = subprocess.run(
+                [sys.executable, target_path],
+                input=inp, capture_output=True, text=True, timeout=timeout, cwd=cwd,
+            )
+            actual = result.stdout.strip()
+            err = result.stderr.strip()
+        except subprocess.TimeoutExpired:
+            actual, err = "", f"Timed out after {timeout}s"
+        except Exception as e:
+            actual, err = "", f"Failed to run: {e}"
+        if actual.split() != expected.split():
+            mismatches.append(
+                f"Sample {idx}:\nInput:\n{inp}\nExpected output:\n{expected}\n"
+                f"Actual output:\n{actual}\nStderr:\n{err}"
+            )
+    return mismatches
+
