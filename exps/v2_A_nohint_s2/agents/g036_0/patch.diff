diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..ef0110f
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,94 @@
+import subprocess
+import sys
+import time
+
+
+def _tail(text, max_lines=40):
+    lines = (text or "").splitlines()
+    return "\n".join(lines[-max_lines:])
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": (
+            "Run a Python solution file on an input and measure wall-clock time with a timeout. "
+            "Provide either input_path (a file fed to stdin) or generator_path (a Python script whose "
+            "stdout is fed to the solution's stdin). Returns elapsed seconds, whether it timed out, "
+            "the exit code, and the last lines of stdout/stderr."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (reads stdin, writes stdout).",
+                },
+                "input_path": {
+                    "type": "string",
+                    "description": "Path to a file whose contents are fed to the solution's stdin. Optional if generator_path is given.",
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator script; its stdout is fed to the solution's stdin. Optional if input_path is given.",
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the solution run (default 10).",
+                },
+            },
+            "required": ["solution_path"],
+        },
+    }
+
+
+def tool_function(solution_path, input_path=None, generator_path=None, timeout_sec=10):
+    try:
+        timeout = float(timeout_sec) if timeout_sec is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    input_text = None
+    gen_note = ""
+    if generator_path:
+        try:
+            gen = subprocess.run(
+                [sys.executable, generator_path],
+                capture_output=True, text=True, timeout=max(timeout, 60),
+            )
+        except subprocess.TimeoutExpired:
+            return "Generator timed out."
+        if gen.returncode != 0:
+            return "Generator failed (exit code %d):\n%s" % (gen.returncode, _tail(gen.stderr))
+        input_text = gen.stdout
+        gen_note = "Generator output size: %d bytes\n" % len(input_text)
+    elif input_path:
+        try:
+            with open(input_path, "r") as f:
+                input_text = f.read()
+        except OSError as e:
+            return "Could not read input_path: %s" % e
+    else:
+        input_text = ""
+
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text, capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return (
+            gen_note
+            + "TIMED OUT after %.2fs (limit %.1fs). The solution is too slow for this input.\n" % (elapsed, timeout)
+            + "stdout tail:\n" + _tail(out, 10) + "\nstderr tail:\n" + _tail(err, 10)
+        )
+    elapsed = time.time() - start
+    return (
+        gen_note
+        + "Finished in %.2fs (limit %.1fs), timed_out=False, exit_code=%d\n" % (elapsed, timeout, proc.returncode)
+        + "stdout tail:\n" + _tail(proc.stdout, 20) + "\nstderr tail:\n" + _tail(proc.stderr, 20)
+    )
