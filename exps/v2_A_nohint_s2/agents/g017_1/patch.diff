-def _find_target_file(git_tempdir):
-    """
-    Locate the stub file the agent should edit, as a path relative to git_tempdir.
-    Preference: solution.py, then a git-tracked .py file containing a
-    'Write your solution here' comment or a `class Solution`, then the first .py file.
-    """
-    result = subprocess.run(
-        ["git", "-C", git_tempdir, "ls-files"],
-        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
-    )
-    files = result.stdout.decode(errors='replace').splitlines()
-    py_files = [f for f in files if f.endswith('.py')]
-
-    for f in py_files:
-        if os.path.basename(f) == 'solution.py':
-            return f
-
-    for f in py_files:
-        try:
-            with open(os.path.join(git_tempdir, f), 'r', encoding='utf-8', errors='replace') as fh:
-                content = fh.read()
-        except OSError:
-            continue
-        if 'Write your solution here' in content or re.search(r'^\s*class\s+Solution\b', content, re.MULTILINE):
-            return f
-
-    if py_files:
-        return py_files[0]
-    return 'solution.py'
