+    def _last_assistant_has_content(self, msg_history):
+        """True if the last assistant message has a tool_use block or non-empty text."""
+        for msg in reversed(msg_history or []):
+            if msg.get("role") != "assistant":
+                continue
+            content = msg.get("content")
+            if isinstance(content, str):
+                return bool(content.strip())
+            if isinstance(content, list):
+                for block in content:
+                    btype = block.get("type") if isinstance(block, dict) else getattr(block, "type", None)
+                    if btype == "tool_use":
+                        return True
+                    text = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+                    if text and str(text).strip():
+                        return True
+                return False
+            # OpenAI-style output items or other objects: be permissive about unknown shapes.
+            return content is not None
+        return False
 
