+    def _extract_samples(self, problem_statement):
+        """Parse 'Sample Input k' / 'Sample Output k' blocks into (input, expected) pairs."""
+        text = problem_statement or ''
+        pattern = re.compile(
+            r'Sample Input\s*(\d+)\s*:?\s*\n(.*?)\n\s*Sample Output\s*\1\s*:?\s*\n(.*?)(?=\n[ \t]*\n|\n\s*Sample Input\s*\d+|\Z)',
+            re.DOTALL | re.IGNORECASE,
+        )
+        samples = []
+        for m in pattern.finditer(text):
+            inp = m.group(2).strip('\n') + '\n'
+            expected = m.group(3).strip()
+            samples.append((inp, expected))
+        return samples
+
+    def _run_samples(self, target_path):
+        """Run `python target_path` on each sample; return a raw human-readable report."""
+        samples = self._extract_samples(self.problem_statement)
+        if not samples:
+            self._last_sample_counts = (0, 0)
+            return "No sample tests found in the problem statement."
+        if target_path is None or not os.path.exists(target_path):
+            self._last_sample_counts = (0, len(samples))
+            return f"Target file {target_path} does not exist; cannot run samples."
+        lines = []
+        passed = 0
+        for idx, (inp, expected) in enumerate(samples, start=1):
+            try:
+                proc = subprocess.run(
+                    ["python", target_path], input=inp, capture_output=True,
+                    text=True, timeout=10, cwd=self.git_tempdir,
+                )
+                actual = proc.stdout.strip()
+                stderr = proc.stderr.strip()
+            except subprocess.TimeoutExpired as e:
+                actual = (e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")).strip()
+                stderr = "TIMEOUT after 10s"
+            ok = actual.split() == expected.split()
+            passed += ok
+            lines.append(
+                f"Sample {idx}: {'PASS' if ok else 'FAIL'}\n"
+                f"  input:\n{inp}"
+                f"  expected: {expected!r}\n"
+                f"  actual:   {actual!r}\n"
+                f"  stderr:   {stderr!r}"
+            )
+        self._last_sample_counts = (passed, len(samples))
+        lines.insert(0, f"Sample results: {passed}/{len(samples)} passed")
+        return "\n".join(lines)
+
+    def _samples_all_pass(self, report):
+        """True if the last _run_samples report had every sample passing."""
+        passed, total = self._last_sample_counts
+        return total > 0 and passed == total
