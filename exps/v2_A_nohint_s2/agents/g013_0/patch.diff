@@ -0,0 +1,106 @@
+import os
+import re
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution file against the sample input/output pairs found in a problem statement.\n
+* Extracts samples from 'Sample Input N' / 'Sample Output N' blocks, and from 'Example' blocks with 'Input:' / 'Output:' lines.\n
+* Runs `python <file_path>` once per sample with the sample input on stdin, with a timeout.\n
+* Returns a plain-text report listing, for each sample, PASS/FAIL, the expected output, the actual output, and stderr.\n
+* Use this tool to verify your solution before finishing. Finish only when all samples pass.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the sample input/output pairs."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each sample run. Defaults to 10."
+                }
+            },
+            "required": ["file_path", "problem_statement", "timeout"]
+        }
+    }
+
+
+_SAMPLE_IN_OUT = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n##|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+_EXAMPLE_IN_OUT = re.compile(
+    r'(?:Example\s*(\d*)[^\n]*\n\s*)?Input:?\s*\n?(.*?)\n\s*Output:?\s*\n(.*?)(?=\n\s*(?:Example|Input:|Sample Input)|\n##|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+
+
+def extract_samples(problem_statement):
+    """Return a list of (input_text, expected_output_text) tuples."""
+    samples = []
+    for m in _SAMPLE_IN_OUT.finditer(problem_statement):
+        samples.append((m.group(2).strip('\n') + '\n', m.group(3).strip()))
+    if samples:
+        return samples
+    for m in _EXAMPLE_IN_OUT.finditer(problem_statement):
+        inp = m.group(2).strip('\n')
+        out = m.group(3).strip()
+        if inp.strip() and out:
+            samples.append((inp + '\n', out))
+    return samples
+
+
+def _normalize(text):
+    return [line.rstrip() for line in text.strip().splitlines()]
+
+
+def tool_function(file_path, problem_statement, timeout=DEFAULT_TIMEOUT):
+    if timeout is None:
+        timeout = DEFAULT_TIMEOUT
+    if not os.path.isfile(file_path):
+        return f"Error: file not found: {file_path}"
+    samples = extract_samples(problem_statement or "")
+    if not samples:
+        return "Error: no sample input/output pairs found in the problem statement."
+
+    lines = []
+    all_passed = True
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        try:
+            proc = subprocess.run(
+                [sys.executable, file_path],
+                input=inp, capture_output=True, text=True, timeout=timeout,
+            )
+            actual = proc.stdout
+            stderr = proc.stderr
+            status_note = ""
+        except subprocess.TimeoutExpired as e:
+            actual = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or "")
+            stderr = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or "")
+            status_note = f"TIMEOUT after {timeout}s"
+        passed = not status_note and _normalize(actual) == _normalize(expected)
+        all_passed = all_passed and passed
+        lines.append(f"=== Sample {idx}: {'PASS' if passed else 'FAIL'} ===")
+        if status_note:
+            lines.append(status_note)
+        lines.append("--- input ---")
+        lines.append(inp.rstrip('\n'))
+        lines.append("--- expected output ---")
+        lines.append(expected)
+        lines.append("--- actual output ---")
+        lines.append(actual.rstrip('\n'))
+        lines.append("--- stderr ---")
+        lines.append(stderr.rstrip('\n'))
+        lines.append("")
+    summary = "ALL SAMPLES PASSED" if all_passed else "SOME SAMPLES FAILED"
+    return f"{summary} ({len(samples)} samples)\n\n" + "\n".join(lines)
