@@ -0,0 +1,116 @@
+import os
+import re
+import subprocess
+import sys
+
+SAMPLE_TIMEOUT = 10  # seconds per sample
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution against the sample tests embedded in a problem statement.\n
+* Parses every 'Sample Input N' / 'Sample Output N' block (case-insensitive, with or without colon/heading markers).\n
+* Runs `python <solution_path>` on each sample input with a timeout, feeding the input via stdin.\n
+* Returns PASS/FAIL per sample, plus the expected and actual output for each failing sample.\n
+* Use this tool to verify the solution file instead of writing your own harness.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_statement_path_or_text": {
+                    "type": "string",
+                    "description": "Either the path to a file containing the problem statement, or the statement text itself.",
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run.",
+                },
+            },
+            "required": ["problem_statement_path_or_text", "solution_path"],
+        },
+    }
+
+
+_SAMPLE_RE = re.compile(
+    r"(?:^|\n)[#*_\s]*sample\s+(input|output)\s*(\d+)?[*_:\s]*\n(.*?)(?=\n[#*_\s]*sample\s+(?:input|output)|\n[#*_\s]*(?:explanation|note|constraints)\b|\Z)",
+    flags=re.IGNORECASE | re.DOTALL,
+)
+
+
+def _load_statement(path_or_text):
+    if path_or_text and os.path.isfile(path_or_text):
+        with open(path_or_text, "r", encoding="utf-8", errors="replace") as f:
+            return f.read()
+    return path_or_text or ""
+
+
+def _parse_samples(text):
+    """Return a list of (index, input_text, output_text) tuples in order of appearance."""
+    inputs, outputs = {}, {}
+    order = []
+    auto = 0
+    for m in _SAMPLE_RE.finditer(text):
+        kind = m.group(1).lower()
+        if m.group(2):
+            idx = int(m.group(2))
+        else:
+            auto += 1
+            idx = auto
+        body = m.group(3)
+        # Strip code fences and surrounding whitespace
+        body = re.sub(r"^```[^\n]*\n|```\s*$", "", body.strip("\n"), flags=re.MULTILINE)
+        body = body.strip("\n")
+        if idx not in order:
+            order.append(idx)
+        (inputs if kind == "input" else outputs)[idx] = body
+    samples = []
+    for idx in order:
+        if idx in inputs and idx in outputs:
+            samples.append((idx, inputs[idx], outputs[idx]))
+    return samples
+
+
+def _normalize(out):
+    return [line.rstrip() for line in out.strip().splitlines()]
+
+
+def tool_function(problem_statement_path_or_text, solution_path):
+    text = _load_statement(problem_statement_path_or_text)
+    samples = _parse_samples(text)
+    if not samples:
+        return "No 'Sample Input N' / 'Sample Output N' blocks found in the problem statement."
+    if not os.path.isfile(solution_path):
+        return f"Solution file not found: {solution_path}"
+
+    lines = []
+    passed = 0
+    for idx, inp, expected in samples:
+        input_data = inp.rstrip("\n") + "\n"
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=input_data,
+                capture_output=True,
+                text=True,
+                timeout=SAMPLE_TIMEOUT,
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f"Sample {idx}: FAIL (timed out after {SAMPLE_TIMEOUT}s)")
+            lines.append(f"  input: {inp!r}")
+            continue
+        actual = proc.stdout
+        if proc.returncode != 0:
+            lines.append(f"Sample {idx}: FAIL (exit code {proc.returncode})")
+            lines.append(f"  stderr: {proc.stderr.strip()[-1000:]}")
+            lines.append(f"  expected: {expected!r}")
+            continue
+        if _normalize(actual) == _normalize(expected):
+            passed += 1
+            lines.append(f"Sample {idx}: PASS")
+        else:
+            lines.append(f"Sample {idx}: FAIL")
+            lines.append(f"  input: {inp!r}")
+            lines.append(f"  expected: {expected!r}")
+            lines.append(f"  actual: {actual!r}")
+    header = f"{passed}/{len(samples)} samples passed."
+    return header + "\n" + "\n".join(lines)
