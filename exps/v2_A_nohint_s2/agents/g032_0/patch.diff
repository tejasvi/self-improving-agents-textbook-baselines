+                f"2. Explore small cases with {brute_path} to find structure/invariants.\n"
+                f"3. Implement the intended efficient algorithm in {target_name} with the editor tool, and include a written complexity analysis against the constraints in your reply.\n"
+                "4. Save a max-constraint input to /tmp/max_input.txt and a random small-case generator to /tmp/gen.py (it must print one random small input to stdout).\n"
+                "5. Keep temporary files outside the repository."
+            )
+        else:
+            body = (
+                f"This is attempt {attempt}. The previous attempt failed these checks:\n{feedback}\n"
+                f"Fix {target_name} with the editor tool so that samples, stress tests (/tmp/gen.py vs {brute_path}) "
+                "and the max-size performance run (/tmp/max_input.txt, 10s limit, 1GB memory) all pass."
+            )
+        return f"{problem_header}\n{common}\n{body}\nReply briefly when done."
+
+    def _file_is_identical(self, target_path, other_path):
+        try:
+            with open(target_path) as a, open(other_path) as b:
+                return a.read() == b.read()
+        except OSError:
+            return False
+
+    def _run_perf_check(self, target_path):
+        """Run target on /tmp/max_input.txt with time and memory limits. Returns (ok, raw_output)."""
+        if not os.path.exists("/tmp/max_input.txt"):
+            return False, "/tmp/max_input.txt does not exist; create a max-constraint input there."
+        def limit_mem():
+            import resource
+            resource.setrlimit(resource.RLIMIT_AS, (1024 ** 3, 1024 ** 3))
+        try:
+            with open("/tmp/max_input.txt") as f:
+                proc = subprocess.run(["python", target_path], stdin=f, capture_output=True,
+                                      text=True, timeout=10, cwd=self.git_tempdir, preexec_fn=limit_mem)
+        except subprocess.TimeoutExpired:
+            return False, "TIMEOUT after 10s on /tmp/max_input.txt"
+        if proc.returncode != 0:
+            return False, f"exit code {proc.returncode}\nstderr:\n{proc.stderr[-3000:]}"
+        return True, "ok"
+
+    def _run_stress_check(self, target_path, brute_path, iterations=100):
+        """Compare target vs brute on generated inputs from /tmp/gen.py. Returns (ok, raw_output)."""
+        if not os.path.exists("/tmp/gen.py"):
+            return False, "/tmp/gen.py does not exist; write a random small-case generator there."
+        for i in range(iterations):
+            try:
+                inp = subprocess.run(["python", "/tmp/gen.py"], capture_output=True, text=True, timeout=10).stdout
+                a = subprocess.run(["python", target_path], input=inp, capture_output=True, text=True, timeout=10)
+                b = subprocess.run(["python", brute_path], input=inp, capture_output=True, text=True, timeout=10)
+            except subprocess.TimeoutExpired as e:
+                return False, f"TIMEOUT in stress iteration {i}: {e}"
+            if a.stdout.split() != b.stdout.split():
+                return False, (f"MISMATCH at iteration {i}\ninput:\n{inp}\n"
+                               f"solution output: {a.stdout!r}\nbrute output: {b.stdout!r}\nsolution stderr: {a.stderr[-1000:]!r}")
+        return True, f"{iterations} random cases matched"
+
+
