+                with open(target_path, 'w') as f:
+                    f.write(stub_content)
+                safe_log(f"Created stub target file: {target_path}")
+            except OSError as e:
+                safe_log(f"Failed to create stub {target_path}: {repr(e)}", level=logging.ERROR)
