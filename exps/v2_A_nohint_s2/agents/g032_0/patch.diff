+            samples_ok = self._samples_all_pass(samples_report)
+            stress_ok, stress_out = self._run_stress_check(target_path, brute_path)
+            perf_ok, perf_out = self._run_perf_check(target_path)
+            safe_log(f"[opt] attempt {attempt}: samples={samples_ok} stress={stress_ok} perf={perf_ok}")
