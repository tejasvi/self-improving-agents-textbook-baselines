+            (f"Write any correct Python solution to {target_name} now using the editor tool."),
+        ]
+        brute_ok = False
+        for attempt, prompt in enumerate(brute_prompts, start=1):
+            if attempt > 3:
+                break
+            safe_log(f"[brute stage] attempt {attempt}")
+            _, ok = self._run_agent(prompt, [])
+            if not ok or self._file_is_stub_or_empty(target_path, stub_content):
+                safe_log(f"[brute stage] attempt {attempt}: empty turn or file unchanged; retrying.", level=logging.ERROR)
+                continue
