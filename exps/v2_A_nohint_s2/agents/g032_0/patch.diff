+    def forward(self):
+        """
+        The forward function for the AgenticSystem.
+        Stages: brute force -> optimization/stress test -> performance check.
+        """
+        problem_header = f"""I have uploaded a code repository in the directory {self.git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {self.git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
