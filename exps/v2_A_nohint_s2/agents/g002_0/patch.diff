+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the last assistant message ('' if none or empty)."""
+        for msg in reversed(msg_history or []):
+            if msg.get("role") != "assistant":
+                continue
+            content = msg.get("content")
+            if isinstance(content, str):
+                return content.strip()
+            texts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    text = block.get("text")
+                else:
+                    text = getattr(block, "text", None)
+                if text:
+                    texts.append(text)
+            return "\n".join(texts).strip()
+        return ""
+
+    def _target_file(self):
+        """Pick the target file: a *.py file named in the problem statement, else solution.py."""
+        match = re.search(r'`([\w./]+\.py)`', self.problem_statement or "")
+        name = match.group(1) if match else "solution.py"
+        return os.path.join(self.git_tempdir, name.lstrip("/"))
+
+    def _fallback_write_solution(self):
+        """Ask the model for the full program in a ```python block and write it to the target file."""
+        target = self._target_file()
+        prompt = (
+            "Write the complete, final Python program for the problem below. "
+            "Reply with ONLY the complete program inside a single ```python fenced code block. "
+            "The program must read from standard input and write to standard output "
+            "(or implement the required Solution class if the problem asks for one). "
+            "You may use tools if you need to, but the code block in your final reply is what will be used.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>"
+        )
+        msg_history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        text = self._last_assistant_text(msg_history)
+        blocks = re.findall(r"```(?:python3?|py)?[ \t]*\n(.*?)```", text, flags=re.DOTALL)
+        if not blocks:
+            safe_log("Fallback: no ```python block found in reply.")
+            return False
+        code = max(blocks, key=len)
+        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
+        with open(target, "w") as f:
+            f.write(code)
+        safe_log(f"Fallback: wrote solution to {target}")
+        return True
+
