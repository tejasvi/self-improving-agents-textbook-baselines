+    def _target_file_ok(self):
+        """
+        True if solution.py (or any new/modified .py file in the diff) exists
+        and passes `python -m py_compile`.
+        """
+        candidates = []
+        solution_path = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.isfile(solution_path):
+            candidates.append(solution_path)
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        for line in diff.splitlines():
+            if line.startswith('+++ b/') and line.endswith('.py'):
+                path = os.path.join(self.git_tempdir, line[len('+++ b/'):].strip())
+                if os.path.isfile(path) and path not in candidates:
+                    candidates.append(path)
+        if not candidates:
+            return False
+        for path in candidates:
+            try:
+                result = subprocess.run(
+                    [sys.executable, '-m', 'py_compile', path],
+                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60, check=False,
+                )
+            except subprocess.TimeoutExpired:
+                return False
+            if result.returncode != 0:
+                safe_log(f"py_compile failed for {path}: {result.stderr.decode(errors='replace')}")
+                return False
+        return True
+
+    def _extract_code_block(self, text):
+        """Return the contents of the first ```python fenced block in text, or None."""
+        if not text:
+            return None
+        match = re.search(r"```python[ \t]*\n(.*?)```", text, re.DOTALL)
+        return match.group(1) if match else None
+
+    def _last_assistant_text(self, msg_history):
+        """Concatenate the text of the last assistant message in msg_history."""
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    parts.append(block.get('text', ''))
+                elif hasattr(block, 'text') and isinstance(getattr(block, 'text'), str):
+                    parts.append(block.text)
+            return '\n'.join(parts)
+        return ''
+
