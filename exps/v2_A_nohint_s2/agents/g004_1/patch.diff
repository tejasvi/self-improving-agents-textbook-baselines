+    def _target_file_path(self):
+        """Detect a target filename (e.g. `solution.py`) named in the problem statement."""
+        match = re.search(r'`([\w./]+\.py)`', self.problem_statement or '')
+        if not match:
+            return None
+        return os.path.join(self.git_tempdir, match.group(1))
