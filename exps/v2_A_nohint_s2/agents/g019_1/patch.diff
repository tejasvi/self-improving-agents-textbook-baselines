+def _run_blocking(command, timeout):
+    """Run a command in its own process group; kill the group on timeout.
+
+    Returns (stdout, stderr, timed_out). Partial output is returned on timeout.
+    """
+    proc = subprocess.Popen(
+        ["/bin/bash", "-c", command],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        stdin=subprocess.DEVNULL,
+        env=os.environ.copy(),
+        start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(timeout=timeout)
+        return out.decode(errors="ignore"), err.decode(errors="ignore"), False
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        try:
+            out, err = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            out, err = b"", b""
+        out = (out or b"").decode(errors="ignore")
+        err = (err or b"").decode(errors="ignore")
+        return out, err, True
+
