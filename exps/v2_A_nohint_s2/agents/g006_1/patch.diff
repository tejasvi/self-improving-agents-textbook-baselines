+def _has_changes(git_tempdir, base_commit):
+    """
+    Return True if the repository differs from base_commit (tracked or untracked files).
+    """
+    return bool(diff_versus_commit(git_tempdir, base_commit).strip())
+
+def _find_target_file(git_tempdir):
+    """
+    Locate the stub file the agent should edit, as a path relative to git_tempdir.
+    Preference: solution.py, then a git-tracked .py file containing a
+    'Write your solution here' comment or a `class Solution`, then the first .py file.
+    """
+    result = subprocess.run(
+        ["git", "-C", git_tempdir, "ls-files"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+    )
+    files = result.stdout.decode(errors='replace').splitlines()
+    py_files = [f for f in files if f.endswith('.py')]
+
+    for f in py_files:
+        if os.path.basename(f) == 'solution.py':
+            return f
+
+    for f in py_files:
+        try:
+            with open(os.path.join(git_tempdir, f), 'r', encoding='utf-8', errors='replace') as fh:
+                content = fh.read()
+        except OSError:
+            continue
+        if 'Write your solution here' in content or re.search(r'^\s*class\s+Solution\b', content, re.MULTILINE):
+            return f
+
+    if py_files:
+        return py_files[0]
+    return 'solution.py'
+
+def _message_text(msg):
+    """
+    Extract plain text from a chat history entry (Claude-style content blocks,
+    OpenAI-style objects, or plain strings).
+    """
+    if isinstance(msg, dict):
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict) and isinstance(block.get('text'), str):
+                    parts.append(block['text'])
+                elif isinstance(getattr(block, 'text', None), str):
+                    parts.append(block.text)
+            return "\n".join(parts)
+        return str(msg)
+    output_text = getattr(msg, 'output_text', None)
+    if isinstance(output_text, str):
+        return output_text
+    return str(msg)
+
+def _extract_last_python_block(msg_history):
+    """
+    Return the content of the last ```python fenced block in the history, or None.
+    """
+    pattern = re.compile(r'```python[ \t]*\n(.*?)```', re.DOTALL)
+    for msg in reversed(msg_history):
+        matches = pattern.findall(_message_text(msg))
+        if matches:
+            return matches[-1]
+    return None
