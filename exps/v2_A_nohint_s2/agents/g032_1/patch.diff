diff --git a/tools/time_solution.py b/tools/time_solution.py
new file mode 100644
index 0000000..a0d7f30
--- /dev/null
+++ b/tools/time_solution.py
@@ -0,0 +1,140 @@
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+DEFAULT_TIMEOUT = 10
+MAX_OUTPUT_CHARS = 1000
+
+# Harness executed in a child process for class-method entry points.
+# It runs the generator, imports the solution file, times one call and prints a JSON line.
+_METHOD_HARNESS = r'''
+import importlib.util, json, sys, time
+path, entry, gen_code = sys.argv[1], sys.argv[2], sys.argv[3]
+ns = {}
+exec(gen_code, ns)
+args = ns["gen"]()
+if not isinstance(args, tuple):
+    args = (args,)
+spec = importlib.util.spec_from_file_location("user_solution", path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+cls_name, meth_name = entry.split(".", 1)
+obj = getattr(mod, cls_name)()
+fn = getattr(obj, meth_name)
+t0 = time.perf_counter()
+res = fn(*args)
+el = time.perf_counter() - t0
+print(json.dumps({"elapsed": el, "result": repr(res)[:500]}))
+'''
+
+
+def tool_info():
+    return {
+        "name": "time_solution",
+        "description": """Time a solution on a generated max-size input, in a subprocess with a hard timeout.\n
+* Use this to check the worst-case runtime of a solution against the constraints in the problem statement.\n
+* 'generator_code' is a Python snippet that defines a function gen() with no arguments.
+  - For entry='stdin': gen() must return the full stdin text (a string) for the program.
+  - For entry like 'Solution.methodName': gen() must return a tuple of the arguments to pass to the method (a single non-tuple value is also accepted as one argument).
+  - The generator runs before timing starts; only the solution's execution is timed.
+* 'entry' is 'stdin' to run the file as a complete program (input via stdin), or 'ClassName.method' to call a method of a class in the file.
+* Returns plain text: 'OK elapsed=<seconds>s' with the output/result preview, or 'TIMEOUT after <N>s' if the run exceeded the timeout, or the error traceback / exit code on failure.
+* The timing is only meaningful for the worst-case size; generate the largest input allowed by the constraints.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to time."
+                },
+                "generator_code": {
+                    "type": "string",
+                    "description": "Python source defining gen() that returns the max-size input (stdin text, or a tuple of method arguments)."
+                },
+                "entry": {
+                    "type": "string",
+                    "description": "'stdin' to run the file as a program, or 'ClassName.method' (e.g. 'Solution.maxDistance') to call a method."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the timed run. Defaults to 10."
+                }
+            },
+            "required": ["file_path", "generator_code", "entry"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    text = text or ""
+    if len(text) > limit:
+        return text[:limit] + f"\n... [truncated {len(text) - limit} chars]"
+    return text
+
+
+def _run_stdin(file_path, generator_code, timeout):
+    ns = {}
+    try:
+        exec(generator_code, ns)
+        input_text = ns["gen"]()
+    except Exception as e:
+        return f"ERROR: generator_code failed: {type(e).__name__}: {e}"
+    if isinstance(input_text, bytes):
+        input_text = input_text.decode()
+    if not isinstance(input_text, str):
+        input_text = str(input_text)
+    t0 = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            [sys.executable, file_path],
+            input=input_text, capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s (program did not finish on the generated max-size input)"
+    elapsed = time.perf_counter() - t0
+    if proc.returncode != 0:
+        return (f"ERROR: exit code {proc.returncode} after {elapsed:.3f}s\n"
+                f"stdout:\n{_truncate(proc.stdout)}\nstderr:\n{_truncate(proc.stderr)}")
+    return (f"OK elapsed={elapsed:.3f}s\n"
+            f"stdout preview:\n{_truncate(proc.stdout)}\n"
+            f"stderr:\n{_truncate(proc.stderr)}")
+
+
+def _run_method(file_path, entry, generator_code, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", _METHOD_HARNESS, file_path, entry, generator_code],
+            capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s (method {entry} did not return on the generated max-size input)"
+    if proc.returncode != 0:
+        return f"ERROR: exit code {proc.returncode}\nstdout:\n{_truncate(proc.stdout)}\nstderr:\n{_truncate(proc.stderr)}"
+    lines = [ln for ln in proc.stdout.strip().splitlines() if ln.strip()]
+    if not lines:
+        return f"ERROR: harness produced no output\nstderr:\n{_truncate(proc.stderr)}"
+    try:
+        data = json.loads(lines[-1])
+    except json.JSONDecodeError:
+        return f"ERROR: unexpected harness output\n{_truncate(proc.stdout)}"
+    return f"OK elapsed={data['elapsed']:.3f}s\nresult preview: {data['result']}"
+
+
+def tool_function(file_path, generator_code, entry, timeout=DEFAULT_TIMEOUT):
+    try:
+        timeout = int(timeout) if timeout is not None else DEFAULT_TIMEOUT
+    except (TypeError, ValueError):
+        timeout = DEFAULT_TIMEOUT
+    if timeout <= 0:
+        timeout = DEFAULT_TIMEOUT
+    if not os.path.isfile(file_path):
+        return f"ERROR: file not found: {file_path}"
+    entry = (entry or "").strip()
+    if entry == "stdin":
+        return _run_stdin(file_path, generator_code, timeout)
+    if "." not in entry:
+        return f"ERROR: entry must be 'stdin' or 'ClassName.method', got {entry!r}"
+    return _run_method(file_path, entry, generator_code, timeout)
