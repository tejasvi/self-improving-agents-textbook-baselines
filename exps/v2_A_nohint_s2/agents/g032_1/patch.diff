+FAILURE_KEYWORDS = ('timeout', 'timed out', 'exit 124', 'fail', 'tle', 'too slow', 'not complete', 'exit code')
+
+def _turn_ended_without_action(history):
+    """
+    Return True if the last assistant message contains no tool_use block.
+    """
+    for msg in reversed(history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role != 'assistant':
+            continue
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, list):
+            for block in content:
+                btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+                if btype == 'tool_use':
+                    return False
+        return True
+    return True
+
+def _last_output_has_failure(history):
+    """
+    Return True if the last non-empty message (tool output or assistant text) mentions a failure keyword.
+    """
+    for msg in reversed(history or []):
+        lowered = _message_text(msg).lower()
+        if not lowered.strip():
+            continue
+        return any(re.search(r'(?<![a-z])' + re.escape(k) + r'(?![a-z])', lowered) for k in FAILURE_KEYWORDS)
+    return False
+
+def _turn_text_signals_unfinished(history):
+    """
+    Return True if the last assistant turn has no tool call and its text says work is still pending.
+    """
+    if not _turn_ended_without_action(history):
+        return False
+    for msg in reversed(history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role == 'assistant':
+            lowered = _message_text(msg).lower()
+            return any(k in lowered for k in ("i'll", "i will", "will rewrite", "need to fix", "not complete", "timed out", "let me"))
+    return False
+
+def _last_test_passed(history):
+    """
+    Return True if the last message mentions a pass marker for both the examples and the timing test.
+    """
+    for msg in reversed(history or []):
+        lowered = _message_text(msg).lower()
+        if not lowered.strip():
+            continue
+        return ('pass' in lowered and 'ok elapsed' in lowered) or ('all examples pass' in lowered and 'stress' in lowered)
+    return False
+
