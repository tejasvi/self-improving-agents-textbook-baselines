+    @staticmethod
+    def _last_assistant_is_empty(history):
+        """
+        Return True if the last assistant message in `history` has no tool use and no
+        non-empty text. Handles Claude-style dict messages (content blocks) and
+        OpenAI-style response objects (with `.output`) as well as plain dicts.
+        """
+        if not history:
+            return True
+        for msg in reversed(history):
+            if isinstance(msg, dict):
+                role = msg.get('role')
+                content = msg.get('content')
+            else:
+                role = getattr(msg, 'role', None)
+                content = getattr(msg, 'content', None)
+                if role is None and hasattr(msg, 'output'):
+                    # OpenAI response object: inspect its output items
+                    role = 'assistant'
+                    content = getattr(msg, 'output', None)
+                    for item in content or []:
+                        if getattr(item, 'type', None) in ('function_call', 'tool_use'):
+                            return False
+                        for part in getattr(item, 'content', None) or []:
+                            if (getattr(part, 'text', '') or '').strip():
+                                return False
+                    return True
+            if role != 'assistant':
+                continue
+            if content is None:
+                return True
+            if isinstance(content, str):
+                return not content.strip()
+            for block in content:
+                if isinstance(block, dict):
+                    btype = block.get('type')
+                    if btype in ('tool_use', 'function_call'):
+                        return False
+                    if (block.get('text') or '').strip():
+                        return False
+                else:
+                    btype = getattr(block, 'type', None)
+                    if btype in ('tool_use', 'function_call'):
+                        return False
+                    if (getattr(block, 'text', '') or '').strip():
+                        return False
+            return True
+        return True
+
