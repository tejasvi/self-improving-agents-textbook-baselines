+from typing import List
+
+
+class Solution:
+    def maxDistance(self, side: int, points: List[List[int]], k: int) -> int:
+        # Map each boundary point to its position along the perimeter, in [0, 4*side).
+        perim = 4 * side
+
+        def pos(x: int, y: int) -> int:
+            if y == 0:
+                return x
+            if x == side:
+                return side + y
+            if y == side:
+                return 3 * side - x
+            return 4 * side - y  # x == 0
+
+        pts = sorted((pos(x, y), x, y) for x, y in points)
+        n = len(pts)
+        # Doubled array to handle the cyclic wrap-around.
+        ext = pts + [(p + perim, x, y) for p, x, y in pts]
+
+        def manhattan(a, b) -> int:
+            return abs(a[1] - b[1]) + abs(a[2] - b[2])
+
+        def feasible(d: int) -> bool:
+            # Pick k points on the cycle with all pairwise Manhattan distances >= d.
+            # Try each start point; greedily take the next point in perimeter order
+            # that is far enough from the current one, and check the wrap-around.
+            if k <= 1:
+                return True
+            for s in range(n):
+                start = ext[s]
+                cur = start
+                count = 1
+                j = s + 1
+                while count < k and j < s + n:
+                    if manhattan(cur, ext[j]) >= d:
+                        cur = ext[j]
+                        count += 1
+                    j += 1
+                if count >= k and manhattan(cur, start) >= d:
+                    return True
+            return False
+
+        lo, hi = 0, 2 * side
+        while lo < hi:
+            mid = (lo + hi + 1) // 2
+            if feasible(mid):
+                lo = mid
+            else:
+                hi = mid - 1
+        return lo
