+def _block_text(block):
+    """Return the text of a content block (dict or SDK object), or None if it has no text field."""
+    if isinstance(block, dict):
+        if block.get('type') == 'text' or 'text' in block:
+            value = block.get('text')
+            return value if isinstance(value, str) else None
+        return None
+    value = getattr(block, 'text', None)
+    return value if isinstance(value, str) else None
+
+def _clean_history(history):
+    """
+    Return a copy of the message history with empty / whitespace-only text blocks removed,
+    and messages left with no content dropped.
+    """
+    cleaned = []
+    for msg in history or []:
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            if not content.strip():
+                continue
+            new_msg = dict(msg)
+        elif isinstance(content, list):
+            new_blocks = []
+            for block in content:
+                text = _block_text(block)
+                if text is not None and not text.strip():
+                    continue
+                new_blocks.append(block)
+            if not new_blocks:
+                continue
+            new_msg = dict(msg)
+            new_msg['content'] = new_blocks
+        else:
+            if content is None:
+                continue
+            new_msg = dict(msg)
+        cleaned.append(new_msg)
+    return cleaned
+
+def _message_text(msg):
+    """Concatenate the text of a message whose content is a string or a list of blocks."""
+    if not isinstance(msg, dict):
+        return ''
+    content = msg.get('content')
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = [_block_text(b) for b in content]
+        return '\n'.join(p for p in parts if p)
+    return ''
+
+def _last_python_block(history):
+    """Return the code of the last ```python fenced block found in the history (searching newest first), or None."""
+    for msg in reversed(history or []):
+        text = _message_text(msg)
+        matches = re.findall(r"```python[ \t]*\n(.*?)```", text, re.DOTALL)
+        if matches:
+            return matches[-1]
+    return None
+
