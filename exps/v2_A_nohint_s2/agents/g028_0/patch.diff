new file mode 100644
index 0000000..2bb2cbc
--- /dev/null
+++ b/utils/stress_check.py
@@ -0,0 +1,26 @@
+import os
+import sys
+import subprocess
+
+def run_stress_check(solution_path, brute_path, generator_path, trials=200, timeout_seconds=10):
+    """Re-run the stress test outside the agent. Returns (passed: bool, report: str)."""
+    script = (
+        "import sys, json\n"
+        "sys.path.insert(0, sys.argv[1])\n"
+        "from tools.stress_test import tool_function\n"
+        "print(tool_function(sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5]), int(sys.argv[6])))\n"
+    )
+    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", script, repo_root, solution_path, brute_path, generator_path,
+             str(trials), str(timeout_seconds)],
+            capture_output=True, text=True,
+            timeout=trials * timeout_seconds * 3 + 60,
+        )
+    except subprocess.TimeoutExpired:
+        return False, "FAIL: stress check overall timeout"
+    report = (proc.stdout or "").strip()
+    if proc.returncode != 0 or not report:
+        return False, f"FAIL: stress check crashed: {(proc.stderr or '')[-500:]}"
+    return report.splitlines()[-1].startswith("PASS"), report
