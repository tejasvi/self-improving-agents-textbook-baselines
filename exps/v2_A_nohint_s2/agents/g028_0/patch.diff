diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..cd29da7
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,117 @@
+import os
+import subprocess
+import sys
+
+MAX_INPUT_CHARS = 500
+MAX_OUTPUT_CHARS = 500
+STDERR_TAIL_CHARS = 300
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Compare a solution against a brute-force reference on random inputs.
+
+* solution_path and brute_path are Python scripts that read stdin and write stdout.
+* generator_path is a script that takes an integer seed as argv[1] and prints ONE test input to stdout.
+* For each seed in 0..trials-1 the generator is run, then both the solution and the brute force are run on its output, and their stripped stdout is compared.
+* Returns 'PASS: N trials' if all match, otherwise a compact FAIL report with the failing input, both outputs, and the stderr tail.
+* Timeouts and runtime errors are reported as failures.
+* Use absolute paths. Run this after writing /tmp/brute.py and /tmp/gen.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference script (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random generator script; takes the seed as argv[1] and prints one test input to stdout."
+                },
+                "trials": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test. Default 200."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Per-process timeout in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _tail(text, limit):
+    text = text or ""
+    return text if len(text) <= limit else "..." + text[-limit:]
+
+
+def _head(text, limit):
+    text = text or ""
+    return text if len(text) <= limit else text[:limit] + "..."
+
+
+def _run(script, stdin_text, timeout, args=()):
+    """Run a Python script; returns (stdout, stderr, error_or_None)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, script, *args],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "", "", f"TIMEOUT after {timeout}s"
+    if proc.returncode != 0:
+        return proc.stdout, proc.stderr, f"RUNTIME ERROR (exit code {proc.returncode})"
+    return proc.stdout, proc.stderr, None
+
+
+def tool_function(solution_path, brute_path, generator_path, trials=200, timeout_seconds=10):
+    try:
+        trials = int(trials)
+        timeout_seconds = int(timeout_seconds)
+    except (TypeError, ValueError):
+        return "ERROR: trials and timeout_seconds must be integers."
+    for label, path in (("solution_path", solution_path), ("brute_path", brute_path), ("generator_path", generator_path)):
+        if not path or not os.path.isfile(path):
+            return f"ERROR: {label} does not exist: {path}"
+    if trials <= 0:
+        return "ERROR: trials must be positive."
+
+    for seed in range(trials):
+        gen_out, gen_err, gen_problem = _run(generator_path, "", timeout_seconds, args=(str(seed),))
+        if gen_problem:
+            return (f"FAIL on seed {seed}: generator {gen_problem}\n"
+                    f"stderr tail: {_tail(gen_err, STDERR_TAIL_CHARS)}")
+        test_input = gen_out
+
+        sol_out, sol_err, sol_problem = _run(solution_path, test_input, timeout_seconds)
+        brute_out, brute_err, brute_problem = _run(brute_path, test_input, timeout_seconds)
+
+        if brute_problem:
+            return (f"FAIL on seed {seed}: brute force {brute_problem} (the reference itself is broken; fix /tmp/brute.py)\n"
+                    f"input: {_head(test_input, MAX_INPUT_CHARS)!r}\n"
+                    f"brute stderr tail: {_tail(brute_err, STDERR_TAIL_CHARS)}")
+
+        if sol_problem:
+            return (f"FAIL on seed {seed}: solution {sol_problem}\n"
+                    f"input: {_head(test_input, MAX_INPUT_CHARS)!r}\n"
+                    f"expected (brute): {_head(brute_out.strip(), MAX_OUTPUT_CHARS)!r}\n"
+                    f"solution stderr tail: {_tail(sol_err, STDERR_TAIL_CHARS)}")
+
+        if sol_out.strip() != brute_out.strip():
+            return (f"FAIL on seed {seed}: output mismatch\n"
+                    f"input: {_head(test_input, MAX_INPUT_CHARS)!r}\n"
+                    f"solution output: {_head(sol_out.strip(), MAX_OUTPUT_CHARS)!r}\n"
+                    f"brute output: {_head(brute_out.strip(), MAX_OUTPUT_CHARS)!r}\n"
+                    f"solution stderr tail: {_tail(sol_err, STDERR_TAIL_CHARS)}")
+
+    return f"PASS: {trials} trials"
