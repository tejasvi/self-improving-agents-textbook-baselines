+def _detect_problem_type(problem_statement):
+    """
+    Classify the task as 'interactive', 'solution_class' or 'stdin'.
+    """
+    text = problem_statement.lower()
+    if 'interactive problem' in text:
+        return 'interactive'
+    if 'class solution' in text:
+        return 'solution_class'
+    return 'stdin'
