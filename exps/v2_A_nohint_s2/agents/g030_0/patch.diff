+def _last_assistant_is_empty(msg_history):
+    """
+    Return True if the most recent assistant turn has no text (and therefore no
+    final answer), or if there is no assistant turn at all.
+    """
+    for msg in reversed(msg_history):
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            return not _message_text(msg).strip()
+    return True
