+# claude-3-5-sonnet-20241022 supports at most 8192 output tokens.
+CLAUDE_MAX_OUTPUT_TOKENS = 8192
+CLAUDE_THINKING_BUDGET_CAP = 4000
+
+def _claude_create(client, model, messages, tools, tool_choice, max_tokens, thinking):
+    kwargs = dict(
+        model=model,
+        messages=messages,
+        max_tokens=max_tokens,
+        tool_choice=tool_choice,
+        tools=tools,
+    )
+    if thinking:
+        kwargs['thinking'] = {
+            'type': 'enabled',
+            'budget_tokens': min(CLAUDE_THINKING_BUDGET_CAP, max_tokens // 3),
+        }
+    return client.messages.create(**kwargs)
+
+def _response_has_usable_content(response):
+    """True if the response has at least one text or tool_use block."""
+    content = getattr(response, 'content', None) or []
+    return any(getattr(b, 'type', None) in ('text', 'tool_use') for b in content)
+
+def _create_with_budget_retry(client, model, messages, tools, tool_choice,
+                              max_tokens, thinking, logging, max_retries=3):
+    """
+    Call Claude; if the response has no text/tool_use blocks (e.g. thinking used up
+    max_tokens), retry with thinking disabled and a doubled max_tokens (capped).
+    """
+    response = _claude_create(client, model, messages, tools, tool_choice, max_tokens, thinking)
+    retry_messages = list(messages)
+    for attempt in range(1, max_retries + 1):
+        if _response_has_usable_content(response):
+            break
+        logging(f"Empty Claude response (stop_reason={getattr(response, 'stop_reason', None)}, "
+                f"thinking={thinking}, max_tokens={max_tokens}); retry {attempt}/{max_retries}.")
+        thinking = False
+        max_tokens = min(max_tokens * 2, CLAUDE_MAX_OUTPUT_TOKENS)
+        retry_messages = retry_messages + [{
+            "role": "user",
+            "content": [{
+                "type": "text",
+                "text": "Do not think at length. Immediately use the editor tool to write a working solution.",
+            }],
+        }]
+        response = _claude_create(client, model, retry_messages, tools, tool_choice, max_tokens, thinking)
+    return response
+
