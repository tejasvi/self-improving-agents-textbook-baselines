+    def _parse_constraint_hint(self):
+        """Return (variable, bound) for the first 'N <= 5000'-style bound in the statement, or None."""
+        text = self.problem_statement or ''
+        m = re.search(r'\b([A-Za-z])\s*(?:\\le(?:q)?|<=|\u2264)\s*(\d+)', text)
+        if not m:
+            return None
+        return m.group(1), int(m.group(2))
