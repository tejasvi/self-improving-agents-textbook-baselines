+    def _time_on_large_input(self, target_path):
+        """Build a max-size input and time `python target_path` on it. Returns (elapsed, timed_out).
+        Returns (None, False) when the output is missing (treated as failure by the caller)."""
+        gen_path = "/tmp/gen_max.py"
