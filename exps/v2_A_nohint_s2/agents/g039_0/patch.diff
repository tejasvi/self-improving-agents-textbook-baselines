+    @staticmethod
+    def _has_tool_use(msg_history):
+        """Return True if the last assistant message contains a tool-use block."""
+        for msg in reversed(msg_history or []):
+            if msg.get("role") != "assistant":
+                continue
+            content = msg.get("content")
+            if isinstance(content, str):
+                return False
+            for block in content or []:
+                btype = block.get("type") if isinstance(block, dict) else getattr(block, "type", None)
+                if btype in ("tool_use", "tool_call", "function_call"):
+                    return True
+                if not isinstance(block, dict) and getattr(block, "tool_calls", None):
+                    return True
+            return False
+        return False
+
+    @classmethod
+    def _is_empty_reply(cls, msg_history):
+        """True if the last assistant message has no text and no tool-use blocks."""
+        return (not cls._last_assistant_text(msg_history)) and (not cls._has_tool_use(msg_history))
+
+    def _alternate_model(self):
+        """Return the other model from llm_withtools (CLAUDE_MODEL <-> OPENAI_MODEL)."""
+        return OPENAI_MODEL if self.code_model == CLAUDE_MODEL else CLAUDE_MODEL
+
+    def _call_with_escalation(self, prompt, msg_history):
+        """
+        Call the model, escalating through strategies while the reply is empty.
+        Returns the msg_history of the last attempt. Bounded: fixed list of strategies.
+        """
+        nudge = (
+            "Your last reply was empty. The solution must now be written to the target file "
+            "using the editor tool. Do not reply with an empty message: make the edit now, "
+            "then briefly say what you wrote.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>"
+        )
+        plan_prompt = (
+            "Plan only, no tools. In at most 200 words, describe the algorithm for the problem below "
+            "(approach, key data structures, time complexity, and how input/output is handled).\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>"
+        )
+        implement_prompt = (
+            "Now implement this plan with the editor tool: write the complete program into the target file "
+            f"in the repository at {self.git_tempdir} (a file named in the problem statement, or solution.py). "
+            "Do not reply with only text.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>"
+        )
+        alt = self._alternate_model()
+        strategies = [
+            ("continue_with_nudge", self.code_model, lambda: (nudge, list(msg_history))),
+            ("fresh_plan_then_implement", self.code_model, None),
+            ("alternate_model", alt, lambda: (prompt, [])),
+        ]
+        last_history = msg_history
+        for name, model, make in strategies:
+            if name == "fresh_plan_then_implement":
+                safe_log(f"Escalation strategy={name} model={model}: plan step")
+                hist = chat_with_agent(plan_prompt, model=model, msg_history=[], logging=safe_log)
+                plan_text = self._last_assistant_text(hist)
+                safe_log(f"Escalation strategy={name} model={model}: plan reply length={len(plan_text)}")
+                msg = f"{implement_prompt}\n\nPlan:\n{plan_text}"
+                hist = chat_with_agent(msg, model=model, msg_history=hist, logging=safe_log)
+            else:
+                msg, hist_in = make()
+                safe_log(f"Escalation strategy={name} model={model}: sending")
+                hist = chat_with_agent(msg, model=model, msg_history=hist_in, logging=safe_log)
+            reply = self._last_assistant_text(hist)
+            safe_log(f"Escalation strategy={name} model={model}: reply length={len(reply)} empty={self._is_empty_reply(hist)}")
+            last_history = hist
+            if not self._is_empty_reply(hist) or self._has_diff():
+                return hist
+        return last_history
+
