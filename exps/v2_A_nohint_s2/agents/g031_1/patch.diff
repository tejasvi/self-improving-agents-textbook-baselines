+SAMPLE_PATTERN = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n## |\Z)',
+    re.S,
+)
+STDLIB_NOTE = "Only the Python standard library is available; do not import numpy or other third-party packages."
+
+def _extract_samples(problem_statement):
+    """Return a list of (input_text, expected_output) pairs from 'Sample Input N' / 'Sample Output N' blocks."""
+    samples = []
+    for m in SAMPLE_PATTERN.finditer(problem_statement or ''):
+        sample_in = m.group(2).strip('\n') + '\n'
+        expected = m.group(3).strip()
+        samples.append((sample_in, expected))
+    return samples
+
+def _as_text(value):
+    """TimeoutExpired may carry bytes even when text=True; normalize to str."""
+    if value is None:
+        return ''
+    if isinstance(value, bytes):
+        return value.decode('utf-8', errors='replace')
+    return value
+
+def _run_samples(target_path, samples, max_report_chars=3000):
+    """
+    Run target_path (python -I -S, so site-packages such as numpy are unavailable, as in the grader)
+    on each sample. Returns (all_passed, report). Reports at most the first 3 failures.
+    """
+    if not samples:
+        return True, "No sample tests were found in the problem statement."
+    if not os.path.exists(target_path):
+        return False, f"Solution file {target_path} does not exist."
+    failures = []
+    for i, (sample_in, expected) in enumerate(samples, start=1):
+        if len(failures) >= 3:
+            break  # enough evidence; avoids N * 10s when every sample hangs
+        try:
+            proc = subprocess.run([sys.executable, '-I', '-S', target_path], input=sample_in,
+                                  capture_output=True, text=True, timeout=10)
+        except subprocess.TimeoutExpired as e:
+            out = _as_text(e.stdout)
+            err = _as_text(e.stderr)
+            failures.append(f"Sample {i}: TIMEOUT after 10s\nInput:\n{sample_in}"
+                            f"Expected output:\n{expected}\nStdout:\n{out[:max_report_chars]}\nStderr:\n{err[:max_report_chars]}")
+            continue
+        except OSError as e:
+            failures.append(f"Sample {i}: could not execute ({repr(e)})")
+            continue
+        got = proc.stdout.strip()
+        if proc.returncode == 0 and got == expected:
+            continue
+        failures.append(f"Sample {i}: FAIL (exit code {proc.returncode})\nInput:\n{sample_in}"
+                        f"Expected output:\n{expected}\nStdout:\n{proc.stdout[:max_report_chars]}"
+                        f"\nStderr:\n{proc.stderr[:max_report_chars]}")
+    if not failures:
+        return True, f"All {len(samples)} sample(s) passed."
+    header = f"Sample check failed ({len(samples)} sample(s) total). First failing samples (at most 3 shown):\n"
+    return False, header + "\n".join(failures[:3])
+
