     return any(pattern.search(normalized) for pattern in _TEST_FILE_PATTERNS)
 
 
+_COMMENT_PREFIXES = ('#', '//', '/*')
+
+
+def _substantive_added_lines_by_file(patch_str):
+    """
+    Map each file in a unified diff to the list of added lines that are not blank
+    and not comment-only (language-agnostic heuristic).
+    """
+    result = {}
+    current = None
+    for line in (patch_str or '').splitlines():
+        match = _DIFF_HEADER_RE.match(line)
+        if match:
+            current = match.group(2)
+            result.setdefault(current, [])
+            continue
+        if current is None or not line.startswith('+') or line.startswith('+++'):
+            continue
+        content = line[1:].strip()
+        if content and not content.startswith(_COMMENT_PREFIXES):
+            result[current].append(content)
+    return result
+
+
 def has_source_edits(patch_str):
     """
-    Return True if the patch changes at least one file that is not a test file.
+    Return True if the patch substantively changes at least one non-test file.
+    Patches that touch only test files, or only add blank/comment lines, do not count.
+    """
+    substantive = _substantive_added_lines_by_file(patch_str)
+    return any(not is_test_file(path) and lines for path, lines in substantive.items())
+
+
+def list_non_test_tracked_files(git_dname):
     """
-    return any(not is_test_file(path) for path in changed_files_from_patch(patch_str))
+    Return the git-tracked files in `git_dname` that are not test files, sorted by path.
+    Uses `git ls-files`, so it works for any language.
+    """
+    result = subprocess.run(
+        ["git", "-C", git_dname, "ls-files"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+    )
+    files = result.stdout.decode(errors='replace').splitlines()
+    return sorted(f for f in files if f and not is_test_file(f))
+
+
+def read_starter_files(git_dname, max_chars_per_file=4000, max_files=5):
+    """
+    Read the contents of the non-test tracked files in `git_dname`.
+    Returns a list of (relative_path, content) tuples. Unreadable files are skipped,
+    and long contents are truncated.
+    """
+    contents = []
+    for rel_path in list_non_test_tracked_files(git_dname):
+        if len(contents) >= max_files:
+            break
+        full_path = os.path.join(git_dname, rel_path)
+        try:
+            with open(full_path, 'r', encoding='utf-8') as f:
+                text = f.read()
+        except (OSError, UnicodeDecodeError):
+            continue
+        if len(text) > max_chars_per_file:
+            text = text[:max_chars_per_file] + "\n<truncated>"
+        contents.append((rel_path, text))
+    return contents
