+    def _run_differential_check(self):
+        """
+        Run the differential-test harness at HARNESS_PATH with a timeout.
+        Returns the raw result dict from run_script (returncode, output, timed_out),
+        or None if the harness file does not exist. No error parsing is performed.
+        """
+        if not os.path.isfile(HARNESS_PATH):
+            return None
+        return run_script(HARNESS_PATH, timeout=120, max_chars=4000, cwd=self.git_tempdir)
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the last assistant message ('' if none or empty)."""
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                parts = []
+                for block in content:
+                    if isinstance(block, dict) and isinstance(block.get('text'), str):
+                        parts.append(block['text'])
+                    elif isinstance(block, str):
+                        parts.append(block)
+                return '\n'.join(parts)
+            return ''
+        return ''
+
