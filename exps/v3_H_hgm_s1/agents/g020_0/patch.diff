+    def _call_agent_safely(self, prompt, model, msg_history):
+        """
+        Calls chat_with_agent and classifies the outcome.
+        Returns (msg_history, status) where status is 'ok', 'empty' or 'error'.
+        'empty' means no assistant text and no tool_use/tool_result block in the history.
+        """
+        try:
+            result = chat_with_agent(prompt, model=model, msg_history=msg_history, logging=safe_log)
+        except Exception:
+            safe_log(f"[call_agent] chat_with_agent raised with model={model}:\n{traceback.format_exc()}", level=logging.ERROR)
+            return msg_history, 'error'
+        if isinstance(result, list):
+            msg_history = result
+        has_tool_block = False
+        for msg in msg_history or []:
+            content = msg.get("content") if isinstance(msg, dict) else None
+            if isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict) and block.get("type") in ("tool_use", "tool_result"):
+                        has_tool_block = True
+                        break
+            if has_tool_block:
+                break
+        if not self._last_assistant_text(msg_history).strip() and not has_tool_block:
+            safe_log(f"[call_agent] Empty completion from model={model} (no text, no tool use).")
+            return msg_history, 'empty'
+        return msg_history, 'ok'
+
