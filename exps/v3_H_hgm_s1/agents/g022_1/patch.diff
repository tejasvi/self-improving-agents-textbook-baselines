@@ -0,0 +1,51 @@
+import os
+import subprocess
+import sys
+
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from utils.git_utils import has_source_edits, is_doc_file, resolve_primary_source_file, read_starter_files
+
+
+@pytest.fixture
+def repo(tmp_path):
+    d = tmp_path / "repo"
+    d.mkdir()
+    (d / "README.md").write_text("Solve the problem. See `solution.py`.\n")
+    (d / "solution.py").write_text("def solve():\n    # Write your solution here\n    pass\n")
+    (d / "tests").mkdir()
+    (d / "tests" / "test_solution.py").write_text("def test_x():\n    pass\n")
+    env = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
+    subprocess.run(["git", "init", "-q"], cwd=d, check=True)
+    subprocess.run(["git", "add", "."], cwd=d, check=True, env=env)
+    subprocess.run(["git", "commit", "-qm", "init"], cwd=d, check=True, env=env)
+    return str(d)
+
+
+def test_resolver_picks_solution_from_statement(repo):
+    assert resolve_primary_source_file(repo, "Solve it. See `solution.py`.", "python") == "solution.py"
+
+
+def test_resolver_falls_back_to_stub_scoring(repo):
+    assert resolve_primary_source_file(repo, "no filenames here", "python") == "solution.py"
+
+
+def test_resolver_never_returns_doc(repo):
+    assert not is_doc_file(resolve_primary_source_file(repo, "", "python"))
+
+
+def test_starter_files_primary_first_and_no_docs(repo):
+    names = [p for p, _ in read_starter_files(repo, primary_path="solution.py")]
+    assert names == ["solution.py"]
+
+
+def test_readme_only_diff_is_not_source_edit():
+    patch = "diff --git a/README.md b/README.md\n--- a/README.md\n+++ b/README.md\n@@ -1 +1,2 @@\n+New text here\n"
+    assert has_source_edits(patch) is False
+
+
+def test_source_diff_is_source_edit():
+    patch = "diff --git a/solution.py b/solution.py\n--- a/solution.py\n+++ b/solution.py\n@@ -1 +1 @@\n+return 42\n"
+    assert has_source_edits(patch) is True
