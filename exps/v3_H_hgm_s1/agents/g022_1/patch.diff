+_STUB_MARKERS = ('pass', 'TODO', 'Write your solution here')
+_LANGUAGE_EXTENSIONS = {
+    'python': '.py', 'javascript': '.js', 'cpp': '.cpp', 'go': '.go', 'rust': '.rs', 'java': '.java',
+}
+_KNOWN_CODE_EXTENSIONS = ('.py', '.js', '.ts', '.cpp', '.cc', '.h', '.hpp', '.go', '.rs', '.java')
+_FILENAME_RE = re.compile(r'`([\w./-]+\.(?:py|js|cpp|go|rs|java))`|\b(\w+\.(?:py|js|cpp|go|rs|java))\b')
+_SMALL_FILE_BYTES = 4000
+
+
+def _extract_problem_filenames(problem_statement):
+    """Return filenames mentioned in the problem statement (backticked or bare), in order, deduplicated."""
+    names = []
+    for m in _FILENAME_RE.finditer(problem_statement or ''):
+        name = m.group(1) or m.group(2)
+        if name and name not in names:
+            names.append(name)
+    return names
+
+
+def _tracked_files(git_dname):
+    result = subprocess.run(
+        ["git", "-C", git_dname, "ls-files"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+    )
+    return result.stdout.decode(errors='replace').splitlines()
+
+
+def resolve_primary_source_file(git_dname, problem_statement, language):
+    """
+    Pick the file the agent should edit.
+    (a) A filename mentioned in the problem statement that exists in git ls-files (matched by path or basename);
+        otherwise the first mentioned filename with a known code extension (to be created).
+    (b) Otherwise score each non-test, non-doc tracked file: +10 if it contains stub markers,
+        +5 if its extension matches `language`, +1 if it is small. Highest score wins (ties: sorted path).
+    Returns a relative path, or None if there are no candidates.
+    """
+    tracked = _tracked_files(git_dname)
+    candidates = [f for f in tracked if f and not is_test_file(f) and not is_doc_file(f)]
+
+    mentioned = _extract_problem_filenames(problem_statement)
+    for name in mentioned:
+        for f in candidates:
+            if f == name or os.path.basename(f) == os.path.basename(name):
+                return f
+    for name in mentioned:
+        if name.endswith(_KNOWN_CODE_EXTENSIONS) and not is_doc_file(name) and not is_test_file(name):
+            return name
+
+    if not candidates:
+        return None
+
+    lang_ext = _LANGUAGE_EXTENSIONS.get(language, '')
+    best, best_score = None, None
+    for f in sorted(candidates):
+        score = 0
+        full = os.path.join(git_dname, f)
+        try:
+            with open(full, 'r', encoding='utf-8') as fh:
+                text = fh.read()
+            size = os.path.getsize(full)
+        except (OSError, UnicodeDecodeError):
+            continue
+        if any(marker in text for marker in _STUB_MARKERS):
+            score += 10
+        if lang_ext and f.endswith(lang_ext):
+            score += 5
+        if size <= _SMALL_FILE_BYTES:
+            score += 1
+        if best_score is None or score > best_score:
+            best, best_score = f, score
+    return best
