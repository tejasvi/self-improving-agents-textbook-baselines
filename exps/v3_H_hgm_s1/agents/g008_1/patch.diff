+def extract_code_block(text):
+    """
+    Return the body of the last fenced code block in `text`, or None if there is none.
+    """
+    if not isinstance(text, str):
+        return None
+    fences = _FENCE_RE.findall(text)
+    if not fences:
+        return None
+    return fences[-1]
diff --git a/utils/git_utils.py b/utils/git_utils.py
index fb20964..80f6e18 100644
--- a/utils/git_utils.py
+++ b/utils/git_utils.py
@@ -186,3 +186,25 @@ def has_source_edits(patch_str):
     Return True if the patch changes at least one file that is not a test file.
     """
     return any(not is_test_file(path) for path in changed_files_from_patch(patch_str))
+
+
+def stub_unchanged(git_dname, path, base_commit):
+    """
+    Return True if the file at `path` (relative to `git_dname`) is missing, or its content
+    matches the version at `base_commit` once all whitespace is ignored. Used to detect a
+    starter stub that was never substantively edited.
+    """
+    full_path = os.path.join(git_dname, path)
+    if not os.path.isfile(full_path):
+        return True
+    with open(full_path, 'r', encoding='utf-8', errors='replace') as f:
+        current = f.read()
+    result = subprocess.run(
+        ["git", "-C", git_dname, "show", f"{base_commit}:{path}"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    if result.returncode != 0:
+        # File did not exist at the base commit: it counts as changed if it has content.
+        return not current.strip()
+    base = result.stdout.decode('utf-8', errors='replace')
+    return ''.join(current.split()) == ''.join(base.split())
