-                    safe_log(f"[forward] Fallback wrote {len(code)} chars to {primary_path}.")
-                    patch = diff_versus_commit(self.git_tempdir, self.base_commit)
-                else:
-                    safe_log("[forward] Fallback produced no code block; nothing written.")
-
-        # Last resort: write a minimal stub into the resolved file so the patch is non-empty and targets the right file
-        if not has_source_edits(patch) and primary_path is not None:
-            safe_log(f"[forward] Fallback failed. Writing minimal stub to {primary_path}.")
-            write_fallback_solution(self.git_tempdir, primary_path)
-            patch = diff_versus_commit(self.git_tempdir, self.base_commit)
-
-        has_edit = has_source_edits(patch)
-        if has_edit:
-            # Verification pass once a source edit exists
-            safe_log("[forward] Running verification pass.")
