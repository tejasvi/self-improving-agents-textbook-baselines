-            for round_idx, verify_msg in enumerate(verify_prompts, start=1):
-                safe_log(f"[forward] Verification round {round_idx}/{len(verify_prompts)}.")
-                msg_history = chat_with_agent(verify_msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
-        else:
-            safe_log("[forward] Warning: agent finished without a non-test source edit.")
-        safe_log(f"[forward] Final status: source edit exists = {has_edit}.")
-
-        return msg_history
