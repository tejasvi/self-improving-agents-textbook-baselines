-            else:
-                fallback_msg = _build_fallback_prompt(self.problem_statement, primary_path, self.git_tempdir)
-                fallback_history = chat_with_agent(fallback_msg, model=self.code_model, msg_history=[], logging=safe_log)
-                reply_text = _last_assistant_text(fallback_history)
