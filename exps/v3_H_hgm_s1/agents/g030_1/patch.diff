-                break
-            safe_log(f"[forward] No source edits detected (attempt {attempt + 1}/3). Retrying with fresh context.")
-            retry_msg = _build_retry_prompt(self.git_tempdir, primary_path, patch)
-            msg_history = chat_with_agent(retry_msg, model=self.code_model, msg_history=[], logging=safe_log)
-            if _is_empty_reply(msg_history):
-                safe_log(f"[forward] Stall detected on retry attempt {attempt + 1}/3 (empty reply).")
-                _log_raw_empty_reply(msg_history)
-            patch = diff_versus_commit(self.git_tempdir, self.base_commit)
-
-        # Tool-free fallback: ask for the full primary file as a single code block
-        if not has_source_edits(patch):
