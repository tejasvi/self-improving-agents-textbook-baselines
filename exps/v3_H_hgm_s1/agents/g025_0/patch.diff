--- /dev/null
+++ b/tools/run_examples.py
@@ -0,0 +1,148 @@
+import ast
+import os
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10  # seconds per example
+
+# Runs inside a subprocess: imports the solution, parses the call arguments
+# from an "a = 1, b = [2]" style input, calls Solution.method and prints the
+# repr of the result as a literal.
+_METHOD_RUNNER = r'''
+import ast, importlib.util, sys
+path, class_name, method_name, call_src = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
+spec = importlib.util.spec_from_file_location("solution_mod", path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+call = ast.parse("_f(" + call_src + ")", mode="eval").body
+args = [ast.literal_eval(a) for a in call.args]
+kwargs = {k.arg: ast.literal_eval(k.value) for k in call.keywords}
+obj = getattr(mod, class_name)()
+result = getattr(obj, method_name)(*args, **kwargs)
+print(repr(result))
+'''
+
+
+def tool_info():
+    return {
+        "name": "run_examples",
+        "description": """Run examples against a solution and report PASS/FAIL per example.\\n
+* mode 'method': imports the file, instantiates class_name (default 'Solution'), and calls method_name (required) with arguments parsed from each example input in 'name = value' form (ast.literal_eval). The result is compared against the expected value parsed with ast.literal_eval (compared by equality).\\n
+* mode 'stdin': runs the file with python3, piping the example input to stdin; output is compared after stripping trailing whitespace.\\n
+* Reports actual output, expected output, tracebacks, and timeouts for each failing example.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["method", "stdin"],
+                    "description": "'method' to call a Solution method, or 'stdin' to run the script with input on stdin."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Class to instantiate in 'method' mode. Defaults to 'Solution'."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Method to call in 'method' mode."
+                },
+                "examples": {
+                    "type": "array",
+                    "description": "Examples to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Example input text."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Expected output (stdin mode) or expected return value literal (method mode)."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                }
+            },
+            "required": ["solution_path", "mode", "examples"]
+        }
+    }
+
+
+def _run_stdin(solution_path, example_input, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=example_input, capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f"Timed out after {timeout}s"
+    if proc.returncode != 0:
+        return proc.stdout, proc.stderr.strip()
+    return proc.stdout, ""
+
+
+def _run_method(solution_path, class_name, method_name, example_input, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", _METHOD_RUNNER, solution_path, class_name, method_name, example_input],
+            capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f"Timed out after {timeout}s"
+    if proc.returncode != 0:
+        return proc.stdout, proc.stderr.strip()
+    return proc.stdout, ""
+
+
+def _compare_method(actual_text, expected_text):
+    try:
+        expected = ast.literal_eval(expected_text.strip())
+        actual = ast.literal_eval(actual_text.strip())
+    except Exception:
+        return actual_text.strip() == expected_text.strip()
+    return actual == expected
+
+
+def tool_function(solution_path, mode, examples, class_name=None, method_name=None):
+    timeout = DEFAULT_TIMEOUT
+    if not isinstance(examples, list) or not examples:
+        return "Error: 'examples' must be a non-empty array of {input, expected} objects."
+    if mode not in ("method", "stdin"):
+        return "Error: 'mode' must be 'method' or 'stdin'."
+    if mode == "method" and not method_name:
+        return "Error: 'method_name' is required in 'method' mode."
+    if not os.path.exists(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    class_name = class_name or "Solution"
+
+    lines = []
+    passed = 0
+    for i, ex in enumerate(examples, start=1):
+        if not isinstance(ex, dict) or "input" not in ex or "expected" not in ex:
+            lines.append(f"Example {i}: FAIL (malformed example; needs 'input' and 'expected')")
+            continue
+        ex_input, expected = str(ex["input"]), str(ex["expected"])
+        if mode == "stdin":
+            actual, err = _run_stdin(solution_path, ex_input, timeout)
+            ok = actual is not None and not err and actual.rstrip() == expected.rstrip()
+        else:
+            actual, err = _run_method(solution_path, class_name, method_name, ex_input, timeout)
+            ok = actual is not None and not err and _compare_method(actual, expected)
+        if ok:
+            passed += 1
+            lines.append(f"Example {i}: PASS")
+            continue
+        lines.append(f"Example {i}: FAIL")
+        lines.append(f"  input: {ex_input!r}")
+        lines.append(f"  expected: {expected!r}")
+        lines.append(f"  actual: {(actual or '')!r}")
+        if err:
+            lines.append(f"  error/traceback:\n{err}")
+    lines.insert(0, f"{passed}/{len(examples)} examples passed.")
+    return "\n".join(lines)
