+def _parse_examples_fallback(problem_statement):
+    """Regex fallback: pull 'Input:' / 'Output:' pairs from the statement (stdin mode)."""
+    pattern = re.compile(r'Input:\s*(.*?)\s*Output:\s*(.*?)(?=\n\s*(?:Input:|Explanation:|Constraints:)|\Z)', re.DOTALL)
+    examples = []
+    for m in pattern.finditer(problem_statement or ''):
