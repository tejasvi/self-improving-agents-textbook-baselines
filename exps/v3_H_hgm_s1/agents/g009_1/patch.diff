+    def _has_source_edits(self):
+        """
+        Returns True if the current repo diff touches at least one non-test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_paths = []
+        for line in diff.splitlines():
+            match = re.match(r'^diff --git a/(.+?) b/(.+)$', line)
+            if match:
+                changed_paths.append(match.group(2).strip())
+        for path in changed_paths:
+            lowered = path.lower()
+            basename = os.path.basename(lowered)
+            is_test = ('test' in lowered) or ('tests/' in lowered) or ('spec' in lowered) or basename.startswith('test_')
+            if not is_test:
+                return True
+        return False
