+import os
+import subprocess
+import sys
+import time
+
+DEFAULT_NUM_TESTS = 100
+DEFAULT_TIMEOUT = 5  # seconds per run
+MAX_NUM_TESTS = 2000
+REPORT_INPUT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a candidate stdin/stdout Python program against a brute-force reference, or time it on a large input.\\n
+* mode 'stress' (default): generates random small inputs with generator_path (run as `python3 generator_path SEED`, which prints one input to stdout), runs both candidate_path and reference_path on each input, and compares their stdout (whitespace-normalized). Reports the number of agreements, the smallest failing input with expected vs. actual output, and any crashes or timeouts.\\n
+* mode 'timing': runs candidate_path once on input_path (a large input file) and reports the wall-clock time, exit status, and whether it timed out.\\n
+* Timeouts and crashes are always reported. Use a small timeout for brute-force-sized inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidate_path": {
+                    "type": "string",
+                    "description": "Path to the candidate Python program (reads stdin, writes stdout)."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["stress", "timing"],
+                    "description": "'stress' to compare against a reference on random inputs, or 'timing' to time the candidate on input_path. Defaults to 'stress'."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python program (required in 'stress' mode)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator program (required in 'stress' mode). It is run as `python3 generator_path SEED` and must print one random small input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random inputs to test in 'stress' mode. Defaults to 100."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run. Defaults to 5."
+                },
+                "input_path": {
+                    "type": "string",
+                    "description": "Path to a large input file (required in 'timing' mode)."
+                }
+            },
+            "required": ["candidate_path"]
+        }
+    }
+
+
+def _normalize(text):
+    return "\n".join(line.rstrip() for line in (text or "").strip().splitlines())
+
+
+def _run(path, stdin_text, timeout):
+    """Run a Python program on stdin_text. Returns (status, stdout, stderr); status is 'ok', 'crash' or 'timeout'."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, path], input=stdin_text, capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", "", f"Timed out after {timeout}s"
+    if proc.returncode != 0:
+        return "crash", proc.stdout, proc.stderr.strip()[-800:]
+    return "ok", proc.stdout, proc.stderr.strip()
+
+
+def _generate(generator_path, seed, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, generator_path, str(seed)],
+            capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, "generator timed out"
+    if proc.returncode != 0:
+        return None, f"generator crashed: {proc.stderr.strip()[-400:]}"
+    return proc.stdout, ""
+
+
+def _stress(candidate_path, reference_path, generator_path, num_tests, timeout):
+    if not reference_path or not generator_path:
+        return "Error: 'reference_path' and 'generator_path' are required in 'stress' mode."
+    for label, p in (("candidate", candidate_path), ("reference", reference_path), ("generator", generator_path)):
+        if not os.path.exists(p):
+            return f"Error: {label} file not found: {p}"
+
+    agreements = 0
+    timeouts = 0
+    crashes = 0
+    failures = []  # (input_text, expected, actual, note)
+    for seed in range(num_tests):
+        gen_out, gen_err = _generate(generator_path, seed, timeout)
+        if gen_out is None:
+            return f"Error at seed {seed}: {gen_err}"
+        test_input = gen_out
+        ref_status, ref_out, ref_err = _run(reference_path, test_input, timeout)
+        if ref_status != "ok":
+            return (f"Reference failed on seed {seed} ({ref_status}); the brute force is unusable.\n"
+                    f"input: {test_input[:REPORT_INPUT_CHARS]!r}\n{ref_err}")
+        cand_status, cand_out, cand_err = _run(candidate_path, test_input, timeout)
+        if cand_status == "timeout":
+            timeouts += 1
+            failures.append((test_input, _normalize(ref_out), "", f"TIMEOUT: {cand_err}"))
+        elif cand_status == "crash":
+            crashes += 1
+            failures.append((test_input, _normalize(ref_out), _normalize(cand_out), f"CRASH: {cand_err}"))
+        elif _normalize(cand_out) == _normalize(ref_out):
+            agreements += 1
+        else:
+            failures.append((test_input, _normalize(ref_out), _normalize(cand_out), "WRONG ANSWER"))
+
+    lines = [f"Stress test: {agreements}/{num_tests} agreements with reference, "
+             f"{len(failures)} failing, {timeouts} timeouts, {crashes} crashes."]
+    if failures:
+        # Smallest failing input first (shortest, then lexicographic).
+        failures.sort(key=lambda f: (len(f[0]), f[0]))
+        inp, expected, actual, note = failures[0]
+        lines.append(f"Smallest failing input ({note}):")
+        lines.append(f"input: {inp[:REPORT_INPUT_CHARS]!r}")
+        lines.append(f"expected: {expected!r}")
+        lines.append(f"actual: {actual!r}")
+    return "\n".join(lines)
+
+
+def _timing(candidate_path, input_path, timeout):
+    if not input_path:
+        return "Error: 'input_path' is required in 'timing' mode."
+    if not os.path.exists(candidate_path):
+        return f"Error: candidate file not found: {candidate_path}"
+    if not os.path.exists(input_path):
+        return f"Error: input file not found: {input_path}"
+    with open(input_path, 'r', encoding='utf-8') as f:
+        data = f.read()
+    start = time.monotonic()
+    status, out, err = _run(candidate_path, data, timeout)
+    elapsed = time.monotonic() - start
+    if status == "timeout":
+        return f"Timing: TIMEOUT after {timeout}s on {input_path}."
+    if status == "crash":
+        return f"Timing: CRASH after {elapsed:.3f}s on {input_path}.\n{err}"
+    return (f"Timing: OK, {elapsed:.3f}s on {input_path} "
+            f"({len(out)} chars of output).")
+
+
+def tool_function(candidate_path, mode="stress", reference_path=None, generator_path=None,
+                  num_tests=DEFAULT_NUM_TESTS, timeout=DEFAULT_TIMEOUT, input_path=None):
+    mode = mode or "stress"
+    if mode not in ("stress", "timing"):
+        return "Error: 'mode' must be 'stress' or 'timing'."
+    try:
+        num_tests = int(num_tests) if num_tests is not None else DEFAULT_NUM_TESTS
+        timeout = float(timeout) if timeout is not None else DEFAULT_TIMEOUT
+    except (TypeError, ValueError):
+        return "Error: 'num_tests' must be an integer and 'timeout' a number."
+    if num_tests < 1 or num_tests > MAX_NUM_TESTS:
+        return f"Error: 'num_tests' must be between 1 and {MAX_NUM_TESTS}."
+    if timeout <= 0:
+        return "Error: 'timeout' must be positive."
+    if not candidate_path or not os.path.exists(candidate_path):
+        return f"Error: candidate file not found: {candidate_path}"
+    if mode == "timing":
+        return _timing(candidate_path, input_path, timeout)
+    return _stress(candidate_path, reference_path, generator_path, num_tests, timeout)
