+# ---------------------------------------------------------------------------
+# Prompt compaction & escalation helpers
+# ---------------------------------------------------------------------------
+
+_MAX_RUN_LINES = 30      # runs longer than this are collapsed
+_KEEP_RUN_LINES = 10     # lines kept from the start of a collapsed run
+
+
+def _compact_problem(statement, max_chars=6000):
+    """
+    Shrink a problem statement for retry prompts:
+      * collapse any run of more than ~30 consecutive lines (e.g. huge sample
+        inputs) down to its first ~10 lines plus an '... (N lines omitted)' marker;
+      * cap the total length at max_chars.
+    """
+    if not statement:
+        return ""
+    lines = statement.splitlines()
+    out = []
+    run = []
+
+    def flush_run():
+        if len(run) > _MAX_RUN_LINES:
+            out.extend(run[:_KEEP_RUN_LINES])
+            out.append(f"... ({len(run) - _KEEP_RUN_LINES} lines omitted)")
+        else:
+            out.extend(run)
+        run.clear()
+
+    for line in lines:
+        if line.strip():
+            run.append(line)
+        else:
+            flush_run()
+            out.append(line)
+    flush_run()
+
+    text = "\n".join(out)
+    if len(text) > max_chars:
+        text = text[:max_chars].rstrip() + "\n... (truncated)"
+    return text
+
+
+def _alternate_model(model):
+    """Return the other model in the CLAUDE_MODEL / OPENAI_MODEL pair."""
+    return OPENAI_MODEL if model == CLAUDE_MODEL else CLAUDE_MODEL
+
+
+def robust_chat(prompt, model, history, compact_prompt=None):
+    """
+    Call chat_with_agent, escalating when the assistant reply is empty.
+
+    Ladder (bounded, no loops that can spin):
+      1. Normal call with `prompt` and `history`.
+      2. If empty: compacted prompt, fresh history, same model.
+      3. If still empty: compacted prompt, fresh history, alternate model.
+
+    Returns the first history whose last assistant turn is non-empty,
+    otherwise the last history produced.
+    """
+    compact = compact_prompt or _compact_problem(prompt)
+
+    steps = [
+        ("initial", prompt, history, model),
+        ("compact-same-model", compact, [], model),
+        ("compact-alternate-model", compact, [], _alternate_model(model)),
+    ]
+
+    results = []
+    for label, p, h, m in steps:
+        if results:
+            safe_log(f"[robust_chat] escalating ({label}) -> model={m}, "
+                     f"prompt_chars={len(p)}, history_len={len(h)}")
+        result = chat_with_agent(p, m, msg_history=h, logging=safe_log)
+        results.append(result)
+        if not _last_assistant_is_empty(result):
+            return result
+        safe_log(f"[robust_chat] empty assistant reply at step '{label}' (model={m}).")
+
+    return results[-1]
+
+
+def _is_duplicate_doc(name, content, problem_statement):
+    """
+    True if a starter file is documentation-like (README, *.md, *.txt) or
+    mostly repeats the problem statement, so it should not be included again.
+    """
+    lower = name.lower()
+    if lower.endswith((".md", ".txt", ".rst")) or lower.startswith("readme"):
+        return True
+    if not content or not problem_statement:
+        return False
+    stmt_lines = {l.strip() for l in problem_statement.splitlines() if l.strip()}
+    file_lines = [l.strip() for l in content.splitlines() if l.strip()]
+    if not file_lines:
+        return False
+    overlap = sum(1 for l in file_lines if l in stmt_lines)
+    return overlap / len(file_lines) > 0.5
+
