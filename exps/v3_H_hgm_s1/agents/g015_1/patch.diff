+def _is_empty_reply(msg_history):
+    """
+    Return True if the last assistant message in `msg_history` has only empty/whitespace text.
+    A message carrying non-text blocks (e.g. tool calls) is not considered empty.
+    Handles both block-style content (list of dicts with 'text') and plain string content.
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content', '')
+        if isinstance(content, str):
+            return not content.strip()
+        if isinstance(content, list):
+            blocks = [b for b in content if isinstance(b, dict)]
+            if any(b.get('type') not in ('text', 'output_text') for b in blocks):
+                return False
+            text = ''.join(b.get('text', '') for b in blocks if isinstance(b.get('text'), str))
+            return not text.strip()
+        return True
+    return False
+
+
+def _last_assistant_text(msg_history):
+    """Return the concatenated text of the last assistant message, or '' if none."""
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content', '')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            return ''.join(b.get('text', '') for b in content if isinstance(b, dict) and isinstance(b.get('text'), str))
+    return ''
+
+
+def _primary_source_file(git_tempdir):
+    """Return the primary non-test tracked file (first by sorted git ls-files, skipping dotfiles), or None."""
+    candidates = [p for p in list_non_test_tracked_files(git_tempdir)
+                  if not os.path.basename(p).startswith('.')]
+    return candidates[0] if candidates else None
+
+
+def _build_retry_prompt(problem_statement, git_tempdir, primary_path, patch):
+    """Compact, self-contained retry prompt for a fresh context."""
+    patch_display = patch.strip() if patch.strip() else "EMPTY (no changes at all)"
+    starter = read_starter_files(git_tempdir)
+    starter_text = "\n\n".join(f"### {path}\n```\n{text}\n```" for path, text in starter) or "(no files)"
+    primary_text = primary_path if primary_path else "(no non-test file found; create the appropriate source file)"
+    return f"""I have uploaded a code repository in the directory {git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+No source edits were detected so far. The current diff against the base commit is:
+{patch_display}
+
+Primary source file: {primary_text}
+
+Current contents of the non-test files:
+{starter_text}
+
+Your first action must be an editor tool call with command=edit on {primary_text} containing the full solution (or command=create if the file does not exist); do not explore further and do not reply with an empty message. The solution must replace the starter stub and keep the required signature, adding any missing imports. After editing, reply with a short summary of the change."""
+
+
+def _build_fallback_prompt(problem_statement, primary_path, git_tempdir):
+    """Tool-free prompt asking for the complete primary file contents."""
+    return f"""Problem:
+{problem_statement}
+
+Output the complete contents of {primary_path} (inside {git_tempdir}) that solves the problem, in one ```python fenced block, and nothing else. Keep the required signature and any imports needed. If the file is not Python, use the fence language matching its extension."""
+
