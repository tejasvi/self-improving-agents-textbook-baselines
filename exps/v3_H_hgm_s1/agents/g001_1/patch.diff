+def _truncate_middle(text, max_chars):
+    """
+    Keep the head and tail of `text` so that it fits within roughly `max_chars`.
+    """
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n... [{omitted} characters truncated] ...\n{text[-half:]}"
+
+
+def run_script(path, timeout=600, max_chars=8000, cwd=None, args=None):
+    """
+    Run a script (bash for *.sh, otherwise python3 for *.py) with a timeout.
+
+    Returns a dict with:
+      - 'returncode': process return code (None if timed out)
+      - 'timed_out': bool
+      - 'elapsed': wall-clock seconds
+      - 'output': combined stdout+stderr, truncated to about `max_chars`.
+    The raw output is returned as-is; no error parsing is performed.
+    """
+    import subprocess
+    import time
+
+    if path.endswith('.sh'):
+        cmd = ['bash', path]
+    else:
+        cmd = ['python3', path]
+    cmd += list(args or [])
+
+    start = time.time()
+    timed_out = False
+    try:
+        proc = subprocess.run(
+            cmd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=timeout,
+            cwd=cwd,
+        )
+        returncode = proc.returncode
+        raw = proc.stdout
+    except subprocess.TimeoutExpired as e:
+        timed_out = True
+        returncode = None
+        raw = e.stdout or b''
+    elapsed = time.time() - start
+
+    if isinstance(raw, bytes):
+        raw = raw.decode('utf-8', errors='replace')
+    output = _truncate_middle(raw, max_chars)
+    if timed_out:
+        output += f"\n[run_script] TIMED OUT after {timeout} seconds"
+    return {
+        'returncode': returncode,
+        'timed_out': timed_out,
+        'elapsed': elapsed,
+        'output': output,
+    }
