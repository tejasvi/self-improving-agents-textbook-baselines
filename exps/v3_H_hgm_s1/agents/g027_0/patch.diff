+    def _call_agent(self, instruction, msg_history, max_tokens):
+        """Single LLM call returning (text, new_history, stop_reason)."""
+        if chat_with_agent is None:
+            raise RuntimeError("llm_withtools.chat_with_agent unavailable")
+        result = chat_with_agent(
+            instruction,
+            model=self.model,
+            msg_history=msg_history,
