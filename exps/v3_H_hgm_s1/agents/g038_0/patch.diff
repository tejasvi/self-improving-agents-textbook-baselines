+++ b/tools/run_samples.py
@@ -0,0 +1,187 @@
+import os
+import re
+import signal
+import subprocess
+import sys
+import time
+
+# Upper bound below the bash tool's 45s session timeout (same rationale as run_with_timeout.py).
+MAX_TIMEOUT_SECONDS = 40.0
+DEFAULT_TIMEOUT_SECONDS = 10.0
+MAX_SAMPLE_CHARS = 1500
+
+_SAMPLE_RE = re.compile(
+    r'Sample Input\s*(\d+)\s*:?\s*\n(.*?)Sample Output\s*\1\s*:?\s*\n(.*?)(?=Sample Input\s*\d+|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution file against the sample test cases of a problem statement.\n
+* Parses every 'Sample Input N' / 'Sample Output N' pair from the statement text (or uses the explicit `samples` list).\n
+* Runs `python <path>` for each sample with stdin set to the sample input and a hard timeout; the process group is killed on timeout.\n
+* Returns PASS/FAIL per sample, with the expected output and the actual output (truncated), plus a summary line.\n
+* Use this after writing or editing a solution to check it against the official examples.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "statement_text": {
+                    "type": "string",
+                    "description": "Problem statement text containing 'Sample Input N' / 'Sample Output N' blocks."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Optional explicit list of samples; used instead of parsing statement_text.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Standard input for this sample."
+                            },
+                            "output": {
+                                "type": "string",
+                                "description": "Expected standard output for this sample."
+                            }
+                        },
+                        "required": ["input", "output"]
+                    }
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Per-sample time limit in seconds (capped at 40). Defaults to 10."
+                }
+            },
+            "required": ["path"]
+        }
+    }
+
+
+def parse_samples(statement_text):
+    """Return a list of {'input', 'output'} dicts parsed from 'Sample Input N' / 'Sample Output N' blocks."""
+    samples = []
+    if not statement_text:
+        return samples
+    for match in _SAMPLE_RE.finditer(statement_text):
+        inp = _strip_fence(match.group(2))
+        out = _strip_fence(match.group(3))
+        samples.append({'input': inp, 'output': out})
+    return samples
+
+
+def _strip_fence(text):
+    text = text.strip('\n')
+    text = re.sub(r'^\s*```[^\n]*\n', '', text)
+    text = re.sub(r'\n\s*```\s*$', '', text)
+    return text.strip()
+
+
+def _normalize(text):
+    """Compare ignoring trailing whitespace on each line and surrounding blank lines."""
+    return "\n".join(line.rstrip() for line in (text or '').strip().splitlines())
+
+
+def _clamp_timeout(timeout_seconds):
+    try:
+        value = float(timeout_seconds) if timeout_seconds is not None else DEFAULT_TIMEOUT_SECONDS
+    except (TypeError, ValueError):
+        value = DEFAULT_TIMEOUT_SECONDS
+    return min(max(value, 0.1), MAX_TIMEOUT_SECONDS)
+
+
+def _clip(text):
+    if len(text) > MAX_SAMPLE_CHARS:
+        return text[:MAX_SAMPLE_CHARS] + "\n<output clipped>"
+    return text
+
+
+def run_once(path, stdin_text, timeout_seconds=DEFAULT_TIMEOUT_SECONDS):
+    """
+    Run `python path` with stdin_text. Returns (status, stdout, stderr) where status is
+    'ok', 'timeout', or 'error'. The child runs in its own process group, which is killed on timeout.
+    """
+    proc = subprocess.Popen(
+        [sys.executable, path],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(input=(stdin_text or '').encode(), timeout=timeout_seconds)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError, OSError):
+            proc.kill()
+        try:
+            proc.communicate(timeout=5)
+        except Exception:
+            pass
+        return 'timeout', '', ''
+    stdout = out.decode(errors='replace')
+    stderr = err.decode(errors='replace')
+    if proc.returncode != 0:
+        return 'error', stdout, stderr
+    return 'ok', stdout, stderr
+
+
+def check_samples(path, samples, timeout_seconds=DEFAULT_TIMEOUT_SECONDS):
+    """
+    Run every sample. Returns a dict with 'passed' (int), 'total' (int), and 'report' (str).
+    """
+    timeout_seconds = _clamp_timeout(timeout_seconds)
+    if not os.path.isfile(path):
+        return {'passed': 0, 'total': len(samples), 'report': f"Error: file not found: {path}"}
+    lines = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        status, stdout, stderr = run_once(path, sample['input'], timeout_seconds)
+        expected = _normalize(sample['output'])
+        actual = _normalize(stdout)
+        if status == 'ok' and actual == expected:
+            passed += 1
+            lines.append(f"Sample {idx}: PASS")
+            continue
+        if status == 'timeout':
+            reason = f"TIMEOUT after {timeout_seconds:g}s (killed)"
+        elif status == 'error':
+            reason = "RUNTIME ERROR (non-zero exit)"
+        else:
+            reason = "WRONG ANSWER"
+        lines.append(f"Sample {idx}: FAIL ({reason})")
+        lines.append(f"  expected:\n{_clip(expected)}")
+        lines.append(f"  actual:\n{_clip(actual) if actual else '(empty)'}")
+        if stderr.strip():
+            lines.append(f"  stderr:\n{_clip(stderr.strip())}")
+    total = len(samples)
+    lines.append(f"Summary: {passed}/{total} samples passed.")
+    return {'passed': passed, 'total': total, 'report': "\n".join(lines)}
+
+
+def tool_function(path=None, statement_text=None, samples=None, timeout_seconds=None):
+    """Tool entry point. Always returns a string (never raises)."""
+    try:
+        if not path:
+            return "Error: provide `path` to the solution file."
+        if samples is None:
+            samples = parse_samples(statement_text)
+        else:
+            samples = [{'input': str(s.get('input', '')), 'output': str(s.get('output', ''))} for s in samples]
+        if not samples:
+            return "No samples found: the statement has no 'Sample Input N' / 'Sample Output N' blocks."
+        return check_samples(path, samples, timeout_seconds)['report']
+    except Exception as e:
+        return f"Error running samples: {e}"
+
+
+if __name__ == "__main__":
+    demo = "Sample Input 1\n1 2\nSample Output 1\n3\n"
+    print(parse_samples(demo))
+    print(tool_function(path=__file__, statement_text=demo))
