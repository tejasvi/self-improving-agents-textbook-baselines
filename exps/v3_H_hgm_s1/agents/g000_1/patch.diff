\ No newline at end of file
+    return "\n".join(filtered_lines)
+
+_DIFF_HEADER_RE = re.compile(r'^diff --git a/(.+?) b/(.+)$')
+
+_TEST_FILE_PATTERNS = [
+    re.compile(r'(^|/)(tests?|__tests__)/'),
+    re.compile(r'(^|/)test_[^/]*\.py$'),
+    re.compile(r'_test\.(py|go|js|ts|rs|cpp|java)$'),
+    re.compile(r'\.spec\.(js|ts)$'),
+]
+
+
+def changed_files_from_patch(patch_str):
+    """
+    Return the list of file paths changed in a unified git diff string,
+    parsed from the 'diff --git a/X b/X' header lines.
+    """
+    files = []
+    for line in (patch_str or '').splitlines():
+        match = _DIFF_HEADER_RE.match(line)
+        if match:
+            path = match.group(2)
+            if path not in files:
+                files.append(path)
+    return files
+
+
+def is_test_file(path):
+    """
+    Return True if `path` looks like a test file (generic, language-agnostic heuristics).
+    """
+    normalized = path.replace('\\', '/')
+    return any(pattern.search(normalized) for pattern in _TEST_FILE_PATTERNS)
+
+
+def has_source_edits(patch_str):
+    """
+    Return True if the patch changes at least one file that is not a test file.
+    """
+    return any(not is_test_file(path) for path in changed_files_from_patch(patch_str))
