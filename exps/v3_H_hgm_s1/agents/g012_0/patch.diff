--- a/utils/common_utils.py
+++ b/utils/common_utils.py
@@ -133,3 +133,69 @@ def last_code_candidate(msg_history, max_chars=6000):
         if fences:
             return fences[-1][:max_chars]
     return None
+
+
+def _block_type_and_text(block):
+    if isinstance(block, dict):
+        return block.get('type'), block.get('text')
+    return getattr(block, 'type', None), getattr(block, 'text', None)
+
+
+def _is_empty_block(block):
+    """A text block whose text is empty or whitespace-only carries no content."""
+    btype, text = _block_type_and_text(block)
+    if btype == 'text':
+        return not isinstance(text, str) or not text.strip()
+    return False
+
+
+def sanitize_msg_history(msg_history):
+    """
+    Return a cleaned copy of `msg_history`:
+      - drop empty / whitespace-only text blocks,
+      - drop messages left with no content,
+      - merge consecutive messages sharing the same role by concatenating
+        their content lists, so the sequence alternates user/assistant.
+    Plain-string content is wrapped as a text block. The input is not mutated.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            content = [{'type': 'text', 'text': content}]
+        elif content is None:
+            content = []
+        else:
+            content = list(content)
+        content = [b for b in content if not _is_empty_block(b)]
+        if not content:
+            continue
+        role = msg.get('role')
+        if cleaned and cleaned[-1]['role'] == role:
+            cleaned[-1] = {**cleaned[-1], 'content': cleaned[-1]['content'] + content}
+        else:
+            cleaned.append({**msg, 'content': content})
+    return cleaned
+
+
+_CODE_FENCE_RE = re.compile(r"```[^\n]*\n(.*?)```", re.DOTALL)
+
+
+def extract_code_block(text):
+    """
+    Return the body of the largest fenced code block in `text` (the last one
+    among equal-sized blocks), without the language tag line. Returns None if
+    there is no fenced block.
+    """
+    if not isinstance(text, str):
+        return None
+    blocks = _CODE_FENCE_RE.findall(text)
+    if not blocks:
+        return None
+    best = blocks[0]
+    for b in blocks[1:]:
+        if len(b) >= len(best):
+            best = b
+    return best.strip('\n')
