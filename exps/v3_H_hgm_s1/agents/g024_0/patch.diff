+_DOC_METADATA_EXTENSIONS = ('.md', '.txt', '.rst', '.json', '.yml', '.toml', '.cfg', '.lock')
+
+_LANGUAGE_EXTENSIONS = {
+    'python': ('.py',),
+    'cpp': ('.cpp', '.cc'),
+    'java': ('.java',),
+    'go': ('.go',),
+    'rust': ('.rs',),
+    'javascript': ('.js',),
+}
+
+_PLACEHOLDER_RE = re.compile(r'\bpass\b|TODO|Write your solution|not implemented|unimplemented!', re.IGNORECASE)
+
+
+def _is_doc_or_metadata_file(path):
+    base = os.path.basename(path)
+    if base.startswith('.'):
+        return True
+    if base.upper().startswith('LICENSE'):
+        return True
+    return base.lower().endswith(_DOC_METADATA_EXTENSIONS)
+
+
+def rank_candidate_source_files(git_dname, problem_statement, language):
+    """
+    Rank the non-test tracked source files in `git_dname` by how likely they are to be
+    the file the solution must be written into. Documentation/metadata files and dotfiles
+    are dropped. Scoring (generic, language-agnostic heuristics):
+      +100 if the file's basename appears in the problem statement,
+      +20  if the extension matches the task language,
+      +10  if the file is small (<500 chars) or contains placeholder markers,
+      +5   for names like solution/main.
+    Returns the candidate paths sorted by descending score (ties keep path order).
+    """
+    problem_statement = problem_statement or ''
+    lang_exts = _LANGUAGE_EXTENSIONS.get((language or '').lower(), ())
+    scored = []
+    for rel_path in list_non_test_tracked_files(git_dname):
+        if _is_doc_or_metadata_file(rel_path):
+            continue
+        base = os.path.basename(rel_path)
+        stem, ext = os.path.splitext(base)
+        score = 0
+        if base and base in problem_statement:
+            score += 100
+        if ext.lower() in lang_exts:
+            score += 20
+        full_path = os.path.join(git_dname, rel_path)
+        try:
+            with open(full_path, 'r', encoding='utf-8') as f:
+                text = f.read()
+        except (OSError, UnicodeDecodeError):
+            text = ''
+        if len(text) < 500 or _PLACEHOLDER_RE.search(text):
+            score += 10
+        if stem.lower() in ('solution', 'main'):
+            score += 5
+        scored.append((-score, rel_path))
+    scored.sort()
+    return [path for _, path in scored]
