+_SAMPLE_IN_RE = re.compile(
+    r'Sample\s+Input\s*(\d*)\s*:?\s*\n(.*?)(?=\n\s*Sample\s+Output|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+_SAMPLE_OUT_RE = re.compile(
+    r'Sample\s+Output\s*(\d*)\s*:?\s*\n(.*?)(?=\n\s*Sample\s+|\n\s*Explanation|\n\s*#{1,6}\s|\n\s*Input\s*:|\n\s*Expected\s+output|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+_IO_RE = re.compile(
+    r'Input:\s*\n(.*?)\n\s*Expected\s+output:\s*\n(.*?)(?=\n\s*Input:|\n\s*#{1,6}\s|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+
+
+def extract_samples(problem_statement):
+    """
+    Parse example (input, expected_output) pairs from a problem statement.
+    Supports 'Sample Input N' / 'Sample Output N' blocks and 'Input:' / 'Expected output:' blocks.
+    Returns a list of (input_text, expected_output) tuples; [] if none are found.
+    """
+    if not problem_statement:
+        return []
+    samples = []
+    # Pair each 'Sample Input k' with the 'Sample Output k' that follows it
+    inputs = [(m.group(1), m.group(2)) for m in _SAMPLE_IN_RE.finditer(problem_statement)]
+    outputs = {m.group(1): m.group(2) for m in _SAMPLE_OUT_RE.finditer(problem_statement)}
+    for idx, (num, inp) in enumerate(inputs):
+        key = num if num else ''
+        out = outputs.get(key)
+        if out is None and not num:
+            # Unnumbered: take the idx-th output in order
+            out_list = list(outputs.values())
+            out = out_list[idx] if idx < len(out_list) else None
+        if out is None:
+            continue
+        inp, out = inp.strip('\n'), out.strip('\n')
+        if inp.strip() and out.strip():
+            samples.append((inp.rstrip() + '\n', out.rstrip() + '\n'))
+    if not samples:
+        for m in _IO_RE.finditer(problem_statement):
+            inp, out = m.group(1).strip('\n'), m.group(2).strip('\n')
+            if inp.strip() and out.strip():
+                samples.append((inp.rstrip() + '\n', out.rstrip() + '\n'))
+    return samples
+
+
+def run_samples(git_dir, entry_file, samples, timeout=10):
+    """
+    Run the Python file `entry_file` (relative to git_dir) on each sample input.
+    Returns a list of failure dicts with keys: input, expected, stdout, stderr, timed_out.
+    Comparison is whitespace-normalized (split/join).
+    """
+    import subprocess
+    import sys
+    import os
+
+    path = entry_file if os.path.isabs(entry_file) else os.path.join(git_dir, entry_file)
+    failures = []
+    for inp, expected in samples:
+        try:
+            proc = subprocess.run(
+                [sys.executable, path], input=inp, capture_output=True,
+                text=True, timeout=timeout, cwd=git_dir,
+            )
+            stdout, stderr, timed_out = proc.stdout, proc.stderr, False
+        except subprocess.TimeoutExpired as e:
+            stdout = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            stderr = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+            stderr += f"\nTimed out after {timeout}s"
+            timed_out = True
+        except Exception as e:
+            stdout, stderr, timed_out = '', f"Failed to run: {e}", False
+        if timed_out or stdout.split() != expected.split():
+            failures.append({
+                'input': inp,
+                'expected': expected,
+                'stdout': stdout,
+                'stderr': stderr,
+                'timed_out': timed_out,
+            })
+    return failures
+
