+def _format_failures(failures, limit=3):
+    """Concise, human-readable failure report for the agent."""
+    parts = []
+    for i, f in enumerate(failures[:limit], 1):
+        status = "TIMED OUT" if f['timed_out'] else "WRONG OUTPUT"
+        parts.append(
+            f"Failure {i} ({status}):\n"
+            f"Input:\n{f['input']}"
+            f"Expected:\n{f['expected']}"
+            f"Actual stdout:\n{f['stdout'] or '(empty)'}\n"
+            f"Stderr/traceback:\n{(f['stderr'] or '(none)')[-1500:]}"
+        )
+    if len(failures) > limit:
+        parts.append(f"... and {len(failures) - limit} more failing sample(s).")
+    return "\n\n".join(parts)
+
+
