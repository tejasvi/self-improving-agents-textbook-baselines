@@ -0,0 +1,126 @@
+import difflib
+import os
+import subprocess
+
+DEFAULT_TIMEOUT = 10  # seconds per sample
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution program on each sample test case and compare its output EXACTLY against the expected output.\n
+* Each sample is an object with 'input' (stdin text) and 'expected' (expected stdout text), copied from the problem statement.\n
+* For every sample the result is reported as PASS (exact match after stripping only trailing newlines/whitespace at the very end) or FAIL, followed by the actual output, and a unified diff versus the expected output.\n
+* Whitespace-insensitive match info (token-by-token comparison) is also reported, so you can tell apart pure formatting issues from real value differences.\n
+* A FAIL on exact match with a whitespace-insensitive match means formatting differs; a FAIL on both means the answer differs.\n
+* Use this tool to check the exact-match requirement: hidden graders may compare output exactly, so a valid but different answer can still fail.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program file to run (e.g. /path/to/solution.py)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases taken from the problem statement.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact stdin text for this sample."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected stdout text for this sample."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Interpreter command used to run the solution. Defaults to 'python3'."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _normalize_exact(text):
+    # Only strip trailing whitespace at the end of the whole output.
+    return text.rstrip()
+
+
+def _run_one(command, solution_path, sample_input, timeout):
+    try:
+        proc = subprocess.run(
+            [command, solution_path],
+            input=sample_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f"TIMEOUT after {timeout}s"
+    except Exception as e:
+        return None, f"ERROR running command: {e}"
+    out = proc.stdout
+    if proc.returncode != 0:
+        return out, f"NONZERO EXIT ({proc.returncode}). stderr:\n{proc.stderr.strip()}"
+    return out, None
+
+
+def tool_function(solution_path, samples, command='python3'):
+    command = command or 'python3'
+    if not isinstance(samples, list):
+        return "Error: 'samples' must be an array of objects with 'input' and 'expected' strings."
+    if not os.path.exists(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    sections = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        if not isinstance(sample, dict) or 'input' not in sample or 'expected' not in sample:
+            sections.append(f"Sample {idx}: FAIL (malformed sample; needs 'input' and 'expected')")
+            continue
+        sample_input = str(sample['input'])
+        expected = str(sample['expected'])
+        actual, err = _run_one(command, solution_path, sample_input, DEFAULT_TIMEOUT)
+
+        if err is not None:
+            sections.append(f"Sample {idx}: FAIL ({err})")
+            if actual:
+                sections.append(f"Partial output:\n{actual}")
+            continue
+
+        exact_ok = _normalize_exact(actual) == _normalize_exact(expected)
+        ws_ok = actual.split() == expected.split()
+        if exact_ok:
+            passed += 1
+            status = "PASS (exact match)"
+        elif ws_ok:
+            status = "FAIL (exact mismatch, but tokens match: formatting differs)"
+        else:
+            status = "FAIL (exact mismatch: values differ)"
+
+        lines = [f"Sample {idx}: {status}",
+                 f"Whitespace-insensitive match: {'yes' if ws_ok else 'no'}",
+                 f"Actual output:\n{actual.rstrip()}",
+                 f"Expected output:\n{expected.rstrip()}"]
+        if not exact_ok:
+            diff = difflib.unified_diff(
+                expected.rstrip().splitlines(),
+                actual.rstrip().splitlines(),
+                fromfile='expected',
+                tofile='actual',
+                lineterm='',
+            )
+            diff_text = '\n'.join(diff)
+            lines.append(f"Diff (expected -> actual):\n{diff_text if diff_text else '(no line diff; difference is in trailing whitespace only)'}")
+        sections.append("\n".join(lines))
+
+    summary = f"Summary: {passed}/{len(samples)} samples match exactly."
+    return summary + "\n\n" + "\n\n".join(sections)
