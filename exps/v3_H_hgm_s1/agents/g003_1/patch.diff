diff --git a/utils/git_utils.py b/utils/git_utils.py
index fb20964..7ac5731 100644
--- a/utils/git_utils.py
+++ b/utils/git_utils.py
@@ -186,3 +186,57 @@ def has_source_edits(patch_str):
     Return True if the patch changes at least one file that is not a test file.
     """
     return any(not is_test_file(path) for path in changed_files_from_patch(patch_str))
+
+
+_NON_SOURCE_PATTERNS = [
+    'README*', '*.md', '*.txt', '*.json', '*.toml', '*.yml', 'LICENSE',
+]
+
+_STUB_MARKERS = ['Write your solution here']
+
+
+def _is_stub_text(text):
+    """
+    Return True if `text` looks like an unimplemented starter file: it contains a
+    stub marker or a bare `pass` statement.
+    """
+    if any(marker in text for marker in _STUB_MARKERS):
+        return True
+    return any(line.strip() == 'pass' for line in text.splitlines())
+
+
+def find_candidate_source_files(git_dname):
+    """
+    List the non-test, non-doc, non-config source files tracked by the repository at `git_dname`.
+    Files named solution.* / main.* or containing a stub marker are ranked first.
+    Returns a list of paths relative to `git_dname`, best candidate first.
+    """
+    import fnmatch
+
+    result = subprocess.run(
+        ["git", "-C", git_dname, "ls-files"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    )
+    files = []
+    for path in result.stdout.decode().splitlines():
+        basename = os.path.basename(path)
+        if is_test_file(path):
+            continue
+        if any(fnmatch.fnmatch(basename, pat) for pat in _NON_SOURCE_PATTERNS):
+            continue
+        files.append(path)
+
+    def rank(path):
+        basename = os.path.basename(path)
+        stem = os.path.splitext(basename)[0]
+        named = stem in ('solution', 'main')
+        stub = False
+        try:
+            with open(os.path.join(git_dname, path), 'r', encoding='utf-8', errors='replace') as f:
+                stub = _is_stub_text(f.read())
+        except OSError:
+            pass
+        # Lower tuple sorts first.
+        return (0 if named and stub else 1 if stub else 2 if named else 3, path)
+
+    return sorted(files, key=rank)
