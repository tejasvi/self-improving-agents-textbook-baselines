+    def _response_is_empty(self, msg_history):
+        """
+        Returns True if the last assistant message has no tool_use blocks and only empty/whitespace text.
+        """
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get("role") != "assistant":
+                continue
+            content = msg.get("content")
+            if isinstance(content, str):
+                return not content.strip()
+            if isinstance(content, list):
+                for c in content:
+                    if isinstance(c, dict) and c.get("type") == "tool_use":
+                        return False
+                text = " ".join(
+                    c.get("text", "") for c in content if isinstance(c, dict) and isinstance(c.get("text"), str)
+                )
+                return not text.strip()
+            return True
+        return True
+
+    def _build_compact_prompt(self, target):
+        """
+        Short prompt: problem statement plus an explicit instruction to write the solution to target.
+        """
+        return (
+            f"Write the complete Python solution for the problem below to {target} using the editor tool now. "
+            "Then test it on the sample inputs with bash and fix any failures.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>"
+        )
+
+    def _models_to_try(self):
+        """
+        Returns [self.code_model, the other of CLAUDE_MODEL/OPENAI_MODEL], without duplicates.
+        """
+        other = OPENAI_MODEL if self.code_model == CLAUDE_MODEL else CLAUDE_MODEL
+        models = [self.code_model]
+        if other != self.code_model:
+            models.append(other)
+        return models
+
