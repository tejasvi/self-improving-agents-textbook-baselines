@@ -0,0 +1,52 @@
+import os
+
+from utils.common_utils import run_script
+
+
+def tool_info():
+    return {
+        "name": "stress_run",
+        "description": """Run a Python script (or a bash .sh script) with a wall-clock timeout and report the result.
+* Use it for performance checks: write a driver script (created with the editor tool) that builds a max-size input, imports or calls the solution, and runs it.
+* Returns the elapsed time in seconds, whether the run TIMED OUT, the exit code, and the truncated combined stdout/stderr.
+* The script path must be absolute or relative to the current working directory.
+* Create scripts with the editor tool rather than bash heredocs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "script_path": {
+                    "type": "string",
+                    "description": "Path to the .py (run with python3) or .sh (run with bash) script to execute."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Maximum wall-clock seconds before the run is killed and reported as TIMED OUT. Typical value: 20."
+                },
+                "args": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional command-line arguments passed to the script."
+                }
+            },
+            "required": ["script_path", "timeout_seconds"]
+        }
+    }
+
+
+def tool_function(script_path, timeout_seconds, args=None):
+    try:
+        timeout = int(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout = 20
+    if timeout <= 0:
+        timeout = 20
+    if not os.path.isfile(script_path):
+        return f"ERROR: script not found: {script_path}"
+    result = run_script(script_path, timeout=timeout, max_chars=4000, args=args)
+    status = "TIMED OUT" if result['timed_out'] else "FINISHED"
+    return (
+        f"status: {status}\n"
+        f"elapsed_seconds: {result['elapsed']:.2f}\n"
+        f"returncode: {result['returncode']}\n"
+        f"output:\n{result['output']}"
+    )
