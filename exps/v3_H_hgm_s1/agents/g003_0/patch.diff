+_HEREDOC_RE = re.compile(r"cat\s*>\s*(\S+)\s*<<\s*['\"]?(\w+)['\"]?\n(.*?)\n\2\b", re.DOTALL)
+_FENCE_RE = re.compile(r"```[^\n]*\n(.*?)```", re.DOTALL)
+
+
+def _iter_message_texts(msg):
+    """
+    Yield (kind, text) pieces of one message. kind is 'text' for plain text
+    and 'tool' for tool-use input strings (e.g. bash commands, editor file_text).
+    Handles string content, dict blocks, and SDK content objects.
+    """
+    content = msg.get('content') if isinstance(msg, dict) else None
+    if isinstance(content, str):
+        yield 'text', content
+        return
+    if not isinstance(content, list):
+        return
+    for block in content:
+        if isinstance(block, dict):
+            btype, text, tool_input = block.get('type'), block.get('text'), block.get('input')
+        else:
+            btype = getattr(block, 'type', None)
+            text = getattr(block, 'text', None)
+            tool_input = getattr(block, 'input', None)
+        if btype == 'text' and isinstance(text, str):
+            yield 'text', text
+        elif btype == 'tool_use' and isinstance(tool_input, dict):
+            for v in tool_input.values():
+                if isinstance(v, str):
+                    yield 'tool', v
+
+
+def last_code_candidate(msg_history, max_chars=6000):
+    """
+    Return the most recent code snippet written by the assistant, as raw text.
+    Scans assistant messages in reverse for a heredoc file write
+    (`cat > X <<'EOF' ... EOF`) or a fenced code block, and returns the
+    body truncated to `max_chars`. Returns None if nothing is found.
+    No error parsing is performed.
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        pieces = list(_iter_message_texts(msg))
+        # Tool inputs (e.g. bash heredocs) take precedence over plain text.
+        pieces.sort(key=lambda p: 0 if p[0] == 'tool' else 1)
+        # Within a message: a heredoc file write wins over a fenced block.
+        heredocs = [h for _, text in pieces for h in _HEREDOC_RE.findall(text)]
+        if heredocs:
+            return heredocs[-1][2][:max_chars]
+        fences = [fb for _, text in pieces for fb in _FENCE_RE.findall(text)]
+        if fences:
+            return fences[-1][:max_chars]
+    return None
