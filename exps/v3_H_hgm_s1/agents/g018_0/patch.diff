+    def _find_target_file(self):
+        """
+        Returns the path (relative to git_tempdir) of the file the agent should write.
+        Prefers a backticked filename in the problem statement (e.g. `solution.py`);
+        otherwise the single non-test, non-README tracked file from `git ls-files`.
+        Returns None if no target can be determined.
+        """
+        for name in re.findall(r'`([^`\s]+\.[A-Za-z0-9_]+)`', self.problem_statement or ''):
+            name = name.strip().lstrip('./')
+            if name and not os.path.basename(name).lower().startswith('readme') and not self._is_test_path(name):
+                return name
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            tracked = result.stdout.decode().splitlines()
+        except Exception as e:
+            safe_log(f"[find_target] git ls-files failed: {e}")
+            return None
+        candidates = [
+            f for f in tracked
+            if not self._is_test_path(f) and not os.path.basename(f).lower().startswith('readme')
+        ]
+        if len(candidates) == 1:
+            return candidates[0]
+        safe_log(f"[find_target] Could not pick a unique target file among {candidates}")
+        return None
+
+    def _extract_code_block(self, text):
+        """
+        Returns the contents of the last ```python fenced block in text, falling back to
+        any fenced block. Returns None if no fenced block is found.
+        """
+        if not text:
+            return None
+        matches = re.findall(r'```python[ \t]*\r?\n(.*?)```', text, re.DOTALL)
+        if not matches:
+            matches = re.findall(r'```[A-Za-z0-9_+-]*[ \t]*\r?\n(.*?)```', text, re.DOTALL)
+        if not matches:
+            return None
+        return matches[-1].rstrip() + "\n"
