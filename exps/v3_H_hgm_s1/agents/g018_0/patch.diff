+    def _is_test_path(self, path):
+        """
+        Returns True if the path looks like a test file: test_*.py, *_test.py, *.spec.*,
+        or lives under a 'tests' / 'test' directory component.
+        """
+        norm = path.replace('\\', '/').lower()
+        parts = norm.split('/')
+        basename = parts[-1]
+        if any(p in ('tests', 'test') for p in parts[:-1]):
+            return True
+        if fnmatch.fnmatch(basename, 'test_*.py') or fnmatch.fnmatch(basename, '*_test.py'):
+            return True
+        if fnmatch.fnmatch(basename, '*.spec.*'):
+            return True
+        return False
