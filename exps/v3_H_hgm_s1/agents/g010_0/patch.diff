@@ -0,0 +1,97 @@
+import difflib
+import glob
+import os
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "sample_runner",
+        "description": """Run a Python solution on every sample test in a directory and compare its stdout with the expected output.\n
+* Samples are pairs of files named NAME.in (input) and NAME.out (expected output) in samples_dir.\n
+* Comparison ignores leading/trailing whitespace and trailing whitespace on each line, but is otherwise exact (the same output text is required).\n
+* Returns one line per sample: PASS or DIFF (or ERROR if the program crashed or timed out). For every mismatch a unified diff (expected vs actual) is included.\n
+* Use this after writing samples to files to confirm that the solution reproduces the sample outputs exactly, not just a valid answer.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a complete program reading stdin and writing stdout)."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing NAME.in and NAME.out sample files."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, samples_dir):
+    if not os.path.isfile(solution_path):
+        return f"ERROR: solution file not found: {solution_path}"
+    if not os.path.isdir(samples_dir):
+        return f"ERROR: samples directory not found: {samples_dir}"
+
+    in_files = sorted(glob.glob(os.path.join(samples_dir, "*.in")))
+    if not in_files:
+        return f"ERROR: no *.in files found in {samples_dir}"
+
+    results = []
+    passed = 0
+    for in_path in in_files:
+        name = os.path.splitext(os.path.basename(in_path))[0]
+        out_path = os.path.join(samples_dir, name + ".out")
+        if not os.path.isfile(out_path):
+            results.append(f"{name}: ERROR (missing expected output file {name}.out)")
+            continue
+
+        with open(in_path, "r") as f:
+            sample_input = f.read()
+        with open(out_path, "r") as f:
+            expected = f.read()
+
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=sample_input,
+                capture_output=True,
+                text=True,
+                timeout=10,
+            )
+        except subprocess.TimeoutExpired:
+            results.append(f"{name}: ERROR (timed out after 10s)")
+            continue
+
+        if proc.returncode != 0:
+            results.append(
+                f"{name}: ERROR (exit code {proc.returncode})\n"
+                f"stderr:\n{proc.stderr.strip()}"
+            )
+            continue
+
+        actual = proc.stdout
+        if _normalize(actual) == _normalize(expected):
+            passed += 1
+            results.append(f"{name}: PASS")
+        else:
+            diff = "\n".join(
+                difflib.unified_diff(
+                    _normalize(expected).splitlines(),
+                    _normalize(actual).splitlines(),
+                    fromfile=f"{name}.out (expected)",
+                    tofile=f"{name} (actual)",
+                    lineterm="",
+                )
+            )
+            results.append(f"{name}: DIFF\n{diff}")
+
+    summary = f"{passed}/{len(in_files)} samples PASS"
+    return summary + "\n\n" + "\n\n".join(results)
