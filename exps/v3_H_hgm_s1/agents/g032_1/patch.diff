index 0000000..5567d54
--- /dev/null
+++ b/tools/run_with_timeout.py
@@ -0,0 +1,135 @@
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+# Upper bound below the bash tool's 45s session timeout, so a slow program
+# is always killed here and never leaves the persistent bash session hung.
+MAX_TIMEOUT_SECONDS = 40.0
+DEFAULT_TIMEOUT_SECONDS = 10.0
+MAX_OUTPUT_CHARS = 5000
+
+
+def tool_info():
+    return {
+        "name": "run_python_timed",
+        "description": """Run a Python script or snippet in a separate subprocess with a hard time limit.\n
+* Use this for brute-force comparisons, stress tests, and max-size performance tests instead of running them directly in bash.\n
+* Provide either `code` (Python source text) or `path` (path to an existing .py file), not both.\n
+* Optional `input_data` is fed to the program's standard input.\n
+* Returns stdout, stderr, the exit code, and the elapsed wall-clock time. If the limit is reached the program is killed and the result starts with 'TIMEOUT after Ns'.\n
+* The timeout is capped at 40 seconds.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "code": {
+                    "type": "string",
+                    "description": "Python source code to run. Ignored if `path` is given."
+                },
+                "path": {
+                    "type": "string",
+                    "description": "Absolute path to an existing Python file to run."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Maximum run time in seconds (capped at 40). Defaults to 10."
+                },
+                "input_data": {
+                    "type": "string",
+                    "description": "Optional text fed to the program's standard input."
+                },
+                "description": {
+                    "type": "string",
+                    "description": "Optional short note about what this run checks."
+                }
+            },
+            "required": []
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<output clipped>"
+    return text
+
+
+def _clamp_timeout(timeout_seconds):
+    try:
+        value = float(timeout_seconds) if timeout_seconds is not None else DEFAULT_TIMEOUT_SECONDS
+    except (TypeError, ValueError):
+        value = DEFAULT_TIMEOUT_SECONDS
+    return min(max(value, 0.1), MAX_TIMEOUT_SECONDS)
+
+
+def tool_function(code=None, path=None, timeout_seconds=None, input_data=None, description=None):
+    """
+    Run Python code or a script file in a subprocess with a timeout.
+    Always returns a string (never raises), so the agent can read the outcome.
+    """
+    limit = _clamp_timeout(timeout_seconds)
+    header = f"[run_python_timed] {description}\n" if description else ""
+
+    tmp_file = None
+    try:
+        if path:
+            if not os.path.isfile(path):
+                return f"{header}Error: file not found: {path}"
+            script_path = path
+        elif code is not None and str(code).strip():
+            fd, tmp_file = tempfile.mkstemp(suffix=".py", prefix="run_timed_")
+            with os.fdopen(fd, "w") as f:
+                f.write(str(code))
+            script_path = tmp_file
+        else:
+            return f"{header}Error: provide either `code` or `path`."
+
+        stdin_bytes = str(input_data).encode() if input_data is not None else b""
+        start = time.time()
+        # start_new_session puts the child in its own process group so the whole
+        # group can be killed on timeout (grandchildren included).
+        proc = subprocess.Popen(
+            [sys.executable, script_path],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+        )
+        try:
+            out, err = proc.communicate(input=stdin_bytes, timeout=limit)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except (ProcessLookupError, PermissionError, OSError):
+                proc.kill()
+            try:
+                proc.communicate(timeout=5)
+            except Exception:
+                pass
+            elapsed = time.time() - start
+            return (f"{header}TIMEOUT after {limit:g}s: the program did not finish in time "
+                    f"(elapsed {elapsed:.2f}s). It was killed. Reduce the input size or "
+                    f"use a faster algorithm.")
+        elapsed = time.time() - start
+
+        stdout = _truncate(out.decode(errors="replace").strip())
+        stderr = _truncate(err.decode(errors="replace").strip())
+        parts = [header + f"Exit code: {proc.returncode}", f"Elapsed: {elapsed:.2f}s"]
+        parts.append("STDOUT:\n" + (stdout if stdout else "(empty)"))
+        parts.append("STDERR:\n" + (stderr if stderr else "(empty)"))
+        return "\n".join(parts)
+    except Exception as e:
+        return f"{header}Error running program: {e}"
+    finally:
+        if tmp_file and os.path.exists(tmp_file):
+            try:
+                os.remove(tmp_file)
+            except OSError:
+                pass
+
+
+if __name__ == "__main__":
+    print(tool_function(code="import time\nprint('hi')\ntime.sleep(3)", timeout_seconds=1))
+    print(tool_function(code="import sys\nprint(sum(map(int, sys.stdin.read().split())))", input_data="1 2 3"))
