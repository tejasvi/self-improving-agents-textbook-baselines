+STUB_MARKER_RE = re.compile(r'\bpass\b|TODO|unimplemented!|todo!\(\)')
+FILENAME_RE = re.compile(r'`?([\w./-]+\.(?:py|js|cpp|go|rs|java))`?')
+DOC_SUFFIXES = ('.md', '.txt', '.rst')
+
+
+def _is_candidate_source(path):
+    """Non-doc, non-test, non-dotfile tracked file."""
+    base = os.path.basename(path)
+    if base.startswith('.') or path.lower().endswith(DOC_SUFFIXES):
+        return False
+    return True
+
+
+def _primary_source_file(git_tempdir, problem_statement=None):
+    """
+    Pick the primary source file:
+      1. A filename mentioned in the problem statement that exists as a tracked, non-test, non-doc file.
+      2. Otherwise, the first tracked file whose content contains a stub marker (pass/TODO/unimplemented!/todo!()).
+    Returns a path relative to git_tempdir, or None.
+    """
+    candidates = [p for p in list_non_test_tracked_files(git_tempdir) if _is_candidate_source(p)]
+    if not candidates:
+        return None
+    by_name = {}
+    for p in candidates:
+        by_name.setdefault(os.path.basename(p), p)
+        by_name.setdefault(p, p)
+    if problem_statement:
+        for m in FILENAME_RE.finditer(problem_statement):
+            name = m.group(1)
+            if name in by_name:
+                return by_name[name]
+            base = os.path.basename(name)
+            if base in by_name:
+                return by_name[base]
+    for p in candidates:
+        try:
+            with open(os.path.join(git_tempdir, p), encoding='utf-8', errors='replace') as f:
+                if STUB_MARKER_RE.search(f.read()):
+                    return p
+        except OSError:
+            continue
+    return None
+
+
+def _diff_touches_file(patch, path):
+    """True if the unified diff contains a change to `path`."""
+    if not path:
+        return False
+    return any(line.startswith('diff --git') and (f' a/{path}' in line or line.endswith(f' b/{path}'))
+               for line in patch.splitlines())
+
+
+def _run_stress_test(git_tempdir, timeout=120):
+    """
+    Run ../stress_test.py (outside the repo diff) if it exists.
+    Returns (exists, passed, output_tail).
+    """
+    script = os.path.abspath(os.path.join(git_tempdir, '..', 'stress_test.py'))
+    if not os.path.isfile(script):
+        return False, False, ''
+    try:
+        proc = subprocess.run([sys.executable, script], cwd=git_tempdir,
+                              capture_output=True, text=True, timeout=timeout)
+        out = (proc.stdout or '') + (proc.stderr or '')
+        passed = proc.returncode == 0 and 'ALL OK' in (proc.stdout or '')
+        return True, passed, out[-2000:]
+    except subprocess.TimeoutExpired as e:
+        out = ((e.stdout or b'').decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or ''))
+        return True, False, (out + f"\n[stress_test.py timed out after {timeout}s]")[-2000:]
+
+
+def _build_debug_prompt(stress_output, primary_path):
+    return f"""The stress test ../stress_test.py FAILED. Output (last 2000 chars):
+{stress_output}
+
+Debug protocol (do this before editing):
+1. Minimize the counterexample: find the smallest input that still shows the mismatch.
+2. Hand-compute the true expected answer for that input step by step.
