diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..513db85
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,183 @@
+import copy
+import importlib.util
+import os
+import subprocess
+import sys
+import traceback
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test comparing a solution against a trusted brute-force reference on many generated small inputs.\n
+* mode='class': solution_path defines class `Solution` with the method `method_name`; brute_path defines a function `brute(*args)` with the same arguments; generator_path defines `gen(seed)` returning a tuple of args.\n
+* mode='stdio': solution_path and brute_path are complete programs reading stdin and writing stdout; generator_path defines `gen(seed)` returning the input string.\n
+* Runs num_tests cases (seeds 0..num_tests-1), each with a timeout. Returns the smallest failing input (with brute output, solution output, or traceback) on mismatch, otherwise 'ALL N TESTS PASSED'.\n
+* Use this after writing a brute-force reference and a random input generator; fix the solution until it passes.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file under test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the trusted brute-force reference file."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator file defining gen(seed)."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random test cases to run (default 300)."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["class", "stdio"],
+                    "description": "'class' to test a Solution class method, 'stdio' to test a stdin/stdout program (default 'class')."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the Solution method to test (class mode only)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-case timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+MAX_FAILURES_COLLECTED = 50
+
+
+def _load_module(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _normalize(text):
+    return "\n".join(line.rstrip() for line in (text or "").strip().splitlines())
+
+
+def _run_stdio(path, stdin_text, timeout):
+    proc = subprocess.run(
+        [sys.executable, path],
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+    if proc.returncode != 0:
+        raise RuntimeError(f"exit code {proc.returncode}\nstderr:\n{proc.stderr.strip()}")
+    return proc.stdout
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=300, mode='class',
+                  method_name=None, timeout=10):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 300
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError) as e:
+        return f"ERROR: invalid numeric argument: {e}"
+    mode = mode or 'class'
+    if mode not in ('class', 'stdio'):
+        return f"ERROR: unknown mode {mode!r}; use 'class' or 'stdio'."
+    for label, p in (("solution", solution_path), ("brute", brute_path), ("generator", generator_path)):
+        if not os.path.isfile(p):
+            return f"ERROR: {label} file not found: {p}"
+
+    try:
+        gen_mod = _load_module(generator_path, "_stress_gen")
+    except Exception:
+        return f"ERROR: failed to load generator:\n{traceback.format_exc()}"
+    if not hasattr(gen_mod, 'gen'):
+        return "ERROR: generator file must define gen(seed)."
+
+    sol_obj = None
+    brute_fn = None
+    if mode == 'class':
+        if not method_name:
+            return "ERROR: method_name is required in class mode."
+        try:
+            sol_mod = _load_module(solution_path, "_stress_solution")
+            sol_obj = sol_mod.Solution()
+            sol_method = getattr(sol_obj, method_name)
+        except Exception:
+            return f"ERROR: failed to load Solution.{method_name}:\n{traceback.format_exc()}"
+        try:
+            brute_mod = _load_module(brute_path, "_stress_brute")
+            brute_fn = brute_mod.brute
+        except Exception:
+            return f"ERROR: failed to load brute():\n{traceback.format_exc()}"
+
+    failures = []
+    for seed in range(num_tests):
+        if len(failures) >= MAX_FAILURES_COLLECTED:
+            break
+        try:
+            case = gen_mod.gen(seed)
+        except Exception:
+            return f"ERROR: generator raised on seed {seed}:\n{traceback.format_exc()}"
+
+        if mode == 'class':
+            args = case if isinstance(case, tuple) else (case,)
+            label = repr(args)
+            try:
+                expected = brute_fn(*copy.deepcopy(args))
+            except Exception:
+                return f"ERROR: brute raised on input {label}:\n{traceback.format_exc()}"
+            try:
+                actual = sol_method(*copy.deepcopy(args))
+                ok = (actual == expected)
+                actual_s, expected_s = repr(actual), repr(expected)
+                err = None
+            except Exception:
+                ok = False
+                actual_s, expected_s = "<exception>", repr(expected)
+                err = traceback.format_exc()
+            if not ok:
+                failures.append({"input": label, "expected": expected_s,
+                                 "actual": actual_s, "traceback": err})
+        else:
+            stdin_text = case if isinstance(case, str) else str(case)
+            label = stdin_text
+            try:
+                expected = _run_stdio(brute_path, stdin_text, timeout)
+            except subprocess.TimeoutExpired:
+                return f"ERROR: brute timed out on input:\n{label}"
+            except Exception:
+                return f"ERROR: brute failed on input:\n{label}\n{traceback.format_exc()}"
+            try:
+                actual = _run_stdio(solution_path, stdin_text, timeout)
+                err = None
+                ok = _normalize(actual) == _normalize(expected)
+            except subprocess.TimeoutExpired:
+                actual, err, ok = "", f"timed out after {timeout}s", False
+            except Exception as e:
+                actual, err, ok = "", str(e), False
+            if not ok:
+                failures.append({"input": label, "expected": expected,
+                                 "actual": actual, "traceback": err})
+
+    if not failures:
+        return f"ALL {num_tests} TESTS PASSED"
+
+    # Prefer the smallest failing input.
+    failures.sort(key=lambda f: len(repr(f["input"])))
+    f = failures[0]
+    out = [
+        f"MISMATCH (shortest of {len(failures)} failing cases checked)",
+        f"input:\n{f['input']}",
+        f"expected (brute):\n{f['expected']}",
+        f"actual (solution):\n{f['actual']}",
+    ]
+    if f["traceback"]:
+        out.append(f"traceback:\n{f['traceback']}")
+    return "\n\n".join(out)
