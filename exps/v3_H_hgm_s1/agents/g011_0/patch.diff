+_FENCED_BLOCK_RE = re.compile(r'```[ \t]*([A-Za-z0-9_+.-]*)[ \t]*\r?\n(.*?)```', re.DOTALL)
+
+
+def extract_code_block(text):
+    """
+    Return the content of the last fenced ``` code block in `text`, or None if there is none.
+    The language tag on the opening fence (if any) is discarded.
+    """
+    if not text:
+        return None
+    matches = _FENCED_BLOCK_RE.findall(text)
+    if not matches:
+        return None
+    _, code = matches[-1]
+    return code
