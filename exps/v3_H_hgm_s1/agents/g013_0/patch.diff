+    @staticmethod
+    def _final_assistant_text(msg_history):
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    btype, text = block.get('type'), block.get('text')
+                else:
+                    btype, text = getattr(block, 'type', None), getattr(block, 'text', None)
+                if btype == 'text' and isinstance(text, str):
+                    parts.append(text)
+            if parts:
+                return '\n'.join(parts)
+        return ''
+
+    def _fallback_write_solution(self):
+        """
+        Deterministic last resort: ask for the complete program in one fenced block
+        (no tools) and write it directly to the primary source file.
+        """
+        starter = self.find_primary_source_file()
+        if not starter:
+            safe_log("[fallback] No primary source file found; cannot write solution.", level=logging.WARNING)
+            return False
+        starter_path = os.path.join(self.git_tempdir, starter)
+        try:
+            with open(starter_path, 'r', encoding='utf-8', errors='replace') as f:
+                starter_content = f.read()
+        except OSError:
+            starter_content = ''
+        safe_log(f"[fallback] Requesting complete solution for {starter}.")
+        prompt = f"""Solve the following competitive programming problem.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+The starter file is: {starter}
+Current content of the starter file:
+```
+{starter_content}
+```
+
+Reply with ONLY the complete final program in one ```python fenced block, no tools. The program must keep the required signature from the starter file and include all imports."""
+        history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        text = self._final_assistant_text(history)
+        code = extract_code_block(text)
+        if not code:
+            stripped = text.strip()
+            looks_like_code = ('def ' in stripped or 'class ' in stripped or 'import ' in stripped) and '\n' in stripped
+            if looks_like_code:
+                safe_log("[fallback] No fenced block found; using raw reply as code.")
+                code = stripped
+        if not code:
+            safe_log("[fallback] No code found in reply; starter file left unchanged.", level=logging.WARNING)
+            return False
+        with open(starter_path, 'w', encoding='utf-8') as f:
+            f.write(code.rstrip('\n') + '\n')
+        safe_log(f"[fallback] Wrote {len(code)} characters to {starter}.")
+        return True
