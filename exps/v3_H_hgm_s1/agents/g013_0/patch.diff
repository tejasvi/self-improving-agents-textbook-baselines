+
+
+_STUB_MARKERS = ('write your solution here',)
+
+
+def file_is_stub(path):
+    """
+    Return True if the file at `path` is missing, empty, contains a known
+    placeholder marker, or has no real body (only imports, comments, blank
+    lines, signatures, and `pass` / `...` statements).
+    """
+    try:
+        with open(path, 'r', encoding='utf-8', errors='replace') as f:
+            content = f.read()
+    except OSError:
+        return True
+    if not content.strip():
+        return True
+    lowered = content.lower()
+    if any(marker in lowered for marker in _STUB_MARKERS):
+        return True
+    body = []
+    for line in content.splitlines():
+        s = line.strip()
+        if not s or s.startswith('#'):
+            continue
+        if s.startswith(('import ', 'from ', 'def ', 'class ', '@')) or s.endswith(':'):
+            continue
+        body.append(s)
+    return all(s in ('pass', '...') for s in body)
