+def truncate_output(text, limit=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of very long text, marking the removed middle."""
+    if len(text) <= limit:
+        return text
+    head = limit // 2
+    tail = limit - head
+    omitted = len(text) - limit
+    return text[:head] + f"\n<response clipped: {omitted} characters omitted>\n" + text[-tail:]
