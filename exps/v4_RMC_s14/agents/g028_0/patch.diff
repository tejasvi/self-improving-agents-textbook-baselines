+def run_with_one_retry(fn, label="step"):
+    """
+    Call fn() and return its result. If it raises an exception, log it and call fn() once more.
+    The callable is expected to start from the last good conversation state (captured by the caller),
+    so a retry does not repeat work that already succeeded. A second failure is re-raised.
+    """
+    for attempt in range(2):
+        try:
+            return fn()
+        except Exception as e:
+            safe_log(f"{label} raised an exception on attempt {attempt + 1}: {e!r}")
+            if attempt == 1:
+                raise
+            safe_log(f"{label}: retrying once from the last good state.")
+    # Unreachable: the loop either returns or re-raises.
+    raise RuntimeError(f"{label}: retry loop exited unexpectedly")
+
