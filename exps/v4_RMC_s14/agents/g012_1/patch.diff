+def _block_text(block):
+    """Return the text of a message content block (dict or SDK object), or ''."""
+    if isinstance(block, dict):
+        return block.get('text') or ''
+    return getattr(block, 'text', None) or ''
+
+def get_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in msg_history ('' if none).
+    Works for both generic dict blocks and SDK content-block objects.
+    """
+    for msg in reversed(msg_history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role != 'assistant':
+            continue
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            return content
+        texts = [_block_text(b) for b in (content or [])]
+        return "\n".join(t for t in texts if t)
+    return ''
+
