+# Limits used to keep the context small
+MAX_TOOL_OUTPUT_CHARS = 8000   # max characters of a single fresh tool result
+MAX_OLD_TOOL_OUTPUT_CHARS = 500  # max characters kept for tool results in older turns
+KEEP_RECENT_TOOL_RESULTS = 2   # number of most recent tool results kept intact
+
+def truncate_text(text, max_chars=MAX_TOOL_OUTPUT_CHARS):
+    """
+    Truncate text to at most max_chars, keeping the head and tail and
+    inserting a marker in the middle so the agent knows content was removed.
+    """
+    if text is None:
+        return ""
+    text = str(text)
+    if len(text) <= max_chars:
+        return text
+    marker = f"\n<response truncated: {len(text) - max_chars} characters omitted>\n"
+    if len(marker) > max_chars:
+        # Limit too small for the full marker: hard cut without a marker
+        return text[:max(max_chars, 0)]
+    keep = max_chars - len(marker)
+    head = keep // 2
+    tail = keep - head
+    return text[:head] + marker + (text[-tail:] if tail > 0 else "")
+
 def process_tool_call(tools_dict, tool_name, tool_input):
     try:
         if tool_name in tools_dict:
-            return tools_dict[tool_name]['function'](**tool_input)
+            result = tools_dict[tool_name]['function'](**tool_input)
+            return truncate_text(result, MAX_TOOL_OUTPUT_CHARS)
         else:
             return f"Error: Tool '{tool_name}' not found"
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def compact_old_tool_results(messages, keep_recent=KEEP_RECENT_TOOL_RESULTS, max_chars=MAX_OLD_TOOL_OUTPUT_CHARS):
+    """
+    Return a copy of messages where tool_result blocks in older turns are
+    truncated to max_chars. The most recent keep_recent tool results are left
+    intact. The input list and its dicts are not modified.
+    """
+    # Locate every tool_result block (position in messages and index in content)
+    positions = []
+    for mi, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if not isinstance(content, list):
+            continue
+        for bi, block in enumerate(content):
+            if isinstance(block, dict) and block.get('type') == 'tool_result':
+                positions.append((mi, bi))
+    old_positions = set(positions[:-keep_recent] if keep_recent > 0 else positions)
+
+    compacted = []
+    for mi, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if not isinstance(content, list) or not any((mi, bi) in old_positions for bi in range(len(content))):
+            compacted.append(msg)
+            continue
+        new_content = []
+        for bi, block in enumerate(content):
+            if (mi, bi) in old_positions:
+                new_block = dict(block)
+                new_block['content'] = truncate_text(block.get('content'), max_chars)
+                new_content.append(new_block)
+            else:
+                new_content.append(block)
+        new_msg = dict(msg)
+        new_msg['content'] = new_content
+        compacted.append(new_msg)
+    return compacted
+
