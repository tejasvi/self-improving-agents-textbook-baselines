+MAX_OUTPUT_CHARS = 10000  # max characters returned for stdout / stderr each
+COMMAND_TIMEOUT = 120.0  # seconds per command
+
+def truncate_output(content: str, max_length: int = MAX_OUTPUT_CHARS) -> str:
+    """Keep the head and tail of very long output and mark the omitted middle."""
+    if len(content) <= max_length:
+        return content
+    half = max_length // 2
+    omitted = len(content) - 2 * half
+    return f"{content[:half]}\n<response clipped: {omitted} characters omitted>\n{content[-half:]}"
