diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..5d6d9bd
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,39 @@
+"""Retry helper for transient LLM API failures (rate limits, timeouts, connection errors, 5xx)."""
+import random
+import time
+
+import anthropic
+import openai
+
+# Only these errors are considered transient. Other errors (bad request, auth, etc.)
+# are not retried and are raised immediately.
+TRANSIENT_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+
+
+def call_with_retries(fn, *args, max_retries=5, base_delay=1.0, max_delay=60.0, log=None, **kwargs):
+    """
+    Call fn(*args, **kwargs), retrying transient API errors with exponential backoff and jitter.
+    Makes at most max_retries + 1 attempts. Non-transient errors propagate immediately.
+    """
+    last_error = None
+    for attempt in range(max_retries + 1):
+        try:
+            return fn(*args, **kwargs)
+        except TRANSIENT_ERRORS as e:
+            last_error = e
+            if attempt >= max_retries:
+                break
+            delay = min(max_delay, base_delay * (2 ** attempt)) + random.uniform(0, 0.5)
+            if log is not None:
+                log(f"Transient API error ({type(e).__name__}: {e}); retry {attempt + 1}/{max_retries} in {delay:.1f}s")
+            time.sleep(delay)
+    raise last_error
