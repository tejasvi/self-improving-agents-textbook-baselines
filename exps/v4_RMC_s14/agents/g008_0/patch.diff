+import os
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10  # seconds per test case
+MAX_DIFF_CHARS = 2000  # max characters of output shown per failing case
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python program on given stdin inputs and compare its stdout with the expected outputs.\n
+* Each test case runs `python <file_path>` with `input` fed to stdin, with a time limit per case.\n
+* Outputs are compared token by token (whitespace-insensitive), so trailing spaces and newline differences are ignored.\n
+* Returns a per-case PASS/FAIL report with the actual output, expected output, stderr, or timeout info for failing cases.\n
+* Use it to check a solution against the sample tests from the problem statement and your own brute-force comparisons.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python program that reads standard input and writes standard output."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each test case is an object with 'input' (the stdin text) and 'expected_output' (the expected stdout text).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Expected text the program prints to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                }
+            },
+            "required": ["file_path", "test_cases"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_DIFF_CHARS):
+    if len(text) > limit:
+        return text[:limit] + "\n<response clipped>"
+    return text
+
+
+def _run_case(file_path, stdin_text, timeout, cwd):
+    """Run the program once. Returns (stdout, stderr, returncode, timed_out)."""
+    try:
+        result = subprocess.run(
+            [sys.executable, file_path],
+            input=stdin_text.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            cwd=cwd,
+        )
+    except subprocess.TimeoutExpired:
+        return "", "", None, True
+    return (
+        result.stdout.decode(errors="replace"),
+        result.stderr.decode(errors="replace"),
+        result.returncode,
+        False,
+    )
+
+
+def tool_function(file_path, test_cases):
+    if not os.path.isfile(file_path):
+        return f"Error: file not found: {file_path}"
+    if not isinstance(test_cases, list) or not test_cases:
+        return "Error: 'test_cases' must be a non-empty list of objects with 'input' and 'expected_output'."
+
+    cwd = os.path.dirname(os.path.abspath(file_path))
+    lines = []
+    passed = 0
+    for i, case in enumerate(test_cases, 1):
+        if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+            lines.append(f"Case {i}: FAIL (malformed test case, needs 'input' and 'expected_output')")
+            continue
+        stdin_text = str(case["input"])
+        expected = str(case["expected_output"])
+        stdout, stderr, returncode, timed_out = _run_case(file_path, stdin_text, DEFAULT_TIMEOUT, cwd)
+
+        if timed_out:
+            lines.append(f"Case {i}: FAIL (timed out after {DEFAULT_TIMEOUT}s)")
+        elif returncode != 0:
+            lines.append(
+                f"Case {i}: FAIL (exit code {returncode})\n"
+                f"stderr:\n{_truncate(stderr)}"
+            )
+        elif stdout.split() == expected.split():
+            passed += 1
+            lines.append(f"Case {i}: PASS")
+        else:
+            lines.append(
+                f"Case {i}: FAIL (wrong answer)\n"
+                f"input:\n{_truncate(stdin_text)}\n"
+                f"expected:\n{_truncate(expected)}\n"
+                f"actual:\n{_truncate(stdout)}"
+            )
+
+    total = len(test_cases)
+    summary = f"{passed}/{total} test cases passed."
+    return "\n".join(lines) + "\n" + summary
+
+
+if __name__ == "__main__":
+    print(tool_info()["name"])
