+import pytest
+import tempfile
+import os
+from tools.run_io_tests import tool_function, tool_info
+
+
+@pytest.fixture
+def sum_program():
+    d = tempfile.mkdtemp()
+    path = os.path.join(d, "sol.py")
+    with open(path, "w") as f:
+        f.write("a, b = map(int, input().split())\nprint(a + b)\n")
+    return path
+
+
+def test_info_schema():
+    info = tool_info()
+    assert info["name"] == "run_io_tests"
+    assert set(info["input_schema"].keys()) == {"type", "properties", "required"}
+    assert info["input_schema"]["required"] == ["file_path", "test_cases"]
+
+
+def test_all_pass(sum_program):
+    out = tool_function(sum_program, [
+        {"input": "1 2\n", "expected_output": "3\n"},
+        {"input": "5 5", "expected_output": "10"},
+    ])
+    assert "2/2 test cases passed." in out
+
+
+def test_wrong_answer(sum_program):
+    out = tool_function(sum_program, [{"input": "1 2", "expected_output": "4"}])
+    assert "FAIL (wrong answer)" in out
+    assert "actual:" in out and "0/1" in out
+
+
+def test_runtime_error(tmp_path):
+    p = tmp_path / "bad.py"
+    p.write_text("raise ValueError('boom')\n")
+    out = tool_function(str(p), [{"input": "", "expected_output": ""}])
+    assert "exit code 1" in out and "boom" in out
+
+
+def test_timeout(tmp_path, monkeypatch):
+    import tools.run_io_tests as m
+    monkeypatch.setattr(m, "DEFAULT_TIMEOUT", 1)
+    p = tmp_path / "slow.py"
+    p.write_text("import time\ntime.sleep(5)\n")
+    out = tool_function(str(p), [{"input": "", "expected_output": ""}])
+    assert "timed out" in out
+
+
+def test_missing_file():
+    assert "file not found" in tool_function("/nonexistent/x.py", [{"input": "", "expected_output": ""}])
+
+
+def test_malformed_case(sum_program):
+    out = tool_function(sum_program, [{"input": "1 2"}])
+    assert "malformed" in out
