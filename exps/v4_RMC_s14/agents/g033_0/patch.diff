+++ b/tools/run_io_tests.py
@@ -0,0 +1,120 @@
+import subprocess
+import sys
+from pathlib import Path
+
+TIMEOUT_SECONDS = 10
+MAX_OUTPUT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python solution file on given inputs and compare its outputs with expected outputs.\n
+* Each test case is run as `python <solution_path>` with the case's `input` fed to standard input.
+* The program's standard output is compared with `expected_output`. Comparison ignores leading/trailing whitespace and differences in line endings and trailing spaces on each line.
+* Each case has a time limit of 10 seconds.
+* Returns a per-case PASS/FAIL report. For failures, the actual output, stderr and/or exit code are shown so you can diagnose the issue.
+* Use this tool to check your solution against the sample tests from the problem statement and against your own additional test cases (e.g. edge cases and random stress inputs with a brute-force reference).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file (a complete program that reads standard input and writes standard output)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each test case is an object with an 'input' (text fed to stdin) and an 'expected_output' (text expected on stdout).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact text to feed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The exact expected text the program should print to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    """Normalize output for comparison: strip line-end whitespace and outer whitespace."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
+    return "\n".join(lines).strip()
+
+
+def _truncate(text: str) -> str:
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+
+def _run_case(solution_path: Path, cwd: Path, test_input: str, expected_output: str):
+    """Run one test case. Returns (passed, details_string)."""
+    try:
+        result = subprocess.run(
+            [sys.executable, str(solution_path)],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=str(cwd),
+            timeout=TIMEOUT_SECONDS,
+        )
+    except subprocess.TimeoutExpired:
+        return False, f"TIMEOUT: program did not finish within {TIMEOUT_SECONDS} seconds."
+
+    actual = _normalize(result.stdout)
+    expected = _normalize(expected_output)
+    if result.returncode == 0 and actual == expected:
+        return True, "PASS"
+
+    details = ["FAIL"]
+    if result.returncode != 0:
+        details.append(f"Exit code: {result.returncode}")
+    if result.stderr.strip():
+        details.append(f"Stderr:\n{_truncate(result.stderr.strip())}")
+    details.append(f"Expected output:\n{_truncate(expected)}")
+    details.append(f"Actual output:\n{_truncate(actual)}")
+    return False, "\n".join(details)
+
+
+def tool_function(solution_path: str, test_cases: list) -> str:
+    try:
+        path = Path(solution_path)
+        if not path.is_absolute():
+            return f"Error: solution_path must be an absolute path, got {solution_path}"
+        if not path.is_file():
+            return f"Error: solution file does not exist: {solution_path}"
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: test_cases must be a non-empty list of objects with 'input' and 'expected_output'."
+
+        reports = []
+        passed_count = 0
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+                reports.append(f"Test {idx}: FAIL\nMalformed test case; expected keys 'input' and 'expected_output'.")
+                continue
+            passed, details = _run_case(path, path.parent, str(case["input"]), str(case["expected_output"]))
+            if passed:
+                passed_count += 1
+            reports.append(f"Test {idx}: {details}")
+
+        summary = f"Summary: {passed_count}/{len(test_cases)} test cases passed."
+        return summary + "\n\n" + "\n\n".join(reports)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    import json
+    print(json.dumps(tool_info(), indent=2)[:200])
+    print(tool_function(__file__, [{"input": "", "expected_output": ""}]))
