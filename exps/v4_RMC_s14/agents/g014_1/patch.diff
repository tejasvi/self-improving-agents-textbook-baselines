diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..00bddb6
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,84 @@
+"""
+Retry helper for LLM API calls with exponential backoff on transient failures.
+
+Only transient errors (rate limits, timeouts, connection problems, overloaded
+or 5xx server errors) are retried. Client errors such as bad requests or
+authentication failures are raised immediately.
+"""
+import random
+import time
+
+import anthropic
+import openai
+
+DEFAULT_MAX_ATTEMPTS = 6
+DEFAULT_BASE_DELAY = 2.0   # seconds
+DEFAULT_MAX_DELAY = 60.0   # seconds
+
+_TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+
+def _transient_exception_types():
+    types = []
+    for mod in (anthropic, openai):
+        for name in ("RateLimitError", "APITimeoutError", "APIConnectionError", "InternalServerError"):
+            t = getattr(mod, name, None)
+            if t is not None:
+                types.append(t)
+    overloaded = getattr(anthropic, "OverloadedError", None)
+    if overloaded is not None:
+        types.append(overloaded)
+    return tuple(types)
+
+
+TRANSIENT_EXCEPTIONS = _transient_exception_types()
+
+
+def is_transient_error(exc):
+    """Return True if the exception looks like a transient API failure worth retrying."""
+    if isinstance(exc, TRANSIENT_EXCEPTIONS):
+        return True
+    status = getattr(exc, "status_code", None)
+    if isinstance(status, int) and (status in _TRANSIENT_STATUS_CODES or status >= 500):
+        return True
+    return False
+
+
+def backoff_delay(attempt, base_delay=DEFAULT_BASE_DELAY, max_delay=DEFAULT_MAX_DELAY):
+    """Exponential backoff delay (with jitter) for the given 0-based attempt index."""
+    delay = min(max_delay, base_delay * (2 ** attempt))
+    return delay * random.uniform(0.5, 1.0)
+
+
+def call_with_retry(
+        fn,
+        *args,
+        max_attempts=DEFAULT_MAX_ATTEMPTS,
+        base_delay=DEFAULT_BASE_DELAY,
+        max_delay=DEFAULT_MAX_DELAY,
+        logging=None,
+        **kwargs,
+):
+    """
+    Call fn(*args, **kwargs), retrying transient failures with exponential backoff.
+
+    Non-transient exceptions propagate immediately. After max_attempts transient
+    failures, the last exception is re-raised.
+    """
+    log = logging if callable(logging) else print
+    attempts = max(1, int(max_attempts))
+    last_exc = None
+    for attempt in range(attempts):
+        try:
+            return fn(*args, **kwargs)
+        except Exception as e:
+            if not is_transient_error(e):
+                raise
+            last_exc = e
+            if attempt == attempts - 1:
+                break
+            delay = backoff_delay(attempt, base_delay=base_delay, max_delay=max_delay)
+            log(f"Transient API error ({type(e).__name__}: {e}). "
+                f"Retry {attempt + 1}/{attempts - 1} in {delay:.1f}s.")
+            time.sleep(delay)
+    raise last_exc
