+    def format_previous_attempts(self):
+        """
+        Format previous failed attempts (their patches and test outputs) as a prompt section.
+        Returns an empty string if there are no previous attempts.
+        """
+        if not self.previous_attempts:
+            return ""
+        sections = []
+        for i, attempt in enumerate(self.previous_attempts, start=1):
+            patch = attempt.get('patch') or '(no changes)'
+            test_output = attempt.get('test_output') or '(no test output)'
+            sections.append(
+                f"## Attempt {i}\n"
+                f"### Patch\n```diff\n{patch}\n```\n"
+                f"### Test output\n```\n{test_output}\n```"
+            )
+        return (
+            "\n\nThe following previous attempts at this problem FAILED. "
+            "Their patches and test outputs are given below. Do not repeat the same mistakes; "
+            "analyze why they failed and try a different approach.\n\n"
+            "<previous_attempts>\n" + "\n\n".join(sections) + "\n</previous_attempts>"
+        )
+
