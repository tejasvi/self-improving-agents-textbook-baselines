+def truncate_text(text, max_chars):
+    """
+    Truncate text to at most roughly max_chars characters, keeping the head and
+    the tail (where errors and final results usually appear) and dropping the middle.
+    Returns the text unchanged if it already fits.
+    """
+    text = text if isinstance(text, str) else str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    marker = f"\n...[truncated {len(text) - max_chars} characters]...\n"
+    keep = max(0, max_chars - len(marker))
+    head = keep // 2
+    tail = keep - head
+    return text[:head] + marker + (text[-tail:] if tail > 0 else "")
