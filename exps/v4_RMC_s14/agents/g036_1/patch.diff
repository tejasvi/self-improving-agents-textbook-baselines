+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, max_old_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of messages where tool results older than the last `keep_recent`
+    messages are truncated to `max_old_chars`. Only the text of tool results is
+    changed; message and block structure (tool_use/tool_result pairing) is preserved.
+    The input list and its dicts are not mutated, so stored history stays intact.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                    block = {**block, 'content': truncate_text(block['content'], max_old_chars)}
+                new_content.append(block)
+            msg = {**msg, 'content': new_content}
+        elif msg.get('type') == 'function_call_output' and isinstance(msg.get('output'), str):
+            msg = {**msg, 'output': truncate_text(msg['output'], max_old_chars)}
+        compacted.append(msg)
+    return compacted
 
