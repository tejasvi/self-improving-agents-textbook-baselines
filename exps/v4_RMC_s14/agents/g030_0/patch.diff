diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..1ee4583
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,82 @@
+"""
+Retry helpers for model API calls.
+
+Transient failures (connection errors, timeouts, rate limits and 5xx server
+errors) are retried with exponential backoff and jitter. Any other error
+(e.g. a 400 bad request or a 401 auth failure) is raised immediately, because
+retrying it cannot succeed.
+"""
+import random
+import time
+
+import anthropic
+import openai
+
+# HTTP status codes that indicate a transient problem worth retrying.
+TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+_CONNECTION_ERRORS = (
+    openai.APIConnectionError,
+    openai.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.APITimeoutError,
+)
+
+
+def is_transient_api_error(exc):
+    """
+    Return True if `exc` is an API error that is likely to succeed on retry.
+    """
+    if isinstance(exc, _CONNECTION_ERRORS):
+        return True
+    if isinstance(exc, (openai.RateLimitError, anthropic.RateLimitError,
+                        openai.InternalServerError, anthropic.InternalServerError)):
+        return True
+    if isinstance(exc, (openai.APIStatusError, anthropic.APIStatusError)):
+        status = getattr(exc, "status_code", None)
+        return status is not None and (status >= 500 or status in TRANSIENT_STATUS_CODES)
+    return False
+
+
+def compute_backoff_delay(attempt, base_delay=1.0, max_delay=60.0, jitter=True):
+    """
+    Delay before retry number `attempt` (0-based): base_delay * 2**attempt,
+    with up to 50% random jitter when enabled, always capped at max_delay.
+    """
+    delay = base_delay * (2 ** attempt)
+    if jitter:
+        delay *= 1 + random.uniform(0, 0.5)
+    return min(delay, max_delay)
+
+
+def call_with_retries(
+    fn,
+    *,
+    max_retries=5,
+    base_delay=1.0,
+    max_delay=60.0,
+    sleep=time.sleep,
+    logging=print,
+    label="API call",
+):
+    """
+    Call `fn()` and return its result, retrying transient API errors.
+
+    Makes at most `max_retries + 1` attempts. Non-transient errors are raised
+    immediately. If every attempt fails with a transient error, the last one
+    is raised.
+    """
+    for attempt in range(max_retries + 1):
+        try:
+            return fn()
+        except Exception as e:
+            if not is_transient_api_error(e) or attempt >= max_retries:
+                raise
+            delay = compute_backoff_delay(attempt, base_delay=base_delay, max_delay=max_delay)
+            logging(
+                f"{label} failed with transient error ({type(e).__name__}: {e}). "
+                f"Retry {attempt + 1}/{max_retries} in {delay:.1f}s."
+            )
+            sleep(delay)
+    # Unreachable: the loop either returns or re-raises.
+    raise RuntimeError(f"{label}: retry loop exited unexpectedly")
