+            result = f"Error: Tool '{tool_name}' not found"
     except Exception as e:
-        return f"Error executing tool '{tool_name}': {str(e)}"
+        result = f"Error executing tool '{tool_name}': {str(e)}"
+    return truncate_text(result, MAX_TOOL_OUTPUT_CHARS)
+
+def prune_old_tool_results(messages, keep_recent=KEEP_RECENT_TOOL_RESULTS, max_chars=MAX_OLD_TOOL_OUTPUT_CHARS):
+    """
+    Return a new messages list where tool results older than the `keep_recent`
+    most recent ones are truncated to `max_chars`. The original message dicts
+    are not mutated, so the stored history stays intact.
+    Handles Claude-style 'tool_result' blocks and OpenAI-style 'function_call_output' items.
+    """
+    # Locate every tool result in chronological order as (message index, block index or None)
+    locations = []
+    for i, msg in enumerate(messages):
+        if not isinstance(msg, dict):
+            continue
+        if msg.get('type') == 'function_call_output':
+            locations.append((i, None))
+        content = msg.get('content')
+        if isinstance(content, list):
+            for j, block in enumerate(content):
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    locations.append((i, j))
+
+    old = set(locations[:max(0, len(locations) - keep_recent)])
+    if not old:
+        return list(messages)
+
+    old_msg_indices = {i for i, _ in old}
+    pruned = []
+    for i, msg in enumerate(messages):
+        if i not in old_msg_indices or not isinstance(msg, dict):
+            pruned.append(msg)
+            continue
+        new_msg = dict(msg)
+        if msg.get('type') == 'function_call_output':
+            new_msg['output'] = truncate_text(msg.get('output', ''), max_chars)
+        elif isinstance(msg.get('content'), list):
+            new_content = []
+            for j, block in enumerate(msg['content']):
+                if (i, j) in old and isinstance(block, dict):
+                    block = dict(block)
+                    block['content'] = truncate_text(block.get('content', ''), max_chars)
+                new_content.append(block)
+            new_msg['content'] = new_content
+        pruned.append(new_msg)
+    return pruned
 
