+# Context-size controls
+MAX_TOOL_OUTPUT_CHARS = 10000     # max chars of a single tool result kept in the context
+MAX_OLD_TOOL_OUTPUT_CHARS = 1000  # max chars of a tool result once it is no longer recent
+KEEP_RECENT_TOOL_RESULTS = 2      # number of most recent tool results kept at full length
+
+def truncate_text(text, max_chars=MAX_TOOL_OUTPUT_CHARS):
+    """
+    Truncate text to at most max_chars, keeping the head and tail so that
+    both the beginning and the end (often the most informative part, e.g.
+    test summaries or errors) remain visible.
+    """
+    text = text if isinstance(text, str) else str(text)
+    if len(text) <= max_chars:
+        return text
+    omitted = len(text) - max_chars
+    head = max_chars * 2 // 3
+    tail = max_chars - head
+    return (
+        text[:head]
+        + f"\n<response clipped: {omitted} characters omitted>\n"
+        + (text[-tail:] if tail > 0 else "")
+    )
+
 def process_tool_call(tools_dict, tool_name, tool_input):
