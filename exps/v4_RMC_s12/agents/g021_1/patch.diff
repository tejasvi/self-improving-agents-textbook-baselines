+# Context-size limits
+MAX_TOOL_OUTPUT_CHARS = 10000   # max chars of a single tool result kept in history
+MAX_OLD_TOOL_OUTPUT_CHARS = 2000  # max chars of a tool result in older turns sent to the model
+KEEP_RECENT_MESSAGES = 2        # most recent messages that are never compacted
+
+def truncate_text(text, max_chars):
+    """
+    Shorten text longer than max_chars by keeping its head and tail and
+    inserting a marker with the number of omitted characters.
+    """
+    if not isinstance(text, str) or len(text) <= max_chars:
+        return text
+    marker = f"\n... [{len(text) - max_chars} characters omitted] ...\n"
+    head_len = max_chars // 2
+    tail_len = max_chars - head_len
+    return text[:head_len] + marker + text[len(text) - tail_len:]
+
+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, max_chars=MAX_OLD_TOOL_OUTPUT_CHARS):
+    """
+    Return a copy of messages where tool results in older turns are truncated.
+    The most recent `keep_recent` messages are returned unchanged. The input
+    list and its dicts are not modified.
+    """
+    compacted = []
+    cutoff = len(messages) - keep_recent
+    for i, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if i >= cutoff or not isinstance(content, list):
+            compacted.append(msg)
+            continue
+        new_content = []
+        for block in content:
+            if isinstance(block, dict) and block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                block = dict(block, content=truncate_text(block['content'], max_chars))
+            new_content.append(block)
+        compacted.append(dict(msg, content=new_content))
+    return compacted
+
