+    def verify_samples(self):
+        """
+        Ask the agent to check the current solution against the sample inputs in the
+        problem statement. Returns True if the agent reports that all samples pass.
+        """
+        instruction = f"""Check the current solution in the {self.git_tempdir} directory against the sample inputs and expected outputs given in the problem statement below. Do not modify any files. Run the solution on each sample input and compare its output with the expected output exactly.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+When you are done, end your response with exactly one of these lines:
+RESULT: PASS   (every sample output matches exactly)
+RESULT: FAIL   (at least one sample output does not match, or the solution could not be run)
+"""
+        msg_history = chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+        final_text = ""
+        for msg in msg_history[::-1]:
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                final_text = content
+            elif isinstance(content, list):
+                final_text = "\n".join(
+                    block.get('text', '') for block in content
+                    if isinstance(block, dict) and block.get('type') == 'text'
+                )
+            break
+        return "RESULT: PASS" in final_text and "RESULT: FAIL" not in final_text
+
+    def run_attempts(self, max_attempts=3):
+        """
+        Run the agent up to `max_attempts` times. Each attempt starts from the base commit.
+        Keep the first attempt whose solution passes the samples; otherwise keep the last one.
+        Leaves the repository containing the kept attempt's edits.
+        """
+        best_patch = None
+        for attempt in range(1, max_attempts + 1):
+            reset_to_commit(self.git_tempdir, self.base_commit)
+            safe_log(f"=== Attempt {attempt}/{max_attempts} ===")
+            self.forward()
+            patch = diff_versus_commit(self.git_tempdir, self.base_commit)
+            passed = self.verify_samples()
+            safe_log(f"=== Attempt {attempt} sample check: {'PASS' if passed else 'FAIL'} ===")
+            best_patch = patch
+            if passed:
+                break
+
+        reset_to_commit(self.git_tempdir, self.base_commit)
+        if best_patch and best_patch.strip():
+            apply_patch(self.git_tempdir, best_patch)
+        return best_patch
 
