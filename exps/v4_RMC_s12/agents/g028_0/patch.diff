+# Status codes that indicate a transient server-side or rate-limit failure.
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+
+TRANSIENT_ERROR_TYPES = (
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+)
+
+def is_transient_error(e):
+    """
+    Return True if the exception is a transient API failure worth retrying
+    (rate limits, timeouts, connection problems, 5xx/overload responses).
+    Non-transient errors (e.g. 400 Bad Request, auth errors) return False.
+    """
+    if isinstance(e, TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(e, "status_code", None)
+    return isinstance(status, int) and status in TRANSIENT_STATUS_CODES
+
+def call_with_retries(
+        fn,
+        max_retries=5,
+        base_delay=1.0,
+        max_delay=60.0,
+        logging=print,
+        sleep=None,
+):
+    """
+    Call fn() and retry transient API failures with exponential backoff and jitter.
+    Makes at most max_retries + 1 attempts. Non-transient errors are raised immediately.
+    """
+    if sleep is None:
+        sleep = time.sleep
+    for attempt in range(max_retries + 1):
+        try:
+            return fn()
+        except Exception as e:
+            if attempt >= max_retries or not is_transient_error(e):
+                raise
+            delay = min(max_delay, base_delay * (2 ** attempt))
+            delay = delay * random.uniform(0.5, 1.0)
+            if logging is not None:
+                logging(
+                    f"Transient API error ({type(e).__name__}: {e}); "
+                    f"retry {attempt + 1}/{max_retries} in {delay:.1f}s"
+                )
+            sleep(delay)
+
