     else:
         print(f"Warning: No logger found for thread {threading.get_ident()}")
 
+MAX_PHASE_ATTEMPTS = 2  # one initial attempt plus one retry
+
+
+def run_phase_with_retry(instruction, model, msg_history, max_attempts=MAX_PHASE_ATTEMPTS):
+    """
+    Run one conversation phase. If it raises, retry once from the same input
+    msg_history (the last good state). Each attempt gets a deep copy, so a
+    failed attempt cannot mutate the saved history. After max_attempts
+    failures the last exception is re-raised.
+    """
+    last_exc = None
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return chat_with_agent(
+                instruction,
+                model=model,
+                msg_history=copy.deepcopy(msg_history),
+                logging=safe_log,
+                raise_on_error=True,
+            )
+        except Exception as e:
+            last_exc = e
+            safe_log(f"Phase attempt {attempt}/{max_attempts} failed: {e!r}", level=logging.WARNING)
+    raise last_exc
+
+
