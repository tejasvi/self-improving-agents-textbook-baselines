diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..48ba016
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,130 @@
+import copy
+
+import pytest
+
+import coding_agent
+import llm_withtools
+
+
+def _make_fake(outcomes, calls):
+    """outcomes: list of values or exceptions returned in order per call."""
+    def fake(msg, model=None, msg_history=None, logging=print, raise_on_error=False, **kw):
+        calls.append({
+            "msg": msg,
+            "model": model,
+            "history": copy.deepcopy(msg_history),
+            "history_obj": msg_history,
+            "raise_on_error": raise_on_error,
+        })
+        out = outcomes[len(calls) - 1]
+        if isinstance(out, BaseException):
+            raise out
+        return out
+    return fake
+
+
+def test_success_first_attempt(monkeypatch):
+    calls = []
+    monkeypatch.setattr(coding_agent, "chat_with_agent", _make_fake(["H1"], calls))
+    assert coding_agent.run_phase_with_retry("hi", "m", []) == "H1"
+    assert len(calls) == 1
+    assert calls[0]["raise_on_error"] is True
+
+
+def test_fails_once_then_succeeds_uses_same_input_history(monkeypatch):
+    calls = []
+    start = [{"role": "user", "content": "plan"}]
+    monkeypatch.setattr(
+        coding_agent, "chat_with_agent",
+        _make_fake([RuntimeError("boom"), "OK"], calls),
+    )
+    assert coding_agent.run_phase_with_retry("impl", "m", start) == "OK"
+    assert len(calls) == 2
+    assert calls[0]["history"] == calls[1]["history"] == [{"role": "user", "content": "plan"}]
+    assert start == [{"role": "user", "content": "plan"}]  # caller's list untouched
+
+
+def test_input_history_not_mutated_by_failed_attempt(monkeypatch):
+    start = [{"role": "user", "content": "a"}]
+    snapshot = copy.deepcopy(start)
+
+    def mutating_fail(msg, model=None, msg_history=None, logging=print, raise_on_error=False):
+        msg_history.append({"role": "assistant", "content": "junk"})
+        raise RuntimeError("fail")
+
+    calls = []
+    fake_ok = _make_fake(["done"], calls)
+    seq = iter([mutating_fail, fake_ok])
+    monkeypatch.setattr(coding_agent, "chat_with_agent", lambda *a, **k: next(seq)(*a, **k))
+    # first attempt mutates then fails; the retry must still see the original history
+    # (copy is passed in by the helper only if it defends itself; we check the outcome)
+    result = None
+    try:
+        result = coding_agent.run_phase_with_retry("x", "m", start)
+    except RuntimeError:
+        pass
+    assert result == "done"
+    assert calls[0]["history"] == snapshot  # retry sees the original history
+    assert start == snapshot                # caller's list untouched
+
+
+def test_fails_twice_reraises_after_two_calls(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        coding_agent, "chat_with_agent",
+        _make_fake([ValueError("a"), KeyError("b")], calls),
+    )
+    with pytest.raises(KeyError):
+        coding_agent.run_phase_with_retry("x", "m", [])
+    assert len(calls) == coding_agent.MAX_PHASE_ATTEMPTS == 2
+
+
+def test_forward_retries_analysis_then_implementation_gets_retry_result(monkeypatch):
+    calls = []
+    outcomes = [RuntimeError("analysis down"), "ANALYSIS_HIST", "IMPL_HIST"]
+    monkeypatch.setattr(coding_agent, "chat_with_agent", _make_fake(outcomes, calls))
+    monkeypatch.setattr(coding_agent, "safe_log", lambda *a, **k: None)
+
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.problem_statement = "p"
+    agent.git_tempdir = "/tmp/x"
+    agent.base_commit = "abc"
+    agent.test_description = None
+    agent.self_improve = False
+    agent.language = "python"
+    agent.code_model = "some-model"
+    agent.logger = None
+
+    agent.forward()
+
+    # analysis: attempt 1 fails, attempt 2 succeeds; implementation: one call
+    assert len(calls) == 3
+    assert calls[0]["msg"] == calls[1]["msg"]          # retry reuses the same instruction
+    assert "PHASE 1" in calls[0]["msg"]
+    assert calls[0]["history"] == [] and calls[1]["history"] == []
+    assert "PHASE 2" in calls[2]["msg"]
+    assert calls[2]["history"] == "ANALYSIS_HIST"       # impl sees the successful retry result
+
+
+def test_default_raise_on_error_false_swallows_in_llm_layer(monkeypatch):
+    def broken_client(model):
+        raise RuntimeError("no client")
+
+    monkeypatch.setattr(llm_withtools, "create_client", broken_client)
+    monkeypatch.setattr(llm_withtools, "load_all_tools", lambda logging=print: [])
+    logs = []
+    out = llm_withtools.chat_with_agent_claude("hi", model="claude-x", logging=logs.append)
+    assert isinstance(out, list)
+    assert any("Model call failed" in str(m) for m in logs)
+
+
+def test_raise_on_error_true_propagates_in_llm_layer(monkeypatch):
+    def broken_client(model):
+        raise RuntimeError("no client")
+
+    monkeypatch.setattr(llm_withtools, "create_client", broken_client)
+    monkeypatch.setattr(llm_withtools, "load_all_tools", lambda logging=print: [])
+    with pytest.raises(RuntimeError, match="no client"):
+        llm_withtools.chat_with_agent_claude("hi", model="claude-x", raise_on_error=True)
+    with pytest.raises(RuntimeError, match="no client"):
+        llm_withtools.chat_with_agent("hi", model="claude-x", raise_on_error=True)
