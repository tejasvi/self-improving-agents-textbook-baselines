+    @staticmethod
+    def format_previous_attempts(previous_attempts):
+        """
+        Format earlier failed attempts (their edits and test outputs) as context for a retry.
+        Returns an empty string when there are no previous attempts.
+        """
+        if not previous_attempts:
+            return ""
+        sections = []
+        for idx, attempt in enumerate(previous_attempts, start=1):
+            patch = attempt.get('patch') or '(no edits)'
+            test_output = attempt.get('test_output') or '(no test output)'
+            sections.append(
+                f"## Previous attempt {idx}\n"
+                f"### Edits made\n```diff\n{patch}\n```\n"
+                f"### Test output\n```\n{test_output}\n```"
+            )
+        return (
+            "\n\n# Previous failed attempts\n"
+            "An earlier attempt at this task failed. Review what was tried and why it failed, "
+            "avoid repeating the same mistakes, and take a different approach if needed.\n\n"
+            + "\n\n".join(sections)
+            + "\n"
+        )
