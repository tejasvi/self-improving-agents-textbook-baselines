+    def format_previous_attempts(self):
+        """
+        Format previous failed attempts (patches and their test outputs) as text
+        to be included in the instruction when retrying.
+        """
+        if not self.previous_attempts:
+            return ""
+        sections = []
+        for i, attempt in enumerate(self.previous_attempts, start=1):
+            patch = attempt.get('patch', '') or '(empty patch)'
+            test_output = attempt.get('test_output', '') or '(no test output)'
+            sections.append(
+                f"""## Previous attempt {i}
+### Patch
+```diff
+{patch}
+```
+### Test output
+```
+{test_output}
+```"""
+            )
+        return (
+            "\n\n<previous_failed_attempts>\n"
+            "The following attempts at this problem were made before and FAILED. "
+            "Do not repeat their mistakes. Analyze why each failed using its test output, "
+            "and try a different approach.\n\n"
+            + "\n\n".join(sections)
+            + "\n</previous_failed_attempts>\n"
+        )
