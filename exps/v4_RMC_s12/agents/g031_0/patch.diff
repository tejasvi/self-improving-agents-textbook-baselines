+MAX_ATTEMPTS = 3
+EXAMPLE_TIMEOUT_SECONDS = 10
+
+def extract_examples(problem_statement):
+    """
+    Extract (input, expected_output) pairs from 'Input: ... Output: ...' blocks
+    in the problem statement. Returns a list of tuples (may be empty).
+    """
+    pattern = re.compile(
+        r"Input:?[ \t]*\n?(.*?)\n[ \t]*Output:?[ \t]*\n?(.*?)(?=\n[ \t]*(?:Input:|Output:|Explanation|Example|Constraints)|\Z)",
+        re.DOTALL | re.IGNORECASE,
+    )
+    examples = []
+    for m in pattern.finditer(problem_statement or ""):
+        inp = m.group(1).strip("\n") + "\n"
+        out = m.group(2).strip()
+        if inp.strip() and out:
+            examples.append((inp, out))
+    return examples
+
+def _changed_python_files(git_dname, base_commit):
+    """Return changed or new non-test .py files relative to base_commit."""
+    names = subprocess.run(
+        ["git", "-C", git_dname, "diff", "--name-only", base_commit],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    ).stdout.decode().splitlines()
+    names += subprocess.run(
+        ["git", "-C", git_dname, "ls-files", "--others", "--exclude-standard"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+    ).stdout.decode().splitlines()
+    result = []
+    for n in names:
+        base = os.path.basename(n)
+        if n.endswith(".py") and not base.startswith("test_") and not base.endswith("_test.py") \
+                and not n.startswith("tests/") and os.path.exists(os.path.join(git_dname, n)):
+            result.append(n)
+    return result
+
+def attempt_passes_examples(git_dname, base_commit, examples):
+    """
+    An attempt passes if at least one changed Python solution file (run as a
+    stdin/stdout program) reproduces every example output (whitespace-insensitive).
+    """
+    if not examples:
+        return False
+    for rel in _changed_python_files(git_dname, base_commit):
+        ok = True
+        for inp, expected in examples:
+            try:
+                proc = subprocess.run(
+                    ["python3", rel], input=inp, text=True, cwd=git_dname,
+                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                    timeout=EXAMPLE_TIMEOUT_SECONDS, check=False,
+                )
+            except subprocess.TimeoutExpired:
+                ok = False
+                break
+            if proc.returncode != 0 or proc.stdout.split() != expected.split():
+                ok = False
+                break
+        if ok:
+            return True
+    return False
+
