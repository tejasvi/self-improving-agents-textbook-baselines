+def chat_with_agent(
+    msg,
+    model=CLAUDE_MODEL,
+    msg_history=None,
+    logging=print,
+    convert=False,  # Convert the message history to a generic format, so that msg_history can be used across models
+):
+    if msg_history is None:
+        msg_history = []
+
+    # If a run ends with an exception, retry the conversation once from the
+    # last good state (the msg_history that was passed in, not the partial one).
+    try:
+        return _run_conversation(msg, model, msg_history, logging, convert)
+    except ConversationFailed as first_err:
+        logging(f"Run failed, retrying once from last good state: {first_err.cause}")
+
+    try:
+        return _run_conversation(msg, model, msg_history, logging, convert)
+    except ConversationFailed as second_err:
+        logging(f"Retry also failed, returning partial history: {second_err.cause}")
+        # Keep the previous behaviour: return whatever was produced so far.
+        return msg_history + second_err.partial_history
+
+
