--- a/llm.py
+++ b/llm.py
@@ -7,6 +7,43 @@ import anthropic
 import backoff
 import openai
 
+
+TRANSIENT_API_ERRORS = (
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.APIStatusError,
+    openai.APIStatusError,
+)
+
+def is_transient_api_error(e):
+    """Return True if the API error is likely transient and worth retrying."""
+    if isinstance(e, (anthropic.RateLimitError, openai.RateLimitError,
+                      anthropic.APITimeoutError, openai.APITimeoutError,
+                      anthropic.APIConnectionError, openai.APIConnectionError,
+                      anthropic.InternalServerError, openai.InternalServerError)):
+        return True
+    if isinstance(e, (anthropic.APIStatusError, openai.APIStatusError)):
+        status = getattr(e, "status_code", None)
+        return status is not None and (status == 429 or status >= 500)
+    return False
+
+def retry_on_transient_error(max_tries=5, max_time=120):
+    """Retry decorator with exponential backoff for transient API failures only.
+    Non-transient errors (e.g. 400/401/403/404) are raised immediately."""
+    return backoff.on_exception(
+        backoff.expo,
+        TRANSIENT_API_ERRORS,
+        max_tries=max_tries,
+        max_time=max_time,
+        giveup=lambda e: not is_transient_api_error(e),
+    )
+
