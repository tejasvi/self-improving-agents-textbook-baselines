     "java": [["./gradlew", "test"]],
 }
 
+MAX_ATTEMPTS = 3  # total number of agent attempts per task (initial + retries)
+MAX_HISTORY_CHARS = 10000  # max chars kept per previous attempt's diff / test output
+TEST_TIMEOUT_SECONDS = 600
+
+def truncate_text(text, max_chars=MAX_HISTORY_CHARS):
+    """Keep the head and tail of long text so the most informative parts survive."""
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    return text[:half] + "\n...<truncated>...\n" + text[-half:]
+
+def run_test_commands(git_dname, language):
+    """
+    Run the test commands for `language` inside `git_dname`, stopping at the first failing command.
+    Returns (passed, output). If no test commands are configured, returns (None, "").
+    """
+    commands = TEST_COMMANDS.get(language)
+    if not commands:
+        return None, ""
+    outputs = []
+    for cmd in commands:
+        try:
+            result = subprocess.run(
+                cmd, cwd=git_dname, capture_output=True, text=True,
+                timeout=TEST_TIMEOUT_SECONDS, check=False,
+            )
+            output = result.stdout + result.stderr
+            outputs.append(f"$ {' '.join(cmd)}\n{output}")
+            # pytest exits with code 5 when no tests were collected; that is not a test failure.
+            if result.returncode == 5 and cmd[0] == "pytest":
+                continue
+            if result.returncode != 0:
+                return False, "\n".join(outputs)
+        except subprocess.TimeoutExpired as e:
+            partial = (e.stdout or b"").decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+            outputs.append(f"$ {' '.join(cmd)}\n{partial}\nTimed out after {TEST_TIMEOUT_SECONDS} seconds.")
+            return False, "\n".join(outputs)
+        except FileNotFoundError as e:
+            outputs.append(f"$ {' '.join(cmd)}\n{e}")
+            return False, "\n".join(outputs)
+    return True, "\n".join(outputs)
+
