@@ -0,0 +1,51 @@
+import importlib
+import json
+import pathlib
+import pkgutil
+
+import pytest
+
+import tools
+
+TOOL_MODULES = [
+    m.name for m in pkgutil.iter_modules(tools.__path__) if not m.name.startswith("_")
+]
+ALLOWED_PROPERTY_KEYS = {"type", "description", "enum", "items"}
+
+
+def _load(name):
+    return importlib.import_module(f"tools.{name}")
+
+
+@pytest.mark.parametrize("name", TOOL_MODULES)
+def test_tool_info_shape(name):
+    info = _load(name).tool_info()
+    assert set(info) >= {"name", "description", "input_schema"}
+    assert isinstance(info["name"], str) and info["name"]
+    assert isinstance(info["description"], str) and info["description"]
+    schema = info["input_schema"]
+    assert set(schema) == {"type", "properties", "required"}
+    assert schema["type"] == "object"
+    assert isinstance(schema["properties"], dict)
+    assert isinstance(schema["required"], list)
+    for req in schema["required"]:
+        assert req in schema["properties"], f"required '{req}' not in properties"
+
+
+@pytest.mark.parametrize("name", TOOL_MODULES)
+def test_properties_have_type_and_description(name):
+    schema = _load(name).tool_info()["input_schema"]
+    for prop, spec in schema["properties"].items():
+        assert "type" in spec, f"{prop} missing type"
+        assert "description" in spec, f"{prop} missing description"
+        assert set(spec) <= ALLOWED_PROPERTY_KEYS, f"{prop} has disallowed keys {set(spec)}"
+
+
+@pytest.mark.parametrize("name", TOOL_MODULES)
+def test_tool_info_json_serializable(name):
+    json.dumps(_load(name).tool_info())
+
+
+@pytest.mark.parametrize("name", TOOL_MODULES)
+def test_tool_function_exists(name):
+    assert callable(getattr(_load(name), "tool_function"))
