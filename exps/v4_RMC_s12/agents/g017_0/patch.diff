+def get_last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in a Claude-style message history.
+    """
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        for block in reversed(content or []):
+            if isinstance(block, dict):
+                text = block.get('text')
+            else:
+                text = getattr(block, 'text', None)
+            if text:
+                return text
+    return ""
+
