+def truncate_old_tool_results(messages, keep_recent=KEEP_RECENT_TOOL_RESULTS, max_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of the messages where tool results, except for the most recent
+    `keep_recent` ones, are truncated to `max_chars`. The original history is not modified.
+    """
+    # Locate all tool_result blocks (Claude format) and tool outputs (OpenAI format)
+    positions = []
+    for i, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if isinstance(content, list):
+            for j, block in enumerate(content):
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    positions.append((i, j))
+        elif isinstance(msg, dict) and msg.get('type') == 'function_call_output':
+            positions.append((i, None))
+
+    old_positions = set(positions[:-keep_recent] if keep_recent > 0 else positions)
+    new_messages = []
+    for i, msg in enumerate(messages):
+        if not any(pos[0] == i for pos in old_positions):
+            new_messages.append(msg)
+            continue
+        msg_copy = dict(msg)
+        if isinstance(msg.get('content'), list):
+            new_content = []
+            for j, block in enumerate(msg['content']):
+                if (i, j) in old_positions and isinstance(block, dict):
+                    block = dict(block)
+                    block['content'] = truncate_text(block.get('content', ''), max_chars)
+                new_content.append(block)
+            msg_copy['content'] = new_content
+        elif (i, None) in old_positions:
+            msg_copy['output'] = truncate_text(msg.get('output', ''), max_chars)
+        new_messages.append(msg_copy)
+    return new_messages
+
