+def truncate_output(text, limit=MAX_OUTPUT_CHARS):
+    """Truncate long text, keeping the beginning and the end."""
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n... [{omitted} characters truncated] ...\n{text[-half:]}"
