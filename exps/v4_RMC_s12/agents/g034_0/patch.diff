+class TestBashNonInteractive:
+    def test_stdin_is_closed(self):
+        """Commands reading stdin must not block."""
+        result = tool_function("cat")
+        assert result == ""
+
+    def test_timeout(self, monkeypatch):
+        """A command exceeding the timeout is killed and reported."""
+        import tools.bash as bash_mod
+        monkeypatch.setattr(bash_mod, "COMMAND_TIMEOUT", 1.0)
+        result = tool_function("sleep 30")
+        assert "Timed out" in result
+
+    def test_output_truncation(self):
+        """Very long outputs are truncated."""
+        result = tool_function("python3 -c \"print('x' * 200000)\"")
+        assert "truncated" in result
+        assert len(result) < 20000
+
+    def test_truncate_output_short(self):
+        assert truncate_output("abc", limit=10) == "abc"
