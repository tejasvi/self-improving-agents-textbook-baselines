diff --git a/tools/io_tester.py b/tools/io_tester.py
new file mode 100644
index 0000000..d9d9fd1
--- /dev/null
+++ b/tools/io_tester.py
@@ -0,0 +1,115 @@
+import subprocess
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a program on given inputs and compare its standard output with expected outputs.\n
+* Each test case has an "input" (written to the program's stdin) and an "expected_output" (the exact expected stdout).\n
+* The "command" is the shell command that runs the solution, e.g. `python3 /path/to/solution.py`. It is executed in the "working_dir" directory if given.\n
+* Comparison ignores trailing whitespace on each line and leading/trailing blank lines.\n
+* For every test case, the result reports PASS or FAIL. For failures, the actual output, expected output and stderr are shown.\n
+* Each test case is limited by "timeout" seconds.\n
+* To test a method of a `Solution` class, first write a small driver script that imports the solution and reads/writes stdin/stdout, then pass that script as the command.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command that runs the solution program, e.g. `python3 solution.py`. The input is passed via stdin."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run. Each test case is an object with an 'input' string and an 'expected_output' string.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact text to feed to the program's stdin."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The exact expected text the program writes to stdout."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "working_dir": {
+                    "type": "string",
+                    "description": "Optional absolute path of the directory in which the command is run. Defaults to the current directory."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional time limit in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["command", "test_cases"]
+        }
+    }
+
+def _normalize(text: str) -> list:
+    """Split into lines, strip trailing whitespace per line and drop leading/trailing blank lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+def _run_case(command, test_input, timeout, working_dir):
+    try:
+        proc = subprocess.run(
+            command,
+            shell=True,
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            cwd=working_dir,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f"Time limit exceeded (> {timeout} seconds)", ""
+    return proc.stdout, None, proc.stderr
+
+def tool_function(command: str, test_cases: list, working_dir: str = None, timeout: float = 10) -> str:
+    if not isinstance(test_cases, list):
+        return "Error: test_cases must be a list of objects with 'input' and 'expected_output'."
+    if timeout is None:
+        timeout = 10
+    if working_dir is not None and not working_dir.strip():
+        working_dir = None
+
+    passed = 0
+    reports = []
+    for idx, case in enumerate(test_cases, start=1):
+        if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+            reports.append(f"Test {idx}: FAIL (malformed test case, needs 'input' and 'expected_output')")
+            continue
+        test_input = str(case["input"])
+        expected = str(case["expected_output"])
+        try:
+            stdout, error, stderr = _run_case(command, test_input, timeout, working_dir)
+        except Exception as e:
+            reports.append(f"Test {idx}: FAIL (failed to run command: {e})")
+            continue
+
+        if error is not None:
+            reports.append(f"Test {idx}: FAIL ({error})\n--- stderr ---\n{stderr}")
+            continue
+
+        if _normalize(stdout) == _normalize(expected):
+            passed += 1
+            reports.append(f"Test {idx}: PASS")
+        else:
+            reports.append(
+                f"Test {idx}: FAIL (output mismatch)\n"
+                f"--- input ---\n{test_input}\n"
+                f"--- expected output ---\n{expected}\n"
+                f"--- actual output ---\n{stdout}\n"
+                f"--- stderr ---\n{stderr}"
+            )
+
+    total = len(test_cases)
+    summary = f"Summary: {passed}/{total} test cases passed."
+    return summary + "\n\n" + "\n\n".join(reports)
