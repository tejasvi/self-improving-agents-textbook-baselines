diff --git a/tools/run_tests.py b/tools/run_tests.py
new file mode 100644
index 0000000..6f39e67
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,121 @@
+import os
+import subprocess
+import sys
+
+TIMEOUT_SECONDS = 10  # per test case
+MAX_DIFF_CHARS = 2000  # max chars of actual/expected output shown per failing case
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python solution program on given test cases and compare its outputs with the expected outputs.\n
+* The solution file must be a complete Python program that reads from standard input and writes to standard output.\n
+* For each test case, `input` is fed to the program's standard input and its standard output is compared with `expected_output`.\n
+* Comparison ignores leading/trailing whitespace of the whole output and trailing whitespace on each line; otherwise it is exact.\n
+* The result reports PASS/FAIL for every test case, and for failing cases shows the actual output, the expected output, stderr, or the timeout/exit-code error.\n
+* Each test case is limited to a time limit; a case that exceeds it is reported as a timeout.\n
+* Use this tool to check the solution against the sample tests from the problem statement and your own additional tests.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_file": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a complete program reading stdin and writing stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run the solution on.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should write to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                }
+            },
+            "required": ["solution_file", "test_cases"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+
+def _clip(text, limit=MAX_DIFF_CHARS):
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... [{len(text) - limit} characters truncated]"
+
+
+def _run_case(solution_file, cwd, test_input):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_file],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=TIMEOUT_SECONDS,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        return out, "", None, f"Timed out after {TIMEOUT_SECONDS} seconds"
+    except Exception as e:
+        return "", "", None, f"Failed to run solution: {e}"
+
+
+def tool_function(solution_file, test_cases):
+    try:
+        if not os.path.isfile(solution_file):
+            return f"Error: solution file not found: {solution_file}"
+        if not isinstance(test_cases, list) or not test_cases:
+            return "Error: `test_cases` must be a non-empty list of objects with 'input' and 'expected_output'."
+
+        solution_file = os.path.abspath(solution_file)
+        cwd = os.path.dirname(solution_file)
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            test_input = case.get("input", "")
+            expected = case.get("expected_output", "")
+            stdout, stderr, returncode, error = _run_case(solution_file, cwd, test_input)
+
+            if error is None and returncode != 0:
+                error = f"Runtime error: exited with code {returncode}"
+            if error is None and _normalize(stdout) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+                continue
+
+            if error is None:
+                error = "Wrong answer: output differs from expected output"
+            parts = [f"Test {idx}: FAIL ({error})",
+                     f"Input:\n{_clip(test_input)}",
+                     f"Expected output:\n{_clip(expected.strip())}",
+                     f"Actual output:\n{_clip(stdout.strip())}"]
+            if stderr.strip():
+                parts.append(f"Stderr:\n{_clip(stderr.strip())}")
+            reports.append("\n".join(parts))
+
+        total = len(test_cases)
+        summary = f"Summary: {passed}/{total} test cases passed."
+        return summary + "\n\n" + "\n\n".join(reports)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    example = [{"input": "1 2\n", "expected_output": "3\n"}]
+    print(tool_function(sys.argv[1] if len(sys.argv) > 1 else __file__, example))
