diff --git a/utils/api_retry.py b/utils/api_retry.py
new file mode 100644
index 0000000..35905a0
--- /dev/null
+++ b/utils/api_retry.py
@@ -0,0 +1,44 @@
+"""
+Shared helpers for retrying LLM API calls on transient failures.
+
+Only transient errors (rate limits, timeouts, connection problems, 408/409/429 and 5xx
+responses) are retried. Permanent errors (e.g. 400 invalid request, 401 auth) are raised
+immediately so the caller sees them without waiting.
+"""
+import anthropic
+import openai
+
+# Exception classes from the SDKs that are always considered transient
+_TRANSIENT_EXC_TYPES = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+
+# HTTP status codes that are worth retrying
+TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+# Defaults used by the decorators in llm.py / llm_withtools.py
+DEFAULT_MAX_TRIES = 6
+DEFAULT_MAX_TIME = 600  # seconds
+DEFAULT_MAX_BACKOFF = 60  # seconds between two attempts
+
+
+def is_transient_error(exc):
+    """Return True if the exception is a transient API failure that should be retried."""
+    if isinstance(exc, _TRANSIENT_EXC_TYPES):
+        return True
+    status = getattr(exc, 'status_code', None)
+    if isinstance(status, int):
+        return status in TRANSIENT_STATUS_CODES or status >= 500
+    return False
+
+
+def give_up_on_permanent_error(exc):
+    """`giveup` predicate for backoff: stop retrying when the error is not transient."""
+    return not is_transient_error(exc)
