+    def _run_agent_with_retry(self, instruction):
+        """
+        Run one agent conversation. If it ends with an exception, retry the conversation exactly once
+        from the last good state (the message history before the failed call, which is empty here).
+        """
+        last_good_history = []
+        try:
+            return chat_with_agent(instruction, model=self.code_model,
+                                   msg_history=list(last_good_history), logging=safe_log)
+        except Exception as e:
+            safe_log(f"Agent conversation raised an exception: {e!r}. Retrying once from the last good state.")
+        return chat_with_agent(instruction, model=self.code_model,
