+
+TRUNCATION_MARKER = "\n<response clipped>\n"
+
+
+def truncate_text(text, max_length=10000):
+    """
+    Shorten `text` to at most `max_length` characters, keeping the beginning and the end
+    (the end often holds the most useful information, e.g. error summaries or test results).
+    The removed middle section is replaced with a marker.
+    """
+    if text is None:
+        return text
+    text = str(text)
+    if max_length is None or len(text) <= max_length:
+        return text
+    if max_length <= len(TRUNCATION_MARKER):
+        return text[:max_length]
+    keep = max_length - len(TRUNCATION_MARKER)
+    head_len = keep // 2
+    tail_len = keep - head_len
+    tail = text[-tail_len:] if tail_len > 0 else ""
+    return text[:head_len] + TRUNCATION_MARKER + tail
