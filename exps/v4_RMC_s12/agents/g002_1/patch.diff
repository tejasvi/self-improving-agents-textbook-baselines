+def compact_msg_history(messages, keep_recent=KEEP_RECENT_MESSAGES, max_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of `messages` where tool results in older turns are truncated to `max_chars`.
+    The last `keep_recent` messages are left untouched. Message structure and tool ids are preserved,
+    so the history stays valid for the API.
+    """
+    cutoff = max(len(messages) - keep_recent, 0)
+    compacted = []
+    for idx, msg in enumerate(messages):
+        if idx >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+
+        # Claude format: user message with tool_result blocks
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                    block = dict(block, content=truncate_text(block['content'], max_chars))
+                new_content.append(block)
+            msg = dict(msg, content=new_content)
+
+        # OpenAI format: function_call_output items
+        if msg.get('type') == 'function_call_output' and isinstance(msg.get('output'), str):
+            msg = dict(msg, output=truncate_text(msg['output'], max_chars))
+
+        compacted.append(msg)
+    return compacted
+
