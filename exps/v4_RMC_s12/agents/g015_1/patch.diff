+def extract_examples_verdict(msg_history):
+    """
+    Return True if the last assistant text in msg_history contains
+    'EXAMPLES_PASSED: YES', False otherwise (including when no verdict is found).
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content', [])
+        if isinstance(content, str):
+            texts = [content]
+        else:
+            texts = []
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text':
+                        texts.append(block.get('text') or '')
+                elif getattr(block, 'type', None) == 'text':
+                    texts.append(getattr(block, 'text', '') or '')
+        matches = VERDICT_PATTERN.findall("\n".join(texts))
+        if matches:
+            return matches[-1].upper() == 'YES'
+    return False
