+# Retry settings for model API calls
+API_MAX_RETRIES = 5          # total attempts = API_MAX_RETRIES + 1 at most
+API_BASE_DELAY = 2.0         # seconds, first backoff delay
+API_MAX_DELAY = 60.0         # cap for a single backoff delay
+
+
+def _is_transient_api_error(e):
+    """
+    Return True if the exception looks like a transient failure worth retrying
+    (rate limits, timeouts, connection problems, 408/409/429/5xx responses).
+    Other errors (e.g. invalid requests, auth failures) are not retried.
+    """
+    transient_types = []
+    for mod in (openai, anthropic):
+        for name in ('RateLimitError', 'APITimeoutError', 'APIConnectionError',
+                     'InternalServerError', 'ConflictError'):
+            t = getattr(mod, name, None)
+            if isinstance(t, type):
+                transient_types.append(t)
+    if transient_types and isinstance(e, tuple(transient_types)):
+        return True
+    status = getattr(e, 'status_code', None)
+    if isinstance(status, int) and (status in (408, 409, 429) or status >= 500):
+        return True
+    return False
+
+
+def _backoff_delay(attempt):
+    """Exponential backoff with jitter for the given 0-based retry attempt."""
+    delay = min(API_BASE_DELAY * (2 ** attempt), API_MAX_DELAY)
+    return delay * random.uniform(0.5, 1.0)
+
