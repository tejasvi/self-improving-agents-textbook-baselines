+    def run_tests(self):
+        """
+        Run the language's test commands in the repo. Returns (passed, output).
+        If no tests are available for the language, returns (True, '') so no retry is forced.
+        """
+        # Only python is auto-validated here: other languages' test commands (npm sed -i, cmake)
+        # modify repo files, which would pollute the agent's diff.
+        commands = TEST_COMMANDS.get(self.language)
+        if not commands or self.language != 'python':
+            return True, ''
+        output_parts = []
+        for cmd in commands:
+            try:
+                result = subprocess.run(
+                    cmd, cwd=self.git_tempdir, capture_output=True, text=True, timeout=TEST_TIMEOUT_SECONDS,
+                )
+            except subprocess.TimeoutExpired:
+                output_parts.append(f"$ {' '.join(cmd)}\nTimed out after {TEST_TIMEOUT_SECONDS} seconds")
