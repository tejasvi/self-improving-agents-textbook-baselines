diff --git a/utils/example_utils.py b/utils/example_utils.py
new file mode 100644
index 0000000..a2aec61
--- /dev/null
+++ b/utils/example_utils.py
@@ -0,0 +1,81 @@
+import os
+import re
+import subprocess
+
+RUN_TIMEOUT = 10  # seconds per example run
+
+_INPUT_HEADER = re.compile(r"^\s*(?:sample\s+|example\s+\d*\s*)?input\s*\d*\s*:?\s*$", re.IGNORECASE)
+_OUTPUT_HEADER = re.compile(r"^\s*(?:sample\s+|example\s+\d*\s*)?output\s*\d*\s*:?\s*$", re.IGNORECASE)
+
+
+def extract_examples(problem_statement):
+    """
+    Extract (stdin_text, expected_stdout) pairs from a problem statement.
+    Looks for "Input" header lines followed by "Output" header lines.
+    Returns a list of tuples; empty if no Input/Output blocks are found.
+    """
+    examples = []
+    lines = problem_statement.splitlines()
+    mode = None
+    cur_in, cur_out = [], []
+
+    def flush():
+        stdin_text = "\n".join(cur_in).strip("\n")
+        expected = "\n".join(cur_out).strip()
+        if stdin_text.strip() and expected:
+            examples.append((stdin_text + "\n", expected))
+
+    for line in lines:
+        if _INPUT_HEADER.match(line):
+            if mode == "out":
+                flush()
+                cur_in, cur_out = [], []
+            mode = "in"
+        elif _OUTPUT_HEADER.match(line) and mode == "in":
+            mode = "out"
+        elif mode == "in":
+            cur_in.append(line)
+        elif mode == "out":
+            cur_out.append(line)
+    if mode == "out":
+        flush()
+    return examples
+
+
+def _normalize(text):
+    return text.split()
+
+
+def run_solution_on_examples(git_dname, examples, solution_file="solution.py"):
+    """
+    Run `python solution_file` on each example's stdin and compare stdout token-wise.
+    Returns (passed_count, total_count, details). Missing solution file -> 0 passed.
+    """
+    solution_path = os.path.join(git_dname, solution_file)
+    if not os.path.isfile(solution_path):
+        return 0, len(examples), [f"{solution_file} not found in {git_dname}"]
+
+    passed = 0
+    details = []
+    for idx, (stdin_text, expected) in enumerate(examples, 1):
+        try:
+            result = subprocess.run(
+                ["python", solution_file],
+                input=stdin_text,
+                capture_output=True,
+                text=True,
+                cwd=git_dname,
+                timeout=RUN_TIMEOUT,
+                check=False,
+            )
+            ok = result.returncode == 0 and _normalize(result.stdout) == _normalize(expected)
+            if ok:
+                passed += 1
+            else:
+                details.append(
+                    f"Example {idx} failed. Input:\n{stdin_text}Expected:\n{expected}\n"
+                    f"Got:\n{result.stdout}\nStderr:\n{result.stderr[-2000:]}"
+                )
+        except subprocess.TimeoutExpired:
+            details.append(f"Example {idx} timed out after {RUN_TIMEOUT}s.")
+    return passed, len(examples), details
