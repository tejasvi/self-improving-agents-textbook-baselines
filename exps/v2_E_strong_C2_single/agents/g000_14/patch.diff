+    def _changed_files_with_added_lines(self):
+        """
+        Parse `diff_versus_commit` output into a dict {path: number_of_added_lines}.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        result = {}
+        current = None
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                m = re.match(r'diff --git a/(.*) b/(.*)$', line)
+                current = m.group(2) if m else line
+                result.setdefault(current, 0)
+            elif current is not None and line.startswith('+') and not line.startswith('+++'):
+                result[current] += 1
+        return result
+
+    def _changed_files(self):
+        return list(self._changed_files_with_added_lines().keys())
+
+    def _has_primary_edit(self):
+        """
+        True if a non-test, non-spec, non-README file has added lines in the diff.
+        For stdin-program tasks (a solution.py exists), solution.py must also contain
+        non-comment code beyond the placeholder.
+        """
+        files = self._changed_files_with_added_lines()
+        has_primary = False
+        for path, added in files.items():
+            lower = path.lower()
+            if any(k in lower for k in ('test', 'spec')):
+                continue
+            if os.path.basename(lower).startswith('readme'):
+                continue
+            if added > 0:
+                has_primary = True
+                break
+        if not has_primary:
+            return False
+
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.exists(sol_path):
+            with open(sol_path, 'r', errors='replace') as f:
+                code_lines = [l for l in f.read().splitlines()
+                              if l.strip() and not l.strip().startswith('#')]
+            if not code_lines:
+                return False
+        return True
+
