+    def _run_harness(self, solution_path):
+        """Run the harness on one candidate. Returns (passed, total, max_runtime, raw_output).
+        passed/total/max_runtime are None when they cannot be read from the output."""
+        run_script = os.path.join(self.harness_dir, 'run_tests.sh')
+        if not os.path.exists(run_script):
+            return None, None, None, "run_tests.sh does not exist; the test harness was not created."
+        try:
+            p = subprocess.run(
+                ['bash', run_script, os.path.abspath(solution_path)],
+                cwd=self.harness_dir, capture_output=True, text=True,
+                timeout=TEST_RUN_TIMEOUT, errors='replace',
+            )
+            out = p.stdout or ''
+            if p.stderr and p.stderr.strip():
+                out += "\nSTDERR:\n" + p.stderr
+            out += f"\n(exit code {p.returncode})"
+        except subprocess.TimeoutExpired as e:
+            partial = e.stdout
+            if isinstance(partial, bytes):
+                partial = partial.decode(errors='replace')
+            out = (partial or '') + f"\nError: run_tests.sh timed out after {TEST_RUN_TIMEOUT} seconds."
+        passed = total = runtime = None
+        m = re.findall(r'PASSED\s+(\d+)\s*/\s*(\d+)', out)
+        if m:
+            passed, total = int(m[-1][0]), int(m[-1][1])
+        m = re.findall(r'MAX_RUNTIME\s+([\d.]+)', out)
+        if m:
+            try:
+                runtime = float(m[-1])
+            except ValueError:
+                runtime = None
+        return passed, total, runtime, out
