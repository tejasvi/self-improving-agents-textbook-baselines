+    def _write_tests(self):
+        """Phase 1: a separate agent with a fresh history builds the test harness from the statement alone."""
+        os.makedirs(self.harness_dir, exist_ok=True)
+        instruction = f"""{self._task_text()}
+
+{TEST_AUTHOR_PROMPT.replace('{HARNESS_DIR}', self.harness_dir).replace('{SOLUTION_PATH}', self.solution_path)}
+"""
+        safe_log("=== Phase 1: writing test harness ===")
+        chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+
+    def _solve(self, attempt_idx, hint, prior_feedback):
+        """Phase 2: one solver attempt with a fresh history. Returns a record of the candidate."""
+        if os.path.exists(self.solution_path):
+            os.remove(self.solution_path)
+        feedback_block = ""
+        if prior_feedback:
+            feedback_block = f"\n\n# Feedback from the previous attempt\n{prior_feedback}"
+        method = SOLVER_PROMPT.replace('{HARNESS_DIR}', self.harness_dir).replace('{SOLUTION_PATH}', self.solution_path)
+        instruction = f"{self._task_text()}\n\n{method}\n\n# Strategy hint for this attempt\n{hint}{feedback_block}"
+        safe_log(f"=== Phase 2: solve attempt {attempt_idx} ===")
+        chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+
+        record = {'idx': attempt_idx, 'path': None, 'code': None,
+                  'passed': None, 'total': None, 'runtime': None, 'output': ''}
+        if not os.path.exists(self.solution_path):
+            record['output'] = "No solution.py was written in this attempt."
+            return record
+        record['path'] = os.path.join(self.attempts_dir, f'solution_{attempt_idx}.py')
+        shutil.copyfile(self.solution_path, record['path'])
+        with open(record['path']) as f:
+            record['code'] = f.read()
+        passed, total, runtime, out = self._run_harness(record['path'])
+        record.update(passed=passed, total=total, runtime=runtime, output=out)
+        return record
+
+    @staticmethod
+    def _score_key(rec):
+        passed = rec['passed'] if rec['passed'] is not None else -1
+        total = rec['total'] if rec['total'] is not None else 0
+        failures = total - passed if passed >= 0 else float('inf')
+        runtime = rec['runtime'] if rec['runtime'] is not None else float('inf')
+        return (-passed, failures, runtime)
+
+    @staticmethod
+    def _tail(text, n=FEEDBACK_CHARS):
+        return text if len(text) <= n else "...<clipped>...\n" + text[-n:]
+
+    def _select_and_finalize(self, records, task_text):
+        """Phase 3: re-score every candidate, copy the best to solution.py, then run the final review."""
+        safe_log("=== Phase 3: selection ===")
+        scored = []
+        for rec in records:
+            if rec['path'] is None or not os.path.exists(rec['path']):
+                continue
+            passed, total, runtime, out = self._run_harness(rec['path'])
+            rec.update(passed=passed, total=total, runtime=runtime, output=out)
+            scored.append(rec)
+            safe_log(f"candidate {rec['idx']}: passed={passed} total={total} runtime={runtime}")
+
+        best = None
+        if scored:
+            best = min(scored, key=self._score_key)
+            shutil.copyfile(best['path'], self.solution_path)
+            safe_log(f"selected candidate {best['idx']} -> {self.solution_path}")
+            best_key = self._score_key(best)
+        else:
+            best_key = None
+            safe_log("No candidate solutions were produced; the review step will work from scratch.")
+
+        # Final review (one agent call). Keep a backup so a regression can be undone.
+        backup = None
+        if os.path.exists(self.solution_path):
+            backup = os.path.join(self.attempts_dir, 'solution_before_review.py')
+            shutil.copyfile(self.solution_path, backup)
+
+        candidate_list = "\n".join(
+            f"- candidate {r['idx']}: {r['path']} (passed={r['passed']}/{r['total']})" for r in scored
+        ) or "(none)"
+        review_prompt = REVIEW_PROMPT.replace('{HARNESS_DIR}', self.harness_dir) \
+                                     .replace('{SOLUTION_PATH}', self.solution_path) \
+                                     .replace('{CANDIDATES}', candidate_list)
+        safe_log("=== Phase 4: final review ===")
+        chat_with_agent(f"{task_text}\n\n{review_prompt}", model=self.code_model, msg_history=[], logging=safe_log)
+
+        # Guard against regressions introduced by the review.
+        if backup and os.path.exists(self.solution_path) and best_key is not None:
+            passed, total, runtime, out = self._run_harness(self.solution_path)
+            if passed is None or (-passed, total - passed) > (best_key[0], best_key[1]):
+                safe_log("Review regressed the solution (or the harness no longer runs); restoring the pre-review version.")
+                shutil.copyfile(backup, self.solution_path)
+            else:
+                safe_log(f"Review result: passed={passed}/{total}")
+        if backup and os.path.exists(backup):
+            os.remove(backup)
+
+    def forward(self):
+        """
+        Multi-phase, test-driven pipeline:
+        1. test author writes a harness (brute, gen, check, run_tests.sh)
+        2. up to MAX_ATTEMPTS solver attempts with different hints, each scored by the harness
+        3. the best-scoring candidate is copied to solution.py
+        4. a final review checks the requirements and re-runs the tests
+        """
+        start = time.time()
+        task_text = self._task_text()
+        self._write_tests()
+
+        records = []
+        for k in range(1, MAX_ATTEMPTS + 1):
+            if k > 1 and time.time() - start > self.time_budget * 0.6:
+                safe_log("Time budget mostly used; skipping remaining attempts.")
+                break
+            prior_feedback = None
+            if records:
+                prev = records[-1]
+                prior_feedback = (
+                    f"Previous candidate code:\n```python\n{prev['code'] or '(none)'}\n```\n"
+                    f"Harness output (tail):\n{self._tail(prev['output'])}"
+                )
+                if prev['passed'] is not None and prev['total'] and prev['passed'] == prev['total']:
+                    prior_feedback += ("\nThe previous candidate passed every test. Write an independent solution "
+                                       "with a different approach to cross-check it against.")
+            record = self._solve(k, ATTEMPT_HINTS[(k - 1) % len(ATTEMPT_HINTS)], prior_feedback)
+            records.append(record)
+
+            all_pass = [r for r in records if r['passed'] is not None and r['total'] and r['passed'] == r['total']]
+            if len(all_pass) >= 2:
+                safe_log("Two independent candidates pass all tests; stopping early for selection.")
+                break
+            if all_pass and time.time() - start > self.time_budget * 0.4:
+                break
+
+        self._select_and_finalize(records, task_text)
+
