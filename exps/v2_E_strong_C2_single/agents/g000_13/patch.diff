+def _final_text(msg_history):
+    """Return the text of the last assistant message in an agent message history ('' if none)."""
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict) and msg.get("role") == "assistant":
+            content = msg.get("content")
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
+                if texts:
+                    return "\n".join(texts)
+    return ""
+
+
+def _run_suite(git_tempdir, candidate_relpath):
+    """
+    Run `bash tests/run_suite.sh <candidate>` in git_tempdir.
+    Returns (passed, total, max_time, tail_of_output). passed/total/max_time are None
+    if the final 'PASSED x/y, max_time=t' line is missing. Only that line is parsed.
+    """
+    try:
+        p = subprocess.run(
+            ["bash", "tests/run_suite.sh", candidate_relpath],
+            cwd=git_tempdir, capture_output=True, text=True, timeout=SUITE_TIMEOUT, errors="replace",
+        )
+        out = (p.stdout or "") + ("\nSTDERR:\n" + p.stderr if p.stderr else "")
+    except subprocess.TimeoutExpired as e:
+        out = (e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")) \
+            + f"\nError: suite timed out after {SUITE_TIMEOUT} seconds."
+    tail = out[-SUITE_TAIL_CHARS:]
+    m = None
+    for line in out.splitlines():
+        found = _SUITE_LINE_RE.search(line)
+        if found:
+            m = found
+    if m is None:
+        return None, None, None, tail
+    return int(m.group(1)), int(m.group(2)), float(m.group(3)), tail
