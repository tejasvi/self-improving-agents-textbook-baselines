diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..b305aec
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,89 @@
+import subprocess
+
+MAX_ITER = 1000
+MAX_TIMEOUT = 60
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test comparing a solution program against a brute-force program.
+
+* gen_cmd is run as `<gen_cmd> <seed>` (the seed is appended as the last argument) and must print ONE test input to stdout. Make it take the seed (e.g. via random.seed(int(sys.argv[-1]))) and keep sizes small.
+* For each seed 0..iterations-1, the generated input is fed to stdin of both solution_cmd and brute_cmd, and their stripped stdout is compared.
+* Commands are run with a shell, so use absolute paths or prefix with `cd <dir> && ...`, e.g. `cd /repo && python3 solution.py`.
+* Returns 'ALL PASSED' if every seed matches, otherwise the first failing seed with the generated input, the expected (brute) output and the actual (solution) output. Crashes (non-zero exit) and timeouts are reported as failures with stderr.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the program under test, e.g. 'cd /repo && python3 solution.py'. Reads the input from stdin.",
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted brute-force reference program. Reads the input from stdin.",
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the random input generator. The seed is appended as the last argument; it prints one test input to stdout.",
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default 300, max 1000).",
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each program (default 5, max 60).",
+                },
+            },
+            "required": ["solution_cmd", "brute_cmd", "gen_cmd"],
+        },
+    }
+
+def _run(cmd, inp, timeout):
+    """Returns (status, stdout, stderr) where status is 'ok', 'crash' or 'timeout'."""
+    try:
+        p = subprocess.run(cmd, shell=True, input=inp, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        return 'timeout', '', ''
+    if p.returncode != 0:
+        return 'crash', p.stdout, p.stderr
+    return 'ok', p.stdout, p.stderr
+
+def _clip(s, n=3000):
+    s = s or ''
+    return s if len(s) <= n else s[:n] + f"\n... <{len(s) - n} characters clipped>"
+
+def tool_function(solution_cmd, brute_cmd, gen_cmd, iterations=300, timeout=5):
+    try:
+        iterations = int(iterations) if iterations is not None else 300
+    except (TypeError, ValueError):
+        iterations = 300
+    try:
+        timeout = int(timeout) if timeout is not None else 5
+    except (TypeError, ValueError):
+        timeout = 5
+    iterations = max(1, min(iterations, MAX_ITER))
+    timeout = max(1, min(timeout, MAX_TIMEOUT))
+
+    for seed in range(iterations):
+        gst, inp, gerr = _run(f"{gen_cmd} {seed}", None, timeout)
+        if gst != 'ok':
+            return (f"Generator failed on seed {seed} ({gst}).\n"
+                    f"stderr:\n{_clip(gerr)}")
+        bst, bout, berr = _run(brute_cmd, inp, timeout)
+        sst, sout, serr = _run(solution_cmd, inp, timeout)
+        if bst != 'ok':
+            return (f"Brute force {bst} on seed {seed}; the brute force itself is broken.\n"
+                    f"Input:\n{_clip(inp)}\nstderr:\n{_clip(berr)}")
+        if sst != 'ok':
+            detail = 'timed out' if sst == 'timeout' else 'crashed'
+            return (f"FAILED seed {seed}: solution {detail}.\n"
+                    f"Input:\n{_clip(inp)}\nExpected output (brute):\n{_clip(bout.strip())}\n"
+                    f"Solution stderr:\n{_clip(serr)}")
+        if bout.strip() != sout.strip():
+            return (f"FAILED seed {seed}: output mismatch.\n"
+                    f"Input:\n{_clip(inp)}\nExpected output (brute):\n{_clip(bout.strip())}\n"
+                    f"Actual output (solution):\n{_clip(sout.strip())}")
+    return f"ALL PASSED ({iterations} seeds)"
