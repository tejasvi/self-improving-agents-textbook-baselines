+++ b/tools/run_samples.py
@@ -0,0 +1,77 @@
+import difflib
+import subprocess
+import sys
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a stdin-based solution program on sample tests and compare its stdout with the expected output EXACTLY (byte for byte, ignoring only trailing whitespace at the end of lines/file).\n
+* Each sample is {input, expected_output}. The program is run as `python3 solution_path` with `input` on stdin, with a timeout.
+* Returns PASS or FAIL per sample. On FAIL it shows a unified diff of expected vs actual output.
+* IMPORTANT: a FAIL marked 'VALID BUT DIFFERENT' means the output may be a legitimate alternative answer, but it is still NOT acceptable: the hidden grader compares exactly with the reference output. Such failures must be fixed (e.g. by reproducing the reference construction) even when the answer is valid.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python program to run (e.g. solution.py)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample tests to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact stdin content for the sample."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected stdout content for the sample."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 5)."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+def _norm(s):
+    return "\n".join(line.rstrip() for line in s.replace("\r\n", "\n").split("\n")).rstrip()
+
+def tool_function(solution_path, samples, timeout=5):
+    timeout = max(1, min(int(timeout or 5), 60))
+    results = []
+    all_pass = True
+    for idx, sample in enumerate(samples or [], start=1):
+        inp = sample.get("input", "")
+        expected = sample.get("expected_output", "")
+        try:
+            p = subprocess.run([sys.executable, solution_path], input=inp, capture_output=True,
+                               text=True, timeout=timeout, errors="replace")
+        except subprocess.TimeoutExpired:
+            all_pass = False
+            results.append(f"Sample {idx}: FAIL (timed out after {timeout}s)")
+            continue
+        actual = p.stdout
+        if p.returncode != 0:
+            all_pass = False
+            results.append(f"Sample {idx}: FAIL (exit code {p.returncode})\nSTDERR:\n{p.stderr[-3000:]}")
+            continue
+        if _norm(actual) == _norm(expected):
+            results.append(f"Sample {idx}: PASS")
+            continue
+        all_pass = False
+        diff = "\n".join(difflib.unified_diff(
+            _norm(expected).split("\n"), _norm(actual).split("\n"),
+            fromfile="expected", tofile="actual", lineterm=""))
+        results.append(f"Sample {idx}: FAIL (VALID BUT DIFFERENT or WRONG; must match expected exactly)\n{diff}")
+    summary = "ALL SAMPLES PASS" if all_pass else "SOME SAMPLES FAILED"
+    return summary + "\n" + "\n".join(results)
