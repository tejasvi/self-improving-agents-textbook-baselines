+++ b/tools/stress_test.py
@@ -0,0 +1,134 @@
+import subprocess
+
+MAX_SHRINK_TRIES = 300
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress test a solution against a reference (brute force) program using a random input generator.\n
+* `generator_cmd` is a shell command that receives the integer seed as its LAST argument and prints one test input to stdout (e.g. `python3 gen.py`; the seed is appended automatically).\n
+* For seeds 0..num_tests-1 the tool generates an input, runs `solution_cmd` and `reference_cmd` on it (stdin = input) and compares stdout (whitespace-trimmed per line).\n
+* On the first mismatch, crash, or timeout it tries to shrink the failing input (smaller seeds of the generator, keeping the shortest still-failing input) and returns the failing input, expected output, actual output and stderr.\n
+* If all tests pass it returns 'All N tests passed'.\n
+* Use tiny-parameter generators so failing cases are small.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution under test, e.g. `python3 solution.py`. Reads the input from stdin."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the trusted reference / brute force program, e.g. `python3 brute.py`. Reads the input from stdin."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that prints a random test input to stdout. The seed is appended as the last argument, e.g. `python3 gen.py`."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0..num_tests-1). Default 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a shell command with the given stdin. Returns (status, stdout, stderr).
+    status is 'ok', 'crash' or 'timeout'."""
+    try:
+        p = subprocess.run(["bash", "-c", cmd], input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, errors="replace")
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ""
+        err = e.stderr if isinstance(e.stderr, str) else ""
+        return "timeout", out, err
+    if p.returncode != 0:
+        return "crash", p.stdout, p.stderr
+    return "ok", p.stdout, p.stderr
+
+
+def _norm(s):
+    return "\n".join(line.rstrip() for line in s.strip().splitlines())
+
+
+def _check(seed, solution_cmd, reference_cmd, generator_cmd, timeout):
+    """Generate the input for seed and compare. Returns None if they agree, else a dict describing the failure."""
+    gst, gen_out, gen_err = _run(f"{generator_cmd} {seed}", "", timeout)
+    if gst != "ok":
+        return {"seed": seed, "input": "", "kind": "generator failed", "expected": "",
+                "actual": gen_out, "stderr": gen_err}
+    test_input = gen_out
+    rst, ref_out, ref_err = _run(reference_cmd, test_input, timeout)
+    if rst != "ok":
+        return {"seed": seed, "input": test_input, "kind": f"reference {rst}", "expected": ref_out,
+                "actual": "", "stderr": ref_err}
+    sst, sol_out, sol_err = _run(solution_cmd, test_input, timeout)
+    if sst != "ok":
+        return {"seed": seed, "input": test_input, "kind": f"solution {sst}", "expected": ref_out,
+                "actual": sol_out, "stderr": sol_err}
+    if _norm(sol_out) != _norm(ref_out):
+        return {"seed": seed, "input": test_input, "kind": "wrong answer", "expected": ref_out,
+                "actual": sol_out, "stderr": sol_err}
+    return None
+
+
+def _clip(s, n=4000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _format_failure(fail, shrunk):
+    lines = []
+    if shrunk:
+        lines.append(f"Failure ({fail['kind']}) found at seed {fail['seed']}; shrunk to the shortest failing input found (seed {shrunk['seed']}).")
+    else:
+        lines.append(f"Failure ({fail['kind']}) at seed {fail['seed']}.")
+    lines.append("== INPUT ==")
+    lines.append(_clip(fail['input']).rstrip())
+    lines.append("== EXPECTED OUTPUT (reference) ==")
+    lines.append(_clip(fail['expected']).rstrip())
+    lines.append("== ACTUAL OUTPUT (solution) ==")
+    lines.append(_clip(fail['actual']).rstrip())
+    lines.append("== STDERR (solution) ==")
+    lines.append(_clip(fail['stderr']).rstrip() or "(empty)")
+    return "\n".join(lines)
+
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, num_tests=200, timeout=10):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 100000))
+    except (TypeError, ValueError):
+        num_tests = 200
+    try:
+        timeout = max(1, min(int(timeout or 10), 300))
+    except (TypeError, ValueError):
+        timeout = 10
+
+    first_fail = None
+    for seed in range(num_tests):
+        fail = _check(seed, solution_cmd, reference_cmd, generator_cmd, timeout)
+        if fail is not None:
+            first_fail = fail
+            break
+    if first_fail is None:
+        return f"All {num_tests} tests passed"
+
+    # Shrink: among smaller seeds, keep the shortest input that still fails.
+    best = first_fail
+    shrunk = None
+    for seed in range(min(first_fail['seed'], MAX_SHRINK_TRIES)):
+        fail = _check(seed, solution_cmd, reference_cmd, generator_cmd, timeout)
+        if fail is not None and len(fail['input']) < len(best['input']):
+            best = fail
+            shrunk = fail
+    return _format_failure(best, shrunk)
