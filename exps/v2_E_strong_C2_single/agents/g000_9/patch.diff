+def extract_samples(statement):
+    """Best-effort extraction of (input, expected_output) pairs from blocks labelled
+    'Input' / 'Output' (or 'Sample Input' / 'Sample Output'). Returns [] if none found."""
+    lines = statement.splitlines()
+    samples = []
+    i = 0
+    n = len(lines)
+
+    def label(line, name):
+        t = line.strip().lower().replace('*', '').replace('#', '').strip()
+        if t.startswith('sample '):
+            t = t[len('sample '):]
+        return t.startswith(name) and (len(t) == len(name) or t[len(name)] in ': ')
+
+    while i < n:
+        if label(lines[i], 'input'):
+            inp_lines = []
+            rest = lines[i].split(':', 1)[1].strip() if ':' in lines[i] else ''
+            if rest:
+                inp_lines.append(rest)
+            i += 1
+            while i < n and not label(lines[i], 'output') and not label(lines[i], 'input'):
+                inp_lines.append(lines[i])
+                i += 1
+            if i < n and label(lines[i], 'output'):
+                out_lines = []
+                rest = lines[i].split(':', 1)[1].strip() if ':' in lines[i] else ''
+                if rest:
+                    out_lines.append(rest)
+                i += 1
+                while i < n and lines[i].strip() and not label(lines[i], 'input') and not lines[i].strip().lower().startswith('explanation'):
+                    out_lines.append(lines[i])
+                    i += 1
+                inp = '\n'.join(l.rstrip() for l in inp_lines).strip('\n')
+                exp = '\n'.join(l.rstrip() for l in out_lines).strip()
+                if inp and exp:
+                    samples.append((inp, exp))
+            continue
+        i += 1
+    return samples
