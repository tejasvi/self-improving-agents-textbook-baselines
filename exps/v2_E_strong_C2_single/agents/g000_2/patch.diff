+    def _is_scratch_or_test_file(self, path):
+        """Heuristic: True for test files, scratch files and helper dirs (not the primary source)."""
+        parts = path.replace('\\', '/').split('/')
+        name = parts[-1]
+        if name.startswith('test_') or name.endswith('_test.py'):
+            return True
+        if any(p in ('tests', 'test', 'dev') for p in parts[:-1]):
+            return True
+        if 'scratch' in name.lower() or name.lower().startswith('tmp'):
+            return True
+        return False
+
+    def _has_primary_edit(self):
+        """
+        Return True iff the repo diff (vs base_commit) contains at least one added
+        non-comment, non-blank code line in a non-test/non-scratch file, and (if
+        solution.py exists) solution.py contains more than comment lines.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        if not diff or not diff.strip():
+            return False
+
+        # Parse the diff into per-file added lines.
+        current_file = None
+        added = {}
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                m = re.match(r'diff --git a/(\S+) b/(\S+)', line)
+                current_file = m.group(2) if m else None
+                continue
+            if current_file is None:
+                continue
+            if line.startswith('+++') or line.startswith('---'):
+                continue
+            if line.startswith('+'):
+                added.setdefault(current_file, []).append(line[1:])
+
+        # Primary files: changed files that are not test/scratch files.
+        primary_has_code = False
+        for fname, lines in added.items():
+            if self._is_scratch_or_test_file(fname):
+                continue
+            for l in lines:
+                s = l.strip()
+                if s and not s.startswith('#'):
+                    primary_has_code = True
+                    break
+            if primary_has_code:
+                break
+        if not primary_has_code:
+            return False
+
+        # For the stdin-program format, solution.py must hold more than comment lines.
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.exists(sol_path):
+            with open(sol_path, 'r', encoding='utf-8', errors='replace') as f:
+                code_lines = [l for l in f.read().splitlines()
+                              if l.strip() and not l.lstrip().startswith('#')]
+            if not code_lines:
+                return False
+        return True
+
