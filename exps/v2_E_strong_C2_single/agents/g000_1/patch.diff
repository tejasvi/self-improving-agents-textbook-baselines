@@ -0,0 +1,85 @@
+import os
+import shlex
+import subprocess
+
+STRESS_TIMEOUT = 10
+MAX_ITERATIONS = 1000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run a random stress test comparing a solution against a brute-force reference.\n
+* For seed = 1..iterations it runs `gen_cmd SEED` (the seed is appended as the last argument) to get one test input (printed to stdout), then runs `brute_cmd` and `solution_cmd` on that input (via stdin).\n
+* Returns the first mismatching input together with the expected (brute force) and actual (solution) outputs, plus stderr and exit code. Returns a success message if all tests match.\n
+* Commands are split with shell-style quoting but NOT run through a shell; use absolute paths for scripts, e.g. `python3 /abs/path/brute.py`.\n
+* Each command is run with a 10 second timeout.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {"type": "string", "description": "Command that runs the solution; it reads the test input from stdin, e.g. `python3 /abs/path/solution.py`."},
+                "brute_cmd": {"type": "string", "description": "Command that runs the brute-force reference; it reads the test input from stdin, e.g. `python3 /abs/path/brute.py`."},
+                "gen_cmd": {"type": "string", "description": "Command that prints one random test input to stdout; the integer seed is passed as the last argument, e.g. `python3 /abs/path/gen.py`."},
+                "iterations": {"type": "integer", "description": "Number of random seeds to test (1 to 1000)."}
+            },
+            "required": ["solution_cmd", "brute_cmd", "gen_cmd", "iterations"]
+        }
+    }
+
+
+def _as_text(x):
+    if x is None:
+        return ''
+    if isinstance(x, bytes):
+        return x.decode(errors='replace')
+    return x
+
+
+def _run(args, stdin_text, cwd, timeout=STRESS_TIMEOUT):
+    """Returns (returncode, stdout, stderr). returncode is the string 'timeout' on timeout."""
+    try:
+        p = subprocess.run(args, input=stdin_text, capture_output=True, text=True,
+                           timeout=timeout, cwd=cwd, errors='replace')
+        return p.returncode, p.stdout, p.stderr
+    except subprocess.TimeoutExpired as e:
+        return 'timeout', _as_text(e.stdout), _as_text(e.stderr)
+
+
+def _normalize(s):
+    return [line.rstrip() for line in s.strip().splitlines()]
+
+
+def run_stress_test(solution_cmd, brute_cmd, gen_cmd, iterations=200, cwd=None, timeout=STRESS_TIMEOUT):
+    """
+    Returns None if every tested seed matches, otherwise a dict describing the first
+    failure (raw outputs, no parsing of error messages).
+    """
+    cwd = cwd or os.getcwd()
+    iterations = max(1, min(int(iterations), MAX_ITERATIONS))
+    for seed in range(1, iterations + 1):
+        rc, gen_out, gen_err = _run(shlex.split(gen_cmd) + [str(seed)], None, cwd, timeout)
+        if rc != 0:
+            return {'seed': seed, 'error': 'generator failed', 'stderr': gen_err, 'returncode': rc}
+        test_input = gen_out
+        b_rc, b_out, b_err = _run(shlex.split(brute_cmd), test_input, cwd, timeout)
+        if b_rc != 0:
+            return {'seed': seed, 'error': 'brute force failed', 'input': test_input,
+                    'stderr': b_err, 'returncode': b_rc}
+        s_rc, s_out, s_err = _run(shlex.split(solution_cmd), test_input, cwd, timeout)
+        if s_rc == 0 and _normalize(s_out) == _normalize(b_out):
+            continue
+        return {'seed': seed, 'input': test_input, 'expected': b_out, 'got': s_out,
+                'stderr': s_err, 'returncode': s_rc}
+    return None
+
+
+def tool_function(solution_cmd, brute_cmd, gen_cmd, iterations):
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        return f"Error: iterations must be an integer, got {iterations!r}."
+    result = run_stress_test(solution_cmd, brute_cmd, gen_cmd, iterations=iterations, cwd=os.getcwd())
+    if result is None:
+        return f"All {max(1, min(iterations, MAX_ITERATIONS))} random tests matched the brute force."
+    lines = [f"{k}: {v}" for k, v in result.items()]
+    return "First failing case:\n" + "\n".join(lines)
