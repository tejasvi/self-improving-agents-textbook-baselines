+    def _format_sample_failures(self, failures):
+        blocks = []
+        for f in failures:
+            blocks.append(
+                f"--- sample {f['sample']} ---\n"
+                f"input:\n{self._clip(f['input'])}\n"
+                f"expected output:\n{self._clip(f['expected'])}\n"
+                f"actual output:\n{self._clip(f['got'])}\n"
+                f"stderr:\n{self._clip(f['stderr'])}\n"
+                f"return code: {f['returncode']}"
+            )
+        return "\n\n".join(blocks)
