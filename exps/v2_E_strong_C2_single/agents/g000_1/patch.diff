+    def _clip(text):
+        text = '' if text is None else str(text)
+        if len(text) <= MAX_SHOWN_CHARS:
+            return text
+        return text[:MAX_SHOWN_CHARS // 2] + f"\n... <{len(text) - MAX_SHOWN_CHARS} characters clipped> ...\n" + text[-MAX_SHOWN_CHARS // 2:]
