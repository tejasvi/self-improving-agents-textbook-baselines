@@ -0,0 +1,114 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference using a random input generator.
+
+* generator_cmd is run as `<generator_cmd> <seed>` (the seed is passed as the first argument) and must print exactly one test input to stdout.
+* For seed in 0..num_tests-1, the same input is piped to solution_cmd and brute_cmd (each with a timeout of timeout_per_run seconds).
+* Outputs are compared ignoring trailing whitespace.
+* On the first mismatch, crash, timeout, or generator failure it returns the seed, the input, both outputs and stderr, so you can debug a minimal counterexample. Otherwise it reports that all tests passed.
+* Example: solution_cmd="python3 solution.py", brute_cmd="python3 brute.py", generator_cmd="python3 gen.py", num_tests=300, timeout_per_run=5.
+* Write the generator so that it produces small inputs (where the brute force is fast) and covers edge cases.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; it reads the input from stdin and writes the answer to stdout.",
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the trusted brute-force reference; same stdin/stdout protocol as solution_cmd.",
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that takes the seed as its first argument and prints one test input to stdout.",
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0 to num_tests-1). Default 200.",
+                },
+                "timeout_per_run": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each run of a program. Default 5.",
+                },
+            },
+            "required": ["solution_cmd", "brute_cmd", "generator_cmd"],
+        },
+    }
+
+
+def _clip(s, n=4000):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a shell command with stdin piped. Returns (returncode, stdout, stderr) or raises TimeoutExpired."""
+    p = subprocess.run(
+        cmd,
+        shell=True,
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+        errors="replace",
+    )
+    return p.returncode, p.stdout, p.stderr
+
+
+def tool_function(solution_cmd, brute_cmd, generator_cmd, num_tests=200, timeout_per_run=5):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 5000))
+    except (TypeError, ValueError):
+        num_tests = 200
+    try:
+        timeout_per_run = max(1, min(int(timeout_per_run or 5), 60))
+    except (TypeError, ValueError):
+        timeout_per_run = 5
+
+    for seed in range(num_tests):
+        # 1) generate the input
+        try:
+            gen_rc, test_input, gen_err = _run(f"{generator_cmd} {seed}", "", timeout_per_run)
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out on seed {seed}."
+        if gen_rc != 0:
+            return f"Generator failed on seed {seed} (exit code {gen_rc}).\nSTDERR:\n{_clip(gen_err)}"
+
+        # 2) run the solution and the brute force on the same input
+        results = {}
+        for name, cmd in (("solution", solution_cmd), ("brute", brute_cmd)):
+            try:
+                rc, out, err = _run(cmd, test_input, timeout_per_run)
+            except subprocess.TimeoutExpired:
+                return (
+                    f"TIMEOUT: {name} exceeded {timeout_per_run}s on seed {seed}.\n"
+                    f"INPUT:\n{_clip(test_input)}"
+                )
+            if rc != 0:
+                return (
+                    f"CRASH: {name} exited with code {rc} on seed {seed}.\n"
+                    f"INPUT:\n{_clip(test_input)}\n"
+                    f"STDERR:\n{_clip(err)}"
+                )
+            results[name] = (out, err)
+
+        sol_out, sol_err = results["solution"]
+        brute_out, _ = results["brute"]
+        # 3) compare ignoring trailing whitespace
+        if sol_out.rstrip() != brute_out.rstrip():
+            return (
+                f"MISMATCH on seed {seed}.\n"
+                f"INPUT:\n{_clip(test_input)}\n"
+                f"SOLUTION OUTPUT:\n{_clip(sol_out.rstrip()) or '(empty)'}\n"
+                f"BRUTE OUTPUT:\n{_clip(brute_out.rstrip()) or '(empty)'}\n"
+                f"SOLUTION STDERR:\n{_clip(sol_err)}"
+            )
+
+    return f"All {num_tests} tests passed (seeds 0..{num_tests - 1})."
