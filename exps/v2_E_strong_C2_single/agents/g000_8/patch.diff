diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..61797d4
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,169 @@
+import os
+import subprocess
+
+FAIL_INPUT_PATH = '/tmp/stress_fail_input.txt'
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run a multi-regime differential stress test of a solution against a reference implementation.
+
+* generator_cmd is invoked as `<generator_cmd> <seed> <regime>` and must print one test input to stdout.
+* solution_cmd and reference_cmd are shell commands that read the test input from stdin and print the answer to stdout.
+* If checker_cmd is given it is invoked as `<checker_cmd> <input_file> <solution_output_file> <reference_output_file>`; exit code 0 means the solution output is accepted (use it when several answers are valid). Otherwise the whitespace-normalized outputs must match exactly.
+* For each regime in `regimes`, cases_per_regime seeds are run (seeds 1..cases_per_regime). Each run has a per-case timeout in seconds.
+* Stops at the first failure: the failing input is saved to /tmp/stress_fail_input.txt and a report with the regime, seed, input, solution output, reference output and checker message is returned. On success, per-regime pass counts are returned.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the solution under test; reads the input from stdin and writes the answer to stdout (e.g. 'python3 solution.py')."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted reference (e.g. brute force); reads the input from stdin and writes the answer to stdout."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the input generator; invoked as '<generator_cmd> <seed> <regime>' and prints one test input to stdout (e.g. 'python3 gen.py')."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command validating the solution output; invoked as '<checker_cmd> <input_file> <solution_output_file> <reference_output_file>', exit code 0 means accepted. Omit to compare outputs exactly (whitespace-normalized)."
+                },
+                "regimes": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of regime names passed to the generator, e.g. [\"tiny\", \"medium\", \"dups\", \"large\"]."
+                },
+                "cases_per_regime": {
+                    "type": "integer",
+                    "description": "Number of random cases (seeds 1..N) to run for each regime; use at least 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-case timeout in seconds for each command run (generator, solution, reference, checker)."
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _clip(s, n=4000):
+    if s is None:
+        return ''
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(cmd, stdin_text=None, timeout=10):
+    """Run a shell command. Returns (returncode, stdout, stderr) or raises TimeoutError."""
+    try:
+        p = subprocess.run(['bash', '-c', cmd], input=stdin_text if stdin_text is not None else '',
+                           capture_output=True, text=True, timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        raise TimeoutError(f"command timed out after {timeout} seconds: {cmd}")
+    return p.returncode, p.stdout, p.stderr
+
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, checker_cmd=None, regimes=None,
+                  cases_per_regime=200, timeout=10):
+    try:
+        cases_per_regime = int(cases_per_regime) if cases_per_regime else 200
+    except (TypeError, ValueError):
+        cases_per_regime = 200
+    try:
+        timeout = int(timeout) if timeout else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    timeout = max(1, min(timeout, 300))
+    if not regimes:
+        regimes = ['default']
+    elif isinstance(regimes, str):
+        regimes = [r.strip() for r in regimes.split(',') if r.strip()]
+
+    counts = {}
+    total = 0
+    for regime in regimes:
+        passed = 0
+        for seed in range(1, cases_per_regime + 1):
+            # 1. generate input
+            try:
+                rc, inp, err = _run(f"{generator_cmd} {seed} {regime}", timeout=timeout)
+            except TimeoutError as e:
+                return _fail_report(regime, seed, '', f"Generator error: {e}", counts, passed)
+            if rc != 0:
+                return _fail_report(regime, seed, inp, f"Generator failed (exit {rc}): {err.strip()}", counts, passed)
+            # 2. run solution and reference
+            try:
+                rc_s, out_s, err_s = _run(solution_cmd, stdin_text=inp, timeout=timeout)
+            except TimeoutError as e:
+                return _fail_report(regime, seed, inp, f"Solution error: {e}", counts, passed)
+            try:
+                rc_r, out_r, err_r = _run(reference_cmd, stdin_text=inp, timeout=timeout)
+            except TimeoutError as e:
+                return _fail_report(regime, seed, inp, f"Reference error: {e}", counts, passed)
+            if rc_r != 0:
+                return _fail_report(regime, seed, inp, f"Reference failed (exit {rc_r}): {err_r.strip()}", counts, passed,
+                                    out_s=out_s, out_r=out_r)
+            if rc_s != 0:
+                return _fail_report(regime, seed, inp, f"Solution failed (exit {rc_s}): {err_s.strip()}", counts, passed,
+                                    out_s=out_s, out_r=out_r)
+            # 3. compare
+            if checker_cmd:
+                in_path = '/tmp/stress_case_input.txt'
+                so_path = '/tmp/stress_case_sol_out.txt'
+                ro_path = '/tmp/stress_case_ref_out.txt'
+                with open(in_path, 'w') as f:
+                    f.write(inp)
+                with open(so_path, 'w') as f:
+                    f.write(out_s)
+                with open(ro_path, 'w') as f:
+                    f.write(out_r)
+                try:
+                    rc_c, out_c, err_c = _run(f"{checker_cmd} {in_path} {so_path} {ro_path}", timeout=timeout)
+                except TimeoutError as e:
+                    return _fail_report(regime, seed, inp, f"Checker error: {e}", counts, passed,
+                                        out_s=out_s, out_r=out_r)
+                if rc_c != 0:
+                    msg = (out_c + "\n" + err_c).strip()
+                    return _fail_report(regime, seed, inp, f"Checker rejected (exit {rc_c}): {msg}", counts, passed,
+                                        out_s=out_s, out_r=out_r)
+            else:
+                if out_s.split() != out_r.split():
+                    return _fail_report(regime, seed, inp, "Output mismatch (whitespace-normalized)", counts, passed,
+                                        out_s=out_s, out_r=out_r)
+            passed += 1
+            total += 1
+        counts[regime] = passed
+
+    lines = [f"ALL PASSED: {total} cases total."]
+    for regime in regimes:
+        lines.append(f"  regime '{regime}': {counts.get(regime, 0)}/{cases_per_regime} passed")
+    return "\n".join(lines)
+
+
+def _fail_report(regime, seed, inp, message, counts, passed, out_s=None, out_r=None):
+    try:
+        with open(FAIL_INPUT_PATH, 'w') as f:
+            f.write(inp or '')
+    except OSError:
+        pass
+    lines = [
+        "FAILED",
+        f"regime: {regime}",
+        f"seed: {seed}",
+        f"passed before failure in this regime: {passed}",
+        f"message: {message}",
+        f"failing input (saved to {FAIL_INPUT_PATH}):",
+        _clip(inp or ''),
+    ]
+    if out_s is not None:
+        lines += ["solution output:", _clip(out_s)]
+    if out_r is not None:
+        lines += ["reference output:", _clip(out_r)]
+    return "\n".join(lines)
