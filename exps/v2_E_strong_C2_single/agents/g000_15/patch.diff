diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..25bf1a1
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,101 @@
+import os
+import re
+import subprocess
+import tempfile
+
+# Matches blocks like "Sample Input 1 ... Sample Output 1 ..." (case-insensitive,
+# optional colon, optional code fences). Each block runs until the next
+# "Sample Input" header or the end of the text.
+_PAIR_RE = re.compile(
+    r"Sample\s+Input\s*(\d+)\s*:?[ \t]*\n(.*?)\n[ \t]*Sample\s+Output\s*\1\s*:?[ \t]*\n(.*?)(?=\n[ \t]*Sample\s+Input\s*\d+|\Z)",
+    re.IGNORECASE | re.DOTALL,
+)
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a Python solution on every 'Sample Input k' / 'Sample Output k' pair of a problem statement and compare the outputs.\n
+* For each sample the result is one of: EXACT MATCH, WHITESPACE-ONLY DIFFERENCE, or DIFFERENT (expected and actual output are shown).\n
+* Pass the full problem statement text (or a path to a file containing it) and the path to solution.py.\n
+* A DIFFERENT result means the grader may fail you even if your output is valid for multi-answer problems: try to adapt your construction so the output matches exactly.\n
+* Raw stdout/stderr and exit codes are returned; no interpretation of errors is done.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "statement": {"type": "string", "description": "The full problem statement text, or a path to a file containing it."},
+                "solution_path": {"type": "string", "description": "Path to the solution.py program that reads stdin and writes stdout."},
+                "timeout": {"type": "integer", "description": "Time limit in seconds for each sample run (default 10)."}
+            },
+            "required": ["statement", "solution_path"]
+        }
+    }
+
+
+def _parse_samples(text):
+    samples = []
+    for m in _PAIR_RE.finditer(text):
+        inp = m.group(2).strip("\n")
+        out = m.group(3).strip("\n")
+        inp = re.sub(r"^```[^\n]*\n|\n?```\s*$", "", inp.strip("\n")).strip("\n")
+        out = re.sub(r"^```[^\n]*\n|\n?```\s*$", "", out.strip("\n")).strip("\n")
+        samples.append((int(m.group(1)), inp + "\n", out))
+    return samples
+
+
+def tool_function(statement, solution_path, timeout=10):
+    try:
+        if os.path.isfile(statement):
+            with open(statement) as f:
+                statement = f.read()
+    except (OSError, ValueError):
+        pass
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    samples = _parse_samples(statement)
+    if not samples:
+        return "Error: no 'Sample Input k' / 'Sample Output k' pairs found in the statement."
+
+    lines = []
+    all_exact = True
+    for idx, inp, expected in samples:
+        with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as tf:
+            tf.write(inp)
+            in_path = tf.name
+        try:
+            with open(in_path) as fin:
+                p = subprocess.run(["python3", solution_path], stdin=fin, capture_output=True,
+                                   text=True, timeout=timeout, errors="replace")
+            actual = p.stdout
+            status_extra = "" if p.returncode == 0 else f" (exit code {p.returncode})"
+            stderr = p.stderr.strip()
+        except subprocess.TimeoutExpired:
+            actual = ""
+            status_extra = f" (timed out after {timeout}s)"
+            stderr = ""
+        finally:
+            os.unlink(in_path)
+
+        exp_s = expected.rstrip()
+        act_s = actual.rstrip()
+        if exp_s == act_s and not status_extra:
+            status = "EXACT MATCH"
+        elif "".join(exp_s.split()) == "".join(act_s.split()) and not status_extra:
+            status = "WHITESPACE-ONLY DIFFERENCE"
+        else:
+            status = "DIFFERENT"
+        if status != "EXACT MATCH":
+            all_exact = False
+        block = [f"Sample {idx}: {status}{status_extra}"]
+        if status != "EXACT MATCH":
+            block += ["--- input ---", inp.rstrip(), "--- expected ---", exp_s, "--- actual ---", act_s]
+        if stderr:
+            block += ["--- stderr ---", stderr[-3000:]]
+        lines.append("\n".join(block))
+
+    summary = "ALL SAMPLES EXACT MATCH" if all_exact else "SOME SAMPLES DID NOT MATCH EXACTLY"
+    return summary + "\n\n" + "\n\n".join(lines)
