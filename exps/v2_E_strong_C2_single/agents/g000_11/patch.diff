+"""
+Generic helpers for running candidate programs and ranking them.
+
+Nothing in here parses or classifies errors: raw stdout/stderr/return codes are
+returned to the caller so they can be passed back to the agent verbatim.
+"""
+import re
+import subprocess
+import time
+
+
+def run_candidate(cmd, input=None, timeout=10, cwd=None):
+    """
+    Run `cmd` (a list of args) with optional stdin text and a timeout.
+
+    Returns a dict with raw 'stdout', 'stderr', 'returncode', 'runtime' (seconds),
+    and 'timed_out' (bool). Never raises for timeouts or non-zero exits.
+    """
+    start = time.time()
+    try:
+        p = subprocess.run(
+            cmd,
+            input=input if input is not None else "",
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            cwd=cwd,
+            errors="replace",
+        )
+        return {
+            "stdout": p.stdout,
+            "stderr": p.stderr,
+            "returncode": p.returncode,
+            "runtime": time.time() - start,
+            "timed_out": False,
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return {
+            "stdout": out or "",
+            "stderr": err or "",
+            "returncode": None,
+            "runtime": time.time() - start,
+            "timed_out": True,
+        }
+
+
+_NUM = r"([-+]?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)"
+
+
+def parse_field(report_text, name):
+    """
+    Return the float value of the last line 'NAME: <number>' in a harness report, or None.
+    Only the numeric SCORE and RUNTIME lines are read from reports; everything else stays raw.
+    """
+    matches = re.findall(rf"^{name}:\s*{_NUM}\s*$", report_text or "", re.MULTILINE)
+    if not matches:
+        return None
+    return float(matches[-1])
+
+
+def parse_score(report_text):
+    """Return the numeric 'SCORE:' value of a harness report, or None."""
+    return parse_field(report_text, "SCORE")
+
+
+def rank_key(score, runtime):
+    """Sort key for selecting the best candidate: higher score first, then faster."""
+    return (score, -runtime)
+
+
+def best_index(entries):
+    """
+    `entries` is a list of dicts with 'score' and 'runtime'.
+    Returns the index of the best entry by (score, -runtime), or None if empty.
+    """
+    best = None
+    for i, e in enumerate(entries):
+        if best is None or rank_key(e["score"], e["runtime"]) > rank_key(entries[best]["score"], entries[best]["runtime"]):
+            best = i
+    return best
+
+
+def normalize_output(text):
+    """Whitespace-insensitive comparison key for two outputs."""
+    return "\n".join(line.rstrip() for line in (text or "").strip().splitlines())
