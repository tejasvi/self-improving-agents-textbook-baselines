+    def _run_test_script(self):
+        """Run tests/run_tests.sh under git_tempdir. Returns (returncode, raw_output)."""
+        script = os.path.join('tests', 'run_tests.sh')
+        if not os.path.exists(os.path.join(self.git_tempdir, script)):
+            return 1, f"{script} does not exist yet."
+        try:
+            result = subprocess.run(
+                ['bash', script],
+                cwd=self.git_tempdir,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                timeout=self.TEST_TIMEOUT,
+            )
+            out = result.stdout.decode(errors='replace')
+            rc = result.returncode
+        except subprocess.TimeoutExpired:
+            out = f"[run_tests.sh timed out after {self.TEST_TIMEOUT}s]"
+            rc = 1
+        except Exception as e:
+            out = f"[failed to run tests: {e}]"
+            rc = 1
+        return rc, out
+
+    def _truncate(self, text):
