+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the last assistant message in a message history (or '')."""
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = [b.get('text', '') for b in content if isinstance(b, dict) and b.get('text')]
+                if texts:
+                    return '\n'.join(texts)
+        return ''
