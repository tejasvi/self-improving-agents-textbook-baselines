diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..06f7fed
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,117 @@
+import os
+import subprocess
+import sys
+
+RUN_TIMEOUT = 10.0  # seconds per program run
+MAX_OUTPUT_CHARS = 1500
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a fast solution against a brute-force solution on random inputs.\n
+* Runs the generator (`python3 generator_path SEED`, which must print one test input to stdout) for `num_tests` seeds (0..num_tests-1).\n
+* Feeds each generated input to both `python3 brute_path` and `python3 fast_path` and compares their outputs (whitespace-normalized).\n
+* Returns 'all passed' if every case matches, otherwise the first differing input together with both outputs.\n
+* Write the brute-force and generator files yourself with the editor tool or bash before calling this tool.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the trusted brute-force Python program (reads stdin, writes stdout)."
+                },
+                "fast_path": {
+                    "type": "string",
+                    "description": "Path to the optimized Python program to test (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator program. It is run as `python3 generator_path SEED` and must print one random test input to stdout; it should produce small inputs."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random test cases to run (seeds 0 to num_tests-1). Optional; defaults to 200."
+                }
+            },
+            "required": ["brute_path", "fast_path", "generator_path", "num_tests"]
+        }
+    }
+
+
+def _run(program, stdin_text):
+    proc = subprocess.run(
+        ["python3", program],
+        input=stdin_text.encode("utf-8"),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=RUN_TIMEOUT,
+    )
+    out = proc.stdout.decode(errors="replace")
+    err = proc.stderr.decode(errors="replace").strip()
+    if proc.returncode != 0:
+        out += f"\n[exit code {proc.returncode}] {err[-500:]}"
+    return out
+
+
+def _normalize(s):
+    return " ".join(s.split())
+
+
+def _clip(s):
+    s = s.rstrip("\n") or "(empty)"
+    if len(s) > MAX_OUTPUT_CHARS:
+        s = s[:MAX_OUTPUT_CHARS] + "\n...(truncated)"
+    return s
+
+
+def tool_function(brute_path, fast_path, generator_path, num_tests=200):
+    for label, p in (("brute_path", brute_path), ("fast_path", fast_path), ("generator_path", generator_path)):
+        if not os.path.isfile(p):
+            return f"Error: {label} file not found: {p}"
+    try:
+        num_tests = int(num_tests)
+    except (TypeError, ValueError):
+        return f"Error: num_tests must be an integer, got {num_tests!r}"
+    if num_tests <= 0:
+        return "Error: num_tests must be positive."
+
+    for seed in range(num_tests):
+        try:
+            gen = subprocess.run(
+                ["python3", generator_path, str(seed)],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=RUN_TIMEOUT,
+            )
+        except subprocess.TimeoutExpired:
+            return f"Error: generator timed out on seed {seed}."
+        if gen.returncode != 0:
+            return f"Error: generator failed on seed {seed}: {gen.stderr.decode(errors='replace').strip()[-500:]}"
+        test_input = gen.stdout.decode(errors="replace")
+
+        try:
+            expected = _run(brute_path, test_input)
+        except subprocess.TimeoutExpired:
+            return f"Error: brute-force solution timed out on seed {seed}; input:\n{_clip(test_input)}"
+        try:
+            actual = _run(fast_path, test_input)
+        except subprocess.TimeoutExpired:
+            return (f"MISMATCH on seed {seed} (fast solution timed out).\n"
+                    f"Input:\n{_clip(test_input)}\n"
+                    f"Brute-force output:\n{_clip(expected)}\n"
+                    f"Fast output:\n(timed out)")
+
+        if _normalize(expected) != _normalize(actual):
+            return (f"MISMATCH on seed {seed} after {seed + 1} test(s).\n"
+                    f"Input:\n{_clip(test_input)}\n"
+                    f"Brute-force output:\n{_clip(expected)}\n"
+                    f"Fast output:\n{_clip(actual)}")
+
+    return f"all passed ({num_tests} random tests)"
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 4:
+        print("usage: stress_test.py BRUTE_PATH FAST_PATH GENERATOR_PATH [NUM_TESTS]")
+        sys.exit(1)
+    n = int(sys.argv[4]) if len(sys.argv) > 4 else 200
+    print(tool_function(sys.argv[1], sys.argv[2], sys.argv[3], n))
