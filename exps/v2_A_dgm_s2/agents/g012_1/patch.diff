+def _dedupe_paragraphs(text):
+    """
+    Split text into blank-line-separated blocks and drop exact-duplicate multi-line blocks
+    (e.g. a repeated 'Input and Output' section), preserving the order of first occurrences.
+    Single-line blocks are kept as they are.
+    """
+    if not text:
+        return text or ''
+    blocks = re.split(r'\n[ \t]*\n', text)
+    seen = set()
+    kept = []
+    for block in blocks:
+        key = block.strip()
+        if key and '\n' in key:
+            if key in seen:
+                continue
+            seen.add(key)
+        kept.append(block)
+    return '\n\n'.join(kept)
+
+def _extract_code(text):
+    """
+    Return the code inside the first fenced python block of text, or None if there is none.
+    """
+    match = re.search(r'```(?:python|py)?[ \t]*\n(.*?)```', text or '', flags=re.DOTALL)
+    if match and match.group(1).strip():
+        return match.group(1)
+    return None
