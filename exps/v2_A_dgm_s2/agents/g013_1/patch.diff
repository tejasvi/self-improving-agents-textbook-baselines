 def extract_python_code(text):
     """
-    Return the contents of the first 
\ No newline at end of file
+    Return the contents of the first ```python fenced code block in `text`.
+    If no ```python block exists, fall back to the first generic ``` block.
+    If no fenced block exists at all, return the stripped text.
+    """
+    if not isinstance(text, str):
+        return ""
+    match = re.search(r"```python[ \t]*\n(.*?)```", text, re.DOTALL)
+    if match is None:
+        match = re.search(r"```[^\n]*\n(.*?)```", text, re.DOTALL)
+    if match is None:
+        return text.strip()
+    return match.group(1).strip("\n")
+
+
+if __name__ == "__main__":
+    sample = sys.stdin.read()
+    sys.stdout.write(extract_python_code(sample) + "\n")
