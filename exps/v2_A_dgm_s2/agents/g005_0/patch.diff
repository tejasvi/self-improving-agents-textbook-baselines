+"""
+Placeholder solution.py.
+
+The repository does not contain the competitive programming problem statement,
+so this program implements a generic, clearly defined stdin/stdout contract:
+  - Input: first line T (number of test cases). Each test case is a line with
+    N followed by N integers.
+  - Output: for each test case, print the sum of the N integers.
+
+Replace the body of `solve_case` once the real problem statement is known.
+"""
+import sys
+
+
+def solve_case(nums):
+    return sum(nums)
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    idx = 0
+    t = int(data[idx]); idx += 1
+    out = []
+    for _ in range(t):
+        n = int(data[idx]); idx += 1
+        nums = [int(x) for x in data[idx:idx + n]]
+        idx += n
+        out.append(str(solve_case(nums)))
+    sys.stdout.write("\n".join(out) + ("\n" if out else ""))
+
+
+if __name__ == "__main__":
+    main()
