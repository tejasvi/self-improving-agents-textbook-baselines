+    def _changed_file_paths(self):
+        """
+        Return the list of file paths changed relative to the base commit,
+        parsed from the `diff --git a/X b/X` headers of the current diff.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        paths = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.+) b/(.+)$', line)
+            if m:
+                paths.append(m.group(2))
+        return paths
+
+    @staticmethod
+    def _is_test_path(path):
+        parts = [p for p in path.replace('\\', '/').split('/') if p]
+        if not parts:
+            return False
+        dirs, filename = parts[:-1], parts[-1]
+        for d in dirs:
+            if d.lower() in ('test', 'tests', 'spec', 'specs', '__tests__'):
+                return True
+        name = filename.lower()
+        if name.startswith('test_') or name.startswith('spec_'):
+            return True
+        test_suffixes = (
+            '_test.py', '_test.go', '_test.rs', '_test.cpp', '_test.cc', '_test.js', '_test.ts',
+            '.test.js', '.test.ts', '.test.jsx', '.test.tsx', '.spec.js', '.spec.ts',
+            '.spec.jsx', '.spec.tsx', 'test.java', 'tests.java', 'test.cpp',
+        )
+        return name.endswith(test_suffixes)
+
+    def _has_valid_source_patch(self):
+        """
+        Return True if the current diff against the base commit touches at least
+        one non-test file.
+        """
+        try:
+            paths = self._changed_file_paths()
+        except Exception as e:
+            safe_log(f"Failed to compute diff while validating patch: {e}", logging.WARNING)
+            return False
+        return any(not self._is_test_path(p) for p in paths)
+
