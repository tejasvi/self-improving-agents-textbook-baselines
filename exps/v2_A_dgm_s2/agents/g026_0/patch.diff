+import difflib
+import glob
+import os
+import subprocess
+import sys
+
+TIMEOUT_SECONDS = 20
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution file on every sample test case and compare its output with the expected output.
+* Each sample is a pair of files in samples_dir: N.in (input) and N.out (expected output), e.g. 1.in and 1.out.
+* The solution is run as `python3 <solution_path>` with the .in file on stdin, with a timeout.
+* Comparison is whitespace-normalised (line endings and trailing spaces/blank lines are ignored).
+* Returns a per-sample PASS/FAIL report, and a unified diff (expected vs actual) for each FAIL.
+* Use this to check exact sample conformance before finishing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. solution.py)."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing the sample files N.in and N.out (e.g. /tmp/samples)."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.replace('\r\n', '\n').replace('\r', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def _sample_sort_key(path):
+    stem = os.path.splitext(os.path.basename(path))[0]
+    return (0, int(stem), stem) if stem.isdigit() else (1, 0, stem)
+
+
+def tool_function(solution_path, samples_dir):
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isdir(samples_dir):
+        return f"Error: samples directory not found: {samples_dir}"
+
+    in_files = sorted(glob.glob(os.path.join(samples_dir, '*.in')), key=_sample_sort_key)
+    if not in_files:
+        return f"Error: no *.in sample files found in {samples_dir}"
+
+    report_lines = []
+    diffs = []
+    passed = 0
+    for in_path in in_files:
+        name = os.path.splitext(os.path.basename(in_path))[0]
+        out_path = os.path.join(samples_dir, name + '.out')
+        if not os.path.isfile(out_path):
+            report_lines.append(f"Sample {name}: FAIL (missing expected file {name}.out)")
+            continue
+        with open(in_path, 'r', encoding='utf-8') as f:
+            stdin_data = f.read()
+        with open(out_path, 'r', encoding='utf-8') as f:
+            expected = f.read()
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=stdin_data, capture_output=True, text=True, timeout=TIMEOUT_SECONDS,
+            )
+        except subprocess.TimeoutExpired:
+            report_lines.append(f"Sample {name}: FAIL (timeout after {TIMEOUT_SECONDS}s)")
+            continue
+        actual = proc.stdout
+        if proc.returncode != 0:
+            report_lines.append(f"Sample {name}: FAIL (exit code {proc.returncode}) stderr: {proc.stderr.strip()[-1000:]}")
+            continue
+        exp_lines, act_lines = _normalize(expected), _normalize(actual)
+        if exp_lines == act_lines:
+            passed += 1
+            report_lines.append(f"Sample {name}: PASS")
+        else:
+            report_lines.append(f"Sample {name}: FAIL")
+            diff = difflib.unified_diff(
+                exp_lines, act_lines, fromfile=f"{name}.out (expected)", tofile=f"{name} (actual)", lineterm='',
+            )
+            diffs.append("\n".join(diff))
+
+    total = len(in_files)
+    summary = f"Summary: {passed}/{total} samples passed."
+    result = "\n".join(report_lines) + "\n" + summary
+    if diffs:
+        result += "\n\nDiffs for failing samples:\n" + "\n\n".join(diffs)
+    return result
