+"""Standalone implementations of the helpers requested for coding_agent.py.
+
+_dedupe_paragraphs(text): drop exact duplicate blank-line-separated paragraphs,
+preserving the order of first occurrence.
+
+_is_empty_response(msg_history): True when the last assistant message has no
+non-whitespace text and no tool use. The helpers below mirror the behavior of
+the existing `_last_assistant_text` / `_has_tool_use` helpers in coding_agent.py
+and are self-contained so this file can be tested on its own.
+"""
+import re
+
+
+def _dedupe_paragraphs(text):
+    if not text:
+        return text or ''
+    blocks = re.split(r'\n\s*\n', text)
+    seen = set()
+    kept = []
+    for block in blocks:
+        key = block.strip()
+        if not key:
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        kept.append(block.strip('\n'))
+    return '\n\n'.join(kept)
+
+
+def _last_assistant_text(msg_history):
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    parts.append(block.get('text') or '')
+            return ''.join(parts)
+    return ''
+
+
+def _has_tool_use(msg_history):
+    for msg in msg_history or []:
+        if isinstance(msg, dict):
+            if msg.get('type') in ('function_call', 'function_call_output'):
+                return True
+            content = msg.get('content')
+        else:
+            if getattr(msg, 'type', None) == 'function_call' or getattr(msg, 'tool_calls', None):
+                return True
+            content = getattr(msg, 'content', None)
+        if isinstance(content, str):
+            if '<tool_use>' in content:
+                return True
+            continue
+        for block in content or []:
+            if isinstance(block, dict) and block.get('type') in ('tool_use', 'function_call'):
+                return True
+    return False
+
+
+def _is_empty_response(msg_history):
+    if _has_tool_use(msg_history):
+        return False
+    return not _last_assistant_text(msg_history).strip()
+
+
+if __name__ == '__main__':
+    import sys
+    data = sys.stdin.read()
+    print(_dedupe_paragraphs(data))
