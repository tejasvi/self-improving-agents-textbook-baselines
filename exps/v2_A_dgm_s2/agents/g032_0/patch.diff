+# Matches a fenced code block whose closing fence is present.
+# Truncated replies (no closing ```) do NOT match.
+_FENCE_RE = re.compile(r'```(?:python|py)?[ \t]*\n(.*?)\n```', re.DOTALL)
+
+
+def extract_closed_code_block(reply):
+    """Return the code inside the first closed fenced block, or None."""
+    if not reply:
+        return None
+    m = _FENCE_RE.search(reply)
+    if not m:
+        return None
+    return m.group(1)
+
+
+def is_parseable(code):
+    """True if code is valid Python syntax (ast.parse succeeds)."""
+    try:
+        ast.parse(code)
+        return True
+    except (SyntaxError, ValueError):
+        return False
+
+
+def safe_write_solution(path, reply):
+    """Extract code from an LLM reply and write it only if it is complete and parseable.
+
+    Returns (True, message) on success, (False, reason) otherwise. Never writes
+    truncated or unparseable code.
+    """
+    code = extract_closed_code_block(reply)
+    if code is None:
+        return False, "no closed code fence found (reply may be truncated)"
+    if not is_parseable(code):
+        return False, "extracted code failed ast.parse"
+    directory = os.path.dirname(os.path.abspath(path))
+    os.makedirs(directory, exist_ok=True)
+    with open(path, "w") as f:
+        f.write(code if code.endswith("\n") else code + "\n")
+    return True, f"wrote {path}"
+
+
+def compiles(path):
+    """True if the file at path passes py_compile."""
+    try:
+        py_compile.compile(path, doraise=True)
+        return True
+    except py_compile.PyCompileError:
+        return False
+
+
+def find_candidate_solutions(class_name, search_dirs, max_age_seconds=None):
+    """Find compiling .py files under search_dirs that define `class_name`.
+
+    Returns a list of paths sorted newest first.
+    """
+    now = time.time()
+    found = []
+    pattern = re.compile(r'^\s*class\s+' + re.escape(class_name) + r'\b', re.MULTILINE)
+    for d in search_dirs:
+        if not os.path.isdir(d):
+            continue
+        for root, _dirs, files in os.walk(d):
+            for name in files:
+                if not name.endswith(".py"):
+                    continue
+                p = os.path.join(root, name)
+                try:
+                    mtime = os.path.getmtime(p)
+                    if max_age_seconds is not None and now - mtime > max_age_seconds:
+                        continue
+                    with open(p, errors="ignore") as f:
+                        text = f.read()
+                except OSError:
+                    continue
+                if pattern.search(text) and compiles(p):
+                    found.append((mtime, p))
+    found.sort(reverse=True)
+    return [p for _, p in found]
+
+
