+    def _patch_is_acceptable(self):
+        """
+        Check the current repo diff against the base commit.
+        Returns (ok, diff, files). The patch is unacceptable if it is empty or
+        if every changed file looks like a test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+            if m:
+                path = m.group(2).strip()
+                if path not in files:
+                    files.append(path)
+        if not files:
+            return False, diff, files
+        test_markers = ('test', 'spec', 'conftest')
+        non_test_files = [f for f in files if not any(t in f.lower() for t in test_markers)]
+        if not non_test_files:
+            return False, diff, files
+        return True, diff, files
+
+    def _list_repo_files(self):
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            return result.stdout.decode(errors='replace').splitlines()
+        except Exception as e:
+            return [f"(failed to list files: {e})"]
+
