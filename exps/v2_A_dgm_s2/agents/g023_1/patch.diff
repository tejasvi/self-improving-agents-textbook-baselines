+def _response_metadata(response):
+    """
+    Return a short description of a raw API response (stop reason, content block types, output types)
+    for diagnosing empty replies.
+    """
+    meta = {}
+    try:
+        meta['stop_reason'] = getattr(response, 'stop_reason', None)
+        content = getattr(response, 'content', None)
+        if content is not None:
+            meta['content_block_types'] = [getattr(b, 'type', None) or (b.get('type') if isinstance(b, dict) else None) for b in content]
+        output = getattr(response, 'output', None)
+        if output is not None:
+            meta['output_types'] = [getattr(b, 'type', None) for b in output]
+        status = getattr(response, 'status', None)
+        if status is not None:
+            meta['status'] = status
+    except Exception as e:
+        meta['error'] = str(e)
+    return meta
+
+def chat_text_only(msg, model=CLAUDE_MODEL, system_message=None, logging=print, max_retry=2):
+    """
+    Plain text LLM call with NO tool schema. Returns the reply text ('' if empty).
+    Supports Claude models (messages API) and o3-style models (responses API).
+    """
+    separator = '=' * 10
+    logging(f"\n{separator} Text-only request (model={model}) {separator}\n{msg}")
+    client, client_model = create_client(model)
+    text = ''
+    for attempt in range(max_retry + 1):
+        try:
+            if 'claude' in client_model:
+                kwargs = dict(
+                    model=client_model,
+                    max_tokens=8192,
+                    messages=[{"role": "user", "content": [{"type": "text", "text": msg}]}],
+                )
+                if system_message:
+                    kwargs['system'] = system_message
+                response = client.messages.create(**kwargs)
+                text = "\n".join(
+                    b.text for b in response.content if getattr(b, 'type', None) == 'text' and getattr(b, 'text', None)
+                )
+            elif client_model.startswith('o3-') or client_model.startswith('o1-'):
+                input_msgs = []
+                if system_message:
+                    input_msgs.append({"role": "developer", "content": system_message})
+                input_msgs.append({"role": "user", "content": msg})
+                response = client.responses.create(model=client_model, input=input_msgs)
+                text = getattr(response, 'output_text', None) or ''
+            else:
+                raise ValueError(f"chat_text_only: unsupported model {model}")
+        except Exception as e:
+            logging(f"chat_text_only error (attempt {attempt}): {e}")
+            text = ''
+            continue
+        if text.strip():
+            break
+        logging(f"chat_text_only empty reply (attempt {attempt}); metadata={_response_metadata(response)}")
+    logging(f"\n{separator} Text-only reply (model={model}) {separator}\n{text}")
+    return text
+
