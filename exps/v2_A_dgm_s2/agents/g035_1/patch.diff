+def _message_is_empty(msg):
+    """True if an assistant message has no non-whitespace text and no tool_use blocks."""
+    content = msg.get('content')
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return not content.strip()
+    for block in content:
+        btype = _block_field(block, 'type')
+        if btype == 'tool_use':
+            return False
+        if btype == 'text':
+            text = _block_field(block, 'text') or ''
+            if str(text).strip():
+                return False
+        elif btype is not None:
+            # other block types (e.g. thinking, tool_result) carry content
+            if btype != 'thinking' and btype != 'redacted_thinking':
+                return False
+    return True
