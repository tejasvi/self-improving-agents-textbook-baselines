+def _is_test_path(path):
+    """True if the path looks like a test file, judged by components and basename only."""
+    parts = [p for p in re.split(r'[\\/]', path.strip()) if p]
+    if not parts:
+        return False
+    if any(p.lower() in ('test', 'tests', '__tests__') for p in parts[:-1]):
+        return True
+    base = parts[-1].lower()
+    return (
+        base.startswith('test_')
+        or base.endswith('_test.py')
+        or base.endswith('.spec.js')
+        or base.endswith('.spec.ts')
+        or base.endswith('.test.js')
+        or base.endswith('.test.ts')
+        or base == 'conftest.py'
+    )
+
+def _block_field(block, key):
+    if isinstance(block, dict):
+        return block.get(key)
+    return getattr(block, key, None)
