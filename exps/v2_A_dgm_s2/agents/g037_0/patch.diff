 import re
+import subprocess
 import sys
 
 
@@ -18,6 +19,59 @@ def extract_python_code(text):
     return match.group(1).strip("\n")
 
 
+def _extract_code(text):
+    """Extract code from an LLM reply (fenced block preferred)."""
+    return extract_python_code(text)
+
+
+_SAMPLE_RE = re.compile(
+    r"Sample Input\s*(\d+)\s*:?\s*\n(.*?)\n\s*Sample Output\s*\1\s*:?\s*\n(.*?)(?=\n\s*Sample Input\s*\d+|\Z)",
+    re.DOTALL | re.IGNORECASE,
+)
+
+
+def _strip_fence(block):
+    block = block.strip("\n")
+    m = re.match(r"^\s*```[^\n]*\n(.*?)\n?```\s*$", block, re.DOTALL)
+    if m:
+        block = m.group(1)
+    return block.strip()
+
+
+def _parse_samples(problem_statement):
+    """
+    Parse 'Sample Input N' / 'Sample Output N' blocks into (input, expected) pairs.
+    Blocks may be fenced with ``` or plain text.
+    """
+    if not isinstance(problem_statement, str):
+        return []
+    pairs = []
+    for _, raw_in, raw_out in _SAMPLE_RE.findall(problem_statement):
+        pairs.append((_strip_fence(raw_in), _strip_fence(raw_out)))
+    return pairs
+
+
+def _run_candidate(path, input_str, timeout=5.0):
+    """
+    Run a python file with input_str on stdin under a timeout.
+    Returns dict with keys: status ('ok' | 'error' | 'timeout'), stdout, stderr.
+    """
+    try:
+        proc = subprocess.run(
+            [sys.executable, path],
+            input=input_str,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return {"status": "timeout", "stdout": out, "stderr": err}
+    status = "ok" if proc.returncode == 0 else "error"
+    return {"status": status, "stdout": proc.stdout, "stderr": proc.stderr}
+
+
 if __name__ == "__main__":
     sample = sys.stdin.read()
     sys.stdout.write(extract_python_code(sample) + "\n")
