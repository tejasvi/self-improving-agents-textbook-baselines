+"""Standalone helpers for the coding agent workflow.
+
+- extract_samples: parse 'Sample Input k' / 'Sample Output k' blocks from a statement
+  and write them to <out_dir>/k.in and <out_dir>/k.out.
+- run_stress: run gen.py <seed> to create inputs, compare solution.py against brute.py
+  (whitespace-normalised), and return the first counterexample or 'ALL PASSED'.
+- score_candidate / pick_best: harness-side scoring of candidates as
+  (samples_passed, stress_passed, not_timeout).
+"""
+import glob
+import os
+import re
+import subprocess
+import sys
+
+SAMPLE_RE = re.compile(
+    r'Sample Input (\d+)\s*\n(.*?)\n\s*Sample Output \1\s*\n(.*?)(?=\n\s*Sample Input|\n\s*Remember|\n## |\Z)',
+    re.DOTALL,
+)
+
+RUN_TIMEOUT = 10
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.replace('\r\n', '\n').replace('\r', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def extract_samples(statement, out_dir='/tmp/samples'):
+    """Write sample pairs to out_dir and return the number extracted."""
+    os.makedirs(out_dir, exist_ok=True)
+    count = 0
+    for m in SAMPLE_RE.finditer(statement):
+        idx, inp, out = m.group(1), m.group(2).strip('\n') + '\n', m.group(3).strip('\n') + '\n'
+        with open(os.path.join(out_dir, f'{idx}.in'), 'w', encoding='utf-8') as f:
+            f.write(inp)
+        with open(os.path.join(out_dir, f'{idx}.out'), 'w', encoding='utf-8') as f:
+            f.write(out)
+        count += 1
+    print(f'Extracted {count} sample(s) to {out_dir}.')
+    return count
+
+
+def _run(path, stdin_data, timeout=RUN_TIMEOUT):
+    """Returns (status, stdout). status is 'ok', 'timeout', or 'error: ...'."""
+    try:
+        proc = subprocess.run([sys.executable, path], input=stdin_data,
+                              capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return 'timeout', ''
+    if proc.returncode != 0:
+        return f'error: exit {proc.returncode}: {proc.stderr.strip()[-500:]}', proc.stdout
+    return 'ok', proc.stdout
+
+
+def run_samples(solution_path, samples_dir='/tmp/samples'):
+    """Return (passed, total) over N.in / N.out pairs."""
+    in_files = glob.glob(os.path.join(samples_dir, '*.in'))
+    passed = 0
+    for in_path in in_files:
+        out_path = in_path[:-3] + '.out'
+        if not os.path.isfile(out_path):
+            continue
+        with open(in_path, encoding='utf-8') as f:
+            data = f.read()
+        with open(out_path, encoding='utf-8') as f:
+            expected = f.read()
+        status, actual = _run(solution_path, data)
+        if status == 'ok' and _normalize(actual) == _normalize(expected):
+            passed += 1
+    return passed, len(in_files)
+
+
+def run_stress(solution_path, brute_path, gen_path, num_tests=300, timeout=RUN_TIMEOUT):
+    """Compare solution vs brute on random inputs from gen.py <seed>.
+
+    Returns ('ALL PASSED', stress_passed) or a counterexample report string.
+    Returns (report, stress_passed) with stress_passed = number of tests passed before failure.
+    """
+    for seed in range(num_tests):
+        try:
+            gen = subprocess.run([sys.executable, gen_path, str(seed)],
+                                 capture_output=True, text=True, timeout=timeout)
+        except subprocess.TimeoutExpired:
+            return f'Generator timed out on seed {seed}', seed
+        if gen.returncode != 0:
+            return f'Generator failed on seed {seed}: {gen.stderr.strip()[-500:]}', seed
+        data = gen.stdout
+        exp_status, expected = _run(brute_path, data, timeout)
+        act_status, actual = _run(solution_path, data, timeout)
+        if exp_status != 'ok':
+            return f'Brute failed on seed {seed}: {exp_status}', seed
+        if act_status != 'ok':
+            return (f'Counterexample (seed {seed}): solution {act_status}\n'
+                    f'Input:\n{data}\nExpected:\n{expected}'), seed
+        if _normalize(expected) != _normalize(actual):
+            return (f'Counterexample (seed {seed})\nInput:\n{data}\n'
+                    f'Expected:\n{expected}\nActual:\n{actual}'), seed
+    return 'ALL PASSED', num_tests
+
+
+def score_candidate(solution_path, brute_path, gen_path, samples_dir='/tmp/samples', num_tests=300):
+    """Return (samples_passed, stress_passed, not_timeout) as a comparable tuple."""
+    samples_passed, _ = run_samples(solution_path, samples_dir)
+    report, stress_passed = run_stress(solution_path, brute_path, gen_path, num_tests)
+    not_timeout = 0 if 'timed out' in report or 'timeout' in report else 1
+    return (samples_passed, stress_passed, not_timeout), report
+
+
+def pick_best(scored):
+    """scored: list of (path, score_tuple). Returns the path with max score, or None."""
+    if not scored:
+        return None
+    return max(scored, key=lambda item: item[1])[0]
+
+
+if __name__ == '__main__':
+    import tempfile
+
+    # Self-test with a tiny problem: sum of two integers.
+    statement = """Problem: add two numbers.
+Sample Input 1
+1 2
+Sample Output 1
+3
+Sample Input 2
+5 7
+Sample Output 2
+12
+Remember to be fast.
+"""
+    with tempfile.TemporaryDirectory() as d:
+        samples = os.path.join(d, 'samples')
+        assert extract_samples(statement, samples) == 2
+        assert open(os.path.join(samples, '1.in')).read() == '1 2\n'
+        assert open(os.path.join(samples, '2.out')).read() == '12\n'
+
+        good = os.path.join(d, 'good.py')
+        bad = os.path.join(d, 'bad.py')
+        brute = os.path.join(d, 'brute.py')
+        gen = os.path.join(d, 'gen.py')
+        with open(good, 'w') as f:
+            f.write('a, b = map(int, input().split())\nprint(a + b)\n')
+        with open(bad, 'w') as f:
+            f.write('a, b = map(int, input().split())\nprint(a - b)\n')
+        with open(brute, 'w') as f:
+            f.write('a, b = map(int, input().split())\nprint(a + b)\n')
+        with open(gen, 'w') as f:
+            f.write('import random, sys\nrandom.seed(int(sys.argv[1]))\n'
+                    'print(random.randint(-99, 99), random.randint(-99, 99))\n')
+
+        assert run_samples(good, samples) == (2, 2)
+        assert run_samples(bad, samples)[0] == 0
+        report, n = run_stress(good, brute, gen, 50)
+        assert report == 'ALL PASSED' and n == 50, report
+        report, _ = run_stress(bad, brute, gen, 50)
+        assert report.startswith('Counterexample'), report
+
+        s_good, _ = score_candidate(good, brute, gen, samples, 20)
+        s_bad, _ = score_candidate(bad, brute, gen, samples, 20)
+        assert s_good > s_bad
+        assert pick_best([(bad, s_bad), (good, s_good)]) == good
+        print('self-test OK:', s_good, s_bad)
