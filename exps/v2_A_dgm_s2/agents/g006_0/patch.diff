+    def _read_solution_from_disk(self):
+        """
+        Return the current contents of the solution file(s) in the repo (for the verification prompt).
+        """
+        try:
+            ls = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            files = [f for f in ls.stdout.decode(errors='replace').splitlines() if f.strip()]
+        except Exception:
+            files = []
+        chunks = []
+        for f in files:
+            if os.path.basename(f) == 'solution.py' and not _is_test_path(f):
+                full = os.path.join(self.git_tempdir, f)
+                try:
+                    with open(full, 'r', encoding='utf-8') as fh:
+                        chunks.append(f"--- {f} ---\n{fh.read()}")
+                except Exception as e:
+                    chunks.append(f"--- {f} --- (could not be read: {e})")
+        return "\n\n".join(chunks) if chunks else "(no solution.py found in the repository)"
+
+    def _run_stress_script(self, timeout=300):
+        """
+        Run /tmp/stress.py if it exists. Returns (exists, exit_code, raw_output). No output parsing.
+        """
+        script = '/tmp/stress.py'
+        if not os.path.isfile(script):
+            return False, None, "/tmp/stress.py does not exist yet."
+        try:
+            proc = subprocess.run(
+                ["python", script],
+                cwd=self.git_tempdir,
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                timeout=timeout, check=False,
+            )
+            return True, proc.returncode, proc.stdout.decode(errors='replace')
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            return True, 'timeout', out + f"\n[stress script killed after {timeout}s timeout]"
