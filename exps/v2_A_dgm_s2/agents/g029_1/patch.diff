+_FENCE_RE = re.compile(r'```(?:python|py)?[ \t]*\n(.*?)```', re.DOTALL)
+
+
+def extract_code_block(text):
+    """
+    Return the contents of the first fenced code block in `text`.
+    If there is no fenced block, return the stripped text unchanged.
+    """
+    match = _FENCE_RE.search(text or '')
+    if match:
+        return match.group(1)
+    return (text or '').strip()
+
+
+def main():
+    data = sys.stdin.read()
+    sys.stdout.write(extract_code_block(data))
+
+
+if __name__ == '__main__':
+    main()
