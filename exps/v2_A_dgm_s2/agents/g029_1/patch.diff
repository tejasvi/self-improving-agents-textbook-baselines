+_SAMPLE_IN_RE = re.compile(r'Sample Input\s*(\d+)\s*:?\s*\n(.*?)(?=Sample Output\s*\1\b|\Z)', re.DOTALL | re.IGNORECASE)
+_SAMPLE_OUT_RE = re.compile(r'Sample Output\s*(\d+)\s*:?\s*\n(.*?)(?=Sample Input\s*\d+|\Z|\n\s*(?:Explanation|Constraints|Note)\b)', re.DOTALL | re.IGNORECASE)
+
+def _extract_samples(problem_statement):
+    """
+    Extract (input, expected_output) pairs from 'Sample Input N' / 'Sample Output N' blocks.
+    Returns a list of tuples ordered by N. Missing outputs are skipped.
+    """
+    text = problem_statement or ''
+    inputs = {int(m.group(1)): m.group(2) for m in _SAMPLE_IN_RE.finditer(text)}
+    outputs = {int(m.group(1)): m.group(2) for m in _SAMPLE_OUT_RE.finditer(text)}
+    samples = []
+    for n in sorted(inputs):
+        if n in outputs:
+            samples.append((inputs[n].strip('\n') + '\n', outputs[n].strip()))
+    return samples
+
+def _find_solution_file(git_tempdir):
+    """
+    Return the path of the solution file: 'solution.py' if present, else None.
+    """
+    path = os.path.join(git_tempdir, 'solution.py')
+    return path if os.path.isfile(path) else None
+
+def _run_samples(git_tempdir, samples, timeout=10):
+    """
+    Run solution.py on each sample input. Returns a list of raw failure descriptions
+    (empty list means all samples passed). Output is compared whitespace-normalized.
+    """
+    failures = []
+    if not samples:
+        return failures
+    solution = _find_solution_file(git_tempdir)
+    if solution is None:
+        return ["solution.py was not found in the repository."]
+    for idx, (inp, expected) in enumerate(samples, 1):
+        try:
+            proc = subprocess.run(
+                ['python3', 'solution.py'], input=inp, cwd=git_tempdir,
+                timeout=timeout, capture_output=True, text=True,
+            )
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            failures.append(
+                f"Sample {idx}: TIMEOUT after {timeout}s (the algorithm is too slow for the constraints; a better algorithm is needed).\n"
+                f"Input:\n{inp}Partial stdout:\n{out}"
+            )
+            continue
+        actual = proc.stdout
+        if actual.split() != expected.split():
+            msg = (f"Sample {idx}: WRONG ANSWER (exit code {proc.returncode}).\n"
+                   f"Input:\n{inp}Expected:\n{expected}\nActual stdout:\n{actual}")
+            if proc.stderr.strip():
+                msg += f"\nstderr:\n{proc.stderr}"
+            failures.append(msg)
+        elif proc.returncode != 0:
+            failures.append(
+                f"Sample {idx}: exit code {proc.returncode}.\nstderr:\n{proc.stderr}"
+            )
+    return failures
+
