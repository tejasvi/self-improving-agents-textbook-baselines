+++ b/tools/benchmark.py
@@ -0,0 +1,67 @@
+import os
+import signal
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Run a shell command with a hard timeout and report its stdout, stderr, exit code and wall-clock time.
+Use this to time a solution on maximum-size inputs (e.g. `python3 /tmp/bench.py`) without risking a hung bash session.
+* If the command exceeds timeout_seconds it is killed and the result is marked as TIMEOUT.
+* Do not use it for long-running servers or interactive programs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python3 /tmp/bench.py'."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Hard timeout in seconds after which the command is killed. Defaults to 20 if not given."
+                }
+            },
+            "required": ["command", "timeout_seconds"]
+        }
+    }
+
+def tool_function(command, timeout_seconds):
+    try:
+        timeout = int(timeout_seconds) if timeout_seconds is not None else 20
+    except (TypeError, ValueError):
+        timeout = 20
+    start = time.time()
+    try:
+        # Run in its own session so the whole process group can be killed on timeout.
+        proc = subprocess.Popen(
+            command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, start_new_session=True
+        )
+    except Exception as e:
+        return f"Error running command: {e}"
+    try:
+        out, err = proc.communicate(timeout=timeout)
+        elapsed = time.time() - start
+        return (
+            f"exit_code: {proc.returncode}\n"
+            f"elapsed_seconds: {elapsed:.3f}\n"
+            f"stdout:\n{out}\n"
+            f"stderr:\n{err}"
+        )
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            pass
+        try:
+            out, err = proc.communicate(timeout=5)
+        except Exception:
+            out, err = '', ''
+        elapsed = time.time() - start
+        return (
+            f"TIMEOUT after {timeout}s (killed)\n"
+            f"elapsed_seconds: {elapsed:.3f}\n"
+            f"stdout:\n{out}\n"
+            f"stderr:\n{err}"
+        )
