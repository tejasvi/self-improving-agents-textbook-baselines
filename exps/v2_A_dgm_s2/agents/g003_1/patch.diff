+def _last_turn_is_empty_or_toolless(msg_history):
+    """
+    Return True if the last assistant text is empty/whitespace, or no tool was called
+    after the last user message.
+    """
+    if not str(_last_assistant_text(msg_history)).strip():
+        return True
+    # Find messages after the last user message
+    msgs = list(msg_history or [])
+    last_user_idx = -1
+    for i, msg in enumerate(msgs):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role == 'user':
+            last_user_idx = i
+    return not _has_tool_use(msgs[last_user_idx + 1:])
