+import difflib
+import os
+import re
+import subprocess
+
+SAMPLE_TIMEOUT = 10.0  # seconds per sample run
+DEFAULT_PROBLEM_FILE = "/tmp/problem_statement.txt"
+
+# Matches headers such as "Sample Input 1", "Sample Output 2:", "Sample Input #3"
+_HEADER_RE = re.compile(r'^[ \t]*Sample\s+(Input|Output)[ \t]*#?[ \t]*(\d+)[ \t]*:?[ \t]*$', re.IGNORECASE | re.MULTILINE)
+# Lines that usually begin a non-sample section and therefore end the last sample block
+_SECTION_END_RE = re.compile(r'^\s*(Note|Notes|Explanation|Explanations)\b\s*:?', re.IGNORECASE)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution against the sample test cases found in the problem statement file.\n
+* Parses 'Sample Input N' / 'Sample Output N' blocks from the problem statement file.\n
+* Runs `python3 solution_path` on each sample input with a timeout.\n
+* Compares outputs with whitespace-normalized comparison and reports PASS/FAIL per sample, including the actual output, the expected output and a unified diff.\n
+* The problem statement is saved at /tmp/problem_statement.txt; leave problem_file empty to use it.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_file": {
+                    "type": "string",
+                    "description": "Path to a text file containing the problem statement with the sample blocks. Optional; defaults to /tmp/problem_statement.txt."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed as `python3 solution_path`)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _parse_samples(text):
+    """
+    Return a list of (index, input_text, expected_output_text) tuples parsed from the statement.
+    """
+    headers = list(_HEADER_RE.finditer(text))
+    blocks = {}  # index -> {'Input': str, 'Output': str}
+    for i, match in enumerate(headers):
+        kind = match.group(1).capitalize()
+        idx = int(match.group(2))
+        start = match.end()
+        end = headers[i + 1].start() if i + 1 < len(headers) else len(text)
+        body = text[start:end]
+        # Trim trailing non-sample sections (e.g. "Note" paragraphs) from the block
+        kept = []
+        for line in body.splitlines():
+            if _SECTION_END_RE.match(line) and kept:
+                break
+            kept.append(line)
+        content = "\n".join(kept).strip("\n")
+        content = content.strip()
+        blocks.setdefault(idx, {})
+        if kind not in blocks[idx]:
+            blocks[idx][kind] = content
+    samples = []
+    for idx in sorted(blocks):
+        if 'Input' in blocks[idx] and 'Output' in blocks[idx]:
+            samples.append((idx, blocks[idx]['Input'] + "\n", blocks[idx]['Output']))
+    return samples
+
+
+def _normalize(s):
+    return " ".join(s.split())
+
+
+def tool_function(solution_path, problem_file=None):
+    path = problem_file or DEFAULT_PROBLEM_FILE
+    try:
+        with open(path, 'r', encoding='utf-8') as fh:
+            text = fh.read()
+    except Exception as e:
+        return f"Error: could not read problem file {path}: {e}"
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    samples = _parse_samples(text)
+    if not samples:
+        return f"Error: no 'Sample Input N' / 'Sample Output N' blocks found in {path}."
+
+    reports = []
+    passed = 0
+    for idx, sample_in, expected in samples:
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=sample_in.encode('utf-8'),
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                timeout=SAMPLE_TIMEOUT,
+            )
+            actual = proc.stdout.decode(errors='replace')
+            stderr = proc.stderr.decode(errors='replace').strip()
+            run_err = None
+            if proc.returncode != 0:
+                run_err = f"non-zero exit code {proc.returncode}"
+        except subprocess.TimeoutExpired:
+            actual = ""
+            stderr = ""
+            run_err = f"timed out after {SAMPLE_TIMEOUT} seconds"
+
+        ok = run_err is None and _normalize(actual) == _normalize(expected)
+        if ok:
+            passed += 1
+        status = "PASS" if ok else "FAIL"
+        block = [f"=== Sample {idx}: {status} ===",
+                 "Input:", sample_in.rstrip("\n"),
+                 "Actual output:", actual.rstrip("\n") or "(empty)",
+                 "Expected output:", expected.rstrip("\n") or "(empty)"]
+        if run_err:
+            block.append(f"Run error: {run_err}")
+        if stderr:
+            block.append("Stderr:")
+            block.append(stderr[-2000:])
+        if not ok:
+            diff = difflib.unified_diff(
+                expected.splitlines(), actual.splitlines(),
+                fromfile=f"expected_{idx}", tofile=f"actual_{idx}", lineterm="")
+            block.append("Diff (expected -> actual):")
+            block.append("\n".join(diff) or "(no line differences; only whitespace differs)")
+        reports.append("\n".join(block))
+
+    summary = f"Summary: {passed}/{len(samples)} samples passed."
+    return "\n\n".join(reports) + "\n\n" + summary
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("usage: run_samples.py SOLUTION_PATH [PROBLEM_FILE]")
+        sys.exit(1)
+    print(tool_function(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else None))
