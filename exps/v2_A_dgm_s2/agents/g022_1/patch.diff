+    def _find_target_file(self):
+        """
+        Return the relative path of the most likely target file: solution.py if present,
+        otherwise the first non-test tracked source file. Returns None if nothing is found.
+        """
+        if os.path.exists(os.path.join(self.git_tempdir, 'solution.py')):
+            return 'solution.py'
+        exts = ('.py', '.rs', '.go', '.js', '.cpp', '.java')
+        try:
+            out = subprocess.run(
+                ['git', 'ls-files'], cwd=self.git_tempdir,
+                capture_output=True, text=True, check=False
+            ).stdout
+        except Exception as e:
+            safe_log(f"git ls-files failed: {e}", logging.WARNING)
+            return None
+        for path in out.splitlines():
+            path = path.strip()
+            if not path.endswith(exts):
+                continue
+            if self._is_test_path(path):
+                continue
+            return path
+        return None
+
+    @staticmethod
+    def _last_assistant_is_empty(msg_history):
+        """
+        Return True if the last assistant message has no tool_use blocks and only empty text
+        (or if there is no assistant message at all).
+        """
+        last = None
+        for msg in msg_history or []:
+            if msg.get('role') == 'assistant':
+                last = msg
+        if last is None:
+            return True
+        content = last.get('content', [])
+        if isinstance(content, str):
+            return not content.strip()
+        for block in content or []:
+            btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+            if btype == 'tool_use':
+                return False
+            text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if text and str(text).strip():
+                return False
+        return True
+
+    def _fallback_write_solution(self, target_file, problem_statement):
+        """
+        Last resort: one tool-less LLM call asking only for the full Python solution code,
+        then write the extracted code block to the target file.
+        """
+        prompt = (
+            "Write the complete Python solution for the following competitive programming problem. "
+            "Reply with only one Python code block containing the full program or Solution class, "
+            "reading from standard input and writing to standard output if the problem requires it.\n\n"
+            f"<problem_description>\n{problem_statement}\n</problem_description>"
+        )
+        try:
+            client, client_model = create_client(self.code_model)
+            response = client.messages.create(
+                model=client_model,
+                max_tokens=4096,
+                messages=[{"role": "user", "content": [{"type": "text", "text": prompt}]}],
+            )
+            text = "".join(getattr(b, 'text', '') or '' for b in response.content)
+        except Exception as e:
+            safe_log(f"Fallback LLM call failed: {e}", logging.WARNING)
+            return False
+        m = re.search(r"```(?:python|py)?\s*\n(.*?)```", text, re.DOTALL)
+        if not m:
+            safe_log("Fallback: no code block found in response.", logging.WARNING)
+            return False
+        code = m.group(1)
+        with open(os.path.join(self.git_tempdir, target_file), 'w') as f:
+            f.write(code)
+        safe_log(f"Fallback wrote solution to {target_file}.")
+        return True
+
