+import sys
+
+
+def count_lattice_paths(n, m, rect):
+    """
+    Count monotone (right/up) lattice paths from (0, 0) to (n, m) that never
+    enter the forbidden rectangle rect = (x1, y1, x2, y2), inclusive of its
+    boundary cells. Returns the count modulo 10**9 + 7.
+    """
+    MOD = 10 ** 9 + 7
+    x1, y1, x2, y2 = rect
+    if x1 <= 0 <= x2 and y1 <= 0 <= y2:
+        return 0
+    if x1 <= n <= x2 and y1 <= m <= y2:
+        return 0
+    # dp over grid points; forbidden points get 0 ways.
+    dp = [[0] * (m + 1) for _ in range(n + 1)]
+    for i in range(n + 1):
+        for j in range(m + 1):
+            if x1 <= i <= x2 and y1 <= j <= y2:
+                dp[i][j] = 0
+                continue
+            if i == 0 and j == 0:
+                dp[i][j] = 1
+                continue
+            v = 0
+            if i > 0:
+                v += dp[i - 1][j]
+            if j > 0:
+                v += dp[i][j - 1]
+            dp[i][j] = v % MOD
+    return dp[n][m]
+
+
+def main():
+    data = sys.stdin.read().split()
+    n, m, x1, y1, x2, y2 = map(int, data[:6])
+    print(count_lattice_paths(n, m, (x1, y1, x2, y2)))
+
+
+if __name__ == "__main__":
+    main()
