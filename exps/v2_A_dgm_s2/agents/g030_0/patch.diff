+MOD = 10**9 + 7
+
+
+def count_paths(n, m, hole=None):
+    """Return number of monotone paths (0,0)->(n,m) avoiding the hole, mod MOD."""
+    if hole is None:
+        r1, c1, r2, c2 = 1, 1, 0, 0  # empty rectangle: nothing is blocked
+    else:
+        r1, c1, r2, c2 = hole
+    # Rolling 1-D DP over columns to keep memory O(m).
+    dp = [0] * (m + 1)
+    for r in range(n + 1):
+        for c in range(m + 1):
+            if r1 <= r <= r2 and c1 <= c <= c2:
+                dp[c] = 0
+            elif r == 0 and c == 0:
+                dp[c] = 1
+            else:
+                up = dp[c] if r > 0 else 0
+                left = dp[c - 1] if c > 0 else 0
+                dp[c] = (up + left) % MOD
+    return dp[m]
 
 
