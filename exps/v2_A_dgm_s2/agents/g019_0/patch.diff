+def _extract_code(text):
+    """
+    Extract Python code from a model reply. Prefers the first ```python fenced block;
+    falls back to any fenced block, then to the raw text if it looks like code. Returns '' if none.
+    """
+    text = text or ''
+    match = re.search(r'```(?:python|py)[ \t]*\r?\n(.*?)```', text, flags=re.DOTALL)
+    if match is None:
+        match = re.search(r'```[^\n]*\n(.*?)```', text, flags=re.DOTALL)
+    if match is not None:
+        return match.group(1) if match.group(1).strip() else ''
+    if text.strip() and any(k in text for k in ('def ', 'import ', 'input(', 'print(')):
+        return text.strip() + "\n"
+    return ''
+
+def _extract_sample_io(problem_statement):
+    """
+    Best-effort extraction of (sample_input, expected_output) pairs from a problem statement.
+    Looks for 'Input'/'Output' headings followed by code blocks or indented/plain lines.
+    Returns a list of (input_text, output_text or None).
+    """
+    text = problem_statement or ''
+    pairs = []
+    pattern = re.compile(
+        r'(?:sample|example)\s*input\s*\d*\s*:?\s*\n(?:```[^\n]*\n)?(.*?)(?:```|\n\s*\n)'
+        r'(?:.*?(?:sample|example)\s*output\s*\d*\s*:?\s*\n(?:```[^\n]*\n)?(.*?)(?:```|\n\s*\n|$))?',
+        flags=re.IGNORECASE | re.DOTALL,
+    )
+    for m in pattern.finditer(text):
+        inp = m.group(1).strip('\n') + "\n"
+        out = m.group(2).strip() if m.group(2) else None
+        if inp.strip():
+            pairs.append((inp, out))
+    return pairs[:3]
+
+def _run_sample(target_path, cwd, sample_io):
+    """
+    Run the solution file on each sample input with a timeout. Returns (ok, report_text).
+    ok is None when no samples were available to check.
+    """
+    if not sample_io:
+        return None, "No sample input could be extracted from the problem statement."
+    lines = []
+    all_ok = True
+    for idx, (inp, expected) in enumerate(sample_io):
+        try:
+            proc = subprocess.run(
+                ["python3", target_path], input=inp, capture_output=True, text=True,
+                timeout=10, cwd=cwd,
+            )
+        except subprocess.TimeoutExpired:
+            all_ok = False
+            lines.append(f"Sample {idx}: timed out after 10 seconds.")
+            continue
+        out = proc.stdout.strip()
+        if proc.returncode != 0:
+            all_ok = False
+            lines.append(f"Sample {idx}: exited with code {proc.returncode}.\nstderr:\n{proc.stderr.strip()}")
+        elif expected is not None and out.split() != expected.split():
+            all_ok = False
+            lines.append(f"Sample {idx}: wrong output.\nInput:\n{inp}\nExpected:\n{expected}\nGot:\n{out}")
+        else:
+            lines.append(f"Sample {idx}: ok.")
+    return all_ok, "\n".join(lines)
+
