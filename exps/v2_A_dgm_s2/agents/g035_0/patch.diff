+def _trim_expected(expected):
+    """
+    Keep only the first paragraph of an expected output (cut at the first blank line).
+    Return None if the result still looks unreliable (too long or contains prose markers).
+    """
+    trimmed = re.split(r'\n\s*\n', expected.strip())[0].strip()
+    if not trimmed:
+        return None
+    if len(trimmed.splitlines()) > 20:
+        return None
+    if any(marker in trimmed for marker in _PROSE_MARKERS):
+        return None
+    return trimmed
+
