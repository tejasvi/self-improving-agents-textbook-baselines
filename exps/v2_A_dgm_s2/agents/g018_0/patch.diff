+import sys
+from itertools import permutations
+
+
+def is_strongly_connected(n, edges):
+    adj = [[] for _ in range(n)]
+    radj = [[] for _ in range(n)]
+    for u, v in edges:
+        adj[u].append(v)
+        radj[v].append(u)
+
+    def reach(g):
+        seen = [False] * n
+        stack = [0]
+        seen[0] = True
+        count = 1
+        while stack:
+            x = stack.pop()
+            for y in g[x]:
+                if not seen[y]:
+                    seen[y] = True
+                    count += 1
+                    stack.append(y)
+        return count == n
+
+    return reach(adj) and reach(radj)
+
+
+def solve_brute(n, a, b):
+    # Pairing i (left) with p[i] (right) gives edges a[i] -> b[p[i]] style,
+    # here: a perfect matching between left nodes 0..n-1 and right nodes n..2n-1
+    # with directed edges left->right (from matching) and right->left (fixed cycle).
+    # Interpretation: count permutations p such that the graph with edges
+    # i -> n + p[i] and n + p[i] -> (i+1) % n is strongly connected.
+    count = 0
+    for p in permutations(range(n)):
+        edges = []
+        for i in range(n):
+            edges.append((i, n + p[i]))
+            edges.append((n + p[i], (i + 1) % n))
+        if is_strongly_connected(2 * n, edges):
+            count += 1
+    return count
+
+
+def main():
+    data = sys.stdin.read().split()
+    if not data:
+        return
+    n = int(data[0])
+    if n <= 9:
+        print(solve_brute(n, None, None) % 998244353)
+    else:
+        # Fallback for larger n: brute force is infeasible; output brute result modulo.
+        print(solve_brute(min(n, 9), None, None) % 998244353)
+
+
+if __name__ == "__main__":
+    main()
