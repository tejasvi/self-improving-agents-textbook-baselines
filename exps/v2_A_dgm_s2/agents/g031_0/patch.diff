+_LATEX_REPLACEMENTS = [
+    (r'\\leq', '<='),
+    (r'\\le', '<='),
+    (r'\\geq', '>='),
+    (r'\\ge', '>='),
+    (r'\\neq', '!='),
+    (r'\\ldots', '...'),
+    (r'\\dots', '...'),
+    (r'\\cdots', '...'),
+    (r'\\times', '*'),
+    (r'\\cdot', '*'),
+]
+
+
+def sanitize_statement(text):
+    """
+    Convert common LaTeX commands to plain text and collapse whitespace.
+    """
+    if not text:
+        return ""
+    result = text
+    for pattern, replacement in _LATEX_REPLACEMENTS:
+        result = re.sub(pattern, replacement, result)
+    # Remove inline math delimiters such as $...$ while keeping content.
+    result = result.replace('$', '')
+    # Collapse runs of spaces/tabs and blank lines.
+    result = re.sub(r'[ \t]+', ' ', result)
+    result = re.sub(r'\n\s*\n+', '\n', result)
+    return result.strip()
+
+
+_SAMPLE_PATTERN = re.compile(
+    r'Sample Input\s*(\d+)\s*:?\s*\n(.*?)\n\s*Sample Output\s*\1\s*:?\s*\n(.*?)(?=\n\s*Sample Input\s*\d+|\Z)',
+    flags=re.DOTALL | re.IGNORECASE,
+)
+
+
+def extract_samples(problem_statement):
+    """
+    Parse every 'Sample Input k' / 'Sample Output k' pair.
+    Returns a list of (input_text, expected_text) tuples in order of appearance.
+    """
+    if not problem_statement:
+        return []
+    samples = []
+    for match in _SAMPLE_PATTERN.finditer(problem_statement):
+        inp = match.group(2).strip("\n").rstrip() + "\n"
+        exp = match.group(3).strip()
+        samples.append((inp, exp))
+    return samples
+
+
+def run_samples(solution_path, samples, timeout=10):
+    """
+    Run `python solution_path` on each sample input and compare whitespace-normalized
+    stdout with the expected output. Returns (pass_count, report_string).
+    """
+    if not samples:
+        return 0, "No samples found in the problem statement."
+    lines = []
+    passed = 0
+    for idx, (inp, expected) in enumerate(samples, 1):
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=inp,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            if proc.returncode != 0:
+                actual = None
+                actual_desc = f"(exit code {proc.returncode}) stderr: {proc.stderr.strip()[-500:]}"
+            else:
+                actual = proc.stdout.strip()
+                actual_desc = actual
+        except subprocess.TimeoutExpired:
+            actual = None
+            actual_desc = f"TIMEOUT after {timeout}s"
+        ok = actual is not None and actual.split() == expected.split()
+        if ok:
+            passed += 1
+        status = "PASS" if ok else "FAIL"
+        lines.append(
+            f"Sample {idx}: {status}\n  input:\n{inp}  expected: {expected!r}\n  actual: {actual_desc!r}"
+        )
+    lines.insert(0, f"{passed}/{len(samples)} samples passed.")
+    return passed, "\n".join(lines)
+
+
 def main():
     data = sys.stdin.read()
