+    def _chat_robust(self, prompt):
+        """
+        Call the LLM with a fixed list of attempts and return the first non-empty message history
+        (or the last one if all are empty). Attempts: (primary, prompt), (primary, minimal prompt),
+        (alternate, minimal prompt). Switches the primary model for the rest of the run after the
+        primary model returns empty twice.
+        """
+        alt_model = OPENAI_MODEL if self.code_model == CLAUDE_MODEL else CLAUDE_MODEL
+        primary = self.active_model
+        alternate = alt_model if primary == self.code_model else self.code_model
+        minimal_prompt = (
+            f"Task:\n{self.problem_statement}\n\n"
+            "Write the full solution into solution.py using the editor tool."
+        )
+        attempts = [(primary, prompt), (primary, minimal_prompt), (alternate, minimal_prompt)]
+        last_history = []
+        for i, (model, text) in enumerate(attempts):
+            if i > 0:
+                time.sleep(1)
+            history = chat_with_agent(text, model=model, msg_history=[], logging=safe_log)
+            empty = _is_empty_response(history)
+            self.last_model_used = model
+            safe_log(f"_chat_robust attempt {i}: model={model}, empty_response={empty}")
+            if model == primary and i < 2 and empty:
+                self.primary_empty_count += 1
+                if self.primary_empty_count >= 2 and self.active_model == self.code_model:
+                    self.active_model = alternate
+                    safe_log(f"Primary model {primary} returned empty responses twice; switching to {alternate} for the rest of the run.")
+            elif model == primary and not empty:
+                self.primary_empty_count = 0
+            last_history = history
+            if not empty:
+                return history
+            safe_log(f"Empty response from model={model}; last assistant message repr: {_last_assistant_text(history)!r}")
+        return last_history
+
