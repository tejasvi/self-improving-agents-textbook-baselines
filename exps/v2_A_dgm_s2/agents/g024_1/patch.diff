+    Compact summary for a fresh chat: current solution file plus the last failing case.
+    """
+    path = os.path.join(git_tempdir, solution_rel)
+    try:
+        with open(path, 'r', encoding='utf-8') as fh:
+            code = fh.read()
+    except Exception:
+        code = '(solution file could not be read)'
+    return (f"Current {solution_rel}:\n```python\n{code[:max_chars]}\n```\n\n"
+            f"Last stress-test result:\n{failure_report}\n")
