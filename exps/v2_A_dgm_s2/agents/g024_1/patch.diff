+import os
+import subprocess
+import sys
+
+MAX_REPORT_CHARS = 400
+MAX_CASES_LIMIT = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference using a random input generator.\n
+* The generator is run as `python <generator_path> <seed>` and must print one test input to stdout.\n
+* The solution and the brute force are run as `python <path>` with the input on stdin; they must print the answer to stdout.\n
+* Outputs are compared after stripping trailing whitespace on each line.\n
+* Returns 'ALL PASSED' if every case matches, otherwise the smallest failing input together with the expected (brute) and actual (solution) outputs.\n
+* Use this after writing brute.py and gen.py in a scratch directory such as /tmp/stress/.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python program (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the trusted brute-force Python program (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator; invoked as `python generator_path seed` and prints one input to stdout."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default 300)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-program timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_REPORT_CHARS):
+    text = text if text is not None else ''
+    if len(text) <= limit:
+        return text
+    return text[:limit] + '...[truncated]'
+
+
+def _normalize(text):
+    return '\n'.join(line.rstrip() for line in (text or '').strip().splitlines())
+
+
+def _run_py(path, args=(), stdin_text='', timeout=10.0):
+    """Run a python file; return (ok, stdout, error_text)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, path, *args],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            cwd=os.path.dirname(os.path.abspath(path)) or None,
+        )
+    except subprocess.TimeoutExpired:
+        return False, '', f'timed out after {timeout}s'
+    except Exception as e:
+        return False, '', f'failed to run: {e}'
+    if proc.returncode != 0:
+        return False, proc.stdout, f'exit code {proc.returncode}: {proc.stderr.strip()}'
+    return True, proc.stdout, ''
+
+
+def tool_function(solution_path, brute_path, generator_path, num_cases=300, timeout=10):
+    try:
+        num_cases = int(num_cases) if num_cases is not None else 300
+    except (TypeError, ValueError):
+        num_cases = 300
+    num_cases = max(1, min(num_cases, MAX_CASES_LIMIT))
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+    timeout = max(0.1, min(timeout, 120.0))
+
+    for label, p in (('solution_path', solution_path), ('brute_path', brute_path),
+                     ('generator_path', generator_path)):
+        if not p or not os.path.isfile(p):
+            return f"Error: {label} does not exist: {p}"
+
+    failures = []  # (input_len, seed, input, expected, actual, note)
+    for seed in range(num_cases):
+        ok, test_input, err = _run_py(generator_path, args=[str(seed)], timeout=timeout)
+        if not ok:
+            return f"Error: generator failed at seed {seed}: {_truncate(err)}"
+        ok, expected, err = _run_py(brute_path, stdin_text=test_input, timeout=timeout)
+        if not ok:
+            failures.append((len(test_input), seed, test_input, '', '', f"brute failed: {err}"))
+            continue
+        ok, actual, err = _run_py(solution_path, stdin_text=test_input, timeout=timeout)
+        if not ok:
+            failures.append((len(test_input), seed, test_input, expected, actual, f"solution failed: {err}"))
+            continue
+        if _normalize(expected) != _normalize(actual):
+            failures.append((len(test_input), seed, test_input, expected, actual, 'output mismatch'))
+
+    if not failures:
+        return f"ALL PASSED ({num_cases} cases)"
+
+    # Smallest failing input (by length, then by seed) is easiest to debug.
+    failures.sort(key=lambda f: (f[0], f[1]))
+    _, seed, test_input, expected, actual, note = failures[0]
+    return (
+        f"FAILED {len(failures)}/{num_cases} cases ({note}). Smallest failing case (seed {seed}):\n"
+        f"input: {_truncate(test_input.strip())}\n"
+        f"expected (brute): {_truncate(_normalize(expected))}\n"
+        f"actual (solution): {_truncate(_normalize(actual))}"
+    )
