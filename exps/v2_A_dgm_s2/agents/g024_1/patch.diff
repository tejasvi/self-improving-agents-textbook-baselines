+    return 'solution.py'
+
+def _run_stress_gate(solution_path, num_cases=200, timeout=5):
+    """
+    Run the stress comparison in a subprocess with a time limit.
+    Returns None if the scratch harness (/tmp/stress/brute.py and gen.py) is absent,
+    otherwise (passed: bool, report: str).
+    """
+    brute = os.path.join(STRESS_DIR, 'brute.py')
+    gen = os.path.join(STRESS_DIR, 'gen.py')
+    if not (os.path.isfile(brute) and os.path.isfile(gen)):
+        return None
+    code = (
+        "import sys; sys.path.insert(0, %r); "
+        "from tools.stress_test import tool_function; "
+        "print(tool_function(%r, %r, %r, num_cases=%d, timeout=%d))"
+    ) % (os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+         solution_path, brute, gen, num_cases, timeout)
+    try:
+        proc = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True,
+                              timeout=STRESS_GATE_TIMEOUT)
+        out = (proc.stdout or '').strip() or (proc.stderr or '').strip()
+    except subprocess.TimeoutExpired:
+        return False, f"stress test exceeded {STRESS_GATE_TIMEOUT}s time limit"
+    passed = out.startswith('ALL PASSED')
+    return passed, out[-1500:]
+
+def _compact_summary(git_tempdir, solution_rel, failure_report, max_chars=6000):
