diff --git a/tests/test_coding_agent_retry.py b/tests/test_coding_agent_retry.py
index a273054..127ed0a 100644
--- a/tests/test_coding_agent_retry.py
+++ b/tests/test_coding_agent_retry.py
@@ -144,3 +144,93 @@ def test_analysis_prompt_has_no_max_size_timing_step(fake_env):
     make, calls = fake_env
     make().forward()
     assert "Max-size timing check" not in calls["chat"][0]["msg"]
+
+
+# ---- retry of a phase once from the last good state ----
+
+@pytest.fixture
+def flaky_env(monkeypatch, tmp_path):
+    """Fake chat that raises on the call indices listed in `fail_on` (1-based)."""
+    calls = {"chat": [], "reset": [], "diff": 0, "fail_on": set()}
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls["chat"].append({"msg": msg, "history": list(msg_history or [])})
+        n = len(calls["chat"])
+        if n in calls["fail_on"]:
+            raise RuntimeError(f"boom-{n}")
+        return list(msg_history or []) + [
+            {"role": "user", "content": [{"type": "text", "text": msg}]},
+            {"role": "assistant", "content": [{"type": "text", "text": f"reply-{n}"}]},
+        ]
+
+    def fake_reset(git_dname, commit):
+        calls["reset"].append((git_dname, commit))
+
+    def fake_diff(git_dname, commit):
+        calls["diff"] += 1
+        return f"diff-{calls['diff']}"
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    monkeypatch.setattr(coding_agent, "reset_to_commit", fake_reset)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", fake_diff)
+
+    def make():
+        return AgenticSystem(
+            problem_statement="Sum two numbers.",
+            git_tempdir=str(tmp_path / "repo"),
+            base_commit="abc123",
+            chat_history_file=str(tmp_path / "chat.md"),
+        )
+    return make, calls
+
+
+def test_analysis_failure_retried_once_from_empty_history(flaky_env):
+    make, calls = flaky_env
+    calls["fail_on"] = {1}
+    records = make().forward()
+    assert len(calls["chat"]) == 3          # failed analysis, retried analysis, implementation
+    assert calls["chat"][0]["history"] == calls["chat"][1]["history"] == []
+    assert "Previous attempts" not in calls["chat"][1]["msg"]
+    assert len(records) == 1 and "reply-3" in records[0]["summary"]
+
+
+def test_implementation_failure_retried_from_analysis_history(flaky_env):
+    make, calls = flaky_env
+    calls["fail_on"] = {2}
+    records = make().forward()
+    assert len(calls["chat"]) == 3
+    analysis_hist = calls["chat"][2]["history"]  # history passed to the retried impl call
+    assert len(analysis_hist) == 2                # exactly the analysis turn (user + assistant)
+    assert analysis_hist[-1]["content"][0]["text"] == "reply-1"
+    assert calls["chat"][1]["history"] == calls["chat"][2]["history"]
+    assert "reply-3" in records[0]["summary"]
+
+
+def test_phase_failing_twice_propagates(flaky_env):
+    make, calls = flaky_env
+    calls["fail_on"] = {1, 2}
+    with pytest.raises(RuntimeError, match="boom-2"):
+        make().forward()
+    assert len(calls["chat"]) == 2  # no third attempt at the same phase
+
+
+def test_retry_does_not_repeat_completed_implementation(flaky_env):
+    make, calls = flaky_env
+    calls["fail_on"] = {2}  # attempt 1 implementation fails once
+    make().forward(max_attempts=2)
+    # attempt 1: analysis(1), impl fails(2), impl retry(3); attempt 2: analysis(4), impl(5)
+    assert len(calls["chat"]) == 5
+    assert calls["reset"] == [(str(make().git_tempdir), "abc123")]
+
+
+def test_run_with_one_retry_helper_logs_and_returns():
+    attempts = []
+
+    def call():
+        attempts.append(1)
+        if len(attempts) == 1:
+            raise ValueError("transient")
+        return "ok"
+
+    assert coding_agent.run_with_one_retry(call, "analysis") == "ok"
+    assert len(attempts) == 2
