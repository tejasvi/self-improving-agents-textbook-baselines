+def run_with_one_retry(call, phase_name):
+    """
+    Run `call()` once; if it raises, log the exception and run it once more.
+    The second failure propagates to the caller. `call` must be re-runnable from the
+    same inputs (the caller's last good state), so the retry does not repeat completed work.
+    """
+    for try_idx in range(2):
+        try:
+            return call()
+        except Exception as e:
+            if try_idx == 1:
+                raise
+            safe_log(f"=== Exception during {phase_name}: {e!r}. Retrying {phase_name} once from the last good state ===")
+
