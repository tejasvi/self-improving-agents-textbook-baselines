+# Errors that are worth retrying (network issues, rate limits, server-side failures).
+# Anything else (e.g. 400 bad request, auth errors) is not retried.
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+
+def is_transient_llm_error(e: Exception) -> bool:
+    """Return True if the exception from an LLM API call is transient and should be retried."""
+    transient_types = (
+        openai.RateLimitError,
+        openai.APITimeoutError,
+        openai.APIConnectionError,
+        openai.InternalServerError,
+        anthropic.RateLimitError,
+        anthropic.APITimeoutError,
+        anthropic.APIConnectionError,
+        anthropic.InternalServerError,
+    )
+    if isinstance(e, transient_types):
+        return True
+    if isinstance(e, (openai.APIStatusError, anthropic.APIStatusError)):
+        return getattr(e, "status_code", None) in TRANSIENT_STATUS_CODES
+    return False
+
+def llm_retry(max_tries=6, max_time=300):
+    """Decorator: retry transient LLM API failures with exponential backoff and jitter.
+    Non-transient errors are raised immediately."""
+    def _log_backoff(details):
+        print(f"LLM call failed (attempt {details['tries']}), retrying in {details['wait']:.1f}s: {details['exception']}")
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        giveup=lambda e: not is_transient_llm_error(e),
+        max_tries=max_tries,
+        max_time=max_time,
+        jitter=backoff.full_jitter,
+        on_backoff=_log_backoff,
+    )
+
