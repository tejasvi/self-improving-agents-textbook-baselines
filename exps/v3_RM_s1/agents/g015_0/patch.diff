+    @staticmethod
+    def _truncate_middle(text, max_chars):
+        """Keep the head and tail of `text` so it fits within `max_chars`."""
+        if len(text) <= max_chars:
+            return text
+        half = max_chars // 2
+        return text[:half] + "\n...<truncated>...\n" + text[-half:]
+
+    def _build_retry_context(self):
+        """Describe previous failed attempts (their diffs and test outputs) for the next attempt."""
+        if not self.failed_attempts:
+            return ""
+        sections = [
+            "# Previous failed attempts",
+            "The following earlier attempts at this same problem did NOT pass the examples. "
+            "The repository has been reset to its original state, so their edits are not present. "
+            "Use their diffs and verification output to avoid repeating the same mistakes, "
+            "and try a different approach if the earlier one was fundamentally wrong.",
+        ]
+        for i, attempt in enumerate(self.failed_attempts, 1):
+            sections.append(
+                f"## Failed attempt {i}\n"
+                f"### Edits made in this attempt (diff versus base commit)\n"
+                f"```diff\n{self._truncate_middle(attempt['diff'], 6000)}\n```\n"
+                f"### Verification output\n"
+                f"{self._truncate_middle(attempt['feedback'], 3000)}"
+            )
+        return "\n\n".join(sections)
