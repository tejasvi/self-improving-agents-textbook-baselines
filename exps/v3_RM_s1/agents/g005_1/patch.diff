+def test_implementation_prompt_has_final_review_step(fake_env):
+    make, calls = fake_env
+    make().forward()
+    msg = calls["chat"][1]["msg"]
+    assert "Final review" in msg
+    assert "re-read the original <problem_description>" in msg
+    assert "edge cases" in msg
