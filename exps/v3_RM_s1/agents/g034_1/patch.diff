index 8e238b9..b992ca4 100644
--- a/llm_withtools.py
+++ b/llm_withtools.py
@@ -22,6 +22,19 @@ def process_tool_call(tools_dict, tool_name, tool_input):
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def log_response_metadata(response, logging=print):
+    """
+    Log the metadata (stop reason and usage) of a model response to the chat history.
+    """
+    stop_reason = getattr(response, 'stop_reason', None)
+    if stop_reason is None:
+        # OpenAI responses expose a status instead of a stop reason
+        stop_reason = getattr(response, 'status', None)
+    usage = getattr(response, 'usage', None)
+    if hasattr(usage, 'model_dump'):
+        usage = usage.model_dump()
+    logging(f"Response metadata - stop reason: {stop_reason}, usage: {usage}")
+
 @backoff.on_exception(
     backoff.expo,
     (openai.RateLimitError, openai.APITimeoutError, anthropic.RateLimitError, anthropic.APIStatusError),
@@ -52,6 +65,7 @@ def get_response_withtools(
             response = response
         else:
             raise ValueError(f"Unsupported model: {model}")
+        log_response_metadata(response, logging=logging)
         return response
     except Exception as e:
         logging(f"Error in get_response_withtools: {str(e)}")
