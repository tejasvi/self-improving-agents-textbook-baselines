+# Errors from model API calls that are worth retrying (rate limits, timeouts,
+# connection drops, 5xx server errors). Other errors (e.g. 400 bad request,
+# auth failures) are not retried.
+TRANSIENT_API_ERRORS = (
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+)
+MAX_API_TRIES = 6
+MAX_API_BACKOFF_SECONDS = 60
+
+def is_transient_api_error(e):
+    """Return True if the API error is transient and should be retried."""
+    if isinstance(e, TRANSIENT_API_ERRORS):
+        return True
+    status = getattr(e, "status_code", None)
+    return status in (408, 409, 429) or (isinstance(status, int) and status >= 500)
+
+def giveup_on_permanent_api_error(e):
+    """backoff giveup predicate: stop retrying on non-transient errors."""
+    return not is_transient_api_error(e)
+
+def api_retry(func):
+    """Decorator: retry model API calls with exponential backoff on transient failures."""
+    return backoff.on_exception(
+        backoff.expo,
+        (openai.APIError, anthropic.APIError),
+        giveup=giveup_on_permanent_api_error,
+        max_tries=MAX_API_TRIES,
+        max_value=MAX_API_BACKOFF_SECONDS,
+    )(func)
+
