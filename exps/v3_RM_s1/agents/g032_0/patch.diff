index 0000000..8dbe3a0
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,131 @@
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10.0  # seconds per test case
+MAX_OUTPUT_CHARS = 2000  # max characters of actual/expected output shown per test
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python program on given test inputs and compare its standard output with the expected outputs.\n
+* The program at `solution_path` is executed with `python` once per test case; the test case `input` is fed to its standard input.\n
+* The actual stdout is compared with `expected_output`. Trailing whitespace on each line and at the end of the output is ignored.\n
+* For each test case the tool reports PASS or FAIL, and for failures it shows the actual output, the expected output, and any stderr or timeout message.\n
+* A final summary gives the number of passed and failed test cases.\n
+* To test a method of a `Solution` class, first write a small Python script that imports or defines the class, reads the input, calls the method, and prints the result, then pass that script as `solution_path`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python program to test (a file that reads standard input and writes standard output)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run against the program.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program should print to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Maximum number of seconds allowed for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def normalize_output(text: str) -> str:
+    """Strip trailing whitespace on each line and at the end of the whole output."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    return "\n".join(lines).rstrip()
+
+
+def truncate(text: str, max_chars: int = MAX_OUTPUT_CHARS) -> str:
+    if len(text) <= max_chars:
+        return text
+    return text[:max_chars] + "\n<output clipped>"
+
+
+def run_single_test(solution_path: str, test_input: str, timeout: float):
+    """
+    Run the program once with test_input on stdin.
+    Returns (stdout, stderr, error_message); error_message is None when the program finished.
+    """
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        stdout = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        return stdout, "", f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return "", "", f"Failed to run program: {e}"
+    error = None
+    if proc.returncode != 0:
+        error = f"Program exited with return code {proc.returncode}"
+    return proc.stdout, proc.stderr, error
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = None) -> str:
+    try:
+        if timeout is None:
+            timeout = DEFAULT_TIMEOUT
+        if not test_cases:
+            return "Error: No test cases were provided."
+
+        passed = 0
+        failed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            test_input = case.get("input", "")
+            expected = case.get("expected_output", "")
+            stdout, stderr, error = run_single_test(solution_path, test_input, timeout)
+
+            ok = error is None and normalize_output(stdout) == normalize_output(expected)
+            if ok:
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+                continue
+
+            failed += 1
+            lines = [f"Test {idx}: FAIL"]
+            if error:
+                lines.append(f"Error: {error}")
+            lines.append(f"Input:\n{truncate(test_input)}")
+            lines.append(f"Expected output:\n{truncate(normalize_output(expected))}")
+            lines.append(f"Actual output:\n{truncate(normalize_output(stdout))}")
+            if stderr.strip():
+                lines.append(f"Stderr:\n{truncate(stderr.strip())}")
+            reports.append("\n".join(lines))
+
+        summary = f"Summary: {passed} passed, {failed} failed, {len(test_cases)} total"
+        return "\n\n".join(reports) + "\n\n" + summary
+    except Exception as e:
+        return f"Error running tests: {e}"
+
+
+if __name__ == "__main__":
+    import json
+    if len(sys.argv) != 3:
+        print("Usage: python run_tests.py <solution_path> '<test_cases_json>'")
+    else:
+        print(tool_function(sys.argv[1], json.loads(sys.argv[2])))
