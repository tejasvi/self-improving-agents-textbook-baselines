index 8e238b9..f6cf12b 100644
--- a/llm_withtools.py
+++ b/llm_withtools.py
@@ -22,6 +22,35 @@ def process_tool_call(tools_dict, tool_name, tool_input):
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def format_response_metadata(response, model=''):
+    """
+    Formats the metadata (stop reason and usage) of a model response for logging.
+    """
+    try:
+        if 'claude' in model:
+            stop_reason = getattr(response, 'stop_reason', None)
+            usage = getattr(response, 'usage', None)
+            usage_str = {
+                'input_tokens': getattr(usage, 'input_tokens', None),
+                'output_tokens': getattr(usage, 'output_tokens', None),
+            } if usage is not None else None
+        elif model.startswith('o3-'):
+            stop_reason = getattr(response, 'status', None)
+            incomplete = getattr(response, 'incomplete_details', None)
+            if incomplete is not None:
+                stop_reason = f"{stop_reason} ({getattr(incomplete, 'reason', incomplete)})"
+            usage = getattr(response, 'usage', None)
+            usage_str = {
+                'input_tokens': getattr(usage, 'input_tokens', None),
+                'output_tokens': getattr(usage, 'output_tokens', None),
+                'total_tokens': getattr(usage, 'total_tokens', None),
+            } if usage is not None else None
+        else:
+            return ""
+        return f"Response metadata - Stop reason: {stop_reason}, Usage: {usage_str}"
+    except Exception as e:
+        return f"Response metadata unavailable: {str(e)}"
+
 @backoff.on_exception(
     backoff.expo,
     (openai.RateLimitError, openai.APITimeoutError, anthropic.RateLimitError, anthropic.APIStatusError),
@@ -52,6 +81,9 @@ def get_response_withtools(
             response = response
         else:
             raise ValueError(f"Unsupported model: {model}")
+        metadata = format_response_metadata(response, model)
+        if logging is not None and metadata:
+            logging(metadata)
         return response
     except Exception as e:
         logging(f"Error in get_response_withtools: {str(e)}")
