@@ -52,6 +97,7 @@ def get_response_withtools(
             response = response
         else:
             raise ValueError(f"Unsupported model: {model}")
+        log_response_metadata(response, model=model, logging=logging)
         return response
     except Exception as e:
         logging(f"Error in get_response_withtools: {str(e)}")
