+import os
+import tempfile
+from unittest import mock
+
+import pytest
+
+import coding_agent
+from tools import load_all_tools
+
+
+@pytest.fixture
+def agent():
+    with tempfile.TemporaryDirectory() as d:
+        log = os.path.join(d, "chat.md")
+        yield coding_agent.AgenticSystem(
+            problem_statement="Sum two numbers.",
+            git_tempdir=d,
+            base_commit="HEAD",
+            chat_history_file=log,
+        )
+
+
+def test_forward_runs_analysis_then_implementation(agent):
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=None):
+        calls.append({"msg": msg, "msg_history": msg_history})
+        return (msg_history or []) + [{"role": "assistant", "content": f"reply {len(calls)}"}]
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=fake_chat):
+        agent.forward()
+
+    assert len(calls) == 2
+    # Phase 1: analysis, no prior history, must forbid edits
+    assert calls[0]["msg_history"] == []
+    assert "ANALYSIS phase" in calls[0]["msg"]
+    assert "Do NOT edit" in calls[0]["msg"]
+    # Phase 2: implementation, receives the analysis history
+    assert "IMPLEMENTATION phase" in calls[1]["msg"]
+    assert calls[1]["msg_history"] == [{"role": "assistant", "content": "reply 1"}]
+
+
+def _check_schema(schema, path="input_schema"):
+    assert schema["type"] == "object", path
+    assert isinstance(schema["properties"], dict), path
+    assert isinstance(schema["required"], list), path
+    assert set(schema["required"]) <= set(schema["properties"]), path
+    for name, prop in schema["properties"].items():
+        assert "type" in prop, f"{path}.{name} missing type"
+        assert "description" in prop, f"{path}.{name} missing description"
+        # 'required' must not leak into a property
+        assert "required" not in prop, f"{path}.{name} has nested required"
+
+
+@pytest.mark.parametrize("tool", load_all_tools(), ids=lambda t: t["name"])
+def test_tool_schema_shape(tool):
+    info = tool["info"]
+    assert {"name", "description", "input_schema"} <= set(info)
+    _check_schema(info["input_schema"])
+    assert callable(tool["function"])
