+def _is_tool_result_message(msg):
+    """Returns True if the message (Claude dict or OpenAI item) carries a tool result."""
+    if not isinstance(msg, dict):
+        return False
+    if msg.get('type') == 'function_call_output':
+        return True
+    content = msg.get('content')
+    if isinstance(content, list):
+        return any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content)
+    return False
+
+def compact_old_tool_results(messages, keep_recent=KEEP_RECENT_TOOL_RESULTS, old_max_chars=OLD_TOOL_RESULT_CHARS):
+    """
+    Returns a new message list in which tool results, except the `keep_recent` most recent ones,
+    are truncated to `old_max_chars`. The input list and its messages are not mutated, and
+    tool_use / tool_result pairing is preserved.
+    """
+    result_positions = [i for i, m in enumerate(messages) if _is_tool_result_message(m)]
+    old_positions = set(result_positions[:-keep_recent] if keep_recent > 0 else result_positions)
+
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i not in old_positions:
+            compacted.append(msg)
+            continue
+        if msg.get('type') == 'function_call_output':
+            new_msg = dict(msg)
+            new_msg['output'] = truncate_middle(msg.get('output'), old_max_chars)
+        else:
+            new_blocks = []
+            for b in msg['content']:
+                if isinstance(b, dict) and b.get('type') == 'tool_result':
+                    b = dict(b)
+                    b['content'] = truncate_middle(b.get('content'), old_max_chars)
+                new_blocks.append(b)
+            new_msg = dict(msg)
+            new_msg['content'] = new_blocks
+        compacted.append(new_msg)
+    return compacted
