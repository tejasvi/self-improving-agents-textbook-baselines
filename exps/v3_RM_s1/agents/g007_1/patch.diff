+def truncate_middle(text, max_chars):
+    """
+    Truncate text to at most roughly max_chars characters by keeping the head and
+    the tail and replacing the middle with a marker. Returns text unchanged if short enough.
+    """
+    text = "" if text is None else str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    half = max(max_chars // 2, 0)
+    omitted = len(text) - 2 * half
+    head = text[:half]
+    tail = text[len(text) - half:] if half > 0 else ""
+    return f"{head}\n<... {omitted} characters truncated ...>\n{tail}"
