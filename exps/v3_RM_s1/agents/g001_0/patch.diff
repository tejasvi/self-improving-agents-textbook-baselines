         result = tool_function(command)
         assert "Line 1" in result
         assert "Line 100" in result
+
+
+from tools.bash import filter_error
+
+class TestFilterError:
+    def test_ioctl_warning_only_does_not_raise(self):
+        """Stderr with only the ioctl warning at the end must not index out of range."""
+        err = "bash: cannot set terminal process group (1): Inappropriate ioctl for device\nbash: no job control in this shell"
+        assert isinstance(filter_error(err), str)
+
+    def test_empty_error(self):
+        assert filter_error("") == ""
+
+    def test_plain_error_passthrough(self):
+        assert filter_error("some failure") == "some failure"
