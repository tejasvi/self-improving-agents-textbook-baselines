+"""Retry with exponential backoff for transient model API failures.
+
+This module is a self-contained helper. It does not import the repository's
+LLM modules and does not modify them. Callers wrap an API call in
+``call_with_retries``; the call is retried only when the error is transient.
+
+Classification is done by attribute and class name, so the module does not
+require the ``anthropic`` or ``openai`` packages to be importable.
+"""
+
+import random
+import time
+
+# HTTP status codes treated as transient (rate limit, overload, server error).
+RETRYABLE_STATUS_CODES = frozenset({408, 409, 429, 500, 502, 503, 504, 529})
+
+# Exception class names treated as transient, from the anthropic and openai SDKs.
+RETRYABLE_ERROR_NAMES = frozenset({
+    "RateLimitError",
+    "APITimeoutError",
+    "APIConnectionError",
+    "InternalServerError",
+    "OverloadedError",
+})
+
+
+def is_retryable_error(exc):
+    """Return True if ``exc`` looks like a transient API failure."""
+    if isinstance(exc, (TimeoutError, ConnectionError)):
+        return True
+    for klass in type(exc).__mro__:
+        if klass.__name__ in RETRYABLE_ERROR_NAMES:
+            return True
+    status = getattr(exc, "status_code", None)
+    if status is None:
+        response = getattr(exc, "response", None)
+        status = getattr(response, "status_code", None)
+    return isinstance(status, int) and status in RETRYABLE_STATUS_CODES
+
+
+def _retry_after_seconds(exc):
+    """Return the server-requested delay in seconds, or None if absent or invalid."""
+    response = getattr(exc, "response", None)
+    headers = getattr(response, "headers", None)
+    if not headers:
+        return None
+    raw = headers.get("retry-after") or headers.get("Retry-After")
+    if raw is None:
+        return None
+    try:
+        value = float(raw)
+    except (TypeError, ValueError):
+        return None
+    return value if value >= 0 else None
+
+
+def backoff_delay(attempt, base_delay=1.0, max_delay=60.0, jitter=True, rng=random):
+    """Exponential delay for a zero-based retry index, capped at ``max_delay``."""
+    delay = min(max_delay, base_delay * (2 ** attempt))
+    if jitter:
+        delay *= rng.uniform(0.5, 1.0)
+    return delay
+
+
+def call_with_retries(
+    fn,
+    *,
+    max_retries=5,
+    base_delay=1.0,
+    max_delay=60.0,
+    logging=print,
+    sleep=time.sleep,
+    jitter=True,
+):
+    """Call ``fn()`` and retry transient failures with exponential backoff.
+
+    Makes at most ``max_retries + 1`` calls. Non-transient errors are re-raised
+    immediately. After the final transient failure, the last error is re-raised.
+    Returns the result of the first successful call.
+    """
+    if max_retries < 0:
+        raise ValueError("max_retries must be >= 0")
+    last_exc = None
+    for attempt in range(max_retries + 1):
+        try:
+            return fn()
+        except Exception as exc:  # noqa: BLE001 - classified below
+            if not is_retryable_error(exc):
+                raise
+            last_exc = exc
+            if attempt >= max_retries:
+                break
+            delay = backoff_delay(attempt, base_delay, max_delay, jitter=jitter)
+            server_delay = _retry_after_seconds(exc)
+            if server_delay is not None:
+                delay = min(max_delay, server_delay)
+            logging(
+                f"Transient API error ({type(exc).__name__}: {exc}); "
+                f"retry {attempt + 1}/{max_retries} in {delay:.2f}s"
+            )
+            sleep(delay)
+    raise last_exc
