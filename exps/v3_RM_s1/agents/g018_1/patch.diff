+# Retry policy for model API calls.
+API_MAX_RETRIES = 5          # retries after the first attempt
+API_BASE_DELAY = 2.0         # seconds; doubled on each retry
+API_MAX_DELAY = 60.0         # cap on a single backoff sleep
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+
+
+def _is_transient_api_error(e):
+    """
+    Return True if `e` is a failure that is worth retrying (rate limits, timeouts,
+    connection drops, overloaded/5xx responses). Client errors such as bad requests
+    or authentication failures are not transient and are raised immediately.
+    """
+    transient_types = (
+        openai.RateLimitError,
+        openai.APITimeoutError,
+        openai.APIConnectionError,
+        openai.InternalServerError,
+        anthropic.RateLimitError,
+        anthropic.APITimeoutError,
+        anthropic.APIConnectionError,
+        anthropic.InternalServerError,
+    )
+    if isinstance(e, transient_types):
+        return True
+    if isinstance(e, (openai.APIStatusError, anthropic.APIStatusError)):
+        return getattr(e, 'status_code', None) in TRANSIENT_STATUS_CODES
+    return False
+
+
+def _backoff_delay(attempt):
+    """Exponential backoff with jitter for the given zero-based retry index."""
+    delay = min(API_MAX_DELAY, API_BASE_DELAY * (2 ** attempt))
+    return delay * random.uniform(0.5, 1.0)
+
+
+def _call_model_api(call, logging=print, max_retries=API_MAX_RETRIES):
+    """
+    Invoke `call()` (a zero-argument function that performs one API request),
+    retrying transient failures with exponential backoff. Non-transient errors
+    and the final failure are re-raised to the caller.
+    """
+    log = logging if logging is not None else print
+    for attempt in range(max_retries + 1):
+        try:
+            return call()
+        except Exception as e:
+            if not _is_transient_api_error(e) or attempt >= max_retries:
+                log(f"Model API call failed (attempt {attempt + 1}): {e}")
+                raise
+            delay = _backoff_delay(attempt)
+            log(f"Transient model API error (attempt {attempt + 1}/{max_retries + 1}): {e}. Retrying in {delay:.1f}s")
+            time.sleep(delay)
+
+
