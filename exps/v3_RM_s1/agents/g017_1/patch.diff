diff --git a/tests/test_coding_agent_retry.py b/tests/test_coding_agent_retry.py
index 57c3f90..a4b37b7 100644
--- a/tests/test_coding_agent_retry.py
+++ b/tests/test_coding_agent_retry.py
@@ -128,3 +128,26 @@ def test_analysis_prompt_has_no_final_review_step(fake_env):
     make, calls = fake_env
     make().forward()
     assert "Final review" not in calls["chat"][0]["msg"]
+
+
+def test_deliverable_sentence_in_both_phases(fake_env):
+    make, calls = fake_env
+    make().forward()
+    for idx in (0, 1):
+        msg = calls["chat"][idx]["msg"]
+        assert "Your deliverable is the final solution file." in msg
+        assert "state its path in your final summary" in msg
+
+
+def test_implementation_prompt_names_solution_file_in_summary(fake_env):
+    make, calls = fake_env
+    make().forward()
+    msg = calls["chat"][1]["msg"]
+    assert "Write the final solution to the deliverable file described above." in msg
+    assert "the path of the solution file" in msg
+
+
+def test_analysis_prompt_forbids_file_changes(fake_env):
+    make, calls = fake_env
+    make().forward()
+    assert "Do NOT create or modify any files in this phase." in calls["chat"][0]["msg"]
