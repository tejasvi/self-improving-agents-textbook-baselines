diff --git a/tests/test_coding_agent_flow.py b/tests/test_coding_agent_flow.py
index c8d0c41..7a16917 100644
--- a/tests/test_coding_agent_flow.py
+++ b/tests/test_coding_agent_flow.py
@@ -58,3 +58,57 @@ def test_tool_schema_shape(tool):
     assert {"name", "description", "input_schema"} <= set(info)
     _check_schema(info["input_schema"])
     assert callable(tool["function"])
+
+
+def test_phase_retry_after_exception_uses_last_good_state(agent):
+    calls = []
+
+    def flaky_chat(msg, model=None, msg_history=None, logging=None):
+        calls.append({"msg": msg, "msg_history": msg_history})
+        # First attempt of the analysis phase fails once.
+        if len(calls) == 1:
+            raise RuntimeError("transient")
+        return (msg_history or []) + [{"role": "assistant", "content": f"reply {len(calls)}"}]
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=flaky_chat):
+        agent.forward()
+
+    assert len(calls) == 3
+    assert "ANALYSIS phase" in calls[0]["msg"]
+    assert "ANALYSIS phase" in calls[1]["msg"]          # retried same phase
+    assert calls[1]["msg_history"] == []                # from last good state
+    assert "IMPLEMENTATION phase" in calls[2]["msg"]
+    assert calls[2]["msg_history"] == [{"role": "assistant", "content": "reply 2"}]
+
+
+def test_implementation_phase_retry_keeps_analysis_history(agent):
+    calls = []
+
+    def flaky_chat(msg, model=None, msg_history=None, logging=None):
+        calls.append({"msg": msg, "msg_history": msg_history})
+        if len(calls) == 2:
+            raise RuntimeError("transient")
+        return (msg_history or []) + [{"role": "assistant", "content": f"reply {len(calls)}"}]
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=flaky_chat):
+        agent.forward()
+
+    assert len(calls) == 3
+    expected = [{"role": "assistant", "content": "reply 1"}]
+    assert calls[1]["msg_history"] == expected
+    assert calls[2]["msg_history"] == expected
+    assert "IMPLEMENTATION phase" in calls[2]["msg"]
+
+
+def test_retry_gives_up_after_one_retry(agent):
+    calls = []
+
+    def always_fail(msg, model=None, msg_history=None, logging=None):
+        calls.append(msg)
+        raise RuntimeError("persistent")
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=always_fail):
+        with pytest.raises(RuntimeError, match="persistent"):
+            agent.forward()
+
+    assert len(calls) == 2  # original attempt + exactly one retry
