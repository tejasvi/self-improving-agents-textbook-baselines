+def run_phase_with_retry(instruction, model, msg_history, max_retries=1):
+    """
+    Run one conversation phase. If it ends with an exception, retry it up to
+    `max_retries` more times, each time starting again from the last good
+    message history (the history passed in, which the phase never mutates).
+    The final exception is re-raised if every attempt fails.
+    """
+    for attempt in range(max_retries + 1):
+        try:
+            return chat_with_agent(
+                instruction, model=model, msg_history=msg_history, logging=safe_log
+            )
+        except Exception as e:
+            safe_log(f"Phase attempt {attempt + 1} failed: {e}")
+            if attempt == max_retries:
+                raise
+
