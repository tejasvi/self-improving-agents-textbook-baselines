diff --git a/tests/test_llm_retry.py b/tests/test_llm_retry.py
new file mode 100644
index 0000000..051af94
--- /dev/null
+++ b/tests/test_llm_retry.py
@@ -0,0 +1,188 @@
+import sys
+import os
+from unittest.mock import MagicMock, patch
+
+import anthropic
+import backoff
+import httpx
+import openai
+import pytest
+
+sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import llm
+from llm import is_transient_error, get_response_from_llm, get_batch_responses_from_llm
+from llm_withtools import get_response_withtools
+
+
+def _req():
+    return httpx.Request("POST", "https://example.invalid/v1/messages")
+
+
+def _resp(status):
+    return httpx.Response(status, request=_req())
+
+
+def anth_status(cls, status):
+    return cls("boom", response=_resp(status), body=None)
+
+
+def oai_status(cls, status):
+    return cls("boom", response=_resp(status), body=None)
+
+
+@pytest.fixture(autouse=True)
+def no_sleep(monkeypatch):
+    # Make backoff sleeps instant so retry tests are fast.
+    monkeypatch.setattr(backoff._sync.time, "sleep", lambda s: None)
+
+
+def claude_ok_response(text="hello"):
+    block = MagicMock()
+    block.text = text
+    resp = MagicMock()
+    resp.content = [block]
+    return resp
+
+
+# ---------- classifier ----------
+
+@pytest.mark.parametrize("exc", [
+    anth_status(anthropic.RateLimitError, 429),
+    anth_status(anthropic.InternalServerError, 500),
+    anth_status(anthropic.APIStatusError, 503),
+    anthropic.APITimeoutError(request=_req()),
+    anthropic.APIConnectionError(request=_req()),
+    oai_status(openai.RateLimitError, 429),
+    openai.APITimeoutError(request=_req()),
+    openai.APIConnectionError(request=_req()),
+    oai_status(openai.InternalServerError, 502),
+])
+def test_transient_errors_are_retryable(exc):
+    assert is_transient_error(exc)
+
+
+@pytest.mark.parametrize("exc", [
+    anth_status(anthropic.BadRequestError, 400),
+    anth_status(anthropic.AuthenticationError, 401),
+    anth_status(anthropic.NotFoundError, 404),
+    oai_status(openai.BadRequestError, 400),
+    ValueError("Unsupported model: foo"),
+    KeyError("x"),
+])
+def test_permanent_errors_are_not_retryable(exc):
+    assert not is_transient_error(exc)
+
+
+# ---------- get_response_from_llm ----------
+
+def test_retries_transient_then_succeeds():
+    client = MagicMock()
+    client.messages.create.side_effect = [
+        anth_status(anthropic.RateLimitError, 429),
+        anthropic.APIConnectionError(request=_req()),
+        claude_ok_response("done"),
+    ]
+    content, hist = get_response_from_llm(
+        msg="hi", client=client, model="claude-3-5-sonnet-20241022", system_message="sys",
+    )
+    assert content == "done"
+    assert client.messages.create.call_count == 3
+    assert hist[-1]["content"][0]["text"] == "done"
+
+
+def test_permanent_error_fails_fast():
+    client = MagicMock()
+    client.messages.create.side_effect = anth_status(anthropic.BadRequestError, 400)
+    with pytest.raises(anthropic.BadRequestError):
+        get_response_from_llm(
+            msg="hi", client=client, model="claude-3-5-sonnet-20241022", system_message="sys",
+        )
+    assert client.messages.create.call_count == 1
+
+
+def test_transient_failure_exhausts_max_tries():
+    client = MagicMock()
+    client.messages.create.side_effect = anth_status(anthropic.InternalServerError, 500)
+    with pytest.raises(anthropic.InternalServerError):
+        get_response_from_llm(
+            msg="hi", client=client, model="claude-3-5-sonnet-20241022", system_message="sys",
+        )
+    assert client.messages.create.call_count == 6  # max_tries
+
+
+def test_openai_transient_retried():
+    client = MagicMock()
+    ok = MagicMock()
+    ok.choices = [MagicMock(message=MagicMock(content="yo"))]
+    client.chat.completions.create.side_effect = [
+        openai.APITimeoutError(request=_req()),
+        ok,
+    ]
+    content, _ = get_response_from_llm(
+        msg="hi", client=client, model="gpt-4o-2024-08-06", system_message="sys",
+    )
+    assert content == "yo"
+    assert client.chat.completions.create.call_count == 2
+
+
+# ---------- batch: no stacked retries ----------
+
+def test_batch_fallback_does_not_stack_retries():
+    client = MagicMock()
+    client.messages.create.side_effect = anth_status(anthropic.InternalServerError, 500)
+    with pytest.raises(anthropic.InternalServerError):
+        get_batch_responses_from_llm(
+            msg="hi", client=client, model="claude-3-5-sonnet-20241022",
+            system_message="sys", n_responses=2,
+        )
+    # Only the outer llm_retry governs attempts: 6 total, not 6*6.
+    assert client.messages.create.call_count == 6
+
+
+# ---------- get_response_withtools ----------
+
+def test_withtools_retries_transient_then_succeeds():
+    client = MagicMock()
+    client.messages.create.side_effect = [
+        anth_status(anthropic.RateLimitError, 429),
+        claude_ok_response("tool ok"),
+    ]
+    out = get_response_withtools(
+        client=client, model="claude-3-5-sonnet-20241022", messages=[],
+        tools=[], tool_choice={"type": "auto"}, logging=lambda *a, **k: None,
+    )
+    assert out.content[0].text == "tool ok"
+    assert client.messages.create.call_count == 2
+
+
+def test_withtools_permanent_error_no_retry():
+    client = MagicMock()
+    client.messages.create.side_effect = anth_status(anthropic.BadRequestError, 400)
+    with pytest.raises(anthropic.BadRequestError):
+        get_response_withtools(
+            client=client, model="claude-3-5-sonnet-20241022", messages=[],
+            tools=[], tool_choice={"type": "auto"},
+        )
+    assert client.messages.create.call_count == 1
+
+
+def test_withtools_unsupported_model_raises_once():
+    client = MagicMock()
+    with pytest.raises(ValueError):
+        get_response_withtools(
+            client=client, model="unknown-model", messages=[],
+            tools=[], tool_choice="auto",
+        )
+    assert not client.messages.create.called
+
+
+def test_withtools_default_logging_does_not_crash():
+    # logging was previously None by default; calling without it must work.
+    client = MagicMock()
+    client.messages.create.return_value = claude_ok_response("x")
+    out = get_response_withtools(
+        client=client, model="claude-3-5-sonnet-20241022", messages=[],
+        tools=[], tool_choice={"type": "auto"},
+    )
+    assert out.content[0].text == "x"
