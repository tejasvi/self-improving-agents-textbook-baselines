+# Errors that are worth retrying: rate limits, timeouts, connection drops, and
+# server-side failures. Anything else (bad request, auth, not found, ...) is permanent.
+TRANSIENT_ERROR_TYPES = (
+    anthropic.RateLimitError,
+    anthropic.APITimeoutError,
+    anthropic.APIConnectionError,
+    anthropic.InternalServerError,
+    openai.RateLimitError,
+    openai.APITimeoutError,
+    openai.APIConnectionError,
+    openai.InternalServerError,
+)
+TRANSIENT_STATUS_CODES = (408, 409, 429)
+
+
+def is_transient_error(e: Exception) -> bool:
+    """Return True if the exception is a transient API failure that should be retried."""
+    if isinstance(e, TRANSIENT_ERROR_TYPES):
+        return True
+    status = getattr(e, "status_code", None)
+    if isinstance(status, int):
+        return status in TRANSIENT_STATUS_CODES or status >= 500
+    return False
+
+
+def _log_retry(details):
+    exc = details.get("exception")
+    print(
+        f"LLM call failed with transient error ({type(exc).__name__}: {exc}). "
+        f"Retry {details['tries']} in {details['wait']:.1f}s."
+    )
+
+
+# Retry transient failures with capped, jittered exponential backoff.
+# Bounded by max_tries and max_time, so it never loops indefinitely.
+llm_retry = backoff.on_exception(
+    backoff.expo,
+    Exception,
+    giveup=lambda e: not is_transient_error(e),
+    max_tries=6,
+    max_time=300,
+    max_value=60,
+    jitter=backoff.full_jitter,
+    on_backoff=_log_retry,
+)
+
+
