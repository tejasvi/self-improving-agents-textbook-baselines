diff --git a/llm.py b/llm.py
index ca4f279..466b1d9 100644
--- a/llm.py
+++ b/llm.py
@@ -202,6 +202,27 @@ def get_batch_responses_from_llm(
 
     return content, new_msg_history
 
+def format_chat_response_metadata(response, model=''):
+    """
+    Formats the metadata (stop reason and usage) of a response from a
+    chat-style API call (Anthropic messages or OpenAI chat completions) for logging.
+    """
+    try:
+        stop_reason = getattr(response, 'stop_reason', None)
+        choices = getattr(response, 'choices', None)
+        if stop_reason is None and choices:
+            stop_reason = getattr(choices[0], 'finish_reason', None)
+        usage = getattr(response, 'usage', None)
+        usage_str = None
+        if usage is not None:
+            usage_str = {
+                'input_tokens': getattr(usage, 'input_tokens', getattr(usage, 'prompt_tokens', None)),
+                'output_tokens': getattr(usage, 'output_tokens', getattr(usage, 'completion_tokens', None)),
+            }
+        return f"Response metadata - Stop reason: {stop_reason}, Usage: {usage_str}"
+    except Exception as e:
+        return f"Response metadata unavailable: {str(e)}"
+
 @llm_retry()
 def get_response_from_llm(
         msg,
@@ -211,6 +232,7 @@ def get_response_from_llm(
         print_debug=False,
         msg_history=None,
         temperature=0.7,
+        logging=None,
 ):
     if msg_history is None:
         msg_history = []
@@ -327,6 +349,8 @@ def get_response_from_llm(
         resoning_content = response.choices[0].message.reasoning_content
     else:
         raise ValueError(f"Model {model} not supported.")
+    if logging is not None:
+        logging(format_chat_response_metadata(response, model))
     if print_debug:
         print()
         print("*" * 20 + " LLM START " + "*" * 20)
