+def truncate_output(text, limit=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of text if it exceeds limit characters."""
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return text[:half] + f"\n... [{omitted} characters truncated] ...\n" + text[-half:]
