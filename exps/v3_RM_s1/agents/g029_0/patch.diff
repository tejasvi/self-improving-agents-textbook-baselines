+def _last_assistant_text(msg_history):
+    """Returns the text of the last assistant message in a message history."""
+    for msg in reversed(msg_history):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            texts = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    texts.append(block.get('text', ''))
+                elif hasattr(block, 'type') and getattr(block, 'type') == 'text':
+                    texts.append(getattr(block, 'text', ''))
+            return "\n".join(texts)
+    return ""
+
+def _examples_passed(msg_history):
+    """True if the agent's final verification reply ends with 'EXAMPLES: PASS'."""
+    lines = [l.strip() for l in _last_assistant_text(msg_history).splitlines() if l.strip()]
+    if not lines:
+        return False
+    return lines[-1].upper().endswith("EXAMPLES: PASS")
