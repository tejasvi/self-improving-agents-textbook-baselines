+# Retry policy for transient model API failures (rate limits, timeouts,
+# connection drops, 5xx / overloaded responses).
+MAX_API_RETRIES = 5
+BASE_RETRY_DELAY = 2.0  # seconds
+MAX_RETRY_DELAY = 60.0  # seconds
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+_TRANSIENT_ERROR_NAMES = [
+    "RateLimitError",
+    "APITimeoutError",
+    "APIConnectionError",
+    "InternalServerError",
+]
+_TRANSIENT_ERROR_TYPES = tuple(
+    getattr(module, name)
+    for module in (anthropic, openai)
+    for name in _TRANSIENT_ERROR_NAMES
+    if hasattr(module, name)
+)
+
+
+def is_transient_api_error(error):
+    """True if the exception looks like a transient, retryable API failure."""
+    if isinstance(error, _TRANSIENT_ERROR_TYPES):
+        return True
+    status_code = getattr(error, "status_code", None)
+    return isinstance(status_code, int) and status_code in TRANSIENT_STATUS_CODES
+
+
+def call_with_retries(fn, *args, max_retries=MAX_API_RETRIES, logging=print, **kwargs):
+    """
+    Call fn(*args, **kwargs), retrying only on transient API errors with
+    capped exponential backoff and jitter. Non-transient errors propagate immediately.
+    """
+    for attempt in range(max_retries + 1):
+        try:
+            return fn(*args, **kwargs)
+        except Exception as e:
+            if attempt >= max_retries or not is_transient_api_error(e):
+                raise
+            delay = min(MAX_RETRY_DELAY, BASE_RETRY_DELAY * (2 ** attempt))
+            delay *= random.uniform(0.5, 1.0)
+            logging(
+                f"Transient API error ({type(e).__name__}: {e}); "
+                f"retry {attempt + 1}/{max_retries} in {delay:.1f}s"
+            )
+            time.sleep(delay)
+
