+def get_response_metadata(response, model=''):
+    """
+    Extract stop reason and token usage from a model response (Claude or OpenAI).
+    Missing fields are reported as None.
+    """
+    if 'claude' in model:
+        stop_reason = getattr(response, 'stop_reason', None)
+    else:
+        incomplete = getattr(response, 'incomplete_details', None)
+        stop_reason = getattr(response, 'status', None)
+        if incomplete is not None:
+            reason = getattr(incomplete, 'reason', None)
+            if reason is None and isinstance(incomplete, dict):
+                reason = incomplete.get('reason')
+            if reason:
+                stop_reason = f"{stop_reason} ({reason})"
+
+    usage = getattr(response, 'usage', None)
+    if usage is not None:
+        usage = {
+            'input_tokens': getattr(usage, 'input_tokens', None),
+            'output_tokens': getattr(usage, 'output_tokens', None),
+        }
+    return {'stop_reason': stop_reason, 'usage': usage}
+
+def log_response_metadata(response, model='', logging=None):
+    """
+    Log the stop reason and usage of a model response to the chat history.
+    """
+    if logging is None:
+        return
+    metadata = get_response_metadata(response, model=model)
+    logging(f"Response metadata: stop_reason={metadata['stop_reason']}, usage={metadata['usage']}")
+
