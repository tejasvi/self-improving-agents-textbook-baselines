+    def _chat_with_retry(self, msg, msg_history):
+        """
+        Send one turn to the agent. If the call raises an exception, retry the turn
+        exactly once from the last good state (the msg_history passed in, which is
+        not modified by the failed call). If the retry also fails, return the last
+        good state unchanged.
+        """
+        try:
+            return chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        except Exception as e:
+            safe_log(f"Run raised an exception, retrying once from last good state: {e!r}", level=logging.WARNING)
+        try:
+            return chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        except Exception as e:
+            # Second failure: keep the last good state so the attempt can still finish.
+            safe_log(f"Retry also failed, continuing from last good state: {e!r}", level=logging.ERROR)
+            return msg_history
+
