+# Limits used to keep the context small
+MAX_TOOL_OUTPUT_CHARS = 10000     # max characters of a single tool result
+MAX_OLD_TOOL_RESULT_CHARS = 1000  # max characters of a tool result in older turns
+KEEP_RECENT_MESSAGES = 6          # most recent messages are kept with full tool results
+
+def truncate_text(text, max_chars=MAX_TOOL_OUTPUT_CHARS):
+    """
+    Truncates text to about max_chars characters by keeping its head and tail,
+    with a marker in the middle giving the number of characters omitted.
+    """
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    marker = f"\n... [{len(text) - max_chars} characters truncated] ...\n"
+    if max_chars < len(marker):
+        return text[:max_chars]
+    keep = max_chars - len(marker)
+    head = keep // 2
+    tail = keep - head
+    return text[:head] + marker + (text[-tail:] if tail > 0 else "")
+
+def compress_msg_history_for_context(messages, keep_recent=KEEP_RECENT_MESSAGES, max_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Returns a copy of messages where tool results in older turns (all but the last
+    `keep_recent` messages) are truncated. The original messages are not modified.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compressed = []
+    for i, msg in enumerate(messages):
+        content = msg.get('content') if isinstance(msg, dict) else None
+        if i >= cutoff or not isinstance(content, list):
+            compressed.append(msg)
+            continue
+        new_content = []
+        for block in content:
+            if isinstance(block, dict) and block.get('type') == 'tool_result':
+                block = dict(block)
+                block['content'] = truncate_text(block.get('content', ''), max_chars)
+            new_content.append(block)
+        compressed.append({**msg, 'content': new_content})
+    return compressed
+
