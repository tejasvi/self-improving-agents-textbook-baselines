diff --git a/tools/run_io_tests.py b/tools/run_io_tests.py
new file mode 100644
index 0000000..5175033
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,114 @@
+import shlex
+import subprocess
+
+MAX_FIELD_CHARS = 2000
+DEFAULT_TIMEOUT = 10.0
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a program on given test inputs and compare its standard output with the expected outputs.\n
+* The 'command' is executed once per test case (e.g. 'python3 /path/to/solution.py'); the test 'input' is fed to its standard input.
+* Each test's stdout is compared with 'expected_output' after normalizing line endings, trailing whitespace on each line and trailing blank lines.
+* Returns a PASS/FAIL line per test case; for failures it shows the actual output, expected output, stderr and exit code, and for timeouts it says so.
+* Use it to check the solution against the examples in the problem statement and against your own additional test cases (including edge cases).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell-style command that runs the program reading from stdin and writing to stdout, e.g. 'python3 /path/to/solution.py'."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "The list of test cases to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The exact text the program is expected to print to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional time limit in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["command", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def _clip(text: str) -> str:
+    if len(text) > MAX_FIELD_CHARS:
+        return text[:MAX_FIELD_CHARS] + "\n<response clipped>"
+    return text
+
+
+def tool_function(command: str, test_cases: list, timeout: float = None) -> str:
+    try:
+        args = shlex.split(command)
+    except ValueError as e:
+        return f"Error: could not parse command: {e}"
+    if not args:
+        return "Error: empty command"
+    if not isinstance(test_cases, list) or not test_cases:
+        return "Error: test_cases must be a non-empty list"
+    time_limit = DEFAULT_TIMEOUT if timeout is None else float(timeout)
+
+    results = []
+    passed = 0
+    for idx, case in enumerate(test_cases, start=1):
+        if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+            results.append(f"Test {idx}: FAIL (malformed test case; needs 'input' and 'expected_output')")
+            continue
+        test_input = str(case["input"])
+        expected = str(case["expected_output"])
+        try:
+            proc = subprocess.run(
+                args,
+                input=test_input,
+                capture_output=True,
+                text=True,
+                timeout=time_limit,
+            )
+        except subprocess.TimeoutExpired:
+            results.append(f"Test {idx}: FAIL (timed out after {time_limit} seconds)\n"
+                           f"Input:\n{_clip(test_input)}")
+            continue
+        except FileNotFoundError as e:
+            return f"Error: command not found: {e}"
+        except Exception as e:
+            results.append(f"Test {idx}: FAIL (error running command: {e})")
+            continue
+
+        if _normalize(proc.stdout) == _normalize(expected):
+            passed += 1
+            results.append(f"Test {idx}: PASS")
+        else:
+            results.append(
+                f"Test {idx}: FAIL (exit code {proc.returncode})\n"
+                f"Input:\n{_clip(test_input)}\n"
+                f"Expected output:\n{_clip(expected)}\n"
+                f"Actual output:\n{_clip(proc.stdout)}\n"
+                f"Stderr:\n{_clip(proc.stderr)}"
+            )
+
+    summary = f"{passed}/{len(test_cases)} test cases passed."
+    return summary + "\n\n" + "\n\n".join(results)
