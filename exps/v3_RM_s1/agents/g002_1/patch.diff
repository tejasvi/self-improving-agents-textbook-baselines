@@ -0,0 +1,112 @@
+import pytest
+
+import coding_agent
+from coding_agent import AgenticSystem, format_previous_attempts, extract_last_assistant_text, MAX_PREVIOUS_ATTEMPT_CHARS
+
+
+@pytest.fixture
+def fake_env(monkeypatch, tmp_path):
+    """Replace LLM and git side effects with recorders."""
+    calls = {"chat": [], "reset": [], "diff": 0}
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls["chat"].append({"msg": msg, "history_len": len(msg_history or [])})
+        n = len(calls["chat"])
+        new_hist = list(msg_history or []) + [
+            {"role": "user", "content": [{"type": "text", "text": msg}]},
+            {"role": "assistant", "content": [{"type": "text", "text": f"reply-{n}: tests FAILED on case 3"}]},
+        ]
+        return new_hist
+
+    def fake_reset(git_dname, commit):
+        calls["reset"].append((git_dname, commit))
+
+    def fake_diff(git_dname, commit):
+        calls["diff"] += 1
+        return f"diff-{calls['diff']}"
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    monkeypatch.setattr(coding_agent, "reset_to_commit", fake_reset)
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", fake_diff)
+
+    def make(**kw):
+        return AgenticSystem(
+            problem_statement="Sum two numbers.",
+            git_tempdir=str(tmp_path / "repo"),
+            base_commit="abc123",
+            chat_history_file=str(tmp_path / "chat.md"),
+            **kw,
+        )
+    return make, calls
+
+
+def test_single_attempt_makes_two_llm_calls_and_no_reset(fake_env):
+    make, calls = fake_env
+    records = make().forward()  # default max_attempts=1
+    assert len(calls["chat"]) == 2
+    assert calls["reset"] == []
+    assert len(records) == 1
+    assert records[0]["attempt"] == 1
+    assert "reply-2" in records[0]["summary"]
+    assert records[0]["patch"] == "diff-1"
+    assert "# Previous attempts" not in calls["chat"][0]["msg"]
+
+
+def test_retry_resets_before_second_attempt_only(fake_env):
+    make, calls = fake_env
+    records = make().forward(max_attempts=3)
+    assert len(records) == 3
+    # reset happens before attempts 2 and 3, never before attempt 1
+    assert calls["reset"] == [(str(make().git_tempdir), "abc123")] * 2
+
+
+def test_retry_prompt_contains_previous_summary_and_patch(fake_env):
+    make, calls = fake_env
+    make().forward(max_attempts=2)
+    # calls[0..1] are attempt 1, calls[2..3] are attempt 2
+    first_attempt_analysis = calls["chat"][0]["msg"]
+    retry_analysis = calls["chat"][2]["msg"]
+    retry_impl = calls["chat"][3]["msg"]
+    assert "# Previous attempts" not in first_attempt_analysis
+    for msg in (retry_analysis, retry_impl):
+        assert "## Attempt 1" in msg
+        assert "reply-2: tests FAILED on case 3" in msg
+        assert "diff-1" in msg
+    # retry impl starts with fresh history (analysis only), not the failed attempt's history
+    assert calls["chat"][2]["history_len"] == 0
+
+
+def test_implementation_prompt_requests_test_output(fake_env):
+    make, calls = fake_env
+    make().forward()
+    assert "test commands you ran" in calls["chat"][1]["msg"]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1.5, None, "2"])
+def test_invalid_max_attempts_raises(fake_env, bad):
+    make, calls = fake_env
+    with pytest.raises(ValueError):
+        make().forward(max_attempts=bad)
+    assert calls["chat"] == []
+
+
+def test_format_previous_attempts_empty():
+    assert format_previous_attempts([]) == ""
+
+
+def test_format_previous_attempts_truncates_large_output():
+    big = "x" * (MAX_PREVIOUS_ATTEMPT_CHARS * 3)
+    text = format_previous_attempts([{"attempt": 1, "summary": big, "patch": big}])
+    assert "<response clipped>" in text
+    assert len(text) < MAX_PREVIOUS_ATTEMPT_CHARS * 2 + 1000
+
+
+def test_extract_last_assistant_text_handles_block_lists_and_strings():
+    hist = [
+        {"role": "user", "content": "hi"},
+        {"role": "assistant", "content": "first"},
+        {"role": "user", "content": [{"type": "text", "text": "q"}]},
+        {"role": "assistant", "content": [{"type": "text", "text": "last"}]},
+    ]
+    assert extract_last_assistant_text(hist) == "last"
+    assert extract_last_assistant_text([]) == ""
