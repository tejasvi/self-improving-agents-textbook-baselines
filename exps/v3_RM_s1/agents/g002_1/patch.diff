+MAX_PREVIOUS_ATTEMPT_CHARS = 8000
+
+def _content_to_text(content):
+    """Extract plain text from a message content (str, or list of text blocks)."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for block in content:
+            if isinstance(block, dict):
+                text = block.get('text')
+            else:
+                text = getattr(block, 'text', None)
+            if isinstance(text, str):
+                parts.append(text)
+        return "\n".join(parts)
+    return ""
+
+def extract_last_assistant_text(msg_history):
+    """Return the text of the last assistant message in a message history."""
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            return _content_to_text(msg.get('content'))
+    return ""
+
+def _truncate(text, max_chars=MAX_PREVIOUS_ATTEMPT_CHARS):
+    if len(text) <= max_chars:
+        return text
+    return text[:max_chars] + "\n<response clipped>"
+
+def format_previous_attempts(previous_attempts):
+    """
+    Render earlier failed attempts (summary with test output, and patch) as prompt text.
+    Returns an empty string when there are no previous attempts.
+    """
+    if not previous_attempts:
+        return ""
+    sections = []
+    for record in previous_attempts:
+        sections.append(
+            f"## Attempt {record['attempt']}\n"
+            f"### Final summary and test output of attempt {record['attempt']}\n"
+            f"{_truncate(record['summary'])}\n\n"
+            f"### Patch produced by attempt {record['attempt']}\n"
+            f"```diff\n{_truncate(record['patch'])}\n```"
+        )
+    body = "\n\n".join(sections)
+    return (
+        "\n\n# Previous attempts\n"
+        "The following earlier attempts at this problem did not succeed. The repository has been reset "
+        "to the base commit. Study what they tried, the test output they reported, and why it was "
+        "insufficient, and avoid repeating the same mistakes.\n\n"
+        f"{body}\n"
+    )
+
