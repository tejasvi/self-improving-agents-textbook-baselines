diff --git a/coding_agent.py b/coding_agent.py
index 2ed67de..a1f0789 100644
--- a/coding_agent.py
+++ b/coding_agent.py
@@ -95,6 +95,9 @@ def safe_log(message, level=logging.INFO):
 
 MAX_PREVIOUS_ATTEMPT_CHARS = 8000
 
+# Extra runs of an attempt that left no change in the repository (empty git diff).
+MAX_NO_CHANGE_RERUNS = 2
+
 def _content_to_text(content):
     """Extract plain text from a message content (str, or list of text blocks)."""
     if isinstance(content, str):
@@ -200,6 +203,11 @@ class AgenticSystem:
         is given the previous attempts' summaries (including test output) and their
         patches, and starts from a clean copy of the base commit. Returns a list of
         attempt records, one per attempt that was run.
+
+        After each attempt the git diff against the base commit is checked. If the attempt
+        left no changes in the repository, it is rerun (up to MAX_NO_CHANGE_RERUNS extra
+        times) before moving on to the next attempt slot. Attempts without changes are
+        not recorded, so they do not appear in the retry prompt.
         """
         if not isinstance(max_attempts, int) or max_attempts < 1:
             raise ValueError(f"max_attempts must be a positive integer, got {max_attempts!r}")
@@ -211,7 +219,22 @@ class AgenticSystem:
                 safe_log(f"=== Resetting repo to {self.base_commit} before attempt {attempt_idx + 1} ===")
                 reset_to_commit(self.git_tempdir, self.base_commit)
 
-            record = self._run_single_attempt(attempt_idx + 1, previous_attempts)
+            record = None
+            for run_idx in range(1 + MAX_NO_CHANGE_RERUNS):
+                if run_idx > 0:
+                    safe_log(
+                        f"=== Attempt {attempt_idx + 1} produced no solution-file change; "
+                        f"rerunning (rerun {run_idx} of {MAX_NO_CHANGE_RERUNS}) ==="
+                    )
+                candidate = self._run_single_attempt(attempt_idx + 1, previous_attempts)
+                if candidate["patch"].strip():
+                    record = candidate
+                    break
+
+            if record is None:
+                # Still no change after all reruns; nothing to hand to the next attempt.
+                safe_log(f"=== Attempt {attempt_idx + 1} made no changes after {MAX_NO_CHANGE_RERUNS} reruns ===")
+                continue
             previous_attempts.append(record)
 
         return previous_attempts
diff --git a/tests/test_coding_agent_retry.py b/tests/test_coding_agent_retry.py
index a273054..496a587 100644
--- a/tests/test_coding_agent_retry.py
+++ b/tests/test_coding_agent_retry.py
@@ -144,3 +144,56 @@ def test_analysis_prompt_has_no_max_size_timing_step(fake_env):
     make, calls = fake_env
     make().forward()
     assert "Max-size timing check" not in calls["chat"][0]["msg"]
+
+
+def _patch_diffs(monkeypatch, diffs):
+    """Make diff_versus_commit return the given sequence of patches, then repeat the last one."""
+    seq = list(diffs)
+    calls = {"n": 0}
+
+    def fake_diff(git_dname, commit):
+        i = min(calls["n"], len(seq) - 1)
+        calls["n"] += 1
+        return seq[i]
+
+    monkeypatch.setattr(coding_agent, "diff_versus_commit", fake_diff)
+    return calls
+
+
+def test_no_change_attempt_is_rerun_until_change(fake_env, monkeypatch):
+    make, calls = fake_env
+    # attempt 1: first run makes no change, second run makes a change
+    _patch_diffs(monkeypatch, ["", "real patch"])
+    records = make().forward(max_attempts=1)
+    assert len(calls["chat"]) == 4  # 2 runs x (analysis + implementation)
+    assert len(records) == 1
+    assert records[0]["patch"] == "real patch"
+
+
+def test_no_change_attempt_rerun_is_bounded(fake_env, monkeypatch):
+    make, calls = fake_env
+    _patch_diffs(monkeypatch, [""])  # never changes anything
+    records = make().forward(max_attempts=1)
+    runs = 1 + coding_agent.MAX_NO_CHANGE_RERUNS
+    assert len(calls["chat"]) == 2 * runs
+    assert records == []  # unchanged attempts are not recorded
+
+
+def test_no_change_attempts_do_not_enter_retry_prompt(fake_env, monkeypatch):
+    make, calls = fake_env
+    # attempt slot 1 never changes; slot 2 changes
+    _patch_diffs(monkeypatch, [""] * (1 + coding_agent.MAX_NO_CHANGE_RERUNS) + ["patch-2"])
+    records = make().forward(max_attempts=2)
+    assert [r["patch"] for r in records] == ["patch-2"]
+    assert records[0]["attempt"] == 2
+    last_analysis = calls["chat"][-2]["msg"]
+    assert "## Attempt 1" not in last_analysis
+    assert "## Attempt 2" not in last_analysis
+
+
+def test_changed_attempt_is_not_rerun(fake_env, monkeypatch):
+    make, calls = fake_env
+    _patch_diffs(monkeypatch, ["patch-a"])
+    records = make().forward(max_attempts=1)
+    assert len(calls["chat"]) == 2
+    assert records[0]["patch"] == "patch-a"
