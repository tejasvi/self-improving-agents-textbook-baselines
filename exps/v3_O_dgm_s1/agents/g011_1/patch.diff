+def _run_method(solution_path: str, class_name: str, method_name: str, args_json: str, timeout: int) -> subprocess.CompletedProcess:
+    """Run a solution class method via a temporary runner script.
+    The runner imports the solution file, injects typing, instantiates the class, calls the method with JSON-decoded args, and prints the JSON result.
+    """
+    runner_code = f"""
+import sys, json, importlib.util, traceback, typing
+solution_path = sys.argv[1]
+class_name = sys.argv[2]
+method_name = sys.argv[3]
+args_json = sys.argv[4]
+# Load module
+spec = importlib.util.spec_from_file_location('mod', solution_path)
+mod = importlib.util.module_from_spec(spec)
+# Inject typing symbols
+mod.__dict__.update(typing.__dict__)
+spec.loader.exec_module(mod)
+cls = getattr(mod, class_name)
+inst = cls()
+method = getattr(inst, method_name)
+args = json.loads(args_json)
+result = method(*args)
+print(json.dumps(result))
+"""
+    with tempfile.NamedTemporaryFile('w', delete=False, suffix='.py') as tf:
+        tf.write(runner_code)
+        runner_path = tf.name
+    try:
+        cmd = ["timeout", str(timeout), "python3", runner_path, solution_path, class_name, method_name, args_json]
+        return subprocess.run(
+            cmd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+    finally:
+        try:
+            os.remove(runner_path)
+        except OSError:
+            pass
+
+def _load_counterexamples():
+    path = "/tmp/agent_tests/counterexamples.jsonl"
+    if not os.path.exists(path):
+        return []
+    ce = []
+    with open(path, 'r') as f:
+        for line in f:
+            try:
+                ce.append(json.loads(line))
+            except json.JSONDecodeError:
+                continue
+    return ce
+
+def _append_counterexample(input_data: str, expected: str, got: str):
+    path = "/tmp/agent_tests/counterexamples.jsonl"
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, 'a') as f:
+        json.dump({"input": input_data, "expected": expected, "got": got}, f)
+        f.write('\n')
+
