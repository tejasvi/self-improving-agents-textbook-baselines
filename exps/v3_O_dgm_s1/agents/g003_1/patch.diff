+    def _changed_files(self):
+        """Return a list of files changed since base_commit, including untracked files."""
+        # tracked changes
+        try:
+            tracked = subprocess.check_output([
+                "git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit
+            ], text=True).splitlines()
+        except subprocess.CalledProcessError:
+            tracked = []
+        # untracked files
+        try:
+            untracked = subprocess.check_output([
+                "git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"
+            ], text=True).splitlines()
+        except subprocess.CalledProcessError:
+            untracked = []
+        # combine and deduplicate
+        return list(dict.fromkeys(tracked + untracked))
+
+    def _is_test_file(self, path):
+        """Heuristic to determine if a file is a test file."""
+        basename = os.path.basename(path).lower()
+        if basename.startswith('test_') or basename.endswith('_test.py') or basename.endswith('.spec.js') or basename.endswith('test.java'):
+            return True
+        # check if path contains test directories
+        parts = [p.lower() for p in path.split(os.sep)]
+        if 'tests' in parts or 'test' in parts:
+            return True
+        return False
+
+    def _patch_status(self):
+        """Classify the current patch status.
+        Returns:
+            'empty' if no non‑readme files changed,
+            'test_only' if all changed files are tests,
+            'ok' otherwise.
+        """
+        changed = self._changed_files()
+        # filter out README/markdown files
+        non_readme = [p for p in changed if not (os.path.basename(p).lower().startswith('readme') or p.lower().endswith('.md') or p.lower().endswith('.markdown'))]
+        if not non_readme:
+            return 'empty'
+        if all(self._is_test_file(p) for p in non_readme):
+            return 'test_only'
+        return 'ok'
+
