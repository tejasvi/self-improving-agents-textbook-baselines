--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,106 @@
+import subprocess
+import re
+import os
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": "Run the provided solution against sample input/output pairs extracted from the problem statement. Returns a plain‑text report of PASS/FAIL for each sample, including the input, expected output, actual output and any stderr.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution Python file to execute."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "Full problem statement text from which sample inputs/outputs are parsed."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each sample execution."
+                }
+            },
+            "required": ["solution_path", "problem_text", "timeout_seconds"]
+        }
+    }
+
+def _extract_samples(problem_text):
+    """Return a list of (input_str, output_str) pairs extracted from the problem text.
+    Handles patterns like:
+    - Sample Input N / Sample Output N
+    - Example / Input: / Output:
+    """
+    samples = []
+    # Pattern for "Sample Input" followed by "Sample Output"
+    pattern = re.compile(
+        r"Sample Input\s*\d*[:\s]*\n(?P<input>.*?)(?:\n{2,}|$)"
+        r"Sample Output\s*\d*[:\s]*\n(?P<output>.*?)(?:\n{2,}|$)",
+        re.DOTALL | re.IGNORECASE,
+    )
+    for m in pattern.finditer(problem_text):
+        inp = m.group('input').strip('\n')
+        out = m.group('output').strip('\n')
+        samples.append((inp, out))
+
+    # Fallback pattern for generic "Input:" / "Output:" sections (often preceded by "Example")
+    generic_pat = re.compile(
+        r"Input\s*[:]?\s*\n(?P<input>.*?)(?:\n{2,}|$)"
+        r"Output\s*[:]?\s*\n(?P<output>.*?)(?:\n{2,}|$)",
+        re.DOTALL | re.IGNORECASE,
+    )
+    for m in generic_pat.finditer(problem_text):
+        inp = m.group('input').strip('\n')
+        out = m.group('output').strip('\n')
+        samples.append((inp, out))
+    return samples
+
+def _run_one(solution_path, input_data, timeout):
+    try:
+        proc = subprocess.run(
+            ["python", solution_path],
+            input=input_data.encode('utf-8'),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+        stdout = proc.stdout.decode('utf-8', errors='ignore').strip('\n')
+        stderr = proc.stderr.decode('utf-8', errors='ignore')
+        return stdout, stderr, proc.returncode
+    except subprocess.TimeoutExpired:
+        return "", f"Execution timed out after {timeout} seconds", -1
+    except Exception as e:
+        return "", f"Execution error: {e}", -1
+
+def tool_function(solution_path: str, problem_text: str, timeout_seconds: int) -> str:
+    """Execute the solution against extracted samples and return a report.
+    The report is plain text and includes PASS/FAIL for each sample.
+    """
+    if not os.path.isabs(solution_path):
+        return f"Error: solution_path must be absolute, got '{solution_path}'"
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found at '{solution_path}'"
+    samples = _extract_samples(problem_text)
+    if not samples:
+        return "No samples could be parsed from the problem statement."
+    report_lines = []
+    for idx, (inp, exp) in enumerate(samples, start=1):
+        actual, stderr, rc = _run_one(solution_path, inp, timeout_seconds)
+        # Normalize whitespace for comparison
+        norm_actual = "\n".join([line.rstrip() for line in actual.splitlines()])
+        norm_exp = "\n".join([line.rstrip() for line in exp.splitlines()])
+        passed = (norm_actual == norm_exp) and (rc == 0)
+        status = "PASS" if passed else "FAIL"
+        report_lines.append(f"Sample {idx}: {status}")
+        report_lines.append("Input:")
+        report_lines.append(inp)
+        report_lines.append("Expected Output:")
+        report_lines.append(exp)
+        report_lines.append("Actual Output:")
+        report_lines.append(actual)
+        if stderr:
+            report_lines.append("Stderr:")
+            report_lines.append(stderr)
+        report_lines.append("---")
+    return "\n".join(report_lines)
