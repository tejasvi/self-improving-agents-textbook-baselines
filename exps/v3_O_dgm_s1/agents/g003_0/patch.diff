+import importlib.util
+import json
+import os
+import sys
+import traceback
+import time
+import subprocess
+from types import ModuleType
+from typing import Any, List, Tuple
+
+def tool_info():
+    return {
+        "name": "verify_solution",
+        "description": "Verify a Solution class by running JSON test cases and optional differential testing.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file containing a Solution class."
+                },
+                "cases_path": {
+                    "type": "string",
+                    "description": "Path to JSON file with test cases (list of {\"args\": [...], \"expected\": ...}). Defaults to /tmp/cases.json."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional path to a brute‑force implementation module for differential testing."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Optional path to a generator script that writes a single random test case to stdout."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Maximum acceptable runtime (seconds) for the max‑size test.",
+                    "default": 2
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+def _load_module_from_path(path: str) -> ModuleType:
+    spec = importlib.util.spec_from_file_location("solution_mod", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {path}")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["solution_mod"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+def _find_public_method(obj: Any) -> Tuple[str, Any]:
+    for attr in dir(obj):
+        if attr.startswith("_"):
+            continue
+        val = getattr(obj, attr)
+        if callable(val):
+            return attr, val
+    raise AttributeError("No public method found on solution object")
+
+def _run_cases(method, cases: List[dict]) -> Tuple[int, List[dict]]:
+    passed = 0
+    failures = []
+    for case in cases:
+        args = case.get("args", [])
+        expected = case.get("expected")
+        try:
+            result = method(*args)
+            if result == expected:
+                passed += 1
+            else:
+                failures.append({"case": case, "got": result, "expected": expected})
+        except Exception:
+            failures.append({"case": case, "error": traceback.format_exc()})
+    return passed, failures
+
+def tool_function(solution_path: str,
+                  cases_path: str = "/tmp/cases.json",
+                  brute_path: str = None,
+                  gen_path: str = None,
+                  time_limit: float = 2.0) -> str:
+    """Run verification harness. Returns a JSON string with results."""
+    report = {"passed": 0, "total": 0, "failures": [], "time_seconds": None}
+    try:
+        sol_mod = _load_module_from_path(solution_path)
+        # Find Solution class
+        Solution = None
+        for name in dir(sol_mod):
+            obj = getattr(sol_mod, name)
+            if isinstance(obj, type) and name == "Solution":
+                Solution = obj
+                break
+        if Solution is None:
+            raise AttributeError("Solution class not found")
+        instance = Solution()
+        _, method = _find_public_method(instance)
+        # Load cases
+        if os.path.exists(cases_path):
+            with open(cases_path) as f:
+                cases = json.load(f)
+        else:
+            cases = []
+        total = len(cases)
+        passed, failures = _run_cases(method, cases)
+        report["passed"] = passed
+        report["total"] = total
+        report["failures"] = failures
+        # Timing on last case if exists
+        if cases:
+            max_case = cases[-1]
+            start = time.time()
+            try:
+                method(*max_case.get("args", []))
+            except Exception:
+                pass
+            elapsed = time.time() - start
+            report["time_seconds"] = elapsed
+        # Differential testing
+        if brute_path and gen_path and os.path.exists(brute_path) and os.path.exists(gen_path):
+            brute_mod = _load_module_from_path(brute_path)
+            # Locate brute Solution
+            BruteSolution = None
+            for name in dir(brute_mod):
+                obj = getattr(brute_mod, name)
+                if isinstance(obj, type) and name == "Solution":
+                    BruteSolution = obj
+                    break
+            if BruteSolution is None:
+                raise AttributeError("Brute force Solution not found")
+            brute_inst = BruteSolution()
+            _, brute_method = _find_public_method(brute_inst)
+            diff_pass = 0
+            diff_total = 5
+            diff_failures = []
+            for _ in range(diff_total):
+                proc = subprocess.run(["python3", gen_path], capture_output=True, text=True, timeout=5)
+                if proc.returncode != 0:
+                    continue
+                try:
+                    gen_case = json.loads(proc.stdout.strip())
+                except Exception:
+                    continue
+                args = gen_case.get("args", [])
+                try:
+                    fast_res = method(*args)
+                    brute_res = brute_method(*args)
+                    if fast_res == brute_res:
+                        diff_pass += 1
+                    else:
+                        diff_failures.append({"case": gen_case, "fast": fast_res, "brute": brute_res})
+                except Exception:
+                    diff_failures.append({"case": gen_case, "error": traceback.format_exc()})
+            report["differential"] = {"passed": diff_pass, "total": diff_total, "failures": diff_failures}
+    except Exception:
+        report["error"] = traceback.format_exc()
+    return json.dumps(report)
