--- /dev/null
+++ b/tools/run_examples.py
@@ -0,0 +1,179 @@
+"""Tool to run solution against examples defined in a JSON file.
+
+The JSON file should contain a list of objects with keys:
+    "input": either a list (positional args) or a dict (keyword args) for the solution call,
+    "expected": the expected output (any JSON-serializable value).
+
+For class‑based solutions the module is imported, a `Solution` instance is created, and the
+single public method (or the method named in the optional `method` argument) is invoked.
+For script‑based solutions the solution is executed with the input string on stdin.
+The tool returns a raw string describing each example's result, including any traceback
+or runtime information, without any further parsing.
+"""
+
+import importlib.util
+import json
+import subprocess
+import traceback
+import time
+from typing import Any, Dict, List
+
+
+def tool_info() -> Dict[str, Any]:
+    return {
+        "name": "run_examples",
+        "description": (
+            "Run the solution on a list of examples and compare the actual output with the expected one. "
+            "Supports both class‑based (Solution class) and script‑based solutions."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (e.g., solution.py)."
+                },
+                "examples_json_path": {
+                    "type": "string",
+                    "description": "Absolute path to a JSON file containing a list of {'input': ..., 'expected': ...} objects."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["auto", "class", "script"],
+                    "description": "Force mode: 'class' for Solution class, 'script' for stdin/stdout program, or 'auto' to detect automatically."
+                },
+                "method": {
+                    "type": "string",
+                    "description": "Name of the method to call when mode is 'class'. If omitted, the tool picks the sole public method of the Solution class."
+                }
+            },
+            "required": ["solution_path", "examples_json_path"]
+        }
+    }
+
+
+def _load_examples(path: str) -> List[Dict[str, Any]]:
+    with open(path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+    if not isinstance(data, list):
+        raise ValueError("Examples JSON must be a list.")
+    return data
+
+
+def _run_script(solution_path: str, input_data: str, timeout: int = 10) -> subprocess.CompletedProcess:
+    """Execute a Python script with given stdin and a timeout (seconds)."""
+    cmd = ["timeout", str(timeout), "python3", solution_path]
+    return subprocess.run(
+        cmd,
+        input=input_data,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+
+def _import_solution_module(solution_path: str):
+    spec = importlib.util.spec_from_file_location("solution_module", solution_path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {solution_path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)  # type: ignore
+    return module
+
+
+def _find_solution_method(module) -> Any:
+    # Identify a class named Solution
+    if not hasattr(module, "Solution"):
+        raise AttributeError("Module does not define a 'Solution' class.")
+    cls = getattr(module, "Solution")
+    instance = cls()
+    # Find public methods (not starting with _) and not built-in
+    public_methods = [
+        getattr(instance, name) for name in dir(instance)
+        if not name.startswith("_") and callable(getattr(instance, name))
+    ]
+    if len(public_methods) == 0:
+        raise AttributeError("Solution class has no public method.")
+    if len(public_methods) > 1:
+        raise AttributeError("Solution class has multiple public methods; specify 'method' argument.")
+    return public_methods[0]
+
+
+def tool_function(
+    solution_path: str,
+    examples_json_path: str,
+    mode: str = "auto",
+    method: str = None,
+) -> str:
+    """Run the solution against each example and report results.
+
+    Returns a raw multi‑line string containing a JSON‑like list of result objects:
+        {"input": ..., "expected": ..., "actual": ..., "traceback": ..., "runtime": ...}
+    """
+    results = []
+    examples = _load_examples(examples_json_path)
+    # Determine mode if auto
+    if mode == "auto":
+        try:
+            mod = _import_solution_module(solution_path)
+            if hasattr(mod, "Solution"):
+                mode = "class"
+            else:
+                mode = "script"
+        except Exception:
+            mode = "script"
+    # Prepare callable for class mode
+    class_callable = None
+    if mode == "class":
+        try:
+            mod = _import_solution_module(solution_path)
+            if method:
+                if not hasattr(mod.Solution, method):
+                    raise AttributeError(f"Method {method} not found in Solution class.")
+                class_callable = getattr(mod.Solution(), method)
+            else:
+                class_callable = _find_solution_method(mod)
+        except Exception as e:
+            return f"Error preparing class solution: {traceback.format_exc()}"
+
+    for idx, ex in enumerate(examples):
+        inp = ex.get("input")
+        expected = ex.get("expected")
+        start = time.time()
+        try:
+            if mode == "script":
+                stdin_data = inp if isinstance(inp, str) else json.dumps(inp)
+                proc = _run_script(solution_path, stdin_data)
+                if proc.returncode != 0:
+                    raise RuntimeError(f"Non-zero exit code {proc.returncode}: {proc.stderr}")
+                actual = proc.stdout.strip()
+            else:
+                # class mode
+                if isinstance(inp, dict):
+                    actual = class_callable(**inp)
+                elif isinstance(inp, list):
+                    actual = class_callable(*inp)
+                else:
+                    actual = class_callable(inp)
+        except Exception:
+            tb = traceback.format_exc()
+            runtime = time.time() - start
+            results.append({
+                "input": inp,
+                "expected": expected,
+                "actual": None,
+                "traceback": tb,
+                "runtime": runtime,
+                "error": True,
+            })
+            continue
+        runtime = time.time() - start
+        results.append({
+            "input": inp,
+            "expected": expected,
+            "actual": actual,
+            "traceback": None,
+            "runtime": runtime,
+            "error": False,
+        })
+    return json.dumps(results, indent=2, ensure_ascii=False)
