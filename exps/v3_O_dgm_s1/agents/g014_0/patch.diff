++    def forward(self):
++        """Run the multi‑phase agentic workflow.
++
++        The original implementation performed a single LLM call that was asked
++        to edit the repository and finish.  This often led to solutions that
++        passed the sample tests but failed on hidden cases (e.g. greedy
++        algorithms).  The updated workflow introduces an explicit verification
++        phase that:
++
++        1. Instructs the model to reason about the problem, generate a brute‑
++           force reference, a random input generator and a stress‑test script.
++        2. Executes the generated code (outside the repository) to compare the
++           current solution against the brute implementation on many random
++           small inputs.
++        3. If a mismatch is found, the model is asked to analyse the failure,
++           patch the solution and repeat until the stress test reports success.
++        4. Finally, a timing check on worst‑case inputs is performed to ensure
++           the algorithm meets the complexity constraints.
++
++        The verification step is performed via the generic ``stress_test`` tool
++        added in ``tools/stress_test.py``.  The second LLM call receives the
++        current repository diff as context and is explicitly asked to run the
++        tool, analyse its output and fix any issues.
++        """
++        # ------------------------------------------------------------------
++        # Phase 1 – initial problem solving
++        # ------------------------------------------------------------------
++        task = f"""I have uploaded a code repository in the directory {self.git_tempdir}. Help solve the following problem.
++
++<problem_description>
++{self.problem_statement}
++</problem_description>
++
++Your task is to make changes to the files in the {self.git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
++"""
++
++        # Detailed multi‑step instruction for the LLM
++        instruction = (
++            f"{task}\n\n"
++            "Please follow these steps:\n"
++            "1. Analyse the problem, constraints and think of possible edge cases.\n"
++            "2. If a greedy or heuristic approach is considered, try to construct a counter‑example manually before implementing it.\n"
++            "3. Implement the solution in the repository.\n"
++            "4. Also create three auxiliary scripts *outside* the repository (e.g., in /tmp):\n"
++            "   - a brute‑force reference implementation (e.g., /tmp/brute.py),\n"
++            "   - a random small‑input generator (e.g., /tmp/gen.py) that writes a test case to stdout and accepts a seed integer argument,\n"
++            "   - a driver that can be used by the stress_test tool (the tool itself will invoke the generator and both solutions).\n"
++            "5. Do NOT trust the greedy solution without proof; the stress testing phase will validate it.\n"
++            "6. After editing, ensure the auxiliary files are cleaned up or placed outside the git repo.\n"
++            "7. Once the code is ready, respond only with the edits (the system will capture them)."
++        )
++        # First LLM interaction – let the agent create/modify files.
++        init_edit = chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
++
++        # ------------------------------------------------------------------
++        # Phase 2 – verification via stress testing
++        # ------------------------------------------------------------------
++        # Obtain the current diff to give the model context about what it has
++        # changed so far.
++        diff_msg = self.get_current_edits()
++
++        verification_prompt = (
++            "Now verify the correctness of the solution you just wrote.\n"
++            "Use the provided auxiliary scripts (brute, generator) and the generic\n"
++            "`stress_test` tool (name: stress_test) to compare the solution against the\n"
++            "brute‑force implementation on many random small inputs.\n"
++            "If the tool reports a mismatch, edit the solution (or the algorithm) to fix it,\n"
++            "re‑run the stress test, and repeat until the tool returns a success message.\n"
++            "Finally, run a timing test on a worst‑case sized input (you may generate it\n"
++            "with the same generator using a large seed) to ensure the solution runs within\n"
++            "reasonable time limits.  When everything passes, respond with a short\n"
++            "confirmation message."
++        )
++        # Second LLM interaction – the agent should invoke the stress_test tool.
++        _ = chat_with_agent(
++            verification_prompt,
++            model=self.code_model,
++            msg_history=diff_msg,
++            logging=safe_log,
++        )
