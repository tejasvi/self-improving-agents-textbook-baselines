diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..fe7fef5
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,102 @@
+import subprocess
+import os
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": "Run a solution against .in/.out sample pairs and report PASS/FAIL for each.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution python file to execute."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing *.in and matching *.out files."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds to allow each run."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    # Collapse all whitespace to single spaces and strip
+    return " ".join(text.strip().split())
+
+
+def tool_function(solution_path: str, samples_dir: str, timeout: int = 10) -> str:
+    """Execute the solution on each sample input and compare with expected output.
+
+    Returns a raw multiline report containing PASS/FAIL for each sample, the
+    input, expected output, actual output and any stderr.
+    """
+    sol_path = Path(solution_path)
+    samp_dir = Path(samples_dir)
+    if not sol_path.is_file():
+        return f"Error: solution_path {solution_path} does not exist or is not a file"
+    if not samp_dir.is_dir():
+        return f"Error: samples_dir {samples_dir} does not exist or is not a directory"
+
+    # Find all .in files
+    in_files = sorted(samp_dir.glob("*.in"))
+    if not in_files:
+        return "No .in sample files found in the directory."
+
+    reports = []
+    for in_file in in_files:
+        base = in_file.stem
+        out_file = samp_dir / f"{base}.out"
+        if not out_file.is_file():
+            reports.append(f"Sample {base}: Missing .out file.")
+            continue
+        try:
+            input_data = in_file.read_text()
+        except Exception as e:
+            reports.append(f"Sample {base}: Error reading input file: {e}")
+            continue
+        try:
+            expected = out_file.read_text()
+        except Exception as e:
+            reports.append(f"Sample {base}: Error reading output file: {e}")
+            continue
+        try:
+            completed = subprocess.run(
+                ["python3", str(sol_path)],
+                input=input_data,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            actual = completed.stdout
+            stderr = completed.stderr
+            retcode = completed.returncode
+        except subprocess.TimeoutExpired:
+            reports.append(
+                f"Sample {base}: FAIL (timeout after {timeout}s)\nInput:\n{input_data}\nExpected:\n{expected}\nActual:\n<no output>\nStderr:\nTimeout"
+            )
+            continue
+        except Exception as e:
+            reports.append(
+                f"Sample {base}: FAIL (exception {e})\nInput:\n{input_data}\nExpected:\n{expected}\nActual:\n<no output>\nStderr:\n{e}"
+            )
+            continue
+        norm_actual = _normalize(actual)
+        norm_expected = _normalize(expected)
+        if retcode != 0:
+            # treat non-zero as failure but still report
+            status = "FAIL"
+        else:
+            status = "PASS" if norm_actual == norm_expected else "FAIL"
+        reports.append(
+            f"Sample {base}: {status}\nInput:\n{input_data}\nExpected:\n{expected}\nActual:\n{actual}\nStderr:\n{stderr}"
+        )
+    return "\n---\n".join(reports)
