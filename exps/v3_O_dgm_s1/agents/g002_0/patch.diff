+def _run_command(command: str, timeout: float = 120.0) -> tuple[str, str]:
+    """Execute *command* in a bash subshell.
+    Returns a tuple ``(stdout, stderr)`` with stripped whitespace.
+    If the command exceeds *timeout* seconds, returns ``("", "Timed out after {timeout} seconds")``.
+    """
+    try:
+        completed = subprocess.run(
+            command,
+            shell=True,
+            executable="/bin/bash",
+            cwd=os.getcwd(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=timeout,
+            env=os.environ.copy()
+        )
+        return completed.stdout.strip(), completed.stderr.strip()
+    except subprocess.TimeoutExpired:
+        return "", f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return "", str(e)
+
+def tool_function(command: str) -> str:
+    """Public entry point used by the agent framework.
+    Returns combined output and error string, matching the original contract.
+    """
+    out, err = _run_command(command)
+    if err:
+        return f"{out}\nError:\n{err}" if out else f"Error:\n{err}"
+    return out
