++    def _run_sample_check(self):
++        """Run the ``run_samples`` tool on the current solution and return its report string.
++
++        The original implementation treated the *absence* of sample blocks in the problem
++        statement as a failure because ``run_samples`` returns the message
++        ``"No sample inputs/outputs could be parsed from the problem statement."``.  The
++        ``forward`` loop interprets any report that does **not** contain the word ``"PASS"``
++        as a failure and consequently retries editing the solution indefinitely.  For
++        problems that legitimately have no examples, this leads to an endless loop.
++
++        To make the system robust we intercept the special‑case message and convert it
++        into a benign "PASS" report.  This keeps the existing forward‑loop logic
++        unchanged while ensuring that a missing sample set is treated as a successful
++        verification step.
++        """
++        try:
++            # Import the tool lazily to avoid circular imports
++            from tools.run_samples import tool_function as run_samples_fn
++        except Exception as e:
++            return f"Error importing run_samples tool: {e}"
++
++        # Determine solution path: look for a modified .py file via diff, fallback to
++        # ``solution.py`` in the repository root.
++        diff_text = str(diff_versus_commit(self.git_tempdir, self.base_commit))
++        solution_path = None
++        for line in diff_text.splitlines():
++            if line.startswith('+++ b/') and line.endswith('.py'):
++                # ``+++ b/relative/path.py`` – extract the relative part.
++                rel = line[len('+++ b/') :]
++                solution_path = os.path.join(self.git_tempdir, rel)
++                break
++        if not solution_path:
++            solution_path = os.path.join(self.git_tempdir, 'solution.py')
++
++        if not os.path.exists(solution_path):
++            # The repository does not yet contain a solution file – the caller will be
++            # prompted to create one.
++            return 'solution file missing - create it'
++
++        # Run the sample checker.
++        report = run_samples_fn(
++            solution_path=solution_path,
++            problem_statement=self.problem_statement,
++            timeout_seconds=5,
++        )
++
++        # ``run_samples`` returns a specific message when no samples are found.  Convert
++        # that into a PASS‑like report so the forward loop can continue.
++        if "No sample inputs/outputs could be parsed" in report:
++            return (
++                "No sample inputs/outputs could be parsed from the problem statement. "
++                "Assuming correctness – PASS"
++            )
++        return report
