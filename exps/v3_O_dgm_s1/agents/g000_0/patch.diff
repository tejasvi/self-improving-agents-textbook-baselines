diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..d2c057f
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,140 @@
+import subprocess
+import os
+import sys
+import random
+from typing import List
+
+
+def tool_info():
+    """Return the tool specification for the stress test tool.
+
+    The tool runs a generator to produce inputs, then executes both a candidate
+    implementation and a brute‑force reference implementation on each generated
+    input. It reports the first mismatch or a success message.
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run differential stress testing between a candidate solution and a brute‑force reference using a supplied generator.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidate_path": {
+                    "type": "string",
+                    "description": "Filesystem path to the candidate solution script (e.g., solution.py)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Filesystem path to the brute‑force reference implementation script."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Filesystem path to a generator script that writes a single test case to stdout. It should accept an optional integer seed as its first argument."
+                },
+                "num_trials": {
+                    "type": "integer",
+                    "description": "Number of random trials to perform."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Maximum number of seconds allowed for each solution run."
+                }
+            },
+            "required": ["candidate_path", "brute_path", "generator_path", "num_trials", "timeout_seconds"]
+        }
+    }
+
+
+def _run_script(script_path: str, input_data: str, timeout: int) -> str:
+    """Execute a Python script with the given input and return its stdout.
+
+    Args:
+        script_path: Path to the script to execute.
+        input_data: String to feed to the script's stdin.
+        timeout: Maximum execution time in seconds.
+
+    Returns:
+        The stripped standard output of the script.
+    """
+    if not os.path.isfile(script_path):
+        raise FileNotFoundError(f"Script not found: {script_path}")
+    result = subprocess.run(
+        [sys.executable, script_path],
+        input=input_data.encode(),
+        capture_output=True,
+        timeout=timeout,
+        check=False,
+    )
+    return result.stdout.decode(errors="ignore").strip()
+
+
+def _generate_input(generator_path: str, seed: int) -> str:
+    """Run the generator script with a seed and return its stdout as the test input.
+    """
+    if not os.path.isfile(generator_path):
+        raise FileNotFoundError(f"Generator script not found: {generator_path}")
+    result = subprocess.run(
+        [sys.executable, generator_path, str(seed)],
+        capture_output=True,
+        timeout=30,
+        check=False,
+    )
+    return result.stdout.decode(errors="ignore")
+
+
+def tool_function(candidate_path: str, brute_path: str, generator_path: str, num_trials: int, timeout_seconds: int) -> str:
+    """Perform stress testing.
+
+    Returns a description of the first failing case or a success message.
+    """
+    if num_trials <= 0:
+        return "Error: num_trials must be a positive integer."
+    if timeout_seconds <= 0:
+        return "Error: timeout_seconds must be a positive integer."
+
+    for i in range(1, num_trials + 1):
+        seed = random.randint(0, 1_000_000_000)
+        try:
+            test_input = _generate_input(generator_path, seed)
+        except Exception as e:
+            return f"Error while generating input on trial {i}: {e}"
+
+        try:
+            cand_out = _run_script(candidate_path, test_input, timeout_seconds)
+        except subprocess.TimeoutExpired:
+            return f"Candidate solution timed out on trial {i} (seed {seed})."
+        except Exception as e:
+            return f"Error running candidate solution on trial {i} (seed {seed}): {e}"
+
+        try:
+            brute_out = _run_script(brute_path, test_input, timeout_seconds)
+        except subprocess.TimeoutExpired:
+            return f"Brute‑force reference timed out on trial {i} (seed {seed})."
+        except Exception as e:
+            return f"Error running brute‑force reference on trial {i} (seed {seed}): {e}"
+
+        if cand_out != brute_out:
+            return (
+                f"Counterexample found on trial {i} (seed {seed}):\n"
+                f"Input:\n{test_input}\n"
+                f"Candidate Output:\n{cand_out}\n"
+                f"Brute‑force Output:\n{brute_out}"
+            )
+    return f"All {num_trials} trials passed. No differences found between candidate and brute‑force implementations."
+
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser(description="Run stress_test tool from command line.")
+    parser.add_argument("candidate_path")
+    parser.add_argument("brute_path")
+    parser.add_argument("generator_path")
+    parser.add_argument("--num_trials", type=int, default=100)
+    parser.add_argument("--timeout_seconds", type=int, default=5)
+    args = parser.parse_args()
+    print(tool_function(
+        args.candidate_path,
+        args.brute_path,
+        args.generator_path,
+        args.num_trials,
+        args.timeout_seconds,
+    ))
