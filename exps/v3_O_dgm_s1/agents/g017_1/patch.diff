diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..e217e31
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,87 @@
+import re
+import subprocess
+import os
+from typing import List, Tuple
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": "Run the solution against all sample input/output pairs extracted from the problem statement.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_statement": {
+                    "type": "string",
+                    "description": "Full problem statement containing Sample Input/Output sections."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script to execute. Defaults to '<repo>/solution.py'."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds to allow each sample execution."
+                }
+            },
+            "required": ["problem_statement"]
+        }
+    }
+
+def _extract_samples(problem: str) -> List[Tuple[str, str]]:
+    """Extract (input, output) pairs from the problem statement.
+    Supports patterns like:
+    Sample Input 1\n<...>\nSample Output 1\n<...>
+    Returns a list of tuples.
+    """
+    pattern = re.compile(
+        r"Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\Z|\n\s*Do not|\n\s*##)",
+        re.DOTALL | re.IGNORECASE,
+    )
+    samples = []
+    for match in pattern.finditer(problem):
+        inp = match.group(2).strip('\n')
+        outp = match.group(3).strip('\n')
+        samples.append((inp, outp))
+    return samples
+
+def _run_solution(solution_path: str, sample_input: str, timeout: int) -> Tuple[str, str, int]:
+    """Run solution with given input, return stdout, stderr, returncode."""
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=sample_input,
+            text=True,
+            capture_output=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode
+    except subprocess.TimeoutExpired:
+        return "", f"Timeout after {timeout}s", -1
+    except Exception as e:
+        return "", f"Error: {str(e)}", -1
+
+def _normalize(text: str) -> str:
+    """Normalize whitespace for comparison: strip, collapse spaces, keep line breaks."""
+    lines = [" ".join(line.strip().split()) for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+def tool_function(problem_statement: str, solution_path: str = None, timeout: int = 10) -> str:
+    """Execute the solution against all samples and return a raw report.
+    The report contains lines like:
+    PASS/FAIL, Input, Expected, Actual, Stderr per sample.
+    """
+    if solution_path is None:
+        solution_path = os.path.join(os.getcwd(), "solution.py")
+    samples = _extract_samples(problem_statement)
+    if not samples:
+        return "No samples found in problem statement."
+    report_parts = []
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        stdout, stderr, rc = _run_solution(solution_path, inp, timeout)
+        norm_out = _normalize(stdout)
+        norm_exp = _normalize(expected)
+        status = "PASS" if rc == 0 and norm_out == norm_exp else "FAIL"
+        report_parts.append(
+            f"Sample {idx}: {status}\nInput:\n{inp}\nExpected:\n{expected}\nActual:\n{stdout}\nStderr:\n{stderr}\n"
+        )
+    return "\n".join(report_parts)
