@@ -0,0 +1,115 @@
+import re
+import subprocess
+import tempfile
+import os
+import time
+import shutil
+from typing import Optional
+
+def tool_info():
+    """Return the metadata for the run_samples tool."""
+    return {
+        "name": "run_samples",
+        "description": (
+            "Parse sample test cases from a problem statement and run the solution script on each. "
+            "Returns a raw text report for every sample, including status, input, expected, actual, "
+            "stderr and elapsed time."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_text": {
+                    "type": "string",
+                    "description": "Full problem statement containing sample input/output blocks."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution script (e.g., solution.py)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum time in seconds allowed for each run.",
+                    "default": 10
+                }
+            },
+            "required": ["problem_text", "solution_path"]
+        }
+    }
+
+def _run_solution(solution_path: str, input_data: str, timeout: int) -> subprocess.CompletedProcess:
+    """Execute the solution script with given input and timeout.
+
+    Returns the CompletedProcess object.
+    """
+    # Prefer external `timeout` command for consistency with other tools.
+    if shutil.which("timeout"):
+        cmd = ["timeout", str(timeout), "python3", solution_path]
+        return subprocess.run(
+            cmd,
+            input=input_data,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            # When using the external timeout command we let it handle the timeout.
+            timeout=None,
+        )
+    else:
+        # Fallback to subprocess timeout parameter.
+        cmd = ["python3", solution_path]
+        return subprocess.run(
+            cmd,
+            input=input_data,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=timeout,
+        )
+
+def tool_function(problem_text: str, solution_path: str, timeout: int = 10) -> str:
+    """Parse samples from ``problem_text`` and run ``solution_path`` on each.
+
+    The function returns a concatenated raw report for all samples.
+    """
+    # Regex to capture Sample Input N / Sample Output N blocks.
+    pattern = re.compile(r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n\s*##|\Z)', re.S)
+    matches = pattern.findall(problem_text)
+    if not matches:
+        return "No sample inputs/outputs found in problem statement."
+
+    reports = []
+    for idx, (num, inp, outp) in enumerate(matches, start=1):
+        # Ensure input ends with a newline for programs expecting it.
+        if not inp.endswith("\n"):
+            inp += "\n"
+        try:
+            start = time.time()
+            proc = _run_solution(solution_path, inp, timeout)
+            elapsed = time.time() - start
+            if proc.returncode != 0:
+                status = "crashed"
+            else:
+                actual = proc.stdout.rstrip("\n")
+                expected = outp.rstrip("\n")
+                if actual == expected:
+                    status = "exact match"
+                elif actual.strip() == expected.strip():
+                    status = "whitespace-insensitive match"
+                else:
+                    status = "differs"
+        except subprocess.TimeoutExpired:
+            status = "timed out"
+            proc = None
+            elapsed = timeout
+        report_lines = [
+            f"Sample {idx} (Sample {num}):",
+            f"Status: {status}",
+            f"Elapsed: {elapsed:.3f}s",
+            f"Input:\n{inp}",
+            f"Expected Output:\n{outp}",
+        ]
+        if proc is not None:
+            report_lines.append(f"Actual Output:\n{proc.stdout}")
+            if proc.stderr:
+                report_lines.append(f"Stderr:\n{proc.stderr}")
+        reports.append("\n".join(report_lines))
+    return "\n\n".join(reports)
