diff --git a/tools/run_solution_tests.py b/tools/run_solution_tests.py
new file mode 100644
index 0000000..be86dc5
--- /dev/null
+++ b/tools/run_solution_tests.py
@@ -0,0 +1,234 @@
+import importlib.util
+import json
+import os
+import subprocess
+import sys
+import traceback
+import copy
+import time
+from typing import Any, Dict, List
+
+
+def tool_info():
+    """Return metadata for the run_solution_tests tool."""
+    return {
+        "name": "run_solution_tests",
+        "description": "Execute a Python Solution class method against provided sample tests, a brute‑force reference, or randomly generated inputs, and report detailed results.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate solution file (containing a Solution class)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to a brute‑force reference implementation (also a Solution class).",
+                    "default": ""
+                },
+                "samples_path": {
+                    "type": "string",
+                    "description": "Path to a JSON file containing a list of {\"args\": [...], \"expected\": ...} objects.",
+                    "default": ""
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to a generator script that writes a JSON representation of arguments to stdout. Used for differential testing.",
+                    "default": ""
+                },
+                "num_trials": {
+                    "type": "integer",
+                    "description": "Number of random trials to run when using a generator.",
+                    "default": 0
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each execution of the solution.",
+                    "default": 5
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method on the Solution class to invoke (e.g., 'solve').",
+                    "default": "solve"
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _load_solution_module(path: str) -> Any:
+    """Load a Python file as a module, injecting common typing names to avoid missing imports."""
+    if not os.path.isfile(path):
+        raise FileNotFoundError(f"Solution file not found: {path}")
+    spec = importlib.util.spec_from_file_location("solution_mod", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Could not load spec for {path}")
+    module = importlib.util.module_from_spec(spec)
+    # Inject typing symbols so solution can use List, Optional, etc.
+    typing_globals: Dict[str, Any] = {}
+    exec('from typing import *', typing_globals)
+    module.__dict__.update(typing_globals)
+    # Execute the module code
+    spec.loader.exec_module(module)  # type: ignore
+    return module
+
+
+def _run_method(module: Any, method_name: str, args: List[Any]) -> Any:
+    """Instantiate Solution from module and invoke the specified method with args."""
+    if not hasattr(module, "Solution"):
+        raise AttributeError("Module does not define a 'Solution' class.")
+    sol_instance = module.Solution()
+    if not hasattr(sol_instance, method_name):
+        raise AttributeError(f"Solution class has no method '{method_name}'.")
+    method = getattr(sol_instance, method_name)
+    return method(*args)
+
+
+def _run_subprocess(solution_path: str, input_data: str, timeout: int) -> Dict[str, Any]:
+    """Fallback: run solution as a script reading from stdin/stdout."""
+    try:
+        result = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_data.encode(),
+            capture_output=True,
+            timeout=timeout,
+        )
+        return {
+            "stdout": result.stdout.decode(errors="ignore"),
+            "stderr": result.stderr.decode(errors="ignore"),
+            "error": "" if result.returncode == 0 else f"Non-zero exit code {result.returncode}",
+        }
+    except subprocess.TimeoutExpired:
+        return {"stdout": "", "stderr": "", "error": f"Execution timed out after {timeout}s"}
+    except Exception as e:
+        return {"stdout": "", "stderr": "", "error": f"Execution error: {e}"}
+
+
+def tool_function(
+    solution_path: str,
+    brute_path: str = "",
+    samples_path: str = "",
+    gen_path: str = "",
+    num_trials: int = 0,
+    timeout_seconds: int = 5,
+    method_name: str = "solve",
+) -> str:
+    """Run the candidate solution against tests and return a JSON report.
+
+    The function prefers the following order:
+    1. If ``samples_path`` points to a valid JSON file, run those samples.
+    2. Else if ``gen_path`` and ``brute_path`` are provided, perform differential testing for ``num_trials`` trials.
+    3. Otherwise fall back to a simple stdin/stdout execution.
+    """
+    report: Dict[str, Any] = {
+        "passed": 0,
+        "failed": 0,
+        "failures": [],
+        "timings": [],
+        "mode": "",
+    }
+
+    def _load_samples(file_path: str) -> List[Dict[str, Any]]:
+        with open(file_path, "r", encoding="utf-8") as f:
+            data = json.load(f)
+        if not isinstance(data, list):
+            raise ValueError("Samples JSON must be a list of objects.")
+        return data
+
+    # 1. Sample based testing
+    if samples_path and os.path.isfile(samples_path):
+        report["mode"] = "samples"
+        try:
+            samples = _load_samples(samples_path)
+        except Exception as e:
+            return json.dumps({"error": f"Failed to load samples: {e}"})
+        try:
+            sol_mod = _load_solution_module(solution_path)
+        except Exception as e:
+            return json.dumps({"error": f"Failed to load solution: {e}"})
+        for entry in samples:
+            args = entry.get("args", [])
+            expected = entry.get("expected")
+            start = time.time()
+            try:
+                actual = _run_method(sol_mod, method_name, copy.deepcopy(args))
+                passed = actual == expected
+                err_msg = ""
+            except Exception as exc:
+                actual = None
+                passed = False
+                err_msg = "".join(traceback.format_exception_only(type(exc), exc))
+            duration = time.time() - start
+            report["timings"].append(duration)
+            if passed:
+                report["passed"] += 1
+            else:
+                report["failed"] += 1
+                report["failures"].append({
+                    "input": args,
+                    "expected": expected,
+                    "actual": actual,
+                    "error": err_msg,
+                })
+        return json.dumps(report, indent=2)
+
+    # 2. Differential testing using generator and brute force
+    if gen_path and brute_path and os.path.isfile(gen_path) and os.path.isfile(brute_path) and num_trials > 0:
+        report["mode"] = "differential"
+        try:
+            sol_mod = _load_solution_module(solution_path)
+            brute_mod = _load_solution_module(brute_path)
+        except Exception as e:
+            return json.dumps({"error": f"Failed to load modules: {e}"})
+        for trial in range(num_trials):
+            # Run generator script; it should output JSON representation of args list
+            try:
+                gen_res = subprocess.run(
+                    [sys.executable, gen_path, str(trial)],
+                    capture_output=True,
+                    timeout=timeout_seconds,
+                )
+                gen_out = gen_res.stdout.decode().strip()
+                args = json.loads(gen_out)
+                if not isinstance(args, list):
+                    args = [args]
+            except Exception as e:
+                report["failed"] += 1
+                report["failures"].append({"input": "generator error", "error": str(e)})
+                continue
+            start = time.time()
+            try:
+                sol_out = _run_method(sol_mod, method_name, copy.deepcopy(args))
+                brute_out = _run_method(brute_mod, method_name, copy.deepcopy(args))
+                passed = sol_out == brute_out
+                err_msg = ""
+            except Exception as exc:
+                sol_out = None
+                brute_out = None
+                passed = False
+                err_msg = "".join(traceback.format_exception_only(type(exc), exc))
+            duration = time.time() - start
+            report["timings"].append(duration)
+            if passed:
+                report["passed"] += 1
+            else:
+                report["failed"] += 1
+                report["failures"].append({
+                    "input": args,
+                    "expected": brute_out,
+                    "actual": sol_out,
+                    "error": err_msg,
+                })
+        return json.dumps(report, indent=2)
+
+    # 3. Fallback: run as script with empty stdin
+    report["mode"] = "fallback"
+    try:
+        res = _run_subprocess(solution_path, "", timeout_seconds)
+        report["stdout"] = res["stdout"]
+        report["stderr"] = res["stderr"]
+        report["error"] = res["error"]
+    except Exception as e:
+        report["error"] = f"Fallback execution error: {e}"
+    return json.dumps(report, indent=2)
