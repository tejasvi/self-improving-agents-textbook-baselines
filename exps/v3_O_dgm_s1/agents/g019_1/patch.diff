@@ -0,0 +1,98 @@
+import importlib.util
+import traceback
+import json
+import os
+
+def tool_info():
+    """Return metadata for the run_class_tests tool.
+
+    This tool allows the agent to test a Solution class implementation by
+    providing a list of test cases, each consisting of a tuple of arguments and the
+    expected return value.
+    """
+    return {
+        "name": "run_class_tests",
+        "description": "Import a solution module, instantiate a class, invoke a method with supplied arguments, and compare with expected results. Returns a raw pass/fail report.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "module_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python module that defines the Solution class."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the Solution class to instantiate."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on the Solution instance."
+                },
+                "tests": {
+                    "type": "array",
+                    "description": "List of test cases. Each test case is an object with \"args\" (array) and \"expected\" (any JSON-serializable value).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "args": {
+                                "type": "array",
+                                "description": "Positional arguments to pass to the method."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "JSON string of the expected result."
+                            }
+                        },
+                        "required": ["args", "expected"]
+                    }
+                }
+            },
+            "required": ["module_path", "class_name", "method_name", "tests"]
+        }
+    }
+
+def _load_module_from_path(module_path: str):
+    spec = importlib.util.spec_from_file_location("solution_module", module_path)
+    if spec is None:
+        raise ImportError(f"Cannot find module at {module_path}")
+    module = importlib.util.module_from_spec(spec)
+    loader = spec.loader
+    if loader is None:
+        raise ImportError(f"No loader for module at {module_path}")
+    loader.exec_module(module)
+    return module
+
+def tool_function(module_path: str, class_name: str, method_name: str, tests):
+    """Run the supplied test cases against the specified class method.
+
+    Returns a string summarizing passed/failed cases and any traceback information.
+    """
+    try:
+        module = _load_module_from_path(module_path)
+        cls = getattr(module, class_name)
+        instance = cls()
+        method = getattr(instance, method_name)
+    except Exception as e:
+        return f"Error loading class or method: {traceback.format_exc()}"
+
+    passed = 0
+    total = len(tests)
+    reports = []
+    for idx, case in enumerate(tests, start=1):
+        args = case.get('args', [])
+        expected_json = case.get('expected')
+        try:
+            expected = json.loads(expected_json)
+        except Exception:
+            expected = expected_json  # fallback to raw string
+        try:
+            result = method(*args)
+            if result == expected:
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+            else:
+                reports.append(f"Test {idx}: FAIL (args={args}) Expected={expected} Got={result}")
+        except Exception:
+            reports.append(f"Test {idx}: EXCEPTION (args={args})\n{traceback.format_exc()}")
+    summary = f"{passed}/{total} tests passed.\n" + "\n".join(reports)
+    return summary
