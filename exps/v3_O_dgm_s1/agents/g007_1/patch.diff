+    def _changed_files(self):
+        """Return a list of changed file paths relative to git_tempdir.
+        Includes both tracked changes since base_commit and untracked files.
+        """
+        # Tracked changes
+        tracked = []
+        diff_cmd = ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit]
+        result = subprocess.run(diff_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        if result.returncode == 0:
+            tracked = [p for p in result.stdout.splitlines() if p]
+        # Untracked files
+        untracked_cmd = ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]
+        result2 = subprocess.run(untracked_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+        untracked = [p for p in result2.stdout.splitlines() if p]
+        return tracked + untracked
+
+    def _is_test_file(self, path):
+        """Determine if a given file path (relative) is a test file using common patterns."""
+        test_patterns = [
+            r"tests?/", r"test_.*\\.py$", r".*_test\\.py$", r"conftest\\.py$",
+            r".*\\.spec\\.js$", r".*_test\\.go$", r".*_test\\.java$",
+        ]
+        for pat in test_patterns:
+            if re.search(pat, path, re.IGNORECASE):
+                return True
+        return False
+
+    def _has_source_edit(self):
+        """Return True if any changed file is NOT a test file."""
+        for f in self._changed_files():
+            if not self._is_test_file(f):
+                return True
+        return False
