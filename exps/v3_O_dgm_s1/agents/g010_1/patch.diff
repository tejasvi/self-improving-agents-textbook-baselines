diff --git a/tools/run_solution.py b/tools/run_solution.py
new file mode 100644
index 0000000..e9a35a6
--- /dev/null
+++ b/tools/run_solution.py
@@ -0,0 +1,130 @@
+import subprocess
+import time
+import json
+import os
+from typing import Optional
+
+def tool_info():
+    """Return the JSON schema describing the run_solution tool.
+
+    The tool executes a Python solution file with optional input from a string or a file.
+    It can also compare the output to an expected output and report a diff.
+    """
+    return {
+        "name": "run_solution",
+        "description": "Run a Python solution script on given input and optionally compare against expected output.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to execute."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "Input to feed to the program via stdin as a raw string. Optional if input_path is provided."
+                },
+                "input_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the input. Optional if input_text is provided."
+                },
+                "expected_output": {
+                    "type": "string",
+                    "description": "The expected output to compare against. If provided, a PASS/FAIL result and diff are returned."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum number of seconds to allow the solution to run. Defaults to 10.",
+                    "default": 10
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+def _read_input(input_text: Optional[str], input_path: Optional[str]) -> bytes:
+    """Return the bytes to be used as stdin for the subprocess.
+    Preference is given to input_text if both are provided.
+    """
+    if input_text is not None:
+        return input_text.encode()
+    if input_path is not None:
+        with open(input_path, "rb") as f:
+            return f.read()
+    return b""
+
+def _tokenize(s: str):
+    """Simple whitespace tokenization for output comparison."""
+    return s.strip().split()
+
+def tool_function(
+    solution_path: str,
+    input_text: Optional[str] = None,
+    input_path: Optional[str] = None,
+    expected_output: Optional[str] = None,
+    timeout: int = 10,
+) -> str:
+    """Execute the Python solution and optionally compare its output.
+
+    Returns a JSON string containing:
+        stdout, stderr, return_code, runtime (seconds)
+    If expected_output is supplied, also includes:
+        result ("PASS" or "FAIL") and diff (unified diff string, may be empty).
+    The function does **not** raise exceptions; all errors are captured in the JSON output.
+    """
+    result = {
+        "stdout": "",
+        "stderr": "",
+        "return_code": None,
+        "runtime": None,
+    }
+    try:
+        if not os.path.isabs(solution_path):
+            raise ValueError("solution_path must be an absolute path.")
+        if not os.path.isfile(solution_path):
+            raise ValueError(f"Solution file not found: {solution_path}")
+        stdin_bytes = _read_input(input_text, input_path)
+        start = time.time()
+        completed = subprocess.run(
+            ["python3", solution_path],
+            input=stdin_bytes,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+        elapsed = time.time() - start
+        result["stdout"] = completed.stdout.decode(errors="replace")
+        result["stderr"] = completed.stderr.decode(errors="replace")
+        result["return_code"] = completed.returncode
+        result["runtime"] = round(elapsed, 3)
+        if expected_output is not None:
+            actual_tokens = _tokenize(result["stdout"])\
+            expected_tokens = _tokenize(expected_output)
+            if actual_tokens == expected_tokens:
+                result["result"] = "PASS"
+                result["diff"] = ""
+            else:
+                import difflib
+                diff = difflib.unified_diff(
+                    expected_output.splitlines(keepends=True),
+                    result["stdout"].splitlines(keepends=True),
+                    fromfile="expected",
+                    tofile="actual",
+                )
+                result["result"] = "FAIL"
+                result["diff"] = "".join(diff)
+    except subprocess.TimeoutExpired:
+        result["stderr"] = f"Timeout after {timeout} seconds"
+        result["return_code"] = -1
+        result["runtime"] = timeout
+        if expected_output is not None:
+            result["result"] = "FAIL"
+            result["diff"] = ""
+    except Exception as e:
+        result["stderr"] = f"Error: {str(e)}"
+        result["return_code"] = -1
+        result["runtime"] = 0
+        if expected_output is not None:
+            result["result"] = "FAIL"
+            result["diff"] = ""
+    return json.dumps(result)
