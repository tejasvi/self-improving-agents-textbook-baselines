diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..ab2bea8
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,133 @@
+import re
+import subprocess
+import os
+from typing import List, Tuple
+
+
+def tool_info():
+    """Return tool metadata for the run_samples tool."""
+    return {
+        "name": "run_samples",
+        "description": "Run solution against sample inputs extracted from a problem statement and report pass/fail for each.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to execute."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "Full text of the problem statement containing sample input/output blocks."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each run of the solution.",
+                    "default": 5
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+
+def _extract_samples(problem: str) -> List[Tuple[str, str]]:
+    """Extract (input, output) sample pairs from the problem statement.
+    Supports variations like "Sample Input 1", "Input:", "Example", etc.
+    Returns a list of tuples. If nothing is found, returns an empty list.
+    """
+    samples: List[Tuple[str, str]] = []
+    # Normalize line endings
+    prob = problem.replace('\r\n', '\n')
+
+    # Regex pattern for blocks like "Sample Input 1" followed by text then "Sample Output 1"
+    pattern = re.compile(
+        r"Sample Input\s*\d*\s*[:\n]+(?P<input>.*?)(?=\n\s*Sample Output|\Z)",
+        re.IGNORECASE | re.DOTALL,
+    )
+    # Find all inputs first
+    inputs = []
+    for m in pattern.finditer(prob):
+        inputs.append(m.group('input').strip())
+    # Corresponding outputs
+    out_pattern = re.compile(
+        r"Sample Output\s*\d*\s*[:\n]+(?P<output>.*?)(?=\n\s*Sample Input|\Z)",
+        re.IGNORECASE | re.DOTALL,
+    )
+    outputs = []
+    for m in out_pattern.finditer(prob):
+        outputs.append(m.group('output').strip())
+
+    # Pair them by order
+    for i in range(min(len(inputs), len(outputs))):
+        samples.append((inputs[i], outputs[i]))
+
+    # Fallback: look for generic "Input:" / "Output:" sections (often a single example)
+    if not samples:
+        generic_pat = re.compile(
+            r"Input\s*[:\n]+(?P<input>.*?)(?=\n\s*Output|\Z)",
+            re.IGNORECASE | re.DOTALL,
+        )
+        generic_out_pat = re.compile(
+            r"Output\s*[:\n]+(?P<output>.*?)(?=\n\s*Input|\Z)",
+            re.IGNORECASE | re.DOTALL,
+        )
+        gen_in = generic_pat.search(prob)
+        gen_out = generic_out_pat.search(prob)
+        if gen_in and gen_out:
+            samples.append((gen_in.group('input').strip(), gen_out.group('output').strip()))
+    return samples
+
+
+def _run_one(solution_path: str, inp: str, timeout: int) -> Tuple[str, str, str]:
+    """Run the solution with given input, return (stdout, stderr, error_msg)."""
+    if not os.path.isfile(solution_path):
+        return "", "", f"Solution file not found: {solution_path}"
+    try:
+        result = subprocess.run(
+            ["python3", solution_path],
+            input=inp.encode(),
+            capture_output=True,
+            timeout=timeout,
+        )
+        out = result.stdout.decode(errors="ignore")
+        err = result.stderr.decode(errors="ignore")
+        return out, err, ""
+    except subprocess.TimeoutExpired:
+        return "", "", f"Execution timed out after {timeout} seconds"
+    except Exception as e:
+        return "", "", f"Execution error: {e}"
+
+
+def tool_function(solution_path: str, problem_statement: str, timeout_seconds: int = 5) -> str:
+    """Execute the solution against extracted samples and report results.
+    The report contains PASS/FAIL for each sample together with the input,
+    expected output, actual output and any stderr.
+    """
+    samples = _extract_samples(problem_statement)
+    if not samples:
+        return "No sample inputs/outputs could be parsed from the problem statement."
+
+    report_lines = []
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        actual, stderr, err_msg = _run_one(solution_path, inp, timeout_seconds)
+        # Normalise whitespace for comparison
+        norm_actual = " ".join(actual.split())
+        norm_expected = " ".join(expected.split())
+        passed = norm_actual == norm_expected and not err_msg
+        status = "PASS" if passed else "FAIL"
+        report_lines.append(f"Sample {idx}: {status}")
+        report_lines.append("--- Input ---")
+        report_lines.append(inp)
+        report_lines.append("--- Expected Output ---")
+        report_lines.append(expected)
+        report_lines.append("--- Actual Output ---")
+        report_lines.append(actual.rstrip())
+        if stderr:
+            report_lines.append("--- Stderr ---")
+            report_lines.append(stderr.rstrip())
+        if err_msg:
+            report_lines.append("--- Error ---")
+            report_lines.append(err_msg)
+        report_lines.append("")
+    return "\n".join(report_lines)
