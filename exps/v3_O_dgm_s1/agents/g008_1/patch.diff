@@ -0,0 +1,119 @@
+import subprocess
+import os
+import json
+import tempfile
+from typing import Optional
+
+def tool_info():
+    """Return metadata for the run_samples tool."""
+    return {
+        "name": "run_samples",
+        "description": (
+            "Run a solution script against a list of sample test cases. "
+            "The tool receives a JSON list of objects with `input` and `expected_output`. "
+            "It executes `python3 solution_path` for each sample, captures stdout, stderr, "
+            "and the exit code, and reports whether the actual output exactly matches the expected output. "
+            "Optionally, a validator script can be provided which is invoked as "
+            "`python3 validator_path <input_file> <output_file>` and its exit code indicates success."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution script (e.g., solution.py)."
+                },
+                "samples_json": {
+                    "type": "string",
+                    "description": "JSON-encoded list of samples, each with `input` and `expected_output` strings."
+                },
+                "validator_path": {
+                    "type": "string",
+                    "description": "Optional path to a validator script for multi‑answer problems."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each run.",
+                    "default": 10
+                }
+            },
+            "required": ["solution_path", "samples_json"]
+        }
+    }
+
+def _run_solution(solution_path: str, input_data: str, timeout: int) -> subprocess.CompletedProcess:
+    """Execute the solution with the provided input under a timeout."""
+    cmd = ["timeout", str(timeout), "python3", solution_path]
+    return subprocess.run(
+        cmd,
+        input=input_data,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+def tool_function(
+    solution_path: str,
+    samples_json: str,
+    validator_path: Optional[str] = None,
+    timeout: int = 10,
+) -> str:
+    """Run the solution against each sample and optionally validate.
+
+    Returns a raw multi‑line report containing for each sample:
+    - Input
+    - Expected output
+    - Actual output
+    - Stderr (if any)
+    - Return code
+    - Exact‑match flag (True/False)
+    If a validator is supplied, its exit code and stdout/stderr are also included.
+    The function does **not** interpret or parse errors; all raw data are returned.
+    """
+    try:
+        samples = json.loads(samples_json)
+    except Exception as e:
+        return f"Error parsing samples_json: {e}"
+
+    report_lines = []
+    for idx, sample in enumerate(samples):
+        inp = sample.get('input', '')
+        expected = sample.get('expected_output', '')
+        # Run solution
+        sol_res = _run_solution(solution_path, inp, timeout)
+        actual = sol_res.stdout
+        match = actual.strip() == expected.strip()
+        report_lines.append(f"Sample {idx}:")
+        report_lines.append(f"Input:\n{inp}")
+        report_lines.append(f"Expected Output:\n{expected}")
+        report_lines.append(f"Actual Output:\n{actual}")
+        report_lines.append(f"Stderr:\n{sol_res.stderr}")
+        report_lines.append(f"Return Code: {sol_res.returncode}")
+        report_lines.append(f"Exact Match: {match}")
+
+        if validator_path:
+            # Write input and solution output to temporary files for validator
+            with tempfile.NamedTemporaryFile(mode='w', delete=False) as inp_file:
+                inp_file.write(inp)
+                inp_path = inp_file.name
+            with tempfile.NamedTemporaryFile(mode='w', delete=False) as out_file:
+                out_file.write(actual)
+                out_path = out_file.name
+            chk_res = subprocess.run(
+                ["python3", validator_path, inp_path, out_path],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+            )
+            # Cleanup temporary files
+            try:
+                os.remove(inp_path)
+                os.remove(out_path)
+            except Exception:
+                pass
+            report_lines.append(f"Validator Exit Code: {chk_res.returncode}")
+            report_lines.append(f"Validator Stdout:\n{chk_res.stdout}")
+            report_lines.append(f"Validator Stderr:\n{chk_res.stderr}")
+        report_lines.append("---")
+
+    return "\n".join(report_lines)
