+    def _is_empty_reply(self, msg_history):
+        """
+        True if the last assistant message has no tool call and no text.
+        """
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj.get(key)
+            return getattr(obj, key, None)
