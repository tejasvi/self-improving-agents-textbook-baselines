@@ -0,0 +1,135 @@
+import os
+import re
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution program on the sample tests found in the problem statement.
+
+* solution_path: the Python program to run (it reads stdin and writes stdout).
+* problem_statement: the full problem statement text containing 'Sample Input N' / 'Sample Output N' blocks (or 'Example' variants). If omitted, the tool reports that no samples were found.
+* timeout_sec: per-sample timeout in seconds.
+
+For each sample, the program is run with the sample input on stdin. The report shows PASS, FAIL (with input, expected output, actual output and stderr), or TIMEOUT for every sample.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution program to run."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The problem statement text that contains the sample input/output blocks."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each sample run. Default 10."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+_MARKER_RE = re.compile(
+    r'^[ \t#*_]*(?:(?:sample|example)[ \t]+)?(input|output)[ \t]*(\d*)[ \t]*[:.]?[ \t]*[*_]*[ \t]*$',
+    re.IGNORECASE | re.MULTILINE,
+)
+_STOP_RE = re.compile(r'^\s*(explanation|note|constraints?|example|sample)\b', re.IGNORECASE)
+
+
+def _block_body(lines):
+    """Payload of a block: its fenced code if present, else the lines up to a blank line or a section label."""
+    text = '\n'.join(lines)
+    fence = re.search(r'```[^\n]*\n(.*?)```', text, flags=re.DOTALL)
+    if fence:
+        body = fence.group(1)
+    else:
+        kept = []
+        for line in lines:
+            if kept and not line.strip():
+                break
+            if _STOP_RE.match(line):
+                break
+            if line.strip():
+                kept.append(line)
+        body = '\n'.join(kept)
+    body = body.replace('\r\n', '\n').strip('\n')
+    return body + '\n' if body.strip() else ''
+
+
+def parse_samples(problem_statement):
+    """
+    Return a sorted list of (index, input_text, expected_output_text) parsed from the statement.
+    Markers must occupy a whole line: 'Sample Input N', 'Example N', or a bare 'Input' / 'Output'.
+    """
+    if not problem_statement:
+        return []
+    markers = list(_MARKER_RE.finditer(problem_statement))
+    inputs, outputs = {}, {}
+    count = 0
+    for i, m in enumerate(markers):
+        end = markers[i + 1].start() if i + 1 < len(markers) else len(problem_statement)
+        body_lines = problem_statement[m.end():end].split('\n')[1:]
+        kind = m.group(1).lower()
+        if m.group(2):
+            num = int(m.group(2))
+        else:
+            num = count + 1 if kind == 'input' else count
+        if kind == 'input':
+            count = num
+            inputs.setdefault(num, _block_body(body_lines))
+        else:
+            outputs.setdefault(num, _block_body(body_lines))
+    return [(k, inputs[k], outputs[k]) for k in sorted(set(inputs) & set(outputs))]
+
+
+def _norm(text):
+    lines = [line.rstrip() for line in (text or '').replace('\r\n', '\n').split('\n')]
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def run_samples_report(solution_path, problem_statement, timeout_sec=10):
+    """Shared implementation returning the raw report text."""
+    try:
+        timeout_sec = float(timeout_sec)
+    except (TypeError, ValueError):
+        timeout_sec = 10.0
+    samples = parse_samples(problem_statement)
+    if not samples:
+        return "No samples found"
+    if not os.path.exists(solution_path):
+        return f"Solution file not found: {solution_path}"
+    parts = []
+    passed = 0
+    for idx, inp, expected in samples:
+        try:
+            res = subprocess.run(
+                ['python3', solution_path],
+                input=inp, capture_output=True, text=True, timeout=timeout_sec,
+            )
+        except subprocess.TimeoutExpired:
+            parts.append(f"Sample {idx}: TIMEOUT (exceeded {timeout_sec} seconds)\nInput:\n{inp}")
+            continue
+        if _norm(res.stdout).split() == _norm(expected).split() and res.returncode == 0:
+            passed += 1
+            parts.append(f"Sample {idx}: PASS")
+        else:
+            parts.append(
+                f"Sample {idx}: FAIL (exit code {res.returncode})\n"
+                f"Input:\n{inp}"
+                f"Expected:\n{expected}"
+                f"Actual:\n{res.stdout}"
+                f"stderr:\n{res.stderr}"
+            )
+    header = f"{passed}/{len(samples)} samples passed."
+    return header + "\n\n" + "\n\n".join(parts)
+
+
+def tool_function(solution_path, problem_statement=None, timeout_sec=10):
+    return run_samples_report(solution_path, problem_statement, timeout_sec)
