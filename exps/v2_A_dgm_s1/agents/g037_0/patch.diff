+    def _target_is_placeholder(self, target):
+        """
+        True if the target file has no meaningful content (only blank lines and '#' comments),
+        or its content is identical to the content at base_commit.
+        Returns False when no target is given.
+        """
+        if not target:
+            return False
+        content = self._read_target_content(target)
+        meaningful = [
+            line for line in content.splitlines()
+            if line.strip() and not line.lstrip().startswith('#')
+        ]
+        if not meaningful:
+            return True
+        try:
+            result = subprocess.run(
+                ['git', 'show', f'{self.base_commit}:{target}'],
+                cwd=self.git_tempdir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            if result.returncode == 0:
+                original = result.stdout.decode('utf-8', errors='replace')
+                if original == content:
+                    return True
+        except Exception as e:
+            safe_log(f"[placeholder] could not read base content of {target}: {e}")
+        return False
+
+    def _last_turn_empty(self, msg_history):
+        """
+        True if the last assistant message has no tool_use block and only empty/whitespace text.
+        """
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj.get(key)
+            return getattr(obj, key, None)
+
+        last = None
+        for msg in msg_history or []:
+            if _get(msg, 'role') == 'assistant':
+                last = msg
+        if last is None:
+            return False
+        content = _get(last, 'content')
+        if isinstance(content, str):
+            return not content.strip()
+        if not isinstance(content, list):
+            return True
+        texts = []
+        for block in content:
+            btype = _get(block, 'type')
+            if btype == 'tool_use':
+                return False
+            if btype == 'text':
+                texts.append(str(_get(block, 'text') or ''))
+        return not ''.join(texts).strip()
+
