+    def _find_deliverable_path(self):
+        """Absolute path of the deliverable file, or None if it cannot be determined."""
+        rel = self._find_deliverable()
+        if rel and self._is_test_path(rel):
+            rel = None  # never let the fallback write to a test file
+        if not rel:
+            try:
+                out = subprocess.run(
+                    ["git", "-C", self.git_tempdir, "grep", "-l", "-E", r"\bpass\b|NotImplemented"],
+                    capture_output=True, text=True, timeout=30,
+                ).stdout
+                candidates = [f for f in out.splitlines()
+                              if f.strip().endswith('.py') and not self._is_test_path(f)]
+                if len(candidates) == 1:
+                    rel = candidates[0]
+            except Exception:
+                rel = None
+        if rel and self._is_test_path(rel):
+            rel = None
+        if not rel and os.path.exists(os.path.join(self.git_tempdir, 'solution.py')):
+            rel = 'solution.py'
+        if not rel:
+            return None
+        return os.path.join(self.git_tempdir, rel)
+
+    @staticmethod
+    def _extract_code_block(text):
+        """Longest ```python ... ``` block in text (or any ``` block); None if there is none."""
+        if not text:
+            return None
+        blocks = re.findall(r"```(?:python|py)?[ \t]*\n(.*?)```", text, flags=re.DOTALL)
+        if not blocks:
+            return None
+        return max(blocks, key=len)
+
+    @staticmethod
+    def _last_assistant_text(history):
+        for msg in reversed(history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            parts = [c.get('text', '') for c in (content or []) if isinstance(c, dict) and c.get('type') == 'text']
+            return "\n".join(parts)
+        return ""
+
+    def _fallback_write_solution(self):
+        """Deterministic fallback: ask the model for the full file contents and write them."""
+        path = self._find_deliverable_path()
+        if not path:
+            safe_log("Fallback: could not determine deliverable path.", level=logging.WARNING)
+            return False
+        try:
+            with open(path, 'r') as f:
+                stub = f.read()
+        except Exception as e:
+            safe_log(f"Fallback: could not read {path}: {e}", level=logging.WARNING)
+            return False
+        for attempt in range(2):
+            if attempt == 0:
+                prompt = (
+                    f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+                    f"Current contents of {path}:\n```python\n{stub}\n```\n\n"
+                    "Write a complete correct solution. Reply with ONLY the full final contents of this file "
+                    "in one ```python block, keeping the class and method signature from the stub. No explanation."
+                )
+            else:
+                prompt = (
+                    f"Reply with ONLY the full contents of {path} in one ```python block. No explanation.\n\n"
+                    f"Problem:\n{self.problem_statement}\n\nStub:\n```python\n{stub}\n```"
+                )
+            history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log) or []
+            code = self._extract_code_block(self._last_assistant_text(history))
+            if code is not None and code.strip():
+                with open(path, 'w') as f:
+                    f.write(code)
+                safe_log(f"Fallback attempt {attempt}: wrote {len(code)} chars to {path}.")
+                return True
+            safe_log(f"Fallback attempt {attempt}: no code block found in reply.", level=logging.WARNING)
+        return False
+
     def _has_real_source_change(self, patch):
         """True if a non-test source file has at least one added non-blank, non-comment line."""
         return self._diff_problem(patch) is None
