+++ b/tools/run_samples.py
@@ -0,0 +1,101 @@
+import os
+import re
+import subprocess
+import sys
+
+TIMEOUT_SECONDS = 10
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Extract the sample input/output pairs from a problem statement and run a Python solution file on each sample input.\n
+* Recognizes headings such as 'Sample Input N' / 'Sample Output N', 'Example N' with 'Input:' / 'Output:', or bare 'Input:' / 'Output:' lines.\n
+* Returns, for each sample, the input, the expected output, the actual output, stderr, and a MATCH or MISMATCH flag (whitespace-normalized comparison).\n
+* Returns the raw text; no error parsing is performed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed as `python3 solution_path`)."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full problem statement containing the sample inputs and outputs."
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+# A heading line such as "Sample Input 1", "Example 2 Output:", "Input:" or "Output"
+_HEADER_RE = re.compile(
+    r'^[ \t]*(?:#+[ \t]*)?(?:(?:Sample|Example)[ \t]*)?(?P<kind>Input|Output)[ \t]*\d*[ \t]*:?[ \t]*$',
+    re.MULTILINE | re.IGNORECASE,
+)
+
+def _section_text(lines):
+    """Collect the lines of a section, stopping at the first blank line after content starts."""
+    out = []
+    for line in lines:
+        if not line.strip():
+            if out:
+                break
+            continue
+        out.append(line.rstrip())
+    return '\n'.join(out)
+
+def _extract_samples(problem_statement):
+    """Return a list of (input_text, expected_output_text) tuples."""
+    text = problem_statement or ''
+    headers = list(_HEADER_RE.finditer(text))
+    samples = []
+    pending_input = None
+    for i, h in enumerate(headers):
+        body_end = headers[i + 1].start() if i + 1 < len(headers) else len(text)
+        body = text[h.end():body_end].split('\n')[1:]  # skip the rest of the header line
+        kind = h.group('kind').lower()
+        if kind == 'input':
+            pending_input = _section_text(body)
+        elif kind == 'output' and pending_input is not None:
+            expected = _section_text(body)
+            if pending_input.strip() or expected.strip():
+                samples.append((pending_input, expected))
+            pending_input = None
+    return samples
+
+def _normalize(s):
+    return ' '.join((s or '').split())
+
+def tool_function(solution_path, problem_statement):
+    samples = _extract_samples(problem_statement)
+    if not samples:
+        return "No sample input/output pairs found in the problem statement."
+    if not os.path.exists(solution_path):
+        return f"Solution file not found: {solution_path}"
+
+    reports = []
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        try:
+            result = subprocess.run(
+                [sys.executable, solution_path],
+                input=inp + '\n',
+                capture_output=True,
+                text=True,
+                timeout=TIMEOUT_SECONDS,
+            )
+            actual = result.stdout
+            stderr = result.stderr
+            status = 'MATCH' if _normalize(actual) == _normalize(expected) else 'MISMATCH'
+        except subprocess.TimeoutExpired as e:
+            actual = (e.stdout.decode('utf-8', errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or ''))
+            stderr = f"Timed out after {TIMEOUT_SECONDS} seconds"
+            status = 'MISMATCH'
+        reports.append(
+            f"=== Sample {idx}: {status} ===\n"
+            f"--- input ---\n{inp}\n"
+            f"--- expected output ---\n{expected}\n"
+            f"--- actual output ---\n{actual}\n"
+            f"--- stderr ---\n{stderr}\n"
+        )
+    return '\n'.join(reports)
