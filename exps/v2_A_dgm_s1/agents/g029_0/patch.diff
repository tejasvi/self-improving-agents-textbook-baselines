+    def _last_assistant_text_empty(self, msg_history):
+        """
+        True if the last assistant message has no non-whitespace text and no tool_use block.
+        """
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj.get(key)
+            return getattr(obj, key, None)
+
+        for msg in reversed(msg_history or []):
+            if _get(msg, 'role') != 'assistant':
+                continue
+            content = _get(msg, 'content')
+            if isinstance(content, str):
+                return not content.strip()
+            if not isinstance(content, list):
+                return True
+            text = ''
+            for block in content:
+                if _get(block, 'type') == 'tool_use':
+                    return False
+                if _get(block, 'type') == 'text':
+                    text += str(_get(block, 'text') or '')
+            return not text.strip()
+        return False
+
