diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..1065ec4
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,76 @@
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_timed",
+        "description": """Run a shell command with a wall-clock timeout and report its timing.\n
+* Use this to benchmark a solution on max-size inputs, e.g. `python solution.py < big_input.txt`.\n
+* Returns the elapsed wall time in seconds, the exit code, and the tail of stdout and stderr (raw, unparsed).\n
+* If the command exceeds the timeout it is killed and the result reports TIMEOUT.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The bash command to run, e.g. `python solution.py < max_input.txt`."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Wall-clock timeout in seconds (default 10)."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _tail(text, limit=MAX_OUTPUT_CHARS):
+    if text is None:
+        return ""
+    if len(text) > limit:
+        return "...<truncated>...\n" + text[-limit:]
+    return text
+
+
+def tool_function(command: str, timeout_seconds: int = 10) -> str:
+    if timeout_seconds is None:
+        timeout_seconds = 10
+    try:
+        timeout_seconds = int(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout_seconds = 10
+    if timeout_seconds <= 0:
+        timeout_seconds = 10
+
+    start = time.monotonic()
+    try:
+        result = subprocess.run(
+            command,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.monotonic() - start
+        stdout = e.stdout.decode('utf-8', errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or "")
+        stderr = e.stderr.decode('utf-8', errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return (
+            f"TIMEOUT after {timeout_seconds}s (elapsed {elapsed:.2f}s); process killed.\n"
+            f"stdout tail:\n{_tail(stdout)}\n"
+            f"stderr tail:\n{_tail(stderr)}"
+        )
+    except Exception as e:
+        return f"Error running command: {e}"
+
+    elapsed = time.monotonic() - start
+    return (
+        f"Elapsed: {elapsed:.3f}s\n"
+        f"Exit code: {result.returncode}\n"
+        f"stdout tail:\n{_tail(result.stdout)}\n"
+        f"stderr tail:\n{_tail(result.stderr)}"
+    )
