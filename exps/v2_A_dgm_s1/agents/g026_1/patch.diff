+"""Baseline coding agent.
+
+Minimal baseline: reads a task description, sends it to an LLM together with
+a snapshot of the working directory, and prints the model's response. If the
+model returns a JSON list of file edits, they are applied to disk.
+
+Usage:
+    python coding_agent_baseline.py --task "Fix the bug in foo.py" --repo /path/to/repo
+"""
+
+import argparse
+import json
+import os
+import sys
+
+
+MAX_FILE_CHARS = 20000
+MAX_FILES = 50
+SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "venv"}
+
+SYSTEM_PROMPT = (
+    "You are a coding agent. Given a task and a snapshot of a repository, "
+    "respond with a JSON object of the form "
+    '{"edits": [{"path": "relative/path.py", "content": "full new file content"}], '
+    '"explanation": "short summary"}. '
+    "Only output JSON."
+)
+
+
+def snapshot_repo(repo):
+    """Collect text files from the repo (bounded in count and size)."""
+    files = {}
+    for root, dirs, names in os.walk(repo):
+        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
+        for name in names:
+            if len(files) >= MAX_FILES:
+                return files
+            full = os.path.join(root, name)
+            rel = os.path.relpath(full, repo)
+            try:
+                with open(full, "r", encoding="utf-8") as f:
+                    files[rel] = f.read(MAX_FILE_CHARS)
+            except (UnicodeDecodeError, OSError):
+                continue
+    return files
+
+
+def call_llm(task, files):
+    """Call the LLM. Requires the OpenAI client and OPENAI_API_KEY."""
+    try:
+        from openai import OpenAI
+    except ImportError:
+        sys.exit("openai package not installed: pip install openai")
+
+    client = OpenAI()
+    model = os.environ.get("MODEL", "gpt-4o")
+    context = "\n\n".join(f"### {p}\n{c}" for p, c in files.items())
+    resp = client.chat.completions.create(
+        model=model,
+        messages=[
+            {"role": "system", "content": SYSTEM_PROMPT},
+            {"role": "user", "content": f"Task:\n{task}\n\nRepository:\n{context}"},
+        ],
+        temperature=0,
+    )
+    return resp.choices[0].message.content
+
+
+def parse_edits(text):
+    """Parse the model output as JSON, tolerating surrounding code fences."""
+    text = text.strip()
+    if text.startswith("```"):
+        text = text.strip("`")
+        if text.startswith("json"):
+            text = text[4:]
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError:
+        return None
+
+
+def apply_edits(repo, edits):
+    applied = []
+    root = os.path.abspath(repo)
+    for edit in edits:
+        path = edit.get("path")
+        content = edit.get("content")
+        if not path or content is None:
+            continue
+        full = os.path.abspath(os.path.join(root, path))
+        if not full.startswith(root + os.sep):
+            print(f"skipping path outside repo: {path}", file=sys.stderr)
+            continue
+        os.makedirs(os.path.dirname(full), exist_ok=True)
+        with open(full, "w", encoding="utf-8") as f:
+            f.write(content)
+        applied.append(path)
+    return applied
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Baseline coding agent")
+    parser.add_argument("--task", required=True, help="Task description")
+    parser.add_argument("--repo", default=".", help="Repository path")
+    parser.add_argument("--dry-run", action="store_true", help="Do not write files")
+    args = parser.parse_args()
+
+    files = snapshot_repo(args.repo)
+    raw = call_llm(args.task, files)
+    result = parse_edits(raw)
+    if result is None:
+        print("Model did not return valid JSON:\n", raw)
+        return 1
+
+    print("Explanation:", result.get("explanation", ""))
+    edits = result.get("edits", [])
+    if args.dry_run:
+        print(f"Dry run: {len(edits)} edit(s) proposed")
+        return 0
+
+    applied = apply_edits(args.repo, edits)
+    print(f"Applied {len(applied)} edit(s): {', '.join(applied)}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
