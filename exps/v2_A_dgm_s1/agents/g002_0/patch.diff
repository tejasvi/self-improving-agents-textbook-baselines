+    def _detect_target_file(self):
+        """
+        Identify the file the task asks us to write. Returns a path relative to git_tempdir, or None.
+        1) A backticked *.py name mentioned in the problem statement that exists in the repo.
+        2) Otherwise, the single non-test .py file tracked in the repo.
+        """
+        candidates = re.findall(r'`([^`\s]+\.py)`', self.problem_statement or '')
+        for cand in candidates:
+            rel = cand.lstrip('./')
+            if os.path.exists(os.path.join(self.git_tempdir, rel)):
+                return rel
+        py_files = []
+        for root, dirs, files in os.walk(self.git_tempdir):
+            dirs[:] = [d for d in dirs if d not in ('.git', '__pycache__', 'node_modules', 'build')]
+            for f in files:
+                if f.endswith('.py'):
+                    rel = os.path.relpath(os.path.join(root, f), self.git_tempdir)
+                    if not self._is_test_file(rel):
+                        py_files.append(rel)
+        if len(py_files) == 1:
+            return py_files[0]
+        return None
+
+    def _read_target_content(self, target):
+        if not target:
+            return ''
+        full_path = os.path.join(self.git_tempdir, target)
+        if not os.path.exists(full_path):
+            return ''
+        with open(full_path, 'r', encoding='utf-8', errors='replace') as f:
+            return f.read()
+
+    def _fallback_write_solution(self, target):
+        """
+        Deterministic fallback: ask the LLM once for the complete file contents and write them.
+        Returns True if a file was written.
+        """
+        if not target:
+            safe_log("[fallback] No target file detected; cannot write solution directly.")
+            return False
+        current = self._read_target_content(target)
+        prompt = f"""Here is a competitive programming problem:
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+The solution file is `{target}`. Its current content is:
+```python
+{current}
+```
+
+Write the complete, final contents of `{target}` that solve the problem. Keep any required function or class signatures. Output ONLY the full file contents in a single ```python fenced code block, with no other text."""
+        safe_log(f"[fallback] Requesting full contents of {target} from the model.")
+        try:
+            client, client_model = create_client(self.code_model)
+            response, _ = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message="You are an expert competitive programmer. You output only code.",
+                print_debug=False,
+                msg_history=[],
+            )
+        except Exception as e:
+            safe_log(f"[fallback] LLM call failed: {e}")
+            return False
+        match = re.search(r'```python\s*\n(.*?)```', response or '', flags=re.DOTALL)
+        if not match:
+            safe_log(f"[fallback] No ```python block found in response: {str(response)[:500]}")
+            return False
+        code = match.group(1)
+        full_path = os.path.join(self.git_tempdir, target)
+        os.makedirs(os.path.dirname(full_path) or '.', exist_ok=True)
+        with open(full_path, 'w', encoding='utf-8') as f:
+            f.write(code)
+        safe_log(f"[fallback] Wrote {len(code)} chars to {target}:\n{code}")
+        return True
