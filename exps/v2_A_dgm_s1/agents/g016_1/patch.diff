diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..4822d9b
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,115 @@
+import subprocess
+import os
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress tester. Runs a candidate solution and a reference solution on many generated inputs and compares their stdout.\n
+* Provide either `generator_path` (a program that takes one integer seed as its first command-line argument and prints one test input to stdout) or `input_cases` (a list of literal input strings). If both are given, `input_cases` is used first and then the generator.\n
+* Both `solution_path` and `reference_path` are executed with `python3` if they end in `.py`, otherwise they are executed directly (e.g. compiled C++ binaries). Each run gets `timeout` seconds.\n
+* Returns 'all N cases passed' if every input produces identical stdout from both programs. Otherwise returns the first differing input together with the raw stdout and stderr of both programs. No parsing is performed; interpret the raw output yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate solution (a .py script or an executable)."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the trusted reference solution (a .py script or an executable)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator program. It is called as `<generator> <seed>` and must print one test input to stdout. Used when input_cases is not given."
+                },
+                "input_cases": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional explicit list of input strings to test. Each string is fed to stdin as-is."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of seeds to run through the generator (seeds 1..num_cases). Ignored for input_cases."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each individual program run."
+                }
+            },
+            "required": ["solution_path", "reference_path", "num_cases", "timeout"]
+        }
+    }
+
+
+def _command_for(path):
+    if path.endswith('.py'):
+        return ['python3', path]
+    return [os.path.abspath(path)]
+
+
+def _run(cmd, stdin_text, timeout):
+    try:
+        proc = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True, timeout=timeout)
+        return proc.stdout, proc.stderr, f"exit code {proc.returncode}"
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or '')
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return out, err, f"TIMEOUT after {timeout}s"
+    except Exception as e:
+        return '', str(e), 'EXCEPTION'
+
+
+def _generate(generator_path, seed, timeout):
+    cmd = _command_for(generator_path) + [str(seed)]
+    try:
+        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return None, f"generator TIMEOUT after {timeout}s"
+    except Exception as e:
+        return None, f"generator EXCEPTION: {e}"
+    if proc.returncode != 0:
+        return None, f"generator exit code {proc.returncode}, stderr: {proc.stderr}"
+    return proc.stdout, None
+
+
+def tool_function(solution_path, reference_path, num_cases=100, timeout=10,
+                  generator_path=None, input_cases=None):
+    try:
+        num_cases = int(num_cases)
+        timeout = int(timeout)
+    except (TypeError, ValueError):
+        return "Error: num_cases and timeout must be integers."
+
+    sol_cmd = _command_for(solution_path)
+    ref_cmd = _command_for(reference_path)
+
+    if input_cases:
+        cases = [(f"input_cases[{i}]", c) for i, c in enumerate(input_cases)]
+    elif generator_path:
+        cases = []
+        for seed in range(1, num_cases + 1):
+            text, err = _generate(generator_path, seed, timeout)
+            if err is not None:
+                return f"Error at seed {seed}: {err}"
+            cases.append((f"seed {seed}", text))
+    else:
+        return "Error: provide either generator_path or input_cases."
+
+    for label, test_input in cases:
+        ref_out, ref_err, ref_status = _run(ref_cmd, test_input, timeout)
+        sol_out, sol_err, sol_status = _run(sol_cmd, test_input, timeout)
+        ok_status = ref_status == sol_status == "exit code 0"
+        if ok_status and sol_out.rstrip() == ref_out.rstrip():
+            continue
+        return (
+            f"Mismatch found on {label}.\n"
+            f"=== Input ===\n{test_input}\n"
+            f"=== Reference ({reference_path}) [{ref_status}] stdout ===\n{ref_out}\n"
+            f"=== Reference stderr ===\n{ref_err}\n"
+            f"=== Solution ({solution_path}) [{sol_status}] stdout ===\n{sol_out}\n"
+            f"=== Solution stderr ===\n{sol_err}"
+        )
+
+    return f"all {len(cases)} cases passed"
