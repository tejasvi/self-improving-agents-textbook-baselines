+    def _last_assistant_text(self, msg_history):
+        """
+        Return the concatenated text blocks of the last message in the history ('' if none).
+        """
+        if not msg_history:
+            return ''
+        content = msg_history[-1].get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'text':
+                    parts.append(str(block.get('text', '')))
+            return '\n'.join(parts)
+        return ''
+
