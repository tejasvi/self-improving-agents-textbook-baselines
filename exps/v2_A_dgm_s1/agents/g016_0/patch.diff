+    def _run_stress_check(self, path=STRESS_CHECK_PATH):
+        """
+        Run the agent's stress-test script and return (exit_code, stdout, stderr).
+        exit_code is None if the script does not exist. Raw output is returned unparsed.
+        """
+        if not os.path.exists(path):
+            return None, '', ''
+        try:
+            result = subprocess.run(['python3', path], capture_output=True, text=True, timeout=STRESS_CHECK_TIMEOUT)
+            return result.returncode, result.stdout, result.stderr
+        except subprocess.TimeoutExpired as e:
+            stdout = e.stdout.decode(errors='ignore') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            stderr = e.stderr.decode(errors='ignore') if isinstance(e.stderr, bytes) else (e.stderr or '')
+            return -1, stdout, stderr + f"\nTimeout: stress script exceeded {STRESS_CHECK_TIMEOUT} seconds."
+
+    def _read_solution_files(self):
+        """
+        Return the current contents of changed non-test files, formatted for a prompt.
+        """
+        parts = []
+        for f in self._changed_files():
+            if self._is_test_file(f):
+                continue
+            full = os.path.join(self.git_tempdir, f)
+            try:
+                with open(full, 'r', errors='ignore') as fh:
+                    content = fh.read()
+            except Exception as e:
+                content = f"(could not read file: {e})"
+            parts.append(f"### {f}\n```\n{content}\n```")
+        return "\n\n".join(parts) if parts else "(no changed source files found)"
+
+    def _last_assistant_text(self, msg_history):
+        """
+        Return the text of the last assistant message ('' if none or empty).
+        Handles both plain-string and list-of-blocks content.
+        """
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content.strip()
+            if isinstance(content, list):
+                texts = []
+                for block in content:
+                    if isinstance(block, dict) and block.get('type') == 'text':
+                        texts.append(block.get('text') or '')
+                    elif hasattr(block, 'text'):
+                        texts.append(block.text or '')
+                return "\n".join(texts).strip()
+            return ''
+        return ''
+
