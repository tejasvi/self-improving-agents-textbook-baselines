+    """Replace a unique occurrence of old_str with new_str. Fails unless old_str occurs exactly once."""
+    if old_str is None or old_str == "":
+        raise ValueError("Missing required non-empty `old_str` for 'str_replace' command.")
+    if new_str is None:
+        raise ValueError("Missing required `new_str` for 'str_replace' command.")
+    content = read_file(path_obj)
+    count = content.count(old_str)
+    if count == 0:
+        raise ValueError(f"No replacement performed: `old_str` was not found in {path_obj}.")
+    if count > 1:
+        raise ValueError(f"No replacement performed: `old_str` occurs {count} times in {path_obj}; it must occur exactly once. Include more surrounding context.")
+    write_file(path_obj, content.replace(old_str, new_str, 1))
+    return f"The file {path_obj} has been edited successfully."
