+import json
+import subprocess
+
+TIMEOUT_SECONDS = 10
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution program against sample test cases and compare its output with the expected output.\n
+* Each sample is {"input": <stdin text>, "expected": <expected stdout text>}.\n
+* The solution is executed as `python3 <solution_path>` once per sample, with the input on stdin (timeout 10 seconds per sample).\n
+* Outputs are compared after whitespace normalization (leading/trailing whitespace and runs of whitespace are collapsed). The report also states whether the output matches EXACTLY (byte-for-byte after stripping only trailing newlines).\n
+* For each sample the tool reports PASS/FAIL, the exact-match status, the actual output and the expected output.\n
+* A sample passes only if the whitespace-normalized output equals the expected output. Exact-match status must also be YES for the answer to be trusted, since the hidden grader may compare exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute or relative path to the Python solution file to run with python3."
+                },
+                "samples_json": {
+                    "type": "string",
+                    "description": "A JSON string containing a list of objects, each with keys \"input\" (string, stdin content) and \"expected\" (string, expected stdout). Example: [{\"input\": \"2\\n1 2\\n\", \"expected\": \"3\\n\"}]"
+                }
+            },
+            "required": ["solution_path", "samples_json"]
+        }
+    }
+
+
+def _normalize_ws(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _exact(text: str) -> str:
+    return text.rstrip("\n")
+
+
+def _run_one(solution_path: str, input_text: str) -> str:
+    """Run the solution on input_text and return stdout (or an error description)."""
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=TIMEOUT_SECONDS,
+        )
+    except subprocess.TimeoutExpired:
+        return "__ERROR__: timed out after %d seconds" % TIMEOUT_SECONDS
+    except Exception as e:
+        return "__ERROR__: failed to run solution: %s" % e
+    if proc.returncode != 0:
+        return "__ERROR__: exit code %d; stderr:\n%s" % (proc.returncode, proc.stderr)
+    return proc.stdout
+
+
+def tool_function(solution_path: str, samples_json: str) -> str:
+    try:
+        samples = json.loads(samples_json)
+    except Exception as e:
+        return f"Error: samples_json is not valid JSON: {e}"
+    if not isinstance(samples, list):
+        return "Error: samples_json must be a JSON list of {\"input\", \"expected\"} objects."
+
+    lines = []
+    passed = 0
+    for i, sample in enumerate(samples):
+        if not isinstance(sample, dict) or "input" not in sample or "expected" not in sample:
+            lines.append(f"Sample {i + 1}: FAIL (malformed sample; needs keys 'input' and 'expected')")
+            continue
+        input_text = str(sample["input"])
+        expected = str(sample["expected"])
+        actual = _run_one(solution_path, input_text)
+        if actual.startswith("__ERROR__:"):
+            lines.append(f"Sample {i + 1}: FAIL ({actual[len('__ERROR__: '):]})")
+            lines.append(f"  expected:\n{expected}")
+            continue
+        ws_match = _normalize_ws(actual) == _normalize_ws(expected)
+        exact_match = _exact(actual) == _exact(expected)
+        status = "PASS" if ws_match else "FAIL"
+        if ws_match:
+            passed += 1
+        lines.append(
+            f"Sample {i + 1}: {status} (exact match: {'YES' if exact_match else 'NO'})"
+        )
+        lines.append(f"  actual output:\n{actual}")
+        lines.append(f"  expected output:\n{expected}")
+
+    summary = f"{passed}/{len(samples)} samples passed (whitespace-normalized)."
+    return summary + "\n" + "\n".join(lines)
