+    def _is_empty_assistant_msg(self, msg):
+        """
+        True if an assistant message carries no text and no tool-use markup.
+        Non-dict entries (e.g. SDK objects) are never treated as empty.
+        """
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            return False
+        if msg.get('tool_calls'):
+            return False
+        content = msg.get('content')
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return not content.strip()
+        if isinstance(content, list):
+            for block in content:
+                if not isinstance(block, dict):
+                    return False
+                btype = block.get('type')
+                if btype in ('tool_use', 'tool_result', 'tool_call', 'function_call'):
+                    return False
+                if btype == 'text' and str(block.get('text') or '').strip():
+                    return False
+                if btype != 'text':
+                    return False
+            return True
+        return False
+
+    def _clean_history(self, msg_history):
+        """
+        Return a copy of msg_history without assistant messages that are empty or
+        whitespace-only text with no tool-use markup.
+        """
+        cleaned = []
+        for msg in msg_history or []:
+            if self._is_empty_assistant_msg(msg):
+                continue
+            cleaned.append(msg)
+        return cleaned
+
+    def _last_turn_is_empty(self, msg_history):
+        """
+        True if the final assistant message has empty text.
+        """
+        for msg in reversed(msg_history or []):
+            if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                return self._is_empty_assistant_msg(msg)
+        return False
+
+    def _continue_until_edit(self, history, max_nudges=4):
+        """
+        Keep the same conversation going with escalating nudges until a real
+        source edit exists. Bounded by max_nudges (no while True).
+        Returns the updated history.
+        """
+        target = self._target_file()
+        rel_target = os.path.relpath(target, self.git_tempdir)
+        for i in range(max_nudges):
+            if self._has_source_edit() and self._has_real_edit():
+                break
+            if i == 0:
+                nudge = (f"Your previous reply was empty/ended without writing the solution. "
+                         f"Continue from where you left off and now call the editor tool to write the full solution to {rel_target}.")
+            elif i == 1:
+                nudge = (f"Write a straightforward correct first version of the solution to {rel_target} "
+                         f"immediately using the editor tool, refine later.")
+            else:
+                nudge = (f"Use the editor tool to write the complete solution to {rel_target} now, in exactly one editor call that writes the file. "
+                         f"Do not reply with text only.\n\nFull problem statement:\n{self.problem_statement}")
+            safe_log(f"[continue {i + 1}] nudging; history_len={len(history or [])} last_empty={self._last_turn_is_empty(history)}")
+            history = chat_with_agent(nudge, model=self.code_model, msg_history=self._clean_history(history), logging=safe_log)
+            safe_log(f"[continue {i + 1}] history_len={len(history or [])} tool_use={self._history_has_tool_use(history)}")
+        return history
+
