+    def _changed_files(self):
+        """
+        Return files changed relative to base_commit, including untracked files.
+        """
+        files = []
+        cmds = [
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+        ]
+        for cmd in cmds:
+            try:
+                result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+                out = result.stdout.decode(errors='ignore')
+            except Exception:
+                out = ''
+            for line in out.splitlines():
+                line = line.strip()
+                if line and line not in files:
+                    files.append(line)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Heuristic: decide whether a changed path is a test file based on its path and name.
+        """
+        normalized = path.replace('\\', '/').lower()
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        name = parts[-1]
+
+        # Any directory component that denotes tests
+        test_dirs = ('test', 'tests', 'spec', 'specs', '__tests__', 'testing')
+        if any(part in test_dirs for part in parts[:-1]):
+            return True
+
+        # Filename patterns across languages
+        if name.startswith('test_') or name == 'conftest.py':
+            return True
+        if name.endswith((
+            '_test.py', '_test.go', '_test.rs', '_test.cpp', '_test.cc', '_test.c',
+            '_spec.rb', '.spec.js', '.spec.ts', '.spec.jsx', '.spec.tsx',
+            '.test.js', '.test.ts', '.test.jsx', '.test.tsx',
+            'test.java', 'tests.java', 'test.cpp', 'test.cc',
+        )):
+            return True
+        return False
+
+    def _has_source_edit(self):
+        """
+        Return True only if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in self._changed_files())
+
     def forward(self):
