@@ -0,0 +1,55 @@
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_timed",
+        "description": """Run a shell command under a hard timeout and report its output and elapsed time.\n
+* Use this for performance checks (e.g. running a solution on large inputs) so that slow or hanging programs cannot block the session.\n
+* Returns the stdout and stderr, the exit code and the elapsed wall-clock time.\n
+* If the command does not finish within timeout_seconds it is killed and the result starts with 'TIMEOUT'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python3 solution.py < input.txt'."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Hard timeout in seconds after which the command is killed (e.g. 10)."
+                }
+            },
+            "required": ["command", "timeout_seconds"]
+        }
+    }
+
+def tool_function(command, timeout_seconds):
+    start = time.time()
+    try:
+        timeout = float(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout = 10.0
+    try:
+        result = subprocess.run(
+            command, shell=True, capture_output=True, text=True,
+            timeout=timeout, executable='/bin/bash', start_new_session=True,
+        )
+        elapsed = time.time() - start
+        return (
+            f"exit_code: {result.returncode}\n"
+            f"elapsed_seconds: {elapsed:.3f}\n"
+            f"--- stdout ---\n{result.stdout}\n"
+            f"--- stderr ---\n{result.stderr}"
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout.decode('utf-8', errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+        err = e.stderr.decode('utf-8', errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return (
+            f"TIMEOUT: command did not finish within {timeout} seconds (elapsed {elapsed:.3f}s) and was killed.\n"
+            f"--- partial stdout ---\n{out}\n"
+            f"--- partial stderr ---\n{err}"
+        )
+    except Exception as e:
+        return f"ERROR running command: {e}"
