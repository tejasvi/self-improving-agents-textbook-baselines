+def simple_completion(prompt, model=CLAUDE_MODEL, max_tokens=8192):
+    """
+    Plain single-turn LLM call with NO tools. Returns the response text ('' if empty).
+    Supports Claude (Anthropic/Bedrock/Vertex via create_client) and OpenAI models.
+    """
+    client, client_model = create_client(model)
+    if 'claude' in client_model:
+        response = client.messages.create(
+            model=client_model,
+            max_tokens=max_tokens,
+            messages=[{"role": "user", "content": prompt}],
+        )
+        parts = []
+        for block in response.content:
+            if getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                parts.append(block.text)
+        return "".join(parts)
+    if client_model.startswith('o3-'):
+        response = client.responses.create(model=client_model, input=prompt)
+        return response.output_text or ""
+    response = client.chat.completions.create(
+        model=client_model,
+        messages=[{"role": "user", "content": prompt}],
+    )
+    return response.choices[0].message.content or ""
+
