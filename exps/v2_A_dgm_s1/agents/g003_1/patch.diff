+    def _changed_files(self):
+        """
+        Return the list of files changed relative to base_commit, including
+        untracked (new) files. Only file names are returned.
+        """
+        files = []
+        try:
+            diff_out = subprocess.run(
+                ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+                capture_output=True, text=True, timeout=120,
+            )
+            files.extend(line.strip() for line in diff_out.stdout.splitlines() if line.strip())
+            untracked = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+                capture_output=True, text=True, timeout=120,
+            )
+            files.extend(line.strip() for line in untracked.stdout.splitlines() if line.strip())
+        except Exception as e:
+            safe_log(f"Could not list changed files: {e}")
+        # Deduplicate while preserving order
+        seen = set()
+        result = []
+        for f in files:
+            if f not in seen:
+                seen.add(f)
+                result.append(f)
+        return result
+
+    def _has_source_edit(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not _is_test_file(f) for f in self._changed_files())
