+TEST_DIR_NAMES = {"test", "tests", "__tests__", "spec"}
+TEST_BASENAME_PREFIXES = ("test_",)
+TEST_BASENAME_SUFFIXES = (
+    "_test.py", "_test.go", ".test.js", ".spec.js", "Test.java", "_test.rs", "_test.cpp",
+)
+
+def _is_test_file(path):
+    """
+    Heuristically decide whether a path refers to a test file.
+    """
+    normalized = path.replace("\\", "/")
+    parts = [p for p in normalized.split("/") if p]
+    if not parts:
+        return False
+    basename = parts[-1]
+    lower_dirs = [p.lower() for p in parts[:-1]]
+    if any(d in TEST_DIR_NAMES for d in lower_dirs):
+        return True
+    lower_base = basename.lower()
+    if any(lower_base.startswith(p) for p in TEST_BASENAME_PREFIXES):
+        return True
+    if any(basename.endswith(s) or lower_base.endswith(s.lower()) for s in TEST_BASENAME_SUFFIXES):
+        return True
+    return False
