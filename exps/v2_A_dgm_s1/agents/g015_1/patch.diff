+    def _has_tool_use(self, msg_history):
+        """
+        True if any assistant message contains a tool_use block (dict or object blocks).
+        """
+        def _get(obj, key):
+            if isinstance(obj, dict):
+                return obj.get(key)
+            return getattr(obj, key, None)
+
+        for msg in msg_history or []:
+            if _get(msg, 'role') != 'assistant':
+                continue
+            content = _get(msg, 'content')
+            if not isinstance(content, list):
+                continue
+            for block in content:
+                if _get(block, 'type') == 'tool_use':
+                    return True
+        return False
+
