+SOURCE_EXTENSIONS = (".py", ".js", ".go", ".rs", ".java", ".cpp")
+CANDIDATE_CONTENT_CHARS = 6000
+CANDIDATE_MAX_FILES = 4
+STUB_PATTERN = re.compile(r"\bpass\b|TODO|unimplemented|NotImplemented")
+
+def _block_text(block):
+    """
+    Return (is_text_block, text) for a content block, which may be a dict or an SDK object.
+    """
+    if isinstance(block, dict):
+        btype = block.get('type')
+        text = block.get('text')
+    else:
+        btype = getattr(block, 'type', None)
+        text = getattr(block, 'text', None)
+    return btype == 'text' or (btype is None and text is not None), text
+
+def _is_empty_assistant_message(msg):
+    """
+    True if msg is an assistant message whose text content is empty or whitespace-only.
+    Messages carrying non-text blocks (e.g. tool_use) are never considered empty.
+    """
+    if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+        return False
+    content = msg.get('content')
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return not content.strip()
+    texts = []
+    for block in content:
+        is_text, text = _block_text(block)
+        if not is_text:
+            return False
+        texts.append(text or '')
+    return not ''.join(texts).strip()
+
+def _sanitize_history(msg_history):
+    """
+    Return a copy of msg_history with trailing empty assistant messages removed.
+    The input list is never mutated.
+    """
+    if not msg_history:
+        return []
+    cleaned = list(msg_history)
+    num_trailing_empty = 0
+    for msg in reversed(cleaned):
+        if _is_empty_assistant_message(msg):
+            num_trailing_empty += 1
+        else:
+            break
+    if num_trailing_empty:
+        cleaned = cleaned[:len(cleaned) - num_trailing_empty]
+    return cleaned
+
+def _read_text_file(path, max_chars=None):
+    try:
+        with open(path, 'r', encoding='utf-8', errors='replace') as f:
+            content = f.read() if max_chars is None else f.read(max_chars)
+    except Exception:
+        return None
+    if max_chars is not None and len(content) >= max_chars:
+        content += "\n...[truncated]"
+    return content
+
