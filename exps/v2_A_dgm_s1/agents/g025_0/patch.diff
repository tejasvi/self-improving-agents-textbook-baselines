+    def _find_candidate_files(self):
+        """
+        Locate non-test source files in the repo (tracked plus untracked) that are likely
+        to hold the implementation, and return their contents as a formatted string.
+        Files named solution.* come first, then files containing a stub marker
+        (pass / TODO / unimplemented / NotImplemented).
+        """
+        names = []
+        try:
+            for args in (["git", "-C", self.git_tempdir, "ls-files"],
+                         ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]):
+                out = subprocess.run(args, capture_output=True, text=True, timeout=120)
+                names.extend(line.strip() for line in out.stdout.splitlines() if line.strip())
+        except Exception as e:
+            safe_log(f"Could not list candidate files: {e}")
+
+        seen = set()
+        candidates = []
+        for name in names:
+            if name in seen or _is_test_file(name) or not name.endswith(SOURCE_EXTENSIONS):
+                continue
+            seen.add(name)
+            candidates.append(name)
+
+        def is_solution(name):
+            return os.path.basename(name).startswith("solution.")
+
+        def has_stub(name):
+            content = _read_text_file(os.path.join(self.git_tempdir, name), max_chars=CANDIDATE_CONTENT_CHARS)
+            return bool(content) and STUB_PATTERN.search(content) is not None
+
+        preferred = [n for n in candidates if is_solution(n)]
+        others = [n for n in candidates if not is_solution(n) and has_stub(n)]
+        chosen = (preferred + others)[:CANDIDATE_MAX_FILES]
+
+        parts = []
+        for name in chosen:
+            content = _read_text_file(os.path.join(self.git_tempdir, name), max_chars=CANDIDATE_CONTENT_CHARS)
+            if content is None:
+                continue
+            parts.append(f"### File: {name}\n```\n{content}\n```")
+        return "\n\n".join(parts)
+
