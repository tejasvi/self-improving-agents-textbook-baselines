diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..742d098
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,180 @@
+import os
+import re
+import signal
+import subprocess
+
+DEFAULT_TIMEOUT = 10
+
+MULTI_ANSWER_PATTERNS = [
+    r"any of them (will|may|can) be accepted",
+    r"any of (these|those|them)",
+    r"any valid",
+    r"any answer",
+    r"any solution",
+    r"multiple (solutions|answers|outputs)",
+    r"(there may be|there can be|there could be) (multiple|several|more than one)",
+    r"print any",
+    r"output any",
+]
+
+SAMPLE_PATTERN = re.compile(
+    r"Sample Input\s*(\d+)[^\n]*\n(.*?)Sample Output\s*\1[^\n]*\n(.*?)(?=Sample Input\s*\d+|\Z)",
+    re.DOTALL | re.IGNORECASE,
+)
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Check a solution against all 'Sample Input k' / 'Sample Output k' pairs of a problem statement.\n
+* Runs the solution command on each sample input and compares its output with the sample output.\n
+* Comparison is whitespace-normalized, and the report shows PASS or FAIL per sample with expected and actual output.\n
+* If the statement allows multiple valid answers, a warning is added: the official grader may still compare exactly, so reproduce the sample output exactly where a natural canonical choice exists.\n
+* `problem_file` may be a path to a file containing the statement, or the statement text itself.\n
+* `solution_path` may be a solution file (e.g. /repo/solution.py) or a directory containing solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_file": {
+                    "type": "string",
+                    "description": "Path to a file containing the problem statement, or the problem statement text itself."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (e.g. /repo/solution.py) or to a directory containing solution.py."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Command used to run the solution, executed in the solution's directory. Defaults to 'python3 solution.py' (or 'python3 <file>' when solution_path is a file)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample timeout in seconds. Defaults to 10."
+                }
+            },
+            "required": ["problem_file", "solution_path"]
+        }
+    }
+
+
+def _load_problem_text(problem_file: str) -> str:
+    """Return the statement text: file contents if the path exists, else the input itself."""
+    try:
+        if os.path.isfile(problem_file):
+            with open(problem_file, "r", encoding="utf-8", errors="replace") as f:
+                return f.read()
+    except Exception:
+        pass
+    return problem_file
+
+
+def parse_samples(text: str):
+    """Return a list of (index, input_text, expected_output_text) tuples."""
+    samples = []
+    for m in SAMPLE_PATTERN.finditer(text):
+        idx = m.group(1)
+        inp = _strip_fences(m.group(2))
+        out = _strip_fences(m.group(3))
+        samples.append((idx, inp, out))
+    return samples
+
+
+def _strip_fences(block: str) -> str:
+    lines = [ln for ln in block.strip("\n").splitlines() if not ln.strip().startswith("```")]
+    return "\n".join(lines).strip("\n")
+
+
+def _multi_answer_note(text: str) -> bool:
+    lowered = text.lower()
+    return any(re.search(p, lowered) for p in MULTI_ANSWER_PATTERNS)
+
+
+def _resolve_run(solution_path: str, command: str = None):
+    """Return (cwd, command_string) for running the solution."""
+    if os.path.isdir(solution_path):
+        cwd = solution_path
+        default_cmd = "python3 solution.py"
+    else:
+        cwd = os.path.dirname(os.path.abspath(solution_path))
+        default_cmd = f"python3 {os.path.basename(solution_path)}"
+    return cwd, (command.strip() if command and command.strip() else default_cmd)
+
+
+def _run_sample(cmd, cwd, inp, timeout):
+    """Run cmd with inp on stdin. Returns (stdout, stderr, returncode); stdout is None on timeout."""
+    proc = subprocess.Popen(
+        cmd, shell=True, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE, text=True, start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(input=inp + "\n", timeout=timeout)
+        return out, err, proc.returncode
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            pass
+        try:
+            proc.communicate(timeout=5)
+        except Exception:
+            pass
+        return None, f"Timed out after {timeout} seconds", None
+
+
+def tool_function(problem_file: str, solution_path: str, command: str = None, timeout: int = DEFAULT_TIMEOUT) -> str:
+    try:
+        if timeout is None:
+            timeout = DEFAULT_TIMEOUT
+        text = _load_problem_text(problem_file)
+        samples = parse_samples(text)
+        if not samples:
+            return "No 'Sample Input k' / 'Sample Output k' pairs found in the problem statement."
+
+        cwd, cmd = _resolve_run(solution_path, command)
+        multi = _multi_answer_note(text)
+
+        lines = [f"Ran `{cmd}` in {cwd} on {len(samples)} sample(s)."]
+        all_pass = True
+        exact_mismatch_with_multi = False
+
+        for idx, inp, expected in samples:
+            actual, stderr, rc = _run_sample(cmd, cwd, inp, timeout)
+
+            if actual is not None and actual.split() == expected.split():
+                lines.append(f"Sample {idx}: PASS")
+                continue
+
+            all_pass = False
+            if actual is not None and actual.strip() != expected.strip() and multi:
+                exact_mismatch_with_multi = True
+            lines.append(f"Sample {idx}: FAIL")
+            lines.append("Expected:")
+            lines.append(expected)
+            lines.append("Actual:")
+            lines.append(actual if actual is not None else "(no output)")
+            if rc is not None and rc != 0:
+                lines.append(f"Exit code: {rc}")
+            if stderr and stderr.strip():
+                lines.append("Stderr:")
+                lines.append(stderr.strip())
+
+        lines.append("")
+        if all_pass:
+            lines.append("Summary: all samples PASS (exact match after whitespace normalization).")
+        else:
+            lines.append("Summary: some samples FAIL.")
+
+        if exact_mismatch_with_multi:
+            lines.append(
+                "WARNING: The problem appears to allow multiple valid answers, but the grader may still "
+                "compare output exactly. Do not dismiss mismatches as acceptable. Adjust the algorithm "
+                "(ordering, tie-breaking, canonical choice) so that the sample outputs are reproduced exactly, "
+                "where a natural canonical choice exists."
+            )
+        return "\n".join(lines)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    print(tool_function("Sample Input 1\n3\nSample Output 1\n3\n", "/tmp/solution.py"))
