+++ b/tools/stress_test.py
@@ -0,0 +1,107 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution program against a brute-force reference program using random inputs.
+
+* solution_path: the program under test (Python file that reads stdin and writes stdout).
+* brute_path: a naive, obviously-correct reference program with the same stdin/stdout contract.
+* generator_path: a Python script that prints ONE random test input to stdout and takes an integer seed as argv[1].
+* iterations: number of seeds to test (seeds 0..iterations-1).
+* timeout_sec: per-run timeout in seconds.
+
+For each seed, the generator is run to produce an input, then both programs are run on that input. Stripped stdout is compared.
+On the first mismatch, runtime error or timeout, a report with the seed, input, expected (brute) output, actual output and stderr is returned.
+If every iteration passes, a success message is returned.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python program to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python program."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python script that prints one random test input to stdout; it takes the integer seed as argv[1]."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0..iterations-1). Default 200."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run. Default 5."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _run(cmd, stdin_text, timeout_sec):
+    return subprocess.run(
+        cmd,
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        timeout=timeout_sec,
+    )
+
+
+def tool_function(solution_path, brute_path, generator_path, iterations=200, timeout_sec=5):
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        iterations = 200
+    try:
+        timeout_sec = float(timeout_sec)
+    except (TypeError, ValueError):
+        timeout_sec = 5.0
+
+    for seed in range(iterations):
+        # 1) Generate the input
+        try:
+            gen = _run(['python3', generator_path, str(seed)], None, timeout_sec)
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out at seed {seed}.\nGenerator: {generator_path}"
+        if gen.returncode != 0:
+            return (f"Generator crashed at seed {seed} (exit code {gen.returncode}).\n"
+                    f"stderr:\n{gen.stderr}")
+        test_input = gen.stdout
+
+        # 2) Run the brute-force reference
+        try:
+            brute = _run(['python3', brute_path], test_input, timeout_sec)
+        except subprocess.TimeoutExpired:
+            return (f"Brute-force timed out at seed {seed}.\n"
+                    f"Input:\n{test_input}")
+        if brute.returncode != 0:
+            return (f"Brute-force crashed at seed {seed} (exit code {brute.returncode}).\n"
+                    f"Input:\n{test_input}\nstderr:\n{brute.stderr}")
+
+        # 3) Run the solution under test
+        try:
+            sol = _run(['python3', solution_path], test_input, timeout_sec)
+        except subprocess.TimeoutExpired:
+            return (f"Solution timed out at seed {seed}.\n"
+                    f"Input:\n{test_input}\nExpected output (brute force):\n{brute.stdout}")
+        if sol.returncode != 0:
+            return (f"Solution crashed at seed {seed} (exit code {sol.returncode}).\n"
+                    f"Input:\n{test_input}\nExpected output (brute force):\n{brute.stdout}\n"
+                    f"Solution stdout:\n{sol.stdout}\nstderr:\n{sol.stderr}")
+
+        # 4) Compare
+        if sol.stdout.strip() != brute.stdout.strip():
+            return (f"Mismatch at seed {seed}.\n"
+                    f"Input:\n{test_input}\n"
+                    f"Expected output (brute force):\n{brute.stdout}\n"
+                    f"Actual output (solution):\n{sol.stdout}\n"
+                    f"Solution stderr:\n{sol.stderr}")
+
+    return f"All {iterations} tests passed"
