diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..07bc6e4
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,165 @@
+import subprocess
+import sys
+import json
+import os
+import textwrap
+
+def tool_info():
+    """Return metadata for the stress_test tool.
+
+    Required properties:
+        - solution_path (string): Path to the candidate solution script.
+        - brute_path (string): Path to the brute‑force reference solution script.
+        - generator_path (string): Path to the input generator script.
+        - checker_path (string, optional): Path to a checker script for custom validation.
+        - iterations (integer, default 200): Number of seeds to test.
+        - timeout (integer, default 10): Seconds allowed per run.
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run a generator, the candidate solution and a brute‑force reference on many seeds, optionally checking with a custom validator.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script to be tested."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute‑force reference script."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator script that writes a single test case to stdout. It will be invoked as: python <generator_path> <seed>."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a checker script. Called as: python <checker_path> <input_file> <solution_output_file> <brute_output_file>. Exit code 0 means the solution is correct.",
+                    "default": None
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of seeds to test.",
+                    "default": 200
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each run (solution and brute).",
+                    "default": 10
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+def _run_script(path: str, input_data: str, timeout: int) -> tuple:
+    """Execute a Python script located at *path* with *input_data* as stdin.
+    Returns (stdout, stderr, returncode)."""
+    try:
+        result = subprocess.run(
+            [sys.executable, path],
+            input=input_data,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return result.stdout.strip(), result.stderr.strip(), result.returncode
+    except subprocess.TimeoutExpired:
+        return "", f"TIMEOUT after {timeout}s", -1
+    except Exception as e:
+        return "", f"Error: {str(e)}", -1
+
+def tool_function(solution_path: str = None, brute_path: str = None, generator_path: str = None,
+                checker_path: str = None, iterations: int = 200, timeout: int = 10, **kwargs) -> str:
+    """Stress‑test *solution_path* against *brute_path* using *generator_path*.
+
+    If *checker_path* is supplied, it is used to validate the outputs; otherwise a plain
+    string equality check (after stripping) is performed.
+    The function stops at the first mismatch, crash or timeout and returns a detailed report.
+    """
+    # Handle raw JSON wrapper
+    if '_raw' in kwargs:
+        try:
+            raw = json.loads(kwargs['_raw'])
+            solution_path = raw.get('solution_path', solution_path)
+            brute_path = raw.get('brute_path', brute_path)
+            generator_path = raw.get('generator_path', generator_path)
+            checker_path = raw.get('checker_path', checker_path)
+            iterations = raw.get('iterations', iterations)
+            timeout = raw.get('timeout', timeout)
+        except Exception as e:
+            return f"Error parsing _raw JSON: {str(e)}"
+
+    # Basic argument validation
+    if not all([solution_path, brute_path, generator_path]):
+        return "Error: solution_path, brute_path and generator_path are required."
+
+    for seed in range(iterations):
+        # 1. Generate input
+        try:
+            gen_result = subprocess.run(
+                [sys.executable, generator_path, str(seed)],
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            gen_input = gen_result.stdout
+            if gen_result.returncode != 0:
+                return (f"Generator failed on seed {seed}\n"
+                        f"STDERR:\n{gen_result.stderr.strip()}\n"
+                        f"RETURN_CODE: {gen_result.returncode}")
+        except subprocess.TimeoutExpired:
+            return f"Generator TIMEOUT after {timeout}s on seed {seed}"
+        except Exception as e:
+            return f"Generator error on seed {seed}: {str(e)}"
+
+        # 2. Run solution and brute
+        sol_out, sol_err, sol_rc = _run_script(solution_path, gen_input, timeout)
+        brute_out, brute_err, brute_rc = _run_script(brute_path, gen_input, timeout)
+
+        # If either crashed or timed out, report immediately
+        if sol_rc != 0 or brute_rc != 0:
+            return (f"Non‑zero exit on seed {seed}\n"
+                    f"Solution rc={sol_rc}, stderr=\n{sol_err}\n"
+                    f"Brute rc={brute_rc}, stderr=\n{brute_err}\n"
+                    f"Input (truncated):\n{gen_input[:200]}")
+
+        # 3. Validate outputs
+        if checker_path:
+            input_file = f"/tmp/stress_input_{seed}.txt"
+            sol_file = f"/tmp/stress_sol_{seed}.txt"
+            brute_file = f"/tmp/stress_brute_{seed}.txt"
+            try:
+                with open(input_file, 'w') as f:
+                    f.write(gen_input)
+                with open(sol_file, 'w') as f:
+                    f.write(sol_out)
+                with open(brute_file, 'w') as f:
+                    f.write(brute_out)
+                chk_res = subprocess.run(
+                    [sys.executable, checker_path, input_file, sol_file, brute_file],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                if chk_res.returncode != 0:
+                    return (f"Checker reported mismatch on seed {seed}\n"
+                            f"Checker STDERR:\n{chk_res.stderr.strip()}\n"
+                            f"Input (truncated):\n{gen_input[:200]}\n"
+                            f"Solution output:\n{sol_out}\n"
+                            f"Brute output:\n{brute_out}")
+            finally:
+                for p in (input_file, sol_file, brute_file):
+                    try:
+                        os.remove(p)
+                    except Exception:
+                        pass
+        else:
+            if sol_out.strip() != brute_out.strip():
+                return (f"Output mismatch on seed {seed}\n"
+                        f"Input (truncated):\n{gen_input[:200]}\n"
+                        f"Solution output:\n{sol_out}\n"
+                        f"Brute output:\n{brute_out}")
+
+    return f"ALL {iterations} PASSED"
