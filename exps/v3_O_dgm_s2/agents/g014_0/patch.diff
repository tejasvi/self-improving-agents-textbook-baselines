index 0000000..c9bfd30
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,190 @@
+import subprocess
+import sys
+import time
+import importlib.util
+import os
+from typing import Any, Tuple
+
+
+def tool_info():
+    """Return metadata for the stress_test tool.
+
+    The tool runs a solution against a brute‑force reference on many randomly
+    generated inputs. It supports two execution modes:
+    1. **STDIN/STDOUT programs** – generator prints an input, solution and brute
+       read from stdin and write to stdout.
+    2. **Function‑style modules** – generator, brute, and solution expose Python
+       functions; the optional ``entry`` argument specifies the function to call
+       in the solution module (e.g. ``solve`` or ``Solution.maxLength``).
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run a stress test comparing a solution against a brute‑force reference on many generated cases.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script or module."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute‑force reference script or module."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the test‑case generator script or module."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of random cases to test.",
+                    "default": 500
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Total time budget in seconds for the whole stress test.",
+                    "default": 60
+                },
+                "entry": {
+                    "type": "string",
+                    "description": "Optional dotted entry point for function‑style solution, e.g. 'solve' or 'Solution.maxLength'.",
+                    "default": ""
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _load_module_from_path(path: str) -> Any:
+    """Dynamically load a Python module from *path* without adding it to sys.path."""
+    spec = importlib.util.spec_from_file_location("mod_" + os.path.basename(path), path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {path}")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)  # type: ignore
+    return mod
+
+
+def _call_solution(solution_mod: Any, entry: str, args: Tuple) -> Any:
+    """Call the solution according to *entry*.
+
+    If *entry* is empty, we assume the module is a script and will be executed
+    via ``subprocess`` elsewhere (this function will not be used).
+    """
+    if not entry:
+        raise ValueError("Entry point required for function‑style execution.")
+    # Resolve dotted name
+    parts = entry.split('.')
+    obj = solution_mod
+    for p in parts:
+        if not hasattr(obj, p):
+            raise AttributeError(f"{obj} has no attribute {p}")
+        obj = getattr(obj, p)
+    if callable(obj):
+        return obj(*args)
+    else:
+        raise TypeError(f"Entry point {entry} is not callable.")
+
+
+def tool_function(
+    solution_path: str,
+    brute_path: str,
+    generator_path: str,
+    num_cases: int = 500,
+    timeout: int = 60,
+    entry: str = "",
+) -> str:
+    """Execute a stress test.
+
+    Returns a string starting with ``PASS`` on success or ``FAIL`` on the first
+    mismatch. Crashes and timeouts are also reported.
+    """
+    start_total = time.time()
+    # Determine mode based on presence of entry and whether modules define expected functions
+    function_mode = bool(entry)
+
+    if function_mode:
+        # Load modules as Python objects
+        try:
+            gen_mod = _load_module_from_path(generator_path)
+            brute_mod = _load_module_from_path(brute_path)
+            sol_mod = _load_module_from_path(solution_path)
+        except Exception as e:
+            return f"FAIL loading modules: {e}"
+    else:
+        # Ensure scripts exist
+        for p in (solution_path, brute_path, generator_path):
+            if not os.path.isfile(p):
+                return f"FAIL missing file: {p}"
+
+    for seed in range(num_cases):
+        # Check overall timeout
+        if time.time() - start_total > timeout:
+            return f"FAIL timeout after {seed} cases (budget {timeout}s)"
+        try:
+            if function_mode:
+                # generator function `gen(seed)` returns args (tuple/list) or a single value
+                if not hasattr(gen_mod, "gen"):
+                    return "FAIL generator missing 'gen' function"
+                gen_args = gen_mod.gen(seed)
+                if not isinstance(gen_args, (list, tuple)):
+                    gen_args = (gen_args,)
+                # Run brute and solution with the same args
+                if not hasattr(brute_mod, "brute"):
+                    return "FAIL brute missing 'brute' function"
+                expected = brute_mod.brute(*gen_args)
+                got = _call_solution(sol_mod, entry, gen_args)
+            else:
+                # Run generator script with seed as command‑line argument
+                gen_res = subprocess.run(
+                    [sys.executable, generator_path, str(seed)],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                if gen_res.returncode != 0:
+                    return f"FAIL generator crashed on seed={seed}: {gen_res.stderr.strip()}"
+                input_data = gen_res.stdout
+                # Run brute force script
+                brute_res = subprocess.run(
+                    [sys.executable, brute_path],
+                    input=input_data,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                if brute_res.returncode != 0:
+                    return f"FAIL brute crashed on seed={seed}: {brute_res.stderr.strip()}"
+                expected = brute_res.stdout.strip()
+                # Run solution script
+                sol_res = subprocess.run(
+                    [sys.executable, solution_path],
+                    input=input_data,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                if sol_res.returncode != 0:
+                    return f"FAIL solution crashed on seed={seed}: {sol_res.stderr.strip()}"
+                got = sol_res.stdout.strip()
+            # Compare outputs (stringified)
+            if str(got) != str(expected):
+                # For function mode, we also want to capture the generated input for reporting
+                input_repr = gen_args if function_mode else input_data.strip().split('\n')[0]
+                return f"FAIL seed={seed} input={input_repr} expected={expected} got={got}"
+        except subprocess.TimeoutExpired:
+            return f"FAIL timeout on seed={seed}"
+        except Exception as e:
+            return f"FAIL exception on seed={seed}: {e}"
+    return f"PASS {num_cases} cases"
+
+if __name__ == "__main__":
+    # Simple manual test harness
+    import json, argparse
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--json", help="JSON string with arguments")
+    args = parser.parse_args()
+    if args.json:
+        params = json.loads(args.json)
+        print(tool_function(**params))
