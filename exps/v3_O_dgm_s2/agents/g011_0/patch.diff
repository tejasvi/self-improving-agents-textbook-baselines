@@ -0,0 +1,76 @@
+from typing import Dict, Any
+import os
+import subprocess
+import time
+
+
+def tool_info() -> Dict[str, Any]:
+    return {
+        "name": "run_tests",
+        "description": "Run solution against .in/.out test files in a workspace and report failures.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution script or executable."},
+                "workspace": {"type": "string", "description": "Directory containing test files (*.in and *.out)."},
+                "mode": {"type": "string", "description": "Mode of testing: samples, stress, perf, or all."},
+                "timeout": {"type": "integer", "description": "Maximum seconds to allow for each test case."}
+            },
+            "required": ["solution_path", "workspace"]
+        }
+    }
+
+
+def tool_function(solution_path: str, workspace: str, mode: str = "all", timeout: int = 5) -> str:
+    """Execute the solution on each *.in file in workspace and compare to *.out.
+    Returns a plain‑text report summarizing passed/failed cases and the first failure.
+    """
+    if not os.path.isdir(workspace):
+        return f"Error: workspace {workspace} does not exist."
+    in_files = sorted([f for f in os.listdir(workspace) if f.endswith('.in')])
+    if not in_files:
+        return "No .in test files found in workspace."
+    passed = 0
+    failed = 0
+    first_failure = None
+    max_time = 0.0
+    for in_file in in_files:
+        base = in_file[:-3]
+        out_file = base + '.out'
+        in_path = os.path.join(workspace, in_file)
+        expected_path = os.path.join(workspace, out_file)
+        try:
+            with open(in_path, 'r') as f_in:
+                inp = f_in.read()
+            start = time.time()
+            proc = subprocess.run(["python3", solution_path], input=inp, capture_output=True, text=True, timeout=timeout)
+            elapsed = time.time() - start
+            max_time = max(max_time, elapsed)
+            actual = proc.stdout.strip()
+            if os.path.isfile(expected_path):
+                with open(expected_path, 'r') as f_out:
+                    expected = f_out.read().strip()
+                if actual == expected:
+                    passed += 1
+                else:
+                    failed += 1
+                    if first_failure is None:
+                        first_failure = f"Input: {in_file}\nExpected: {expected}\nActual: {actual}"
+            else:
+                # No expected file; treat as pass if runs without error
+                passed += 1
+        except subprocess.TimeoutExpired:
+            failed += 1
+            if first_failure is None:
+                first_failure = f"Timeout on {in_file} after {timeout}s"
+        except Exception as e:
+            failed += 1
+            if first_failure is None:
+                first_failure = f"Error on {in_file}: {e}"
+    report_lines = []
+    report_lines.append(f"Passed: {passed}")
+    report_lines.append(f"Failed: {failed}")
+    if first_failure:
+        report_lines.append("First failure details:\n" + first_failure)
+    report_lines.append(f"Max runtime: {max_time:.3f}s")
+    return "\n".join(report_lines)
