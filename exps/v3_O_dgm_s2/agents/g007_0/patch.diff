diff --git a/tools/run_tests.py b/tools/run_tests.py
new file mode 100644
index 0000000..570611f
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,131 @@
+import subprocess
+import time
+import json
+from typing import List, Dict, Any
+
+def tool_info():
+    """Return the tool metadata for run_tests.
+
+    The tool runs a Python solution file against a list of test cases.
+    Each case must contain an "input" string and may optionally contain an
+    "expected_output" string. A per‑case timeout (seconds) can be specified.
+    """
+    return {
+        "name": "run_tests",
+        "description": "Run a Python solution file against multiple test cases with timeouts.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of test cases.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Standard input for the test case."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Expected standard output for the test case (optional)."
+                            }
+                        },
+                        "required": ["input"]
+                    }
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Per‑case timeout in seconds (default 5).",
+                    "default": 5
+                }
+            },
+            "required": ["solution_path", "cases"]
+        }
+    }
+
+def _run_single_case(solution_path: str, case: Dict[str, Any], timeout: float) -> Dict[str, Any]:
+    """Execute the solution for a single test case.
+
+    Returns a dictionary with keys: status, time, output, expected (if provided),
+    error (stderr), and a truncated diff when applicable.
+    """
+    start = time.time()
+    try:
+        completed = subprocess.run(
+            ["python3", solution_path],
+            input=case["input"],
+            text=True,
+            capture_output=True,
+            timeout=timeout,
+        )
+        elapsed = time.time() - start
+        stdout = completed.stdout.strip()
+        stderr = completed.stderr.strip()
+        result: Dict[str, Any] = {
+            "time": round(elapsed, 3),
+            "error": stderr,
+        }
+        if completed.returncode != 0:
+            result["status"] = "ERROR"
+            result["output"] = stdout
+            return result
+        # Success path
+        if "expected_output" in case:
+            expected = case["expected_output"].strip()
+            result["expected"] = expected
+            result["output"] = stdout
+            if stdout == expected:
+                result["status"] = "PASS"
+            else:
+                result["status"] = "FAIL"
+                # Provide truncated diff-like info
+                diff = f"Actual: {stdout[:200]}" if len(stdout) > 200 else f"Actual: {stdout}"
+                diff += f" | Expected: {expected[:200]}" if len(expected) > 200 else f" | Expected: {expected}"
+                result["diff"] = diff
+        else:
+            # No expected output – just report runtime and stdout
+            result["status"] = "OK"
+            result["output"] = stdout
+        return result
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start
+        return {
+            "status": "TIMEOUT",
+            "time": round(elapsed, 3),
+            "error": "",
+            "output": "",
+        }
+    except Exception as e:
+        elapsed = time.time() - start
+        return {
+            "status": "ERROR",
+            "time": round(elapsed, 3),
+            "error": str(e),
+            "output": "",
+        }
+
+def tool_function(solution_path: str, cases: List[Dict[str, Any]], timeout_sec: float = 5) -> str:
+    """Run the provided solution against all test cases.
+
+    Returns a human‑readable multiline string summarizing each case.
+    """
+    reports = []
+    for idx, case in enumerate(cases, start=1):
+        res = _run_single_case(solution_path, case, timeout_sec)
+        header = f"Case {idx}: {res.get('status', 'UNKNOWN')} (time: {res.get('time', 'N/A')}s)"
+        details = []
+        if "output" in res:
+            details.append(f"Output: {res['output']}")
+        if "expected" in res:
+            details.append(f"Expected: {res['expected']}")
+        if "diff" in res:
+            details.append(f"Diff: {res['diff']}")
+        if res.get("error"):
+            details.append(f"Stderr: {res['error']}")
+        reports.append(header + ("\n  " + "\n  ".join(details) if details else ""))
+    return "\n".join(reports)
