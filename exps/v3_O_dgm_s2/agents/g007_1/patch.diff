index 0000000..30cbfcc
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,88 @@
+import subprocess
+import json
+from typing import List, Dict
+
+def tool_info():
+    """Return tool metadata for the run_tests tool.
+
+    The tool runs a Python solution against a list of test cases.
+    """
+    return {
+        "name": "run_tests",
+        "description": "Run a Python solution file against provided test cases and report results.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to test."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test case objects.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Input to be fed to stdin"},
+                            "expected_output": {"type": "string", "description": "Expected stdout output"}
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum seconds to allow each test case to run.",
+                    "default": 5
+                }
+            },
+            "required": ["file_path", "test_cases"]
+        }
+    }
+
+def _normalize_output(text: str) -> List[str]:
+    """Normalize output by stripping and splitting on whitespace tokens.
+    Returns a list of tokens for comparison.
+    """
+    return text.strip().split()
+
+def _compare_output(actual: str, expected: str) -> bool:
+    return _normalize_output(actual) == _normalize_output(expected)
+
+def tool_function(file_path: str, test_cases: List[Dict[str, str]], timeout_sec: float = 5) -> str:
+    """Execute the given Python file against each test case.
+
+    Returns a multiline report indicating PASS/FAIL/TIMEOUT/ERROR for each case.
+    """
+    reports = []
+    for idx, case in enumerate(test_cases, start=1):
+        inp = case.get("input", "")
+        exp = case.get("expected_output", "")
+        try:
+            result = subprocess.run(
+                ["python3", file_path],
+                input=inp,
+                capture_output=True,
+                text=True,
+                timeout=timeout_sec,
+            )
+        except subprocess.TimeoutExpired:
+            reports.append(f"Case {idx}: TIMEOUT (>{timeout_sec}s)")
+            continue
+        except Exception as e:
+            reports.append(f"Case {idx}: ERROR while executing: {e}")
+            continue
+        # Determine if runtime error
+        if result.returncode != 0:
+            err = result.stderr.strip()
+            reports.append(
+                f"Case {idx}: RUNTIME ERROR (exit {result.returncode})\nStderr: {err}\nStdout: {result.stdout.strip()}"
+            )
+            continue
+        actual_out = result.stdout
