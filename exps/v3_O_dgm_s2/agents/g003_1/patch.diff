index 0000000..95b6f39
--- /dev/null
+++ b/tools/run_solution.py
@@ -0,0 +1,83 @@
+# Tool to run a Python solution script with optional stdin and timeout
+import subprocess
+import sys
+import os
+from typing import Optional
+
+def tool_info():
+    """Return the tool metadata according to the required schema."""
+    return {
+        "name": "run_solution",
+        "description": "Run a Python script (solution) with given stdin text or a stdin file, enforcing a timeout.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "script_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python script to execute."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to provide to the program via standard input."
+                },
+                "stdin_file": {
+                    "type": "string",
+                    "description": "Path to a file whose content should be used as stdin (optional, overrides stdin_text if provided)."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum number of seconds to allow the script to run."
+                }
+            },
+            "required": ["script_path"]
+        }
+    }
+
+def _read_stdin(stdin_text: Optional[str], stdin_file: Optional[str]):
+    if stdin_file and os.path.exists(stdin_file):
+        with open(stdin_file, "rb") as f:
+            return f.read()
+    if stdin_text is not None:
+        return stdin_text.encode()
+    return None
+
+def tool_function(script_path: str, stdin_text: str = "", stdin_file: str = None, timeout_sec: float = 60.0) -> str:
+    """Execute the Python script and return a concise result.
+
+    The return string contains:
+      * exit code (or "TIMEOUT")
+      * elapsed seconds (rounded to 2 decimals)
+      * first 500 characters of stdout (truncated with "..." if longer)
+      * first 500 characters of stderr (truncated similarly)
+    """
+    import time
+    stdin_data = _read_stdin(stdin_text, stdin_file)
+    start = time.time()
+    try:
+        result = subprocess.run(
+            [sys.executable, script_path],
+            input=stdin_data,
+            capture_output=True,
+            text=False,
+            timeout=timeout_sec,
+        )
+        elapsed = time.time() - start
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout_sec}s"
+    except Exception as e:
+        return f"ERROR: {str(e)}"
+
+    def truncate(data: bytes) -> str:
+        s = data.decode(errors="ignore")
+        if len(s) > 500:
+            return s[:500] + "..."
+        return s
+
+    stdout = truncate(result.stdout or b"")
+    stderr = truncate(result.stderr or b"")
+    exit_code = result.returncode
+    return (
+        f"exit_code={exit_code} elapsed={elapsed:.2f}s\n"
+        f"stdout:\n{stdout}\n"
+        f"stderr:\n{stderr}"
+    )
