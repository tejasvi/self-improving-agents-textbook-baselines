diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..393bda7
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,173 @@
+import importlib.util
+import json
+import traceback
+import random
+import sys
+import os
+import time
+
+
+def tool_info():
+    """Return metadata for the stress_test tool.
+
+    The tool runs random test cases generated by a user‑provided generator
+    against a solution implementation and a brute‑force reference, reporting
+    the first mismatch (or confirming that all tests passed).
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run randomized stress tests comparing a solution to a brute‑force reference.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python file containing the solution implementation."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the class that implements the method (if any). Optional when the solution is a plain function.",
+                    "default": ""
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method or function to invoke for the solution."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python file containing the brute‑force reference implementation."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python file exposing a function `gen(rng)` returning a list of arguments for the test case."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run.",
+                    "default": 500
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum total time (seconds) allowed for the whole stress run.",
+                    "default": 30
+                }
+            },
+            "required": ["solution_path", "method_name", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _load_module_from_path(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def tool_function(
+    solution_path: str,
+    method_name: str,
+    brute_path: str,
+    generator_path: str,
+    class_name: str = "",
+    num_tests: int = 500,
+    timeout: int = 30,
+) -> str:
+    """Execute stress testing and return a concise report.
+
+    The function loads three modules:
+    * solution – either a class with ``method_name`` or a plain function.
+    * brute   – a module exposing the same callable name.
+    * generator – a module exposing ``gen(rng)`` which returns a list of args.
+
+    It runs ``num_tests`` random cases (or until ``timeout`` seconds elapse),
+    comparing the outputs. The first failing case (shortest ``repr``) is
+    reported. If every case matches, the string ``ALL PASSED`` is returned.
+    """
+    start_time = time.time()
+    try:
+        # Load modules
+        solution_mod = _load_module_from_path(solution_path, "solution_mod")
+        brute_mod = _load_module_from_path(brute_path, "brute_mod")
+        gen_mod = _load_module_from_path(generator_path, "gen_mod")
+    except Exception as e:
+        return f"Error loading modules: {e}\n{traceback.format_exc()}"
+
+    # Resolve callables
+    try:
+        if class_name:
+            solution_cls = getattr(solution_mod, class_name)
+            solution_callable = getattr(solution_cls(), method_name)
+        else:
+            solution_callable = getattr(solution_mod, method_name)
+    except Exception as e:
+        return f"Error retrieving solution callable: {e}\n{traceback.format_exc()}"
+    try:
+        if class_name:
+            brute_cls = getattr(brute_mod, class_name)
+            brute_callable = getattr(brute_cls(), method_name)
+        else:
+            brute_callable = getattr(brute_mod, method_name)
+    except Exception as e:
+        return f"Error retrieving brute callable: {e}\n{traceback.format_exc()}"
+    if not hasattr(gen_mod, "gen"):
+        return "Generator module must define a function named 'gen(rng)'."
+    gen_func = getattr(gen_mod, "gen")
+
+    rng = random.Random(0)  # deterministic seed
+    best_fail = None
+    for i in range(num_tests):
+        # Timeout check
+        if timeout and (time.time() - start_time) > timeout:
+            return f"Timeout after {timeout}s after {i} tests."
+        try:
+            args = gen_func(rng)
+            if not isinstance(args, (list, tuple)):
+                return f"Generator returned non‑list/tuple args on iteration {i}: {args}"
+        except Exception as e:
+            return f"Error in generator on iteration {i}: {e}\n{traceback.format_exc()}"
+        try:
+            sol_res = solution_callable(*args)
+        except Exception as e:
+            tb = traceback.format_exc()
+            return f"Exception in solution on args {args!r}: {e}\n{tb}"
+        try:
+            brute_res = brute_callable(*args)
+        except Exception as e:
+            tb = traceback.format_exc()
+            return f"Exception in brute on args {args!r}: {e}\n{tb}"
+        if sol_res != brute_res:
+            # Record this failure; keep the one with shortest repr
+            fail_repr = repr(args)
+            if best_fail is None or len(fail_repr) < len(best_fail[0]):
+                best_fail = (fail_repr, brute_res, sol_res)
+            # continue to find potentially shorter failing case
+    if best_fail:
+        args_repr, expected, actual = best_fail
+        return (
+            f"FAIL\nInput: {args_repr}\nExpected: {expected}\nActual: {actual}"
+        )
+    return "ALL PASSED"
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser(description=tool_info()["description"])
+    parser.add_argument("--solution_path", required=True)
+    parser.add_argument("--class_name", default="")
+    parser.add_argument("--method_name", required=True)
+    parser.add_argument("--brute_path", required=True)
+    parser.add_argument("--generator_path", required=True)
+    parser.add_argument("--num_tests", type=int, default=500)
+    parser.add_argument("--timeout", type=int, default=30)
+    args = parser.parse_args()
+    print(tool_function(
+        solution_path=args.solution_path,
+        class_name=args.class_name,
+        method_name=args.method_name,
+        brute_path=args.brute_path,
+        generator_path=args.generator_path,
+        num_tests=args.num_tests,
+        timeout=args.timeout,
+    ))
