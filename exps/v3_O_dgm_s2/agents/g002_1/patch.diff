@@ -0,0 +1,91 @@
+import subprocess
+import sys
+import time
+
+
+def tool_info():
+    """Return tool metadata for the run_python tool.
+
+    The schema follows the required format:
+    - name: tool name
+    - description: brief description
+    - input_schema: JSON schema with required properties.
+    """
+    return {
+        "name": "run_python",
+        "description": "Run a Python script with optional stdin and timeout, returning stdout, stderr, exit code, and execution time.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python script to execute."
+                },
+                "stdin": {
+                    "type": "string",
+                    "description": "String to provide as standard input to the script.",
+                    "default": ""
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum execution time in seconds.",
+                    "default": 10
+                }
+            },
+            "required": ["path"]
+        }
+    }
+
+
+def tool_function(path: str, stdin: str = "", timeout: int = 10) -> str:
+    """Execute a Python script located at *path*.
+
+    Parameters
+    ----------
+    path: str
+        Absolute path to the Python script.
+    stdin: str, optional
+        Input text to feed to the script's standard input.
+    timeout: int, optional
+        Maximum number of seconds to allow execution.
+
+    Returns
+    -------
+    str
+        A formatted string containing stdout, stderr (if any), the exit code, and the elapsed time.
+        On timeout, a clear message is returned.
+    """
+    start = time.time()
+    try:
+        result = subprocess.run(
+            [sys.executable, path],
+            input=stdin,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        elapsed = time.time() - start
+        stdout = result.stdout.strip()
+        stderr = result.stderr.strip()
+        retcode = result.returncode
+        parts = []
+        if stdout:
+            parts.append(f"STDOUT:\n{stdout}")
+        if stderr:
+            parts.append(f"STDERR:\n{stderr}")
+        parts.append(f"RETURN_CODE: {retcode}")
+        parts.append(f"ELAPSED_TIME: {elapsed:.3f}s")
+        return "\n".join(parts)
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s"
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser(description="Run a Python script with optional stdin and timeout.")
+    parser.add_argument("path", help="Path to the script")
+    parser.add_argument("--stdin", default="", help="Standard input for the script")
+    parser.add_argument("--timeout", type=int, default=10, help="Timeout in seconds")
+    args = parser.parse_args()
+    print(tool_function(args.path, stdin=args.stdin, timeout=args.timeout))
