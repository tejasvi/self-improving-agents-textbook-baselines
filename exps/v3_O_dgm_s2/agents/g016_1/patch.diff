@@ -0,0 +1,182 @@
+# -*- coding: utf-8 -*-
+"""Stress test tool.
+
+Runs a generator script (seeded via argv) to produce an input, feeds it to a solution script
+and a brute‑force reference implementation, and optionally validates the solution output
+with a checker script.
+
+If the checker is not supplied, the tool performs a literal string comparison of the
+solution's stdout and the brute's stdout.
+
+The tool returns a human‑readable string:
+* "ALL PASSED" – all generated tests matched.
+* Otherwise a description of the first failing case, including the seed, the generated
+  input, the solution output and the brute output (or the checker’s message).
+"""
+
+import subprocess
+import sys
+import json
+import os
+import tempfile
+from typing import Optional
+
+
+def tool_info():
+    """Return the metadata for the stress_test tool.
+
+    The schema follows the repository convention: ``name``, ``description`` and
+    ``input_schema`` with ``type``/``properties``/``required`` fields.
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run a random‑input generator, feed the input to both solution and brute scripts, optionally validate with a checker, and report the first mismatch.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the candidate solution script."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the brute‑force reference script."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to the input generator script. It must accept a single integer seed as argv[1]."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "(Optional) Path to a checker script. It receives three file arguments: input_file, solution_output_file, brute_output_file. Exit code 0 means the solution is valid."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run.",
+                    "default": 100
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each script execution.",
+                    "default": 5
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path", "num_tests"]
+        }
+    }
+
+
+def _run_script(path: str, input_data: str = "", timeout: int = 5) -> subprocess.CompletedProcess:
+    """Execute a Python script and return the CompletedProcess.
+
+    ``input_data`` is passed via stdin. ``timeout`` caps the execution time.
+    """
+    return subprocess.run(
+        [sys.executable, path],
+        input=input_data,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+
+
+def tool_function(
+    solution_path: str,
+    brute_path: str,
+    generator_path: str,
+    checker_path: Optional[str] = None,
+    num_tests: int = 100,
+    timeout: int = 5,
+) -> str:
+    """Perform stress testing.
+
+    Returns a string describing the outcome.
+    """
+    for seed in range(num_tests):
+        # 1. Generate input using the generator script.
+        try:
+            gen_res = subprocess.run(
+                [sys.executable, generator_path, str(seed)],
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            return f"Generator TIMEOUT at seed {seed} (>{timeout}s)"
+        if gen_res.returncode != 0:
+            return f"Generator failed at seed {seed}: stderr={gen_res.stderr.strip()}"
+        input_data = gen_res.stdout
+        # 2. Run candidate solution.
+        try:
+            sol_res = _run_script(solution_path, input_data, timeout)
+        except subprocess.TimeoutExpired:
+            return f"Solution TIMEOUT at seed {seed} (>{timeout}s)"
+        # 3. Run brute reference.
+        try:
+            brute_res = _run_script(brute_path, input_data, timeout)
+        except subprocess.TimeoutExpired:
+            return f"Brute TIMEOUT at seed {seed} (>{timeout}s)"
+        # 4. Validation.
+        if checker_path:
+            # Write temporary files for checker.
+            with tempfile.NamedTemporaryFile(delete=False, mode="w", suffix=".txt") as f_in,
+                 tempfile.NamedTemporaryFile(delete=False, mode="w", suffix=".txt") as f_sol,
+                 tempfile.NamedTemporaryFile(delete=False, mode="w", suffix=".txt") as f_brute:
+                f_in.write(input_data)
+                f_sol.write(sol_res.stdout)
+                f_brute.write(brute_res.stdout)
+                f_in.flush(); f_sol.flush(); f_brute.flush()
+                try:
+                    check_res = subprocess.run(
+                        [sys.executable, checker_path, f_in.name, f_sol.name, f_brute.name],
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout,
+                    )
+                finally:
+                    # Clean up temporary files.
+                    os.unlink(f_in.name)
+                    os.unlink(f_sol.name)
+                    os.unlink(f_brute.name)
+                if check_res.returncode != 0:
+                    # Checker signals failure.
+                    return (
+                        f"Checker rejected solution at seed {seed}.\n"
+                        f"INPUT:\n{input_data}\n"
+                        f"SOLVER_OUTPUT:\n{sol_res.stdout}\n"
+                        f"BRUTE_OUTPUT:\n{brute_res.stdout}\n"
+                        f"CHECKER_STDERR:\n{check_res.stderr.strip()}"
+                    )
+                # If returncode == 0, consider passed.
+            continue
+        else:
+            # Direct string comparison.
+            if sol_res.stdout.strip() != brute_res.stdout.strip():
+                return (
+                    f"Mismatch at seed {seed}.\n"
+                    f"INPUT:\n{input_data}\n"
+                    f"SOLVER_OUTPUT:\n{sol_res.stdout}\n"
+                    f"BRUTE_OUTPUT:\n{brute_res.stdout}\n"
+                )
+    return "ALL PASSED"
+
+
+if __name__ == "__main__":
+    # Simple CLI for manual testing.
+    import argparse
+    parser = argparse.ArgumentParser(description=tool_info()["description"])
+    parser.add_argument("solution_path")
+    parser.add_argument("brute_path")
+    parser.add_argument("generator_path")
+    parser.add_argument("--checker_path")
+    parser.add_argument("--num_tests", type=int, default=100)
+    parser.add_argument("--timeout", type=int, default=5)
+    args = parser.parse_args()
+    print(tool_function(
+        args.solution_path,
+        args.brute_path,
+        args.generator_path,
+        checker_path=args.checker_path,
+        num_tests=args.num_tests,
+        timeout=args.timeout,
+    ))
