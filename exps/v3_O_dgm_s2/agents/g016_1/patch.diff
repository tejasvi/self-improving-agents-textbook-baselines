@@ -0,0 +1,106 @@
+# -*- coding: utf-8 -*-
+"""Performance testing tool.
+
+Runs a solution script on a generated input (typically maximum size) and reports
+elapsed wall‑clock time and peak memory usage as measured by ``resource.getrusage``.
+If the execution exceeds the supplied timeout, the tool returns ``TIMEOUT``.
+"""
+
+import subprocess
+import sys
+import resource
+import time
+import os
+
+
+def tool_info():
+    """Metadata for the perf_test tool.
+
+    Returns a dict with ``name``, ``description`` and ``input_schema`` following the
+    repository convention.
+    """
+    return {
+        "name": "perf_test",
+        "description": "Run a solution script on a generated input and report elapsed time and peak memory usage.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution script."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to an input generator script. It should accept a size argument as argv[1]."
+                },
+                "size": {
+                    "type": "integer",
+                    "description": "Size argument passed to the generator (e.g., N for max‑size test).",
+                    "default": 1000000
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for the solution execution.",
+                    "default": 30
+                }
+            },
+            "required": ["solution_path", "generator_path", "size"]
+        }
+    }
+
+
+def tool_function(solution_path: str, generator_path: str, size: int = 1000000, timeout: int = 30) -> str:
+    """Execute *solution_path* on input generated by *generator_path*.
+
+    Returns a formatted string ``TIME: <seconds>s\nMEMORY: <kilobytes>KB`` or ``TIMEOUT``.
+    """
+    # Generate input first.
+    try:
+        gen_res = subprocess.run(
+            [sys.executable, generator_path, str(size)],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return f"Generator TIMEOUT after {timeout}s"
+    if gen_res.returncode != 0:
+        return f"Generator failed: stderr={gen_res.stderr.strip()}"
+    input_data = gen_res.stdout
+
+    # Run solution with resource monitoring.
+    start = time.time()
+    try:
+        proc = subprocess.Popen(
+            [sys.executable, solution_path],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        try:
+            stdout, stderr = proc.communicate(input=input_data, timeout=timeout)
+            elapsed = time.time() - start
+            # Peak memory usage (in kilobytes) from the child process.
+            usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+            peak_kb = usage.ru_maxrss
+            parts = [f"TIME: {elapsed:.3f}s", f"MEMORY: {peak_kb}KB"]
+            if stderr.strip():
+                parts.append(f"STDERR:\n{stderr.strip()}")
+            return "\n".join(parts)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            return f"TIMEOUT after {timeout}s"
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser(description=tool_info()["description"])
+    parser.add_argument("solution_path")
+    parser.add_argument("generator_path")
+    parser.add_argument("--size", type=int, default=1000000)
+    parser.add_argument("--timeout", type=int, default=30)
+    args = parser.parse_args()
+    print(tool_function(args.solution_path, args.generator_path, args.size, args.timeout))
