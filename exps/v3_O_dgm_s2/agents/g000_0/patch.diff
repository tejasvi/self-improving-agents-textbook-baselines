+
+    def _patch_touches_source(self, patch: str) -> bool:
+        """Return True if the patch modifies any non-test source file.
+
+        The function parses lines starting with ``diff --git a/<path> b/<path>``
+        and checks the target file name against common test file patterns.
+        Patterns considered test files are case‑insensitive matches for:
+
+        * ``test`` or ``tests`` in the path
+        * file names starting with ``test_``
+        * file names containing ``_test.``
+        * file names containing ``.spec.``
+
+        If any diff header does **not** match these patterns, the function
+        returns ``True`` indicating that the patch touches source code.
+        """
+        for line in patch.splitlines():
+            if line.startswith('diff --git'):
+                # Extract the b/ path (new file path)
+                parts = line.split(' b/')
+                if len(parts) < 2:
+                    continue
+                b_path = parts[1].strip()
+                # Normalise to lower‑case for pattern checks
+                lower = b_path.lower()
+                test_patterns = [
+                    'test',
+                    'tests',
+                    'test_',
+                    '_test.',
+                    '.spec.'
+                ]
+                if any(p in lower for p in test_patterns):
+                    # This diff block is likely a test file – ignore it
+                    continue
+                # If we reach here, it's a non‑test file
+                return True
+        return False
 
