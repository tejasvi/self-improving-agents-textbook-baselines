+import subprocess
+import time
+import json
+
+def tool_info():
+    return {
+        "name": "run_solution",
+        "description": "Run a Python solution script with given input and timeout, returning stdout, stderr, return code and elapsed time.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to execute."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "The input to feed to the solution via stdin."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum number of seconds to allow the solution to run."
+                }
+            },
+            "required": ["solution_path", "input_text"]
+        }
+    }
+
+def _truncate(text: str, limit: int = 10000) -> str:
+    """Truncate lengthy output to avoid huge responses."""
+    if len(text) > limit:
+        return text[:limit] + "\n<response clipped>"
+    return text
+
+def tool_function(solution_path: str, input_text: str, timeout_sec: float = 10.0) -> str:
+    """Execute the solution script.
+
+    Returns a formatted string containing stdout, stderr, return code and elapsed time.
+    If the process exceeds timeout_sec a clear TIMEOUT message is returned.
+    """
+    try:
+        start = time.time()
+        completed = subprocess.run(
+            ["python3", solution_path],
+            input=input_text.encode(),
+            capture_output=True,
+            timeout=timeout_sec,
+        )
+        elapsed = time.time() - start
+        stdout = _truncate(completed.stdout.decode(errors="ignore"))
+        stderr = _truncate(completed.stderr.decode(errors="ignore"))
+        result = (
+            f"--- Run Solution ---\n"
+            f"Path: {solution_path}\n"
+            f"Return Code: {completed.returncode}\n"
+            f"Elapsed: {elapsed:.3f}s\n"
+            f"--- STDOUT ---\n{stdout}\n"
+            f"--- STDERR ---\n{stderr}\n"
+        )
+        return result.strip()
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout_sec} seconds"
+    except Exception as e:
+        return f"Error running solution: {str(e)}"
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: python run_solution.py <solution_path>")
+    else:
+        print(tool_function(sys.argv[1], "", 5))
