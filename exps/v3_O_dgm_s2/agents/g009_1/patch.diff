+    def _classify_patch(self):
+        """Classify the current git diff against ``self.base_commit``.
+
+        Returns a tuple ``(status, files)`` where ``status`` is one of:
+        * ``'empty'`` – no files changed.
+        * ``'tests_only'`` – only test‑related files were changed.
+        * ``'ok'`` – at least one non‑test source file was modified.
+
+        ``files`` is the list of changed file paths extracted from the diff.
+        """
+        diff_text = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_files = []
+        for line in diff_text.splitlines():
+            if line.startswith('diff --git'):
+                parts = line.split(' ')
+                if len(parts) >= 4:
+                    # parts[2] = 'a/<path>', parts[3] = 'b/<path>'
+                    b_path = parts[3][2:]
+                    changed_files.append(b_path)
+        # Deduplicate while preserving order
+        seen = set()
+        uniq_files = []
+        for f in changed_files:
+            if f not in seen:
+                seen.add(f)
+                uniq_files.append(f)
+        def is_test_file(path: str) -> bool:
+            basename = os.path.basename(path)
+            # pattern matches
+            if (
+                (basename.startswith('test_') and basename.endswith('.py')) or
+                basename.endswith('_test.py') or
+                basename.endswith('.spec.js') or
+                basename.endswith('_test.go') or
+                basename.endswith('Test.java')
+            ):
+                return True
+            # any component is a test folder
+            for component in path.split(os.sep):
+                if component in {'test', 'tests', '__tests__'}:
+                    return True
+            return False
+        if not uniq_files:
+            return 'empty', []
+        if all(is_test_file(p) for p in uniq_files):
+            return 'tests_only', uniq_files
+        return 'ok', uniq_files
+
