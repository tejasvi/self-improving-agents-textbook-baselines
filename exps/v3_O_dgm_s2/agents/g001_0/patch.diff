+    def _snapshot_repo(self) -> str:
+        """Create a concise snapshot of the repository.
+
+        Walks ``self.git_tempdir`` while skipping hidden directories and common
+        build/artifact folders (e.g., ``.git``, ``node_modules``, ``build``). It
+        selects up to five source files (excluding obvious test files) that are
+        small or contain stub markers such as ``pass``, ``TODO`` or
+        ``NotImplemented``. For each selected file it includes up to 200 lines
+        or 8KB of content, whichever is smaller.
+        """
+        import os
+        max_files = 5
+        max_lines = 200
+        max_bytes = 8 * 1024
+        candidates = []
+        skip_dirs = {'.git', 'node_modules', 'build', '__pycache__'}
+        test_indicators = ['test', 'tests', '_test.', '.spec.']
+        for root, dirs, files in os.walk(self.git_tempdir):
+            # Prune skipped directories in-place
+            dirs[:] = [d for d in dirs if not d.startswith('.') and d not in skip_dirs]
+            for fname in files:
+                if fname.startswith('.'):  # skip hidden files
+                    continue
+                rel_path = os.path.relpath(os.path.join(root, fname), self.git_tempdir)
+                lower = rel_path.lower()
+                if any(t in lower for t in test_indicators):
+                    continue  # skip test files
+                full_path = os.path.join(root, fname)
+                try:
+                    size = os.path.getsize(full_path)
+                except OSError:
+                    continue
+                candidates.append((size, rel_path, full_path))
+        # Sort by size (smallest first)
+        candidates.sort(key=lambda x: x[0])
+        snapshot_parts = []
+        for _, rel_path, full_path in candidates[:max_files]:
+            try:
+                with open(full_path, 'r', encoding='utf-8', errors='replace') as f:
+                    content = f.read(max_bytes)
+                    lines = content.splitlines()[:max_lines]
+                    trimmed = "\n".join(lines)
+            except Exception as e:
+                trimmed = f"<error reading file: {e}>"
+            snapshot_parts.append(f"--- {rel_path} ---\n{trimmed}\n--- end of {rel_path} ---")
+        return "\n".join(snapshot_parts)
+
+    def _clean_history(self, msg_history):
+        """Remove trailing empty assistant messages and ensure history ends with a user message."""
+        cleaned = list(msg_history)
+        # Remove trailing assistant messages that are empty or whitespace-only
+        while cleaned and cleaned[-1].get('role') == 'assistant':
+            content_items = cleaned[-1].get('content', [])
+            # Content may be a list of dicts; extract text
+            text = ''
+            for item in content_items:
+                if isinstance(item, dict) and item.get('type') == 'text':
+                    text += item.get('text', '')
+            if not text.strip():
+                cleaned.pop()
+            else:
+                break
+        # Ensure the last message is from the user; if not, drop the last assistant
+        if cleaned and cleaned[-1].get('role') != 'user':
+            cleaned.pop()
+        return cleaned
+
