diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..09e4ce8
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,129 @@
+import re
+import subprocess
+import sys
+from typing import List, Dict
+
+
+def tool_info():
+    """Return metadata for the run_samples tool.
+
+    Required properties:
+        - solution_path (string): Path to the candidate solution script.
+        - problem_statement (string, optional): Full problem statement text from which to parse samples.
+        - samples (array of objects, optional): Each object should have 'input' and 'expected' strings.
+    """
+    return {
+        "name": "run_samples",
+        "description": "Run solution against sample tests extracted from a problem statement or provided explicitly.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script to be tested."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "Problem statement containing Sample Input/Output blocks.",
+                    "default": None
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Explicit list of samples (overrides parsing). Each entry must have 'input' and 'expected' fields.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Sample input"},
+                            "expected": {"type": "string", "description": "Sample expected output"}
+                        },
+                        "required": ["input", "expected"]
+                    },
+                    "default": None
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed per run.",
+                    "default": 10
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _run_solution(solution_path: str, inp: str, timeout: int = 10) -> tuple:
+    """Execute the solution script with given input.
+    Returns (stdout, stderr, returncode).
+    """
+    try:
+        result = subprocess.run(
+            [sys.executable, solution_path],
+            input=inp,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return result.stdout.strip(), result.stderr.strip(), result.returncode
+    except subprocess.TimeoutExpired:
+        return "", f"TIMEOUT after {timeout}s", -1
+    except Exception as e:
+        return "", f"ERROR: {str(e)}", -1
+
+
+def _parse_samples_from_statement(statement: str) -> List[Dict[str, str]]:
+    """Extract Sample Input/Output blocks using regex.
+    Supports formats like:
+        Sample Input 1
+        ...
+        Sample Output 1
+        ...
+    Returns list of dicts with 'input' and 'expected'.
+    """
+    # Pattern for input blocks
+    input_pat = re.compile(r"Sample Input\s*(\d+)\s*\n(?P<input>.*?)(?=\nSample Output\s*\1|\Z)", re.DOTALL)
+    inputs = {m.group(1): m.group('input').strip() for m in input_pat.finditer(statement)}
+    # Pattern for output blocks
+    output_pat = re.compile(r"Sample Output\s*(\d+)\s*\n(?P<output>.*?)(?=\nSample Input\s*\d+|\Z)", re.DOTALL)
+    outputs = {m.group(1): m.group('output').strip() for m in output_pat.finditer(statement)}
+    samples = []
+    for idx, inp in inputs.items():
+        exp = outputs.get(idx, "")
+        samples.append({"input": inp, "expected": exp})
+    return samples
+
+
+def tool_function(solution_path: str = None, problem_statement: str = None, samples: List[Dict[str, str]] = None, timeout: int = 10, **kwargs) -> str:
+    """Run the solution against each sample and return a PASS/FAIL report.
+    If `samples` is provided, it is used directly. Otherwise, if `problem_statement`
+    is provided, the function attempts to parse Sample Input/Output blocks.
+    Returns a multiline string report.
+    """
+    if not solution_path:
+        return "Error: solution_path is required."
+    # Determine sample list
+    if samples is None:
+        if not problem_statement:
+            return "Error: No samples provided and problem_statement is missing for parsing."
+        samples = _parse_samples_from_statement(problem_statement)
+        if not samples:
+            return "Error: Could not parse any samples from the problem statement."
+    report_lines = []
+    all_pass = True
+    for idx, sample in enumerate(samples, start=1):
+        inp = sample.get('input', '')
+        expected = sample.get('expected', '')
+        out, err, rc = _run_solution(solution_path, inp, timeout)
+        passed = (rc == 0 and out.strip() == expected.strip())
+        status = "PASS" if passed else "FAIL"
+        if not passed:
+            all_pass = False
+        report_lines.append(f"Sample {idx}: {status}")
+        report_lines.append(f"Input:\n{inp}")
+        report_lines.append(f"Expected:\n{expected}")
+        report_lines.append(f"Actual:\n{out}")
+        if err:
+            report_lines.append(f"Stderr:\n{err}")
+        report_lines.append("")
+    summary = "ALL PASS" if all_pass else "SOME FAIL"
+    report_lines.insert(0, f"Result: {summary}")
+    return "\n".join(report_lines)
