@@ -0,0 +1,180 @@
+import subprocess
+import os
+import json
+import sys
+import traceback
+from typing import Optional
+
+
+def tool_info():
+    """Return tool metadata for the evaluate_solution tool."""
+    return {
+        "name": "evaluate_solution",
+        "description": "Run a solution against generated tests and a brute-force reference, returning a report.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "repo_path": {
+                    "type": "string",
+                    "description": "Path to the repository containing the candidate solution."
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Directory containing test harness files: brute.py, gen.py, samples.json."
+                },
+                "class_name": {
+                    "type": ["string", "null"],
+                    "description": "If the problem expects a class method, the name of the class (e.g., 'Solution'). Null for script style."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random test iterations to run.",
+                    "default": 100
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for each test execution.",
+                    "default": 30
+                }
+            },
+            "required": ["repo_path", "tests_dir"]
+        }
+    }
+
+
+def _run_subprocess(cmd, cwd, timeout, input_data: str = None):
+    """Execute a command in a subprocess, returning stdout, stderr, and exit code.
+    ``input_data`` is sent to the process stdin if provided.
+    """
+    result = subprocess.run(
+        cmd,
+        cwd=cwd,
+        input=input_data,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        timeout=timeout
+    )
+    return result.stdout, result.stderr, result.returncode
+
+
+def _load_json_file(path: str):
+    with open(path, 'r') as f:
+        return json.load(f)
+
+
+def tool_function(
+    repo_path: str,
+    tests_dir: str,
+    class_name: Optional[str] = None,
+    iterations: int = 100,
+    timeout: int = 30
+) -> str:
+    """Evaluate the candidate solution.
+
+    Expected files in ``tests_dir``:
+        - ``brute.py``: reference implementation exposing a ``solve`` function (or appropriate class method).
+        - ``gen.py``: script that prints a JSON object representing a single test input.
+        - ``samples.json``: array of ``{"input": ..., "output": ...}`` objects.
+    The repository at ``repo_path`` must contain ``solution.py`` (or appropriate file).
+    The tool runs the candidate on all samples, then on ``iterations`` random inputs generated by ``gen.py`` and compares the output to ``brute.py``.
+    It returns a textual report.
+    """
+    try:
+        repo_path = os.path.abspath(repo_path)
+        tests_dir = os.path.abspath(tests_dir)
+
+        brute_path = os.path.join(tests_dir, 'brute.py')
+        gen_path = os.path.join(tests_dir, 'gen.py')
+        samples_path = os.path.join(tests_dir, 'samples.json')
+
+        for p in (brute_path, gen_path, samples_path):
+            if not os.path.isfile(p):
+                return f"Error: required file {os.path.basename(p)} not found in {tests_dir}"
+
+        samples = _load_json_file(samples_path)
+        total_tests = len(samples)
+        passed = 0
+        report_lines = []
+
+        def run_solution(input_dict):
+            if class_name:
+                # Write a temporary runner script that imports the class and calls solve
+                runner_code = (
+                    "import json, sys; "
+                    f"sys.path.append('{repo_path}'); "
+                    f"from solution import {class_name} as Sol; "
+                    f"obj = Sol(); "
+                    "data = json.loads(sys.stdin.read()); "
+                    "result = obj.solve(**data); "
+                    "print(json.dumps(result))"
+                )
+                runner_path = os.path.join(tests_dir, 'run_solution.py')
+                with open(runner_path, 'w') as f:
+                    f.write(runner_code)
+                cmd = [sys.executable, runner_path]
+            else:
+                cmd = [sys.executable, os.path.join(repo_path, 'solution.py')]
+            stdin_data = json.dumps(input_dict)
+            return _run_subprocess(cmd, cwd=repo_path, timeout=timeout, input_data=stdin_data)
+
+        # Evaluate sample tests
+        for idx, case in enumerate(samples, 1):
+            inp = case.get('input')
+            expected = case.get('output')
+            stdout, stderr, rc = run_solution(inp)
+            try:
+                actual = json.loads(stdout.strip()) if stdout.strip() else stdout.strip()
+            except Exception:
+                actual = stdout.strip()
+            if rc == 0 and actual == expected:
+                passed += 1
+                report_lines.append(f"Sample {idx}: PASS")
+            else:
+                report_lines.append(f"Sample {idx}: FAIL (expected={expected}, actual={actual}, rc={rc})")
+                break
+
+        # Random tests against brute if all samples passed
+        if passed == total_tests:
+            # Helper to run brute
+            def run_brute(input_dict):
+                cmd = [sys.executable, brute_path]
+                stdin_data = json.dumps(input_dict)
+                return _run_subprocess(cmd, cwd=tests_dir, timeout=timeout, input_data=stdin_data)
+
+            for i in range(iterations):
+                gen_stdout, gen_stderr, gen_rc = _run_subprocess([sys.executable, gen_path], cwd=tests_dir, timeout=timeout)
+                if gen_rc != 0:
+                    report_lines.append(f"Generator failed at iteration {i+1}: rc={gen_rc}, err={gen_stderr.strip()}")
+                    break
+                try:
+                    input_dict = json.loads(gen_stdout.strip())
+                except Exception as e:
+                    report_lines.append(f"Invalid JSON from generator at iteration {i+1}: {e}")
+                    break
+                cand_stdout, cand_stderr, cand_rc = run_solution(input_dict)
+                brute_stdout, brute_stderr, brute_rc = run_brute(input_dict)
+                try:
+                    cand_output = json.loads(cand_stdout.strip()) if cand_stdout.strip() else cand_stdout.strip()
+                except Exception:
+                    cand_output = cand_stdout.strip()
+                try:
+                    brute_output = json.loads(brute_stdout.strip()) if brute_stdout.strip() else brute_stdout.strip()
+                except Exception:
+                    brute_output = brute_stdout.strip()
+                if cand_rc != 0 or cand_output != brute_output:
+                    report_lines.append(
+                        f"Random test {i+1}: FAIL (input={input_dict}, expected={brute_output}, actual={cand_output}, rc={cand_rc})"
+                    )
+                    break
+                else:
+                    passed += 1
+                    total_tests += 1
+            else:
+                report_lines.append(f"All {iterations} random tests passed.")
+
+        summary = f"Passed {passed}/{total_tests} tests."
+        return "\n".join([summary] + report_lines)
+    except Exception as e:
+        tb = traceback.format_exc()
+        return f"Evaluation tool encountered an exception: {e}\n{tb}"
