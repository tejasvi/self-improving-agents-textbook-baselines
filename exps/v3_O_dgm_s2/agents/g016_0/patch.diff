+    def _find_target_files(self):
+        """Return a list of candidate source files to edit.
+        Preference is given to files containing 'pass' or 'NotImplemented' stubs.
+        Excludes test files and README files.
+        """
+        candidates = []
+        for root, dirs, files in os.walk(self.git_tempdir):
+            # skip test directories
+            if any(part in {'test', 'tests', '__tests__'} for part in root.split(os.sep)):
+                continue
+            for f in files:
+                if f.startswith('README'):
+                    continue
+                if not f.endswith(('.py', '.js', '.go', '.java', '.cpp', '.c', '.ts')):
+                    continue
+                path = os.path.join(root, f)
+                # skip if it's a test file by name pattern
+                if f.startswith('test_') or f.endswith('_test.py') or f.endswith('.spec.js') or f.endswith('_test.go') or f.endswith('Test.java'):
+                    continue
+                candidates.append(path)
+        # Prefer stubs containing 'pass' or 'NotImplemented'
+        stub_candidates = []
+        for p in candidates:
+            try:
+                content = open(p, 'r').read()
+                if 'pass' in content or 'NotImplemented' in content:
+                    stub_candidates.append(p)
+            except Exception:
+                continue
+        return stub_candidates if stub_candidates else candidates
+
+    def _salvage_tool_calls(self, msg_history):
+        """Inspect the last assistant message for unexecuted tool JSON and invoke it.
+        Returns True if a tool was successfully called.
+        """
+        if not msg_history:
+            return False
+        last_msg = msg_history[-1]
+        if last_msg.get('role') != 'assistant':
+            return False
+        content_items = last_msg.get('content', [])
+        # Collect raw text from content items
+        raw_text = ''
+        for item in content_items:
+            if isinstance(item, dict) and item.get('type') == 'text':
+                raw_text += item.get('text', '')
+            elif isinstance(item, str):
+                raw_text += item
+        # Find JSON object after possible markers like 'commentary<|message|>' or 'functions.editor'
+        import re, json
+        # regex to find first '{' and matching closing '}' using a simple balanced approach
+        start = raw_text.find('{')
+        if start == -1:
+            return False
+        # attempt to extract balanced JSON substring
+        brace_count = 0
+        end = -1
+        for i in range(start, len(raw_text)):
+            if raw_text[i] == '{':
+                brace_count += 1
+            elif raw_text[i] == '}':
+                brace_count -= 1
+                if brace_count == 0:
+                    end = i + 1
+                    break
+        if end == -1:
+            return False
+        json_str = raw_text[start:end]
+        try:
+            data = json.loads(json_str)
+        except Exception:
+            return False
+        # Expect keys command and path, maybe file_text etc.
+        if not isinstance(data, dict) or 'command' not in data or 'path' not in data:
+            return False
+        # Use the edit tool directly
+        from tools.edit import tool_function
+        try:
+            result = tool_function(**data)
+            safe_log(f"Salvaged tool call result: {result}")
+            return True
+        except Exception as e:
+            safe_log(f"Error executing salvaged tool call: {e}")
+            return False
+
