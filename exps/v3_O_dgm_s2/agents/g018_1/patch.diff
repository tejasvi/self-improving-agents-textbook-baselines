diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..8fcdb02
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,235 @@
+import subprocess
+import json
+import os
+import sys
+import time
+
+
+def tool_info():
+    """Metadata for the stress_test tool.
+    """
+    return {
+        "name": "stress_test",
+        "description": "Generate inputs via a generator script and test a solution script against a reference or checker, reporting PASS/FAIL counts and first failure details.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python script to be tested."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator script (gen.py) that produces test inputs."
+                },
+                "generator_modes": {
+                    "type": "string",
+                    "description": "Comma‑separated list of generator modes (e.g., 'small,edge,maxsize,worst_case')."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Optional path to a reference implementation script. If omitted, a checker must be provided.",
+                    "default": ""
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a checker script that validates the solution output. It is invoked as 'python checker.py input_file output_file'.",
+                    "default": ""
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test per mode.",
+                    "default": 5
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds allowed for the solution per test case.",
+                    "default": 30
+                },
+                "scaling_sizes": {
+                    "type": "string",
+                    "description": "Optional comma‑separated list of scaling sizes (e.g., '1,0.5,0.25') to run the worst‑case input at reduced sizes for benchmarking.",
+                    "default": ""
+                },
+                "_raw": {
+                    "type": "string",
+                    "description": "Raw JSON string of arguments (optional)."
+                }
+            },
+            "required": ["solution_path", "generator_path", "generator_modes"]
+        }
+    }
+
+
+def _run_cmd(cmd, timeout):
+    """Helper to run a shell command with timeout and capture stdout+stderr."""
+    try:
+        result = subprocess.run(
+            cmd,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            executable="/bin/bash"
+        )
+        return result.stdout, result.stderr, result.returncode
+    except subprocess.TimeoutExpired:
+        return "", f"TIMEOUT after {timeout}s", -1
+    except Exception as e:
+        return "", f"Error: {str(e)}", -1
+
+
+def tool_function(
+        solution_path: str,
+        generator_path: str,
+        generator_modes: str,
+        reference_path: str = "",
+        checker_path: str = "",
+        iterations: int = 5,
+        timeout: int = 30,
+        scaling_sizes: str = "",
+        **kwargs
+    ) -> str:
+    """Run stress tests.
+
+    Returns a plain‑text report containing PASS/FAIL counts, first failing input (truncated),
+    solution vs expected output, and per‑mode maximum runtime. Errors are returned verbatim.
+    """
+    # Handle raw JSON argument if provided
+    if '_raw' in kwargs:
+        try:
+            raw_args = json.loads(kwargs['_raw'])
+        except Exception:
+            raw_args = {'solution_path': kwargs['_raw']}
+        for k, v in raw_args.items():
+            if k not in kwargs:
+                kwargs[k] = v
+        # Merge into locals
+        solution_path = kwargs.get('solution_path', solution_path)
+        generator_path = kwargs.get('generator_path', generator_path)
+        generator_modes = kwargs.get('generator_modes', generator_modes)
+        reference_path = kwargs.get('reference_path', reference_path)
+        checker_path = kwargs.get('checker_path', checker_path)
+        iterations = kwargs.get('iterations', iterations)
+        timeout = kwargs.get('timeout', timeout)
+        scaling_sizes = kwargs.get('scaling_sizes', scaling_sizes)
+
+    modes = [m.strip() for m in generator_modes.split(',') if m.strip()]
+    scaling = [s.strip() for s in scaling_sizes.split(',') if s.strip()] if scaling_sizes else []
+
+    total_pass = 0
+    total_fail = 0
+    first_fail_detail = None
+    mode_max_time = {}
+
+    # Temporary files
+    input_file = "/tmp/stress_input.txt"
+    output_file = "/tmp/stress_output.txt"
+    expected_file = "/tmp/stress_expected.txt"
+
+    for mode in modes:
+        mode_max = 0.0
+        for seed in range(iterations):
+            # Generate input
+            gen_cmd = f"python {generator_path} {mode} {seed}"
+            inp_stdout, inp_err, rc = _run_cmd(gen_cmd, timeout)
+            if rc != 0:
+                # Generator error – treat as failure
+                total_fail += 1
+                if not first_fail_detail:
+                    first_fail_detail = f"Generator failed for mode {mode} seed {seed}: {inp_err}"
+                continue
+            # Write generated input to file
+            with open(input_file, "w") as f:
+                f.write(inp_stdout)
+
+            # Run solution
+            start = time.time()
+            sol_cmd = f"python {solution_path} < {input_file}"
+            sol_stdout, sol_err, sol_rc = _run_cmd(sol_cmd, timeout)
+            elapsed = time.time() - start
+            mode_max = max(mode_max, elapsed)
+            # Write solution output to file
+            with open(output_file, "w") as f:
+                f.write(sol_stdout)
+
+            # Determine expected output
+            if reference_path:
+                ref_cmd = f"python {reference_path} < {input_file}"
+                exp_stdout, exp_err, ref_rc = _run_cmd(ref_cmd, timeout)
+                expected = exp_stdout
+                # Write expected for possible checker usage
+                with open(expected_file, "w") as f:
+                    f.write(expected)
+            elif checker_path:
+                # Checker invoked as: python checker.py input_file output_file
+                chk_cmd = f"python {checker_path} {input_file} {output_file}"
+                chk_out, chk_err, chk_rc = _run_cmd(chk_cmd, timeout)
+                # Assume checker exits with code 0 for pass
+                if chk_rc == 0:
+                    total_pass += 1
+                    continue
+                else:
+                    total_fail += 1
+                    if not first_fail_detail:
+                        first_fail_detail = f"Checker reported failure for mode {mode} seed {seed}: {chk_err or chk_out}"
+                    continue
+            else:
+                # No reference or checker – cannot verify
+                total_fail += 1
+                if not first_fail_detail:
+                    first_fail_detail = "No reference or checker provided to validate output."
+                continue
+
+            # Compare solution vs expected
+            if sol_stdout.strip() == expected.strip():
+                total_pass += 1
+            else:
+                total_fail += 1
+                if not first_fail_detail:
+                    # Truncate large input for reporting
+                    display_input = inp_stdout[:200] + ("..." if len(inp_stdout) > 200 else "")
+                    first_fail_detail = (
+                        f"FAILURE for mode {mode} seed {seed}\n"
+                        f"Input (truncated):\n{display_input}\n"
+                        f"Expected: {expected.strip()}\n"
+                        f"Got: {sol_stdout.strip()}"
+                    )
+        mode_max_time[mode] = mode_max
+
+    report_lines = [
+        f"PASS: {total_pass}",
+        f"FAIL: {total_fail}",
+    ]
+    if first_fail_detail:
+        report_lines.append("First failure detail:")
+        report_lines.append(first_fail_detail)
+    for mode, mt in mode_max_time.items():
+        report_lines.append(f"Mode {mode} max runtime: {mt:.3f}s")
+
+    # The agent is expected to end with a verdict line, but we simply return the report
+    return "\n".join(report_lines)
+
+if __name__ == "__main__":
+    # Simple manual test interface
+    import argparse
+    parser = argparse.ArgumentParser(description="Run stress_test tool")
+    parser.add_argument("--solution_path", required=True)
+    parser.add_argument("--generator_path", required=True)
+    parser.add_argument("--generator_modes", required=True)
+    parser.add_argument("--reference_path", default="")
+    parser.add_argument("--checker_path", default="")
+    parser.add_argument("--iterations", type=int, default=5)
+    parser.add_argument("--timeout", type=int, default=30)
+    parser.add_argument("--scaling_sizes", default="")
+    args = parser.parse_args()
+    print(tool_function(
+        args.solution_path,
+        args.generator_path,
+        args.generator_modes,
+        reference_path=args.reference_path,
+        checker_path=args.checker_path,
+        iterations=args.iterations,
+        timeout=args.timeout,
+        scaling_sizes=args.scaling_sizes,
+    ))
