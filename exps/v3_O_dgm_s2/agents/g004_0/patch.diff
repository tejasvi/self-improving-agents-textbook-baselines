+    # Helper to list changed files (including untracked) since base_commit
+    def _get_changed_files(self):
+        try:
+            # Tracked changes
+            cmd_diff = ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit]
+            result_diff = subprocess.run(cmd_diff, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, text=True)
+            tracked = result_diff.stdout.splitlines()
+            # Untracked files
+            cmd_untracked = ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]
+            result_untracked = subprocess.run(cmd_untracked, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, text=True)
+            untracked = result_untracked.stdout.splitlines()
+            files = list(set(tracked + untracked))
+            return files
+        except Exception as e:
+            safe_log(f"Error getting changed files: {e}")
+            return []
+
+    # Heuristic to determine if a file is a test file
+    def _is_test_file(self, path):
+        lower_path = path.lower()
+        # Directory heuristics
+        test_dirs = ["test", "tests", "__tests__", "spec"]
+        if any(d in lower_path.split(os.sep) for d in test_dirs):
+            return True
+        # Filename heuristics
+        filename = os.path.basename(path).lower()
+        test_patterns = [
+            "test_", "_test.", "_test.", "_spec.", "spec_", "conftest.", "test.", "_test", "_spec", "test-", "spec-"
+        ]
+        if any(p in filename for p in test_patterns):
+            return True
+        return False
+
+    # Determine patch status: empty, tests_only, ok
+    def _patch_status(self):
+        changed = self._get_changed_files()
+        if not changed:
+            return 'empty'
+        # If all changed files are test files
+        if all(self._is_test_file(p) for p in changed):
+            return 'tests_only'
+        return 'ok'
+
