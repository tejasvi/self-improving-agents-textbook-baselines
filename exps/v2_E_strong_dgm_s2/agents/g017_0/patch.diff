+        samples_dir = os.path.join(tests_dir, 'samples')
+
+        def timed_run(cmd, inp):
+            import time
+            t0 = time.time()
+            rc, out, err, timed_out = self._run_cmd(cmd, input=inp, timeout=5)
+            return rc, out, err, timed_out, time.time() - t0
