+    @staticmethod
+    def _clip(text, limit=1500):
+        text = '' if text is None else str(text)
+        return text if len(text) <= limit else text[:limit] + '\n...[clipped]'
+
+    def _format_failures(self, ev):
+        lines = []
+        for i, (inp, expected, got) in enumerate(ev['failures'], 1):
+            lines.append(f"Failure {i}:\nInput:\n{self._clip(inp, 600)}\nExpected output:\n{self._clip(expected, 400)}\nYour output:\n{self._clip(got, 400)}")
+        return '\n\n'.join(lines) if lines else '(no failing cases recorded)'
+
+    @staticmethod
+    def _is_bad_reply(msg_history, prev_len):
+        """Detect empty or '(no output)' assistant replies appended in the last turn."""
+        new = msg_history[prev_len:] if isinstance(msg_history, list) else []
+        assistant = [m for m in new if m.get('role') == 'assistant']
+        if not assistant:
+            return True
+        last = assistant[-1].get('content')
+        texts = []
+        if isinstance(last, str):
+            texts = [last]
+        elif isinstance(last, list):
+            texts = [b.get('text', '') for b in last if isinstance(b, dict) and b.get('type') == 'text']
+        joined = ''.join(t or '' for t in texts).strip()
+        return joined == '' or joined == '(no output)'
+
+    def _call_agent(self, msg, msg_history):
+        """Call the agent. Returns (new_history, ok). ok=False if the reply was empty / '(no output)'."""
+        prev_len = len(msg_history)
+        new_history = chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        if not isinstance(new_history, list):
+            return msg_history, False
+        if self._is_bad_reply(new_history, prev_len):
+            return new_history, False
+        return new_history, True
+
+    def _stage(self, prompt, history, label):
+        """Run one stage with a single re-prompt on empty/'(no output)' replies. Returns history."""
