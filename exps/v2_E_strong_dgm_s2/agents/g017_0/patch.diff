+    def _run_cmd(self, cmd, input=None, timeout=5):
+        """Run a command with a timeout. Returns (returncode, stdout, stderr, timed_out)."""
+        try:
+            proc = subprocess.run(
+                cmd, input=input, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                timeout=timeout, text=True, cwd=self.git_tempdir,
+            )
+            return proc.returncode, proc.stdout, proc.stderr, False
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or '')
+            err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or '')
+            return -1, out, err, True
+        except Exception as e:
+            return -1, '', f'{type(e).__name__}: {e}', False
+
+    def _extract_samples(self, problem_statement):
+        """
+        Parse 'Sample Input k' / 'Sample Output k' blocks from the statement and write them to
+        tests/samples/k.in and tests/samples/k.out. Returns the number of samples written (0 if none).
+        """
+        pattern = re.compile(
+            r'Sample Input\s*(\d+)\s*[:\-]?\s*\n(.*?)\n\s*Sample Output\s*\1\s*[:\-]?\s*\n(.*?)(?=\n\s*\n|\n\s*(?:Sample Input|Explanation|Note|Constraints)|\Z)',
+            re.S | re.I,
+        )
+        samples = pattern.findall(problem_statement or '')
+        if not samples:
+            return 0
+        samples_dir = os.path.join(self.git_tempdir, 'tests', 'samples')
+        os.makedirs(samples_dir, exist_ok=True)
+        count = 0
+        for k, inp, out in samples:
+            with open(os.path.join(samples_dir, f'{k}.in'), 'w') as f:
+                f.write(inp.strip() + '\n')
+            with open(os.path.join(samples_dir, f'{k}.out'), 'w') as f:
+                f.write(out.strip() + '\n')
+            count += 1
+        return count
+
+    def _evaluate(self, solution_path):
