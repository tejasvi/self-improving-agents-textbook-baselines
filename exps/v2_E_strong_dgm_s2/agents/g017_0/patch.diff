+    @staticmethod
+    def _is_perfect(ev):
+        return (ev['samples_total'] > 0 and ev['samples_passed'] == ev['samples_total']
+                and ev['stress_total'] > 0 and ev['stress_passed'] == ev['stress_total']
+                and not ev['crashed'])
