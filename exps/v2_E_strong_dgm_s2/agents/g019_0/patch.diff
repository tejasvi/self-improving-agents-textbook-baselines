-This script only checks that those pieces are present; it never edits files.
+Phases:
+  (a) test-author session builds and self-validates the harness (once);
+  (b) N independent solver sessions write candidates/sol_k.py and iterate
+      with bounded reflection rounds against run_tests;
+  (c) deterministic scoring ranks candidates (samples, stress pass rate, runtime),
+      optional cross-check on large random inputs, winner copied to solution.py;
+  (d) if nothing passes everything, one final reflection starts from the best candidate.
 """
+
+import json
 import os
+import shutil
+import subprocess
 import sys
+import tempfile
+import time
+import glob
+import importlib.util
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+# ---------------------------------------------------------------------------
+# tools/run_tests.py (generic harness runner)
+# ---------------------------------------------------------------------------
+
+MAX_SHOW = 600  # characters per shown input/output
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": (
+            "Run a candidate solution against the harness in tests_dir: every samples/*.in "
+            "(compared with .out), every edge case, and num_random random cases generated by "
+            "gen.py whose expected output comes from brute.py. Reports pass/fail counts, the "
+            "first 3 failures (input, expected, actual) and the max runtime. Raw output only."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the candidate Python solution file."},
+                "tests_dir": {"type": "string", "description": "Path to the harness directory containing samples/, edge_cases.py, brute.py, gen.py."},
+                "num_random": {"type": "integer", "description": "Number of random cases from gen.py (default 500)."},
+                "timeout": {"type": "integer", "description": "Per-case time limit in seconds (default 5)."},
+                "seed": {"type": "integer", "description": "Seed offset for random cases (default 0)."},
+            },
+            "required": ["solution_path", "tests_dir"],
+        },
+    }
+
+
+def _load_module(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _run_candidate(solution_path, tests_dir, inp, timeout):
+    """Returns (ok, stdout, stderr, elapsed). ok False on crash/timeout."""
+    driver = os.path.join(tests_dir, "driver.py")
+    cmd = [sys.executable, driver, solution_path] if os.path.exists(driver) else [sys.executable, solution_path]
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=inp, capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return False, "", "TIMEOUT", time.time() - t0
+    el = time.time() - t0
+    return p.returncode == 0, p.stdout, p.stderr, el
+
+
+def _same(a, b):
+    return a.split() == b.split()
+
+
+def evaluate(solution_path, tests_dir, num_random=500, timeout=5, seed=0):
