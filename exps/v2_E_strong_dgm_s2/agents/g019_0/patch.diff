+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a candidate solution against the test harness and report raw results.\n
+* Harness layout (relative to tests_dir): samples/NAME.in with samples/NAME.out (expected output), edge_cases.py defining EDGE_CASES = [(input_text, expected_output_text), ...], brute.py defining canonical(inp) -> output text (the exact reference answer), and gen.py defining generate(seed) -> input text.\n
+* A stdin program is run as `python3 solution_path` with the input on stdin. If tests_dir/driver.py exists (for Solution-class tasks), it is run as `python3 tests_dir/driver.py solution_path` with the input on stdin instead.\n
+* Runs the candidate on every sample, every edge case, and num_random inputs from generate(seed..seed+num_random-1) whose expected output is brute's canonical(inp).\n
+* Reports pass/fail counts per group, the first 3 failing cases (input, expected output, actual output, including raw stderr when the program crashed), and the max runtime. Output is raw; read it yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the candidate Python solution file to test."},
+                "tests_dir": {"type": "string", "description": "Path to the harness directory (e.g. <repo>/tests) containing samples/, edge_cases.py, brute.py, gen.py."},
+                "num_random": {"type": "integer", "description": "Number of random cases from gen.py compared against brute.py. Default 500."},
+                "timeout": {"type": "integer", "description": "Per-case time limit in seconds. Default 5."},
+                "seed": {"type": "integer", "description": "Seed offset for the random cases. Default 0."}
+            },
+            "required": ["solution_path", "tests_dir"]
+        }
+    }
+
+_CLIP = 400
+
+def _clip(s, n=_CLIP):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[:n] + f"...<{len(s) - n} more chars clipped>"
+
+def _norm(s):
+    return "\n".join(line.rstrip() for line in (s or "").strip().splitlines())
+
+def _load_module(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+def _run_candidate(solution_path, tests_dir, inp, timeout):
+    """Run the candidate on inp. Returns dict(stdout, stderr, returncode, seconds, timed_out)."""
+    driver = os.path.join(tests_dir, "driver.py")
+    if os.path.isfile(driver):
+        cmd = [sys.executable, driver, solution_path]
+    else:
+        cmd = [sys.executable, solution_path]
+    if not inp.endswith("\n"):
+        inp += "\n"
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=inp, capture_output=True, text=True, timeout=timeout,
+                           cwd=os.path.dirname(os.path.abspath(tests_dir)), errors="replace")
+    except subprocess.TimeoutExpired:
+        return {"stdout": "", "stderr": "", "returncode": None, "seconds": float(timeout), "timed_out": True}
+    return {"stdout": p.stdout, "stderr": p.stderr, "returncode": p.returncode,
+            "seconds": time.time() - t0, "timed_out": False}
+
+def _actual_text(run):
+    if run["timed_out"]:
+        return f"(timed out after {run['seconds']:.1f}s)"
+    text = run["stdout"]
+    if run["returncode"] != 0:
+        text += f"\n(exit code {run['returncode']})\nSTDERR:\n{run['stderr']}"
+    return text
+
+def _check_case(group, idx, inp, expected, solution_path, tests_dir, timeout):
+    run = _run_candidate(solution_path, tests_dir, inp, timeout)
