+def is_perfect(res):
+    return (res["error"] is None and res["harness_errors"] == 0 and res["samples_total"] > 0
+            and res["samples_passed"] == res["samples_total"]
+            and res["edge_passed"] == res["edge_total"]
+            and res["random_passed"] == res["random_total"])
+
+def format_report(res, first_k=3):
