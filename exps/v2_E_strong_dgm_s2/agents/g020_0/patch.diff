+    @staticmethod
+    def _extract_example_samples(text):
+        """
+        Fallback parser: 'Example N' / 'Input:' / 'Output:' blocks.
+        Pairs each 'Input:' line with the next 'Output:' line; the input runs until the
+        Output line, the output runs until a blank line or a new label.
+        """
+        lines = [ln.rstrip() for ln in text.splitlines() if not ln.strip().startswith("```")]
+        label_re = re.compile(r"^\s*(Input|Output|Explanation|Example|Note|Constraints)\b\s*\d*\s*:?", re.I)
+        samples = []
+        i = 0
+        n = len(lines)
+        while i < n:
+            m = re.match(r"^\s*Input\s*\d*\s*:\s*(.*)$", lines[i], re.I)
+            if not m:
+                i += 1
+                continue
+            inp = [m.group(1)] if m.group(1).strip() else []
+            j = i + 1
+            while j < n and not re.match(r"^\s*Output\s*\d*\s*:", lines[j], re.I):
+                if label_re.match(lines[j]) and lines[j].strip():
+                    break
+                if lines[j].strip():
+                    inp.append(lines[j])
+                j += 1
+            if j >= n or not re.match(r"^\s*Output\s*\d*\s*:", lines[j], re.I):
+                i = j
+                continue
+            om = re.match(r"^\s*Output\s*\d*\s*:\s*(.*)$", lines[j], re.I)
+            out = [om.group(1)] if om.group(1).strip() else []
+            k = j + 1
+            while k < n and lines[k].strip() and not label_re.match(lines[k]):
+                out.append(lines[k])
+                k += 1
+            inp_text = "\n".join(x.strip() for x in inp).strip()
+            exp_text = "\n".join(x.strip() for x in out).strip()
+            if inp_text and exp_text:
+                samples.append((inp_text + "\n", exp_text))
+            i = k
+        return samples
+
