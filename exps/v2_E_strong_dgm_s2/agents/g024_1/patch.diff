@@ -0,0 +1,261 @@
+import os
+import sys
+import json
+import pickle
+import inspect
+import random
+import tempfile
+import subprocess
+import importlib.util
+import math
+
+DEFAULT_KINDS = ["random", "all_equal", "all_distinct", "sorted", "adversarial"]
+FRACS = [1 / 16, 1 / 8, 1 / 4, 1 / 2, 1.0]
+MIN_MEASURABLE = 0.02  # seconds; below this, timing differences are mostly process start-up noise
+
+# Driver for Solution-class candidates: loads the file, calls the method on a pickled tuple of args, and prints
+# the elapsed time of the call as JSON on stdout.
+_METHOD_DRIVER = r'''
+import sys, json, pickle, time, importlib.util, os, io, contextlib
+sol_path, method, pkl_path = sys.argv[1:4]
+d = os.path.dirname(os.path.abspath(sol_path))
+sys.path.insert(0, d)
+spec = importlib.util.spec_from_file_location("_perf_solution", sol_path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+args = pickle.load(open(pkl_path, "rb"))
+inst = mod.Solution()
+fn = getattr(inst, method)
+buf = io.StringIO()
+t0 = time.time()
+with contextlib.redirect_stdout(buf):
+    fn(*args)
+print(json.dumps({"seconds": time.time() - t0}))
+'''
+
+
+def _load_gen(generator_path):
+    spec = importlib.util.spec_from_file_location("_perf_gen", generator_path)
+    mod = importlib.util.module_from_spec(spec)
+    d = os.path.dirname(os.path.abspath(generator_path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _accepts_frac(fn):
+    try:
+        params = inspect.signature(fn).parameters
+    except (TypeError, ValueError):
+        return False
+    return "frac" in params or any(p.kind == inspect.Parameter.VAR_KEYWORD for p in params.values())
+
+
+def _input_size(x):
+    """Best-effort N: first integer token of a stdin string, or length of the first list argument."""
+    if isinstance(x, str):
+        for tok in x.split():
+            try:
+                return int(tok)
+            except ValueError:
+                continue
+        return None
+    if isinstance(x, (tuple, list)):
+        for a in x:
+            if isinstance(a, (list, tuple, str)):
+                return len(a)
+        return None
+    return None
+
+
+def _run_once(solution_path, method, x, time_limit):
+    """Run the candidate once on x. Returns (status, seconds, detail); status in ok|tle|error."""
+    if method:
+        fd, pkl = tempfile.mkstemp(suffix=".pkl")
+        os.close(fd)
+        try:
+            with open(pkl, "wb") as f:
+                pickle.dump(tuple(x), f)
+            cmd = [sys.executable, "-c", _METHOD_DRIVER, solution_path, method, pkl]
+            try:
+                p = subprocess.run(cmd, capture_output=True, text=True, timeout=time_limit,
+                                   stdin=subprocess.DEVNULL)
+            except subprocess.TimeoutExpired:
+                return "tle", float(time_limit), f"exceeded {time_limit}s"
+        finally:
+            try:
+                os.remove(pkl)
+            except OSError:
+                pass
+        if p.returncode != 0:
+            return "error", 0.0, (p.stderr or "").strip()[-400:]
+        try:
+            return "ok", float(json.loads(p.stdout.strip().splitlines()[-1])["seconds"]), ""
+        except (ValueError, KeyError, IndexError):
+            return "error", 0.0, "could not parse driver output"
+    import time as _time
+    data = x if isinstance(x, str) else str(x)
+    t0 = _time.time()
+    try:
+        p = subprocess.run([sys.executable, solution_path], input=data, capture_output=True, text=True,
+                           timeout=time_limit, stdin=None)
+    except subprocess.TimeoutExpired:
+        return "tle", float(time_limit), f"exceeded {time_limit}s"
+    elapsed = _time.time() - t0
+    if p.returncode != 0:
+        return "error", elapsed, (p.stderr or "").strip()[-400:]
+    return "ok", elapsed, ""
+
+
+def run_perf(solution_path, generator_path, method=None, time_limit=2.0, kinds=None):
+    """
+    Time a candidate on max-size inputs from gen_max(rng, kind[, frac]) and on a scaling series.
+    Returns a dict: {'error': str or None, 'tle': bool, 'max_time': float, 'text': str}.
+    """
+    time_limit = float(time_limit) if time_limit else 2.0
+    kinds = list(kinds) if kinds else list(DEFAULT_KINDS)
+    if not os.path.isfile(solution_path):
+        return {"error": f"solution file does not exist: {solution_path}", "tle": False, "max_time": 0.0,
+                "text": f"ERROR: solution file does not exist: {solution_path}"}
+    if not os.path.isfile(generator_path):
+        return {"error": f"generator file does not exist: {generator_path}", "tle": False, "max_time": 0.0,
+                "text": f"ERROR: generator file does not exist: {generator_path}"}
+    try:
+        gen = _load_gen(generator_path)
+    except BaseException as e:
+        msg = f"could not import generator: {type(e).__name__}: {e}"
+        return {"error": msg, "tle": False, "max_time": 0.0, "text": "ERROR: " + msg}
+    if not hasattr(gen, "gen_max"):
+        msg = "generator does not define gen_max(rng, kind, frac=1.0); add it so that perf can be checked."
+        return {"error": msg, "tle": False, "max_time": 0.0, "text": "ERROR: " + msg}
+
+    lines = [f"Perf check of {os.path.basename(solution_path)} (time limit {time_limit:.2f}s per run, "
+             f"wall clock including interpreter start-up):", "",
+             "kind           | N         | seconds | status"]
+    tle = False
+    error = None
+    max_time = 0.0
+    for kind in kinds:
+        try:
+            x = gen.gen_max(random.Random(12345), kind)
+        except BaseException as e:
+            lines.append(f"{kind:<14} | -         | -       | generator error: {type(e).__name__}: {e}")
+            error = error or f"gen_max failed for kind {kind}"
+            continue
+        n = _input_size(x)
+        status, secs, detail = _run_once(solution_path, method, x, time_limit)
+        max_time = max(max_time, secs)
+        if status == "tle":
+            tle = True
+            cell = f"TLE (>{time_limit:.2f}s)"
+        elif status == "error":
+            cell = "RUNTIME ERROR: " + detail.replace("\n", " ")[-200:]
+            error = error or f"runtime error on kind {kind}"
+        else:
+            cell = "ok"
+        lines.append(f"{kind:<14} | {str(n) if n is not None else '?':<9} | {secs:<7.3f} | {cell}")
+
+    # Scaling series on the 'random' kind (or the first kind) if gen_max accepts frac.
+    lines.append("")
+    if _accepts_frac(gen.gen_max):
+        series_kind = "random" if "random" in kinds else kinds[0]
+        lines.append(f"Scaling series (kind={series_kind}):")
+        lines.append("frac   | N         | seconds | status")
+        times = []  # (frac, seconds) of completed runs
+        for frac in FRACS:
+            try:
+                x = gen.gen_max(random.Random(777), series_kind, frac=frac)
+            except BaseException as e:
+                lines.append(f"{frac:<6.4f} | -         | -       | generator error: {type(e).__name__}: {e}")
+                break
+            n = _input_size(x)
+            status, secs, detail = _run_once(solution_path, method, x, time_limit)
+            if status == "tle":
+                tle = True
+                lines.append(f"{frac:<6.4f} | {str(n) if n is not None else '?':<9} | >{time_limit:<6.2f} | TLE")
+                break
+            if status == "error":
+                lines.append(f"{frac:<6.4f} | {str(n) if n is not None else '?':<9} | {secs:<7.3f} | "
+                             f"RUNTIME ERROR: {detail.replace(chr(10), ' ')[-200:]}")
+                error = error or "runtime error in scaling series"
+                break
+            times.append((frac, secs, n))
+            lines.append(f"{frac:<6.4f} | {str(n) if n is not None else '?':<9} | {secs:<7.3f} | ok")
+        exps = []
+        for (f0, t0_, _), (f1, t1_, _) in zip(times, times[1:]):
+            if f1 > f0 and t0_ >= MIN_MEASURABLE and t1_ >= MIN_MEASURABLE:
+                exps.append(math.log2(t1_ / t0_) / math.log2(f1 / f0))
+        if exps:
+            e = exps[-1]
+            lines.append(f"Estimated growth exponent (last doubling, log2(t(N)/t(N/2)) per unit log2 N): {e:.2f}")
+            base_frac, base_t, _ = times[-1]
+            est = base_t * (1.0 / base_frac) ** e
+            lines.append(f"Extrapolated time at max size: {est:.2f}s (from frac={base_frac:.4f} "
+                         f"at {base_t:.3f}s, exponent {e:.2f})")
+            if est > time_limit:
+                tle = True
+        else:
+            lines.append("Growth exponent: not estimable (runs too fast to measure).")
+    else:
+        lines.append("Scaling series skipped: gen_max does not accept frac (define gen_max(rng, kind, frac=1.0)).")
+
+    lines.append("")
+    if tle:
+        lines.append(f"RESULT: TLE. At least one max-size run exceeded {time_limit:.2f}s. "
+                     "The algorithm's worst-case complexity is too high; choose a lower-complexity approach.")
+    elif error:
+        lines.append(f"RESULT: ERROR ({error}). Fix the runtime error before judging performance.")
+    else:
+        lines.append(f"RESULT: OK. All max-size runs finished within {time_limit:.2f}s "
+                     f"(slowest {max_time:.3f}s).")
+    text = "\n".join(lines)
+    return {"error": error, "tle": tle, "max_time": max_time, "text": text}
+
+
+def tool_info():
+    return {
+        "name": "perf_check",
+        "description": """Measure the running time of a solution at MAX constraint sizes.
+* Requires the generator file to define gen_max(rng, kind, frac=1.0) that returns a valid input at the statement's real upper bounds (kinds such as random, all_equal, all_distinct, sorted, adversarial).
+* Runs the solution in a subprocess per kind with a wall-clock limit (default 2 seconds), then runs a scaling series at frac = 1/16, 1/8, 1/4, 1/2, 1 and reports the growth exponent and an extrapolated time at max size.
+* Reports TLE if any max-size run exceeds the limit. Use it to verify performance before finishing; if it reports TLE, switch to a lower-complexity algorithm instead of micro-optimizing.
+* Pass method (the Solution method name) when the problem is a method of class Solution; otherwise the solution is run as a stdin/stdout program.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator Python file exposing gen_max(rng, kind, frac=1.0)."
+                },
+                "method": {
+                    "type": "string",
+                    "description": "Optional. Name of the method of class Solution to call; omit for a stdin/stdout program."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Optional. Wall-clock limit in seconds per run (default 2)."
+                },
+                "kinds": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional. Input kinds to test passed to gen_max (default: random, all_equal, all_distinct, sorted, adversarial)."
+                }
+            },
+            "required": ["solution_path", "generator_path"]
+        }
+    }
+
+
+def tool_function(solution_path, generator_path, method=None, time_limit=2, kinds=None):
+    try:
+        res = run_perf(solution_path, generator_path, method=method or None,
+                       time_limit=time_limit if time_limit is not None else 2,
+                       kinds=kinds or None)
+    except Exception as e:
+        return f"ERROR: perf check failed: {type(e).__name__}: {e}"
+    return res["text"]
