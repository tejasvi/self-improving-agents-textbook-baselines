+import importlib.util
+import itertools
+import random
+import traceback
+from fractions import Fraction
+
+OUT_CAP = 2900
+
+
+def tool_info():
+    return {
+        "name": "fit_formula",
+        "description": """Study a slow brute-force oracle at large parameter values and fit closed forms.\n
+* oracle_path: a Python file defining `f(*args)` (the brute force). Arguments are passed in the order of `params`.\n
+* params: list of parameter specs. kind 'linear' = large coordinate-like value, sampled in [min,max]; kind 'periodic' = value whose residue mod `modulus` defines a group (the oracle is studied per residue class).\n
+* The tool samples the oracle, groups points by periodic residues, and per group tests exact affine fits in the linear params and affine fits in simple features (|xi-xj|, max, min of pairs). It reports the best rule per group, match fraction, and up to 5 counterexamples.\n
+* It also reports which parameters change the output (dependency test).\n
+* Output is compact by design. Use small ranges (e.g. max up to 60) for quick scale studies, and larger ranges to validate a candidate formula.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "oracle_path": {
+                    "type": "string",
+                    "description": "Absolute path to a Python file exposing f(*args) that returns the brute-force answer."
+                },
+                "params": {
+                    "type": "array",
+                    "description": "Ordered list of parameter specs; each item describes one argument of f.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "name": {"type": "string", "description": "Parameter name, used in reports."},
+                            "min": {"type": "integer", "description": "Minimum sampled value (inclusive)."},
+                            "max": {"type": "integer", "description": "Maximum sampled value (inclusive)."},
+                            "kind": {"type": "string", "enum": ["linear", "periodic"],
+                                     "description": "'linear' for fit in affine forms; 'periodic' to group by residue mod modulus."},
+                            "modulus": {"type": "integer", "description": "Modulus for kind 'periodic' (ignored for linear)."}
+                        },
+                        "required": ["name", "min", "max", "kind"]
+                    }
+                },
+                "num_samples": {
+                    "type": "integer",
+                    "description": "Approximate total number of oracle samples (default 300)."
+                }
+            },
+            "required": ["oracle_path", "params"]
+        }
+    }
+
+
+def _load_oracle(path):
+    spec = importlib.util.spec_from_file_location("_fit_oracle_mod", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod.f
+
+
+def _solve_ls(rows, ys):
+    """Exact least squares via normal equations over Fractions; free variables set to 0."""
+    n = len(rows[0])
+    M = [[Fraction(0)] * (n + 1) for _ in range(n)]
+    for r, y in zip(rows, ys):
+        for i in range(n):
+            ri = r[i]
+            if ri == 0:
+                continue
+            for j in range(n):
+                M[i][j] += ri * r[j]
+            M[i][n] += ri * y
+    piv_cols = []
+    row = 0
+    for col in range(n):
+        if row >= n:
+            break
+        p = next((k for k in range(row, n) if M[k][col] != 0), None)
+        if p is None:
+            continue
+        M[row], M[p] = M[p], M[row]
+        inv = M[row][col]
+        M[row] = [v / inv for v in M[row]]
+        for k in range(n):
+            if k != row and M[k][col] != 0:
+                fct = M[k][col]
+                M[k] = [a - fct * b for a, b in zip(M[k], M[row])]
+        piv_cols.append(col)
+        row += 1
+    c = [Fraction(0)] * n
+    for i, col in enumerate(piv_cols):
+        c[col] = M[i][n]
+    return c
+
+
+def _feature_names(lin_names, mode):
+    names = ["1"] + list(lin_names)
+    if mode == "abs":
+        for i, j in itertools.combinations(range(len(lin_names)), 2):
+            a, b = lin_names[i], lin_names[j]
+            names += [f"|{a}-{b}|", f"max({a},{b})", f"min({a},{b})"]
+    return names
+
+
+def _features(lin_vals, mode):
+    feats = [Fraction(1)] + [Fraction(v) for v in lin_vals]
+    if mode == "abs":
+        for i, j in itertools.combinations(range(len(lin_vals)), 2):
+            a, b = lin_vals[i], lin_vals[j]
+            feats += [Fraction(abs(a - b)), Fraction(max(a, b)), Fraction(min(a, b))]
+    return feats
+
+
+def _fit_group(points, lin_names, mode):
+    """points: list of (lin_vals tuple, f value). Returns (rule_str, matched, total, coeffs, mismatches)."""
+    rows = [_features(x, mode) for x, _ in points]
+    ys = [Fraction(y) for _, y in points]
+    c = _solve_ls(rows, ys)
+    names = _feature_names(lin_names, mode)
+    matched = 0
+    mism = []
+    for (x, y), r in zip(points, rows):
+        pred = sum(ci * ri for ci, ri in zip(c, r))
+        if pred == y:
+            matched += 1
+        else:
+            mism.append((x, y, pred))
+    terms = [f"{c[k]}*{names[k]}" for k in range(len(c)) if c[k] != 0]
+    rule = " + ".join(terms) if terms else "0"
+    return rule, matched, len(points), mism
+
+
+def _fmt_args(args):
+    return "(" + ",".join(str(a) for a in args) + ")"
+
+
+def tool_function(oracle_path, params, num_samples=300):
+    try:
+        f = _load_oracle(oracle_path)
+    except Exception as e:
+        return f"Error loading oracle: {type(e).__name__}: {e}"
+    try:
+        num_samples = int(num_samples or 300)
+        specs = []
+        for p in params:
+            kind = p.get("kind", "linear")
+            if kind not in ("linear", "periodic"):
+                return f"Error: unknown kind {kind!r} for {p.get('name')}"
+            lo, hi = int(p["min"]), int(p["max"])
+            if hi < lo:
+                return f"Error: max < min for {p.get('name')}"
+            mod = int(p.get("modulus") or 1) if kind == "periodic" else 1
+            if kind == "periodic" and mod < 1:
+                return f"Error: modulus must be >= 1 for {p.get('name')}"
+            specs.append({"name": p["name"], "lo": lo, "hi": hi, "kind": kind, "mod": mod})
+        rng = random.Random(12345)
+        per_idx = [i for i, s in enumerate(specs) if s["kind"] == "periodic"]
+        lin_idx = [i for i, s in enumerate(specs) if s["kind"] == "linear"]
+        lin_names = [specs[i]["name"] for i in lin_idx]
+
+        def sample_value(s, residue=None):
+            lo, hi, m = s["lo"], s["hi"], s["mod"]
+            if residue is None:
+                if rng.random() < 0.2:
+                    return rng.choice([lo, hi])
+                return rng.randint(lo, hi)
+            first = lo + ((residue - lo) % m)
+            if first > hi:
+                return None
+            cnt = (hi - first) // m + 1
+            k = rng.choice([0, cnt - 1]) if rng.random() < 0.2 else rng.randint(0, cnt - 1)
+            return first + k * m
+
+        # Residue groups for periodic params.
+        groups = []
+        if per_idx:
+            full = 1
+            for i in per_idx:
+                full *= specs[i]["mod"]
+            if full <= 40:
+                combos = itertools.product(*[range(specs[i]["mod"]) for i in per_idx])
+                cand = list(combos)
+            else:
+                cand = []
+                for _ in range(40):
+                    cand.append(tuple(specs[i]["lo"] + rng.randrange(max(1, specs[i]["hi"] - specs[i]["lo"] + 1))
+                                      for i in per_idx))
+                cand = [tuple(v % specs[i]["mod"] for v, i in zip(c, per_idx)) for c in cand]
+            seen = set()
+            for c in cand:
+                if c in seen:
+                    continue
+                seen.add(c)
+                ok = all(sample_value(specs[i], r) is not None for r, i in zip(c, per_idx))
+                if ok:
+                    groups.append(c)
+            groups = groups[:40]
+        else:
+            groups = [()]
+        if not groups:
+            return "Error: no valid residue groups in the given ranges."
+
+        per_group = max(12, num_samples // len(groups))
+        n_calls = 0
+        errors = 0
+        group_results = []
+        for g in groups:
+            pts = []
+            for _ in range(per_group):
+                vals = [None] * len(specs)
+                for r, i in zip(g, per_idx):
+                    vals[i] = sample_value(specs[i], r)
+                for i in lin_idx:
+                    vals[i] = sample_value(specs[i])
+                try:
+                    y = f(*vals)
+                    n_calls += 1
+                except Exception:
+                    errors += 1
+                    continue
+                if isinstance(y, bool):
+                    y = int(y)
+                try:
+                    y = int(y)
+                except Exception:
+                    return f"Error: oracle returned non-integer {y!r} at args {_fmt_args(vals)}"
+                pts.append((tuple(vals[i] for i in lin_idx), y, tuple(vals)))
+            if len(pts) < 3:
+                continue
+            best = None
+            for mode in ("affine", "abs"):
+                rule, matched, total, mism = _fit_group([(x, y) for x, y, _ in pts], lin_names, mode)
+                score = matched / total
+                if best is None or score > best[0] + 1e-12:
+                    best = (score, mode, rule, matched, total, mism)
+                if matched == total:
+                    break
+            group_results.append((g, best))
+
+        # Dependency test: which parameters change the output.
+        dep_lines = []
+        for i, s in enumerate(specs):
+            changed = 0
+            trials = 0
+            for _ in range(6):
+                base = [None] * len(specs)
+                for j, t in enumerate(specs):
+                    base[j] = sample_value(t, rng.randrange(t["mod"]) if t["kind"] == "periodic" else None)
+                    if base[j] is None:
+                        base[j] = t["lo"]
+                if specs[i]["kind"] == "periodic":
+                    vals_alt = [sample_value(s, rng.randrange(s["mod"])) for _ in range(3)]
+                else:
+                    vals_alt = [s["lo"], s["hi"], rng.randint(s["lo"], s["hi"])]
+                outs = []
+                for v in vals_alt:
+                    if v is None:
+                        continue
+                    a = list(base)
+                    a[i] = v
+                    try:
+                        outs.append(f(*a))
+                        n_calls += 1
+                    except Exception:
+                        errors += 1
+                if len(outs) >= 2:
+                    trials += 1
+                    if any(o != outs[0] for o in outs[1:]):
+                        changed += 1
+            pct = (100 * changed // trials) if trials else -1
+            dep_lines.append(f"  {s['name']}: changes output in {pct}% of trials" if trials else
+                             f"  {s['name']}: not tested")
+
+        lines = [f"oracle calls={n_calls} errors={errors} groups={len(group_results)} "
+                 f"per_group={per_group}"]
+        lines.append("dependency (parameter changes output alone):")
+        lines += dep_lines[:12]
+        full_ok = sum(1 for _, b in group_results if b and b[3] == b[4])
+        lines.append(f"groups fully matched: {full_ok}/{len(group_results)}")
+        shown = 0
+        for g, b in group_results:
+            if shown >= 12:
+                lines.append("  ...more groups omitted")
+                break
+            score, mode, rule, matched, total, _ = b
+            gname = ",".join(f"{specs[i]['name']}%{specs[i]['mod']}={r}" for r, i in zip(g, per_idx)) or "all"
+            rule_s = rule if len(rule) <= 160 else rule[:157] + "..."
+            lines.append(f"[{gname}] {mode}: {rule_s} match={matched}/{total}")
+            shown += 1
+        cex = []
+        for g, b in group_results:
+            if b and b[5]:
+                for x, y, pred in b[5]:
+                    if len(cex) >= 5:
+                        break
+                    cex.append(f"  args{_fmt_args(x)} f={y} rule_pred={pred}")
+            if len(cex) >= 5:
+                break
+        if cex:
+            lines.append("counterexamples (linear args only):")
+            lines += cex
+        else:
+            lines.append("no counterexamples to the best fits")
+        out = "\n".join(lines)
+        if len(out) > OUT_CAP:
+            out = out[:OUT_CAP - 30] + "\n...<output clipped>"
+        return out
+    except Exception as e:
+        return f"Error during fit: {type(e).__name__}: {e}\n{traceback.format_exc()[-800:]}"
