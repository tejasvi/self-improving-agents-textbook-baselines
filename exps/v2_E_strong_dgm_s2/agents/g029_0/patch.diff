@@ -0,0 +1,88 @@
+import json
+import os
+import subprocess
+import sys
+import importlib.util
+
+PER_SAMPLE_TIMEOUT = 10
+CLIP = 600
+
+
+def tool_info():
+    return {
+        "name": "sample_match",
+        "description": """Check a stdin/stdout program against the statement's sample tests with EXACT comparison.\n
+* Runs the program on each sample input (stdin) and compares its stdout with the expected sample output, ignoring only leading/trailing whitespace and line-ending differences.\n
+* Reports one line per sample: EXACT, DIFFERENT (with expected and actual output), or ERROR (crash or timeout).\n
+* No checker fallback: a valid-but-different answer is reported as DIFFERENT, because the grader may compare exactly with the sample outputs.\n
+* Samples come either from a JSON list of [input, expected] pairs (a JSON string or a path to a .json file), or from a generator .py file that defines samples() (e.g. _work/gen.py).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the stdin/stdout Python program to test."},
+                "samples_path_or_json": {"type": "string", "description": "A JSON list of [input, expected_output] pairs, a path to a .json file with that list, or a path to a .py file defining samples()."}
+            },
+            "required": ["solution_path", "samples_path_or_json"]
+        }
+    }
+
+
+def _load_samples(spec):
+    spec = spec.strip()
+    if spec.endswith('.py') and os.path.isfile(spec):
+        mod_spec = importlib.util.spec_from_file_location('_sample_match_gen', spec)
+        mod = importlib.util.module_from_spec(mod_spec)
+        mod_spec.loader.exec_module(mod)
+        if not hasattr(mod, 'samples'):
+            raise ValueError(f"{spec} defines no samples()")
+        return list(mod.samples())
+    if spec.endswith('.json') and os.path.isfile(spec):
+        with open(spec, 'r', encoding='utf-8') as f:
+            return json.load(f)
+    return json.loads(spec)
+
+
+def _norm(s):
+    return '\n'.join(line.rstrip() for line in s.strip().splitlines())
+
+
+def _clip(s):
+    return s if len(s) <= CLIP else s[:CLIP] + '...<clipped>'
+
+
+def tool_function(solution_path, samples_path_or_json):
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    try:
+        samples = _load_samples(samples_path_or_json)
+    except Exception as e:
+        return f"Error: could not load samples: {e}"
+    if not samples:
+        return "Error: no samples provided."
+
+    lines = []
+    exact = 0
+    for k, item in enumerate(samples):
+        try:
+            inp, expected = item
+        except (TypeError, ValueError):
+            lines.append(f"sample {k}: ERROR (malformed sample entry)")
+            continue
+        inp = str(inp)
+        expected = str(expected)
+        try:
+            proc = subprocess.run([sys.executable, solution_path], input=inp, capture_output=True,
+                                  text=True, timeout=PER_SAMPLE_TIMEOUT)
+        except subprocess.TimeoutExpired:
+            lines.append(f"sample {k}: ERROR (timeout after {PER_SAMPLE_TIMEOUT}s)")
+            continue
+        if proc.returncode != 0:
+            lines.append(f"sample {k}: ERROR (exit code {proc.returncode}): {_clip(proc.stderr.strip()[-300:])}")
+            continue
+        if _norm(proc.stdout) == _norm(expected):
+            exact += 1
+            lines.append(f"sample {k}: EXACT")
+        else:
+            lines.append(f"sample {k}: DIFFERENT\n  expected: {_clip(expected.strip())!r}\n  actual:   {_clip(proc.stdout.strip())!r}")
+    lines.append(f"Summary: {exact}/{len(samples)} samples EXACT.")
+    return "\n".join(lines)
