@@ -0,0 +1,48 @@
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "timing",
+        "description": """Time a shell command once per input file, with stdin redirected from each file.\n
+* Each run is limited by `timeout` seconds; runs that exceed it are reported as TIMEOUT.\n
+* Returns a table with one row per input file: the file path, elapsed seconds (or TIMEOUT), and the exit code.\n
+* Use it for performance gates, e.g. command `python3 solution.py` with the adversarial max-size inputs as input_files.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {"type": "string", "description": "Shell command to run for each input, e.g. `python3 solution.py`. Its stdin is set to each input file in turn."},
+                "input_files": {"type": "array", "items": {"type": "string"}, "description": "Paths of the input files to run the command on, one run per file."},
+                "timeout": {"type": "number", "description": "Per-run time limit in seconds (default 5)."}
+            },
+            "required": ["command", "input_files"]
+        }
+    }
+
+
+def tool_function(command, input_files, timeout=5):
+    try:
+        limit = float(timeout) if timeout is not None else 5.0
+    except (TypeError, ValueError):
+        limit = 5.0
+    limit = max(0.1, min(limit, 300.0))
+    if isinstance(input_files, str):
+        input_files = [input_files]
+    rows = ["file\telapsed_s\texit_code"]
+    for path in input_files or []:
+        try:
+            with open(path, "rb") as fin:
+                start = time.time()
+                try:
+                    p = subprocess.run(["bash", "-c", command], stdin=fin, stdout=subprocess.DEVNULL,
+                                       stderr=subprocess.PIPE, timeout=limit)
+                    elapsed = time.time() - start
+                    err = p.stderr.decode("utf-8", "replace").strip().splitlines()
+                    tail = err[-1] if (p.returncode != 0 and err) else ""
+                    rows.append(f"{path}\t{elapsed:.3f}\t{p.returncode}" + (f"  # {tail[:200]}" if tail else ""))
+                except subprocess.TimeoutExpired:
+                    rows.append(f"{path}\tTIMEOUT (>{limit}s)\t-")
+        except OSError as e:
+            rows.append(f"{path}\tERROR\t{e}")
+    return "\n".join(rows)
