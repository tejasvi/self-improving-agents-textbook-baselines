index 0000000..f7ce6fe
--- /dev/null
+++ b/tools/diff_test.py
@@ -0,0 +1,86 @@
+import subprocess
+from collections import Counter
+
+
+def tool_info():
+    return {
+        "name": "diff_test",
+        "description": """Differential tester: runs a solution command and a reference command on inputs produced by a generator command, for a range of seeds, and reports mismatches.\n
+* `generator_cmd` is a shell command that prints ONE test input to stdout. The seed is appended as the last argument, or substituted for the literal `{seed}` if that placeholder is present (e.g. `python3 tests/gen.py {seed} medium`).\n
+* `solution_cmd` and `reference_cmd` are shell commands that read the input on stdin and print the answer on stdout (e.g. `python3 solution.py`).\n
+* Outputs are compared token by token (whitespace-insensitive). A timeout or crash counts as a mismatch.\n
+* Returns at most the first 3 mismatches, smallest inputs first, each with both outputs, plus a histogram of input sizes (number of whitespace tokens) over all seeds run.\n
+* Use it for medium-size differential testing of an optimized solution against a simple polynomial reference.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {"type": "string", "description": "Shell command for the solution under test; reads stdin, writes stdout."},
+                "reference_cmd": {"type": "string", "description": "Shell command for the trusted reference; reads stdin, writes stdout."},
+                "generator_cmd": {"type": "string", "description": "Shell command that prints one test input to stdout; seed appended or substituted for {seed}."},
+                "seed_start": {"type": "integer", "description": "First seed to run (default 0)."},
+                "count": {"type": "integer", "description": "Number of seeds to run (default 200, max 2000)."},
+                "timeout": {"type": "integer", "description": "Per-command timeout in seconds (default 10, max 60)."}
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _run(cmd, inp, timeout):
+    try:
+        p = subprocess.run(['bash', '-c', cmd], input=inp, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        return None, 'TIMEOUT'
+    if p.returncode != 0:
+        return None, 'CRASH: ' + (p.stderr.strip().splitlines() or ['exit %d' % p.returncode])[-1][:200]
+    return p.stdout.split(), p.stdout.strip()[:300]
+
+
+def _short(s, n=300):
+    return s if len(s) <= n else s[:n] + '...'
+
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, seed_start=0, count=200, timeout=10):
+    seed_start = int(seed_start or 0)
+    count = max(1, min(int(count or 200), 2000))
+    timeout = max(1, min(int(timeout or 10), 60))
+    mismatches = []
+    sizes = Counter()
+    ran = 0
+    for seed in range(seed_start, seed_start + count):
+        if '{seed}' in generator_cmd:
+            gcmd = generator_cmd.replace('{seed}', str(seed))
+        else:
+            gcmd = f"{generator_cmd} {seed}"
+        try:
+            p = subprocess.run(['bash', '-c', gcmd], capture_output=True, text=True, timeout=timeout)
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out at seed {seed}."
+        if p.returncode != 0:
+            return f"Generator failed at seed {seed}: {p.stderr.strip()[-300:]}"
+        inp = p.stdout
+        sizes[len(inp.split())] += 1
+        ran += 1
+        got, got_raw = _run(solution_cmd, inp, timeout)
+        exp, exp_raw = _run(reference_cmd, inp, timeout)
+        if exp is None:
+            return f"Reference failed at seed {seed}: {exp_raw}\nInput:\n{_short(inp)}"
+        if got is None or got != exp:
+            mismatches.append((len(inp.split()), len(inp), seed, inp, got_raw, exp_raw))
+
+    lines = [f"Ran {ran} seeds [{seed_start}, {seed_start + count}); mismatches: {len(mismatches)}"]
+    mismatches.sort(key=lambda m: (m[0], m[1], m[2]))
+    for tokens, _, seed, inp, got_raw, exp_raw in mismatches[:3]:
+        lines.append(f"--- MISMATCH seed={seed} input_tokens={tokens}")
+        lines.append("input:\n" + _short(inp, 400).rstrip())
+        lines.append("solution output: " + got_raw)
+        lines.append("reference output: " + exp_raw)
+    # Compact size histogram: buckets by powers of two of the token count.
+    buckets = Counter()
+    for tok, c in sizes.items():
+        lo = 0 if tok == 0 else 1 << (tok.bit_length() - 1)
+        buckets[lo] += c
+    hist = ", ".join(f"[{lo}..{2 * lo - 1 if lo else 0}]:{buckets[lo]}" for lo in sorted(buckets))
+    lines.append("input size histogram (tokens): " + (hist or "none"))
+    return "\n".join(lines)
