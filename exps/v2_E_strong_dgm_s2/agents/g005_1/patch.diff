+"""Standalone core logic for the scalability gate and the fixed sample parser.
+
+- parse_statement(text): extracts samples from a problem statement. Only
+  'Sample Input N' / 'Sample Output N' (or 'Input:' / 'Output:' with a colon)
+  act as headings. Bare 'Input' / 'Output' section headers are ignored.
+  An output block ends at a blank line followed by prose, or at an
+  'Explanation' / 'Let us' line.
+- scale_check(solution_path, inputs, time_limit): runs `python3 solution_path`
+  on each input with a timeout and reports OK / TIMEOUT / WRONG per input,
+  ending with 'SCALABILITY: PASS' or 'SCALABILITY: FAIL (n problem(s))'.
+"""
+
+import json
+import re
+import subprocess
+import sys
+import time
+
+_IN_HEAD = re.compile(r'^\s*(?:#+\s*)?(?:Sample\s+Input\s*\d*\s*:?|Input:)\s*$', re.I)
+_OUT_HEAD = re.compile(r'^\s*(?:#+\s*)?(?:Sample\s+Output\s*\d*\s*:?|Output:)\s*$', re.I)
+_STOP = re.compile(r'^\s*(?:Explanation|Let us|Note\b|#+\s)', re.I)
+
+
+def parse_statement(text):
+    """Return a list of {"input": str, "expected": str} dicts."""
+    lines = text.splitlines()
+    samples = []
+    i = 0
+    n = len(lines)
+    while i < n:
+        if _IN_HEAD.match(lines[i]):
+            i += 1
+            inp = []
+            while i < n and not _OUT_HEAD.match(lines[i]) and not _IN_HEAD.match(lines[i]):
+                inp.append(lines[i])
+                i += 1
+            if i < n and _OUT_HEAD.match(lines[i]):
+                i += 1
+                out = []
+                while i < n:
+                    ln = lines[i]
+                    if _STOP.match(ln) or _IN_HEAD.match(ln) or _OUT_HEAD.match(ln):
+                        break
+                    if ln.strip() == '':
+                        # blank line: end the block if followed by prose or the end
+                        j = i + 1
+                        while j < n and lines[j].strip() == '':
+                            j += 1
+                        if j >= n or not re.match(r'^\s*[-+]?\d|^\s*[\w\[]', lines[j]) or \
+                                not _numeric_like(lines[j]):
+                            break
+                        i = j
+                        continue
+                    out.append(ln)
+                    i += 1
+                samples.append({
+                    'input': '\n'.join(inp).strip('\n') + '\n',
+                    'expected': '\n'.join(out).strip('\n') + '\n',
+                })
+            continue
+        i += 1
+    return samples
+
+
+def _numeric_like(line):
+    """True if a line looks like sample data (tokens of numbers / short words)."""
+    toks = line.split()
+    if not toks or len(toks) > 12:
+        return False
+    return all(re.match(r'^[-+]?[\w.\-\[\],]+$', t) and len(t) <= 40 for t in toks)
+
+
+def _self_test():
+    stmt = """Tile Distance 3
+
+Input
+
+Print T lines.
+
+Sample Input 1
+
+2
+1 2
+3 4
+
+Sample Output 1
+
+3
+7
+
+Explanation
+
+Let us see.
+
+Input
+
+Print T lines.
+"""
+    s = parse_statement(stmt)
+    assert len(s) == 1, s
+    assert s[0]['input'] == '2\n1 2\n3 4\n', repr(s[0]['input'])
+    assert s[0]['expected'] == '3\n7\n', repr(s[0]['expected'])
+    assert all('Print' not in x['input'] for x in s)
+    return True
+
+
+def scale_check(solution_path, inputs, time_limit=2):
+    """inputs: list of {"input": str, "expected": str|None}."""
+    report = []
+    failures = 0
+    for idx, item in enumerate(inputs, 1):
+        inp = item.get('input', '')
+        exp = item.get('expected')
+        t0 = time.time()
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path], input=inp, capture_output=True,
+                text=True, timeout=time_limit)
+            wall = time.time() - t0
+            out = proc.stdout
+            if proc.returncode != 0:
+                status = 'ERROR'
+            elif exp is not None and out.strip() != exp.strip():
+                status = 'WRONG'
+            else:
+                status = 'OK'
+        except subprocess.TimeoutExpired:
+            wall = time.time() - t0
+            out = ''
+            status = 'TIMEOUT'
+        if status != 'OK':
+            failures += 1
+        report.append('[%d] %s %.2fs output=%r' % (idx, status, wall, out[:200]))
+    report.append('SCALABILITY: PASS' if failures == 0 else
+                  'SCALABILITY: FAIL (%d problem(s))' % failures)
+    return '\n'.join(report)
+
+
+if __name__ == '__main__':
+    _self_test()
+    if len(sys.argv) >= 2:
+        with open(sys.argv[1]) as f:
+            text = f.read()
+        samples = parse_statement(text)
+        print(json.dumps(samples, indent=2))
+        if len(sys.argv) >= 3:
+            print(scale_check(sys.argv[2], samples, time_limit=2))
+    else:
+        print('self-test passed')
