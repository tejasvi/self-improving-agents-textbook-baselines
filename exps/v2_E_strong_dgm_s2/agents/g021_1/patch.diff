+    def _add_to_pool(self, inp, expected):
+        """Add a failing (input, expected) pair to the regression pool (dedup, short inputs only)."""
+        inp = inp.strip()
+        expected = expected.strip()
+        if not inp or len(inp) > 2000 or any(p[0] == inp for p in self.regression_pool):
+            return
+        self.regression_pool.append((inp, expected))
+        try:
+            os.makedirs(self.regress_dir, exist_ok=True)
+            n = len(self.regression_pool)
+            with open(os.path.join(self.regress_dir, f'{n:03d}.in'), 'w') as f:
+                f.write(inp + '\n')
+            with open(os.path.join(self.regress_dir, f'{n:03d}.out'), 'w') as f:
+                f.write(expected + '\n')
+        except OSError as e:
