index 0000000..bed9921
--- /dev/null
+++ b/tools/run_variants.py
@@ -0,0 +1,70 @@
+import subprocess
+
+RUN_TIMEOUT_DEFAULT = 10
+
+
+def tool_info():
+    return {
+        "name": "run_variants",
+        "description": """Run a shell command once per given stdin string and return the raw outputs.\n
+* Each entry of `inputs` is fed as stdin to a separate run of `command` (e.g. `python3 solution.py`), so several input layouts can be tried in one call.\n
+* For each run, the raw stdout, stderr and exit code are returned verbatim, without any parsing or interpretation.\n
+* Each run has its own time limit (default 10 seconds); a run that exceeds it is reported as timed out.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run for each input, e.g. `python3 solution.py`."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin contents; the command is run once per entry with that text as its standard input."
+                }
+            },
+            "required": ["command", "inputs"]
+        }
+    }
+
+
+def _clip(s, n=4000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def tool_function(command, inputs, timeout=RUN_TIMEOUT_DEFAULT):
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    try:
+        limit = float(timeout) if timeout is not None else RUN_TIMEOUT_DEFAULT
+    except (TypeError, ValueError):
+        limit = RUN_TIMEOUT_DEFAULT
+    limit = max(0.5, min(limit, 300.0))
+
+    sections = []
+    for idx, text in enumerate(inputs or []):
+        if text is None:
+            text = ""
+        header = f"=== run {idx + 1}/{len(inputs)} ==="
+        try:
+            p = subprocess.run(
+                ['bash', '-c', command], input=str(text), capture_output=True, text=True,
+                timeout=limit, errors='replace'
+            )
+            body = (
+                f"stdout:\n{_clip(p.stdout)}\n"
+                f"stderr:\n{_clip(p.stderr)}\n"
+                f"exit code: {p.returncode}"
+            )
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout if isinstance(e.stdout, str) else ''
+            err = e.stderr if isinstance(e.stderr, str) else ''
+            body = (
+                f"stdout:\n{_clip(out)}\n"
+                f"stderr:\n{_clip(err)}\n"
+                f"exit code: TIMEOUT after {limit} seconds"
+            )
+        sections.append(f"{header}\n{body}")
+    return "\n\n".join(sections) or "(no inputs given)"
