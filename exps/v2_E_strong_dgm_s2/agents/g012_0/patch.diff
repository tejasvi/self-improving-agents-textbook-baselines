diff --git a/tools/perf_test.py b/tools/perf_test.py
new file mode 100644
index 0000000..3734663
--- /dev/null
+++ b/tools/perf_test.py
@@ -0,0 +1,168 @@
+import importlib.util
+import math
+import os
+import pickle
+import subprocess
+import sys
+import tempfile
+import time
+
+# Child driver for Solution.method tasks: loads the solution file, instantiates Solution,
+# and calls the method with the pickled positional arguments.
+_METHOD_DRIVER = r'''
+import sys, pickle, importlib.util, os
+sol_path, args_path, method = sys.argv[1:4]
+d = os.path.dirname(os.path.abspath(sol_path))
+sys.path.insert(0, d)
+spec = importlib.util.spec_from_file_location("_perf_solution", sol_path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+with open(args_path, "rb") as f:
+    args = pickle.load(f)
+inst = mod.Solution()
+getattr(inst, method)(*args)
+'''
+
+_DEFAULT_TIMEOUT = 10
+_BUDGET_SECONDS = 270
+
+
+def tool_info():
+    return {
+        "name": "perf_test",
+        "description": """Measure the running time of a solution on large generated inputs of several distributions.\n
+* The generator file must define `KINDS` (a list of distribution names) and `gen_large(kind, n)` returning an input object at size n.
+* For each kind and each size (default n/4, n/2, n where n is the maximum constraint), the solution is run in a subprocess with a timeout.
+* For stdin programs the input object must be a string (it is piped to `python3 solution_path`). For class-based tasks (`method` given) the input object must be a tuple of positional arguments and `Solution().method(*args)` is timed.
+* Output is a plain-text table: kind, size, seconds (or TIMEOUT / crash markers), and the growth exponent between consecutive sizes (about 1 = linear, about 2 = quadratic). Read the raw numbers and decide how to optimize.
+* Use it after the stress tests, at the maximum constraint size, with at least four distributions (all-equal, uniform random, skewed, sorted, etc.).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file."},
+                "generator_path": {"type": "string", "description": "Path to the generator file defining KINDS and gen_large(kind, n)."},
+                "method": {"type": "string", "description": "Optional. Name of the method of class Solution to time (class-based tasks only)."},
+                "sizes": {"type": "array", "items": {"type": "integer"}, "description": "Optional list of input sizes to test. If omitted, uses [n/4, n/2, n] with n = MAX_N from the generator file."},
+                "timeout": {"type": "integer", "description": "Per-run timeout in seconds (default 10)."}
+            },
+            "required": ["solution_path", "generator_path"]
+        }
+    }
+
+
+def _load(path, name):
+    d = os.path.dirname(os.path.abspath(path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _run_once(solution_path, method, obj, timeout, workdir):
+    """Returns (seconds or None, marker) where marker is '' on success, else a description."""
+    sol_abs = os.path.abspath(solution_path)
+    if method:
+        args = obj if isinstance(obj, tuple) else (obj,)
+        args_path = os.path.join(workdir, "args.pkl")
+        with open(args_path, "wb") as f:
+            pickle.dump(args, f)
+        cmd = [sys.executable, "-c", _METHOD_DRIVER, sol_abs, args_path, method]
+        stdin_data = None
+    else:
+        cmd = [sys.executable, sol_abs]
+        stdin_data = obj if isinstance(obj, str) else str(obj)
+    start = time.perf_counter()
+    try:
+        p = subprocess.run(cmd, input=stdin_data, capture_output=True, text=True,
+                           timeout=timeout, stdin=None if stdin_data is not None else subprocess.DEVNULL,
+                           cwd=workdir, errors="replace")
+    except subprocess.TimeoutExpired:
+        return None, "TIMEOUT"
+    elapsed = time.perf_counter() - start
+    if p.returncode != 0:
+        last = (p.stderr.strip().splitlines() or ["?"])[-1][:120]
+        return elapsed, f"CRASH(rc={p.returncode}: {last})"
+    return elapsed, ""
+
+
+def tool_function(solution_path, generator_path, method=None, sizes=None, timeout=10):
+    if not solution_path or not os.path.isfile(os.path.abspath(solution_path)):
+        return f"Error: solution_path does not exist: {solution_path}"
+    if not generator_path or not os.path.isfile(os.path.abspath(generator_path)):
+        return f"Error: generator_path does not exist: {generator_path}"
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else _DEFAULT_TIMEOUT), 120))
+    except (TypeError, ValueError):
+        return "Error: timeout must be an integer."
+    try:
+        gen = _load(generator_path, "_perf_gen")
+    except BaseException as e:
+        return f"Error: failed to import generator: {type(e).__name__}: {e}"
+    if not hasattr(gen, "gen_large") or not hasattr(gen, "KINDS"):
+        return "Error: generator file must define KINDS and gen_large(kind, n)."
+    if sizes is None:
+        if not hasattr(gen, "MAX_N"):
+            return "Error: no sizes given and generator has no MAX_N attribute."
+        n = int(gen.MAX_N)
+        sizes = [max(1, n // 4), max(1, n // 2), n]
+    if isinstance(sizes, int):
+        n = sizes
+        sizes = [max(1, n // 4), max(1, n // 2), n]
+    try:
+        sizes = sorted({max(1, int(s)) for s in sizes})
+    except (TypeError, ValueError):
+        return "Error: sizes must be a list of integers."
+
+    lines = []
+    lines.append(f"perf_test: solution={solution_path} method={method or '-'} timeout={timeout}s sizes={sizes}")
+    lines.append(f"{'kind':<22}{'size':>10}{'seconds':>12}  note")
+    lines.append("-" * 70)
+    overall_start = time.perf_counter()
+    summary = []
+    with tempfile.TemporaryDirectory() as workdir:
+        for kind in gen.KINDS:
+            prev = None  # (size, seconds) of previous successful run
+            timed_out_kind = False
+            for size in sizes:
+                if timed_out_kind:
+                    lines.append(f"{str(kind):<22}{size:>10}{'-':>12}  SKIPPED (a smaller size already timed out)")
+                    continue
+                if time.perf_counter() - overall_start > _BUDGET_SECONDS:
+                    lines.append(f"{str(kind):<22}{size:>10}{'-':>12}  SKIPPED (overall time budget exhausted)")
+                    continue
+                try:
+                    obj = gen.gen_large(kind, size)
+                except BaseException as e:
+                    lines.append(f"{str(kind):<22}{size:>10}{'-':>12}  GENERATOR ERROR: {type(e).__name__}: {e}")
+                    prev = None
+                    continue
+                secs, marker = _run_once(solution_path, method, obj, timeout, workdir)
+                if secs is None:
+                    lines.append(f"{str(kind):<22}{size:>10}{'>' + str(timeout):>12}  {marker}")
+                    summary.append(f"{kind} n={size}: TIMEOUT")
+                    prev = None
+                    timed_out_kind = True
+                    continue
+                note = marker
+                if prev is not None and prev[1] > 0 and secs > 0 and size > prev[0]:
+                    ratio_t = secs / prev[1]
+                    ratio_n = size / prev[0]
+                    exp = math.log(ratio_t) / math.log(ratio_n)
+                    if secs < 0.02 and prev[1] < 0.02:
+                        growth = "growth: n/a (too fast to measure)"
+                    else:
+                        flag = ""
+                        if exp > 1.5:
+                            flag = "  <-- superlinear (quadratic or worse?)"
+                        growth = f"growth vs n={prev[0]}: x{ratio_t:.2f} for x{ratio_n:.2f} size (exponent ~{exp:.2f}){flag}"
+                    note = (note + "; " if note else "") + growth
+                lines.append(f"{str(kind):<22}{size:>10}{secs:>12.3f}  {note}".rstrip())
+                summary.append(f"{kind} n={size}: {secs:.3f}s" + (f" {marker}" if marker else ""))
+                prev = (size, secs)
+    lines.append("-" * 70)
+    worst = [s for s in summary if "TIMEOUT" in s or "CRASH" in s]
+    lines.append(f"timeouts/crashes: {len(worst)}" + ("" if not worst else " -> " + "; ".join(worst)))
+    lines.append(f"total wall time: {time.perf_counter() - overall_start:.1f}s")
+    return "\n".join(lines)
