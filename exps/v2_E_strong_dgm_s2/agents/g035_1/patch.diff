+import sys
+import bisect
+
+
+def main():
+    data = sys.stdin.read().split()
+    n, x = int(data[0]), int(data[1])
+    a = [int(v) for v in data[2:2 + n]]
+    pos = {}
+    for idx, v in enumerate(a):
+        pos.setdefault(v, []).append(idx)
+    last = {v: lst[-1] for v, lst in pos.items()}
+    for i in range(n):
+        ai = a[i]
+        for j in range(i + 1, n):
+            need = x - ai - a[j]
+            lk = last.get(need)
+            if lk is None or lk <= j:
+                continue
+            lst = pos[need]
+            p = bisect.bisect_right(lst, j)
+            sys.stdout.write(f"{i + 1} {j + 1} {lst[p] + 1}\n")
+            return
+    sys.stdout.write("-1\n")
+
+
+main()
