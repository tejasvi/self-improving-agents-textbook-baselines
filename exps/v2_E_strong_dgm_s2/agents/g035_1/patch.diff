diff --git a/_work/brute.py b/_work/brute.py
new file mode 100644
index 0000000..922fb3a
--- /dev/null
+++ b/_work/brute.py
@@ -0,0 +1,24 @@
+# Brute force for the assumed task: input "N X" then N integers a_1..a_N (1 <= a_i <= X).
+# Output: indices i j k (1-based, i < j < k) with a_i + a_j + a_k == X, or -1 if none exists.
+# Prints the lexicographically first valid triple (smallest i, then smallest j, then smallest k).
+# Plain O(N^2 log N) enumeration of pairs (i, j) with a lookup for the third index; correct but not the intended fast method.
+import bisect
+
+
+def solve(input_obj):
+    data = str(input_obj).split()
+    n, x = int(data[0]), int(data[1])
+    a = [int(v) for v in data[2:2 + n]]
+    pos = {}
+    for idx, v in enumerate(a):
+        pos.setdefault(v, []).append(idx)  # sorted by construction
+    for i in range(n):
+        for j in range(i + 1, n):
+            need = x - a[i] - a[j]
+            lst = pos.get(need)
+            if not lst:
+                continue
+            p = bisect.bisect_right(lst, j)
+            if p < len(lst):
+                return f"{i + 1} {j + 1} {lst[p] + 1}\n"
+    return "-1\n"
