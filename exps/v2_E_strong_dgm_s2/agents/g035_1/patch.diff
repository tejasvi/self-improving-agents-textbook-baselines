@@ -0,0 +1,145 @@
+# Generator for the assumed task: "N X" then N integers a_i with 1 <= a_i <= X; print any valid index triple or -1.
+# Output is NOT unique, so check() validates the answer instead of comparing text.
+import itertools
+import random
+
+MAX_N = 2000
+MAX_X = 10 ** 9
+
+
+def _format(n, x, a):
+    return f"{n} {x}\n" + " ".join(map(str, a)) + "\n"
+
+
+def valid(input_obj):
+    try:
+        data = str(input_obj).split()
+        if len(data) < 2:
+            return False
+        n, x = int(data[0]), int(data[1])
+        if len(data) != 2 + n:
+            return False
+        a = [int(v) for v in data[2:]]
+    except (ValueError, TypeError):
+        return False
+    return 3 <= n <= MAX_N and 1 <= x <= MAX_X and all(1 <= v <= x for v in a)
+
+
+def check(input_str, output_str, expected_str):
+    """None if output_str is an acceptable answer for input_str, else a reason string.
+    expected_str (the brute force answer) is only used to decide the -1 case, since the answer is not unique."""
+    data = str(input_str).split()
+    n, x = int(data[0]), int(data[1])
+    a = [int(v) for v in data[2:2 + n]]
+    out = str(output_str).strip()
+    exp = str(expected_str).strip()
+    if exp == "-1":
+        return None if out == "-1" else f"expected -1 (no triple exists), got {out!r}"
+    if out == "-1":
+        return "printed -1 but a valid triple exists"
+    parts = out.split()
+    if len(parts) != 3:
+        return f"expected 3 indices, got {out!r}"
+    try:
+        i, j, k = (int(p) for p in parts)
+    except ValueError:
+        return f"non-integer output {out!r}"
+    if not (1 <= i < j < k <= n):
+        return f"indices must satisfy 1 <= i < j < k <= {n}, got {i} {j} {k}"
+    if a[i - 1] + a[j - 1] + a[k - 1] != x:
+        return f"a_i+a_j+a_k = {a[i-1] + a[j-1] + a[k-1]} != {x}"
+    return None
+
+
+def _random_case(rng, n_max, x_max):
+    n = rng.randint(3, max(3, n_max))
+    x = rng.randint(1, max(1, x_max))
+    a = [rng.randint(1, x) for _ in range(n)]
+    if rng.random() < 0.5 and x >= 3:
+        # plant a triple: pick the target first, then fix three values that sum to it
+        i, j, k = rng.sample(range(n), 3)
+        s = rng.randint(3, x)
+        p = rng.randint(1, s - 2)
+        q = rng.randint(1, s - p - 1)
+        a[i], a[j], a[k] = p, q, s - p - q
+        x = s if rng.random() < 0.5 else x
+        a = [min(max(v, 1), x) for v in a]
+    return _format(n, x, a)
+
+
+def gen(rng, size):
+    size = max(1, size)
+    n_max = min(MAX_N, 3 + size * 2)
+    x_max = min(MAX_X, 2 + size * 10)
+    return _random_case(rng, n_max, x_max)
+
+
+def enumerate_all():
+    # Every case with n in 3..4 and all values in 1..3 with X in 1..6.
+    for n in (3, 4):
+        for x in range(1, 7):
+            for a in itertools.product(range(1, min(x, 3) + 1), repeat=n):
+                yield _format(n, x, list(a))
+
+
+def samples():
+    # Hand-made samples (assumed task, not from a statement).
+    return [
+        (_format(5, 9, [1, 2, 3, 4, 5]), "1 3 5\n"),
+        (_format(3, 100, [1, 2, 3]), "-1\n"),
+        (_format(4, 6, [2, 2, 2, 2]), "1 2 3\n"),
+    ]
+
+
+def _large_random(rng, n):
+    x = MAX_X
+    a = [rng.randint(1, x) for _ in range(n)]
+    i, j, k = rng.sample(range(n), 3)
+    vals = [rng.randint(1, x // 3) for _ in range(2)]
+    vals.append(x - sum(vals))
+    if 1 <= vals[2] <= x:
+        a[i], a[j], a[k] = vals
+    return _format(n, x, a)
+
+
+def _large_no_answer(rng, n):
+    # all values even, X odd: no triple can sum to X
+    x = MAX_X if MAX_X % 2 else MAX_X - 1
+    a = [2 * rng.randint(1, x // 2) for _ in range(n)]
+    return _format(n, x, [min(v, x) for v in a])
+
+
+def _large_all_equal(rng, n):
+    x = 3 * MAX_X // 3
+    return _format(n, x, [x // 3] * n)
+
+
+def _large_small_values(rng, n):
+    x = 6
+    a = [rng.randint(1, 2) for _ in range(n)]
+    return _format(n, x, a)
+
+
+def _large_answer_at_end(rng, n):
+    x = 30
+    a = [1] * n
+    a[-3], a[-2], a[-1] = 10, 10, 10
+    return _format(n, x, a)
+
+
+LARGE_KINDS = ["random_with_answer", "no_answer_even", "all_equal", "small_values", "answer_at_end"]
+
+
+def gen_large(rng, kind):
+    n = MAX_N
+    if kind == "random_with_answer":
+        return _large_random(rng, n)
+    if kind == "no_answer_even":
+        return _large_no_answer(rng, n)
+    if kind == "all_equal":
+        return _large_all_equal(rng, n)
+    if kind == "small_values":
+        return _large_small_values(rng, n)
+    if kind == "answer_at_end":
+        return _large_answer_at_end(rng, n)
+    raise ValueError(f"unknown kind {kind}")
