+# Placeholder generator. Problem statement/samples are unknown, so samples() is empty.
+import random
+
+
+def gen(rng: random.Random, size: int):
+    """Small random stdin text. Mixes uniform, degenerate (empty/all-equal) and boundary-ish cases."""
+    regime = rng.randrange(3)
+    n = rng.randint(0, max(1, size))
+    if regime == 0:
+        return ''.join(rng.choice('abcdef') for _ in range(n))
+    if regime == 1:
+        return 'a' * n
+    return '\n'.join(str(rng.randint(-10**9, 10**9)) for _ in range(min(n, 5)))
+
+
+def gen_large(rng: random.Random):
+    return ''.join(rng.choice('abcdefghijklmnopqrstuvwxyz') for _ in range(rng.randint(10**4, 10**5)))
+
+
+def enumerate_all():
+    for n in range(0, 3):
+        for t in __import__('itertools').product('ab', repeat=n):
+            yield ''.join(t)
+
+
+def tiny_inputs():
+    return list(enumerate_all())
+
+
+def samples():
+    return []
