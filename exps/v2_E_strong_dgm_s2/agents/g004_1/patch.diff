+    def _clean_history(self, msg_history):
+        """
+        Remove empty or '(no output)' assistant messages and synthetic 'cut off by the output limit'
+        user messages, then merge consecutive messages with the same role.
+        """
+        if not isinstance(msg_history, list):
+            return []
+        kept = []
+        for msg in msg_history:
+            if not isinstance(msg, dict):
+                continue
+            role = msg.get('role')
+            if role == 'assistant' and self._message_is_empty_assistant(msg):
+                continue
+            if role == 'user' and self._message_is_cutoff_nudge(msg):
+                continue
+            kept.append(msg)
+
+        merged = []
+        for msg in kept:
+            if merged and merged[-1].get('role') == msg.get('role'):
+                prev = merged[-1]
+                merged[-1] = {
+                    'role': prev['role'],
+                    'content': self._as_block_list(prev.get('content')) + self._as_block_list(msg.get('content')),
+                }
+            else:
+                merged.append({'role': msg.get('role'), 'content': msg.get('content')})
+        return merged
