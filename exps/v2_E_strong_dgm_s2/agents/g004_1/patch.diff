+    @classmethod
+    def _message_is_empty_assistant(cls, msg):
+        """True if an assistant message has no real text and no tool_use blocks."""
+        content = msg.get('content')
+        if isinstance(content, str):
+            text = content.strip()
+            return text in ('', '(no output)')
+        if not isinstance(content, list):
+            return True
+        has_tool_use = False
+        texts = []
+        for block in content:
+            if cls._block_type(block) == 'tool_use':
+                has_tool_use = True
+            t = cls._block_text(block)
+            if t is not None:
+                texts.append(t)
+        if has_tool_use:
+            return False
+        joined = ''.join(texts).strip()
+        return joined in ('', '(no output)')
+
+    @classmethod
+    def _message_is_cutoff_nudge(cls, msg):
+        """True if a user message is the synthetic 'cut off by the output limit' nudge."""
+        content = msg.get('content')
+        if isinstance(content, str):
+            return 'cut off by the output limit' in content
+        if not isinstance(content, list):
+            return False
+        for block in content:
+            t = cls._block_text(block)
+            if t is not None and 'cut off by the output limit' in t:
