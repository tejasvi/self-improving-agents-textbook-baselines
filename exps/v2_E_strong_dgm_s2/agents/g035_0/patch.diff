+def detect_task_type(statement):
+    """Return ('class', method_name) for LeetCode-style Solution tasks, else ('stdin', None)."""
+    text = statement or ""
+    m = METHOD_NAME_RE.search(text)
+    if m or 'class Solution' in text:
+        name = m.group(2) if m else None
+        if name is None:
+            dm = re.search(r'def\s+(\w+)\s*\(\s*self', text)
+            name = dm.group(1) if dm else None
+        return 'class', name
+    return 'stdin', None
+
+
+def _split_top_level_commas(s):
+    """Split on commas that are not nested in brackets or quotes."""
+    parts, depth, cur, quote = [], 0, [], None
+    for ch in s:
+        if quote:
+            cur.append(ch)
+            if ch == quote:
+                quote = None
+            continue
+        if ch in '\'"':
+            quote = ch
+        elif ch in '([{':
+            depth += 1
+        elif ch in ')]}':
+            depth -= 1
+        if ch == ',' and depth == 0:
+            parts.append(''.join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+    parts.append(''.join(cur))
+    return [p.strip() for p in parts if p.strip()]
+
+
+def parse_class_input(text):
+    """'nums = [1, 2], k = 3' -> [[1, 2], 3]; positional values are kept in order."""
+    args = []
+    for piece in _split_top_level_commas(text):
+        if re.match(r'^\w+\s*=(?!=)', piece):
+            piece = piece.split('=', 1)[1]
+        args.append(ast.literal_eval(piece.strip()))
+    return args
+
+
+def extract_class_samples(statement):
+    """Parse 'Example N: Input: ... Output: ...' blocks into [{'args': [...], 'expected': ...}]."""
+    out = []
+    for m in CLASS_SAMPLE_RE.finditer(statement or ""):
+        try:
+            args = parse_class_input(m.group(1).strip())
+            expected = ast.literal_eval(m.group(2).strip())
+        except Exception:
+            continue
+        out.append({'args': args, 'expected': expected})
+    return out
+
