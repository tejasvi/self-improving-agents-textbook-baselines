+def enumerate_and_test_rules(domains, is_valid, sample_output, to_str):
+    """Brute-force valid answers over index-tuple domains and report rules
+    whose canonical pick, rendered with to_str, equals sample_output exactly.
+
+    domains: list of iterables, one per answer component (index order).
+    is_valid: fn(tuple) -> bool.
+    sample_output: expected output string.
+    to_str: fn(tuple) -> str.
+    """
+    cands = [c for c in product(*domains) if is_valid(c)]
+    report = {}
+    for name, rule in RULES.items():
+        if not cands:
+            report[name] = False
+            continue
+        report[name] = to_str(rule(cands)) == sample_output
+    return report
 
 
