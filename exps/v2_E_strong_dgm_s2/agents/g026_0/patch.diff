+    def _read_solution_text(self):
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        try:
+            with open(path, 'r', errors='replace') as f:
+                return f.read()
+        except OSError:
+            return '(solution.py not found)'
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Extract the text of the last assistant message from a msg history list."""
+        if not isinstance(msg_history, list):
+            return '(no message)'
+        for msg in reversed(msg_history):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content', '')
+            if isinstance(content, str):
+                return content
+            parts = []
+            if isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict):
+                        text = block.get('text')
+                    else:
+                        text = getattr(block, 'text', None)
+                    if isinstance(text, str):
+                        parts.append(text)
+            if parts:
+                return '\n'.join(parts)
+        return '(no assistant message)'
+
