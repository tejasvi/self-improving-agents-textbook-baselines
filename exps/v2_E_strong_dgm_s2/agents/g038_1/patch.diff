+    def _samples_exact_match(self):
+        """
+        Run solution.py on every sample parsed from /tmp/problem.md.
+        Returns (report_text, all_matched). If no samples were parsed, returns (None, True) so the gate is skipped.
+        """
+        try:
+            from tools.sample_check import _parse_statement, _norm_lines
+        except Exception as e:
+            return (f"Could not import sample parser: {e}", True)
+        try:
+            with open('/tmp/problem.md', 'r', encoding='utf-8', errors='replace') as f:
+                samples = _parse_statement(f.read())
+        except OSError:
+            return (None, True)
+        if not samples:
+            return (None, True)
+        sol = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.isfile(sol):
+            return (f"solution.py not found at {sol}", False)
+
+        reports = []
+        all_ok = True
+        for i, (inp, expected) in enumerate(samples, 1):
+            try:
+                p = subprocess.run(['python3', sol], input=inp, capture_output=True,
+                                   text=True, timeout=10, errors='replace')
+            except subprocess.TimeoutExpired:
+                reports.append(f"Sample {i}: FAIL (timed out)")
+                all_ok = False
+                continue
+            if p.returncode == 0 and _norm_lines(expected) == _norm_lines(p.stdout):
+                reports.append(f"Sample {i}: PASS")
+                continue
