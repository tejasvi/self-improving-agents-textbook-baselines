diff --git a/tools/variant_search.py b/tools/variant_search.py
new file mode 100644
index 0000000..94be11e
--- /dev/null
+++ b/tools/variant_search.py
@@ -0,0 +1,157 @@
+import itertools
+import json
+import os
+import re
+import subprocess
+import tempfile
+
+try:
+    from tools.sample_check import _parse_statement, _load_samples, _norm_lines
+except Exception:  # pragma: no cover - fallback when imported outside the package
+    import sys as _sys
+    _sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+    from tools.sample_check import _parse_statement, _load_samples, _norm_lines
+
+MAX_COMBINATIONS = 500
+_PLACEHOLDER = re.compile(r'\{\{\s*([A-Za-z_][A-Za-z0-9_]*)\s*\}\}')
+
+
+def tool_info():
+    return {
+        "name": "variant_search",
+        "description": """Search over construction variants of a solution to find one that reproduces the sample outputs EXACTLY.\n
+* The solution template is a Python file containing placeholders written as {{NAME}}. Each NAME is a knob whose value is one of several alternative code strings (for example pivot order, free-variable order, bit order, iteration direction, 0- vs 1-based indexing).\n
+* `knobs_json` is a JSON object mapping each placeholder name to a list of alternative strings, e.g. {"ORDER": ["range(n)", "reversed(range(n))"], "BIT": ["0", "1"]}.\n
+* Up to 500 combinations are enumerated; each instantiated program is run on all samples (from `problem_statement_path` or `samples_json`).\n
+* Reports, for the top combinations, how many samples matched exactly, and the full source plus file path of the first combination that matches every sample.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_template_path": {
+                    "type": "string",
+                    "description": "Path to a Python file containing {{NAME}} placeholders to substitute."
+                },
+                "knobs_json": {
+                    "type": "string",
+                    "description": "JSON object mapping each placeholder name to a list of alternative code strings."
+                },
+                "problem_statement_path": {
+                    "type": "string",
+                    "description": "Optional path to a text file containing the problem statement with sample blocks."
+                },
+                "samples_json": {
+                    "type": "string",
+                    "description": "Optional JSON list of objects with 'input' and 'expected' string fields (or a path to such a file)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each sample (default 5)."
+                }
+            },
+            "required": ["solution_template_path", "knobs_json"]
+        }
+    }
+
+
+def _instantiate(template, assignment):
+    def repl(m):
+        name = m.group(1)
+        if name not in assignment:
+            return m.group(0)
+        return assignment[name]
+    return _PLACEHOLDER.sub(repl, template)
+
+
+def _unknown_placeholders(template, knob_names):
+    found = set(m.group(1) for m in _PLACEHOLDER.finditer(template))
+    return sorted(found - set(knob_names))
+
+
+def _run_on_samples(src_path, samples, timeout):
+    matched = 0
+    details = []
+    for i, (inp, expected) in enumerate(samples, 1):
+        try:
+            p = subprocess.run(['python3', src_path], input=inp, capture_output=True,
+                               text=True, timeout=timeout, errors='replace')
+        except subprocess.TimeoutExpired:
+            details.append(f"S{i}:TIMEOUT")
+            continue
+        if p.returncode == 0 and _norm_lines(expected) == _norm_lines(p.stdout):
+            matched += 1
+            details.append(f"S{i}:OK")
+        else:
+            details.append(f"S{i}:DIFF")
+    return matched, details
+
+
+def tool_function(solution_template_path, knobs_json, problem_statement_path=None,
+                  samples_json=None, timeout=5):
+    if not solution_template_path or not os.path.isfile(solution_template_path):
+        return f"Error: template file not found: {solution_template_path}"
+    try:
+        timeout = max(1, int(timeout or 5))
+    except (TypeError, ValueError):
+        timeout = 5
+    try:
+        knobs = json.loads(knobs_json)
+    except Exception as e:
+        return f"Error: knobs_json is not valid JSON: {e}"
+    if not isinstance(knobs, dict) or not knobs:
+        return "Error: knobs_json must be a non-empty JSON object mapping names to lists of strings."
+    names = list(knobs.keys())
+    for k in names:
+        vals = knobs[k]
+        if not isinstance(vals, list) or not vals or not all(isinstance(v, str) for v in vals):
+            return f"Error: knob '{k}' must map to a non-empty list of strings."
+    try:
+        samples = _load_samples(samples_json, problem_statement_path)
+    except Exception as e:
+        return f"Error: could not load samples: {e}"
+    if not samples:
+        return ("NO SAMPLES PARSED — provide samples_json or a problem_statement_path that contains sample blocks.")
+
+    with open(solution_template_path, 'r', encoding='utf-8', errors='replace') as f:
+        template = f.read()
+    unknown = _unknown_placeholders(template, names)
+    if unknown:
+        return f"Error: template has placeholders without knobs: {unknown}"
+
+    total = 1
+    for k in names:
+        total *= len(knobs[k])
+    combos = list(itertools.islice(itertools.product(*[knobs[k] for k in names]), MAX_COMBINATIONS))
+    note = ''
+    if total > MAX_COMBINATIONS:
+        note = f"(only the first {MAX_COMBINATIONS} of {total} combinations were tried)\n"
+
+    workdir = tempfile.mkdtemp(prefix='variant_search_')
+    results = []
+    first_full = None
+    for idx, combo in enumerate(combos):
+        assignment = dict(zip(names, combo))
+        src = _instantiate(template, assignment)
+        path = os.path.join(workdir, f'variant_{idx}.py')
+        with open(path, 'w', encoding='utf-8') as f:
+            f.write(src)
+        matched, details = _run_on_samples(path, samples, timeout)
+        results.append((matched, idx, assignment, path, details))
+        if matched == len(samples) and first_full is None:
+            first_full = (idx, assignment, path, src)
+
+    n = len(samples)
+    results.sort(key=lambda r: (-r[0], r[1]))
+    lines = [f"Tried {len(combos)} combinations on {n} samples. {note}".rstrip()]
+    lines.append("Top combinations (exact-matched samples / total):")
+    for matched, idx, assignment, path, details in results[:10]:
+        assign_str = ', '.join(f"{k}={assignment[k]!r}" for k in names)
+        lines.append(f"- {matched}/{n} [{' '.join(details)}] {assign_str} -> {path}")
+    if first_full is not None:
+        idx, assignment, path, src = first_full
+        lines.append(f"\nFIRST FULL MATCH: variant {idx} at {path}\nSOURCE:\n{src}")
+        lines.append(f"EXACT MATCH: {n}/{n}")
+    else:
+        best = results[0][0] if results else 0
+        lines.append(f"\nNo combination matched all samples (best {best}/{n}). "
+                     "Extend the knobs (other construction choices) and try again.")
+    return '\n'.join(lines)
