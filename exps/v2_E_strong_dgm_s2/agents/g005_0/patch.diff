+"""Coding agent: keeps a valid checkpoint solution.py and bounds exploration on hard formula problems.
+
+Assumes the surrounding framework provides chat_with_agent(instruction, msg_history, ...)
+returning (text, msg_history) and a tool-using agent that works inside the task workspace.
+"""
+
+import os
+import re
+import subprocess
+import sys
+
+MAX_RETRIES = 3
+SAMPLE_TIMEOUT = 10
+TAIL_CHARS = 3000
+BRUTE_TRUNC = 4000
+
+SAMPLE_RE = re.compile(
+    r"Sample Input\s*(\d*)\s*:?\s*\n(.*?)\n\s*Sample Output\s*\1\s*:?\s*\n(.*?)(?=\n\s*Sample Input|\Z)",
+    re.S | re.I,
+)
+
+METHOD_PROMPT = """You are solving a competitive programming problem in Python.
+Work inside the current directory. Final answer must be in solution.py and read stdin / write stdout.
+
+Steps:
+1. Read the problem statement carefully and extract the samples.
+2. First write tests/brute.py, then immediately copy it into solution.py wrapped in the required I/O format as a checkpoint; verify the samples that fit.
+3. Write a random tester that generates small inputs, runs brute.py and solution.py, and reports mismatches.
+4. Optimize solution.py only after it is correct on small inputs; keep it passing samples at every step.
+
+Hard problems:
+- If the constraints are too large for brute force, state the hypothesis family explicitly (e.g. the answer is a min over a small set of structured routes parameterised by block offsets and entry/exit tiles).
+- Implement the candidate in tests/cand.py and compare against tests/brute.py on all small parameter grids. Report only a mismatch count and the first 3 mismatches, to keep outputs short.
+- Limit exploration to roughly 8 scripts per hypothesis family before committing to a candidate.
+- solution.py may be overwritten only by a version that passes the comparisons.
+- Never leave the checkpoint solution broken.
+
+Keep messages and tool outputs short.
+"""
+
+FALLBACK_PROMPT = """No passing solution.py exists yet. Write solution.py now:
+- Use a brute force (from tests/brute.py if present) with explicit memory and time guards:
+  cap any window or array size (e.g. at 2*10^6 elements) and bound loop iterations.
+- For inputs exceeding the guards, fall back to the best available heuristic/formula instead of raising MemoryError.
+- The program must never crash: wrap the main logic in try/except and print a best-effort answer.
+- Verify it runs on the samples before finishing.
+"""
+
+RETRY_PROMPT = """The previous attempt did not leave a passing solution.py.
+
+PROBLEM STATEMENT:
+{problem}
+
+FILES IN tests/:
+{files}
+
+tests/brute.py (truncated):
+{brute}
+
+PREVIOUS CHAT LOG (tail):
+{tail}
+
+Please:
+(a) write solution.py from tests/brute.py if solution.py is missing or broken (wrapped in stdin/stdout I/O);
+(b) continue the fast-solution search under the budget (about 8 exploratory scripts per hypothesis family), and
+    only overwrite solution.py with a version that passes the comparisons against brute.py.
+Report only short findings.
+"""
+
+
+class AgenticSystem:
+    def __init__(self, workdir=None, chat_fn=None, problem_statement=""):
+        self.workdir = workdir or os.getcwd()
+        self.chat_fn = chat_fn  # chat_fn(instruction, msg_history) -> (text, msg_history)
+        self.problem_statement = problem_statement
+        self.chat_log_path = os.path.join(self.workdir, "chat_log.txt")
+
+    # ---------- helpers ----------
+    def _parse_samples(self):
+        samples = []
+        for m in SAMPLE_RE.finditer(self.problem_statement or ""):
+            samples.append((m.group(2).strip() + "\n", m.group(3).strip()))
+        return samples
+
+    def _solution_has_code(self):
+        path = os.path.join(self.workdir, "solution.py")
+        if not os.path.isfile(path):
+            return False
+        with open(path, "r", encoding="utf-8", errors="replace") as f:
+            text = f.read()
+        lines = [l.strip() for l in text.splitlines()]
+        code = [l for l in lines if l and not l.startswith("#") and l not in ("pass", '"""', "'''")]
+        return len(code) > 0
+
+    def _checkpoint_ok(self):
+        """Run solution.py on sample inputs. Returns True if it passes (or if no samples parse and code exists)."""
+        if not os.path.isfile(os.path.join(self.workdir, "solution.py")):
+            return False
+        samples = self._parse_samples()
+        if not samples:
+            return self._solution_has_code()
+        for inp, expected in samples:
+            try:
+                proc = subprocess.run(
+                    [sys.executable, "solution.py"],
+                    input=inp,
+                    capture_output=True,
+                    text=True,
+                    timeout=SAMPLE_TIMEOUT,
+                    cwd=self.workdir,
+                )
+            except subprocess.TimeoutExpired:
+                return False
+            except Exception:
+                return False
+            if proc.returncode != 0:
+                return False
+            got = " ".join(proc.stdout.split())
+            exp = " ".join(expected.split())
+            if got != exp:
+                return False
+        return True
+
+    def _files_listing(self):
+        d = os.path.join(self.workdir, "tests")
+        if not os.path.isdir(d):
+            return "(none)"
+        names = sorted(os.listdir(d))
+        return "\n".join(names) if names else "(empty)"
+
+    def _read_brute(self):
+        p = os.path.join(self.workdir, "tests", "brute.py")
+        if not os.path.isfile(p):
+            return "(missing)"
+        with open(p, "r", encoding="utf-8", errors="replace") as f:
+            return f.read()[:BRUTE_TRUNC]
+
+    def _log_tail(self):
+        if not os.path.isfile(self.chat_log_path):
+            return "(no log)"
+        with open(self.chat_log_path, "r", encoding="utf-8", errors="replace") as f:
+            return f.read()[-TAIL_CHARS:]
+
+    def _chat(self, instruction, msg_history):
+        if self.chat_fn is None:
+            return "", msg_history
+        text, msg_history = self.chat_fn(instruction, msg_history)
+        try:
+            with open(self.chat_log_path, "a", encoding="utf-8") as f:
+                f.write(str(text) + "\n")
+        except OSError:
+            pass
+        return text, msg_history
+
+    # ---------- main entry ----------
+    def forward(self):
+        msg_history = []
+        _, msg_history = self._chat(METHOD_PROMPT + "\n\nPROBLEM STATEMENT:\n" + self.problem_statement, msg_history)
+        ok = self._checkpoint_ok()
+
+        # bounded retry loop (no while True)
+        for _ in range(MAX_RETRIES):
+            if ok:
+                break
+            prompt = RETRY_PROMPT.format(
+                problem=self.problem_statement,
+                files=self._files_listing(),
+                brute=self._read_brute(),
+                tail=self._log_tail(),
+            )
+            _, msg_history = self._chat(prompt, [])
+            ok = self._checkpoint_ok()
+
+        if not ok:
+            _, msg_history = self._chat(FALLBACK_PROMPT, msg_history)
+            ok = self._checkpoint_ok()
+        return ok
+
+
+if __name__ == "__main__":
+    statement = sys.stdin.read() if not sys.stdin.isatty() else ""
+    agent = AgenticSystem(problem_statement=statement)
+    print("PASS" if agent.forward() else "FAIL")
