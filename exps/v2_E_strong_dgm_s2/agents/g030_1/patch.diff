diff --git a/tools/pattern_fit.py b/tools/pattern_fit.py
new file mode 100644
index 0000000..4d71488
--- /dev/null
+++ b/tools/pattern_fit.py
@@ -0,0 +1,209 @@
+import importlib.util
+import signal
+import threading
+from fractions import Fraction
+
+_OUT_CAP = 3000
+_PER_CALL_TIMEOUT = 10  # seconds allowed for one evaluation of the reference (and for module import)
+
+
+class _EvalTimeout(Exception):
+    pass
+
+
+def tool_info():
+    return {
+        "name": "pattern_fit",
+        "description": """Data-driven pattern finder for a brute-force reference function.\n
+* Imports `func_name` from the Python file `reference_path`, evaluates it for the argument at position `vary_index` of `base_args` ranging over range(start, stop, step), and analyses the first differences d[n] = f(n+1) - f(n) (exact integer/fraction arithmetic).\n
+* Finds the smallest period P (<= max_period) and the smallest pre-period n0 such that d[n+P] == d[n] for all n >= n0 (verified over at least one full period of tail data).\n
+* Reports: pre-period, period, slope per step (sum of d over one period / P), the offset table f(n) - slope*n over one period, and the exceptional prefix values before n0.\n
+* If `other_settings` (a list of alternative base_args lists) is given, it also prints a compact comparison table so you can see how slope and offsets depend on the other parameters.\n
+* Each evaluation has a time limit; timeouts and exceptions of the reference are reported instead of crashing. Output is capped at about 3000 characters.\n
+* Use it on your brute force to discover linear or periodic structure in each parameter, then build a closed form and verify it with stress_test.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "reference_path": {"type": "string", "description": "Path to the Python file containing the brute-force reference."},
+                "func_name": {"type": "string", "description": "Name of the function to call in the reference file."},
+                "base_args": {"type": "array", "items": {"type": "integer"}, "description": "Base positional integer arguments for the function. The entry at vary_index is replaced by the varying values."},
+                "vary_index": {"type": "integer", "description": "0-based index in base_args of the argument to vary."},
+                "start": {"type": "integer", "description": "First value of the varying argument."},
+                "stop": {"type": "integer", "description": "Exclusive upper bound of the varying argument."},
+                "step": {"type": "integer", "description": "Step between consecutive values of the varying argument (default 1)."},
+                "max_period": {"type": "integer", "description": "Largest period to search for (default 64)."},
+                "other_settings": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}, "description": "Optional list of alternative base_args lists (same length as base_args) to compare in a summary table."}
+            },
+            "required": ["reference_path", "func_name", "base_args", "vary_index", "start", "stop"]
+        }
+    }
+
+
+def _load(reference_path, func_name):
+    spec = importlib.util.spec_from_file_location("_pattern_fit_ref", reference_path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load {reference_path}")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    if not hasattr(mod, func_name):
+        raise AttributeError(f"function '{func_name}' not found in reference file")
+    return getattr(mod, func_name)
+
+
+class _Alarm:
+    """Context manager raising _EvalTimeout after _PER_CALL_TIMEOUT seconds (main thread only)."""
+
+    def __enter__(self):
+        self.active = False
+        if threading.current_thread() is threading.main_thread() and hasattr(signal, 'setitimer'):
+            try:
+                self.old = signal.signal(signal.SIGALRM, self._handler)
+                signal.setitimer(signal.ITIMER_REAL, _PER_CALL_TIMEOUT)
+                self.active = True
+            except (ValueError, OSError):
+                self.active = False
+        return self
+
+    @staticmethod
+    def _handler(signum, frame):
+        raise _EvalTimeout()
+
+    def __exit__(self, exc_type, exc, tb):
+        if self.active:
+            signal.setitimer(signal.ITIMER_REAL, 0)
+            signal.signal(signal.SIGALRM, self.old)
+        return False
+
+
+def _fmt(x):
+    if isinstance(x, Fraction) and x.denominator == 1:
+        return str(x.numerator)
+    return str(x)
+
+
+def _to_exact(v):
+    if isinstance(v, bool):
+        return Fraction(int(v))
+    if isinstance(v, int):
+        return Fraction(v)
+    if isinstance(v, Fraction):
+        return v
+    if isinstance(v, float) and v.is_integer():
+        return Fraction(int(v))
+    raise TypeError(f"non-integer result {v!r} ({type(v).__name__})")
+
+
+def _analyse(func, base_args, vary_index, start, stop, step, max_period):
+    """Return (dict_result, error_string). dict_result has keys used for reporting."""
+    xs = list(range(start, stop, step))
+    if len(xs) < 4:
+        return None, "need at least 4 values of the varying argument"
+    vals = []
+    for x in xs:
+        args = list(base_args)
+        args[vary_index] = x
+        try:
+            with _Alarm():
+                v = func(*args)
+            vals.append(_to_exact(v))
+        except _EvalTimeout:
+            return None, f"reference timed out (>{_PER_CALL_TIMEOUT}s) at {x}; use a smaller range"
+        except Exception as e:  # reference raised
+            return None, f"reference raised {type(e).__name__}: {e} at {x}"
+    d = [vals[i + 1] - vals[i] for i in range(len(vals) - 1)]
+    m = len(d)
+    found = None
+    for P in range(1, max(1, min(max_period, m // 2)) + 1):
+        # last index k (0 <= k < m-P) where d[k] != d[k+P]; pre-period is k+1
+        last_bad = -1
+        for k in range(m - P):
+            if d[k] != d[k + P]:
+                last_bad = k
+        n0 = last_bad + 1
+        tail = (m - P) - n0  # number of verified comparisons after n0
+        # require a long verified tail (not just one period) to avoid spurious short periods
+        if tail >= max(2 * P, m // 2):
+            found = (P, n0)
+            break
+    if found is None:
+        return None, (f"no period <= {max_period} verified with {m} differences; "
+                      f"widen the range or raise max_period")
+    P, n0 = found
+    slope = sum(d[n0:n0 + P], Fraction(0)) / P
+    # offsets over one period starting at n0 (index i of f values)
+    offs = []
+    for i in range(n0, n0 + P + 1):
+        offs.append((xs[i], vals[i] - slope * i))
+    prefix = []
+    for i in range(0, min(n0, len(vals))):
+        prefix.append((xs[i], vals[i] - slope * i))
+    return {
+        "P": P, "n0": n0, "slope": slope, "offs": offs, "prefix": prefix,
+        "xs_index_n0": xs[n0] if n0 < len(xs) else None,
+    }, None
+
+
+def _fmt_offs(offs, limit):
+    parts = [f"n={n}:{_fmt(o)}" for n, o in offs[:limit]]
+    if len(offs) > limit:
+        parts.append("...")
+    return ", ".join(parts)
+
+
+def tool_function(reference_path, func_name, base_args, vary_index, start, stop, step=1, max_period=64, other_settings=None):
+    try:
+        step = int(step or 1)
+        if step == 0:
+            return "Error: step must be non-zero"
+        start, stop = int(start), int(stop)
+        vary_index = int(vary_index)
+        max_period = int(max_period or 64)
+        base_args = [int(a) for a in base_args]
+        if not (0 <= vary_index < len(base_args)):
+            return f"Error: vary_index {vary_index} out of range for base_args of length {len(base_args)}"
+        try:
+            with _Alarm():
+                func = _load(reference_path, func_name)
+        except _EvalTimeout:
+            return f"Error: loading reference timed out (>{_PER_CALL_TIMEOUT}s)"
+        except Exception as e:
+            return f"Error loading reference: {type(e).__name__}: {e}"
+
+        settings = [base_args]
+        if other_settings:
+            for s in other_settings:
+                s = [int(a) for a in s]
+                if len(s) != len(base_args):
+                    return f"Error: other_settings entry {s} has length {len(s)}, expected {len(base_args)}"
+                settings.append(s)
+
+        out = []
+        res, err = _analyse(func, base_args, vary_index, start, stop, step, max_period)
+        if err:
+            return f"Error: {err}"
+        xs_desc = f"n in range({start}, {stop}, {step}); index i counts steps from n={start}"
+        out.append(f"Reference: {func_name} in {reference_path}; base_args={base_args}, vary_index={vary_index}")
+        out.append(f"Range: {xs_desc}")
+        out.append(f"pre-period n0 (index) = {res['n0']} (n = {res['xs_index_n0']}), period P = {res['P']}")
+        out.append(f"slope per index step = {_fmt(res['slope'])}  (sum of one period of differences / P)")
+        out.append(f"offsets f(n) - slope*i over one period: {_fmt_offs(res['offs'], 24)}")
+        if res['prefix']:
+            out.append(f"exceptions before n0 (f - slope*i): {_fmt_offs(res['prefix'], 16)}")
+        else:
+            out.append("exceptions before n0: none")
+
+        if other_settings:
+            out.append("")
+            out.append("Settings comparison (base_args -> pre-period, period, slope, first offsets):")
+            for s in settings:
+                r, e = _analyse(func, s, vary_index, start, stop, step, max_period)
+                if e:
+                    out.append(f"  {s}: ERROR {e}")
+                else:
+                    out.append(f"  {s}: n0={r['n0']} P={r['P']} slope={_fmt(r['slope'])} offs[{_fmt_offs(r['offs'], 6)}]")
+        text = "\n".join(out)
+        if len(text) > _OUT_CAP:
+            text = text[:_OUT_CAP - 40] + "\n... <output truncated>"
+        return text
+    except Exception as e:
+        return f"Error: {type(e).__name__}: {e}"
