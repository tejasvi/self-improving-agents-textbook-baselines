+    def _count_tool_calls(items):
+        """Number of tool invocations/results in a list of message-history items (Claude, OpenAI or manual format)."""
+        tool_types = ('tool_use', 'tool_result', 'function_call', 'function_call_output')
+        n = 0
+        for item in items:
+            item_type = item.get('type') if isinstance(item, dict) else getattr(item, 'type', None)
+            if item_type in tool_types:
+                n += 1
+                continue
+            content = item.get('content') if isinstance(item, dict) else getattr(item, 'content', None)
+            if isinstance(content, str):
+                if 'Tool Used:' in content:
+                    n += 1
+            elif isinstance(content, list):
+                for block in content:
+                    b_type = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+                    if b_type in tool_types:
+                        n += 1
+        return n
+
