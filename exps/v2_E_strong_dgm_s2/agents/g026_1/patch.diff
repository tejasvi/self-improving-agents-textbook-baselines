+import os
+import stat
+import sys
+
+
+def is_regular_file(stream):
+    try:
+        return stat.S_ISREG(os.fstat(stream.fileno()).st_mode)
+    except (OSError, ValueError):
+        return False
+
+
+def main():
+    first = sys.stdin.readline()
+    while first and not first.strip():
+        first = sys.stdin.readline()
+    n, l, r = map(int, first.split()[:3])
+
+    if is_regular_file(sys.stdin):
+        # Static stdin: the secret array is already in the file. Read everything up front.
+        tokens = sys.stdin.read().split()
+        if len(tokens) > n:
+            # Extra tokens (e.g. a spare reply line) may follow; they are ignored.
+            arr = list(map(int, tokens[:n]))
+            print(sum(arr[l - 1:r]))
+            return
+        # No extra tokens: fall through to the protocol below.
+
+    # Interactive protocol: ask the judge for the sum over [l, r], then print the final answer.
+    print(f"? {l} {r}", flush=True)
+    reply = sys.stdin.readline().strip()
+    print(f"! {reply}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
