+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    if len(data) < 3:
+        return
+    n, l, r = int(data[0]), int(data[1]), int(data[2])
+    if len(data) >= 3 + n:
+        # Static mode: secret data present on stdin; answer locally, print bare answer.
+        arr = [int(x) for x in data[3:3 + n]]
+        prefix = [0] * (n + 1)
+        for i in range(n):
+            prefix[i + 1] = prefix[i] + arr[i]
+        print(prefix[r] - prefix[l - 1])
+        return
+    # Fallback: no secret data on stdin, run the interactive protocol line by line.
+    # Replies are read from the remaining tokens (none here), so this only queries once per range.
+    print(f"? {l} {r}", flush=True)
+    reply = sys.stdin.readline().strip()
+    print(f"! {reply}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
