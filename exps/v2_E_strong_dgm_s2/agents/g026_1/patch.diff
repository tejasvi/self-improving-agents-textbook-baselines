+import sys
+
+
+def main():
+    data = sys.stdin.read().split()
+    n, l, r = int(data[0]), int(data[1]), int(data[2])
+    rest = data[3:]
+    if rest:
+        # Static mode: secret data is on stdin (array values, maybe a spare token).
+        # Answer locally and print only the bare value.
+        arr = [int(x) for x in rest[:n]]
+        total = sum(arr[l - 1:r])
+        sys.stdout.write(str(total) + "\n")
+        return
+    # No tokens after the parameters: true interactive session.
+    # Query the range and answer with the protocol line "! S".
+    sys.stdout.write(f"? {l} {r}\n")
+    sys.stdout.flush()
+    total = 0
+    reply = sys.stdin.readline()
+    if reply:
+        try:
+            total = int(reply.split()[0])
+        except (ValueError, IndexError):
+            total = 0
+    sys.stdout.write(f"! {total}\n")
+    sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
