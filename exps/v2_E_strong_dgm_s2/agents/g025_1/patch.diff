+        if after == before_text:
+            return False
+        return self._solution_edited()
+
+    @staticmethod
+    def _count_tool_calls(msg_history):
+        """Number of tool invocations recorded in a message history (best effort, for logging)."""
+        n = 0
+        for msg in msg_history or []:
+            if not isinstance(msg, dict):
+                continue
+            content = msg.get("content")
+            if isinstance(content, list):
+                for c in content:
+                    if isinstance(c, dict) and c.get("type") in ("tool_use", "tool_call", "function_call"):
+                        n += 1
+            if isinstance(msg.get("tool_calls"), list):
+                n += len(msg["tool_calls"])
+        return n
+
+    def _build_prompt(self, task, interactive, short, best_text, best_score, prev_score, prev_report, real_attempts):
+        """Assemble the instruction for one agent call."""
+        if short:
+            base = f"{task}\n\n{SHORT_PROMPT}"
+        else:
+            blocks = [CORE_PROMPT]
+            if interactive:
+                blocks.append(INTERACTIVE_BLOCK)
+            if "TLE" in (prev_report or ""):
+                blocks.append(SWEEP_BLOCK)
+            base = f"{FIRST_LINE}{task}\n\n" + "\n".join(blocks)
+        if best_text is None and real_attempts == 0:
