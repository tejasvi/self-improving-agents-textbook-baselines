@@ -0,0 +1,50 @@
+"""Targeted patch of the `method` workflow prompt in coding_agent.py.
+
+Usage: python3 solution.py [path/to/coding_agent.py]
+Replaces the sample-check step (5), the multi-answer step (5b) and the final
+review step (10) with stricter versions. Everything else is left unchanged.
+"""
+import sys
+
+OLD_5 = """5. Save each sample's input and expected output from the statement to files (e.g. tests/samples/sample1.in and tests/samples/sample1.out), and write tests/run_samples.sh that checks every sample with an exact comparison, e.g. `diff <(python3 solution.py < tests/samples/sample1.in) tests/samples/sample1.out`. Run it. Any difference from the expected output is a failure to investigate, even if the answer is valid under your own checker. Then run tests/stress.py and fix every mismatch.
+5b."""
+
+NEW_5 = """5. Save EACH sample's input and expected output from the statement to files (e.g. tests/samples/sample1.in and tests/samples/sample1.out), and write tests/run_samples.sh that, for every sample, runs `diff <(python3 solution.py < tests/samples/sample1.in) tests/samples/sample1.out` and prints PASS or FAIL per sample. Run it. Any difference from the expected output is a failure to investigate, even if the answer is valid under your own checker. Then run tests/stress.py and fix every mismatch.
+5b."""
+
+OLD_5B_START = "5b. If the statement says any valid answer is accepted"
+OLD_5B_END = "keep the valid answer.\n6."
+NEW_5B = """5b. If the statement says any valid answer is accepted (or gives several acceptable outputs), and any sample output is not matched exactly, do NOT conclude that it is fine. The hidden grader may still compare against the reference output exactly. Try to infer the reference's canonical construction from the sample outputs: write a small script (e.g. tests/variants.py) that tries several deterministic variants of the construction (basis or iteration order, bit assignment direction high-to-low vs low-to-high, min vs max choice of values, pivot or free-variable choice, tie-breaking order) and reports which variants reproduce ALL sample outputs exactly. If a variant matches all samples, adopt it in solution.py, then confirm it still passes the validator-based checks in tests/stress.py and re-run tests/run_samples.sh. If no variant matches within a reasonable effort, say so explicitly in your final message and keep the valid answer.
+6."""
+
+OLD_10 = "10. Final review: state explicitly, for each sample, whether solution.py's output matches the expected output exactly (MATCH or MISMATCH), and report the result of tests/stress.py."
+NEW_10 = "10. Final review: rerun tests/run_samples.sh and tests/stress.py. State explicitly, for EACH sample by name, whether solution.py's output matches the expected output exactly (MATCH or MISMATCH), and report the result of tests/stress.py. Any MISMATCH must be investigated (see step 5b) before you finish; do not dismiss it as allowed because the answer is valid."
+
+
+def patch(path):
+    with open(path, encoding="utf-8") as f:
+        src = f.read()
+    # Step 5 (exact, unique).
+    if src.count(OLD_5) != 1:
+        return "step 5 not found exactly once"
+    src = src.replace(OLD_5, NEW_5)
+    # Step 5b: replace from its start through "6." boundary.
+    s = src.find(OLD_5B_START)
+    if s == -1:
+        return "step 5b start not found"
+    e = src.find(OLD_5B_END, s)
+    if e == -1:
+        return "step 5b end not found"
+    src = src[:s] + NEW_5B + src[e + len(OLD_5B_END):]
+    # Step 10.
+    if src.count(OLD_10) != 1:
+        return "step 10 not found exactly once"
+    src = src.replace(OLD_10, NEW_10)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(src)
+    return "patched " + path
+
+
+if __name__ == "__main__":
+    target = sys.argv[1] if len(sys.argv) > 1 else "coding_agent.py"
+    print(patch(target))
