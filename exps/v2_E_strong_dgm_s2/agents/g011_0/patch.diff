+    def _solution_edited(self):
+        """
+        Return True if the repository contains a real (non-placeholder) change to the
+        primary deliverable solution.py. If solution.py does not exist at the base commit,
+        fall back to checking that any non-tests/ file received non-trivial added lines.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        # Split diff into per-file blocks: {path: [added lines]}
+        blocks = {}
+        current = None
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(\S+) b/(\S+)', line)
+            if m:
+                current = m.group(2)
+                blocks.setdefault(current, [])
+                continue
+            if current is None:
+                continue
+            if line.startswith('+') and not line.startswith('+++'):
+                blocks[current].append(line[1:])
+
+        def non_trivial(lines):
+            for l in lines:
+                stripped = l.strip()
+                if stripped and not stripped.startswith('#'):
+                    return True
+            return False
+
+        base_has_solution = subprocess.run(
+            ["git", "-C", self.git_tempdir, "cat-file", "-e", f"{self.base_commit}:solution.py"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        ).returncode == 0
+        if base_has_solution or 'solution.py' in blocks:
+            return non_trivial(blocks.get('solution.py', []))
+
+        for path, lines in blocks.items():
+            if path.startswith('tests/'):
+                continue
+            if non_trivial(lines):
+                return True
+        return False
+
