diff --git a/tools/interactive_judge.py b/tools/interactive_judge.py
new file mode 100644
index 0000000..3e03602
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,205 @@
+import os
+import queue
+import random
+import subprocess
+import sys
+import tempfile
+import threading
+import importlib.util
+
+_MAX_TRANSCRIPT = 3000
+_DEFAULT_LINE_TIMEOUT = 10
+
+
+def tool_info():
+    return {
+        "name": "interactive_judge",
+        "description": """Run solution.py against a user-written interactor to test an INTERACTIVE problem.
+* The interactor is a Python file that exposes either `cases()` returning a list of initial inputs (each a string) or `gen(rng, size)` returning one initial input string, plus `respond(state, query_line)`.
+* `respond(state, query_line)` must return ('reply', text) to send text back to the solution, or ('final', verdict_bool, info) to end the case. `state` is a dict you may freely mutate; it is created per case and starts as {'initial': <initial input text>}.
+* The solution is started as `python3 solution.py` with pipes; the initial input is sent first, then every line the solution prints is treated as a query.
+* Enforces a per-line timeout (a hang is reported explicitly), a max_queries limit, and reports protocol violations (solution exits early or prints nothing).
+* Returns the first failing transcript, or PASS with the number of cases run.
+* Also write a static transcript test yourself if the statement allows it (all judge data pre-supplied on stdin).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution.py file to test."},
+                "interactor_path": {"type": "string", "description": "Path to the Python interactor file (exposes cases() or gen(rng,size), and respond(state, query_line))."},
+                "num_cases": {"type": "integer", "description": "Number of cases to run (default 50)."},
+                "timeout": {"type": "integer", "description": "Per-line timeout in seconds (default 10)."},
+                "max_queries": {"type": "integer", "description": "Maximum number of queries per case; exceeding it is a failure. Default: no limit."}
+            },
+            "required": ["solution_path", "interactor_path"]
+        }
+    }
+
+
+def _clip(s):
+    s = str(s)
+    if len(s) <= _MAX_TRANSCRIPT:
+        return s
+    return s[:_MAX_TRANSCRIPT // 2] + "\n...<clipped>...\n" + s[-_MAX_TRANSCRIPT // 2:]
+
+
+def _load_interactor(path):
+    d = os.path.dirname(os.path.abspath(path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec = importlib.util.spec_from_file_location("_interactor_mod", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _initial_inputs(mod, num_cases):
+    """Return a list of `num_cases` initial input strings."""
+    if hasattr(mod, "cases"):
+        lst = list(mod.cases())
+        return [str(x) for x in lst[:num_cases]]
+    if hasattr(mod, "gen"):
+        rng = random.Random(12345)
+        out = []
+        for i in range(num_cases):
+            out.append(str(mod.gen(rng, i % 20 + 1)))
+        return out
+    raise AttributeError("interactor must define cases() or gen(rng, size)")
+
+
+def _run_case(solution_path, initial, respond, state_mod, line_timeout, max_queries):
+    """Run one interactive case. Returns (ok: bool, message: str, transcript: str, queries: int)."""
+    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PYTHONUNBUFFERED="1")
+    proc = subprocess.Popen(
+        [sys.executable, solution_path],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        text=True, bufsize=1, env=env,
+    )
+    lines_q = queue.Queue()
+
+    def reader(pipe, q):
+        try:
+            for ln in pipe:
+                q.put(ln)
+        finally:
+            q.put(None)  # EOF sentinel
+
+    err_chunks = []
+
+    def err_reader(pipe):
+        try:
+            err_chunks.append(pipe.read())
+        except Exception:
+            pass
+
+    t_out = threading.Thread(target=reader, args=(proc.stdout, lines_q), daemon=True)
+    t_err = threading.Thread(target=err_reader, args=(proc.stderr,), daemon=True)
+    t_out.start()
+    t_err.start()
+
+    transcript = []
+    state = {"initial": initial}
+    queries = 0
+
+    def kill():
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=2)
+        except Exception:
+            pass
+
+    def stderr_tail():
+        t_err.join(timeout=1)
+        s = "".join(err_chunks)
+        return _clip(s[-1000:]) if s else ""
+
+    def fail(msg):
+        kill()
+        tr = _clip("".join(transcript))
+        return False, msg + ("\nstderr:\n" + stderr_tail() if stderr_tail() else ""), tr, queries
+
+    try:
+        proc.stdin.write(initial if initial.endswith("\n") else initial + "\n")
+        proc.stdin.flush()
+    except (BrokenPipeError, OSError):
+        return fail("Protocol violation: solution exited before reading the initial input.")
+
+    # Bounded loop: each iteration consumes one line of solution output or ends the case.
+    max_iters = (max_queries if max_queries else 10000) + 2
+    for _ in range(max_iters * 1000):
+        try:
+            ln = lines_q.get(timeout=line_timeout)
+        except queue.Empty:
+            return fail(f"HANG: no output line within {line_timeout}s (solution is waiting or looping).")
+        if ln is None:
+            code = proc.poll()
+            if code is None:
+                try:
+                    code = proc.wait(timeout=2)
+                except Exception:
+                    code = None
+            return fail(f"Protocol violation: solution ended (exit code {code}) without a final answer or query when expected.")
+        transcript.append("> " + ln)
+        queries += 1
+        if max_queries is not None and queries > max_queries:
+            return fail(f"Query limit exceeded: more than {max_queries} queries in one case.")
+        try:
+            res = respond(state, ln.rstrip("\n"))
+        except Exception as e:
+            return fail(f"Interactor respond() raised: {type(e).__name__}: {e}")
+        if not isinstance(res, tuple) or len(res) == 0:
+            return fail("Interactor respond() must return ('reply', text) or ('final', verdict, info).")
+        kind = res[0]
+        if kind == "reply":
+            text = str(res[1])
+            transcript.append("< " + text + ("" if text.endswith("\n") else "\n"))
+            try:
+                proc.stdin.write(text if text.endswith("\n") else text + "\n")
+                proc.stdin.flush()
+            except (BrokenPipeError, OSError):
+                return fail("Protocol violation: solution closed stdin early (it probably exited after an invalid reply).")
+        elif kind == "final":
+            verdict = bool(res[1]) if len(res) > 1 else False
+            info = res[2] if len(res) > 2 else ""
+            kill()
+            if verdict:
+                return True, "", _clip("".join(transcript)), queries
+            return False, f"Wrong answer: {info}", _clip("".join(transcript)), queries
+        else:
+            return fail(f"Interactor respond() returned unknown kind {kind!r}.")
+    return fail("Query loop bound reached (solution sends too many lines).")
+
+
+def tool_function(solution_path, interactor_path, num_cases=50, timeout=10, max_queries=None):
+    try:
+        num_cases = int(num_cases) if num_cases is not None else 50
+        line_timeout = float(timeout) if timeout is not None else _DEFAULT_LINE_TIMEOUT
+        mq = int(max_queries) if max_queries is not None else None
+    except (TypeError, ValueError) as e:
+        return f"Invalid arguments: {e}"
+    if not os.path.exists(solution_path):
+        return f"solution file not found: {solution_path}"
+    try:
+        mod = _load_interactor(interactor_path)
+    except BaseException as e:
+        return f"Failed to load interactor: {type(e).__name__}: {e}"
+    if not hasattr(mod, "respond"):
+        return "interactor must define respond(state, query_line)"
+    try:
+        inits = _initial_inputs(mod, max(1, num_cases))
+    except BaseException as e:
+        return f"Failed to create initial inputs: {type(e).__name__}: {e}"
+    if not inits:
+        return "interactor produced no cases"
+
+    total_queries = 0
+    for idx, init in enumerate(inits):
+        ok, msg, tr, q = _run_case(solution_path, init, mod.respond, None, line_timeout, mq)
+        total_queries += q
+        if not ok:
+            return (f"FAIL on case {idx + 1}/{len(inits)}: {msg}\n"
+                    f"Initial input:\n{_clip(init)}\n"
+                    f"Transcript (> solution output, < judge reply):\n{tr}")
+    return f"PASS: {len(inits)} cases passed ({total_queries} queries total)."
