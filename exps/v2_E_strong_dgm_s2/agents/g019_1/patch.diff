diff --git a/tools/param_sweep.py b/tools/param_sweep.py
new file mode 100644
index 0000000..1faba03
--- /dev/null
+++ b/tools/param_sweep.py
@@ -0,0 +1,355 @@
+import itertools
+import json
+import math
+import os
+import subprocess
+import sys
+
+MAX_POINTS = 200000
+OUT_LIMIT = 6000
+MODES = ("table", "diff", "check")
+
+
+def tool_info():
+    return {
+        "name": "param_sweep",
+        "description": (
+            "Experiment tool for turning a slow brute force into a fast formula. Runs a brute-force "
+            "function f(*params) (a Python file defining def f(...), or a stdin/stdout program) over an "
+            "integer grid of small parameter ranges in a sandboxed subprocess with a time limit. "
+            "Modes: 'table' prints a compact 2D grid for two chosen parameters (others fixed at their lower bound); "
+            "'diff' prints first/second differences and detects linearity and periodicity per parameter; "
+            "'check' evaluates candidate Python expressions (over parameter names; helpers ceil_div, floor_div, "
+            "isqrt, gcd, lcm, min, max, abs) against f on the whole grid and reports mismatches and the first counterexamples. "
+            "Output is clipped to about 6000 characters, so keep the grids small."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the Python brute-force file. Either defines def f(*args) returning the answer, or is a stdin/stdout program.",
+                },
+                "params": {
+                    "type": "string",
+                    "description": "JSON object mapping parameter names to inclusive [lo, hi] integer ranges, e.g. {\"n\": [1, 12], \"m\": [1, 12]}. Parameter order is the order of keys; f is called with arguments in this order.",
+                },
+                "candidates": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Only for mode 'check': Python expressions over the parameter names, e.g. \"n*m - (n+m)//2\". Each is compared to f on every grid point.",
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["table", "diff", "check"],
+                    "description": "One of 'table', 'diff', 'check'.",
+                },
+                "table_vars": {
+                    "type": "string",
+                    "description": "Only for mode 'table': two comma-separated parameter names for rows and columns, e.g. \"n,m\". Default: first two parameters.",
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Total time limit in seconds for evaluating f over the whole grid (default 10, max 120).",
+                },
+            },
+            "required": ["brute_path", "params"],
+        },
+    }
+
+
+def _parse_params(params):
+    if isinstance(params, str):
+        params = json.loads(params)
+    if not isinstance(params, dict) or not params:
+        raise ValueError("params must be a non-empty JSON object mapping names to [lo, hi]")
+    ranges = []
+    for name, rng in params.items():
+        if isinstance(rng, int):
+            lo = hi = rng
+        else:
+            lo, hi = int(rng[0]), int(rng[1])
+        if hi < lo:
+            raise ValueError(f"empty range for {name}: [{lo}, {hi}]")
+        ranges.append((str(name), lo, hi))
+    return ranges
+
+
+def _grid(ranges):
+    total = 1
+    for _, lo, hi in ranges:
+        total *= hi - lo + 1
+    if total > MAX_POINTS:
+        raise ValueError(f"grid has {total} points, limit is {MAX_POINTS}; shrink the ranges")
+    return list(itertools.product(*[range(lo, hi + 1) for _, lo, hi in ranges]))
+
+
+def _norm(v):
+    if v is None or isinstance(v, (bool, int, float, str)):
+        return v
+    if isinstance(v, (list, tuple)):
+        return [_norm(x) for x in v]
+    return str(v)
+
+
+def _worker_main():
+    import io
+    import re
+    import signal
+
+    req = json.loads(sys.stdin.read())
+    path = req["brute_path"]
+    points = [tuple(p) for p in req["points"]]
+    timeout = int(req["timeout"])
+    results = []
+    error = None
+    real_stdout = sys.stdout
+
+    def _alarm(signum, frame):
+        raise TimeoutError(f"time limit {timeout}s exceeded")
+
+    signal.signal(signal.SIGALRM, _alarm)
+    signal.alarm(timeout)
+    try:
+        with open(path) as fh:
+            src = fh.read()
+        if re.search(r"^def f\s*\(", src, re.M):
+            sys.stdout = io.StringIO()
+            sys.stdin = io.StringIO("")
+            env = {"__name__": "brute_mod", "__file__": path}
+            exec(compile(src, path, "exec"), env)
+            f = env["f"]
+            for pt in points:
+                results.append(_norm(f(*pt)))
+        else:
+            import subprocess as sp
+            for pt in points:
+                r = sp.run([sys.executable, path], input=" ".join(map(str, pt)) + "\n",
+                           capture_output=True, text=True, timeout=timeout)
+                if r.returncode != 0:
+                    tail = (r.stderr or "").strip().splitlines()[-1:] or ["nonzero exit"]
+                    raise RuntimeError(f"exit {r.returncode}: {tail[0]}")
+                out = r.stdout.strip()
+                try:
+                    results.append(int(out))
+                except ValueError:
+                    try:
+                        results.append(float(out))
+                    except ValueError:
+                        results.append(out)
+    except Exception as e:
+        idx = len(results)
+        where = f"at point {points[idx]}" if idx < len(points) else "after grid"
+        error = f"{where}: {type(e).__name__}: {e}"
+    finally:
+        signal.alarm(0)
+        sys.stdout = real_stdout
+    print(json.dumps({"results": results, "error": error}))
+
+
+def _run_points(brute_path, points, timeout):
+    req = json.dumps({"brute_path": os.path.abspath(brute_path),
+                      "points": [list(p) for p in points], "timeout": timeout})
+    try:
+        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "--worker"],
+                              input=req, capture_output=True, text=True, timeout=timeout + 10)
+    except subprocess.TimeoutExpired:
+        return [], "sandbox timeout"
+    lines = proc.stdout.strip().splitlines()
+    if not lines:
+        return [], "worker produced no output: " + (proc.stderr or "")[-300:]
+    try:
+        data = json.loads(lines[-1])
+    except ValueError:
+        return [], "bad worker output: " + lines[-1][:300]
+    return data["results"], data["error"]
+
+
+def _fmt(v):
+    if isinstance(v, float):
+        return f"{v:.6g}"
+    return str(v)
+
+
+def _is_num(v):
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _period(seq):
+    n = len(seq)
+    for p in range(1, n // 2 + 1):
+        if all(seq[k] == seq[k + p] for k in range(n - p)):
+            return p
+    return None
+
+
+def _mode_table(names, ranges, values, table_vars):
+    if table_vars:
+        tv = [x.strip() for x in table_vars.split(",") if x.strip()]
+        if len(tv) not in (1, 2) or any(x not in names for x in tv):
+            return f"Error: table_vars must be 1 or 2 names from {names}"
+    else:
+        tv = names[:2]
+    info = {n: (lo, hi) for n, lo, hi in ranges}
+    base = {n: lo for n, lo, _ in ranges}
+    fixed = [n for n in names if n not in tv]
+    lines = []
+    if fixed:
+        lines.append("fixed: " + ", ".join(f"{n}={base[n]}" for n in fixed))
+    if len(tv) == 1:
+        r = tv[0]
+        lines.append(f"row {r} -> value")
+        for x in range(info[r][0], min(info[r][1], info[r][0] + 59) + 1):
+            a = dict(base)
+            a[r] = x
+            lines.append(f"{r}={x}: {_fmt(values.get(tuple(a[n] for n in names)))}")
+        return "\n".join(lines)
+    rn, cn = tv
+    rlo, rhi = info[rn]
+    clo, chi = info[cn]
+    rhi = min(rhi, rlo + 29)
+    chi = min(chi, clo + 29)
+    cells = {}
+    for r in range(rlo, rhi + 1):
+        for c in range(clo, chi + 1):
+            a = dict(base)
+            a[rn], a[cn] = r, c
+            cells[(r, c)] = _fmt(values.get(tuple(a[n] for n in names)))
+    w = max([len(v) for v in cells.values()] + [len(str(x)) for x in range(clo, chi + 1)] + [1])
+    lines.append(f"rows={rn} [{rlo}..{rhi}], cols={cn} [{clo}..{chi}]")
+    lines.append(" " * (len(rn) + 4) + " ".join(str(c).rjust(w) for c in range(clo, chi + 1)))
+    for r in range(rlo, rhi + 1):
+        lines.append(f"{rn}={r}".ljust(len(rn) + 4) + " ".join(cells[(r, c)].rjust(w) for c in range(clo, chi + 1)))
+    return "\n".join(lines)
+
+
+def _mode_diff(names, ranges, values):
+    lines = []
+    base = [lo for _, lo, _ in ranges]
+    for i, (n, lo, hi) in enumerate(ranges):
+        seq = []
+        for x in range(lo, hi + 1):
+            key = list(base)
+            key[i] = x
+            seq.append(values.get(tuple(key)))
+        lines.append(f"[{n}] len={len(seq)} values: " + ", ".join(_fmt(v) for v in seq[:12]))
+        if len(seq) >= 2 and all(_is_num(v) for v in seq):
+            d1 = [seq[k + 1] - seq[k] for k in range(len(seq) - 1)]
+            lines.append("  d1: " + ", ".join(_fmt(v) for v in d1[:12]))
+            if len(d1) >= 2:
+                d2 = [d1[k + 1] - d1[k] for k in range(len(d1) - 1)]
+                lines.append("  d2: " + ", ".join(_fmt(v) for v in d2[:12]))
+                if all(v == 0 for v in d2):
+                    lines.append(f"  linear: yes, slope {_fmt(d1[0])}")
+            p = _period(seq)
+            if len(set(seq)) == 1:
+                lines.append("  constant")
+            elif p is not None:
+                lines.append(f"  periodic: period {p} (values)")
+            else:
+                pd = _period(d1) if len(d1) >= 2 else None
+                if pd is not None:
+                    lines.append(f"  periodic: period {pd} (first differences)")
+                else:
+                    lines.append("  periodic: no (within range)")
+    return "\n".join(lines)
+
+
+_SAFE_BUILTINS = {
+    "min": min, "max": max, "abs": abs, "sum": sum, "len": len, "range": range,
+    "int": int, "float": float, "bool": bool, "divmod": divmod, "pow": pow,
+    "round": round, "all": all, "any": any, "sorted": sorted,
+    "ceil_div": lambda a, b: -(-a // b),
+    "floor_div": lambda a, b: a // b,
+    "isqrt": math.isqrt, "gcd": math.gcd,
+    "lcm": lambda a, b: abs(a * b) // math.gcd(a, b) if a and b else 0,
+    "math": math,
+}
+
+
+def _close(a, b):
+    if a == b:
+        return True
+    if _is_num(a) and _is_num(b):
+        return math.isclose(a, b, rel_tol=1e-9, abs_tol=1e-9)
+    return False
+
+
+def _mode_check(names, points, values, candidates):
+    if not candidates:
+        return "Error: check mode needs candidates"
+    evaluated = [p for p in points if p in values and values[p] is not None]
+    lines = [f"checked {len(evaluated)} grid points"]
+    for expr in candidates:
+        try:
+            code = compile(expr, "<candidate>", "eval")
+        except SyntaxError as e:
+            lines.append(f"candidate {expr!r}: SYNTAX ERROR {e.msg}")
+            continue
+        mism = 0
+        examples = []
+        for p in evaluated:
+            env = dict(zip(names, p))
+            exp = values[p]
+            try:
+                got = eval(code, {"__builtins__": _SAFE_BUILTINS}, env)
+            except Exception as e:
+                got = f"ERR {type(e).__name__}: {e}"
+            if isinstance(got, str) or not _close(got, exp):
+                mism += 1
+                if len(examples) < 5:
+                    examples.append(f"  at {dict(env)}: expected {_fmt(exp)}, got {_fmt(got)}")
+        status = "OK" if mism == 0 else f"{mism} mismatches"
+        lines.append(f"candidate {expr!r}: {status}")
+        lines.extend(examples)
+    return "\n".join(lines)
+
+
+def _clip(s):
+    if len(s) > OUT_LIMIT:
+        return s[:OUT_LIMIT] + "\n...[output clipped]"
+    return s
+
+
+def tool_function(brute_path=None, params=None, candidates=None, mode="table", table_vars=None, timeout=10):
+    try:
+        if not brute_path:
+            return "Error: brute_path is required"
+        if params is None:
+            return "Error: params is required, e.g. {\"n\": [1, 10]}"
+        if not os.path.isfile(brute_path):
+            return f"Error: brute file not found: {brute_path}"
+        mode = mode or "table"
+        if mode not in MODES:
+            return f"Error: mode must be one of {list(MODES)}"
+        timeout = max(1, min(int(timeout or 10), 120))
+        if isinstance(candidates, str):
+            try:
+                candidates = json.loads(candidates)
+            except ValueError:
+                candidates = [candidates]
+            if isinstance(candidates, str):
+                candidates = [candidates]
+        ranges = _parse_params(params)
+        names = [r[0] for r in ranges]
+        points = _grid(ranges)
+        results, err = _run_points(brute_path, points, timeout)
+        values = dict(zip(points, results))
+        head = f"mode={mode} params={names} points={len(points)} evaluated={len(results)}"
+        if err:
+            head += f"\nERROR {err}"
+        if mode == "table":
+            body = _mode_table(names, ranges, values, table_vars)
+        elif mode == "diff":
+            body = _mode_diff(names, ranges, values)
+        else:
+            body = _mode_check(names, points, values, candidates)
+        if body.startswith("Error:"):
+            return body
+        return _clip(head + "\n" + body)
+    except Exception as e:
+        return f"Error: {type(e).__name__}: {e}"
+
+
+if __name__ == "__main__" and len(sys.argv) > 1 and sys.argv[1] == "--worker":
+    _worker_main()
