+    def _smoke_check(self, timeout=10):
+        """
+        Deterministic smoke test: run solution.py once on a synthetic input (the first extracted
+        sample if any, else a tiny generic input) and report nonzero exit codes or tracebacks.
+        """
+        solution_path = os.path.join(self.git_tempdir, 'solution.py')
+        inp = None
+        if self.sample_names:
+            try:
+                with open(os.path.join(self.samples_dir, f"{self.sample_names[0]}.in")) as f:
+                    inp = f.read()
+            except Exception:
+                inp = None
+        if inp is None:
+            inp = "1\n1\n1\n"
+        try:
+            proc = subprocess.run(["python3", solution_path], input=inp, capture_output=True,
+                                  text=True, timeout=timeout, cwd=self.git_tempdir)
+        except subprocess.TimeoutExpired:
+            return f"smoke check: TIMEOUT after {timeout}s on synthetic input"
+        except Exception as e:
+            return f"smoke check: runner error: {e}"
+        err = proc.stderr or ""
+        if proc.returncode != 0 or "Traceback" in err:
+            return (f"smoke check: FAILED (exit code {proc.returncode}); stderr tail: "
+                    f"{err[-400:]!r}")
+        return "smoke check: ok (exit code 0, no traceback)"
