+# Draft of tools/sample_check.py (to be moved into tools/ after repo inspection)
+import json
+import os
+import subprocess
+import difflib
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": (
+            "Run a Python solution file on every sample in a JSON file and compare stdout "
+            "with the expected output. The JSON file must contain a list of objects with keys "
+            "'input' and 'output'. Reports PASS/FAIL per sample with a unified diff on failure. "
+            "Exact match (after whitespace normalization) is required even if the statement says "
+            "any valid answer is accepted."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run.",
+                },
+                "samples_json_path": {
+                    "type": "string",
+                    "description": "Path to a JSON file: a list of {\"input\": str, \"output\": str} objects.",
+                },
+            },
+            "required": ["solution_path", "samples_json_path"],
+        },
+    }
+
+
+def _normalize(text):
+    return [line.split() for line in text.strip().splitlines() if line.strip()]
+
+
+def tool_function(solution_path, samples_json_path):
+    try:
+        with open(samples_json_path, "r") as f:
+            samples = json.load(f)
+    except Exception as e:
+        return f"Could not read samples file {samples_json_path}: {e}"
+    if not isinstance(samples, list):
+        return "samples file must contain a JSON list of {\"input\", \"output\"} objects"
+    if not os.path.exists(solution_path):
+        return f"Solution file not found: {solution_path}"
+
+    lines = []
+    passed = 0
+    for idx, sample in enumerate(samples):
+        if not isinstance(sample, dict) or "input" not in sample or "output" not in sample:
+            lines.append(f"Sample {idx}: FAIL (malformed entry; needs 'input' and 'output')")
+            continue
+        sin = str(sample["input"])
+        expected = str(sample["output"])
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=sin,
+                capture_output=True,
+                text=True,
+                timeout=10,
+            )
+            actual = proc.stdout
+            err = proc.stderr
+        except subprocess.TimeoutExpired:
+            lines.append(f"Sample {idx}: FAIL (timeout after 10s)")
+            continue
+        except Exception as e:
+            lines.append(f"Sample {idx}: FAIL (could not run: {e})")
+            continue
+
+        if _normalize(actual) == _normalize(expected):
+            passed += 1
+            lines.append(f"Sample {idx}: PASS")
+        else:
+            lines.append(f"Sample {idx}: FAIL")
+            diff = difflib.unified_diff(
+                expected.strip().splitlines(),
+                actual.strip().splitlines(),
+                fromfile="expected",
+                tofile="actual",
+                lineterm="",
+            )
+            lines.extend("    " + d for d in diff)
+            if err.strip():
+                lines.append("    stderr: " + err.strip()[-1000:])
+
+    lines.append(
+        f"Summary: {passed}/{len(samples)} samples PASS. "
+        "EXACT MATCH REQUIRED: the hidden grader may compare stdout exactly even when the "
+        "statement says any valid answer is accepted; a valid-but-different output is a FAILURE."
+    )
+    return "\n".join(lines)
