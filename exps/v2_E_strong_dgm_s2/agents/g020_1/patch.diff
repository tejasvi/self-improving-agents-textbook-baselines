index 0000000..69cc2e1
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,94 @@
+import difflib
+import os
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a Python solution on each sample input via stdin and compare its stripped stdout with the expected output EXACTLY.\n
+* Reports PASS or FAIL for every sample, with a unified diff (expected vs actual) for failures.
+* Use it to verify that solution.py reproduces every sample output of the statement exactly.
+* If a sample fails but the token counts match, the problem may allow multiple answers. In that case the hidden grader may still require the canonical answer: find the canonical rule (e.g. lexicographically smallest, first found in natural scan order) that reproduces all sample outputs, and make solution.py output exactly that.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (run as `python3 <solution_path>`)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of samples. Each sample is an object with the stdin text and the expected stdout text.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Exact stdin text for this sample."},
+                            "expected": {"type": "string", "description": "Exact expected stdout text for this sample."}
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _token_count(s):
+    return len(s.split())
+
+
+def tool_function(solution_path, samples, timeout=10):
+    if not solution_path or not os.path.isfile(os.path.abspath(solution_path)):
+        return f"Error: solution_path does not exist: {solution_path}"
+    if not isinstance(samples, list) or not samples:
+        return "Error: samples must be a non-empty array of objects with 'input' and 'expected' strings."
+    try:
+        timeout = max(1, min(int(timeout if timeout is not None else 10), 120))
+    except (TypeError, ValueError):
+        return "Error: timeout must be an integer."
+
+    lines = []
+    all_pass = True
+    multi_hint = False
+    for idx, s in enumerate(samples, start=1):
+        if not isinstance(s, dict) or "input" not in s or "expected" not in s:
+            return f"Error: sample {idx} must be an object with 'input' and 'expected'."
+        inp = "" if s["input"] is None else str(s["input"])
+        exp = "" if s["expected"] is None else str(s["expected"])
+        try:
+            p = subprocess.run([sys.executable, os.path.abspath(solution_path)], input=inp,
+                               capture_output=True, text=True, timeout=timeout, errors="replace")
+        except subprocess.TimeoutExpired:
+            all_pass = False
+            lines.append(f"Sample {idx}: FAIL (timed out after {timeout} seconds)")
+            continue
+        actual = p.stdout.strip()
+        expected = exp.strip()
+        if actual == expected:
+            lines.append(f"Sample {idx}: PASS")
+            continue
+        all_pass = False
+        if p.returncode != 0:
+            err = (p.stderr or "").strip()[-2000:]
+            lines.append(f"Sample {idx}: FAIL (exit code {p.returncode})\nSTDERR:\n{err}")
+            continue
+        diff = "\n".join(difflib.unified_diff(
+            expected.splitlines(), actual.splitlines(),
+            fromfile="expected", tofile="actual", lineterm=""))
+        lines.append(f"Sample {idx}: FAIL\n{diff or '(whitespace-only difference)'}")
+        if _token_count(actual) == _token_count(expected):
+            multi_hint = True
+
+    summary = "ALL SAMPLES PASS" if all_pass else "SOME SAMPLES FAILED"
+    out = summary + "\n" + "\n".join(lines)
+    if multi_hint:
+        out += ("\nHint: Output differs from expected; if the problem allows multiple answers, "
+                "the grader may still require the canonical answer — infer the rule from the samples.")
+    return out
