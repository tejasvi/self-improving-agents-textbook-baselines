+def _run(solution_path, input_text, time_limit):
+    """Run `python3 solution_path` on input_text. Returns (status, stdout)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=time_limit,
+        )
+    except subprocess.TimeoutExpired:
+        return "TIMEOUT", ""
+    if proc.returncode != 0:
+        return "ERROR", proc.stderr[-500:]
+    return "OK", proc.stdout
+
+
+def scale_check(solution_path, inputs, time_limit=2.0):
+    """Run solution on each max-size input. Returns (passed, report_text)."""
+    lines = []
+    all_ok = True
+    for idx, inp in enumerate(inputs):
+        status, out = _run(solution_path, inp, time_limit)
+        if status != "OK":
+            all_ok = False
+        head = inp.strip().splitlines()[0][:60] if inp.strip() else "<empty>"
+        lines.append(f"input[{idx}] ({head}...): {status}")
+        if status == "ERROR":
+            lines.append(f"  stderr: {out}")
+    lines.append("PASS" if all_ok else "FAIL")
+    return all_ok, "\n".join(lines)
+
+
+def count_samples_passed(solution_path, samples, time_limit=5.0):
+    passed = 0
+    for inp, exp in samples:
+        status, out = _run(solution_path, inp, time_limit)
+        if status == "OK" and out.split() == exp.split():
+            passed += 1
+    return passed
+
+
+def score_attempt(samples_passed, stress_ok, scale_ok):
