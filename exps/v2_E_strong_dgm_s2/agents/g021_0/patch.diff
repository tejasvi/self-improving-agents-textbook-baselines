+def _looks_like_data(block):
+    """Heuristic: sample data is non-empty, has no sentence-like prose."""
+    lines = [l.rstrip() for l in block]
+    if not any(l.strip() for l in lines):
+        return False
+    for l in lines:
+        s = l.strip().lower()
+        if not s:
+            continue
+        if s.startswith(PROSE_STARTS):
+            return False
+        # Prose lines contain several words ending in a period and no digits.
+        if s.endswith(".") and len(s.split()) > 4 and not re.search(r"\d", s):
+            return False
+    return True
 
 
