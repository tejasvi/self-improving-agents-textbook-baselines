+++ b/tools/canonical_check.py
@@ -0,0 +1,100 @@
+import glob
+import importlib.util
+import os
+
+def tool_info():
+    return {
+        "name": "canonical_check",
+        "description": """Check which deterministic ordering of valid answers reproduces the expected sample outputs.\n
+* Loads a brute-force Python module (path given by brute_path) that defines all_answers(inp) -> list of output strings for raw input text inp.\n
+* For every sample in samples_dir (files NAME.in and NAME.out with the same stem), it enumerates all valid answers and picks one per ordering: lex-min (smallest integer tuple), lex-max (largest integer tuple), by-sum-then-lex (smallest sum, ties by lex-min), and string-min (smallest output text).\n
+* Reports for each ordering how many samples it reproduces exactly, and whether it reproduces ALL samples.\n
+* Returns the raw results as text; read it to decide which ordering canonical() should use.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {"type": "string", "description": "Path to the brute-force Python module (e.g. tests/brute.py) that defines all_answers(inp)."},
+                "samples_dir": {"type": "string", "description": "Directory containing sample pairs NAME.in and NAME.out (e.g. tests/samples)."}
+            },
+            "required": ["brute_path", "samples_dir"]
+        }
+    }
+
+def _key_lex_min(parts, text):
+    return tuple(parts)
+
+def _key_lex_max(parts, text):
+    return tuple(-p for p in parts)
+
+def _key_sum_then_lex(parts, text):
+    return (sum(parts), tuple(parts))
+
+def _key_string_min(parts, text):
+    return (text,)
+
+ORDERINGS = {
+    "lex-min": _key_lex_min,
+    "lex-max": _key_lex_max,
+    "by-sum-then-lex": _key_sum_then_lex,
+    "string-min": _key_string_min,
+}
+
+def _parse_ints(text):
+    try:
+        return [int(x) for x in text.split()]
+    except ValueError:
+        return None
+
+def tool_function(brute_path, samples_dir):
+    try:
+        spec = importlib.util.spec_from_file_location("brute_under_check", brute_path)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+    except Exception as e:
+        return f"Error: could not load {brute_path}: {type(e).__name__}: {e}"
+    if not hasattr(mod, "all_answers"):
+        return f"Error: {brute_path} does not define all_answers(inp)."
+
+    stems = sorted(os.path.splitext(os.path.basename(p))[0] for p in glob.glob(os.path.join(samples_dir, "*.in")))
+    if not stems:
+        return f"Error: no *.in files found in {samples_dir}."
+
+    lines = [f"samples: {len(stems)}"]
+    matches = {name: [] for name in ORDERINGS}
+    for stem in stems:
+        with open(os.path.join(samples_dir, stem + ".in")) as f:
+            inp = f.read()
+        out_path = os.path.join(samples_dir, stem + ".out")
+        if not os.path.isfile(out_path):
+            lines.append(f"{stem}: missing {stem}.out")
+            for name in ORDERINGS:
+                matches[name].append(False)
+            continue
+        with open(out_path) as f:
+            expected = f.read().strip()
+        try:
+            answers = [a.strip() for a in mod.all_answers(inp)]
+        except Exception as e:
+            lines.append(f"{stem}: all_answers raised {type(e).__name__}: {e}")
+            for name in ORDERINGS:
+                matches[name].append(False)
+            continue
+        lines.append(f"{stem}: expected={expected!r} num_valid_answers={len(answers)}")
+        parsed = [_parse_ints(a) for a in answers]
+        numeric = bool(answers) and all(p is not None for p in parsed)
+        for name, keyf in ORDERINGS.items():
+            if not answers:
+                chosen = None
+            elif numeric and name != "string-min":
+                chosen = min(zip(answers, parsed), key=lambda ap: keyf(ap[1], ap[0]))[0]
+            else:
+                chosen = min(answers)
+            ok = chosen is not None and chosen == expected
+            matches[name].append(ok)
+            lines.append(f"  {name}: chosen={chosen!r} {'MATCH' if ok else 'MISMATCH'}")
+
+    lines.append("summary:")
+    for name in ORDERINGS:
+        flags = matches[name]
+        lines.append(f"  {name}: {sum(flags)}/{len(flags)} samples reproduced" + (" (ALL)" if flags and all(flags) else ""))
+    return "\n".join(lines)
