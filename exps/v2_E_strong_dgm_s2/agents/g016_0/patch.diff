diff --git a/tools/interactive_judge.py b/tools/interactive_judge.py
new file mode 100644
index 0000000..fc0f1ef
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,139 @@
+import importlib.util
+import os
+import select
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "interactive_judge",
+        "description": """Run a solution as a subprocess against a user-supplied Python judge over pipes, to test interactive protocols.\n
+* The judge file must define `initial_input()` returning the text the solution reads first (may be empty string), and `respond(query_line, state)` returning the reply text for one query line (or None to end the interaction). `state` is a dict you may mutate freely (it starts empty).\n
+* Reports the full transcript (queries and replies), the number of queries, the exit code, stderr (tracebacks), and any timeouts.\n
+* Use it to test the solution against different judge behaviors. Also test the same solution with a static stdin file in the statement's sample format using bash.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file to run."},
+                "judge_path": {"type": "string", "description": "Path to a Python judge file defining initial_input() and respond(query_line, state)."},
+                "timeout": {"type": "integer", "description": "Per-read timeout in seconds (default 5, max 60)."},
+                "max_queries": {"type": "integer", "description": "Maximum number of queries before the judge stops the run (default 1000, max 100000)."},
+            },
+            "required": ["solution_path", "judge_path"],
+        },
+    }
+
+
+def _clip(s, n=8000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _load_judge(path):
+    spec = importlib.util.spec_from_file_location("_user_judge", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    if not hasattr(mod, "respond"):
+        raise AttributeError("judge file must define respond(query_line, state)")
+    init = mod.initial_input() if hasattr(mod, "initial_input") else ""
+    return mod, init
+
+
+def _read_line(stream, fd, timeout):
+    """Read one line from the pipe with a timeout. Returns (line or None on EOF, timed_out flag)."""
+    buf = b""
+    for _ in range(1 << 20):  # bounded loop
+        ready, _, _ = select.select([fd], [], [], timeout)
+        if not ready:
+            return (buf.decode(errors="replace") if buf else None), True
+        chunk = os.read(fd, 1)
+        if not chunk:
+            return (buf.decode(errors="replace") if buf else None), False
+        buf += chunk
+        if chunk == b"\n":
+            return buf.decode(errors="replace"), False
+    return buf.decode(errors="replace"), False
+
+
+def tool_function(solution_path, judge_path, timeout=5, max_queries=1000):
+    timeout = max(1, min(int(timeout or 5), 60))
+    max_queries = max(1, min(int(max_queries or 1000), 100000))
+    try:
+        judge, init = _load_judge(judge_path)
+    except Exception as e:  # report, do not crash the agent
+        return f"Error loading judge file: {type(e).__name__}: {e}"
+
+    proc = subprocess.Popen(
+        [sys.executable, solution_path],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+    )
+    transcript = []
+    state = {}
+    queries = 0
+    status = "ok"
+    try:
+        if init:
+            proc.stdin.write(init.encode())
+        proc.stdin.flush()
+        transcript.append(f"[judge->solution] initial_input: {init!r}")
+        out_fd = proc.stdout.fileno()
+        for _ in range(max_queries + 1):  # bounded loop
+            line, timed_out = _read_line(proc.stdout, out_fd, timeout)
+            if timed_out:
+                status = f"timeout: no output for {timeout}s"
+                break
+            if line is None:
+                status = "solution ended / closed stdout"
+                break
+            transcript.append(f"[solution->judge] {line.rstrip()}")
+            if queries >= max_queries:
+                status = "query limit exceeded"
+                break
+            queries += 1
+            try:
+                reply = judge.respond(line.strip(), state)
+            except Exception as e:
+                status = f"judge raised {type(e).__name__}: {e}"
+                break
+            if reply is None:
+                status = "judge ended interaction"
+                break
+            transcript.append(f"[judge->solution] {str(reply).rstrip()}")
+            try:
+                proc.stdin.write((str(reply) + "\n").encode())
+                proc.stdin.flush()
+            except BrokenPipeError:
+                status = "broken pipe: solution exited early"
+                break
+        else:
+            status = "too many output lines (judge loop bound reached)"
+    finally:
+        try:
+            proc.stdin.close()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+            status += " (solution killed after timeout)"
+        err = proc.stderr.read().decode(errors="replace") if proc.stderr else ""
+        proc.stdout.close()
+        proc.stderr.close()
+
+    rc = proc.returncode
+    parts = [
+        f"Status: {status}",
+        f"Queries: {queries}",
+        f"Exit code: {rc}",
+        "Transcript:",
+        _clip("\n".join(transcript)),
+    ]
+    if err.strip():
+        parts.append("Stderr:\n" + _clip(err))
+    if rc not in (0, None):
+        parts.append("Note: non-zero exit code; investigate the traceback above.")
+    return "\n".join(parts)
