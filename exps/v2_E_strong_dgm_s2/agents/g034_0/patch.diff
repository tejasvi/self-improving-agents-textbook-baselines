diff --git a/tools/perf_test.py b/tools/perf_test.py
new file mode 100644
index 0000000..06b9b06
--- /dev/null
+++ b/tools/perf_test.py
@@ -0,0 +1,255 @@
+import os
+import subprocess
+import sys
+import tempfile
+import json
+
+# Driver executed in a subprocess. It loads the solution and the generator, iterates over
+# big_cases() (a bounded number of cases), times every case and appends one JSON line per
+# case to result_path. Per-case timeouts are enforced with SIGALRM (method / solve mode) or
+# with subprocess timeouts (stdin-program mode, when the generator yields strings).
+_DRIVER = r'''
+import sys, json, signal, importlib.util, os, io, copy, traceback, itertools, contextlib, time, subprocess
+
+sol_path, gen_path, method, per_call, result_path, time_limit = sys.argv[1:7]
+per_call = float(per_call)
+time_limit = float(time_limit)
+MAX_CASES = 30
+REPR_CAP = 300
+
+def record(d):
+    with open(result_path, "a") as f:
+        f.write(json.dumps(d) + "\n")
+        f.flush()
+
+def load(path, name):
+    d = os.path.dirname(os.path.abspath(path))
+    if d not in sys.path:
+        sys.path.insert(0, d)
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+class _Timeout(BaseException):
+    pass
+
+def _on_alarm(signum, frame):
+    raise _Timeout()
+
+import ast
+def _has_top_level_solve(path):
+    try:
+        with open(path, "r", errors="replace") as f:
+            tree = ast.parse(f.read())
+    except Exception:
+        return False
+    return any(isinstance(n, ast.FunctionDef) and n.name == "solve" for n in tree.body)
+
+# Stdin programs are never imported (importing would execute their top-level code and read stdin).
+sol_mod = None
+if method or _has_top_level_solve(sol_path):
+    try:
+        sol_mod = load(sol_path, "_perf_solution")
+    except BaseException:
+        record({"name": "<setup>", "status": "error", "time": 0.0,
+                "message": "Failed to import a file:\n" + traceback.format_exc(limit=5)})
+        os._exit(0)
+try:
+    gen_mod = load(gen_path, "_perf_gen")
+except BaseException:
+    record({"name": "<setup>", "status": "error", "time": 0.0,
+            "message": "Failed to import a file:\n" + traceback.format_exc(limit=5)})
+    os._exit(0)
+
+if not hasattr(gen_mod, "big_cases"):
+    record({"name": "<setup>", "status": "error", "time": 0.0,
+            "message": "generator file must define big_cases() yielding (name, input) pairs"})
+    os._exit(0)
+
+fn = None
+try:
+    if method:
+        if not hasattr(sol_mod, "Solution"):
+            raise AttributeError("solution file has no class Solution (method=%r)" % method)
+        inst = sol_mod.Solution()
+        m = getattr(inst, method)
+        fn = lambda x: m(*x)
+    elif sol_mod is not None and hasattr(sol_mod, "solve"):
+        fn = sol_mod.solve
+except BaseException:
+    record({"name": "<setup>", "status": "error", "time": 0.0,
+            "message": "Setup failed:\n" + traceback.format_exc(limit=5)})
+    os._exit(0)
+
+signal.signal(signal.SIGALRM, _on_alarm)
+
+def run_stdin_program(text):
+    t0 = time.perf_counter()
+    try:
+        p = subprocess.run([sys.executable, sol_path], input=text, capture_output=True,
+                           text=True, timeout=per_call, errors="replace")
+    except subprocess.TimeoutExpired:
+        return ("timeout", time.perf_counter() - t0, None)
+    el = time.perf_counter() - t0
+    if p.returncode != 0:
+        return ("exc", el, (p.stderr or "").strip()[-1000:])
+    return ("ok", el, p.stdout)
+
+try:
+    cases = gen_mod.big_cases()
+    for name, x in itertools.islice(iter(cases), MAX_CASES):
+        name = str(name)
+        try:
+            if not method and (sol_mod is None or not hasattr(sol_mod, "solve")) and isinstance(x, str):
+                st, el, val = run_stdin_program(x)
+            else:
+                signal.setitimer(signal.ITIMER_REAL, per_call)
+                t0 = time.perf_counter()
+                try:
+                    with contextlib.redirect_stdout(io.StringIO()):
+                        fn(x)
+                    st, val = "ok", None
+                except _Timeout:
+                    st, val = "timeout", None
+                except Exception:
+                    st, val = "exc", traceback.format_exc(limit=4)
+                finally:
+                    signal.setitimer(signal.ITIMER_REAL, 0)
+                el = time.perf_counter() - t0
+        except BaseException:
+            st, el, val = "exc", 0.0, traceback.format_exc(limit=4)
+        if st == "timeout":
+            flag = "TIMEOUT"
+        elif st == "exc":
+            flag = "EXC"
+        elif el > time_limit:
+            flag = "SLOW"
+        else:
+            flag = "OK"
+        msg = None
+        if st == "exc":
+            msg = str(val)[-REPR_CAP:]
+        record({"name": name, "status": flag, "time": el, "message": msg})
+except BaseException:
+    record({"name": "<generator>", "status": "error", "time": 0.0,
+            "message": "big_cases() failed:\n" + traceback.format_exc(limit=5)})
+os._exit(0)
+'''
+
+
+def tool_info():
+    return {
+        "name": "perf_test",
+        "description": """Performance-test a solution on the maximum-size adversarial inputs produced by a generator.\n
+* The generator file must define `big_cases()` which yields `(name, input)` pairs (at most 30 are run). Inputs should be at the maximum constraint sizes and structurally different (all equal, all distinct, random, sorted/reverse, and inputs that maximize every loop bound the algorithm depends on).
+* If `method` is given, the solution file defines class `Solution` and each input is a tuple of positional arguments passed to that method. Otherwise, if the solution file defines `solve(input_obj)`, the input object is passed to it; if the input is a string and no `solve` exists, the solution is run as a stdin program with that string as stdin.
+* Every case runs in an isolated way with a per-case hard timeout (`per_case_timeout` seconds). Each case is reported as OK (<= time_limit), SLOW (between time_limit and per_case_timeout), TIMEOUT, or EXC (exception / non-zero exit), with wall time, and a summary is returned. Outputs are not checked for correctness; use stress_test for that.
+* Use this after writing an algorithm, to confirm it is fast enough on worst-case inputs. Heuristic pruning does not count as a complexity fix unless the adversarial cases pass.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file (absolute or relative to the current directory)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator Python file defining big_cases() that yields (name, input) pairs of maximum-size adversarial inputs."
+                },
+                "method": {
+                    "type": "string",
+                    "description": "Optional. If given, the solution file defines class Solution with this method name, and each input must be a tuple of positional arguments."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Seconds above which a case is reported as SLOW (default 2)."
+                },
+                "per_case_timeout": {
+                    "type": "number",
+                    "description": "Hard timeout in seconds for each case; a case exceeding it is reported as TIMEOUT (default 10)."
+                }
+            },
+            "required": ["solution_path", "generator_path"]
+        }
+    }
+
+
+def tool_function(solution_path, generator_path, method=None, time_limit=2, per_case_timeout=10):
+    for label, p in (("solution_path", solution_path), ("generator_path", generator_path)):
+        if not p or not os.path.isfile(os.path.abspath(p)):
+            return f"Error: {label} does not exist: {p}"
+    try:
+        time_limit = float(time_limit if time_limit is not None else 2)
+        per_case_timeout = float(per_case_timeout if per_case_timeout is not None else 10)
+    except (TypeError, ValueError):
+        return "Error: time_limit and per_case_timeout must be numbers."
+    time_limit = max(0.1, min(time_limit, 60.0))
+    per_case_timeout = max(time_limit, min(per_case_timeout, 60.0))
+    fd, result_path = tempfile.mkstemp(suffix=".jsonl")
+    os.close(fd)
+    try:
+        cmd = [sys.executable, "-c", _DRIVER,
+               os.path.abspath(solution_path), os.path.abspath(generator_path),
+               method or "", str(per_case_timeout), result_path, str(time_limit)]
+        # Overall bound: up to 30 cases, each at most per_case_timeout, plus slack.
+        overall = min(280, int(per_case_timeout * 30 + 60))
+        p = None
+        overall_note = ""
+        try:
+            p = subprocess.run(cmd, capture_output=True, text=True, timeout=overall,
+                               stdin=subprocess.DEVNULL, errors="replace")
+        except subprocess.TimeoutExpired:
+            overall_note = f"\n(The overall {overall}s limit was reached; remaining cases were not run.)"
+        records = []
+        try:
+            with open(result_path) as f:
+                for line in f:
+                    line = line.strip()
+                    if line:
+                        try:
+                            records.append(json.loads(line))
+                        except ValueError:
+                            pass
+        except OSError:
+            pass
+        if not records:
+            err = (p.stderr or "").strip()[-2000:] if p is not None else ""
+            return "Error: perf driver produced no result.\n" + (err or "(no stderr)") + overall_note
+        lines = []
+        counts = {"OK": 0, "SLOW": 0, "TIMEOUT": 0, "EXC": 0}
+        errors = []
+        for r in records:
+            if r.get("status") == "error":
+                errors.append(r.get("message", ""))
+                continue
+            st = r.get("status")
+            counts[st] = counts.get(st, 0) + 1
+            if st == "EXC":
+                lines.append(f"{r['name']}: EXC after {r['time']:.2f}s")
+                if r.get("message"):
+                    lines.append("    " + str(r["message"]).replace("\n", "\n    "))
+            elif st == "TIMEOUT":
+                lines.append(f"{r['name']}: TIMEOUT >{per_case_timeout:g}s")
+            else:
+                lines.append(f"{r['name']}: {r['time']:.2f}s {st}")
+        out = []
+        if errors:
+            out.append("ERROR: " + "\n".join(errors))
+        out.append(" | ".join(lines) if lines else "(no cases ran)")
+        total = sum(counts.values())
+        worst = max((r["time"] for r in records if r.get("status") not in ("error",)), default=0.0)
+        verdict = "PASS" if total and counts["OK"] == total else "FAIL"
+        out.append(
+            f"Summary [{verdict}]: {counts['OK']} OK, {counts['SLOW']} SLOW (>{time_limit:g}s), "
+            f"{counts['TIMEOUT']} TIMEOUT (>{per_case_timeout:g}s), {counts['EXC']} EXC out of {total} cases; "
+            f"worst time {worst:.2f}s."
+        )
+        if verdict == "FAIL":
+            out.append("Make the solution faster (better algorithm, not pruning) and re-run perf_test.")
+        return "\n".join(out) + overall_note
+    finally:
+        try:
+            os.remove(result_path)
+        except OSError:
+            pass
