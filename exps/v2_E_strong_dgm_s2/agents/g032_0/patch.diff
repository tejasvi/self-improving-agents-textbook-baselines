index 0000000..43a4350
--- /dev/null
+++ b/tools/check_runs.py
@@ -0,0 +1,173 @@
+import os
+import shutil
+import subprocess
+import tempfile
+import time
+
+INPUT_CLIP = 1500
+OUTPUT_CLIP = 800
+MESSAGE_CLIP = 800
+SHOWN_FAILURES = 3
+MAX_SEEDS = 5000
+
+
+def tool_info():
+    return {
+        "name": "check_runs",
+        "description": """Stress-test a solution against a random input generator and a validity checker over many seeds.\n
+* For each seed: runs `generator_cmd <seed>` to produce one input (the seed is appended as the last argument, the generator prints one input to stdout), runs `solution_cmd` with that input on stdin, saves its stdout, then runs `checker_cmd <input_file> <output_file>`.
+* The checker exits with code 0 if the output is valid; otherwise its stdout/stderr is the reason.
+* Failures include checker rejection, solution crashes (non-zero exit), timeouts and generator errors.
+* Returns a plain-text summary: number of cases, failures, timeouts and crashes, the maximum elapsed time of a solution run, and for up to 3 failing cases (smallest inputs first) the clipped input, the clipped solution output and the raw checker message or stderr.
+* Use it with at least 300 seeds spanning all generator families before and after every change to the solution.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; it reads the input on stdin and writes the answer to stdout, e.g. `python3 solution.py`."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that prints one random input to stdout; the seed is appended as the last argument, e.g. `python3 tests/gen_scale.py`."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Shell command invoked as `<checker_cmd> <input_file> <output_file>`; exit code 0 means the output is valid, otherwise its stdout/stderr is the reason, e.g. `python3 tests/checker.py`."
+                },
+                "seeds": {
+                    "type": "integer",
+                    "description": "Number of seeds to run (default 200)."
+                },
+                "start_seed": {
+                    "type": "integer",
+                    "description": "First seed value; seeds run from start_seed to start_seed + seeds - 1 (default 0)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Time limit in seconds for each solution run (default 10)."
+                }
+            },
+            "required": ["solution_cmd", "generator_cmd", "checker_cmd"]
+        }
+    }
+
+
+def _clip(text, limit):
+    text = text or ""
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n...[clipped, {len(text) - limit} more chars]"
+
+
+def _run_shell(cmd, stdin_path=None, stdout_path=None, timeout=None, args_suffix=""):
+    """Run a shell command. Returns (returncode, stdout_text, stderr_text). Raises TimeoutExpired."""
+    stdin_f = open(stdin_path, "rb") if stdin_path else subprocess.DEVNULL
+    stdout_f = open(stdout_path, "wb") if stdout_path else subprocess.PIPE
+    try:
+        p = subprocess.run(["bash", "-c", cmd + args_suffix], stdin=stdin_f, stdout=stdout_f,
+                           stderr=subprocess.PIPE, timeout=timeout)
+        out = p.stdout.decode("utf-8", "replace") if stdout_path is None else ""
+        err = p.stderr.decode("utf-8", "replace")
+        return p.returncode, out, err
+    finally:
+        if stdin_path:
+            stdin_f.close()
+        if stdout_path:
+            stdout_f.close()
+
+
+def tool_function(solution_cmd, generator_cmd, checker_cmd, seeds=200, start_seed=0, timeout=10):
+    try:
+        n_seeds = int(seeds) if seeds is not None else 200
+    except (TypeError, ValueError):
+        n_seeds = 200
+    n_seeds = max(1, min(n_seeds, MAX_SEEDS))
+    try:
+        first = int(start_seed) if start_seed is not None else 0
+    except (TypeError, ValueError):
+        first = 0
+    try:
+        limit = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        limit = 10.0
+    limit = max(0.1, min(limit, 300.0))
+
+    tmpdir = tempfile.mkdtemp(prefix="check_runs_")
+    in_path = os.path.join(tmpdir, "input.txt")
+    out_path = os.path.join(tmpdir, "output.txt")
+    failures = []  # (len(input), seed, kind, input_text, output_text, message)
+    cases = 0
+    timeouts = 0
+    crashes = 0
+    max_elapsed = 0.0
+    max_elapsed_seed = None
+    try:
+        for seed in range(first, first + n_seeds):
+            cases += 1
+            # 1) generate the input
+            try:
+                rc, gen_out, gen_err = _run_shell(generator_cmd, timeout=limit, args_suffix=f" {seed}")
+            except subprocess.TimeoutExpired:
+                failures.append((0, seed, "generator timeout", "", "", f"generator exceeded {limit}s"))
+                continue
+            if rc != 0:
+                failures.append((0, seed, "generator error", "", "", _clip(gen_err or gen_out, MESSAGE_CLIP)))
+                continue
+            with open(in_path, "w", encoding="utf-8") as f:
+                f.write(gen_out)
+
+            # 2) run the solution
+            start = time.time()
+            try:
+                rc, sol_out, sol_err = _run_shell(solution_cmd, stdin_path=in_path, stdout_path=out_path,
+                                                  timeout=limit)
+            except subprocess.TimeoutExpired:
+                timeouts += 1
+                failures.append((len(gen_out), seed, "timeout", gen_out, "", f"solution exceeded {limit}s"))
+                continue
+            elapsed = time.time() - start
+            if elapsed > max_elapsed:
+                max_elapsed = elapsed
+                max_elapsed_seed = seed
+            with open(out_path, "r", encoding="utf-8", errors="replace") as f:
+                sol_text = f.read()
+            if rc != 0:
+                crashes += 1
+                failures.append((len(gen_out), seed, "crash", gen_out, sol_text,
+                                 _clip(sol_err.strip() or f"solution exit code {rc}", MESSAGE_CLIP)))
+                continue
+
+            # 3) run the checker
+            try:
+                rc, chk_out, chk_err = _run_shell(checker_cmd, timeout=limit,
+                                                  args_suffix=f" {in_path} {out_path}")
+            except subprocess.TimeoutExpired:
+                failures.append((len(gen_out), seed, "checker timeout", gen_out, sol_text,
+                                 f"checker exceeded {limit}s"))
+                continue
+            if rc != 0:
+                msg = (chk_out + ("\n" if chk_out and chk_err else "") + chk_err).strip()
+                failures.append((len(gen_out), seed, "wrong", gen_out, sol_text,
+                                 _clip(msg or f"checker exit code {rc}", MESSAGE_CLIP)))
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    lines = [
+        f"cases: {cases} (seeds {first}..{first + n_seeds - 1})",
+        f"failures: {len(failures)} (timeouts: {timeouts}, crashes: {crashes})",
+        f"max solution elapsed: {max_elapsed:.3f}s" + (f" (seed {max_elapsed_seed})" if max_elapsed_seed is not None else ""),
+    ]
+    if failures:
+        failures.sort(key=lambda t: (t[0], t[1]))
+        for idx, (size, seed, kind, inp, out, msg) in enumerate(failures[:SHOWN_FAILURES], 1):
+            lines.append(f"--- failure {idx}: seed {seed}, kind={kind}, input length {size}")
+            lines.append("input:")
+            lines.append(_clip(inp, INPUT_CLIP).rstrip("\n") or "(none)")
+            lines.append("solution output:")
+            lines.append(_clip(out, OUTPUT_CLIP).rstrip("\n") or "(empty)")
+            lines.append("checker message:" if kind in ("wrong", "checker timeout") else "stderr:")
+            lines.append(msg.rstrip("\n") or "(empty)")
+    else:
+        lines.append("all cases passed")
+    return "\n".join(lines)
