+"""Standalone verifier: extracts 'Sample Input k' / 'Sample Output k' pairs from a
+problem statement and checks a stdin/stdout solution.py against them (token-wise).
+
+Usage: python3 solution.py <statement.txt> [solution_path]
+Exit code 0 when all samples pass, 1 otherwise.
+"""
+import os
+import re
+import subprocess
+import sys
+
+SAMPLE_TIMEOUT = 5
+
+
+def extract_samples(text):
+    """Return a list of (input_text, expected_output) pairs; [] if none are found."""
+    if not isinstance(text, str) or not text:
+        return []
+    in_re = re.compile(r"Sample\s+Input\s*(\d+)\s*:?", re.I)
+    out_re = re.compile(r"Sample\s+Output\s*(\d+)\s*:?", re.I)
+    headers = []
+    for m in in_re.finditer(text):
+        headers.append(("in", int(m.group(1)), m.start(), m.end()))
+    for m in out_re.finditer(text):
+        headers.append(("out", int(m.group(1)), m.start(), m.end()))
+    headers.sort(key=lambda h: h[2])
+
+    def clean(block):
+        lines = [ln.rstrip() for ln in block.splitlines() if not ln.strip().startswith("```")]
+        return "\n".join(lines)
+
+    samples = []
+    for i, h in enumerate(headers):
+        if h[0] != "in":
+            continue
+        nxt = None
+        for h2 in headers[i + 1:]:
+            if h2[0] == "out" and h2[1] == h[1]:
+                nxt = h2
+                break
+            if h2[0] == "in":
+                break
+        if nxt is None:
+            continue
+        inp_block = clean(text[h[3]:nxt[2]])
+        after = [h2[2] for h2 in headers if h2[2] > nxt[3]]
+        out_end = min(after) if after else len(text)
+        out_lines = []
+        for ln in clean(text[nxt[3]:out_end]).splitlines():
+            if not ln.strip():
+                if out_lines:
+                    break
+                continue
+            if re.match(r"\s*(Explanation|Note|Example|Constraints)\b", ln, re.I):
+                break
+            out_lines.append(ln)
+        inp_text = inp_block.strip("\n")
+        exp_text = "\n".join(out_lines).strip()
+        if inp_text.strip() and exp_text:
+            samples.append((inp_text + "\n", exp_text))
+    return samples
+
+
+def run_program(script, input_text, timeout, cwd=None):
+    """Return (status, output) with status in ok | tle | error."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, script], input=input_text, capture_output=True,
+            text=True, timeout=timeout, cwd=cwd,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout
+        if isinstance(out, bytes):
+            out = out.decode(errors="replace")
+        return "tle", out or ""
+    except Exception as e:
+        return "error", f"failed to launch {script}: {e}"
+    if proc.returncode != 0:
+        return "error", (proc.stdout or "") + (proc.stderr or "")
+    return "ok", proc.stdout or ""
+
+
+def check(statement_text, solution_path):
+    """Return (passed_count, total, report_lines)."""
+    samples = extract_samples(statement_text)
+    report = []
+    ok = 0
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    for idx, (inp, exp) in enumerate(samples, 1):
+        status, out = run_program(solution_path, inp, SAMPLE_TIMEOUT, cwd=cwd)
+        if status == "ok" and out.split() == exp.split():
+            ok += 1
+        else:
+            report.append(f"[Sample {idx}] {status}: expected {exp!r}, got {out.strip()[:200]!r}")
+    return ok, len(samples), report
+
+
+def main(argv):
+    if len(argv) < 2:
+        print(__doc__)
+        return 1
+    with open(argv[1]) as f:
+        statement = f.read()
+    sol = argv[2] if len(argv) > 2 else os.path.join(os.path.dirname(os.path.abspath(__file__)), "solution.py")
+    ok, total, report = check(statement, sol)
+    if total == 0:
+        print("No parseable samples found.")
+        return 1
+    print(f"{ok}/{total} samples passed")
+    for line in report:
+        print(line)
+    return 0 if ok == total else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
