+# Generator for the harness. No real samples are available (see brute.py), so samples() is empty.
+# If the problem accepts several valid outputs, define check(input_obj, output) -> bool as well.
+import random
+
+
+def gen(rng, size):
+    """Small random input whose size grows with `size`."""
+    return str(rng.randint(0, max(1, size)))
+
+
+def enumerate_all():
+    for v in range(0, 10):
+        yield str(v)
+
+
+def samples():
+    return []
