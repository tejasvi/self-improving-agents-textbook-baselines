index 0000000..8b202c9
--- /dev/null
+++ b/tools/adversarial_timing.py
@@ -0,0 +1,312 @@
+import importlib.util
+import json
+import math
+import os
+import random
+import shutil
+import string
+import subprocess
+import sys
+import tempfile
+import time
+
+LIMIT_SECONDS = 1.5
+DEFAULT_MAX_N = 20000
+
+DRIVER_TEMPLATE = '''
+import sys, json, importlib.util
+sys.setrecursionlimit(1000000)
+spec = importlib.util.spec_from_file_location("user_solution", __PATH__)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+args = json.load(sys.stdin)
+res = getattr(mod.Solution(), __METHOD__)(*args)
+sys.stdout.write(str(res) + "\\n")
+'''
+
+
+def tool_info():
+    return {
+        "name": "adversarial_timing",
+        "description": (
+            "Measures how the solution's running time grows on structured worst-case inputs (families) "
+            "at several sizes, up to max_n. Built-in families cover all-equal, two-valued alternating, sorted, "
+            "reverse sorted, random small alphabet, random large range and one heavy value plus random rest. "
+            "Optionally supply generator_path exposing families(n) -> dict name -> input, to test "
+            "problem-specific adversarial inputs (e.g. the worst case of each loop of your algorithm). "
+            "Prints a table of times, the fitted growth exponent per family, the projected time at max_n, "
+            "and a WORST line with a LIKELY TLE flag when the projection exceeds about 1.5s. "
+            "Use it at the maximum n before finishing, and to compare a new solution against an old one."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file: a stdin/stdout program, or a file defining class Solution when method is given.",
+                },
+                "method": {
+                    "type": "string",
+                    "description": "Optional. Name of the method of class Solution to call with the family input as positional arguments (a list/tuple input is unpacked, anything else is passed as one argument). If omitted, the solution is run as a stdin/stdout program.",
+                },
+                "input_kind": {
+                    "type": "string",
+                    "description": "Type of the built-in families: 'string' or 'int_list'. Default 'string'.",
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Optional path to a Python file exposing families(n) which returns a dict mapping family name to input: a stdin text (string) for stdin programs, or a list/tuple of arguments or a single object for method mode. If given, these families are used in addition to the built-in ones.",
+                },
+                "sizes": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "Optional list of input sizes. Default [500, 2000, 8000, max_n]. max_n is always included.",
+                },
+                "max_n": {
+                    "type": "integer",
+                    "description": "Maximum input size allowed by the problem constraints. Default 20000.",
+                },
+                "per_call_timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each single run. Default 10.",
+                },
+            },
+            "required": ["solution_path"],
+        },
+    }
+
+
+def _builtin_families(kind, n, rng):
+    """Return dict name -> {'stdin': text, 'args': [...]}."""
+    fams = {}
+    if kind == "int_list":
+        arr_all_equal = [1] * n
+        fams["all_equal"] = arr_all_equal
+        fams["sorted"] = list(range(1, n + 1))
+        fams["reverse_sorted"] = list(range(n, 0, -1))
+        fams["alternating_2"] = [1 if i % 2 == 0 else 2 for i in range(n)]
+        fams["random_small_range"] = [rng.randint(1, 10) for _ in range(n)]
+        fams["random_large_range"] = [rng.randint(1, 10 ** 9) for _ in range(n)]
+        fams["heavy_value_plus_random"] = [
+            1 if rng.random() < 0.9 else rng.randint(1, 10 ** 9) for _ in range(n)
+        ]
+        out = {}
+        for name, arr in fams.items():
+            out[name] = {
+                "stdin": "%d\n%s\n" % (n, " ".join(map(str, arr))),
+                "args": [arr],
+            }
+        return out
+    # default: string
+    letters = string.ascii_lowercase
+    fams["all_same"] = "a" * n
+    fams["alternating_2"] = ("ab" * n)[:n]
+    fams["sorted_blocks"] = "".join(chr(97 + min(25, (i * 26) // n)) for i in range(n))
+    fams["sorted_random"] = "".join(sorted(rng.choice(letters) for _ in range(n)))
+    fams["random_2_letters"] = "".join(rng.choice("ab") for _ in range(n))
+    fams["random_26_letters"] = "".join(rng.choice(letters) for _ in range(n))
+    fams["heavy_one_plus_random"] = "".join(
+        "a" if rng.random() < 0.9 else rng.choice(letters) for _ in range(n)
+    )
+    out = {}
+    for name, s in fams.items():
+        out[name] = {"stdin": s + "\n", "args": [s]}
+    return out
+
+
+def _normalize(obj, method):
+    """Convert a family object into {'stdin': text, 'args': list}."""
+    if isinstance(obj, dict) and ("stdin" in obj or "args" in obj):
+        return {"stdin": obj.get("stdin"), "args": obj.get("args")}
+    if method:
+        args = list(obj) if isinstance(obj, (list, tuple)) else [obj]
+        return {"stdin": None, "args": args}
+    if isinstance(obj, str):
+        text = obj
+    elif isinstance(obj, (list, tuple)) and obj and all(isinstance(x, int) for x in obj):
+        text = "%d\n%s\n" % (len(obj), " ".join(map(str, obj)))
+    else:
+        text = str(obj)
+    return {"stdin": text, "args": None}
+
+
+def _load_generator(path):
+    spec = importlib.util.spec_from_file_location("adversarial_generator", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    if not hasattr(mod, "families"):
+        raise ValueError("generator file has no families(n) function")
+    return mod
+
+
+def _run_once(solution_path, method, item, timeout, tmpdir):
+    """Run once. Returns (elapsed_seconds, status, stderr_tail)."""
+    if method:
+        driver_path = os.path.join(tmpdir, "driver_%d.py" % random.randrange(10 ** 9))
+        abs_sol = os.path.abspath(solution_path)
+        code = DRIVER_TEMPLATE.replace("__PATH__", repr(abs_sol)).replace("__METHOD__", repr(method))
+        with open(driver_path, "w") as f:
+            f.write(code)
+        cmd = [sys.executable, driver_path]
+        inp = json.dumps(item["args"] if item["args"] is not None else [])
+    else:
+        cmd = [sys.executable, os.path.abspath(solution_path)]
+        inp = item["stdin"] if item["stdin"] is not None else ""
+    t0 = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            cmd, input=inp, capture_output=True, text=True, timeout=timeout, cwd=tmpdir
+        )
+    except subprocess.TimeoutExpired:
+        return timeout, "TIMEOUT", ""
+    elapsed = time.perf_counter() - t0
+    if proc.returncode != 0:
+        return elapsed, "RE", (proc.stderr or "")[-300:]
+    return elapsed, "ok", ""
+
+
+def _fit_and_project(points, max_n):
+    """points: list of (n, t) for successful runs sorted by n. Returns (exponent, projected)."""
+    if not points:
+        return None, None
+    n_last, t_last = points[-1]
+    t_last = max(t_last, 1e-3)
+    exponent = None
+    if len(points) >= 2:
+        n1, t1 = points[-2]
+        t1 = max(t1, 1e-3)
+        if n2_ok(n1, n_last):
+            exponent = math.log(t_last / t1) / math.log(n_last / n1)
+            if math.isnan(exponent):
+                exponent = None
+    e = exponent if exponent is not None else 1.0
+    e = min(max(e, 0.0), 3.5)
+    if max_n <= n_last:
+        projected = t_last
+    else:
+        projected = t_last * (max_n / n_last) ** max(e, 1.0)
+    return exponent, projected
+
+
+def n2_ok(n1, n2):
+    return n1 > 0 and n2 > n1
+
+
+def tool_function(solution_path, method=None, input_kind="string", generator_path=None,
+                  sizes=None, max_n=None, per_call_timeout=None):
+    try:
+        if not os.path.exists(solution_path):
+            return "adversarial_timing error: solution file not found: %s" % solution_path
+        max_n = int(max_n) if max_n else DEFAULT_MAX_N
+        timeout = float(per_call_timeout) if per_call_timeout else 10.0
+        if sizes:
+            size_list = sorted(set(int(s) for s in sizes if int(s) > 0))
+        else:
+            size_list = sorted(set([500, 2000, 8000, max_n]))
+        size_list = [s for s in size_list if s <= max_n]
+        if max_n not in size_list:
+            size_list.append(max_n)
+        size_list = sorted(set(size_list))
+
+        gen_mod = _load_generator(generator_path) if generator_path else None
+        rng = random.Random(12345)
+        kind = input_kind or "string"
+
+        # family name -> list of (n, item)
+        family_inputs = {}
+        order = []
+        for n in size_list:
+            fams = _builtin_families(kind, n, rng)
+            if gen_mod is not None:
+                extra = gen_mod.families(n)
+                for name, obj in extra.items():
+                    fams["custom_" + str(name)] = _normalize(obj, method)
+            for name, item in fams.items():
+                if name not in family_inputs:
+                    family_inputs[name] = []
+                    order.append(name)
+                family_inputs[name].append((n, item))
+
+        tmpdir = tempfile.mkdtemp(prefix="adv_timing_")
+        results = {}
+        try:
+            for name in order:
+                results[name] = {"runs": [], "timed_out": False}
+                for n, item in family_inputs[name]:
+                    if results[name]["timed_out"]:
+                        break
+                    elapsed, status, err = _run_once(solution_path, method, item, timeout, tmpdir)
+                    results[name]["runs"].append((n, elapsed, status, err))
+                    if status == "TIMEOUT":
+                        results[name]["timed_out"] = True
+        finally:
+            shutil.rmtree(tmpdir, ignore_errors=True)
+
+        lines = []
+        header = "%-26s" % "family"
+        for n in size_list:
+            header += " %10s" % ("n=%d" % n)
+        header += " %8s %14s  %s" % ("exp", "proj@max_n", "notes")
+        lines.append(header)
+        lines.append("-" * len(header))
+
+        worst = None  # (projected, name, n, time, timed_out)
+        for name in order:
+            res = results[name]
+            row = "%-26s" % name[:26]
+            ok_points = []
+            notes = []
+            cells = {n: "-" for n in size_list}
+            for n, elapsed, status, err in res["runs"]:
+                if status == "ok":
+                    cells[n] = "%.3fs" % elapsed
+                    ok_points.append((n, elapsed))
+                elif status == "TIMEOUT":
+                    cells[n] = "TIMEOUT"
+                    notes.append("timeout at n=%d" % n)
+                else:
+                    cells[n] = "RE"
+                    notes.append("runtime error at n=%d: %s" % (n, err.strip().splitlines()[-1] if err.strip() else ""))
+            for n in size_list:
+                row += " %10s" % cells[n]
+            exponent, projected = _fit_and_project(ok_points, max_n)
+            if res["timed_out"]:
+                projected_eff = float("inf")
+                proj_str = "> %.0fs(timeout)" % timeout
+            elif projected is None:
+                projected_eff = None
+                proj_str = "n/a"
+            else:
+                projected_eff = projected
+                proj_str = "%.2fs" % projected
+            exp_str = "%.2f" % exponent if exponent is not None else "n/a"
+            row += " %8s %14s  %s" % (exp_str, proj_str, "; ".join(notes))
+            lines.append(row)
+            if projected_eff is not None:
+                if worst is None or projected_eff > worst[0]:
+                    last_n, last_t = (ok_points[-1] if ok_points else (None, None))
+                    worst = (projected_eff, name, last_n, last_t, res["timed_out"])
+
+        out = ["adversarial_timing: solution=%s method=%s max_n=%d sizes=%s timeout=%.1fs"
+               % (solution_path, method or "-", max_n, size_list, timeout), ""]
+        out.extend(lines)
+        out.append("")
+        if worst is None:
+            out.append("WORST: no successful runs; check the solution for runtime errors.")
+        else:
+            proj_val, name, last_n, last_t, timed_out = worst
+            if timed_out:
+                out.append("WORST: family %s timed out (limit %.0fs per call); projected > %.0fs"
+                           % (name, timeout, timeout))
+            else:
+                out.append("WORST: family %s at n=%s time %.3fs, projected %.2fs at max_n=%d"
+                           % (name, last_n, last_t, proj_val, max_n))
+            if proj_val > LIMIT_SECONDS:
+                out.append("LIKELY TLE: projected time %s exceeds %.1fs; optimize the loop that the slow family exercises."
+                           % ("> %.0fs" % timeout if timed_out else "%.2fs" % proj_val, LIMIT_SECONDS))
+            else:
+                out.append("OK: all families project under %.1fs at max_n." % LIMIT_SECONDS)
+        out.append("Note: timings include Python startup (~0.03s); exponents are fitted between the two largest sizes.")
+        return "\n".join(out)
+    except Exception as e:
+        return "adversarial_timing error: %s: %s" % (type(e).__name__, e)
