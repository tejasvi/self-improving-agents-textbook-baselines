diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..4559dde
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,154 @@
+import difflib
+import json
+import os
+import re
+import subprocess
+
+_HEADING_IN = re.compile(r'^\W*(sample\s+input|example\s+input|input)\s*\d*\s*\W*$', re.IGNORECASE)
+_HEADING_OUT = re.compile(r'^\W*(sample\s+output|example\s+output|output)\s*\d*\s*\W*$', re.IGNORECASE)
+_HEADING_OTHER = re.compile(r'^\s*#+\s')
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution file on the problem's sample tests and compare its output EXACTLY with the expected sample output.\n
+* Provide either `samples_json` (a JSON list of objects {"input": str, "expected": str}) or `problem_statement_path` (a text file containing the statement; samples are parsed from 'Sample Input N'/'Sample Output N', '### Example', or 'Input:'/'Output:' headings).\n
+* Each sample is run as `python3 solution_path` with the input on stdin. Output is compared line by line ignoring only trailing whitespace.\n
+* Reports PASS per sample, or a unified diff (expected vs actual) plus stderr on mismatch, and ends with 'EXACT MATCH: k/n'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the Python solution file to run (run as `python3 solution_path`)."},
+                "problem_statement_path": {"type": "string", "description": "Optional path to a text file containing the problem statement with sample input/output blocks."},
+                "samples_json": {"type": "string", "description": "Optional JSON list of objects with 'input' and 'expected' string fields (or a path to a file containing that JSON)."},
+                "timeout": {"type": "integer", "description": "Per-sample time limit in seconds (default 10)."}
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _parse_statement(text):
+    """Return list of (input, expected) pairs parsed from statement text."""
+    lines = text.splitlines()
+    ins, outs = [], []
+    mode = None  # 'in' or 'out' or None
+    cur = []
+    seen_content = False
+
+    def flush():
+        nonlocal cur, seen_content
+        if mode == 'in':
+            ins.append('\n'.join(cur))
+        elif mode == 'out':
+            outs.append('\n'.join(cur))
+        cur = []
+        seen_content = False
+
+    for raw in lines:
+        line = raw.strip()
+        if line.startswith('```'):
+            continue
+        if _HEADING_IN.match(line):
+            flush()
+            mode = 'in'
+            continue
+        if _HEADING_OUT.match(line):
+            flush()
+            mode = 'out'
+            continue
+        if mode is None:
+            continue
+        if _HEADING_OTHER.match(raw) or (line.lower().startswith('### ') and mode is not None):
+            flush()
+            mode = None
+            continue
+        if mode == 'out' and not line and seen_content:
+            flush()
+            mode = None
+            continue
+        if line or mode == 'in':
+            if line:
+                seen_content = True
+            cur.append(raw.rstrip())
+    flush()
+
+    # strip empty trailing/leading lines of each block
+    def clean(b):
+        return b.strip('\n')
+    ins = [clean(b) for b in ins]
+    outs = [clean(b) for b in outs]
+    n = min(len(ins), len(outs))
+    return [(ins[i] + '\n', outs[i]) for i in range(n) if outs[i].strip() != '' or ins[i].strip() != '']
+
+
+def _load_samples(samples_json, problem_statement_path):
+    if samples_json:
+        data = samples_json
+        if os.path.isfile(samples_json):
+            with open(samples_json, 'r', encoding='utf-8', errors='replace') as f:
+                data = f.read()
+        items = json.loads(data)
+        if not isinstance(items, list):
+            raise ValueError("samples_json must be a JSON list")
+        return [(str(it['input']), str(it['expected'])) for it in items]
+    if problem_statement_path:
+        with open(problem_statement_path, 'r', encoding='utf-8', errors='replace') as f:
+            return _parse_statement(f.read())
+    raise ValueError("Provide samples_json or problem_statement_path.")
+
+
+def _norm_lines(text):
+    lines = [l.rstrip() for l in text.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def tool_function(solution_path, problem_statement_path=None, samples_json=None, timeout=10):
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    try:
+        timeout = max(1, int(timeout or 10))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        samples = _load_samples(samples_json, problem_statement_path)
+    except Exception as e:
+        return f"Error: could not load samples: {e}"
+    if not samples:
+        return "Error: no samples found. Provide samples_json or a statement with 'Sample Input N'/'Sample Output N' blocks."
+
+    n = len(samples)
+    k = 0
+    reports = []
+    for i, (inp, expected) in enumerate(samples, 1):
+        try:
+            p = subprocess.run(['python3', solution_path], input=inp, capture_output=True,
+                               text=True, timeout=timeout, errors='replace')
+        except subprocess.TimeoutExpired:
+            reports.append(f"Sample {i}: FAIL (timed out after {timeout} seconds)")
+            continue
+        exp_lines = _norm_lines(expected)
+        act_lines = _norm_lines(p.stdout)
+        if exp_lines == act_lines and p.returncode == 0:
+            k += 1
+            reports.append(f"Sample {i}: PASS")
+            continue
+        diff = '\n'.join(difflib.unified_diff(exp_lines, act_lines, 'expected', 'actual', lineterm=''))
+        msg = f"Sample {i}: FAIL"
+        if p.returncode != 0:
+            msg += f" (exit code {p.returncode})"
+        msg += f"\n{diff if diff else '(no line differences; check exit code / stderr)'}"
+        if p.stderr.strip():
+            msg += f"\nSTDERR:\n{p.stderr.rstrip()}"
+        reports.append(msg)
+
+    out = '\n\n'.join(reports)
+    out += f"\n\nEXACT MATCH: {k}/{n}"
+    if k < n:
+        out += ("\nHINT: If the problem accepts any valid answer, your output may still be valid, "
+                "but the grader may compare exactly: try to adjust your construction (tie-breaking, "
+                "ordering, basis choice, bit order) so that it reproduces the sample output exactly.")
+    return out
