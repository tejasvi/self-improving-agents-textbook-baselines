index 0000000..1097216
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,98 @@
+import os
+import subprocess
+import sys
+
+MAX_SHOW = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python program on given standard-input test cases and compare its standard output with the expected outputs.\n
+* Each test case i feeds test_inputs[i] to the program's stdin and compares its stdout with expected_outputs[i].\n
+* Comparison ignores leading/trailing whitespace of the whole output and trailing whitespace on each line.\n
+* The result reports PASS/FAIL per test case, with the actual output, expected output, stderr and exit status for failures.\n
+* Use this to check a solution against the sample tests from the problem statement or your own cases.\n
+* The program is run with the same Python interpreter that runs the agent, with the given timeout per test case.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "program_path": {
+                    "type": "string",
+                    "description": "Path to the Python program file to run (reads stdin, writes stdout)."
+                },
+                "test_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of standard-input contents, one string per test case."
+                },
+                "expected_outputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of expected standard-output contents, one string per test case, in the same order as test_inputs."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["program_path", "test_inputs", "expected_outputs"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+
+def _clip(text: str) -> str:
+    if len(text) > MAX_SHOW:
+        return text[:MAX_SHOW] + "\n<output clipped>"
+    return text
+
+
+def tool_function(program_path: str, test_inputs: list, expected_outputs: list, timeout: float = 10) -> str:
+    if not os.path.isfile(program_path):
+        return f"Error: program file does not exist: {program_path}"
+    if len(test_inputs) != len(expected_outputs):
+        return (f"Error: test_inputs has {len(test_inputs)} entries but expected_outputs has "
+                f"{len(expected_outputs)} entries; they must match.")
+    if timeout is None:
+        timeout = 10
+
+    results = []
+    passed = 0
+    for idx, (inp, expected) in enumerate(zip(test_inputs, expected_outputs), start=1):
+        header = f"Test case {idx}/{len(test_inputs)}"
+        try:
+            proc = subprocess.run(
+                [sys.executable, program_path],
+                input=inp if inp is not None else "",
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            results.append(f"{header}: FAIL (timed out after {timeout} seconds)\n"
+                           f"Input:\n{_clip(inp)}")
+            continue
+        except Exception as e:
+            results.append(f"{header}: FAIL (error running program: {e})")
+            continue
+
+        actual = proc.stdout
+        if _normalize(actual) == _normalize(expected):
+            passed += 1
+            results.append(f"{header}: PASS")
+        else:
+            results.append(
+                f"{header}: FAIL (exit code {proc.returncode})\n"
+                f"Input:\n{_clip(inp)}\n"
+                f"Expected output:\n{_clip(expected)}\n"
+                f"Actual output:\n{_clip(actual)}\n"
+                f"Stderr:\n{_clip(proc.stderr)}"
+            )
+
+    summary = f"{passed}/{len(test_inputs)} test cases passed."
+    return summary + "\n\n" + "\n\n".join(results)
