+MAX_TOOL_RESULT_CHARS = 8000   # max characters kept from a single tool result
+KEEP_RECENT_TURNS = 6          # number of most recent messages left uncompacted
+MAX_OLD_TOOL_RESULT_CHARS = 500  # max characters kept from older tool results
+
+def truncate_text(text, max_chars):
+    """
+    Keep the head and tail of a text that exceeds max_chars, dropping the middle.
+    Returns the text unchanged if it already fits.
+    """
+    text = str(text)
+    if len(text) <= max_chars:
+        return text
+    marker = f"\n... [truncated {len(text) - max_chars} characters] ...\n"
+    head_len = max_chars // 2
+    tail_len = max_chars - head_len
+    return text[:head_len] + marker + text[len(text) - tail_len:]
+
+def truncate_tool_result(result, max_chars=MAX_TOOL_RESULT_CHARS):
+    """Cap the size of a single tool result before it is sent back to the model."""
+    return truncate_text(result, max_chars)
+
 def process_tool_call(tools_dict, tool_name, tool_input):
     try:
         if tool_name in tools_dict:
-            return tools_dict[tool_name]['function'](**tool_input)
+            result = tools_dict[tool_name]['function'](**tool_input)
+            return truncate_tool_result(result)
         else:
             return f"Error: Tool '{tool_name}' not found"
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
 
+def _compact_tool_result_item(item, max_chars):
+    """Shorten the result payload of one tool_result (Claude) or function_call_output (OpenAI) item."""
+    if not isinstance(item, dict):
+        return item
+    if item.get('type') == 'tool_result' and isinstance(item.get('content'), str):
+        return {**item, 'content': truncate_text(item['content'], max_chars)}
+    if item.get('type') == 'function_call_output' and isinstance(item.get('output'), str):
+        return {**item, 'output': truncate_text(item['output'], max_chars)}
+    return item
+
+def compact_old_messages(messages, keep_recent=KEEP_RECENT_TURNS, max_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Return a new message list where tool results in older turns are truncated.
+    The most recent `keep_recent` messages are kept intact. The input list is not mutated.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = [_compact_tool_result_item(item, max_chars) for item in content]
+            compacted.append({**msg, 'content': new_content})
+        else:
+            compacted.append(_compact_tool_result_item(msg, max_chars))
+    return compacted
+
