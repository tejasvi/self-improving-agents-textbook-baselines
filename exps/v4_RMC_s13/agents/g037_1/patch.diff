@@ -0,0 +1,125 @@
+import os
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python program on given test inputs and compare its standard output with the expected outputs.\n
+* Each test case provides an 'input' string that is fed to the program's standard input, and an 'expected_output' string.
+* Outputs are compared after stripping trailing whitespace from each line and leading/trailing blank lines.
+* For every test case the tool reports PASS or FAIL. For failures it shows the actual output, the expected output, and any stderr / exit status so you can analyze them.
+* Use this to check a solution against the sample tests from the problem statement and your own additional tests (e.g. edge cases, small brute-force comparisons).
+* The solution file is executed with the python3 interpreter, with the working directory set to the directory containing the file.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (a complete program reading stdin and writing stdout)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with 'input' and 'expected_output' string fields.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's standard input."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected text the program writes to standard output."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Time limit in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+
+def _normalize(text: str) -> str:
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def _run_one(solution_path: str, cwd: str, test_input: str, timeout: float):
+    try:
+        proc = subprocess.run(
+            [sys.executable, os.path.basename(solution_path)],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        return None, out, f"Timed out after {timeout} seconds", None
+    return proc.returncode, proc.stdout, proc.stderr, None
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = 10) -> str:
+    if not isinstance(test_cases, list) or len(test_cases) == 0:
+        return "Error: 'test_cases' must be a non-empty list of objects with 'input' and 'expected_output'."
+    if timeout is None:
+        timeout = 10
+
+    abs_path = os.path.abspath(solution_path)
+    if not os.path.isfile(abs_path):
+        return f"Error: solution file not found: {solution_path}"
+    cwd = os.path.dirname(abs_path)
+
+    passed = 0
+    report = []
+    for idx, case in enumerate(test_cases, start=1):
+        if not isinstance(case, dict) or "input" not in case or "expected_output" not in case:
+            report.append(f"Test {idx}: FAIL (malformed test case; each needs 'input' and 'expected_output')")
+            continue
+        test_input = str(case["input"])
+        expected = str(case["expected_output"])
+
+        returncode, stdout, stderr, _ = _run_one(abs_path, cwd, test_input, float(timeout))
+        if returncode is None:
+            report.append(f"Test {idx}: FAIL\n{stderr}\nPartial stdout:\n{stdout}")
+            continue
+
+        if returncode == 0 and _normalize(stdout) == _normalize(expected):
+            passed += 1
+            report.append(f"Test {idx}: PASS")
+            continue
+
+        block = [f"Test {idx}: FAIL"]
+        if returncode != 0:
+            block.append(f"Exit status: {returncode}")
+        block.append(f"--- input ---\n{test_input}")
+        block.append(f"--- expected output ---\n{expected}")
+        block.append(f"--- actual output ---\n{stdout}")
+        if stderr.strip():
+            block.append(f"--- stderr ---\n{stderr}")
+        report.append("\n".join(block))
+
+    total = len(test_cases)
+    summary = f"Summary: {passed}/{total} tests passed."
+    return summary + "\n\n" + "\n\n".join(report)
+
+
+if __name__ == "__main__":
+    import json
+    if len(sys.argv) != 3:
+        print("Usage: python run_tests.py <solution_path> '<json list of {input, expected_output}>'")
+    else:
+        print(tool_function(sys.argv[1], json.loads(sys.argv[2])))
