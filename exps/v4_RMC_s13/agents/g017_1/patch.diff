+    def _chat_with_retry(self, msg, msg_history):
+        """
+        Run one conversation turn. If it raises, retry it exactly once from the
+        last good state (the message history passed in, which is not mutated).
+        If the retry also fails, the exception propagates.
+        """
+        try:
+            return chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        except Exception as e:
+            safe_log(f"Conversation turn raised {type(e).__name__}: {e}. Retrying once from the last good state.")
