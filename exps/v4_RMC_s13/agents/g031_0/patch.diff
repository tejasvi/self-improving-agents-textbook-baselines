+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of long output, marking the omitted middle."""
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return (
+        text[:half]
+        + f"\n<response clipped: {omitted} characters omitted>\n"
+        + text[-half:]
+    )
