+# Transient API failures worth retrying with backoff.
+TRANSIENT_STATUS_CODES = {408, 409, 429}
+
+
+def is_transient_api_error(e: Exception) -> bool:
+    """Return True if the exception is a transient API failure (rate limit, timeout,
+    connection problem, 5xx server error, or 408/409/429 status) that should be retried."""
+    transient_types = (
+        openai.RateLimitError,
+        openai.APITimeoutError,
+        openai.APIConnectionError,
+        openai.InternalServerError,
+        anthropic.RateLimitError,
+        anthropic.APITimeoutError,
+        anthropic.APIConnectionError,
+        anthropic.InternalServerError,
+    )
+    if isinstance(e, transient_types):
+        return True
+    if isinstance(e, (openai.APIStatusError, anthropic.APIStatusError)):
+        code = getattr(e, "status_code", None)
+        return code is not None and (code in TRANSIENT_STATUS_CODES or code >= 500)
+    return False
+
+
+def api_retry(max_tries=6, max_time=300):
+    """Decorator: retry transient API errors with exponential backoff and jitter.
+    Non-transient errors (e.g. bad request, auth, unsupported model) are raised immediately."""
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        giveup=lambda e: not is_transient_api_error(e),
+        max_tries=max_tries,
+        max_time=max_time,
+        max_value=60,
+    )
+
