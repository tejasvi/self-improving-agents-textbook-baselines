+# Retry policy for model API calls. Only transient failures are retried
+# (connection problems, timeouts, rate limits, overload and 5xx responses);
+# permanent errors such as bad requests or auth failures fail immediately.
+TRANSIENT_STATUS_CODES = {408, 409, 429, 500, 502, 503, 504, 529}
+RETRY_MAX_TRIES = 6
+RETRY_MAX_TIME = 600  # seconds
+RETRY_MAX_VALUE = 60  # cap on a single backoff sleep, in seconds
+
+
+def is_transient_llm_error(e: Exception) -> bool:
+    """Return True if the exception from an LLM API call is worth retrying."""
+    if isinstance(e, (
+        openai.APIConnectionError,  # includes openai.APITimeoutError
+        openai.RateLimitError,
+        openai.InternalServerError,
+        anthropic.APIConnectionError,  # includes anthropic.APITimeoutError
+        anthropic.RateLimitError,
+        anthropic.InternalServerError,
+    )):
+        return True
+    status = getattr(e, "status_code", None)
+    return isinstance(status, int) and status in TRANSIENT_STATUS_CODES
+
+
+def llm_retry(func):
+    """Decorator: retry transient LLM API errors with exponential backoff."""
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        giveup=lambda e: not is_transient_llm_error(e),
+        max_tries=RETRY_MAX_TRIES,
+        max_time=RETRY_MAX_TIME,
+        max_value=RETRY_MAX_VALUE,
+        on_backoff=lambda d: print(
+            f"Transient LLM API error, retry #{d['tries']} in {d['wait']:.1f}s: {d['exception']}"
+        ),
+    )(func)
+
