+def extract_examples(problem_statement, model=CLAUDE_MODEL):
+    """
+    Ask an LLM to extract the stdin/stdout examples from the problem statement.
+    Returns a list of {"input": str, "output": str} dicts (possibly empty).
+    """
+    prompt = (
+        "Extract the example test cases from the problem statement below. "
+        "Return ONLY a JSON object inside a ```json code block of the form "
+        '{"examples": [{"input": "<exact stdin text>", "output": "<exact expected stdout text>"}]}. '
+        "Do not include any other text.\n\n"
+        f"<problem_statement>\n{problem_statement}\n</problem_statement>"
+    )
+    try:
+        client, client_model = create_client(model)
+        content, _ = get_response_from_llm(
+            prompt, client=client, model=client_model,
+            system_message="You extract structured test examples from programming problems.",
+            temperature=0.0,
+        )
+        match = re.search(r"```json\s*(.*?)```", content, re.DOTALL)
+        data = json.loads(match.group(1) if match else content)
+        examples = []
+        for ex in data.get("examples", []):
+            examples.append({"input": str(ex["input"]), "output": str(ex["output"])})
+        return examples
+    except Exception as e:
+        safe_log(f"Could not extract examples from problem statement: {e}")
+        return []
+
+def get_changed_python_files(git_dir, base_commit):
+    """
+    Return the .py files that differ from base_commit (modified or untracked), relative to git_dir.
+    """
+    tracked = subprocess.run(
+        ["git", "-C", git_dir, "diff", "--name-only", base_commit],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, text=True,
+    ).stdout.splitlines()
+    untracked = subprocess.run(
+        ["git", "-C", git_dir, "ls-files", "--others", "--exclude-standard"],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, text=True,
+    ).stdout.splitlines()
+    files = []
+    for f in tracked + untracked:
+        if f.endswith(".py") and f not in files and os.path.isfile(os.path.join(git_dir, f)):
+            files.append(f)
+    return files
+
+def score_attempt(git_dir, base_commit, examples):
+    """
+    Run each changed .py file on every example. Returns (passed_count, total) for the best candidate file.
+    """
+    if not examples:
+        return 0, 0
+    best = 0
+    for f in get_changed_python_files(git_dir, base_commit):
+        passed = 0
+        for ex in examples:
+            try:
+                result = subprocess.run(
+                    [sys.executable, f], input=ex["input"], cwd=git_dir,
+                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+                    timeout=EXAMPLE_RUN_TIMEOUT, check=False,
+                )
+                if result.stdout.split() == ex["output"].split():
+                    passed += 1
+            except subprocess.TimeoutExpired:
+                pass
+        best = max(best, passed)
+    return best, len(examples)
+
