+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    """Cut text to max_chars and add a marker when it was longer."""
+    if len(text) > max_chars:
+        return text[:max_chars] + "\n<response clipped>"
+    return text
+
+def run_command(command, timeout=COMMAND_TIMEOUT_SECONDS):
+    """Run one command in a non-interactive bash with stdin closed.
+
+    Each call is a fresh bash process. Stdout and stderr go to temporary files,
+    so background jobs started with '&' cannot keep the call waiting.
+    Returns (stdout, stderr) as strings, or raises TimeoutError.
+    """
+    with tempfile.TemporaryFile() as out_file, tempfile.TemporaryFile() as err_file:
+        proc = subprocess.Popen(
+            ["/bin/bash", "-c", command],
+            stdin=subprocess.DEVNULL,
+            stdout=out_file,
+            stderr=err_file,
+            start_new_session=True,  # own process group, so the whole tree can be killed
+            env=os.environ.copy(),
+        )
+        try:
+            proc.wait(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+            proc.wait()
+            raise TimeoutError(
+                f"Command timed out after {timeout} seconds and was killed."
+            )
+        out_file.seek(0)
+        err_file.seek(0)
+        stdout = out_file.read().decode(errors="replace")
+        stderr = err_file.read().decode(errors="replace")
+    return stdout, stderr
