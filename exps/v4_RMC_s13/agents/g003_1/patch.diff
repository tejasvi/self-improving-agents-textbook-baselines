+# Retry policy for model API calls.
+# Only transient failures (network errors, timeouts, rate limits, 408/409/425/429 and 5xx)
+# are retried; permanent errors such as 400/401/403/404 are raised immediately.
+RETRY_MAX_TIME = 300  # seconds of total retry budget per call
+RETRY_MAX_VALUE = 60  # cap for a single backoff sleep, in seconds
+TRANSIENT_STATUS_CODES = {408, 409, 425, 429}
+TRANSIENT_ERROR_TYPES = (
+    openai.APIConnectionError,  # includes openai.APITimeoutError
+    openai.RateLimitError,
+    openai.InternalServerError,
+    anthropic.APIConnectionError,  # includes anthropic.APITimeoutError
+    anthropic.RateLimitError,
+    anthropic.InternalServerError,
+)
+
+
+def is_transient_error(e):
+    """Return True if the exception is a transient API failure that is worth retrying."""
+    if isinstance(e, TRANSIENT_ERROR_TYPES):
+        return True
+    if isinstance(e, (openai.APIStatusError, anthropic.APIStatusError)):
+        status = getattr(e, "status_code", None)
+        return status is not None and (status in TRANSIENT_STATUS_CODES or status >= 500)
+    return False
+
+
+def _log_retry(details):
+    print(
+        f"Transient LLM API error (attempt {details['tries']}), retrying in {details['wait']:.1f}s: "
+        f"{details['exception']}"
+    )
+
+
+def retry_on_transient_error(func):
+    """Decorator: retry a model API call with exponential backoff on transient errors only."""
+    return backoff.on_exception(
+        backoff.expo,
+        Exception,
+        giveup=lambda e: not is_transient_error(e),
+        on_backoff=_log_retry,
+        max_time=RETRY_MAX_TIME,
+        max_value=RETRY_MAX_VALUE,
+    )(func)
+
+
