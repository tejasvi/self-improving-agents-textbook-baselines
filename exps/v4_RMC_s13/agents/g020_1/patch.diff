+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    """Keep the head and tail of text if it exceeds max_chars."""
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return f"{text[:half]}\n... [{omitted} characters truncated] ...\n{text[-half:]}"
 
