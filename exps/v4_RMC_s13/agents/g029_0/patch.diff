diff --git a/tools/run_io_tests.py b/tools/run_io_tests.py
new file mode 100644
index 0000000..9818474
--- /dev/null
+++ b/tools/run_io_tests.py
@@ -0,0 +1,128 @@
+import os
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "run_io_tests",
+        "description": """Run a Python program on given stdin inputs and compare its stdout with expected outputs.
+
+* Each test case provides an 'input' (text fed to the program's stdin) and an 'expected_output' (text the program should print to stdout).
+* Output comparison ignores trailing whitespace on each line and trailing blank lines.
+* The tool reports PASS/FAIL for every test case, showing input, expected output, actual output and stderr for failures, plus a summary.
+* A test case that exceeds the timeout is reported as a failure.
+* Use this tool to check a complete program against the examples in the problem statement, or against extra cases you create (keep any files you create outside the repository).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed with the current Python interpreter).",
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each item is an object with 'input' and 'expected_output' string fields.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact text to feed to the program's stdin.",
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The exact text the program should print to stdout.",
+                            },
+                        },
+                        "required": ["input", "expected_output"],
+                    },
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-test-case time limit in seconds. If omitted, 10 seconds is used.",
+                },
+            },
+            "required": ["solution_path", "test_cases"],
+        },
+    }
+
+
+def normalize_output(text):
+    """Strip trailing whitespace on each line and drop leading/trailing blank lines."""
+    lines = [line.rstrip() for line in (text or "").strip().splitlines()]
+    return "\n".join(lines).strip("\n")
+
+
+def outputs_match(actual, expected):
+    """Return True if the normalized actual output equals the normalized expected output."""
+    return normalize_output(actual) == normalize_output(expected)
+
+
+def run_program_on_input(solution_path, input_text, timeout):
+    """
+    Run `python solution_path` with input_text on stdin.
+    Returns (stdout, stderr, returncode). On timeout returns (stdout, stderr, None)
+    with a note appended to stderr.
+    """
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err + f"\nTimed out after {timeout} seconds.", None
+
+
+def format_case_report(index, input_text, expected, actual, stderr, returncode, passed):
+    """Build the report text for one test case."""
+    if passed:
+        return f"Test {index}: PASS"
+    parts = [
+        f"Test {index}: FAIL",
+        f"--- input ---\n{input_text}",
+        f"--- expected output ---\n{expected}",
+        f"--- actual output ---\n{actual}",
+    ]
+    if stderr:
+        parts.append(f"--- stderr ---\n{stderr}")
+    if returncode is None:
+        parts.append("(program timed out)")
+    elif returncode != 0:
+        parts.append(f"(program exited with code {returncode})")
+    return "\n".join(parts)
+
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = 10) -> str:
+    """Run the program on each test case and report PASS/FAIL per case."""
+    try:
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if not isinstance(test_cases, list) or not test_cases:
+            return "Error: test_cases must be a non-empty list of objects with 'input' and 'expected_output'."
+
+        reports = []
+        passed_count = 0
+        for index, case in enumerate(test_cases, start=1):
+            input_text = case.get("input", "")
+            expected = case.get("expected_output", "")
+            actual, stderr, returncode = run_program_on_input(solution_path, input_text, timeout)
+            passed = returncode == 0 and outputs_match(actual, expected)
+            passed_count += int(passed)
+            reports.append(format_case_report(index, input_text, expected, actual, stderr, returncode, passed))
+
+        summary = f"{passed_count}/{len(test_cases)} test cases passed."
+        return "\n\n".join(reports + [summary])
+    except Exception as e:
+        return f"Error running tests: {e}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_function("/dev/null", []))
