+++ b/tools/stress_test.py
@@ -0,0 +1,128 @@
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress test of a solution against a brute-force reference.
+
+* For each seed from seed_start to seed_start+num_tests-1, runs `python3 <generator_path> <seed>` to produce one test input on stdout.
+* Runs `python3 <solution_path>` and `python3 <brute_path>` on that input (stdin = input), each with a timeout.
+* Compares the outputs token by token (whitespace-insensitive).
+* Stops at the first mismatch, crash, or timeout and returns the raw seed, input, expected output, actual output and stderr.
+* If all tests pass, returns a success message with the number of tests and the maximum solution runtime.
+* Both programs must be stdin/stdout programs. Use absolute paths for the files.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (a stdin/stdout Python script), e.g. /repo/solution.py.",
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference program (a stdin/stdout Python script), e.g. /repo/brute.py.",
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator. It is called as `python3 <generator_path> <seed>` and must print one test input to stdout.",
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test (default 200).",
+                },
+                "timeout_per_test": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each program run on one test (default 5).",
+                },
+                "seed_start": {
+                    "type": "integer",
+                    "description": "First seed value passed to the generator (default 0).",
+                },
+            },
+            "required": ["solution_path", "brute_path", "generator_path"],
+        },
+    }
+
+
+def _clip(s, n=3000):
+    if s is None:
+        return ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(path, inp, timeout):
+    """Run `python3 path` with inp on stdin. Returns (status, stdout, stderr, elapsed)."""
+    start = time.time()
+    try:
+        p = subprocess.run(
+            ["python3", path],
+            input=inp,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            errors="replace",
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return "timeout", out, err, time.time() - start
+    elapsed = time.time() - start
+    status = "ok" if p.returncode == 0 else f"exit code {p.returncode}"
+    return status, p.stdout, p.stderr, elapsed
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, timeout_per_test=5, seed_start=0):
+    num_tests = int(num_tests if num_tests is not None else 200)
+    timeout_per_test = int(timeout_per_test if timeout_per_test is not None else 5)
+    seed_start = int(seed_start if seed_start is not None else 0)
+    max_time = 0.0
+    tests_run = 0
+
+    for i in range(num_tests):
+        seed = seed_start + i
+        try:
+            gen = subprocess.run(
+                ["python3", generator_path, str(seed)],
+                capture_output=True,
+                text=True,
+                timeout=timeout_per_test,
+                errors="replace",
+            )
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out at seed {seed} (timeout {timeout_per_test}s)."
+        if gen.returncode != 0:
+            return (
+                f"Generator failed at seed {seed} with exit code {gen.returncode}.\n"
+                f"stderr:\n{_clip(gen.stderr)}"
+            )
+        inp = gen.stdout
+
+        exp_status, exp_out, exp_err, _ = _run(brute_path, inp, timeout_per_test)
+        act_status, act_out, act_err, act_time = _run(solution_path, inp, timeout_per_test)
+        tests_run += 1
+        max_time = max(max_time, act_time)
+
+        report = None
+        if exp_status != "ok":
+            report = f"Brute-force reference {exp_status} at seed {seed}."
+        elif act_status != "ok":
+            report = f"Solution {act_status} at seed {seed}."
+        elif exp_out.split() != act_out.split():
+            report = f"Output mismatch at seed {seed}."
+
+        if report is not None:
+            return (
+                f"{report}\n"
+                f"seed: {seed}\n"
+                f"input:\n{_clip(inp)}\n"
+                f"expected output (brute):\n{_clip(exp_out)}\n"
+                f"actual output (solution):\n{_clip(act_out)}\n"
+                f"solution stderr:\n{_clip(act_err)}\n"
+                f"brute stderr:\n{_clip(exp_err)}"
+            )
+
+    return f"All {tests_run} tests passed. Max solution runtime: {max_time:.3f}s"
