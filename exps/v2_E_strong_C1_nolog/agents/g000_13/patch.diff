index 0000000..1e1fd98
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,161 @@
+import subprocess
+import sys
+import time
+
+MAX_SHOW = 2000  # max characters shown for input / outputs / stderr
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference using a random input generator.
+
+* The generator must be a Python script. It is run as `python3 generator_path <seed>` where the seed is the integer passed as argv[1]; it must print exactly one test input to stdout. Use the seed with `random.seed(int(sys.argv[1]))` so that runs are reproducible.
+* Optional size control for shrinking: the generator MAY accept a second argument `python3 generator_path <seed> <size>` where <size> is an upper bound on the test size (e.g. n <= size). If it does, the tool will try smaller sizes with the failing seed to find a smaller counterexample. If the generator ignores or rejects the extra argument, shrinking is simply skipped.
+* For each seed 0..num_tests-1 the tool feeds the generated input to solution_path and brute_path (each run as `python3 <path>` with the input on stdin, with timeout_per_test seconds each), and compares stdout token by token (split on whitespace), so formatting differences in whitespace do not matter.
+* On the first mismatch, runtime error (non-zero exit code) or timeout, it stops and reports the seed, the (possibly shrunk) failing input, both outputs and stderr.
+* If all tests pass it reports 'All N tests passed' together with the maximum wall-clock time the solution took on a single test.
+* mode: 'stdin' (default) runs the programs as complete stdin/stdout programs. 'function' is the same protocol and is used when the programs are driver scripts that read the test from stdin and print the answer to stdout.
+* Write the brute force so it is obviously correct, and keep generated inputs small enough for the brute force to be fast.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the efficient solution Python file (e.g. /abs/path/solution.py)."},
+                "brute_path": {"type": "string", "description": "Path to the simple, obviously correct brute-force Python file."},
+                "generator_path": {"type": "string", "description": "Path to the random input generator script. It takes the seed as argv[1] and prints one test input to stdout."},
+                "num_tests": {"type": "integer", "description": "Number of random tests to run (seeds 0..num_tests-1). Default 200."},
+                "timeout_per_test": {"type": "number", "description": "Timeout in seconds for each program run on each test. Default 5."},
+                "mode": {"type": "string", "enum": ["stdin", "function"], "description": "Optional. 'stdin' (default) for stdin/stdout programs, 'function' for driver scripts that read stdin and print output."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_SHOW):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(path, inp, timeout):
+    """Run `python3 path` with inp on stdin. Returns (status, stdout, stderr, elapsed)
+    where status is 'ok', 'error' or 'timeout'."""
+    start = time.perf_counter()
+    try:
+        p = subprocess.run([sys.executable, path], input=inp, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return 'timeout', out, err, time.perf_counter() - start
+    elapsed = time.perf_counter() - start
+    status = 'ok' if p.returncode == 0 else 'error'
+    return status, p.stdout, p.stderr, elapsed
+
+
+def _gen(generator_path, seed, size=None):
+    args = [sys.executable, generator_path, str(seed)]
+    if size is not None:
+        args.append(str(size))
+    try:
+        p = subprocess.run(args, capture_output=True, text=True, timeout=20, errors='replace')
+    except subprocess.TimeoutExpired:
+        return None
+    if p.returncode != 0 or not p.stdout.strip():
+        return None
+    return p.stdout
+
+
+def _same(a, b):
+    return a.split() == b.split()
+
+
+def _check(solution_path, brute_path, inp, timeout):
+    """Returns (ok, info dict, elapsed)."""
+    s_status, s_out, s_err, s_time = _run(solution_path, inp, timeout)
+    b_status, b_out, b_err, _ = _run(brute_path, inp, max(timeout * 4, 20))
+    if b_status != 'ok':
+        # The brute force itself failed; this is a problem with the reference, not the solution.
+        return False, {'kind': 'brute_failed', 'sol_out': s_out, 'sol_err': s_err,
+                       'brute_out': b_out, 'brute_err': b_err}, s_time
+    if s_status == 'timeout':
+        return False, {'kind': 'timeout', 'sol_out': s_out, 'sol_err': s_err,
+                       'brute_out': b_out, 'brute_err': b_err}, s_time
+    if s_status == 'error':
+        return False, {'kind': 'runtime_error', 'sol_out': s_out, 'sol_err': s_err,
+                       'brute_out': b_out, 'brute_err': b_err}, s_time
+    if not _same(s_out, b_out):
+        return False, {'kind': 'mismatch', 'sol_out': s_out, 'sol_err': s_err,
+                       'brute_out': b_out, 'brute_err': b_err}, s_time
+    return True, None, s_time
+
+
+def _format_failure(seed, inp, info, shrunk):
+    parts = [f"FAILED on seed {seed} ({info['kind']}){' [shrunk input]' if shrunk else ''}."]
+    if info['kind'] == 'mismatch':
+        parts.append("Solution output differs from brute force output (compared token by token).")
+    elif info['kind'] == 'timeout':
+        parts.append("Solution timed out.")
+    elif info['kind'] == 'runtime_error':
+        parts.append("Solution exited with a non-zero status.")
+    elif info['kind'] == 'brute_failed':
+        parts.append("The BRUTE FORCE failed; check the brute force or the generator, not the solution.")
+    parts.append(f"--- input ---\n{_clip(inp)}")
+    parts.append(f"--- solution stdout ---\n{_clip(info['sol_out'])}")
+    parts.append(f"--- brute stdout ---\n{_clip(info['brute_out'])}")
+    parts.append(f"--- solution stderr ---\n{_clip(info['sol_err'])}")
+    if info['kind'] == 'brute_failed':
+        parts.append(f"--- brute stderr ---\n{_clip(info['brute_err'])}")
+    return "\n".join(parts)
+
+
+def _shrink(solution_path, brute_path, generator_path, seed, timeout):
+    """Try smaller sizes with the same seed. Returns (inp, info) for the smallest failing
+    input found, or None if the generator does not accept a size argument or no smaller
+    failure was found. Bounded to a fixed list of sizes."""
+    best = None
+    for size in (1, 2, 3, 5, 8, 12, 20):
+        inp = _gen(generator_path, seed, size)
+        if inp is None:
+            # generator does not support a size argument (or produced nothing)
+            if best is None and size == 1:
+                return None
+            continue
+        ok, info, _ = _check(solution_path, brute_path, inp, timeout)
+        if not ok and info['kind'] != 'brute_failed':
+            if best is None or len(inp) < len(best[0]):
+                best = (inp, info)
+            break  # smallest sizes tried first; first failure is the smallest
+    return best
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, timeout_per_test=5, mode='stdin'):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 200
+        timeout = float(timeout_per_test) if timeout_per_test is not None else 5.0
+    except (TypeError, ValueError):
+        return "Error: num_tests must be an integer and timeout_per_test a number."
+    num_tests = max(1, min(num_tests, 100000))
+    timeout = max(0.1, min(timeout, 60.0))
+    if mode not in (None, 'stdin', 'function'):
+        return "Error: mode must be 'stdin' or 'function'."
+
+    max_time = 0.0
+    for seed in range(num_tests):
+        inp = _gen(generator_path, seed)
+        if inp is None:
+            return (f"Error: generator failed on seed {seed}. The generator must be run as "
+                    f"`python3 {generator_path} <seed>` and print one test to stdout.")
+        ok, info, elapsed = _check(solution_path, brute_path, inp, timeout)
+        if not ok:
+            if info['kind'] != 'brute_failed':
+                shrunk = _shrink(solution_path, brute_path, generator_path, seed, timeout)
+                if shrunk is not None:
+                    s_inp, s_info = shrunk
+                    return _format_failure(seed, s_inp, s_info, shrunk=True)
+            return _format_failure(seed, inp, info, shrunk=False)
+        max_time = max(max_time, elapsed)
+
+    return f"All {num_tests} tests passed. Max solution runtime on a single test: {max_time:.3f}s."
