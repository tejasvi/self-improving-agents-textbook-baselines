+def read_verdict(verdict_file):
+    """Return 'PASS', 'FAIL', or None if the reviewer did not write a clear verdict on its last line."""
+    try:
+        with open(verdict_file) as f:
+            lines = [l.strip().upper() for l in f.read().splitlines() if l.strip()]
+    except OSError:
+        return None
+    if not lines:
+        return None
+    last = lines[-1]
+    if last in ('VERDICT: PASS', 'PASS'):
+        return 'PASS'
+    if last in ('VERDICT: FAIL', 'FAIL'):
+        return 'FAIL'
+    return None
+
+PLAN_PROMPT = """PHASE 1 (PLAN). Do NOT write any solution code in this phase.
+1. Restate the problem in your own words, including the input/output format (or the method signature for a `Solution` class task).
+2. List the constraints and the intended algorithm with its time and space complexity. Check that it fits the limits in Python (roughly 10^7 simple operations per second).
+3. List the edge cases you plan to test (minimal sizes, equal values, extremes of the value ranges, degenerate structures).
+4. Save all of this to `{git_tempdir}/notes.md` with the editor tool.
+Keep this phase brief: spend at most a few tool calls. Do not spend more effort than needed to write the notes."""
+
+IMPLEMENT_PROMPT = """PHASE 2 (IMPLEMENT). Write the solution in `{git_tempdir}/solution.py` following the plan in notes.md.
+- For a stdin/stdout program, read from standard input and write to standard output.
+- For a `Solution` class task, put `from typing import *` at the top of solution.py and implement the required method.
+- Run solution.py on every sample from the statement and compare the output with the expected output exactly. For a `Solution` class, write a small driver script that calls the method on the sample arguments.
+- Fix any mismatch before moving on. Keep this phase to a bounded effort (a few fix attempts at most). Make sure solution.py is in a working, runnable state when you finish."""
+
+STRESS_PROMPT = """PHASE 3 (STRESS TEST). Verify solution.py against a brute force.
+1. Write `{git_tempdir}/brute.py`: a simple, obviously correct brute-force solution (same I/O format as solution.py).
+2. Write `{git_tempdir}/gen.py`: a random generator of small valid inputs that respects the constraints, and includes the planned edge cases from notes.md.
+3. Write a comparison script that runs solution.py and brute.py on several hundred random small cases plus the planned edge cases, and reports the first mismatch with its input.
+4. Run it. Fix every mismatch in solution.py (decide whether the bug is in solution.py or in brute.py by reasoning about the statement).
+Bound your effort: at most a few fix iterations. Always leave solution.py in a working state that passes the samples."""
+
+PERF_PROMPT = """PHASE 4 (PERFORMANCE). Check the running time of solution.py on worst-case inputs.
+1. Generate a maximum-size valid input, including adversarial structures (e.g. all equal values, sorted or reverse-sorted input, deep chains, maximal answers) as appropriate for the problem.
+2. Time `python3 solution.py < input.txt` on each of them (for a `Solution` class, time the driver calling the method).
+3. The run must be well within 2 seconds. If it is not, optimize the algorithm or the implementation, then re-run the stress comparison from phase 3 to confirm the results are still correct.
+Bound your effort: a few optimization attempts at most. Keep solution.py working at all times."""
+
+REVIEW_PROMPT = """You are an independent, skeptical reviewer. You have not seen any previous work on this task.
+1. Read the problem statement above, then read `{git_tempdir}/notes.md` and `{git_tempdir}/solution.py` from disk.
+2. Try to construct counterexamples: think about edge cases and boundary constraints, and run solution.py on them. Compare with a brute force if one exists (`brute.py`, `gen.py` in the repo).
+3. Check the I/O format against the statement (or the method signature for a `Solution` class task, including `from typing import *`).
+4. Re-run the sample tests and a quick timing check on a maximum-size input.
+Bound your effort: a few checks, not an exhaustive search.
+When you are done, write `{git_tempdir}/review_verdict.txt` containing either a list of the concrete problems found (if any) followed by a final line exactly `VERDICT: FAIL`, or a short summary followed by a final line exactly `VERDICT: PASS`. End your final message with the same line."""
+
+FIX_PROMPT = """The review found problems (see the reviewer's findings above). Fix them in `{git_tempdir}/solution.py`, re-run the samples and the relevant checks, and make sure solution.py is left in a working state. Bound your effort to a few attempts. Then stop; a fresh review will follow."""
