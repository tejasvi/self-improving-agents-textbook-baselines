@@ -0,0 +1,66 @@
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress test a solution program against a brute-force program on random small inputs.\n
+* The generator is run as `python3 <generator_path> <seed>` for seeds 0..num_cases-1 and must print one test input to stdout.\n
+* The same input is fed to both `solution_path` and `brute_path` (both run as `python3 <file>` with the input on stdin).\n
+* Outputs are compared after stripping trailing whitespace on each line and the ends of the output.\n
+* Returns "All N cases passed" or the first failing input together with both outputs, or a crash/timeout report.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file to test."},
+                "brute_path": {"type": "string", "description": "Path to the brute-force reference Python file."},
+                "generator_path": {"type": "string", "description": "Path to the random input generator Python file; it receives the seed as its only argument."},
+                "num_cases": {"type": "integer", "description": "Number of random cases to run (seeds 0..num_cases-1). Default 300."},
+                "timeout": {"type": "number", "description": "Per-run time limit in seconds for each program. Default 10."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _norm(s):
+    return "\n".join(line.rstrip() for line in s.strip().splitlines())
+
+
+def _run(args, stdin_text, timeout):
+    try:
+        p = subprocess.run([sys.executable] + args, input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        return None, f"timeout after {timeout} seconds"
+    if p.returncode != 0:
+        return p.stdout, f"exit code {p.returncode}\nSTDERR:\n{p.stderr[-3000:]}"
+    return p.stdout, None
+
+
+def tool_function(solution_path, brute_path, generator_path, num_cases=300, timeout=10):
+    try:
+        num_cases = max(1, min(int(num_cases or 300), 5000))
+        timeout = max(0.1, min(float(timeout or 10), 60))
+    except (TypeError, ValueError) as e:
+        return f"Error: invalid numeric argument: {e}"
+
+    for seed in range(num_cases):
+        gen_out, err = _run([generator_path, str(seed)], "", timeout)
+        if err is not None:
+            return f"Generator failed on seed {seed}: {err}"
+        test_input = gen_out or ""
+
+        sol_out, err = _run([solution_path], test_input, timeout)
+        if err is not None:
+            return f"Solution crashed or timed out on seed {seed}.\nInput:\n{test_input}\nSolution: {err}"
+        brute_out, err = _run([brute_path], test_input, timeout)
+        if err is not None:
+            return f"Brute force crashed or timed out on seed {seed} (fix the brute force).\nInput:\n{test_input}\nBrute: {err}"
+
+        if _norm(sol_out) != _norm(brute_out):
+            return (f"Mismatch on seed {seed}.\nInput:\n{test_input}\n"
+                    f"Solution output:\n{sol_out.strip()}\n"
+                    f"Brute force output:\n{brute_out.strip()}")
+    return f"All {num_cases} cases passed."
