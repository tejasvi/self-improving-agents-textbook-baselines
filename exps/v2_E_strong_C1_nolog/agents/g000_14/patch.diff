@@ -0,0 +1,78 @@
+import os
+import subprocess
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run a randomized stress test comparing a solution program against a brute-force reference.\n
+* For each test i in 1..num_tests, runs `python3 generator_path <seed>` (seed = i) to produce an input on stdin-compatible text, then runs both solution_path and brute_path on that input with a per-run timeout.\n
+* Outputs are compared token-wise (whitespace-insensitive).\n
+* Returns the first failing input with both outputs, or 'all N passed'. Crashes (non-zero exit) and timeouts are reported as failures.\n
+* Paths must be absolute or relative to the current directory; all three programs are Python 3 scripts that read stdin and write stdout.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python script (reads stdin, writes stdout)."},
+                "brute_path": {"type": "string", "description": "Path to the brute-force reference Python script (reads stdin, writes stdout)."},
+                "generator_path": {"type": "string", "description": "Path to the random input generator script; it is called as `python3 generator_path <seed>` and prints one test input to stdout."},
+                "num_tests": {"type": "integer", "description": "Number of random tests to run (default 300)."},
+                "timeout": {"type": "integer", "description": "Per-run timeout in seconds for each program (default 5)."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+def _run(script, stdin_text, timeout):
+    return subprocess.run(
+        ['python3', script], input=stdin_text, capture_output=True, text=True,
+        timeout=timeout, errors='replace',
+    )
+
+def _clip(s, n=3000):
+    return s if len(s) <= n else s[:n] + f"\n... <{len(s) - n} characters clipped>"
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=300, timeout=5):
+    try:
+        num_tests = max(1, min(int(num_tests or 300), 5000))
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        timeout = max(1, min(int(timeout or 5), 60))
+    except (TypeError, ValueError):
+        timeout = 5
+    solution_path = os.path.abspath(solution_path)
+    brute_path = os.path.abspath(brute_path)
+    generator_path = os.path.abspath(generator_path)
+    for p in (solution_path, brute_path, generator_path):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+
+    gen_dir = os.path.dirname(generator_path)
+    for seed in range(1, num_tests + 1):
+        try:
+            g = subprocess.run(['python3', generator_path, str(seed)], capture_output=True,
+                               text=True, timeout=timeout, cwd=gen_dir, errors='replace')
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out on seed {seed}."
+        if g.returncode != 0:
+            return f"Generator crashed on seed {seed} (exit {g.returncode}):\n{_clip(g.stderr)}"
+        test_input = g.stdout
+
+        results = {}
+        for name, path in (('solution', solution_path), ('brute', brute_path)):
+            try:
+                r = _run(path, test_input, timeout)
+            except subprocess.TimeoutExpired:
+                return (f"FAIL (seed {seed}): {name} timed out after {timeout}s.\n"
+                        f"Input:\n{_clip(test_input)}")
+            if r.returncode != 0:
+                return (f"FAIL (seed {seed}): {name} crashed (exit {r.returncode}).\n"
+                        f"Input:\n{_clip(test_input)}\nSTDERR:\n{_clip(r.stderr)}")
+            results[name] = r.stdout
+
+        if results['solution'].split() != results['brute'].split():
+            return (f"FAIL (seed {seed}): output mismatch.\n"
+                    f"Input:\n{_clip(test_input)}\n"
+                    f"solution output:\n{_clip(results['solution'])}\n"
+                    f"brute output:\n{_clip(results['brute'])}")
+    return f"all {num_tests} passed"
