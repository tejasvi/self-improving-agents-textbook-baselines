+def _read_file(path):
+    if not os.path.isfile(path):
+        return None
+    with open(path) as f:
+        return f.read()
+
+
+def _compiles(git_dir):
+    """Return (ok, output) for `python3 -m py_compile solution.py` inside git_dir."""
+    p = subprocess.run(['python3', '-m', 'py_compile', 'solution.py'], cwd=git_dir,
+                       capture_output=True, text=True, timeout=60)
+    return p.returncode == 0, (p.stdout + p.stderr)
+
+
+def _check_solution(git_dir):
+    """
+    Verify solution.py: it must exist and compile. If stdin samples exist (sample*.in),
+    run solution.py on each with a timeout and report the raw stdout/stderr.
+    Returns (ok, raw_report). No parsing of errors is done here on purpose.
+    """
+    solution_path = os.path.join(git_dir, 'solution.py')
+    if not os.path.isfile(solution_path):
+        return False, "solution.py does not exist."
+    ok, compile_out = _compiles(git_dir)
+    if not ok:
+        return False, f"python3 -m py_compile solution.py failed:\n{compile_out}"
+    samples = sorted(f for f in os.listdir(git_dir) if f.startswith('sample') and f.endswith('.in'))
+    report = []
+    for name in samples:
+        try:
+            with open(os.path.join(git_dir, name)) as f:
+                p = subprocess.run(['python3', 'solution.py'], stdin=f, cwd=git_dir,
+                                   capture_output=True, text=True, timeout=SMOKE_TIMEOUT)
+        except subprocess.TimeoutExpired:
+            return False, f"Running solution.py on {name} timed out after {SMOKE_TIMEOUT}s."
+        if p.returncode != 0 or p.stderr.strip():
+            report.append(f"{name}: return code {p.returncode}\nstdout:\n{p.stdout}\nstderr:\n{p.stderr}")
+            continue
+        expected_path = os.path.join(git_dir, name[:-3] + '.out')
+        expected = _read_file(expected_path)
+        if expected is not None and p.stdout.rstrip() != expected.rstrip():
+            report.append(f"{name}: output differs from {os.path.basename(expected_path)}\n"
+                          f"stdout:\n{p.stdout}\nexpected:\n{expected}")
+    if report:
+        return False, "\n\n".join(report)
+    return True, f"solution.py compiles; smoke-tested {len(samples)} sample file(s)."
+
