--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,86 @@
+import os
+import subprocess
+import sys
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python program on a list of (input, expected output) test cases and report pass/fail with a diff for each failing case.\n
+* `solution_path` is the Python file to run; it is executed as `python3 <solution_path>` with the case input on stdin.
+* Output is compared after stripping trailing whitespace on each line and the end of the output.
+* Each case has its own timeout. Stdout, stderr and the return code are reported for failing cases.
+* For a `Solution` class method, write a small driver script that calls the method and prints the result, then pass the driver as `solution_path`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the Python program to test."},
+                "tests": {
+                    "type": "array",
+                    "description": "List of test cases.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Text fed to the program on stdin."},
+                            "expected": {"type": "string", "description": "Exact expected stdout (trailing whitespace is ignored)."}
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout": {"type": "integer", "description": "Time limit per test case in seconds (default 5, max 60)."}
+            },
+            "required": ["solution_path", "tests"]
+        }
+    }
+
+def _norm(s):
+    lines = [line.rstrip() for line in s.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+def _clip(s, n=2000):
+    return s if len(s) <= n else s[: n // 2] + "\n...<clipped>...\n" + s[-n // 2:]
+
+def tool_function(solution_path, tests, timeout=5):
+    timeout = max(1, min(int(timeout or 5), 60))
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not tests:
+        return "Error: no test cases given."
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    passed = 0
+    failures = []
+    for idx, case in enumerate(tests, 1):
+        inp = str(case.get("input", ""))
+        expected = str(case.get("expected", ""))
+        try:
+            p = subprocess.run([sys.executable, os.path.abspath(solution_path)], input=inp, capture_output=True,
+                               text=True, timeout=timeout, cwd=cwd, errors='replace')
+        except subprocess.TimeoutExpired:
+            failures.append(f"Case {idx}: TIMEOUT after {timeout}s\nInput:\n{_clip(inp)}")
+            continue
+        if p.returncode == 0 and _norm(p.stdout) == _norm(expected):
+            passed += 1
+            continue
+        got = _norm(p.stdout)
+        exp = _norm(expected)
+        diff = []
+        for i in range(max(len(got), len(exp))):
+            g = got[i] if i < len(got) else '<missing>'
+            e = exp[i] if i < len(exp) else '<missing>'
+            if g != e:
+                diff.append(f"line {i + 1}: expected {e!r}, got {g!r}")
+                if len(diff) >= 5:
+                    break
+        msg = f"Case {idx}: FAILED (return code {p.returncode})"
+        if diff:
+            msg += "\nDiff:\n" + "\n".join(diff)
+        msg += f"\nInput:\n{_clip(inp)}\nStdout:\n{_clip(p.stdout)}"
+        if p.stderr.strip():
+            msg += f"\nStderr:\n{_clip(p.stderr)}"
+        failures.append(msg)
+    total = len(tests)
+    summary = f"{passed}/{total} test cases passed."
+    if not failures:
+        return "PASS: " + summary
+    return "FAIL: " + summary + "\n\n" + "\n\n".join(failures[:5])
