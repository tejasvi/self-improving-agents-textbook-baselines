+    def _current_solution_text(self):
+        """Return the current contents of solution.py, falling back to the repo diff."""
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.exists(path):
+            try:
+                with open(path) as f:
+                    return f"# solution.py\n{f.read()}"
+            except OSError:
+                pass
+        return self._last_assistant_text_fallback(self.get_current_edits())
+
+    @staticmethod
+    def _last_assistant_text_fallback(history):
+        """Extract all text from a message history (used for the diff fallback)."""
+        parts = []
+        for msg in history:
+            content = msg.get('content')
+            if isinstance(content, str):
+                parts.append(content)
+            elif isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict) and 'text' in block:
+                        parts.append(str(block['text']))
+        return "\n".join(parts)
+
+    @staticmethod
+    def _last_assistant_text(history):
+        """Return the text of the last assistant message in a message history."""
+        for msg in reversed(history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = []
+                for block in content:
+                    if isinstance(block, dict) and block.get('type') == 'text' and block.get('text'):
+                        texts.append(str(block['text']))
+                    elif hasattr(block, 'text') and getattr(block, 'text'):
+                        texts.append(str(block.text))
+                if texts:
+                    return "\n".join(texts)
+        return ""
+
+    def _review_prompt(self, task, solution_text):
