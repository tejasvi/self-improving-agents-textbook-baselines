+def _last_assistant_text(msg_history):
+    """Return the text of the last assistant message in a message history ('' if none)."""
+    if not isinstance(msg_history, list):
+        return ""
+    for msg in reversed(msg_history):
+        if not isinstance(msg, dict) or msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            return " ".join(str(c.get("text", "")) for c in content if isinstance(c, dict) and c.get("type") in ("text", "output_text"))
+        return ""
+    return ""
