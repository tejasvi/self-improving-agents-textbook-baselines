index 0000000..3479e73
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,132 @@
+import os
+import subprocess
+import sys
+import time
+
+# Convention:
+# - generator_path is a script taking the seed as argv[1] and printing ONE test input to stdout.
+# - solution_path / brute_path are programs reading the input from stdin and writing the answer to stdout.
+#   For Solution-class problems, write a small wrapper script that reads the input and calls the method,
+#   then pass the wrapper as solution_path / brute_path.
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress test a solution against a brute-force reference using random inputs.
+
+* For seed in 0..num_cases-1: runs `python3 generator_path <seed>` to get an input, then runs brute_path and solution_path on that input via stdin (with a per-case timeout), and compares stdout (whitespace-normalized, token-wise).
+* Stops at the first mismatch, crash (non-zero exit), or timeout and reports the seed, the input, the expected and actual outputs, and stderr.
+* If all cases pass, reports 'All N cases passed' together with the maximum runtime observed.
+* Convention: generator_path takes the seed as argv[1] and prints one input to stdout. For Solution-class problems, write a wrapper script that reads stdin and calls the method, and pass the wrapper as solution_path/brute_path.
+* Relative paths are resolved against working_dir (default: current directory). Put helper files (generator, brute, wrapper) in a scratch directory such as /tmp.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution program (run as `python3 <path>` reading stdin)."},
+                "brute_path": {"type": "string", "description": "Path to the brute-force reference program (run as `python3 <path>` reading stdin)."},
+                "generator_path": {"type": "string", "description": "Path to the random input generator; invoked as `python3 <path> <seed>` and prints one input to stdout."},
+                "num_cases": {"type": "integer", "description": "Number of random seeds to test (default 200)."},
+                "timeout_per_case": {"type": "number", "description": "Timeout in seconds for each program run on each case (default 5)."},
+                "mode": {"type": "string", "description": "Input mode. Only 'stdin' is supported (default 'stdin')."},
+                "working_dir": {"type": "string", "description": "Directory in which relative paths are resolved and programs are run (default: current directory)."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+def _clip(s, n=2000):
+    if s is None:
+        return ''
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+def _norm_tokens(s):
+    return s.split()
+
+def _run(cmd, cwd, inp, timeout):
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, cwd=cwd, input=inp, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+        return p, time.time() - t0, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return None, time.time() - t0, (out, err)
+
+def tool_function(solution_path, brute_path, generator_path, num_cases=200, timeout_per_case=5,
+                  mode='stdin', working_dir=None):
+    cwd = working_dir or os.getcwd()
+    if not os.path.isdir(cwd):
+        return f"Error: working_dir '{cwd}' does not exist."
+    if mode not in (None, 'stdin'):
+        return f"Error: unsupported mode '{mode}'. Only 'stdin' is supported."
+    try:
+        num_cases = int(num_cases) if num_cases is not None else 200
+        num_cases = max(1, min(num_cases, 100000))
+    except (TypeError, ValueError):
+        num_cases = 200
+    try:
+        timeout_per_case = float(timeout_per_case) if timeout_per_case is not None else 5.0
+        timeout_per_case = max(0.1, min(timeout_per_case, 300.0))
+    except (TypeError, ValueError):
+        timeout_per_case = 5.0
+
+    def abs_path(p):
+        return p if os.path.isabs(p) else os.path.join(cwd, p)
+
+    gen = abs_path(generator_path)
+    sol = abs_path(solution_path)
+    brute = abs_path(brute_path)
+    for name, p in [('generator_path', gen), ('solution_path', sol), ('brute_path', brute)]:
+        if not os.path.isfile(p):
+            return f"Error: {name} '{p}' does not exist."
+
+    max_time = 0.0
+    for seed in range(num_cases):
+        # 1. generate input
+        gp, _, gerr = _run([sys.executable, gen, str(seed)], cwd, None, timeout_per_case)
+        if gerr is not None or gp.returncode != 0:
+            err = gp.stderr if gp is not None else gerr[1]
+            return (f"Generator failed at seed {seed}.\n"
+                    f"Stderr:\n{_clip(err)}")
+        inp = gp.stdout
+
+        # 2. run brute
+        bp, _, berr = _run([sys.executable, brute], cwd, inp, timeout_per_case)
+        if berr is not None:
+            return (f"Brute-force reference timed out at seed {seed}.\n"
+                    f"Input:\n{_clip(inp)}\n"
+                    f"Stderr:\n{_clip(berr[1])}")
+        if bp.returncode != 0:
+            return (f"Brute-force reference crashed at seed {seed} (exit code {bp.returncode}).\n"
+                    f"Input:\n{_clip(inp)}\n"
+                    f"Stderr:\n{_clip(bp.stderr)}")
+        expected = bp.stdout
+
+        # 3. run solution
+        sp, elapsed, serr = _run([sys.executable, sol], cwd, inp, timeout_per_case)
+        if serr is not None:
+            return (f"Solution TIMED OUT (limit {timeout_per_case}s) at seed {seed}.\n"
+                    f"Input:\n{_clip(inp)}\n"
+                    f"Expected output:\n{_clip(expected)}\n"
+                    f"Actual output (partial):\n{_clip(serr[0])}\n"
+                    f"Stderr:\n{_clip(serr[1])}")
+        max_time = max(max_time, elapsed)
+        if sp.returncode != 0:
+            return (f"Solution CRASHED at seed {seed} (exit code {sp.returncode}).\n"
+                    f"Input:\n{_clip(inp)}\n"
+                    f"Expected output:\n{_clip(expected)}\n"
+                    f"Actual output:\n{_clip(sp.stdout)}\n"
+                    f"Stderr:\n{_clip(sp.stderr)}")
+
+        # 4. compare
+        if _norm_tokens(expected) != _norm_tokens(sp.stdout):
+            return (f"WRONG ANSWER at seed {seed}.\n"
+                    f"Input:\n{_clip(inp)}\n"
+                    f"Expected output:\n{_clip(expected)}\n"
+                    f"Actual output:\n{_clip(sp.stdout)}\n"
+                    f"Stderr:\n{_clip(sp.stderr)}")
+
+    return f"All {num_cases} cases passed. Max runtime per case: {max_time:.3f}s"
