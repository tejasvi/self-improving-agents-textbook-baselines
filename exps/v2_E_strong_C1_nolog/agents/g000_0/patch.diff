@@ -0,0 +1,83 @@
+import os
+import re
+import subprocess
+import sys
+import time
+
+
+def tool_info():
+    return {
+        "name": "time_check",
+        "description": """Run a program on a (large) input file and report wall time and peak memory.\n
+* Runs `python3 <solution_path>` with the file at `input_path` piped to stdin.\n
+* Use it with a maximum-size generated input to check the solution finishes well within the time limit (usually 1-2 seconds).\n
+* Reports wall-clock seconds, peak resident memory in MB (when available), the exit code and the first lines of stdout.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python program to time (reads stdin, writes stdout)."
+                },
+                "input_path": {
+                    "type": "string",
+                    "description": "Path to the input file to pipe on stdin (e.g. a generated maximum-size test)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for the run. Default 20."
+                }
+            },
+            "required": ["solution_path", "input_path"]
+        }
+    }
+
+
+def _peak_mb_from_time_v(stderr):
+    m = re.search(r"Maximum resident set size \(kbytes\): (\d+)", stderr)
+    return int(m.group(1)) / 1024.0 if m else None
+
+
+def tool_function(solution_path, input_path, timeout=20):
+    try:
+        timeout = max(1, min(int(timeout or 20), 300))
+    except (TypeError, ValueError):
+        return "Error: timeout must be an integer."
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isfile(input_path):
+        return f"Error: input file not found: {input_path}"
+
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    use_time = os.path.exists('/usr/bin/time')
+    cmd = [sys.executable, os.path.abspath(solution_path)]
+    if use_time:
+        cmd = ['/usr/bin/time', '-v'] + cmd
+
+    with open(input_path, 'rb') as fin:
+        start = time.time()
+        try:
+            p = subprocess.run(cmd, stdin=fin, capture_output=True, timeout=timeout, cwd=cwd)
+        except subprocess.TimeoutExpired:
+            return f"TIMEOUT: solution did not finish within {timeout} seconds (wall time > {timeout}s)."
+        wall = time.time() - start
+
+    stdout = p.stdout.decode('utf-8', errors='replace')
+    stderr = p.stderr.decode('utf-8', errors='replace')
+    peak_mb = None
+    if use_time:
+        peak_mb = _peak_mb_from_time_v(stderr)
+        # Drop the verbose /usr/bin/time report from stderr; keep only the program's own stderr.
+        stderr = stderr.split('\tCommand being timed:')[0].rstrip()
+
+    head = '\n'.join(stdout.splitlines()[:10])
+    lines = [
+        f"Wall time: {wall:.3f}s",
+        f"Peak memory: {peak_mb:.1f} MB" if peak_mb is not None else "Peak memory: unknown",
+        f"Exit code: {p.returncode}",
+        "STDOUT (first 10 lines):",
+        head or "(empty)",
+    ]
+    if stderr.strip():
+        lines += ["STDERR:", stderr[-2000:].rstrip()]
+    return "\n".join(lines)
