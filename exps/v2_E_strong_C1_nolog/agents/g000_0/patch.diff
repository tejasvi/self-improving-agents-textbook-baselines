+++ b/tools/stress_test.py
@@ -0,0 +1,133 @@
+import os
+import subprocess
+import sys
+import time
+
+MAX_CLIP = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference using a random test generator.\n
+* The generator is run as `python3 <generator_path> <seed>` for seed = 0..num_tests-1 and must print ONE test input to stdout.\n
+* Each input is piped on stdin to both `solution_path` and `brute_path` (run with `python3`). Outputs are compared token-wise (whitespace-insensitive).\n
+* On the first mismatch, crash (non-zero exit) or timeout, the tool returns the failing seed, the input (clipped), both outputs and stderr. Use this counterexample to debug.\n
+* If every test passes, it returns 'ALL N TESTS PASSED' together with the maximum running time of the solution.\n
+* Only stdin-based programs are supported. For a `Solution` class, first write a stdin driver script and point solution_path at it.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python program (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python program (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the random test generator. It is run as `python3 gen.py <seed>` and prints one test input."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0..num_tests-1). Default 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each program. Default 5."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_CLIP):
+    if s is None:
+        return ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _as_text(x):
+    if x is None:
+        return ''
+    if isinstance(x, bytes):
+        return x.decode('utf-8', errors='replace')
+    return x
+
+
+def _run(path, cwd, args=(), stdin_text="", timeout=5):
+    """Run `python3 path args...` and return (returncode, stdout, stderr, elapsed, timed_out)."""
+    start = time.time()
+    try:
+        p = subprocess.run([sys.executable, path, *args], input=stdin_text, capture_output=True,
+                           text=True, timeout=timeout, cwd=cwd, errors='replace')
+        return p.returncode, p.stdout, p.stderr, time.time() - start, False
+    except subprocess.TimeoutExpired as e:
+        out = _as_text(e.stdout)
+        err = _as_text(e.stderr)
+        return None, out, err, time.time() - start, True
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, timeout=5):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 5000))
+        timeout = max(1, min(int(timeout or 5), 60))
+    except (TypeError, ValueError):
+        return "Error: num_tests and timeout must be integers."
+
+    paths = {'solution': solution_path, 'brute': brute_path, 'generator': generator_path}
+    for name, p in paths.items():
+        if not p or not os.path.isfile(p):
+            return f"Error: {name} file not found: {p}"
+    solution_path, brute_path, generator_path = (os.path.abspath(solution_path),
+                                                  os.path.abspath(brute_path),
+                                                  os.path.abspath(generator_path))
+    cwd = os.path.dirname(solution_path)
+
+    max_sol_time = 0.0
+    for seed in range(num_tests):
+        # 1. generate the input
+        rc, gen_out, gen_err, _, gen_timeout = _run(generator_path, cwd, args=[str(seed)], timeout=timeout)
+        if gen_timeout or rc != 0:
+            return (f"Generator failed at seed {seed} (rc={rc}, timeout={gen_timeout}).\n"
+                    f"STDERR:\n{_clip(gen_err)}")
+        test_input = gen_out
+
+        # 2. run the solution
+        rc, sol_out, sol_err, sol_time, sol_timeout = _run(solution_path, cwd, stdin_text=test_input, timeout=timeout)
+        max_sol_time = max(max_sol_time, sol_time)
+        if sol_timeout:
+            return _report("solution TIMEOUT", seed, test_input, sol_out, None, sol_err, None)
+        if rc != 0:
+            return _report(f"solution CRASH (exit code {rc})", seed, test_input, sol_out, None, sol_err, None)
+
+        # 3. run the brute force
+        rc, brute_out, brute_err, _, brute_timeout = _run(brute_path, cwd, stdin_text=test_input, timeout=timeout)
+        if brute_timeout:
+            return _report("brute force TIMEOUT (fix the brute or lower sizes in the generator)",
+                           seed, test_input, sol_out, brute_out, sol_err, brute_err)
+        if rc != 0:
+            return _report(f"brute force CRASH (exit code {rc})", seed, test_input, sol_out, brute_out, sol_err, brute_err)
+
+        # 4. compare token-wise
+        if sol_out.split() != brute_out.split():
+            return _report("WRONG ANSWER (outputs differ)", seed, test_input, sol_out, brute_out, sol_err, brute_err)
+
+    return f"ALL {num_tests} TESTS PASSED\nMax solution running time: {max_sol_time:.3f}s"
+
+
+def _report(kind, seed, test_input, sol_out, brute_out, sol_err, brute_err):
+    parts = [f"FAILED: {kind} at seed {seed}.", "INPUT:", _clip(test_input).rstrip(),
+             "SOLUTION OUTPUT:", _clip(sol_out or "").rstrip() or "(empty)"]
+    if brute_out is not None:
+        parts += ["BRUTE OUTPUT:", _clip(brute_out or "").rstrip() or "(empty)"]
+    if sol_err and sol_err.strip():
+        parts += ["SOLUTION STDERR:", _clip(sol_err).rstrip()]
+    if brute_err and brute_err.strip():
+        parts += ["BRUTE STDERR:", _clip(brute_err).rstrip()]
+    return "\n".join(parts)
