diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..48ab429
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,151 @@
+import shlex
+import subprocess
+import time
+
+TOTAL_WALL_CAP = 240  # seconds; overall cap for one call so it can never hang
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress tester: compares a solution program against a brute-force reference on random inputs.\n
+* `generator_cmd` is run once per iteration as `<generator_cmd> <i>` (i = 0..iterations-1 is the seed) and must print ONE test input to stdout.\n
+* Each input is fed via stdin to both `solution_cmd` and `brute_cmd`, each with a per-run timeout.\n
+* Stops at the first discrepancy, crash (non-zero exit), or timeout, and returns the iteration index, the failing input, the expected (brute) and actual outputs, and raw stderr.\n
+* On success returns the number of passed tests and the max solution runtime.\n
+* Commands are split with shlex and run WITHOUT a shell (e.g. `python3 solution.py`). Use `cwd` for the working directory, or absolute paths.\n
+* compare_mode `tokens` compares whitespace-separated tokens; `exact` compares after stripping trailing whitespace.\n
+* Overall wall-clock cap is about 240 seconds per call; use fewer iterations for slow programs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command that runs the solution under test reading stdin, e.g. `python3 solution.py`."
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Command that runs the trusted brute-force reference reading stdin, e.g. `python3 brute.py`."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Command that prints one random test input to stdout; the iteration index is appended as the last argument, e.g. `python3 gen.py`."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (default 200)."
+                },
+                "timeout_per_run": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each single run of solution or brute (default 5)."
+                },
+                "compare_mode": {
+                    "type": "string",
+                    "enum": ["tokens", "exact"],
+                    "description": "`tokens` compares whitespace-split tokens (default); `exact` compares after rstrip."
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Optional working directory (absolute path) in which all commands are run. Defaults to the current process directory."
+                }
+            },
+            "required": ["solution_cmd", "brute_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _clip(s, n):
+    s = s or ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _norm(out, mode):
+    if mode == "tokens":
+        return out.split()
+    return out.rstrip()
+
+
+def _run(cmd_list, data, timeout, cwd):
+    """Run a command with stdin=data. Returns (status, stdout, stderr, elapsed)."""
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd_list, input=data, capture_output=True, text=True,
+                           timeout=timeout, cwd=cwd, errors="replace")
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ""
+        err = e.stderr if isinstance(e.stderr, str) else ""
+        return "timeout", out, err, time.time() - t0
+    except FileNotFoundError as e:
+        return "error", "", f"Command not found: {e}", time.time() - t0
+    if p.returncode != 0:
+        return "crash", p.stdout, p.stderr, time.time() - t0
+    return "ok", p.stdout, p.stderr, time.time() - t0
+
+
+def tool_function(solution_cmd, brute_cmd, generator_cmd, iterations=200, timeout_per_run=5,
+                  compare_mode='tokens', cwd=None):
+    try:
+        iterations = int(iterations) if iterations is not None else 200
+        timeout_per_run = float(timeout_per_run) if timeout_per_run is not None else 5
+    except (TypeError, ValueError):
+        return "Error: iterations and timeout_per_run must be numbers."
+    if compare_mode not in ("tokens", "exact"):
+        compare_mode = "tokens"
+    if iterations <= 0:
+        return "Error: iterations must be positive."
+    try:
+        sol_argv = shlex.split(solution_cmd)
+        brute_argv = shlex.split(brute_cmd)
+        gen_argv = shlex.split(generator_cmd)
+    except ValueError as e:
+        return f"Error: could not parse command: {e}"
+    if not (sol_argv and brute_argv and gen_argv):
+        return "Error: commands must be non-empty."
+
+    start = time.time()
+    max_sol_time = 0.0
+    passed = 0
+    for i in range(iterations):
+        if time.time() - start > TOTAL_WALL_CAP:
+            return (f"Stopped: wall-clock cap of {TOTAL_WALL_CAP}s reached after {passed} passed tests "
+                    f"(of {iterations} requested). Max solution runtime so far: {max_sol_time:.3f}s. "
+                    f"No mismatch found in the tests that ran.")
+
+        # 1. generate input
+        gst, gen_out, gen_err, _ = _run(gen_argv + [str(i)], None, max(timeout_per_run, 10), cwd)
+        if gst != "ok":
+            return (f"Generator {gst} at iteration {i}.\nGenerator stderr:\n{_clip(gen_err, 1500)}")
+        test_input = gen_out
+
+        # 2. run brute force (reference)
+        bst, b_out, b_err, _ = _run(brute_argv, test_input, timeout_per_run, cwd)
+        if bst != "ok":
+            return (f"Brute force {bst} at iteration {i}. The brute force must be correct and fast on small inputs.\n"
+                    f"Input:\n{_clip(test_input, 2000)}\nBrute stderr:\n{_clip(b_err, 1500)}")
+
+        # 3. run solution
+        sst, s_out, s_err, s_time = _run(sol_argv, test_input, timeout_per_run, cwd)
+        max_sol_time = max(max_sol_time, s_time)
+        if sst == "timeout":
+            return (f"Solution TIMEOUT (>{timeout_per_run}s) at iteration {i}.\n"
+                    f"Input:\n{_clip(test_input, 2000)}\nSolution stderr:\n{_clip(s_err, 1500)}")
+        if sst == "crash":
+            return (f"Solution CRASHED (non-zero exit) at iteration {i}.\n"
+                    f"Input:\n{_clip(test_input, 2000)}\nSolution stderr:\n{_clip(s_err, 1500)}\n"
+                    f"Solution stdout:\n{_clip(s_out, 500)}")
+        if sst != "ok":
+            return f"Solution {sst} at iteration {i}: {s_err}"
+
+        # 4. compare
+        if _norm(b_out, compare_mode) != _norm(s_out, compare_mode):
+            return (f"MISMATCH at iteration {i} (compare_mode={compare_mode}).\n"
+                    f"Input:\n{_clip(test_input, 2000)}\n"
+                    f"Expected (brute) output:\n{_clip(b_out, 1000)}\n"
+                    f"Actual (solution) output:\n{_clip(s_out, 1000)}\n"
+                    f"Solution stderr:\n{_clip(s_err, 500)}")
+        passed += 1
+
+    return (f"All {passed} tests passed (iterations={iterations}). "
+            f"Max solution runtime: {max_sol_time:.3f}s.")
