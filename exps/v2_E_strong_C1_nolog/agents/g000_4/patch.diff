diff --git a/tools/run_tests.py b/tools/run_tests.py
new file mode 100644
index 0000000..ed9d0c8
--- /dev/null
+++ b/tools/run_tests.py
@@ -0,0 +1,159 @@
+import difflib
+import subprocess
+import time
+
+MAX_CASE_CHARS = 1500
+MAX_TOTAL_CHARS = 12000
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a program against test cases and report the results.\n
+* mode "samples": runs `solution_cmd` once per entry in `samples`, feeding `input` on stdin. Each case gets a PASS/FAIL line, the elapsed time, and a diff (or stderr) on failure. Output is compared token by token (whitespace-insensitive).\n
+* mode "stress": for seed in range(iterations), runs `gen_cmd <seed>` to produce an input on stdout, then runs both `solution_cmd` and `brute_cmd` on that input. Returns the first input where the outputs differ (with both outputs), or 'all N passed'.\n
+* Commands are run through the shell, so pass them as strings, e.g. `python3 /path/solution.py`.\n
+* `timeout` is the per-run time limit in seconds (default 5).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "mode": {
+                    "type": "string",
+                    "enum": ["samples", "stress"],
+                    "description": "'samples' to check fixed test cases, 'stress' to compare against a brute force on generated inputs.",
+                },
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution, e.g. 'python3 /path/solution.py'.",
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Test cases for 'samples' mode.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Exact stdin content for this case."},
+                            "expected": {"type": "string", "description": "Expected stdout for this case."},
+                        },
+                        "required": ["input", "expected"],
+                    },
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the brute-force reference, used in 'stress' mode.",
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the random input generator; it is called as `gen_cmd <seed>` and prints an input on stdout. Used in 'stress' mode.",
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random seeds to try in 'stress' mode (default 200).",
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 5).",
+                },
+            },
+            "required": ["mode", "solution_cmd"],
+        },
+    }
+
+
+def _clip(s, n=MAX_CASE_CHARS):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a shell command. Returns (status, stdout, stderr, elapsed) where status is 'ok', 'timeout' or 'error'."""
+    start = time.time()
+    try:
+        p = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True, text=True,
+            timeout=timeout, errors="replace",
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ""
+        err = e.stderr if isinstance(e.stderr, str) else ""
+        return "timeout", out, err, time.time() - start
+    elapsed = time.time() - start
+    status = "ok" if p.returncode == 0 else "error"
+    return status, p.stdout, p.stderr, elapsed
+
+
+def _same(a, b):
+    return a.split() == b.split()
+
+
+def _diff(expected, actual):
+    d = difflib.unified_diff(
+        expected.rstrip().splitlines(), actual.rstrip().splitlines(),
+        fromfile="expected", tofile="actual", lineterm="",
+    )
+    return _clip("\n".join(d)) or "(outputs differ only in whitespace)"
+
+
+def _run_samples(solution_cmd, samples, timeout):
+    if not samples:
+        return "Error: 'samples' is empty or missing."
+    lines = []
+    passed = 0
+    for idx, case in enumerate(samples, 1):
+        inp = case.get("input", "")
+        exp = case.get("expected", "")
+        status, out, err, elapsed = _run(solution_cmd, inp, timeout)
+        if status == "ok" and _same(out, exp):
+            passed += 1
+            lines.append(f"Case {idx}: PASS ({elapsed:.2f}s)")
+            continue
+        if status == "timeout":
+            lines.append(f"Case {idx}: FAIL (timeout after {timeout}s)")
+            if out.strip():
+                lines.append("Partial output:\n" + _clip(out))
+        elif status == "error":
+            lines.append(f"Case {idx}: FAIL (non-zero exit, {elapsed:.2f}s)")
+            lines.append("STDERR:\n" + _clip(err.rstrip() or "(empty)"))
+        else:
+            lines.append(f"Case {idx}: FAIL ({elapsed:.2f}s)")
+            lines.append("Diff:\n" + _diff(exp, out))
+            if err.strip():
+                lines.append("STDERR:\n" + _clip(err.rstrip()))
+    lines.append(f"Summary: {passed}/{len(samples)} passed")
+    return _clip("\n".join(lines), MAX_TOTAL_CHARS)
+
+
+def _run_stress(solution_cmd, brute_cmd, gen_cmd, iterations, timeout):
+    if not brute_cmd or not gen_cmd:
+        return "Error: 'stress' mode requires both 'brute_cmd' and 'gen_cmd'."
+    total = iterations if iterations and iterations > 0 else 200
+    for seed in range(total):
+        g_status, test_in, g_err, _ = _run(f"{gen_cmd} {seed}", "", timeout)
+        if g_status != "ok":
+            return f"Generator failed on seed {seed} ({g_status}).\nSTDERR:\n{_clip(g_err.rstrip())}"
+        s_status, s_out, s_err, _ = _run(solution_cmd, test_in, timeout)
+        b_status, b_out, b_err, _ = _run(brute_cmd, test_in, timeout)
+        if b_status != "ok":
+            return (f"Brute force failed on seed {seed} ({b_status}); fix the brute force first.\n"
+                    f"Input:\n{_clip(test_in)}\nSTDERR:\n{_clip(b_err.rstrip())}")
+        if s_status != "ok" or not _same(s_out, b_out):
+            return (f"MISMATCH on seed {seed}.\n"
+                    f"Input:\n{_clip(test_in)}\n"
+                    f"Solution status: {s_status}\nSolution output:\n{_clip(s_out.rstrip() or '(empty)')}\n"
+                    f"Solution STDERR:\n{_clip(s_err.rstrip() or '(empty)')}\n"
+                    f"Brute output:\n{_clip(b_out.rstrip() or '(empty)')}")
+    return f"all {total} passed"
+
+
+def tool_function(mode, solution_cmd, samples=None, brute_cmd=None, gen_cmd=None, iterations=None, timeout=None):
+    try:
+        t = int(timeout) if timeout else 5
+        t = max(1, min(t, 60))
+        if mode == "samples":
+            return _run_samples(solution_cmd, samples or [], t)
+        if mode == "stress":
+            return _run_stress(solution_cmd, brute_cmd, gen_cmd, int(iterations or 200), t)
+        return f"Error: unknown mode '{mode}'. Use 'samples' or 'stress'."
+    except Exception as e:
+        return f"Error: {e}"
