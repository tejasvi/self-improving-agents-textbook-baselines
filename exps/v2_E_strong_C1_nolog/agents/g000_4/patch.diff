+
+        # Trivial smoke test: run the file with empty stdin, bounded by a timeout.
+        try:
+            smoke = subprocess.run(['python3', 'solution.py'], cwd=self.git_tempdir, stdin=subprocess.DEVNULL,
+                                   capture_output=True, text=True, timeout=10)
+            outputs.append(f"$ python3 solution.py < /dev/null\nexit code {smoke.returncode}\n"
+                           f"{smoke.stdout[-2000:]}\nSTDERR:\n{smoke.stderr[-2000:]}")
