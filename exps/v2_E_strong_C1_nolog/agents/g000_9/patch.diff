+import subprocess
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test: compare a solution against a brute-force reference.\n
+* `gen_cmd` must print one random input to stdout and accept an integer seed as its last command-line argument (the seed is appended to the command for each test).\n
+* For each seed from 1 to `num_tests`, the generated input is fed to both `solution_cmd` and `brute_cmd` via stdin.\n
+* Outputs are compared after stripping trailing whitespace. A non-zero exit code or a timeout counts as a failure.\n
+* Returns 'all passed' or the first differing input together with both outputs (and stderr/exit codes).\n
+* Commands run through the shell; use `cd <dir> && ...` if needed, e.g. `python3 solution.py`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {"type": "string", "description": "Shell command that runs the solution under test, reading the input from stdin, e.g. `python3 solution.py`."},
+                "brute_cmd": {"type": "string", "description": "Shell command that runs the brute-force reference, reading the input from stdin, e.g. `python3 brute.py`."},
+                "gen_cmd": {"type": "string", "description": "Shell command that prints a random test input to stdout; the seed is appended as the last argument, e.g. `python3 gen.py`."},
+                "num_tests": {"type": "integer", "description": "Number of random tests to run (seeds 1..num_tests). Use at least 300."},
+                "timeout": {"type": "integer", "description": "Per-run time limit in seconds for each program (default 10)."}
+            },
+            "required": ["solution_cmd", "brute_cmd", "gen_cmd", "num_tests"]
+        }
+    }
+
+def _clip(s, n=3000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+def _run(cmd, stdin_text, timeout):
+    """Run a shell command; return (status, stdout, stderr). status is 'ok', 'exit N' or 'timeout'."""
+    try:
+        p = subprocess.run(cmd, shell=True, input=stdin_text, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return 'timeout', out, err
+    status = 'ok' if p.returncode == 0 else f'exit {p.returncode}'
+    return status, p.stdout, p.stderr
+
+def tool_function(solution_cmd, brute_cmd, gen_cmd, num_tests, timeout=10):
+    try:
+        num_tests = int(num_tests)
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        timeout = int(timeout) if timeout else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    timeout = max(1, min(timeout, 120))
+    num_tests = max(1, min(num_tests, 100000))
+
+    for seed in range(1, num_tests + 1):
+        gen_status, test_input, gen_err = _run(f"{gen_cmd} {seed}", "", timeout)
+        if gen_status != 'ok':
+            return f"Generator failed on seed {seed} ({gen_status}).\nSTDERR:\n{_clip(gen_err)}"
+
+        sol_status, sol_out, sol_err = _run(solution_cmd, test_input, timeout)
+        brute_status, brute_out, brute_err = _run(brute_cmd, test_input, timeout)
+
+        same = (sol_status == 'ok' and brute_status == 'ok'
+                and sol_out.rstrip() == brute_out.rstrip())
+        if not same:
+            return (
+                f"MISMATCH at seed {seed}.\n"
+                f"Input:\n{_clip(test_input.rstrip())}\n\n"
+                f"Solution status: {sol_status}\nSolution output:\n{_clip(sol_out.rstrip())}\n"
+                f"Solution stderr:\n{_clip(sol_err.rstrip())}\n\n"
+                f"Brute status: {brute_status}\nBrute output:\n{_clip(brute_out.rstrip())}\n"
+                f"Brute stderr:\n{_clip(brute_err.rstrip())}"
+            )
+    return f"all passed ({num_tests} tests)"
