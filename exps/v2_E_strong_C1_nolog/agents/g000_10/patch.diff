index 0000000..c31ce37
--- /dev/null
+++ b/tests/test_stress_test.py
@@ -0,0 +1,25 @@
+from tools import stress_test
+
+GEN = "import random, sys\nr = random.Random(int(sys.argv[1]))\nn = r.randint(1, 6)\nprint(n)\nprint(*[r.randint(1, 9) for _ in range(n)])\n"
+BRUTE = "n = int(input()); a = list(map(int, input().split())); print(sum(a))\n"
+GOOD = BRUTE
+BAD = "n = int(input()); a = list(map(int, input().split()))\nprint(sum(a) if n < 5 else sum(a) + 1)\n"
+
+def _write(tmp_path, name, text):
+    p = tmp_path / name
+    p.write_text(text)
+    return str(p)
+
+def test_stress_test_passes_good_and_catches_bad(tmp_path):
+    gen = _write(tmp_path, "gen.py", GEN)
+    brute = _write(tmp_path, "brute.py", BRUTE)
+    good = _write(tmp_path, "good.py", GOOD)
+    bad = _write(tmp_path, "bad.py", BAD)
+    assert "PASSED" in stress_test.tool_function(good, brute, gen, num_tests=100)
+    out = stress_test.tool_function(bad, brute, gen, num_tests=100)
+    assert "FAILED at seed" in out and "output mismatch" in out
+
+def test_stress_test_time_mode(tmp_path):
+    gen = _write(tmp_path, "gen.py", GEN)
+    good = _write(tmp_path, "good.py", GOOD)
+    assert "Timing OK" in stress_test.tool_function(good, None, gen, mode="time")
diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..27631b9
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,135 @@
+import os
+import subprocess
+import sys
+import time
+
+MAX_CLIP = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference using a random input generator, or time a solution on large generated input.\n
+* `mode` = 'compare' (default): for seeds seed_start .. seed_start+num_tests-1, run `python3 generator_path <seed>` to produce an input on stdin-compatible text, feed it to both solution_path and brute_path, and compare their outputs (whitespace-normalized). Stops at the first mismatch, crash, or timeout and reports the seed, the (clipped) input, both outputs and stderr. If all pass, returns a summary.
+* `mode` = 'time': runs `python3 generator_path <seed_start>` once to produce an input (use the generator to produce a max-size / adversarial case), then runs only solution_path on it and reports the elapsed wall time and output. brute_path is ignored in this mode.
+* Each program is run with a per-run timeout of `timeout_per_test` seconds.
+* Generator, solution and brute are all run as `python3 <file>`; write them so they read stdin / write stdout. The generator must print the test input to stdout and use argv[1] as its random seed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file to test."},
+                "brute_path": {"type": "string", "description": "Path to the trusted brute-force Python reference file."},
+                "generator_path": {"type": "string", "description": "Path to the random input generator Python file; it is called as `python3 generator_path <seed>` and prints one test input to stdout."},
+                "num_tests": {"type": "integer", "description": "Number of random tests to run in compare mode (default 300)."},
+                "timeout_per_test": {"type": "number", "description": "Timeout in seconds for each program run (default 5)."},
+                "mode": {"type": "string", "enum": ["compare", "time"], "description": "'compare' to check solution against brute, or 'time' to only time the solution on one generated input (default 'compare')."},
+                "seed_start": {"type": "integer", "description": "First seed to use (default 0). In time mode, the seed passed to the generator."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_CLIP):
+    if s is None:
+        return ""
+    if isinstance(s, bytes):
+        s = s.decode(errors="replace")
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(prog, args, inp, timeout):
+    """Run `python3 prog args...` with stdin=inp. Returns (status, stdout, stderr).
+    status is 'ok', 'timeout', or 'crash' (nonzero exit)."""
+    try:
+        p = subprocess.run([sys.executable, prog] + list(args), input=inp, capture_output=True,
+                           text=True, timeout=timeout, errors="replace")
+    except subprocess.TimeoutExpired as e:
+        return "timeout", e.stdout or "", e.stderr or ""
+    if p.returncode != 0:
+        return "crash", p.stdout, p.stderr
+    return "ok", p.stdout, p.stderr
+
+
+def _norm(s):
+    return " ".join(s.split())
+
+
+def tool_function(solution_path, brute_path=None, generator_path=None, num_tests=300,
+                  timeout_per_test=5, mode="compare", seed_start=0):
+    try:
+        solution_path = os.path.abspath(solution_path)
+        if generator_path is None:
+            return "Error: generator_path is required."
+        generator_path = os.path.abspath(generator_path)
+        mode = (mode or "compare").strip().lower()
+        num_tests = int(num_tests) if num_tests is not None else 300
+        timeout = float(timeout_per_test) if timeout_per_test is not None else 5.0
+        timeout = max(0.1, min(timeout, 300.0))
+        seed_start = int(seed_start) if seed_start is not None else 0
+        num_tests = max(1, min(num_tests, 100000))
+
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if not os.path.isfile(generator_path):
+            return f"Error: generator file not found: {generator_path}"
+
+        if mode == "time":
+            st, gout, gerr = _run(generator_path, [str(seed_start)], "", timeout)
+            if st != "ok":
+                return f"Error: generator failed (seed {seed_start}, {st}).\nSTDERR:\n{_clip(gerr)}"
+            t0 = time.time()
+            st, sout, serr = _run(solution_path, [], gout, timeout)
+            elapsed = time.time() - t0
+            if st == "timeout":
+                return f"TIMEOUT: solution exceeded {timeout}s on generated input (seed {seed_start}). Input size: {len(gout)} chars."
+            if st == "crash":
+                return f"CRASH: solution exited with error on seed {seed_start}.\nSTDERR:\n{_clip(serr)}"
+            return (f"Timing OK: solution finished in {elapsed:.3f}s on input of {len(gout)} chars (seed {seed_start}).\n"
+                    f"Output (clipped):\n{_clip(sout, 500)}")
+
+        # compare mode
+        if not brute_path:
+            return "Error: brute_path is required in compare mode."
+        brute_path = os.path.abspath(brute_path)
+        if not os.path.isfile(brute_path):
+            return f"Error: brute file not found: {brute_path}"
+
+        for i in range(num_tests):
+            seed = seed_start + i
+            gst, inp, gerr = _run(generator_path, [str(seed)], "", timeout)
+            if gst != "ok":
+                return f"Generator failed at seed {seed} ({gst}).\nSTDERR:\n{_clip(gerr)}"
+
+            def fail(reason, sol_out="", brute_out="", sol_err="", brute_err=""):
+                parts = [f"FAILED at seed {seed} (test {i + 1}/{num_tests}): {reason}",
+                         f"INPUT (clipped):\n{_clip(inp)}"]
+                if sol_out is not None:
+                    parts.append(f"SOLUTION OUTPUT:\n{_clip(sol_out)}")
+                if brute_out is not None:
+                    parts.append(f"BRUTE OUTPUT:\n{_clip(brute_out)}")
+                if sol_err:
+                    parts.append(f"SOLUTION STDERR:\n{_clip(sol_err)}")
+                if brute_err:
+                    parts.append(f"BRUTE STDERR:\n{_clip(brute_err)}")
+                return "\n".join(parts)
+
+            sst, sout, serr = _run(solution_path, [], inp, timeout)
+            if sst == "timeout":
+                return fail(f"solution timed out after {timeout}s", sol_out=sout, brute_out=None, sol_err=serr)
+            if sst == "crash":
+                return fail("solution crashed (nonzero exit)", sol_out=sout, brute_out=None, sol_err=serr)
+
+            bst, bout, berr = _run(brute_path, [], inp, timeout)
+            if bst != "ok":
+                return fail(f"brute force {bst} (the reference is broken, not necessarily the solution)",
+                            sol_out=sout, brute_out=bout, sol_err=serr, brute_err=berr)
+
+            if _norm(sout) != _norm(bout):
+                return fail("output mismatch", sol_out=sout, brute_out=bout, sol_err=serr, brute_err=berr)
+
+        return f"ALL {num_tests} TESTS PASSED (seeds {seed_start}..{seed_start + num_tests - 1})."
+    except Exception as e:
+        return f"Error in stress_test: {type(e).__name__}: {e}"
