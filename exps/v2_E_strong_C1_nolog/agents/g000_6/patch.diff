+    def _sanity_check(self):
+        """
+        Programmatic gate on the final solution.py.
+        Returns (ok, error_text).
+        """
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.isfile(sol_path):
+            return False, f"solution.py does not exist in {self.git_tempdir}"
+        try:
+            with open(sol_path, 'r') as f:
+                src = f.read()
+        except Exception as e:
+            return False, f"Could not read solution.py: {e}"
+
+        if 'class Solution' not in src and 'input(' not in src and 'sys.stdin' not in src:
+            return False, ("solution.py must either define `class Solution` (for Solution-method tasks) "
+                           "or read from standard input (input() / sys.stdin) for stdin/stdout tasks.")
+        try:
+            proc = subprocess.run(
+                ['python3', '-m', 'py_compile', 'solution.py'],
+                cwd=self.git_tempdir,
+                capture_output=True,
+                text=True,
+                timeout=60,
+            )
+        except Exception as e:
+            return False, f"py_compile could not be run: {e}"
+        if proc.returncode != 0:
+            return False, f"python3 -m py_compile solution.py failed:\n{proc.stdout}\n{proc.stderr}"
+        return True, ""
