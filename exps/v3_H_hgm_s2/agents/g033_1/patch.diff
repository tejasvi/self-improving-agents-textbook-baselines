-    def _extract_samples(self):
-        """
-        Ask the LLM to extract the sample inputs/expected outputs from the problem statement.
-        Returns a list of {"input": str, "output": str} dicts (empty list on failure).
-        Retries once and logs the raw response when parsing fails (no silent empty result).
-        """
-        prompt = f"""Extract the sample test cases from the problem statement below.
-
-Return ONLY a JSON array (no prose) of objects with exactly two string keys:
-[{{"input": "<exact stdin text>", "output": "<exact expected stdout text>"}}, ...]
-
-Copy the sample inputs and outputs exactly, preserving line breaks. If there are no samples, return [].
-
-<problem_statement>
-{self.problem_statement}
-</problem_statement>
-"""
-        for attempt in range(2):
-            text = simple_chat(prompt, model=self.code_model, max_tokens=8192, logging=safe_log)
-            match = re.search(r"\[.*\]", text or "", re.DOTALL)
-            if not match:
-                safe_log(f"[samples] attempt {attempt}: no JSON array in response: {(text or '')[:300]!r}")
-                continue
-            try:
-                data = json.loads(match.group(0))
-            except Exception as e:
-                safe_log(f"[samples] attempt {attempt}: JSON parse failed: {e}")
-                continue
-            samples = []
-            if isinstance(data, list):
-                for item in data:
-                    if isinstance(item, dict) and "input" in item and "output" in item:
-                        samples.append({"input": str(item["input"]), "output": str(item["output"])})
-            return samples
-        return []
