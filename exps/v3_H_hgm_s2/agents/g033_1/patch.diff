-    def _run_candidate(self, solution_path, bank, max_tests=None):
-        """
-        Run a solution file with python3 against a test bank (list of {input, expected, kind}).
-        Each test has its own timeout. Outputs are compared by whitespace-separated tokens.
-        Returns (score, report):
-          score  = (samples_passed, small_passed, max_ok) as a tuple (higher is better)
-          report = raw plain text listing the first few failing cases (truncated)
-        """
-        if not bank:
-            return (0, 0, 0), "No test bank available; verify manually with your own tests."
-        if not solution_path or not os.path.exists(solution_path):
-            return (0, 0, 0), f"Solution file not found: {solution_path}"
-
-        counts = {"sample": [0, 0], "small": [0, 0], "max": [0, 0]}  # [passed, total]
-        failures = []
-        max_report = 3
-        for idx, case in enumerate(bank):
-            kind = case.get("kind", "small")
-            if kind not in counts:
-                counts[kind] = [0, 0]
-            counts[kind][1] += 1
-            stdin_text = case["input"]
-            if stdin_text and not stdin_text.endswith("\n"):
-                stdin_text += "\n"
-            start = time.time()
-            timed_out = False
-            try:
-                proc = subprocess.run(
-                    ["python3", solution_path],
-                    input=stdin_text, capture_output=True, text=True, timeout=10,
-                    cwd=self.git_tempdir,
-                )
-                actual, stderr = proc.stdout, proc.stderr
-                returncode = proc.returncode
-                if case["expected"] is None:  # timing-only case (no reference output)
-                    passed = returncode == 0
-                else:
-                    passed = returncode == 0 and actual.split() == case["expected"].split()
-            except subprocess.TimeoutExpired:
-                timed_out = True
-                actual, stderr, returncode = "", "TIMEOUT: exceeded 10 seconds", None
-                passed = False
-            elapsed = time.time() - start
-            if passed:
-                counts[kind][0] += 1
-            else:
-                if len(failures) < max_report:
-                    failures.append(
-                        f"=== Failing case #{idx + 1} (kind={kind}, "
-                        f"{'timeout' if timed_out else f'exit code {returncode}'}, time {elapsed:.3f}s) ===\n"
-                        f"--- input ---\n{case['input'][:1500]}\n"
-                        f"--- expected output ---\n{(case['expected'] or '(timing-only: no reference)')[:1000]}\n"
-                        f"--- actual output ---\n{actual[:1000]}\n"
-                        f"--- stderr ---\n{stderr[-1000:]}\n"
-                    )
-            if max_tests is not None and idx + 1 >= max_tests:
-                break
-
-        samples_passed = counts["sample"][0]
-        small_passed = counts["small"][0]
-        max_ok = int(counts["max"][0] == counts["max"][1])
-        score = (samples_passed, small_passed, max_ok)
-        total_fail = sum(t - p for p, t in counts.values())
-        summary = (
-            f"score={score} samples {counts['sample'][0]}/{counts['sample'][1]}, "
-            f"small {counts['small'][0]}/{counts['small'][1]}, "
-            f"max {counts['max'][0]}/{counts['max'][1]}"
-        )
-        if total_fail == 0:
-            report = f"ALL TESTS PASSED ({summary})"
-        else:
-            report = f"SOME TESTS FAILED ({summary})\n\n" + "\n".join(failures)
-        return score, report
-
-    def _solution_path(self):
-        """
-        Pick the solution file: a changed non-test file (prefer solution.py), else None.
-        """
-        candidates = [f for f in self._changed_files() if not _is_test_file(f)]
-        if not candidates:
-            return None
-        for f in candidates:
-            if os.path.basename(f) == "solution.py":
-                return os.path.join(self.git_tempdir, f)
-        return os.path.join(self.git_tempdir, candidates[0])
-
-    def _is_perfect(self, score):
-        """True if the score passes every sample, every small case and every max case."""
-        return score == (len(self._sample_cases), self._n_small, 1)
