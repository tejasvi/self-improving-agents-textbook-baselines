+    def _list_repo_files(self):
+        """
+        Return the repo's tracked and untracked (non-ignored) file paths, relative to git_tempdir.
+        """
+        files = []
+        for args in (["git", "-C", self.git_tempdir, "ls-files"],
+                     ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]):
+            result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            for line in result.stdout.decode(errors='replace').splitlines():
+                line = line.strip()
+                if line and line not in files:
+                    files.append(line)
+        return files
