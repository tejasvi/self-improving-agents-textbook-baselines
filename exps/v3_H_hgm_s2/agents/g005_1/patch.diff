+    def _is_placeholder(self, content):
+        """
+        True if content is empty, or it still contains a placeholder marker while being
+        no larger than the original stub (a finished solution may keep a TODO comment).
+        """
+        if content is None or not content.strip():
+            return True
+        if self.original_content is not None and len(content) > len(self.original_content):
+            return False
+        return any(marker in content for marker in self.PLACEHOLDER_MARKERS)
+
+    def _find_target_file(self):
+        """
+        Identify the file the solution must be written to. Priority:
+        1. a non-test source file containing placeholder text,
+        2. a file named in the problem statement (e.g. `solution.py`),
+        3. the first non-test, non-README source file.
+        Returns the path relative to git_tempdir, or None.
+        """
+        candidates = [f for f in self._list_repo_files() if self._is_source_candidate(f)]
+        if not candidates:
+            return None
+
+        for path in candidates:
+            content = self._read_file(path)
+            if content and any(marker in content for marker in self.PLACEHOLDER_MARKERS):
+                return path
+
+        named = re.findall(r'[\w./-]+\.py\b', self.problem_statement or '')
+        for name in named:
+            name = name.lstrip('./')
+            for path in candidates:
+                if path == name or path.endswith('/' + name):
+                    return path
+
+        return candidates[0]
+
+    def _target_modified(self):
+        """
+        True if the target file's content differs from its original content and is not a placeholder.
+        """
+        if not self.target_file:
