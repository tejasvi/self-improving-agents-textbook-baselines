diff --git a/tools/exhaustive_compare.py b/tools/exhaustive_compare.py
new file mode 100644
index 0000000..35f9fac
--- /dev/null
+++ b/tools/exhaustive_compare.py
@@ -0,0 +1,110 @@
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "exhaustive_compare",
+        "description": """Compare a solution program against an oracle program on many generated inputs and report ONLY the count of cases covered and the first few mismatches.
+
+* gen_cmd is a shell command that is called as `gen_cmd <param>` for every integer param in [param_min, param_max] and must print one complete test input (stdin text) to stdout. Example: `python3 /tmp/gen.py`.
+* solution_cmd and oracle_cmd are shell commands that read the test input on stdin and print the answer on stdout (e.g. `python3 /dgm/solution.py`, `/tmp/oracle_v1_bin`).
+* Outputs are compared after stripping trailing whitespace on each line. Each run has its own timeout.
+* The loop stops early when time_budget_sec is exhausted; the report says how far it got, so you can call again with a later param_min.
+* Use this for large exhaustive comparisons on a small-parameter grid instead of writing ad-hoc loops.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the solution under test; reads stdin, writes stdout."
+                },
+                "oracle_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted oracle; reads stdin, writes stdout."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command called as '<gen_cmd> <param>' that prints one test input to stdout."
+                },
+                "param_min": {
+                    "type": "integer",
+                    "description": "First generator parameter (inclusive)."
+                },
+                "param_max": {
+                    "type": "integer",
+                    "description": "Last generator parameter (inclusive)."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Per-run timeout in seconds for each program. Default 10."
+                },
+                "time_budget_sec": {
+                    "type": "integer",
+                    "description": "Total wall-clock budget in seconds for the whole comparison. Default 100."
+                },
+                "max_mismatches_shown": {
+                    "type": "integer",
+                    "description": "How many mismatching cases to show in full. Default 3."
+                }
+            },
+            "required": ["solution_cmd", "oracle_cmd", "gen_cmd", "param_min", "param_max"]
+        }
+    }
+
+def _run(cmd, stdin_text, timeout):
+    try:
+        proc = subprocess.run(cmd, shell=True, input=stdin_text, capture_output=True,
+                              text=True, timeout=timeout)
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired:
+        return None, "", "", True
+
+def _norm(text):
+    return "\n".join(line.rstrip() for line in text.strip().splitlines())
+
+def tool_function(solution_cmd, oracle_cmd, gen_cmd, param_min, param_max,
+                  timeout_sec=10, time_budget_sec=100, max_mismatches_shown=3):
+    timeout_sec = int(timeout_sec) if timeout_sec else 10
+    time_budget_sec = int(time_budget_sec) if time_budget_sec else 100
+    max_mismatches_shown = int(max_mismatches_shown) if max_mismatches_shown is not None else 3
+    start = time.time()
+    covered = 0
+    mismatches = []
+    stopped_early = False
+    last_param = None
+    for param in range(int(param_min), int(param_max) + 1):
+        if time.time() - start > time_budget_sec:
+            stopped_early = True
+            break
+        last_param = param
+        code, gen_out, gen_err, gen_timeout = _run(f"{gen_cmd} {param}", None, timeout_sec)
+        if gen_timeout or code != 0:
+            return f"Generator failed at param={param}: {'timeout' if gen_timeout else gen_err.strip()[:500]}"
+        test_input = gen_out
+        if test_input and not test_input.endswith("\n"):
+            test_input += "\n"
+        ocode, oout, oerr, otimeout = _run(oracle_cmd, test_input, timeout_sec)
+        if otimeout or ocode != 0:
+            return (f"Oracle failed at param={param} (timeout={otimeout}, exit={ocode}); "
+                    f"oracle stderr: {oerr.strip()[:500]}. Covered {covered} cases before this.")
+        scode, sout, serr, stimeout = _run(solution_cmd, test_input, timeout_sec)
+        covered += 1
+        if stimeout:
+            mismatches.append(f"param={param}: solution TIMEOUT\n--- input ---\n{test_input}")
+        elif scode != 0:
+            mismatches.append(f"param={param}: solution exit {scode}, stderr: {serr.strip()[:500]}\n--- input ---\n{test_input}")
+        elif _norm(sout) != _norm(oout):
+            mismatches.append(f"param={param}\n--- input ---\n{test_input}--- expected (oracle) ---\n{oout.strip()}\n--- actual (solution) ---\n{sout.strip()}")
+        if len(mismatches) >= max_mismatches_shown + 100:
+            break
+
+    lines = [f"Covered {covered} case(s) for param in [{param_min}, {param_max}] (last param tried: {last_param})."]
+    if stopped_early:
+        lines.append(f"Stopped early: time budget {time_budget_sec}s exhausted. Call again with param_min={(last_param or param_min) + 1}.")
+    if mismatches:
+        lines.append(f"MISMATCHES: {len(mismatches)} found. First {min(max_mismatches_shown, len(mismatches))}:")
+        for m in mismatches[:max_mismatches_shown]:
+            lines.append(m)
+    else:
+        lines.append("No mismatches in covered cases.")
+    return "\n".join(lines)
