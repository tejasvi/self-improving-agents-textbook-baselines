+    def _run_perf_check(self):
+        """
+        Run the performance/timing script at PERF_SCRIPT_PATH.
+        The script must print a final line starting with 'PERF_RESULT:'
+        (e.g. 'PERF_RESULT: PASS 1.23' or 'PERF_RESULT: FAIL <reason>').
+        Returns (passed, output_tail). A missing script, crash, timeout,
+        or FAIL result all count as not passed.
+        """
+        if not os.path.isfile(PERF_SCRIPT_PATH):
+            return False, f'(no perf script found at {PERF_SCRIPT_PATH})'
+        try:
+            result = subprocess.run(
+                ['python3', PERF_SCRIPT_PATH],
+                timeout=PERF_TIMEOUT_SECONDS,
+                capture_output=True,
+            )
+        except subprocess.TimeoutExpired as e:
+            out = (e.stdout or b'').decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            err = (e.stderr or b'').decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+            tail = (out + err)[-PERF_OUTPUT_TAIL_CHARS:]
+            return False, f'PERF_RESULT: FAIL TIMEOUT (perf script exceeded {PERF_TIMEOUT_SECONDS}s)\n{tail}'
+        except OSError as e:
+            return False, f'(failed to run perf script: {e})'
+        stdout = result.stdout.decode(errors='replace')
+        stderr = result.stderr.decode(errors='replace')
+        output_tail = (stdout + ('\n' + stderr if stderr.strip() else ''))[-PERF_OUTPUT_TAIL_CHARS:]
+        sentinel_lines = [ln.strip() for ln in stdout.splitlines() if ln.strip().startswith(PERF_SENTINEL)]
+        if result.returncode != 0 or not sentinel_lines:
+            return False, output_tail
+        passed = sentinel_lines[-1].startswith(PERF_SENTINEL + ' PASS')
+        return passed, output_tail
+
