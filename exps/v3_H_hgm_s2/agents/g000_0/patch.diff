+    def _changed_files(self):
+        """
+        Return the list of file paths changed versus the base commit (tracked and untracked).
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        paths = []
+        for line in diff.splitlines():
+            path = None
+            if line.startswith('diff --git a/'):
+                # Format: "diff --git a/<path> b/<path>"
+                rest = line[len('diff --git a/'):]
+                path = rest.split(' b/', 1)[0]
+            elif line.startswith('+++ b/'):
+                path = line[len('+++ b/'):].strip()
+            if path and path != '/dev/null' and path not in paths:
+                paths.append(path)
+        return paths
+
+    def _has_source_edits(self):
+        """
+        Return True if at least one changed file is not a test file.
+        """
+        for path in self._changed_files():
+            lower = path.lower()
+            basename = os.path.basename(lower)
+            is_test = 'test' in lower or 'spec' in lower or basename.startswith('test_')
+            if not is_test:
+                return True
+        return False
+
