+    CANDIDATE_STRATEGY_HINTS = [
+        "Reduce the DP state dimension: find which dimension can be eliminated or compressed, and rewrite the recurrence over fewer states.",
+        "Vectorize the hot loop with numpy (or restructure the loops so the inner work is array operations), keeping exact integer semantics.",
+        "Exploit the problem structure: monotonicity, prefix/suffix minimums or maximums, sorting, two pointers, or a greedy argument that is proven from the definition.",
+        "Change the algorithm entirely: use a different decomposition (e.g. divide and conquer, sqrt decomposition, or precomputed tables) that is provably within the time limit for the maximum constraints.",
+    ]
