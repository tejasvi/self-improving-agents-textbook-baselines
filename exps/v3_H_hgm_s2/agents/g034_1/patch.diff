+    def _correctness_suite(self, solution_path, oracle_dir, samples):
+        """
+        Full correctness gate: samples (when extracted) and differential tests (300 seeds, checker.py when present).
+        Returns (ok, report). ok is True only if every enabled check passes.
+        """
+        if not samples and not oracle_dir:
+            return True, "no samples or oracle available; nothing verified"
+        parts = []
+        ok = True
+        if samples:
+            srep, sok = self._run_samples(solution_path, samples)
+            parts.append(srep)
+            ok = ok and sok
+        if oracle_dir:
+            drep, nfail = self._run_differential(solution_path, oracle_dir, n_tests=300)
+            parts.append(drep)
+            ok = ok and nfail == 0
+        return ok, "\n\n".join(parts)
