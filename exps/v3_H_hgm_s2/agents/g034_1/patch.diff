+        if not cpath or not os.path.exists(cpath):
+            return None
+        fd_in, in_path = tempfile.mkstemp(prefix="_pin_", suffix=".txt", dir=oracle_dir)
+        fd_out, out_path = tempfile.mkstemp(prefix="_pout_", suffix=".txt", dir=oracle_dir)
+        try:
+            with os.fdopen(fd_in, "w") as f:
+                f.write(payload)
