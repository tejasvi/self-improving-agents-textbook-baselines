+import sys
+
+
+def main():
+    # Constraints: 1 <= N <= 2*10^5, 1 <= X <= 2*10^5, 1 <= A_i <= X
+    # Input: line 1 = "N X", line 2 = N integers A_1..A_N
+    MAXN = 200000
+    MAXX = 200000
+
+    data = sys.stdin.buffer.read().split()
+    if len(data) < 2:
+        print("FAIL expected at least N and X")
+        return 1
+
+    try:
+        n = int(data[0])
+        x = int(data[1])
+    except ValueError:
+        print("FAIL non-integer token present")
+        return 1
+
+    if not (1 <= n <= MAXN):
+        print("FAIL N=%d out of range [1, %d]" % (n, MAXN))
+        return 1
+    if not (1 <= x <= MAXX):
+        print("FAIL X=%d out of range [1, %d]" % (x, MAXX))
+        return 1
+
+    if len(data) != 2 + n:
+        print("FAIL expected exactly %d array values, got %d" % (n, len(data) - 2))
+        return 1
+
+    try:
+        arr = list(map(int, data[2:]))
+    except ValueError:
+        print("FAIL non-integer token present")
+        return 1
+
+    if min(arr) < 1 or max(arr) > x:
+        # Rare path: locate the first offending index for a precise message.
+        for i, a in enumerate(arr):
+            if not (1 <= a <= x):
+                print("FAIL A_%d=%d violates 1 <= A_i <= X=%d" % (i + 1, a, x))
+                return 1
+
+    print("OK")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except Exception as e:
+        print("FAIL unexpected error: %s" % e)
+        sys.exit(1)
