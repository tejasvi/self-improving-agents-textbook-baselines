+    def _take_snapshot(self, solution_path):
+        """
+        Copy solution_path into a snapshot directory under /tmp and remember (orig path, copy, hash).
+        """
+        if not self._snapshot_dir:
+            self._snapshot_dir = tempfile.mkdtemp(prefix="agent_snapshot_", dir="/tmp")
+        dst = os.path.join(self._snapshot_dir, "best_" + os.path.basename(solution_path))
+        shutil.copyfile(solution_path, dst)
+        self._best_snapshot = (solution_path, dst, self._file_hash(dst))
+        safe_log(f"[gate] snapshot updated from {solution_path} (hash {self._best_snapshot[2][:12]}).")
+
+    def _checkpoint(self, solution_path):
+        """
+        Run the correctness suite on solution_path. When it passes, snapshot the file.
+        Returns (ok, report).
+        """
+        if not solution_path or not os.path.exists(solution_path):
+            return False, f"Solution file not found: {solution_path}"
+        ok, report = self._correctness_suite(solution_path, self._oracle_dir, self._samples)
+        if ok:
+            self._take_snapshot(solution_path)
+        return ok, report
+
+    def _restore_snapshot(self, reason):
+        """
+        Roll the solution file back to the last passing snapshot. Returns True when restored.
+        """
+        if not self._best_snapshot:
+            safe_log(f"[gate] rollback requested ({reason}) but no passing snapshot exists.")
+            return False
+        orig, snap, snap_hash = self._best_snapshot
+        if self._file_hash(snap) != snap_hash:
+            safe_log("[gate] snapshot file is corrupted; refusing to roll back.")
+            return False
+        shutil.copyfile(snap, orig)
+        safe_log(f"[gate] ROLLBACK to last passing snapshot for {orig} ({reason}).")
+        return True
+
+    def _gate(self, solution_path, label, task):
