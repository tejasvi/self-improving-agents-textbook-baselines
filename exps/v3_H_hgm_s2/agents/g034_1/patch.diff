+            ok = proc.returncode == 0 and bool(first) and first[0].startswith("OK")
+            return ok, (proc.stdout or proc.stderr or "").strip()[-500:]
+        except subprocess.TimeoutExpired:
+            return False, "checker timed out"
+        finally:
+            for p in (in_path, out_path):
