+    def _validate_stdin_input(self, text, oracle_dir=None):
+        """
+        Run the oracle's validate_input.py on one stdin-style input.
+        Returns (ok, reason). When no validator exists, returns (True, "no validator").
+        """
+        oracle_dir = oracle_dir or self._oracle_dir
+        vpath = os.path.join(oracle_dir, "validate_input.py") if oracle_dir else None
+        if not vpath or not os.path.exists(vpath):
+            return True, "no validator"
+        fd, in_path = tempfile.mkstemp(prefix="_val_", suffix=".txt", dir=oracle_dir)
+        try:
+            with os.fdopen(fd, "w") as f:
+                f.write(text)
+            proc = subprocess.run(["python3", vpath, in_path], capture_output=True, text=True,
+                                  timeout=20, cwd=oracle_dir)
+            first = (proc.stdout or "").strip().splitlines()
+            ok = proc.returncode == 0 and bool(first) and first[0].startswith("OK")
+            reason = (proc.stdout or proc.stderr or "").strip()[-500:]
+            return ok, reason
+        except subprocess.TimeoutExpired:
+            return False, "validator timed out"
+        finally:
+            try:
+                os.remove(in_path)
+            except OSError:
+                pass
