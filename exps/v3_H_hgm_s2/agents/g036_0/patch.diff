diff --git a/validator.py b/validator.py
new file mode 100644
index 0000000..f4d165d
--- /dev/null
+++ b/validator.py
@@ -0,0 +1,42 @@
+import sys
+
+
+def fail(msg):
+    sys.stderr.write(msg + "\n")
+    sys.exit(1)
+
+
+def main():
+    data = sys.stdin.read().split()
+    if len(data) < 2:
+        fail("input has fewer than 2 tokens (expected N and X)")
+    try:
+        n = int(data[0])
+        x = int(data[1])
+    except ValueError:
+        fail("N and X must be integers")
+
+    if not (1 <= n <= 10**6):
+        fail(f"N={n} out of range [1, 10^6]")
+    if not (1 <= x <= 10**6):
+        fail(f"X={x} out of range [1, 10^6]")
+
+    if len(data) != 2 + n:
+        fail(f"expected exactly {n} array values after N and X, got {len(data) - 2}")
+
+    for idx in range(n):
+        tok = data[2 + idx]
+        try:
+            a = int(tok)
+        except ValueError:
+            fail(f"A_{idx + 1}={tok!r} is not an integer")
+        if not (1 <= a <= 10**6):
+            fail(f"A_{idx + 1}={a} out of range [1, 10^6]")
+        if a > x:
+            fail(f"A_{idx + 1}={a} exceeds X={x}")
+
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
