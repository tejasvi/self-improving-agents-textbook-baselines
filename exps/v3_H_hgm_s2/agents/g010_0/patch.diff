+def _run_stress_test(path=STRESS_TEST_PATH, timeout=STRESS_TEST_TIMEOUT_SECONDS):
+    """
+    Run the stress/sample test script. Returns (passed, truncated_raw_output).
+    Output is passed through verbatim (not parsed).
+    """
+    try:
+        proc = subprocess.run(
+            [sys.executable, path],
+            timeout=timeout, capture_output=True, text=True, errors='replace',
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b'').decode(errors='replace')
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b'').decode(errors='replace')
+        return False, _truncate_output(f"TIMEOUT after {timeout}s\n{out}\n{err}")
+    output = (proc.stdout or '') + (proc.stderr or '')
+    passed = proc.returncode == 0 and 'ALL_TESTS_PASSED' in (proc.stdout or '')
+    return passed, _truncate_output(output)
