+        "description": """Oracle-driven formula discovery and checking.
+
+Two modes:
+* mode="table": runs an oracle over a small parameter window and prints the answers as a compact grid, so you can look for a pattern. The oracle is called as `<oracle_cmd> <x>` (1-D window) or `<oracle_cmd> <x> <y>` (2-D window) and must print the answer on stdout. Output is capped at about 3000 characters.
+* mode="fit": runs a candidate Python solution (reads stdin, prints answer) against the oracle on generated small cases at several scales. The generator `<gen_cmd> <seed>` prints one input (stdin text); the current scale is passed in the environment variable FORMULA_SCALE (the values in `scales`, e.g. the main size parameter K). Reports the pass count, the smallest mismatching cases, and mismatch rates grouped by features of the input values: residue mod K, sign, and block index (floor division by K).
+
+Use `table` to find the pattern on a small window, then `fit` to test a candidate formula. Use scaled-down instances to explore; the final answer must still be an O(1) or O(log) per-case formula (no brute force) that matches the oracle at several scales.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "mode": {
+                    "type": "string",
+                    "enum": ["table", "fit"],
+                    "description": "'table' prints an oracle grid over a window; 'fit' checks a candidate solution against the oracle at several scales."
+                },
+                "oracle_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted oracle. In table mode it is called as '<oracle_cmd> <x>' or '<oracle_cmd> <x> <y>' and prints the answer. In fit mode it reads the input from stdin and prints the answer."
+                },
+                "candidate_path": {
+                    "type": "string",
+                    "description": "Path to the candidate Python solution file (reads stdin, writes stdout). Used in fit mode only."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command called as '<gen_cmd> <seed>' that prints one random small input to stdout. The scale is in env var FORMULA_SCALE. Used in fit mode only."
+                },
+                "scales": {
+                    "type": "string",
+                    "description": "Comma-separated small values of the main size parameter K to test, e.g. '2,3,5,8'. Used in fit mode. Default '2,3,4,5,6,7,8'."
+                },
+                "cases_per_scale": {
+                    "type": "integer",
+                    "description": "Number of seeded random cases per scale in fit mode. Default 40."
+                },
+                "x_range": {
+                    "type": "string",
+                    "description": "Table mode: window for the first argument as 'lo:hi' (hi exclusive), e.g. '0:8'. Default '0:8'."
+                },
+                "y_range": {
+                    "type": "string",
+                    "description": "Table mode: optional window for the second argument as 'lo:hi' (hi exclusive). Leave empty for a one-dimensional oracle."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Per-run timeout in seconds for each program call. Default 5."
+                }
+            },
+            "required": ["mode", "oracle_cmd"]
+        }
+    }
+
+
+def _run(cmd, stdin_text=None, timeout=5, env=None):
+    try:
+        proc = subprocess.run(cmd, shell=True, input=stdin_text, capture_output=True,
+                              text=True, timeout=timeout, env=env,
+                              stdin=None if stdin_text is not None else subprocess.DEVNULL)
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired:
+        return None, "", "", True
+
+
+def _parse_window(spec, default):
+    spec = (spec or "").strip() or default
+    m = re.fullmatch(r"\s*(-?\d+)\s*:\s*(-?\d+)\s*", spec)
+    if not m:
+        raise ValueError(f"bad window '{spec}', expected 'lo:hi'")
+    lo, hi = int(m.group(1)), int(m.group(2))
+    if hi <= lo:
+        raise ValueError(f"empty window '{spec}'")
+    return lo, hi
+
+
+def _table(oracle_cmd, x_range, y_range, timeout):
+    try:
+        xlo, xhi = _parse_window(x_range, "0:8")
+        two_d = bool((y_range or "").strip())
+        if two_d:
+            ylo, yhi = _parse_window(y_range, "0:8")
+    except ValueError as e:
+        return f"formula_fit table error: {e}"
+
+    def ask(*args):
+        cmd = f"{oracle_cmd} " + " ".join(str(a) for a in args)
+        code, out, err, to = _run(cmd, None, timeout)
+        if to:
+            return "T"
+        if code != 0:
+            return "E"
+        return out.strip() or "?"
+
+    lines = []
+    if not two_d:
+        vals = [(x, ask(x)) for x in range(xlo, xhi)]
+        lines.append("x: " + " ".join(str(x) for x, _ in vals))
+        lines.append("f: " + " ".join(v for _, v in vals))
+    else:
+        grid = {(x, y): ask(x, y) for x in range(xlo, xhi) for y in range(ylo, yhi)}
+        cell_w = max([len(str(xhi - 1)), len(str(yhi - 1))] + [len(v) for v in grid.values()]) + 1
+        lines.append("y\\x".ljust(6) + "".join(str(x).rjust(cell_w) for x in range(xlo, xhi)))
+        for y in range(ylo, yhi):
+            lines.append(str(y).ljust(6) + "".join(grid[(x, y)].rjust(cell_w) for x in range(xlo, xhi)))
+    text = "\n".join(lines)
+    if len(text) > MAX_TABLE_CHARS:
+        text = text[:MAX_TABLE_CHARS] + "\n...(table truncated; narrow the window)..."
+    return "TABLE:\n" + text
+
+
+def _features(text, scale):
+    """Integers in an input, plus simple feature keys for each of them:
+    residue mod K, sign, and block index floor(v/K)."""
+    nums = [int(t) for t in re.findall(r"-?\d+", text)]
+    k = scale if scale and scale > 0 else 1
+    feats = set()
+    for v in nums:
+        feats.add(("res", v % k))
+        feats.add(("sign", "neg" if v < 0 else ("zero" if v == 0 else "pos")))
+        feats.add(("block", v // k))
+    pattern = tuple(v % k == 0 for v in nums)
+    return feats, pattern
+
+
+def _top_rates(tot, bad, label, n=8):
+    rows = []
+    for key, t in tot.items():
+        b = bad.get(key, 0)
+        if b:
+            rows.append((b / t, b, t, key))
+    rows.sort(key=lambda r: (-r[0], -r[1]))
+    if not rows:
+        return f"no mismatching {label} values."
+    parts = [f"{label} {k}: {b}/{t} ({rate:.0%})" for rate, b, t, k in rows[:n]]
+    return "; ".join(parts)
+
+
+def _fit(candidate_path, oracle_cmd, gen_cmd, scales_spec, cases_per_scale, timeout):
+    if not candidate_path:
+        return "formula_fit fit error: candidate_path is required."
+    try:
+        scales = [int(s) for s in (scales_spec or "2,3,4,5,6,7,8").split(",") if s.strip()]
+    except ValueError:
+        return "formula_fit fit error: scales must be comma-separated integers."
+    if not scales:
+        return "formula_fit fit error: no scales given."
+    try:
+        cases_per_scale = int(cases_per_scale) if cases_per_scale else 40
+    except (TypeError, ValueError):
+        cases_per_scale = 40
+
+    total = 0
+    passed = 0
+    failures = []  # (scale, seed, input, expected, actual, reason)
+    feat_total = Counter()
+    feat_bad = Counter()
+    pat_total = Counter()
+    pat_bad = Counter()
+
+    for scale in scales:
+        env = dict(os.environ)
+        env["FORMULA_SCALE"] = str(scale)
+        for seed in range(cases_per_scale):
+            gcode, gout, gerr, gto = _run(f"{gen_cmd} {seed}", None, timeout, env=env)
+            if gto or gcode != 0 or not gout.strip():
+                why = "timeout" if gto else (gerr.strip()[:300] or f"exit {gcode}, empty output")
+                return f"Generator failed at scale={scale}, seed={seed}: {why}."
+            test_input = gout if gout.endswith("\n") else gout + "\n"
+            ocode, oout, oerr, oto = _run(oracle_cmd, test_input, timeout, env=env)
+            if oto or ocode != 0:
+                return (f"ORACLE FAILED at scale={scale}, seed={seed} (timeout={oto}, exit={ocode}): "
+                        f"{oerr.strip()[:300]}\n--- input ---\n{test_input}")
+            total += 1
+            scode, sout, serr, sto = _run(f"python3 {candidate_path}", test_input, timeout, env=env)
+            ok = (not sto) and scode == 0 and sout.split() == oout.split()
+            feats, pattern = _features(test_input, scale)
+            for key in feats:
+                feat_total[key] += 1
+                if not ok:
+                    feat_bad[key] += 1
+            pat_total[pattern] += 1
+            if not ok:
+                pat_bad[pattern] += 1
+            if ok:
+                passed += 1
+                continue
+            if sto:
+                reason = "solution TIMEOUT"
+            elif scode != 0:
+                reason = f"solution exit {scode}: {serr.strip()[:300]}"
+            else:
+                reason = "output mismatch"
+            failures.append((scale, seed, test_input, oout, sout, reason))
+
+    if not failures:
+        return f"FORMULA FIT PASSED: {passed}/{total} cases matched the oracle at scales {scales}."
+
+    failures.sort(key=lambda f: (len(f[2]), f[0]))
+    lines = [f"FORMULA FIT FAILED: passed {passed}/{total} cases at scales {scales}; {len(failures)} mismatching."]
+    lines.append(f"Smallest {min(MAX_SHOWN_MISMATCHES, len(failures))} mismatches:")
+    for scale, seed, test_input, expected, actual, reason in failures[:MAX_SHOWN_MISMATCHES]:
+        lines.append(f"--- scale={scale} seed={seed} ({reason}) input: {test_input.strip()!r}")
+        lines.append(f"    expected: {expected.strip()[:200]!r}")
+        lines.append(f"    actual:   {actual.strip()[:200]!r}")
+    lines.append("Mismatch rates (mismatching cases / all cases containing the feature), top entries:")
+    lines.append(_top_rates(feat_total, feat_bad, "feature"))
+    lines.append(_top_rates(pat_total, pat_bad, "(sx%K==0, sy%K==0, ...) pattern"))
+    return "\n".join(lines)
+
+
+def tool_function(mode, oracle_cmd, candidate_path=None, gen_cmd=None, scales=None,
+                  cases_per_scale=None, x_range=None, y_range=None, timeout_sec=None):
+    try:
+        timeout = int(timeout_sec) if timeout_sec else 5
+    except (TypeError, ValueError):
+        timeout = 5
+    mode = (mode or "").strip().lower()
+    if mode == "table":
+        return _table(oracle_cmd, x_range or "", y_range or "", timeout)
+    if mode == "fit":
+        if not gen_cmd:
+            return "formula_fit fit error: gen_cmd is required in fit mode."
+        return _fit(candidate_path, oracle_cmd, gen_cmd, scales, cases_per_scale, timeout)
+    return f"formula_fit error: unknown mode '{mode}' (use 'table' or 'fit')."
