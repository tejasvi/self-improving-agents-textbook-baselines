+    def _classify_problem(self):
+        """
+        Ask the LLM to classify the problem statement (interactive / multi-test / notes).
+        Stores the result on self.problem_info and returns it. Defaults to non-interactive on failure.
+        """
+        prompt = f"""Classify the competitive programming problem below. Return ONLY a JSON object (no prose) with keys:
+{{"interactive": <true if the program must exchange queries/answers with a live judge via stdin/stdout, else false>,
+  "multi_test": <true if the input begins with a number of test cases, else false>,
+  "notes": "<one short sentence on any unusual I/O format, or empty string>"}}
+
+<problem_statement>
+{self.problem_statement}
+</problem_statement>
+"""
+        info = {"interactive": False, "multi_test": False, "notes": ""}
+        try:
+            text = simple_chat(prompt, model=self.code_model, max_tokens=2048, logging=safe_log) or ""
+        except Exception as e:
+            safe_log(f"[classify] LLM call failed, defaulting to non-interactive: {e}")
+            text = ""
+        candidates = []
+        fence = re.search(r"```(?:json)?\s*\n(.*?)```", text, re.DOTALL)
+        if fence:
+            candidates.append(fence.group(1))
+        start, end = text.find("{"), text.rfind("}")
+        if start != -1 and end > start:
+            candidates.append(text[start:end + 1])
+        for cand in candidates:
+            try:
+                data = json.loads(cand, strict=False)
+            except Exception:
+                continue
+            if isinstance(data, dict):
+                info["interactive"] = bool(data.get("interactive", False))
+                info["multi_test"] = bool(data.get("multi_test", False))
+                info["notes"] = str(data.get("notes", "") or "")
+                break
+        self.problem_info = info
+        safe_log(f"[classify] {info}")
+        return info
+
+    def _is_interactive(self):
+        return bool(self.problem_info.get("interactive", False))
+
