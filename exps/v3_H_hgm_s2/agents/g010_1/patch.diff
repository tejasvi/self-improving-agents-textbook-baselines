+def _is_empty_block(block):
+    if isinstance(block, dict):
+        btype = block.get('type')
+        text = block.get('text')
+    else:
+        btype = getattr(block, 'type', None)
+        text = getattr(block, 'text', None)
+    return btype == 'text' and not (text or '').strip()
+
+def sanitize_history(messages):
+    """
+    Drop assistant messages whose content is empty or only empty/whitespace text blocks,
+    and merge consecutive user messages by concatenating their content lists.
+    """
+    cleaned = []
+    for msg in messages or []:
+        if not isinstance(msg, dict):
+            cleaned.append(msg)
+            continue
+        content = msg.get('content')
+        if msg.get('role') == 'assistant':
+            if isinstance(content, str):
+                if not content.strip():
+                    continue
+            elif not content or all(_is_empty_block(b) for b in content):
+                continue
+        if (
+            cleaned
+            and isinstance(cleaned[-1], dict)
+            and msg.get('role') == 'user'
+            and cleaned[-1].get('role') == 'user'
+            and isinstance(cleaned[-1].get('content'), list)
+            and isinstance(content, list)
+        ):
+            cleaned[-1] = {**cleaned[-1], 'content': cleaned[-1]['content'] + content}
+            continue
+        cleaned.append(msg)
+    return cleaned
+
