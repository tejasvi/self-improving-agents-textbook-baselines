+def simple_chat(prompt, model=CLAUDE_MODEL, max_tokens=8192, logging=print):
+    """
+    Plain single-turn LLM call WITHOUT any tools. Returns the response text ('' on failure).
+    """
+    try:
+        client, client_model = create_client(model)
+        if 'claude' in model:
+            response = client.messages.create(
+                model=client_model,
+                max_tokens=max_tokens,
+                messages=[{"role": "user", "content": [{"type": "text", "text": prompt}]}],
+            )
+            return "".join(block.text for block in response.content if hasattr(block, "text"))
+        elif model.startswith('o3-'):
+            response = client.responses.create(model=client_model, input=prompt)
+            return response.output_text or ""
+        else:
+            response = client.chat.completions.create(
+                model=client_model,
+                messages=[{"role": "user", "content": prompt}],
+            )
+            return response.choices[0].message.content or ""
+    except Exception as e:
+        logging(f"Error in simple_chat: {str(e)}")
+        return ""
