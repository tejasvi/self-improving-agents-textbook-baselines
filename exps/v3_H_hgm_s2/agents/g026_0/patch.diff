+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        files = []
+        for f in result.stdout.decode(errors="replace").splitlines():
+            f = f.strip()
+            if not f or _is_test_file(f) or self._is_framework_file(f):
+                continue
+            if f.lower().endswith((".md", ".rst", ".txt")) or "readme" in f.lower():
+                continue
+            files.append(f)
+        py_files = [f for f in files if f.endswith(".py")]
+        for pref in ("solution.py", "main.py"):
