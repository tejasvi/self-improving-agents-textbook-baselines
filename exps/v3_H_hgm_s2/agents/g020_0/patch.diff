diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..49e3997
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,85 @@
+import random
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference on random inputs.
+
+* `generator_code` is Python code that is executed once per test; it must set a variable named `INPUT` to the full stdin text for that test (the `random` module is available). Example: "n = random.randint(1, 5)\\nINPUT = f'{n}\\\\n' + ' '.join(str(random.randint(1, 9)) for _ in range(n)) + '\\\\n'"
+* `solution_cmd` and `brute_cmd` are shell commands that read the input from stdin and print the answer to stdout (e.g. "python3 /tmp/sol.py" and "python3 /tmp/brute.py").
+* Outputs are compared after stripping trailing whitespace on each line.
+* Returns "all passed" if every test matches, otherwise the first differing input together with both outputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the solution under test, reading stdin and writing stdout."
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted brute-force reference, reading stdin and writing stdout."
+                },
+                "generator_code": {
+                    "type": "string",
+                    "description": "Python code run per test that sets a variable INPUT (str) with the stdin text."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run."
+                }
+            },
+            "required": ["solution_cmd", "brute_cmd", "generator_code", "num_tests"]
+        }
+    }
+
+
+def _normalize(text):
+    return "\n".join(line.rstrip() for line in text.strip().splitlines())
+
+
+def _run(cmd, inp, timeout):
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=inp, capture_output=True, text=True, timeout=timeout
+        )
+    except subprocess.TimeoutExpired:
+        return None, "TIMEOUT"
+    out = proc.stdout
+    if proc.returncode != 0:
+        out += f"\n[exit code {proc.returncode}] stderr: {proc.stderr[-500:]}"
+    return out, None
+
+
+def tool_function(solution_cmd, brute_cmd, generator_code, num_tests, timeout=10):
+    num_tests = int(num_tests)
+    rng = random.Random()
+    for i in range(num_tests):
+        namespace = {"random": rng}
+        try:
+            exec(generator_code, namespace)
+        except Exception as e:
+            return f"Generator error: {e}"
+        inp = namespace.get("INPUT")
+        if not isinstance(inp, str):
+            return "Generator error: generator_code must set a string variable INPUT"
+        if not inp.endswith("\n"):
+            inp += "\n"
+
+        sol_out, sol_err = _run(solution_cmd, inp, timeout)
+        if sol_err:
+            return f"Test {i + 1} failed: solution {sol_err} on input:\n{inp}"
+        brute_out, brute_err = _run(brute_cmd, inp, timeout)
+        if brute_err:
+            return f"Brute-force {brute_err} on test {i + 1} input:\n{inp}"
+
+        if _normalize(sol_out) != _normalize(brute_out):
+            return (
+                f"Mismatch on test {i + 1}.\n"
+                f"Input:\n{inp}\n"
+                f"Solution output:\n{sol_out}\n"
+                f"Brute-force output:\n{brute_out}"
+            )
+    return f"all passed ({num_tests} tests)"
