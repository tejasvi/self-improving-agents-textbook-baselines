+def _is_empty_response(msg_history):
+    """
+    True if the final assistant message has no non-whitespace text and no
+    tool_use/function_call blocks (i.e. the model replied with nothing actionable).
+    """
+    last = None
+    for msg in msg_history or []:
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role == 'assistant' or (not isinstance(msg, dict) and getattr(msg, 'type', None) == 'message'):
+            last = msg
+        elif not isinstance(msg, dict) and getattr(msg, 'output', None) is not None:
+            last = msg
+    if last is None:
+        return True
+    if isinstance(last, dict):
+        content = last.get('content', [])
+    else:
+        content = getattr(last, 'content', None)
+        if content is None:
+            content = getattr(last, 'output', None) or []
+    if isinstance(content, str):
+        return not content.strip()
+    has_text = False
+    for block in content or []:
+        btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+        if btype in ('tool_use', 'function_call'):
+            return False
+        if btype == 'text':
+            text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if text and text.strip():
+                has_text = True
+        if btype == 'output_text':
+            text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if text and text.strip():
+                has_text = True
+    return not has_text
+
