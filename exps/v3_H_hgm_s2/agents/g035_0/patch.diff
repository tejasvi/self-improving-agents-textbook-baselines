+    def _run_perf(self, solution_path, driver_path, timeout=PERF_TIMEOUT_SECONDS):
+        """
+        Run the perf driver on the solution with a hard timeout (the whole process group is
+        killed on timeout). Returns (raw_report, passed): passed is True only if the driver
+        finished within the timeout with exit code 0. The report is raw text, not parsed.
+        """
+        if not solution_path or not os.path.exists(solution_path):
+            return f"Solution file not found: {solution_path}", False
+        if not driver_path or not os.path.exists(driver_path):
+            return f"Perf driver not found: {driver_path}", False
+        start = time.time()
+        proc = subprocess.Popen(
+            ["python3", driver_path, solution_path],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            cwd=self.git_tempdir, start_new_session=True,
+        )
+        try:
+            stdout, stderr = proc.communicate(timeout=timeout)
+            elapsed = time.time() - start
+            passed = proc.returncode == 0
+            status = "OK" if passed else f"FAILED (exit code {proc.returncode})"
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, 9)
+            except OSError:
+                proc.kill()
+            stdout, stderr = proc.communicate()
+            elapsed = time.time() - start
+            passed = False
+            status = f"TIMEOUT: exceeded {timeout} seconds"
+        report = (
+            f"=== Max-size perf run ({status}, elapsed {elapsed:.3f}s) ===\n"
+            f"--- driver stdout ---\n{stdout}\n"
+            f"--- driver stderr ---\n{stderr}\n"
+        )
+        return report, passed
+
