+    def _guess_target_file(self):
+        """
+        Return the most likely non-test file the solution should be written to.
+        Prefers placeholder/solution/main files tracked in git, then the only
+        non-README source file, using the extension for self.language.
+        """
+        ext_map = {
+            'python': '.py', 'cpp': '.cpp', 'java': '.java', 'go': '.go',
+            'rust': '.rs', 'javascript': '.js',
+        }
+        ext = ext_map.get(self.language, '.py')
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            files = [f for f in result.stdout.decode(errors='replace').splitlines() if f.strip()]
+        except Exception:
+            files = []
+        candidates = [f for f in files if not _is_test_file(f)]
+        preferred_names = ['solution', 'main', 'answer', 'sol', 'a']
+        for name in preferred_names:
+            for f in candidates:
+                if os.path.splitext(os.path.basename(f))[0].lower() == name and f.endswith(ext):
+                    return f
+        sources = [f for f in candidates if f.endswith(ext)]
+        if len(sources) == 1:
+            return sources[0]
+        if sources:
+            return sources[0]
+        return 'solution' + ext
+
+    @staticmethod
+    def _message_text_parts(msg):
+        """
+        Yield the text fragments of an assistant message, handling plain strings,
+        dict content blocks and SDK block objects.
+        """
+        if not isinstance(msg, dict):
+            msg = {'role': getattr(msg, 'role', None), 'content': getattr(msg, 'content', None)}
+        if msg.get('role') != 'assistant':
+            return
+        content = msg.get('content')
+        if isinstance(content, str):
+            yield content
+            return
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, str):
+                    yield block
+                    continue
+                if isinstance(block, dict):
+                    btype, text = block.get('type'), block.get('text')
+                else:
+                    btype, text = getattr(block, 'type', None), getattr(block, 'text', None)
+                if btype == 'text' and isinstance(text, str):
+                    yield text
+
+    def _extract_last_code_block(self, history):
+        """
+        Return the last fenced code block (prefers ```python) found in assistant
+        messages of `history`, or None if there is none. Blocks are taken in
+        message order; the last one wins.
+        """
+        import re
+        pattern = re.compile(r"```[ \t]*([A-Za-z0-9_+-]*)[ \t]*\n(.*?)```", re.DOTALL)
+        found = []
+        for msg in history or []:
+            for text in self._message_text_parts(msg):
+                for lang, body in pattern.findall(text):
+                    if lang.lower() in ('', 'python', 'py'):
+                        found.append(body)
+        if not found:
+            return None
+        return found[-1].strip('\n') + '\n'
+
