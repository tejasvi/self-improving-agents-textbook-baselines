+def _with_appended_user_text(messages, text):
+    """
+    Return a copy of messages with a text block appended as a user turn. If the
+    last message is already a user turn with list content (e.g. tool results),
+    the text is merged into it so that user turns do not become consecutive.
+    """
+    block = {"type": "text", "text": text}
+    if messages and messages[-1].get('role') == 'user' and isinstance(messages[-1].get('content'), list):
+        last = messages[-1]
+        return messages[:-1] + [{"role": "user", "content": list(last['content']) + [block]}]
+    return list(messages) + [{"role": "user", "content": [block]}]
