+    def _is_stub_solution(self, solution_path):
+        """
+        True if the solution file is missing, empty, has no function definitions,
+        or every function body is only a constant return/pass placeholder.
+        """
+        import ast
+        try:
+            with open(solution_path, 'r') as f:
+                code = f.read()
+        except OSError:
+            return True
+        if not code.strip():
+            return True
+        try:
+            tree = ast.parse(code)
+        except SyntaxError:
+            return False
+        funcs = [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]
+        if not funcs:
+            # A whole-program solution (reads stdin) is not a stub even without defs
+            reads_input = re.search(r"\binput\s*\(|sys\.stdin|\bstdin\b", code) is not None
+            return not reads_input
+        def is_placeholder(fn):
+            body = [st for st in fn.body if not (isinstance(st, ast.Expr) and isinstance(getattr(st, 'value', None), ast.Constant))]
+            if len(body) != 1:
+                return False
+            st = body[0]
+            if isinstance(st, ast.Pass):
+                return True
+            return isinstance(st, ast.Return) and (st.value is None or isinstance(st.value, ast.Constant))
+        return all(is_placeholder(fn) for fn in funcs)
