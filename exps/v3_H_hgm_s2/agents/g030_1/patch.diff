+    def _build_test_bank(self, n_small=300):
+        """
+        Build an independent test bank without looking at any candidate solution.
+        A tester-only agent writes /tmp/tb/brute.py, gen.py and gen_max.py. The harness runs
+        them. Brute-force outputs are the expected answers. Samples are authoritative.
+        Returns a list of {input, expected, kind} dicts.
+        """
+        tb_dir = "/tmp/tb"
+        os.makedirs(tb_dir, exist_ok=True)
+        for fname in ("brute.py", "gen.py", "gen_max.py"):
+            fpath = os.path.join(tb_dir, fname)
+            if os.path.exists(fpath):
+                os.remove(fpath)
+
+        tester_msg = f"""You are a TESTER for a competitive programming problem. Another agent writes the solution; you must NOT write the solution.
+
+<problem_description>
+{self.problem_statement}
+</problem_description>
+
+Write exactly these three Python 3 files using the editor tool (`create`) with ABSOLUTE paths. Do not write any file inside the repository {self.git_tempdir}. Do not write any solution file.
+
+1) /tmp/tb/brute.py: a simple, obviously correct exhaustive solution. Read stdin, print the output to stdout. Prefer clarity over speed. If the statement allows multiple valid answers, print the canonical one (lexicographically smallest / first in natural enumeration order) by exhaustive enumeration.
+2) /tmp/tb/gen.py: a seeded random generator of SMALL inputs. It takes one integer argument (the seed) from sys.argv[1], uses random.Random(seed), and prints one valid input to stdout. Bias toward edge cases: minimal sizes, duplicates, ties, equal values, boundary values. Keep inputs small enough for brute.py to finish in well under 1 second.
+3) /tmp/tb/gen_max.py: a generator of MAX-constraint inputs, i.e. the largest valid input allowed by the constraints (worst-case size for timing). It takes one integer seed from sys.argv[1] (optional) and prints one valid input to stdout.
+
+Requirements:
+- The inputs must follow the exact input format of the problem.
+- Use bash to run gen.py with a few seeds and brute.py on the output to verify they run without errors and produce output.
+- gen.py must not produce an input that brute.py cannot handle.
+- Do not reply with text only. Finish only after the three files are written to disk and verified.
+"""
+        safe_log("[tests] tester agent building test bank (brute.py, gen.py, gen_max.py).")
+        chat_with_agent(tester_msg, model=self.code_model, msg_history=[], logging=safe_log)
+
+        bank = []
+        samples = self._extract_samples()
+        for s in samples:
+            bank.append({"input": s["input"], "expected": s["output"], "kind": "sample"})
+        safe_log(f"[tests] {len(samples)} sample(s) extracted (authoritative).")
+
+        brute = os.path.join(tb_dir, "brute.py")
+        gen = os.path.join(tb_dir, "gen.py")
+        gen_max = os.path.join(tb_dir, "gen_max.py")
+
+        def run_py(args, stdin_text=None, timeout=10):
+            try:
+                proc = subprocess.run(
+                    ["python3"] + args, input=stdin_text, capture_output=True,
+                    text=True, timeout=timeout, cwd=tb_dir,
+                )
+            except subprocess.TimeoutExpired:
+                return None
+            if proc.returncode != 0:
+                return None
+            return proc.stdout
+
+        if os.path.exists(brute) and os.path.exists(gen):
+            kept, dropped = 0, 0
+            for seed in range(n_small):
+                inp = run_py([gen, str(seed)])
+                if not inp or not inp.strip():
+                    dropped += 1
+                    continue
+                expected = run_py([brute], stdin_text=inp)
+                if expected is None or not expected.strip():
+                    dropped += 1
+                    continue
+                bank.append({"input": inp, "expected": expected, "kind": "small"})
+                kept += 1
+            safe_log(f"[tests] small cases: kept {kept}, dropped {dropped} (gen/brute failure or timeout).")
+        else:
+            safe_log("[tests] brute.py or gen.py missing; no small generated cases.")
+
+        if os.path.exists(brute) and os.path.exists(gen_max):
+            inp = run_py([gen_max, "0"])
+            if inp and inp.strip():
+                # Max-size cases only need timing; expected output comes from brute if it finishes,
+                # otherwise the case is kept for timing with expected=None-free comparison skipped.
+                expected = run_py([brute], stdin_text=inp, timeout=10)
+                if expected is not None and expected.strip():
+                    bank.append({"input": inp, "expected": expected, "kind": "max"})
+                    safe_log("[tests] max-size case kept with brute reference.")
+                else:
+                    bank.append({"input": inp, "expected": None, "kind": "max"})
+                    safe_log("[tests] max-size case kept as timing-only (brute did not finish in 10s).")
+            else:
+                safe_log("[tests] max-size generator produced no input.")
+        else:
+            safe_log("[tests] gen_max.py missing; no max-size case.")
+
+        safe_log(f"[tests] test bank size: {len(bank)}.")
+        return bank
+
+    def _generate_candidate(self, i, prev_context, task, strategies, repair_rounds):
+        """
+        Ask the agent for candidate i, written to /tmp/cand_i/solution.py.
+        prev_context: text with earlier candidates' code and failure reports (may be empty).
+        Runs up to 2 repair rounds against the bank. Returns (path, score, report).
+        """
+        cand_dir = f"/tmp/cand_{i}"
+        os.makedirs(cand_dir, exist_ok=True)
+        cand_path = os.path.join(cand_dir, "solution.py")
+        if os.path.exists(cand_path):
+            os.remove(cand_path)
+        strategy = strategies[(i - 1) % len(strategies)]
+        context_block = prev_context if prev_context.strip() else "(none: this is the first attempt)"
+        gen_msg = f"""{task}
+
+You are writing CANDIDATE solution number {i}. Strategy hint: {strategy}
+
+Write the complete solution to the file {cand_path} using the editor tool (`create`, ABSOLUTE path). Do not edit files in the repository for this step. The file must read stdin and write stdout.
+
+Context from earlier candidates (code and raw failure reports). If an earlier approach failed, try a DIFFERENT approach:
+{context_block}
+
+Workflow:
+- Reason about the required complexity for the max constraints first.
+- Write {cand_path}.
+- Test it with bash on the sample inputs from the problem statement and fix any mismatch.
+- Do not reply with text only; the file must be written to disk.
+"""
+        chat_with_agent(gen_msg, model=self.code_model, msg_history=[], logging=safe_log)
+
+        score, report = self._run_candidate(cand_path, self._bank, max_tests=None)
+        safe_log(f"[candidate {i} round 0] {report.splitlines()[0] if report else ''}")
+        for rnd in range(1, repair_rounds + 1):
+            if self._is_perfect(score):
+                break
+            repair_msg = f"""{task}
+
+Candidate {i} was run against the test bank. Raw report (input, expected output, actual output, stderr, runtime for the first failing cases):
+
+{report}
+
+Fix {cand_path} with the editor tool (`edit` or `create`, ABSOLUTE path). Use the failures above to diagnose the cause. Check for timeouts (a too-slow algorithm needs a better complexity). Verify with bash on the sample inputs and any failing input. Do not reply with text only; the file must be fixed on disk.
+"""
+            chat_with_agent(repair_msg, model=self.code_model, msg_history=[], logging=safe_log)
+            new_score, new_report = self._run_candidate(cand_path, self._bank, max_tests=None)
+            safe_log(f"[candidate {i} round {rnd}] {new_report.splitlines()[0] if new_report else ''}")
+            score, report = new_score, new_report
+        return cand_path, score, report
+
+    def _select_and_apply(self, candidates):
+        """
+        candidates: list of (path, score, report). Pick the max score (ties keep the earliest,
+        so candidate 0 wins ties). Copy the winner into the target repo file.
+        Returns the chosen (path, score) or None.
+        """
+        valid = [c for c in candidates if c[0] and os.path.exists(c[0])]
+        if not valid:
+            safe_log("[select] no candidate file exists; nothing to apply.")
+            return None
+        best = valid[0]
+        for c in valid[1:]:
+            if c[1] > best[1]:
+                best = c
+        safe_log(f"[select] best score {best[1]} from {best[0]}")
+
+        target = None
+        named = re.findall(r"[\w./-]+\.py", self.problem_statement or "")
+        for name in named:
+            p = os.path.join(self.git_tempdir, name)
+            if os.path.exists(p) and not _is_test_file(name):
+                target = p
+                break
+        if target is None:
+            target = self._solution_path()
+        if target is None:
+            changed = self._changed_files()
+            if changed:
+                target = os.path.join(self.git_tempdir, changed[0])
+        if target is None:
+            target = os.path.join(self.git_tempdir, "solution.py")
+
+        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
+        shutil.copyfile(best[0], target)
+        safe_log(f"[select] applied {best[0]} -> {target}")
+        return best[0], best[1]
+
