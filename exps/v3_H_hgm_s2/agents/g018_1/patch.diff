+    def _direct_write_fallback(self, task):
+        """
+        Last-resort, tool-less write: ask the model for the complete target file
+        and write the extracted code block to disk. Returns the written path or None.
+        """
+        # 1) Determine the target file
+        tracked = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).stdout.decode(errors='replace').splitlines()
+        tracked_src = [
+            f for f in tracked
+            if f.strip() and not _is_test_file(f)
+            and not os.path.basename(f).upper().startswith('README')
+        ]
+        target = None
+        for name in re.findall(r'`([\w\-./]+\.\w+)`', self.problem_statement or ''):
+            if _is_test_file(name) or os.path.basename(name).upper().startswith('README'):
+                continue
+            if name in tracked_src:
+                target = name
+                break
+            if target is None and name.endswith('.py'):
+                target = name
+        if target is None and len(tracked_src) == 1:
+            target = tracked_src[0]
+        if target is None:
+            safe_log("[fallback] could not determine target file; skipping direct write.")
+            return None
+        safe_log(f"[fallback] target file: {target}")
+
+        # 2) Read current contents
+        path = os.path.join(self.git_tempdir, target)
+        current = ""
+        if os.path.isfile(path):
+            with open(path, 'r', errors='replace') as f:
+                current = f.read()
+        safe_log(f"[fallback] read {len(current)} chars from {target}")
+
+        # 3) Ask the model (tool-less) for the complete file
+        prompt = f"""{task}
+
+Current contents of `{target}`:
+```python
+{current}
+```
+
+Think briefly. Then output ONLY the complete file for `{target}` in one ```python fenced block, with no other code blocks.
+"""
+        response = simple_chat(prompt, model=self.code_model, max_tokens=32000, logging=safe_log)
+        safe_log(f"[fallback] model response length: {len(response or '')}")
+
+        # 4) Extract the last fenced block and write it
+        blocks = re.findall(r"```(?:python|py)?[ \t]*\n(.*?)```", response or '', re.DOTALL)
+        code = blocks[-1] if blocks else ""
+        if not code.strip():
+            safe_log("[fallback] no non-empty code block in response; file not written.")
+            return None
+        os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
+        with open(path, 'w') as f:
+            f.write(code if code.endswith('\n') else code + '\n')
+        safe_log(f"[fallback] wrote {len(code)} chars to {target}")
+        return target
+
