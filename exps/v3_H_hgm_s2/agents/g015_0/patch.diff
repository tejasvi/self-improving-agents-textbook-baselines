index 0000000..caed1f0
--- /dev/null
+++ b/tools/stdin_replay.py
@@ -0,0 +1,129 @@
+import subprocess
+import sys
+import threading
+import time
+
+MAX_OUTPUT_CHARS = 20000
+
+
+def tool_info():
+    return {
+        "name": "stdin_replay",
+        "description": """Replay a static stdin transcript against a Python solution file, as a grader would.\n
+* Runs `python3 solution_path` with the whole `stdin_text` piped in (mode 'flat', default), or line by line with small delays (mode 'lines').\n
+* Use mode 'flat' to check that a program reads all of its input as one plain stream (e.g. several judge answers on one line, or all answers on separate lines).\n
+* Returns the exit code, whether the run timed out, the full stdout, and the full stderr (including any traceback).\n
+* Each call is independent; no judge is involved, so the transcript must contain all answers the program will read.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "The full stdin content to feed to the program in one go."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the run (default 10)."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["flat", "lines"],
+                    "description": "'flat' pipes the whole stdin_text at once (default); 'lines' feeds it one line at a time with small delays."
+                }
+            },
+            "required": ["solution_path", "stdin_text"]
+        }
+    }
+
+
+def _decode(data):
+    if data is None:
+        return ""
+    if isinstance(data, bytes):
+        return data.decode(errors="replace")
+    return str(data)
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + f"\n...<truncated {len(text) - MAX_OUTPUT_CHARS} chars>"
+    return text
+
+
+def _format(exit_code, timed_out, stdout, stderr):
+    return (
+        f"exit_code: {exit_code}\n"
+        f"timed_out: {timed_out}\n"
+        f"stdout:\n{_truncate(stdout)}\n"
+        f"stderr:\n{_truncate(stderr)}"
+    )
+
+
+def tool_function(solution_path, stdin_text, timeout=None, mode=None):
+    if timeout is None:
+        timeout = 10.0
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        timeout = 10.0
+    if mode is None:
+        mode = "flat"
+    if mode not in ("flat", "lines"):
+        return f"Error: unknown mode '{mode}', expected 'flat' or 'lines'"
+    if stdin_text is None:
+        stdin_text = ""
+
+    cmd = [sys.executable or "python3", solution_path]
+
+    if mode == "flat":
+        try:
+            proc = subprocess.run(
+                cmd,
+                input=stdin_text.encode(),
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                timeout=timeout,
+            )
+            return _format(proc.returncode, False, _decode(proc.stdout), _decode(proc.stderr))
+        except subprocess.TimeoutExpired as e:
+            return _format("None", True, _decode(e.stdout), _decode(e.stderr))
+        except Exception as e:
+            return f"Error running solution: {e}"
+
+    # mode == 'lines': feed one line at a time, flushing between lines.
+    try:
+        proc = subprocess.Popen(
+            cmd,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+    except Exception as e:
+        return f"Error running solution: {e}"
+
+    def feeder():
+        try:
+            for line in stdin_text.splitlines(keepends=True):
+                proc.stdin.write(line.encode())
+                proc.stdin.flush()
+                time.sleep(0.01)
+            proc.stdin.close()
+        except (BrokenPipeError, OSError, ValueError):
+            pass
+
+    writer = threading.Thread(target=feeder, daemon=True)
+    writer.start()
+    timed_out = False
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        proc.kill()
+        stdout, stderr = proc.communicate()
+    writer.join(timeout=1.0)
+    exit_code = proc.returncode if not timed_out else "None"
+    return _format(exit_code, timed_out, _decode(stdout), _decode(stderr))
