@@ -0,0 +1,257 @@
+import json
+import os
+import random
+import subprocess
+import tempfile
+
+# Runs one class-method case: argv = [solution_path, method_name, args_file].
+# The args literal is read from a file (not argv) so large inputs do not hit the OS argument limit.
+_METHOD_RUNNER = r'''
+import sys, json, ast, importlib.util
+path, method = sys.argv[1], sys.argv[2]
+with open(sys.argv[3]) as _f:
+    args_src = _f.read()
+spec = importlib.util.spec_from_file_location("candidate_solution", path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+args = ast.literal_eval(args_src)
+if not isinstance(args, tuple):
+    args = (args,)
+result = getattr(mod.Solution(), method)(*args)
+out = result if isinstance(result, str) else repr(result)
+sys.stdout.write("__METHOD_RESULT__" + json.dumps(out) + "\n")
+'''
+
+MAX_CASES = 40
+MAX_REPEAT = 5
+MAX_TIME_LIMIT = 60.0
+STDERR_TAIL = 400
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Time a solution on a file of test cases, each run in its own subprocess with a timeout. Returns a raw plain-text table (case index, label, wall time, TIMEOUT flag, exit code, stderr tail). Wall time includes Python startup and module import.\n
+Modes:
+* "method": class-method task. inputs_file is a JSON list; each element is a Python literal tuple of positional args (e.g. "(\\"aaaa\\", 3)") or an object {"label": "...", "args": "<literal tuple>"}. Calls Solution().<method_name>(*args).
+* "stdin": program task. inputs_file is a JSON list; each element is the stdin text (string) or an object {"label": "...", "input": "<stdin text>"}. Runs `python3 solution_path`.
+* "generate": writes structured adversarial max-size cases to inputs_file (a JSON list of {"label", "args"} objects, usable with mode "method"). Set generate_kind to "string" (constant char, two letters with unequal counts, k-block runs, sorted, periodic, random 2-letter, random 26-letter) or "int_array" (all equal, ascending, descending, random, all max, all min, alternating extremes, random); set n to the max size and optionally max_value for int arrays and alphabet_size for strings. Generated strings use letters starting at 'a'. solution_path is still required but is not used in generate mode.\n
+Results are raw: wall time (max over repeats), TIMEOUT flag, exit code, and the tail of stderr. Interpret them yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (e.g. /repo/solution.py). Not used in generate mode."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["method", "stdin", "generate"],
+                    "description": "'method' for class-method tasks, 'stdin' for stdin/stdout programs, 'generate' to write structured adversarial inputs to inputs_file."
+                },
+                "inputs_file": {
+                    "type": "string",
+                    "description": "Path to a JSON list of cases (input file for 'method'/'stdin'; output file for 'generate')."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method of class Solution to call (required for mode 'method')."
+                },
+                "time_limit_seconds": {
+                    "type": "number",
+                    "description": "Timeout per run in seconds (default 5, max 60)."
+                },
+                "repeat": {
+                    "type": "integer",
+                    "description": "Number of runs per case; the reported time is the maximum (default 1, max 5)."
+                },
+                "generate_kind": {
+                    "type": "string",
+                    "enum": ["string", "int_array"],
+                    "description": "Kind of structured inputs to generate (mode 'generate' only)."
+                },
+                "n": {
+                    "type": "integer",
+                    "description": "Max size of generated inputs (mode 'generate' only, e.g. the max constraint)."
+                },
+                "max_value": {
+                    "type": "integer",
+                    "description": "Largest absolute value for generated int arrays (mode 'generate', default 1000000000)."
+                },
+                "alphabet_size": {
+                    "type": "integer",
+                    "description": "Number of letters used for generated strings (mode 'generate', default 26, max 26)."
+                }
+            },
+            "required": ["solution_path", "mode", "inputs_file"]
+        }
+    }
+
+
+def _string_presets(n, alphabet_size, rng):
+    letters = [chr(ord('a') + i) for i in range(alphabet_size)]
+    presets = []
+    presets.append(("constant", letters[0] * n))
+    if alphabet_size >= 2:
+        presets.append(("two letters, unequal counts", letters[0] * (n - 1) + letters[1]))
+        presets.append(("two letters, unequal counts (front-loaded)", letters[1] + letters[0] * (n - 1)))
+        presets.append(("two letters, random 50/50", "".join(rng.choice(letters[:2]) for _ in range(n))))
+    for k in (2, 3, 26):
+        if k > alphabet_size:
+            continue
+        # blocks of runs: each run length ~ n/k, cycling letters
+        run = max(1, n // k)
+        parts = [letters[i % k] * run for i in range(n // run + 1)]
+        presets.append((f"{k} blocks of equal runs", "".join(parts)[:n]))
+    presets.append(("sorted (cyclic letters, sorted)", "".join(sorted(letters[i % alphabet_size] for i in range(n)))))
+    for p in (2, 3, 7):
+        if p <= alphabet_size:
+            unit = letters[:p]
+            presets.append((f"periodic period {p}", (unit * (n // p + 1))[:n]))
+    presets.append(("random letters", "".join(rng.choice(letters) for _ in range(n))))
+    return presets
+
+
+def _int_presets(n, max_value, rng):
+    presets = []
+    presets.append(("all equal to max_value", [max_value] * n))
+    presets.append(("all equal to 1", [1] * n))
+    presets.append(("all equal to 0", [0] * n))
+    presets.append(("ascending", [(max_value * i) // n for i in range(1, n + 1)]))
+    presets.append(("descending", [max_value - (max_value * i) // n for i in range(n)]))
+    presets.append(("all max_value", [max_value] * n))
+    presets.append(("all -max_value", [-max_value] * n))
+    presets.append(("alternating extremes", [max_value if i % 2 == 0 else -max_value for i in range(n)]))
+    presets.append(("random", [rng.randint(-max_value, max_value) for _ in range(n)]))
+    presets.append(("random small (0..3)", [rng.randint(0, 3) for _ in range(n)]))
+    return presets
+
+
+def _generate(inputs_file, kind, n, max_value, alphabet_size):
+    if kind not in ("string", "int_array"):
+        return "error: generate_kind must be 'string' or 'int_array'."
+    if not n or n < 1:
+        return "error: n (a positive integer) is required for generate mode."
+    rng = random.Random(12345)
+    if kind == "string":
+        alphabet_size = max(1, min(26, alphabet_size or 26))
+        presets = _string_presets(n, alphabet_size, rng)
+    else:
+        max_value = max(1, max_value or 1000000000)
+        presets = _int_presets(n, max_value, rng)
+    cases = [{"label": f"{label} (n={n})", "args": repr((value,))} for label, value in presets]
+    with open(inputs_file, "w") as f:
+        json.dump(cases, f, indent=1)
+    return f"wrote {len(cases)} cases to {inputs_file}:\n" + "\n".join(
+        f"  [{i}] {c['label']}" for i, c in enumerate(cases))
+
+
+def _load_cases(inputs_file):
+    with open(inputs_file) as f:
+        data = json.load(f)
+    if not isinstance(data, list):
+        raise ValueError("inputs_file must contain a JSON list")
+    cases = []
+    for item in data:
+        if isinstance(item, dict):
+            payload = item.get("args", item.get("input", ""))
+            label = str(item.get("label", ""))
+        else:
+            payload, label = item, ""
+        if not isinstance(payload, str):
+            payload = repr(tuple(payload)) if isinstance(payload, list) else str(payload)
+        cases.append((label, payload))
+    return cases
+
+
+def _run_once(mode, solution_abs, method_name, payload, time_limit, cwd):
+    """Returns (wall_seconds, timed_out, returncode, stderr_text)."""
+    import time
+    start = time.time()
+    try:
+        if mode == "method":
+            with tempfile.NamedTemporaryFile("w", suffix=".args", delete=False) as tf:
+                tf.write(payload)
+                args_path = tf.name
+            try:
+                proc = subprocess.run(
+                    ["python3", "-c", _METHOD_RUNNER, solution_abs, method_name, args_path],
+                    capture_output=True, text=True, timeout=time_limit, cwd=cwd,
+                )
+            finally:
+                os.unlink(args_path)
+        else:
+            stdin_text = payload if (not payload or payload.endswith("\n")) else payload + "\n"
+            proc = subprocess.run(
+                ["python3", solution_abs],
+                input=stdin_text, capture_output=True, text=True, timeout=time_limit, cwd=cwd,
+            )
+        return time.time() - start, False, proc.returncode, proc.stderr or ""
+    except subprocess.TimeoutExpired as e:
+        stderr = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return time.time() - start, True, None, stderr
+    except OSError as e:
+        return time.time() - start, False, -1, f"OSError: {e}"
+
+
+def tool_function(solution_path=None, mode=None, inputs_file=None, method_name=None,
+                  time_limit_seconds=None, repeat=None, generate_kind=None, n=None,
+                  max_value=None, alphabet_size=None):
+    if not inputs_file:
+        return "error: inputs_file is required."
+    if mode == "generate":
+        try:
+            return _generate(inputs_file, generate_kind, n, max_value, alphabet_size)
+        except Exception as e:
+            return f"generate failed: {type(e).__name__}: {e}"
+
+    if mode not in ("method", "stdin"):
+        return "error: mode must be 'method', 'stdin', or 'generate'."
+    if not solution_path or not os.path.exists(solution_path):
+        return f"Solution file not found: {solution_path}"
+    if mode == "method" and not method_name:
+        return "error: method_name is required for mode 'method'."
+
+    time_limit = float(time_limit_seconds) if time_limit_seconds else 5.0
+    time_limit = max(0.1, min(time_limit, MAX_TIME_LIMIT))
+    repeat = max(1, min(int(repeat) if repeat else 1, MAX_REPEAT))
+
+    try:
+        cases = _load_cases(inputs_file)
+    except Exception as e:
+        return f"could not read inputs_file {inputs_file}: {type(e).__name__}: {e}"
+    if not cases:
+        return "inputs_file contains no cases."
+    skipped = max(0, len(cases) - MAX_CASES)
+    cases = cases[:MAX_CASES]
+
+    solution_abs = os.path.abspath(solution_path)
+    cwd = os.path.dirname(solution_abs)
+    lines = [
+        f"mode={mode} solution={solution_abs} time_limit={time_limit}s repeat={repeat} cases={len(cases)}"
+        + (f" (skipped {skipped} beyond the {MAX_CASES}-case cap)" if skipped else ""),
+        f"{'idx':>4} | {'label':<40} | {'wall_s':>8} | {'TIMEOUT':<7} | {'exit':>4} | stderr (tail)",
+    ]
+    for idx, (label, payload) in enumerate(cases):
+        worst = 0.0
+        timed_out = False
+        codes = []
+        stderr_text = ""
+        for _ in range(repeat):
+            wall, to, rc, err = _run_once(mode, solution_abs, method_name, payload, time_limit, cwd)
+            worst = max(worst, wall)
+            if to:
+                timed_out = True
+                codes.append("-")
+            else:
+                codes.append(str(rc))
+            if (to or rc != 0) and not stderr_text:
+                stderr_text = err
+            if timed_out:
+                break  # no point repeating a case that already exceeded the limit
+        tail = stderr_text[-STDERR_TAIL:].strip().replace("\n", " | ")
+        exit_str = ",".join(codes) if len(set(codes)) > 1 else codes[0]
+        lines.append(
+            f"{idx:>4} | {label[:40]:<40} | {worst:>8.3f} | {'YES' if timed_out else 'no':<7} | {exit_str:>4} | {tail}"
+        )
+    return "\n".join(lines)
