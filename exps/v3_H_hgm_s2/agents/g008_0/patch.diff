+    def _run_stress_check(self):
+        """
+        Run the conventional stress-test script at STRESS_SCRIPT_PATH.
+        The script must print a final line starting with 'STRESS_RESULT:'.
+        Returns (passed, output_tail). A missing script, crash, timeout,
+        or non-PASS result all count as not passed.
+        """
+        if not os.path.isfile(STRESS_SCRIPT_PATH):
+            return False, f'(no stress script found at {STRESS_SCRIPT_PATH})'
+        try:
+            result = subprocess.run(
+                ['python3', STRESS_SCRIPT_PATH],
+                timeout=STRESS_TIMEOUT_SECONDS,
+                capture_output=True,
+            )
+        except subprocess.TimeoutExpired as e:
+            out = (e.stdout or b'').decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            err = (e.stderr or b'').decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+            tail = (out + err)[-STRESS_OUTPUT_TAIL_CHARS:]
+            return False, f'(stress script timed out after {STRESS_TIMEOUT_SECONDS}s)\n{tail}'
+        except OSError as e:
+            return False, f'(failed to run stress script: {e})'
+        stdout = result.stdout.decode(errors='replace')
+        stderr = result.stderr.decode(errors='replace')
+        output_tail = (stdout + ('\n' + stderr if stderr.strip() else ''))[-STRESS_OUTPUT_TAIL_CHARS:]
+        sentinel_lines = [ln.strip() for ln in stdout.splitlines() if ln.strip().startswith(STRESS_SENTINEL)]
+        if result.returncode != 0 or not sentinel_lines:
+            return False, output_tail
+        passed = sentinel_lines[-1].startswith(STRESS_SENTINEL + ' PASS')
+        return passed, output_tail
+
