+def _history_status(msg_history):
+    """
+    Inspect a message history returned by chat_with_agent.
+    Returns (has_tool_use, final_text).
+    """
+    has_tool_use = False
+    final_text = ''
+    for msg in msg_history or []:
+        content = msg.get('content', []) if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                final_text = content
+            continue
+        if not isinstance(content, list):
+            # e.g. an OpenAI response object
+            if getattr(msg, 'output', None):
+                for item in msg.output:
+                    if getattr(item, 'type', None) == 'function_call':
+                        has_tool_use = True
+            continue
+        texts = []
+        for block in content:
+            btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+            if btype in ('tool_use', 'function_call', 'tool_result', 'function_call_output'):
+                has_tool_use = True
+            if btype == 'text':
+                text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+                if text:
+                    texts.append(text)
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            final_text = '\n'.join(texts)
+    return has_tool_use, final_text
+
+def _extract_code_block(text):
+    """
+    Return the content of the first fenced code block in `text`, or None.
+    """
+    match = re.search(r"```(?:python|py)?[ \t]*\n(.*?)```", text or '', re.DOTALL)
+    if match:
+        return match.group(1)
+    return None
+
+def _parse_samples(problem_statement):
+    """
+    Parse 'Sample Input N' / 'Sample Output N' pairs from the problem statement.
+    Returns a list of (input_text, expected_output_text).
+    """
+    pattern = re.compile(
+        r'Sample Input\s*(\d*)\s*:?[ \t]*\n(.*?)Sample Output\s*\1\s*:?[ \t]*\n(.*?)(?=\n\s*\n|Sample Input|\Z)',
+        re.DOTALL | re.IGNORECASE,
+    )
+    samples = []
+    for match in pattern.finditer(problem_statement or ''):
+        def clean(block):
+            lines = [ln.rstrip() for ln in block.splitlines() if ln.strip() != '```']
+            return '\n'.join(lines).strip('\n')
+        inp, out = clean(match.group(2)), clean(match.group(3))
+        if inp or out:
+            samples.append((inp + '\n', out))
+    return samples
+
+def _outputs_match(actual, expected):
+    norm = lambda t: [ln.strip() for ln in t.strip().splitlines() if ln.strip()]
+    return norm(actual) == norm(expected)
