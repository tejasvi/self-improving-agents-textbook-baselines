diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..502071b
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,190 @@
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+DEFAULT_TRIALS = 300
+DEFAULT_TIMEOUT = 10
+DEFAULT_SEED = 0
+MAX_REPORT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress tester for competitive programming solutions.\n
+* For each trial t in range(trials), runs `python generator_path <seed+t> <t>` to produce a random input (the generator should vary size and value range by trial index).\n
+* Runs the solution and the brute-force reference on that input, each with a timeout.\n
+* If checker_path is given, runs `python checker_path input_file solution_output brute_output`; a nonzero exit code means failure. Otherwise compares whitespace-normalized outputs.\n
+* Stops at the first failure and returns the failing input, both outputs, stderr and the trial number. Crashes and timeouts are reported explicitly.\n
+* Otherwise returns 'ALL N TRIALS PASSED' with the maximum observed runtime.\n
+* Helper files (brute, generator, checker) should be written outside the repository, e.g. under /tmp.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file under test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the simple, obviously-correct Python brute-force reference."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator. It is invoked as `python generator_path <seed> <trial_index>` and must print one test input to stdout."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a Python checker for problems with multiple valid answers. Invoked as `python checker_path input_file solution_output brute_output`; nonzero exit means failure. Pass an empty string or omit to compare outputs directly."
+                },
+                "trials": {
+                    "type": "integer",
+                    "description": "Number of random trials to run. Default 300."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for the generator, solution, brute force and checker. Default 10."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Base random seed; trial t uses seed+t. Default 0."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _normalize(text):
+    return [" ".join(ln.split()) for ln in (text or "").splitlines() if ln.strip()]
+
+
+def _clip(text, limit=MAX_REPORT_CHARS):
+    text = text or ""
+    return text if len(text) <= limit else text[:limit] + "\n...<clipped>"
+
+
+def _run(args, stdin_text=None, timeout=DEFAULT_TIMEOUT, cwd=None):
+    """Run a command. Returns (status, stdout, stderr, elapsed) where status is
+    'ok', 'error' (nonzero exit), or 'timeout'."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            args,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            cwd=cwd,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return "timeout", out, err, time.time() - start
+    elapsed = time.time() - start
+    status = "ok" if proc.returncode == 0 else "error"
+    return status, proc.stdout, proc.stderr, elapsed
+
+
+def _to_int(value, default):
+    if value is None or value == "":
+        return default
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def _to_float(value, default):
+    if value is None or value == "":
+        return default
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def tool_function(solution_path, brute_path, generator_path, checker_path=None,
+                  trials=DEFAULT_TRIALS, timeout=DEFAULT_TIMEOUT, seed=DEFAULT_SEED):
+    trials = _to_int(trials, DEFAULT_TRIALS)
+    timeout = _to_float(timeout, DEFAULT_TIMEOUT)
+    seed = _to_int(seed, DEFAULT_SEED)
+    if checker_path == "":
+        checker_path = None
+
+    for label, path in (("solution_path", solution_path), ("brute_path", brute_path),
+                        ("generator_path", generator_path), ("checker_path", checker_path)):
+        if path is not None and not os.path.isfile(path):
+            return f"ERROR: {label} does not exist: {path}"
+    if trials <= 0:
+        return "ERROR: trials must be a positive integer."
+
+    py = sys.executable
+    max_time = 0.0
+    tmpdir = tempfile.mkdtemp(prefix="stress_")
+    input_file = os.path.join(tmpdir, "input.txt")
+    sol_out_file = os.path.join(tmpdir, "sol_out.txt")
+    brute_out_file = os.path.join(tmpdir, "brute_out.txt")
+
+    def failure(trial, reason, test_input, sol_out="", brute_out="", stderr=""):
+        return (
+            f"FAILED at trial {trial}: {reason}\n"
+            f"--- input ---\n{_clip(test_input)}\n"
+            f"--- solution output ---\n{_clip(sol_out)}\n"
+            f"--- brute output ---\n{_clip(brute_out)}\n"
+            f"--- stderr ---\n{_clip(stderr)}"
+        )
+
+    for t in range(trials):
+        # 1) Generate input
+        status, gen_out, gen_err, _ = _run([py, generator_path, str(seed + t), str(t)], timeout=timeout)
+        if status == "timeout":
+            return f"FAILED at trial {t}: generator timed out after {timeout}s\n--- stderr ---\n{_clip(gen_err)}"
+        if status == "error":
+            return f"FAILED at trial {t}: generator crashed (nonzero exit)\n--- stderr ---\n{_clip(gen_err)}"
+        test_input = gen_out
+        if not test_input.strip():
+            return f"FAILED at trial {t}: generator produced empty input\n--- stderr ---\n{_clip(gen_err)}"
+        if not test_input.endswith("\n"):
+            test_input += "\n"
+
+        # 2) Run solution
+        s_status, s_out, s_err, s_time = _run([py, solution_path], stdin_text=test_input, timeout=timeout)
+        if s_status == "timeout":
+            return failure(t, f"solution timed out after {timeout}s", test_input, s_out, "", s_err)
+        if s_status == "error":
+            return failure(t, "solution crashed (nonzero exit)", test_input, s_out, "", s_err)
+        max_time = max(max_time, s_time)
+
+        # 3) Run brute force
+        b_status, b_out, b_err, b_time = _run([py, brute_path], stdin_text=test_input, timeout=timeout)
+        if b_status == "timeout":
+            return failure(t, f"brute force timed out after {timeout}s (make the generator smaller for this trial or fix the brute)",
+                           test_input, s_out, b_out, b_err)
+        if b_status == "error":
+            return failure(t, "brute force crashed (nonzero exit); the reference is broken",
+                           test_input, s_out, b_out, b_err)
+
+        # 4) Compare
+        if checker_path:
+            with open(input_file, "w") as f:
+                f.write(test_input)
+            with open(sol_out_file, "w") as f:
+                f.write(s_out)
+            with open(brute_out_file, "w") as f:
+                f.write(b_out)
+            c_status, c_out, c_err, _ = _run([py, checker_path, input_file, sol_out_file, brute_out_file],
+                                             timeout=timeout)
+            if c_status == "timeout":
+                return failure(t, f"checker timed out after {timeout}s", test_input, s_out, b_out, c_err)
+            if c_status == "error":
+                reason = "checker rejected solution output"
+                return failure(t, reason, test_input, s_out, b_out, (c_out or "") + (c_err or ""))
+        else:
+            if _normalize(s_out) != _normalize(b_out):
+                return failure(t, "output mismatch between solution and brute force", test_input, s_out, b_out, s_err)
+
+    return (f"ALL {trials} TRIALS PASSED. Max solution runtime: {max_time:.3f}s "
+            f"(timeout {timeout}s per run).")
