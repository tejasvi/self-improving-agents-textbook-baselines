+++ b/tools/run_samples.py
@@ -0,0 +1,180 @@
+import re
+import subprocess
+import sys
+
+MAX_FIELD_CHARS = 4000
+
+# Header lines that start a sample input block, e.g. "Sample Input 1", "Sample Input:", "Example Input", "Input:"
+_INPUT_HEADER = re.compile(
+    r'^\s*(?:(?:sample|example)\s*input\s*\d*\s*:?|input\s*\d*\s*:)\s*(.*)$',
+    re.IGNORECASE,
+)
+# Header lines that start a sample output block, e.g. "Sample Output 1", "Sample Output:", "Example Output", "Output:"
+_OUTPUT_HEADER = re.compile(
+    r'^\s*(?:(?:sample|example)\s*output\s*\d*\s*:?|output\s*\d*\s*:)\s*(.*)$',
+    re.IGNORECASE,
+)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run the sample tests of a problem against a Python solution file.\n
+* Parses every sample input/output pair from the problem statement text (headings like 'Sample Input 1' / 'Sample Output 1', 'Example Input' / 'Example Output', or 'Input:' / 'Output:').\n
+* Runs `python3 solution_path` on each sample input and compares the output with the expected output (whitespace-normalized).\n
+* Returns a report listing PASS or FAIL per sample. A FAIL shows the input, the expected output, the actual output, stderr (tracebacks) and whether the run timed out.\n
+* Use it after every change to the solution to confirm that all samples pass.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the sample input/output blocks."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each sample run (default 10)."
+                }
+            },
+            "required": ["solution_path", "problem_text"]
+        }
+    }
+
+
+def parse_samples(problem_text):
+    """
+    Extract (input, expected_output) pairs from a problem statement.
+    Inputs and outputs are paired in the order they appear.
+    A block starts at a sample header and ends at the first blank line after content.
+    Bare 'Input' / 'Output' section headings (no colon, no Sample/Example prefix) are ignored.
+    """
+    blocks = []  # list of (kind, lines)
+    current = None  # [kind, lines]
+
+    for raw in (problem_text or '').splitlines():
+        line = raw.rstrip('\r')
+        if line.strip().startswith('```'):
+            continue  # markdown code fences around sample blocks are not content
+        m_in = _INPUT_HEADER.match(line)
+        m_out = _OUTPUT_HEADER.match(line)
+        if m_in or m_out:
+            if current is not None:
+                blocks.append(current)
+            m = m_in or m_out
+            kind = 'in' if m_in else 'out'
+            first = m.group(1)
+            current = [kind, [first] if first.strip() else []]
+            continue
+        if current is None:
+            continue
+        if line.strip() == '':
+            if current[1]:
+                blocks.append(current)
+                current = None
+            continue
+        current[1].append(line)
+    if current is not None:
+        blocks.append(current)
+
+    inputs, outputs = [], []
+    for kind, lines in blocks:
+        text = '\n'.join(l.rstrip() for l in lines).strip('\n')
+        if kind == 'in':
+            inputs.append(text)
+        else:
+            outputs.append(text)
+
+    pairs = []
+    for i, inp in enumerate(inputs):
+        if i < len(outputs):
+            pairs.append((inp + '\n', outputs[i]))
+    return pairs
+
+
+def _normalize(text):
+    return ' '.join((text or '').split())
+
+
+def _clip(text):
+    if text is None:
+        return ''
+    if len(text) > MAX_FIELD_CHARS:
+        return text[:MAX_FIELD_CHARS] + f"\n...<truncated {len(text) - MAX_FIELD_CHARS} chars>"
+    return text
+
+
+def _decode(data):
+    if data is None:
+        return ''
+    if isinstance(data, bytes):
+        return data.decode(errors='replace')
+    return str(data)
+
+
+def _run_one(solution_path, stdin_text, timeout):
+    """Returns (stdout, stderr, timed_out, returncode)."""
+    try:
+        proc = subprocess.run(
+            [sys.executable or 'python3', solution_path],
+            input=stdin_text.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+        return _decode(proc.stdout), _decode(proc.stderr), False, proc.returncode
+    except subprocess.TimeoutExpired as e:
+        return _decode(e.stdout), _decode(e.stderr), True, None
+
+
+def run_samples_report(solution_path, problem_text, timeout=10):
+    """
+    Run all samples parsed from problem_text against solution_path.
+    Returns (all_passed, report_str). If no samples can be parsed, returns (True, note)
+    so that callers have nothing to verify and do not loop.
+    """
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    pairs = parse_samples(problem_text)
+    if not pairs:
+        return True, ("No sample input/output blocks were found in the problem statement, "
+                      "so no samples could be verified.")
+
+    lines = []
+    failed = 0
+    for idx, (inp, expected) in enumerate(pairs, start=1):
+        stdout, stderr, timed_out, rc = _run_one(solution_path, inp, timeout)
+        ok = (not timed_out) and rc == 0 and _normalize(stdout) == _normalize(expected)
+        if ok:
+            lines.append(f"Sample {idx}: PASS")
+            continue
+        failed += 1
+        if timed_out:
+            reason = f"TIMEOUT after {timeout}s"
+        elif rc != 0:
+            reason = f"runtime error (exit code {rc})"
+        else:
+            reason = "wrong output"
+        lines.append(f"Sample {idx}: FAIL ({reason})")
+        lines.append(f"  input:\n{_clip(inp)}")
+        lines.append(f"  expected:\n{_clip(expected)}")
+        lines.append(f"  actual:\n{_clip(stdout)}")
+        lines.append(f"  stderr:\n{_clip(stderr)}")
+        lines.append(f"  timed_out: {timed_out}")
+    all_passed = failed == 0
+    summary = f"Summary: {len(pairs)} sample(s), {failed} failed; all passed: {all_passed}"
+    return all_passed, summary + "\n" + "\n".join(lines)
+
+
+def tool_function(solution_path, problem_text, timeout=None):
+    try:
+        _, report = run_samples_report(solution_path, problem_text, timeout=timeout if timeout is not None else 10)
+        return report
+    except Exception as e:
+        return f"Error running samples: {e}"
