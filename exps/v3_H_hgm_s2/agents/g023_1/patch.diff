+    @staticmethod
+    def _parse_summary(report):
+        """
+        Read only the `SUMMARY passed=.. failed=.. crashed=..` line and its max_time.
+        Returns a dict with keys passed, failed, crashed, total, max_time, or None if absent.
+        """
+        m = re.search(
+            r'SUMMARY\s+passed=(\d+)\s+failed=(\d+)\s+crashed=(\d+)(?:\s+max_time=([0-9]+(?:\.[0-9]+)?))?',
+            report or "",
+        )
+        if not m:
+            return None
+        passed, failed, crashed = int(m.group(1)), int(m.group(2)), int(m.group(3))
+        max_time = float(m.group(4)) if m.group(4) is not None else float('inf')
+        return {
+            "passed": passed,
+            "failed": failed,
+            "crashed": crashed,
+            "total": passed + failed + crashed,
+            "max_time": max_time,
+        }
+
+    @staticmethod
+    def _score(report):
+        """
+        Score tuple (passed, -failed, -crashed, -max_time) for a raw harness report, or None.
+        Larger is better. Tuples compare lexicographically.
+        """
+        summary = AgenticSystem._parse_summary(report)
+        if summary is None:
+            return None
+        return (summary["passed"], -summary["failed"], -summary["crashed"], -summary["max_time"])
+
