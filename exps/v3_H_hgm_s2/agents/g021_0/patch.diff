+    if not m:
+        return None
+    fm = re.search(r'^\s+def\s+([A-Za-z]\w*)\s*\(', text[m.end():], re.MULTILINE)
+    return fm.group(1) if fm else None
+
+
+def _outputs_match(actual, expected):
+    """Compare outputs token-wise, falling back to structural equality for literals."""
+    if actual.split() == expected.split():
+        return True
+    # Treat list-style "[0, 1]" and space-separated "0 1" as the same tokens.
+    norm = lambda t: re.sub(r"[\[\],]", " ", t).split()
+    if norm(actual) == norm(expected):
+        return True
+    def _loads_all(text):
+        vals = []
+        for loader in (json.loads, ast.literal_eval):
+            try:
+                vals.append(loader(text))
+            except Exception:
+                pass
+        return vals
+    a_vals = _loads_all(actual.strip())
+    e_vals = _loads_all(expected.strip())
+    return any(a == e for a in a_vals for e in e_vals)
+
