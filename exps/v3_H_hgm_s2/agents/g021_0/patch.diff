+
+def _is_class_solution(path):
+    """True if the solution file defines a `class Solution` (LeetCode-style task)."""
+    return re.search(r'^\s*class\s+Solution\b', _read_text(path), re.MULTILINE) is not None
+
+
+def _class_method_name(path):
+    """Return the first public method name defined in `class Solution`, or None."""
+    text = _read_text(path)
