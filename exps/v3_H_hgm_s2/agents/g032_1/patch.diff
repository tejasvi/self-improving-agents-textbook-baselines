+- Do not write helper scripts with bash heredocs; use the editor tool.
+- Do not reply with text only; finish only after the fix is on disk and verified.
+""", model=self.code_model, msg_history=[], logging=safe_log)
+
+        report, n_fail = self._run_differential(solution_path, oracle_dir)
+        safe_log(f"[harden] post-hardening differential: {n_fail} failure(s) (before: {base_fail}).")
