+    # ------------------------------------------------------------------
+    # I/O robustness hardening (interactive / stdin-protocol problems)
+    # ------------------------------------------------------------------
+
+    def _run_degraded_io(self, solution_path):
+        """
+        Run the solution on 'degraded protocol' stdin built from the first line of a valid input
+        (oracle gen_small.py seed 0): nothing after it, a single integer line, a long line of
+        integers, several integer lines, and CRLF variants. Returns (raw_report, needs_repair);
+        needs_repair is True when any run exits non-zero or times out. Errors are not parsed.
+        """
+        oracle_dir = getattr(self, "_oracle_dir", None)
+        if not solution_path or not os.path.exists(solution_path) or not oracle_dir:
+            return "Degraded I/O harness skipped: no solution or oracle.", False
+        try:
+            g = subprocess.run(["python3", os.path.join(oracle_dir, "gen_small.py"), "0"],
+                               capture_output=True, text=True, timeout=20, cwd=oracle_dir)
+        except subprocess.TimeoutExpired:
+            return "Degraded I/O harness skipped: gen_small.py timed out.", False
+        lines = (g.stdout or "").splitlines()
+        if g.returncode != 0 or not lines or not lines[0].strip():
+            return "Degraded I/O harness skipped: gen_small.py produced no first line.", False
+        first = lines[0].strip()
+        suffixes = [
+            "",
+            "\n",
+            "7\n",
+            "31 41 59 26 53 58 97 93\n7\n7\n7\n",
+        ]
+        payloads = [first + s for s in suffixes]
+        payloads += [first + "\r\n", first + "\r\n7\r\n",
+                     first + "\r\n31 41 59 26 53 58 97 93\r\n7\r\n7\r\n"]
+        blocks = []
+        needs_repair = False
+        for i, payload in enumerate(payloads):
+            res = self._run_candidate(solution_path, "stdin", None, payload, timeout=5, tag=f"degraded{i}")
+            if res["timed_out"] or res["returncode"] != 0:
+                needs_repair = True
+            blocks.append(
+                f"=== Degraded case {i} ===\n"
+                f"--- payload (repr) ---\n{payload!r}\n"
+                f"--- returncode ---\n{res['returncode']}\n"
+                f"--- timed out ---\n{res['timed_out']}\n"
+                f"--- stdout tail ---\n{self._clip(res['stdout'][-600:], 600)}\n"
+                f"--- stderr tail ---\n{self._clip(res['stderr'][-600:], 600)}\n"
+            )
+        header = f"DEGRADED I/O REPORT: {'FAILURES FOUND' if needs_repair else 'ALL CASES EXITED CLEANLY'}"
+        return header + "\n\n" + "\n".join(blocks), needs_repair
+
+    def _harden_io_phase(self, task, max_rounds=2):
