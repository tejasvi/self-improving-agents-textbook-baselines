diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..69c5184
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,148 @@
+import os
+import signal
+import subprocess
+import tempfile
+import threading
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Run a shell command with a hard wall-clock time limit and report how long it took.
+* Use it to check that a solution finishes within the time limit on max-size / adversarial inputs, e.g. `python3 /tmp/sol.py < /tmp/max_input.txt`.
+* Returns 'OK elapsed=Xs' (plus peak memory in MB when available) if the command exits with code 0 within the limit.
+* Returns 'TIMEOUT after Xs' if the limit is exceeded. A TIMEOUT is a FAILURE: the solution must be made faster.
+* Returns 'FAILED exit_code=N elapsed=Xs' followed by the stderr/stdout output if the command exits with a non-zero code.
+* Runs independently of the bash tool, so the bash session's time limit does not apply. Use `runs` > 1 to repeat the command and report the worst elapsed time.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. `python3 /tmp/sol.py < /tmp/max_input.txt`."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Hard wall-clock time limit in seconds for each run (e.g. 2 to 10)."
+                },
+                "runs": {
+                    "type": "integer",
+                    "description": "Number of times to run the command (default 1). The worst elapsed time is reported."
+                }
+            },
+            "required": ["command", "time_limit"]
+        }
+    }
+
+
+def _kill_group(pid):
+    try:
+        os.killpg(pid, signal.SIGKILL)
+    except OSError:
+        pass
+
+
+def _run_once(command, time_limit):
+    """
+    Run `command` once under a hard time limit.
+    Returns (status, elapsed, peak_mem_mb, output_text, exit_code).
+    status is 'OK', 'TIMEOUT' or 'FAILED'.
+    """
+    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
+        start = time.monotonic()
+        proc = subprocess.Popen(
+            ["/bin/bash", "-c", command],
+            stdin=subprocess.DEVNULL,
+            stdout=out,
+            stderr=err,
+            start_new_session=True,  # own process group so the whole tree can be killed
+        )
+        pid = proc.pid
+        timed_out = threading.Event()
+
+        def on_deadline():
+            timed_out.set()
+            _kill_group(pid)
+
+        # The timer kills the whole process group when the limit expires;
+        # os.wait4 then returns (blocking, no polling loop).
+        timer = threading.Timer(time_limit, on_deadline)
+        timer.daemon = True
+        timer.start()
+        try:
+            _, status, rusage = os.wait4(pid, 0)
+        finally:
+            timer.cancel()
+        elapsed = time.monotonic() - start
+        # Kill any leftover processes that were in the group.
+        _kill_group(pid)
+        proc.returncode = 0  # reaped via os.wait4; avoid Popen warnings
+
+        if timed_out.is_set():
+            return 'TIMEOUT', elapsed, None, '', None
+
+        out.seek(0)
+        err.seek(0)
+        stdout_text = out.read().decode(errors='replace')
+        stderr_text = err.read().decode(errors='replace')
+        code = os.waitstatus_to_exitcode(status)
+        peak_mb = rusage.ru_maxrss / 1024.0 if rusage is not None else None  # KB on Linux
+
+        if code == 0:
+            return 'OK', elapsed, peak_mb, stdout_text, 0
+        text = ''
+        if stderr_text.strip():
+            text += 'stderr:\n' + stderr_text
+        if stdout_text.strip():
+            text += ('\n' if text else '') + 'stdout:\n' + stdout_text
+        return 'FAILED', elapsed, peak_mb, text, code
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + '\n... (truncated)'
+    return text
+
+
+def tool_function(command: str, time_limit: float, runs: int = 1) -> str:
+    try:
+        if command is None or not str(command).strip():
+            return "Error: empty command."
+        try:
+            time_limit = float(time_limit)
+        except (TypeError, ValueError):
+            return f"Error: invalid time_limit {time_limit!r}."
+        if time_limit <= 0:
+            return "Error: time_limit must be positive."
+        try:
+            runs = int(runs) if runs is not None else 1
+        except (TypeError, ValueError):
+            runs = 1
+        runs = max(1, min(runs, 20))
+
+        worst_elapsed = 0.0
+        worst_mem = None
+        last_text = ''
+        for i in range(runs):
+            status, elapsed, mem, text, code = _run_once(str(command), time_limit)
+            worst_elapsed = max(worst_elapsed, elapsed)
+            if mem is not None:
+                worst_mem = mem if worst_mem is None else max(worst_mem, mem)
+            if status == 'TIMEOUT':
+                return (f"TIMEOUT after {time_limit:g}s (run {i + 1}/{runs}). "
+                        f"The command did not finish within the time limit and was killed.")
+            if status == 'FAILED':
+                return (f"FAILED exit_code={code} elapsed={elapsed:.2f}s (run {i + 1}/{runs})\n"
+                        + _truncate(text))
+            last_text = text
+
+        mem_str = f" peak_mem={worst_mem:.1f}MB" if worst_mem is not None else ''
+        result = f"OK elapsed={worst_elapsed:.2f}s (limit {time_limit:g}s, runs={runs}){mem_str}"
+        if last_text.strip():
+            result += "\nlast run stdout (truncated):\n" + _truncate(last_text)
+        return result
+    except Exception as e:
+        return f"Error running benchmark: {e}"
