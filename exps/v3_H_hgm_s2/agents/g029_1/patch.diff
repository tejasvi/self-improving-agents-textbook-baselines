+    @staticmethod
+    def _file_hash(path):
+        """
+        SHA-256 of a file's bytes, or None when it cannot be read. Used to detect no-op repair rounds.
+        """
+        try:
+            with open(path, "rb") as f:
+                return hashlib.sha256(f.read()).hexdigest()
+        except OSError:
+            return None
+
+    @staticmethod
+    def _summarize_perf_report(report):
+        """
+        Compact summary of a _run_perf report: counts per status plus up to two example cases.
+        Parses only the status headers that _run_perf itself writes.
+        """
+        rows = []
+        for m in re.finditer(r"^=== Case (\d+): (.*) \((TIMEOUT|SLOW|CRASH|OK)[^\n]*?time ([\d.]+)s\) ===$",
+                             report or "", re.M):
+            rows.append((m.group(1), m.group(2), m.group(3), m.group(4)))
+        if not rows:
+            return "No perf case results."
+        total = len(rows)
+        counts = {k: sum(1 for r in rows if r[2] == k) for k in ("TIMEOUT", "SLOW", "CRASH", "OK")}
+        bad = [r for r in rows if r[2] != "OK"]
+        lines = [f"{counts['TIMEOUT']} of {total} cases timed out; {counts['SLOW']} SLOW; {counts['CRASH']} CRASH; {counts['OK']} OK."]
+        for case_no, name, status, elapsed in bad[:2]:
+            lines.append(f"Example: case {case_no} ({name}) {status}, time {elapsed}s.")
+        return "\n".join(lines)
+
