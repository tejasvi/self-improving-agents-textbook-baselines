+def _is_trivial_stub(code, base_content):
+    """True if code is unchanged from base, or only prints a constant / has a placeholder comment."""
+    if code is None or not code.strip():
+        return True
+    if base_content is not None and code.strip() == base_content.strip():
+        return True
+    lower = code.lower()
+    if 'not yet verified' in lower or 'placeholder' in lower or 'todo: implement' in lower:
+        return True
+    body = [ln.strip() for ln in code.splitlines() if ln.strip() and not ln.strip().startswith('#')]
+    prints = [ln for ln in body if ln.startswith('print(')]
+    if prints and len(prints) == len(body) and all(re.fullmatch(r'print\(\s*-?\d+\s*\)', p) for p in prints):
+        return True
+    return False
+
+def _run_samples(self, target):
+    """
+    Run `sys.executable target` on each parsed sample. Returns (passed, total, first_failure).
+    first_failure is None on success, else a string describing input/expected/actual.
+    With no parsed samples, total=0 and passed is 1 only if the file is a non-trivial change.
+    """
+    target_path = os.path.join(self.git_tempdir, target)
+    samples = _parse_samples(self.problem_statement)
+    if not os.path.exists(target_path):
+        return 0, len(samples), f"{target} does not exist"
+    with open(target_path) as f:
+        code = f.read()
+    if not samples:
+        base = None
+        try:
+            r = subprocess.run(["git", "-C", self.git_tempdir, "show", f"{self.base_commit}:{target}"],
+                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            if r.returncode == 0:
+                base = r.stdout.decode(errors='replace')
+        except Exception:
+            base = None
+        if _is_trivial_stub(code, base):
+            return 0, 0, "no samples parsed and the file looks like a placeholder/stub"
+        return 1, 0, None
+    passed = 0
+    for idx, (inp, expected) in enumerate(samples):
+        try:
+            run = subprocess.run([sys.executable, target_path], input=inp, capture_output=True,
+                                 text=True, timeout=SAMPLE_TIMEOUT_SECONDS, cwd=self.git_tempdir)
+        except subprocess.TimeoutExpired:
+            return passed, len(samples), f"sample {idx}: input:\n{inp}\nTIMEOUT after {SAMPLE_TIMEOUT_SECONDS}s"
+        if run.returncode != 0:
+            return passed, len(samples), f"sample {idx}: input:\n{inp}\nexpected:\n{expected}\ntraceback:\n{run.stderr}"
+        if not _outputs_match(run.stdout, expected):
+            return passed, len(samples), f"sample {idx}: input:\n{inp}\nexpected:\n{expected}\nactual:\n{run.stdout}"
+        passed += 1
+    return passed, len(samples), None
+
