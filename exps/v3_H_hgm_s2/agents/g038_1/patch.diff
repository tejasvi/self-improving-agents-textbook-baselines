+    def _final_text(self, history):
+        """
+        Return the text of the last assistant message in a chat history ('' if none).
+        """
+        for msg in reversed(history or []):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            texts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and block.get('text'):
+                        texts.append(block['text'])
+                elif getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                    texts.append(block.text)
+            if texts:
+                return "\n".join(texts)
+        return ''
+
+    def _find_oracle(self):
+        """
+        Return (oracle_path, gen_path) for differential testing, or (None, None).
+
+        If /tmp/oracle_v*.py exists, the highest-numbered one is used. Its generator is
+        /tmp/gen_vN.py, else /tmp/auto_gen.py, else one is generated. If no oracle exists,
+        an oracle and a generator are generated with simple_chat and written to
+        /tmp/auto_oracle.py and /tmp/auto_gen.py (once per run).
+        """
+        candidates = []
+        for path in glob.glob('/tmp/oracle_v*.py'):
+            m = re.fullmatch(r'oracle_v(\d+)\.py', os.path.basename(path))
+            if m:
+                candidates.append((int(m.group(1)), path))
+        if candidates:
+            version, oracle_path = max(candidates)
+            gen_path = f'/tmp/gen_v{version}.py'
+            if not os.path.exists(gen_path):
+                gen_path = '/tmp/auto_gen.py'
+            if not os.path.exists(gen_path):
+                return oracle_path, None
+            safe_log(f"[oracle] using {oracle_path} with generator {gen_path}")
+            return oracle_path, gen_path
+
+        if not getattr(self, '_auto_oracle_done', False):
+            self._auto_oracle_done = True
+            self._generate_oracle_files()
+        if os.path.exists('/tmp/auto_oracle.py') and os.path.exists('/tmp/auto_gen.py'):
+            safe_log("[oracle] using generated /tmp/auto_oracle.py and /tmp/auto_gen.py")
+            return '/tmp/auto_oracle.py', '/tmp/auto_gen.py'
+        return None, None
+
+    def _generate_oracle_files(self):
+        """
+        Ask the LLM for a brute-force oracle and a seeded small-input generator, then write
+        them to /tmp/auto_oracle.py and /tmp/auto_gen.py. Returns True on success.
+        """
+        prompt = f"""Write two Python 3 programs for the competitive programming problem below.
+
+<problem_statement>
+{self.problem_statement}
+</problem_statement>
+
+1) ORACLE: a brute-force reference solution that reads the problem input from stdin and prints the answer to stdout.
+   It must be obviously correct: use BFS, exhaustive search, or direct simulation of the rules as stated.
+   Do NOT use a clever formula or an optimized algorithm. It only needs to be correct on small inputs.
+2) GENERATOR: a program that takes ONE integer command-line argument (a seed, used with random.seed) and prints ONE valid small input
+   in the exact stdin format of the problem. Keep sizes small (for example, at most 8 elements, values at most 10) so the oracle is fast.
+   Keep it valid under all the constraints of the statement. Do not print anything except the input.
+
+Return exactly two fenced code blocks, in this order, and nothing else of substance:
+```python
+<oracle code>
+```
+```python
+<generator code>
+```
+"""
+        text = simple_chat(prompt, model=self.code_model, max_tokens=8192, logging=safe_log)
+        blocks = re.findall(r"```(?:python|py)?\s*\n(.*?)```", text or "", re.DOTALL)
+        if len(blocks) < 2:
+            safe_log("[oracle] could not extract oracle and generator code blocks.")
+            return False
+        oracle_code, gen_code = blocks[0], blocks[1]
+        import ast
+        try:
+            ast.parse(oracle_code)
+            ast.parse(gen_code)
+        except SyntaxError as e:
+            safe_log(f"[oracle] generated code has a syntax error: {e}")
+            return False
+        if os.path.exists('/tmp/auto_oracle.py') or os.path.exists('/tmp/auto_gen.py'):
+            safe_log('[oracle] /tmp/auto_oracle.py or /tmp/auto_gen.py already exists; not overwriting.')
+            return os.path.exists('/tmp/auto_oracle.py') and os.path.exists('/tmp/auto_gen.py')
+        with open('/tmp/auto_oracle.py', 'w') as f:
+            f.write(oracle_code)
+        with open('/tmp/auto_gen.py', 'w') as f:
+            f.write(gen_code)
+        safe_log("[oracle] wrote /tmp/auto_oracle.py and /tmp/auto_gen.py")
+        return True
+
+    def _differential_test(self, solution_path, oracle_path, gen_path, n=300, timeout=5):
+        """
+        Run the solution and the oracle on n generated inputs (seeds 0..n-1) and compare
+        whitespace-normalized stdout. Returns (report, all_passed).
+        The report is raw plain text: the pass count and the first 3 mismatches with
+        input, oracle output, solution output, and stderr. Oracle failures (timeout or
+        crash) are reported separately and recorded in self._oracle_failed.
+        """
+        self._oracle_failed = False
+        if not solution_path or not os.path.exists(solution_path):
+            return f"Solution file not found: {solution_path}", False
+        passed = 0
+        mismatches = []
+        for seed in range(n):
+            try:
+                gen = subprocess.run(
+                    ["python3", gen_path, str(seed)],
+                    capture_output=True, text=True, timeout=timeout,
+                )
+            except subprocess.TimeoutExpired:
+                return (f"GENERATOR TIMEOUT on seed {seed} ({gen_path}). Fix the generator first.", False)
+            stdin_text = gen.stdout
+            if gen.returncode != 0 or not stdin_text.strip():
+                return (f"GENERATOR FAILED on seed {seed} (exit {gen.returncode}), stderr:\n{gen.stderr}", False)
+            if not stdin_text.endswith("\n"):
+                stdin_text += "\n"
+
+            try:
+                ora = subprocess.run(
+                    ["python3", oracle_path],
+                    input=stdin_text, capture_output=True, text=True, timeout=timeout,
+                )
+            except subprocess.TimeoutExpired:
+                self._oracle_failed = True
+                return (f"ORACLE TIMEOUT on seed {seed}: {oracle_path} did not finish in {timeout} seconds.\n"
+                        f"--- input ---\n{stdin_text}", False)
+            if ora.returncode != 0:
+                self._oracle_failed = True
+                return (f"ORACLE CRASHED on seed {seed} (exit {ora.returncode}): {oracle_path}\n"
+                        f"--- input ---\n{stdin_text}\n--- stderr ---\n{ora.stderr}", False)
+
+            try:
+                sol = subprocess.run(
+                    ["python3", solution_path],
+                    input=stdin_text, capture_output=True, text=True, timeout=timeout,
+                    cwd=self.git_tempdir,
+                )
+                sol_out, sol_err, sol_note = sol.stdout, sol.stderr, f"exit code {sol.returncode}"
+                sol_ok = sol.returncode == 0
+            except subprocess.TimeoutExpired:
+                sol_out, sol_err, sol_note = "", f"TIMEOUT: exceeded {timeout} seconds", "timeout"
+                sol_ok = False
+
+            if sol_ok and sol_out.split() == ora.stdout.split():
+                passed += 1
+            else:
+                mismatches.append(
+                    f"=== Mismatch (seed {seed}, solution {sol_note}) ===\n"
+                    f"--- input ---\n{stdin_text}"
+                    f"--- oracle output ---\n{ora.stdout}"
+                    f"--- solution output ---\n{sol_out}"
+                    f"--- stderr ---\n{sol_err}\n"
+                )
+                if len(mismatches) >= 3:
+                    break
+
+        if mismatches:
+            report = (f"DIFFERENTIAL TEST FAILED: {passed} of {n} generated cases passed "
+                      f"(solution {solution_path} vs oracle {oracle_path}).\n\n" + "\n".join(mismatches))
+            return report, False
+        return f"DIFFERENTIAL TEST PASSED: all {passed} of {n} generated cases matched the oracle.", True
+
