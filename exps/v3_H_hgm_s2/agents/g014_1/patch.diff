diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..101aa99
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,130 @@
+import os
+import re
+import subprocess
+import sys
+import time
+
+DEFAULT_TIMEOUT = 10.0
+TIME_LIMIT_SECONDS = 2.0
+DEFAULT_SIZES = ["200000"]
+MAX_REPORT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Measure the runtime of a solution on large generated inputs.\n
+* Runs `python generator_path <size>` for each size (default size 200000) to produce one large input.\n
+* Runs the solution on that input with stdin set to the generated input and measures wall time.\n
+* Reports per-size runtime and a verdict: 'BENCHMARK OK' if every run finishes within 2 seconds, otherwise 'BENCHMARK SLOW', 'BENCHMARK TIMEOUT' or 'BENCHMARK CRASH' (with stderr).\n
+* Use it on a maximum-constraint input to confirm the solution is fast enough. The task is not finished until the verdict is 'BENCHMARK OK'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to benchmark."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python script run as `python generator_path <size_arg>` that prints one large test input to stdout, e.g. /tmp/gen_big.py."
+                },
+                "sizes": {
+                    "type": "string",
+                    "description": "Optional space- or comma-separated size arguments passed to the generator, e.g. '200000' or '1000 100000 200000'. Default: 200000."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for the solution. Default 10."
+                }
+            },
+            "required": ["solution_path", "generator_path"]
+        }
+    }
+
+
+def _clip(text, limit=MAX_REPORT_CHARS):
+    text = text or ""
+    return text if len(text) <= limit else text[:limit] + "\n...<clipped>"
+
+
+def _parse_sizes(sizes):
+    if sizes is None or (isinstance(sizes, str) and not sizes.strip()):
+        return list(DEFAULT_SIZES)
+    if isinstance(sizes, (list, tuple)):
+        parts = [str(s) for s in sizes]
+    else:
+        parts = re.split(r"[\s,]+", str(sizes).strip())
+    return [p for p in parts if p]
+
+
+def _to_float(value, default):
+    if value is None or value == "":
+        return default
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def tool_function(solution_path, generator_path, sizes=None, timeout=DEFAULT_TIMEOUT):
+    timeout = _to_float(timeout, DEFAULT_TIMEOUT)
+    if not os.path.isfile(solution_path):
+        return f"ERROR: solution_path does not exist: {solution_path}"
+    if not os.path.isfile(generator_path):
+        return f"ERROR: generator_path does not exist: {generator_path}"
+    size_list = _parse_sizes(sizes)
+    if not size_list:
+        return "ERROR: no sizes given."
+
+    py = sys.executable
+    lines = []
+    verdict = "OK"
+    severity = {"OK": 0, "SLOW": 1, "CRASH": 2, "TIMEOUT": 3}
+    details = []
+
+    for size in size_list:
+        try:
+            gen = subprocess.run([py, generator_path, size], capture_output=True, text=True, timeout=timeout)
+        except subprocess.TimeoutExpired:
+            verdict = "TIMEOUT"
+            details.append(f"size {size}: generator timed out after {timeout}s")
+            break
+        if gen.returncode != 0 or not gen.stdout.strip():
+            verdict = "CRASH"
+            details.append(f"size {size}: generator failed (exit {gen.returncode}).\n"
+                           f"stderr:\n{_clip(gen.stderr)}")
+            break
+        test_input = gen.stdout if gen.stdout.endswith("\n") else gen.stdout + "\n"
+        input_chars = len(test_input)
+
+        start = time.time()
+        try:
+            run = subprocess.run([py, solution_path], input=test_input, capture_output=True,
+                                 text=True, timeout=timeout)
+        except subprocess.TimeoutExpired:
+            verdict = "TIMEOUT"
+            details.append(f"size {size} (input {input_chars} chars): solution timed out after {timeout}s")
+            break
+        elapsed = time.time() - start
+
+        if run.returncode != 0:
+            this = "CRASH"
+            details.append(f"size {size}: solution crashed (exit {run.returncode}).\n"
+                           f"stderr:\n{_clip(run.stderr)}")
+        elif elapsed > TIME_LIMIT_SECONDS:
+            this = "SLOW"
+            details.append(f"size {size}: {elapsed:.3f}s exceeds the {TIME_LIMIT_SECONDS}s limit")
+        else:
+            this = "OK"
+            details.append(f"size {size}: {elapsed:.3f}s")
+        lines.append(f"size {size}: {elapsed:.3f}s ({this})")
+        if severity[this] > severity[verdict]:
+            verdict = this
+        if verdict in ("CRASH", "TIMEOUT"):
+            break
+
+    header = f"BENCHMARK {verdict}"
+    if verdict == "OK":
+        header += f" (all runs under {TIME_LIMIT_SECONDS}s)"
+    return "\n".join([header] + details)
