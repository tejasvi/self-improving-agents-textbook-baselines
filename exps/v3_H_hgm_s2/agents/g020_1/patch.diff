+                    samples.append({"input": str(item["input"]), "output": str(item["output"])})
+        return samples
+
+    def _run_samples(self, solution_path, samples):
+        """
+        Run the solution with python3 on each sample. Returns (report, all_passed).
+        The report is raw plain text: input, expected output, actual output, stderr, runtime.
+        """
+        if not samples:
+            return "No samples were extracted from the problem statement; verify manually with your own tests.", False
+        if not solution_path or not os.path.exists(solution_path):
+            return f"Solution file not found: {solution_path}", False
+
+        blocks = []
+        all_passed = True
+        for i, sample in enumerate(samples):
+            stdin_text = sample["input"]
+            if stdin_text and not stdin_text.endswith("\n"):
+                stdin_text += "\n"
+            start = time.time()
+            try:
+                proc = subprocess.run(
+                    ["python3", solution_path],
+                    input=stdin_text, capture_output=True, text=True, timeout=10,
+                    cwd=self.git_tempdir,
+                )
+                elapsed = time.time() - start
+                actual = proc.stdout
+                stderr = proc.stderr
+                status_note = f"exit code {proc.returncode}"
+                passed = proc.returncode == 0 and actual.split() == sample["output"].split()
+            except subprocess.TimeoutExpired:
+                elapsed = time.time() - start
+                actual, stderr = "", "TIMEOUT: exceeded 10 seconds"
+                status_note = "timeout"
+                passed = False
+            if not passed:
+                all_passed = False
