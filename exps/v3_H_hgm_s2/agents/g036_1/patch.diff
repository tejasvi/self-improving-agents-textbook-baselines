@@ -0,0 +1,108 @@
+import subprocess
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress test: compare a solution program against a brute-force oracle on randomly generated inputs.
+
+* gen_cmd is a shell command called as `gen_cmd <seed>` for each seed in [seed_start, seed_start + num_tests). It must print one complete random test input (stdin text) to stdout. The generator should produce SMALL inputs so the oracle is fast.
+* solution_cmd and oracle_cmd read the test input on stdin and print the answer on stdout (e.g. `python3 /dgm/solution.py`, `python3 /tmp/auto_oracle_123.py`).
+* Outputs are compared token-wise (whitespace-separated tokens must match exactly, in order).
+* The report contains ONLY the number of tests passed and, for the SMALLEST failing input (by length), the input, the expected (oracle) output and the actual (solution) output. A failing counterexample means the solution's algorithm/formula is wrong: re-derive it from the oracle's outputs rather than patching it.
+* If the oracle itself fails (timeout, crash), the tool reports that instead, so the oracle can be fixed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the solution under test; reads stdin, writes stdout."
+                },
+                "oracle_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted brute-force oracle; reads stdin, writes stdout."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command called as '<gen_cmd> <seed>' that prints one random small test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds seed_start .. seed_start+num_tests-1). Default 300."
+                },
+                "seed_start": {
+                    "type": "integer",
+                    "description": "First seed passed to the generator. Default 0."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Per-run timeout in seconds for each program. Default 10."
+                }
+            },
+            "required": ["solution_cmd", "oracle_cmd", "gen_cmd"]
+        }
+    }
+
+def _run(cmd, stdin_text, timeout):
+    try:
+        proc = subprocess.run(cmd, shell=True, input=stdin_text, capture_output=True,
+                              text=True, timeout=timeout)
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired:
+        return None, "", "", True
+
+def _tokens(text):
+    return (text or "").split()
+
+def tool_function(solution_cmd, oracle_cmd, gen_cmd, num_tests=300, seed_start=0, timeout_sec=10):
+    try:
+        num_tests = int(num_tests) if num_tests else 300
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        seed_start = int(seed_start) if seed_start is not None else 0
+    except (TypeError, ValueError):
+        seed_start = 0
+    try:
+        timeout_sec = int(timeout_sec) if timeout_sec else 10
+    except (TypeError, ValueError):
+        timeout_sec = 10
+
+    passed = 0
+    failures = []  # (input_text, expected, actual, reason)
+    for seed in range(seed_start, seed_start + num_tests):
+        gcode, gout, gerr, gtimeout = _run(f"{gen_cmd} {seed}", None, timeout_sec)
+        if gtimeout or gcode != 0:
+            return (f"Generator failed at seed={seed}: "
+                    f"{'timeout' if gtimeout else (gerr.strip()[:500] or f'exit {gcode}')}. Passed {passed} test(s) before this.")
+        test_input = gout
+        if test_input and not test_input.endswith("\n"):
+            test_input += "\n"
+
+        ocode, oout, oerr, otimeout = _run(oracle_cmd, test_input, timeout_sec)
+        if otimeout or ocode != 0:
+            return (f"ORACLE FAILED at seed={seed} (timeout={otimeout}, exit={ocode}); "
+                    f"oracle stderr: {oerr.strip()[:500]}. Passed {passed} test(s) before this. "
+                    f"The oracle must be fast and correct on tiny inputs; fix the oracle or the generator.\n"
+                    f"--- input ---\n{test_input}")
+
+        scode, sout, serr, stimeout = _run(solution_cmd, test_input, timeout_sec)
+        if stimeout:
+            failures.append((test_input, oout, "", "solution TIMEOUT"))
+        elif scode != 0:
+            failures.append((test_input, oout, sout, f"solution exit {scode}: {serr.strip()[:500]}"))
+        elif _tokens(sout) != _tokens(oout):
+            failures.append((test_input, oout, sout, "output mismatch"))
+        else:
+            passed += 1
+
+    total = num_tests
+    if not failures:
+        return f"STRESS TEST PASSED: {passed}/{total} random tests matched the oracle (seeds {seed_start}..{seed_start + total - 1})."
+
+    best = min(failures, key=lambda f: len(f[0]))
+    test_input, expected, actual, reason = best
+    return (f"STRESS TEST FAILED: passed {passed}/{total} tests; {len(failures)} failing. "
+            f"Smallest failing input (reason: {reason}):\n"
+            f"--- input ---\n{test_input}"
+            f"--- expected (oracle) ---\n{expected.strip()}\n"
+            f"--- actual (solution) ---\n{actual.strip()}")
