+    def _run_differential(self, solution_path, oracle_dir, n_tests=200, timeout=5, max_failures=3):
+        """
+        Run the solution against the oracle over seeds 0..n_tests-1.
+        - stdin/class problems: expected = ref.py(input), compared by tokens (or checker.py if present).
+        - interactive problems (judge.py present): judge.py(solution) on the generated input must print PASS.
+        Returns (report, n_failures). The report is raw text for the first max_failures cases:
+        input, expected, actual, stderr. Errors are not parsed; the raw text is handed to the agent.
+        """
+        if not solution_path or not os.path.exists(solution_path):
+            return f"Solution file not found: {solution_path}", 1
+
+        def _py(script, args, stdin_text=None, tmo=timeout):
+            try:
+                proc = subprocess.run(
+                    ["python3", os.path.join(oracle_dir, script)] + args,
+                    input=stdin_text, capture_output=True, text=True, timeout=tmo, cwd=oracle_dir,
+                )
+                return proc.returncode, proc.stdout, proc.stderr, False
+            except subprocess.TimeoutExpired as e:
+                def _t(x):
+                    if x is None:
+                        return ""
+                    return x.decode(errors="replace") if isinstance(x, bytes) else x
+                return None, _t(e.stdout), _t(e.stderr), True
+
+        mode, method = self._detect_mode(solution_path)
+        has_judge = os.path.exists(os.path.join(oracle_dir, "judge.py"))
+        has_checker = os.path.exists(os.path.join(oracle_dir, "checker.py"))
+        failures = []
+        n_failures = 0
+        n_skipped = 0
+        for seed in range(n_tests):
+            if n_failures >= max_failures:
+                break
+            rc, inp, gerr, gto = _py("gen_small.py", [str(seed)], tmo=20)
+            if gto or rc != 0 or not inp.strip():
+                n_skipped += 1  # generator problem; not a solution failure
+                continue
+            if has_judge:
+                jrc, jout, jerr, jto = _py("judge.py", [solution_path], stdin_text=inp, tmo=timeout * 3)
+                verdict_lines = [ln for ln in (jout or "").splitlines() if ln.strip()]
+                verdict = verdict_lines[0] if verdict_lines else ""
+                if jto or not verdict.startswith("PASS"):
+                    n_failures += 1
+                    status = "JUDGE TIMEOUT" if jto else "JUDGE OUTPUT"
+                    failures.append(
+                        f"=== Failing case (seed {seed}, {status}) ===\n"
+                        f"--- input ---\n{self._clip(inp)}\n"
+                        f"--- judge output ---\n{self._clip(jout)}\n"
+                        f"--- judge stderr ---\n{self._clip(jerr)}\n"
+                    )
+                continue
+
+            ref_rc, expected, ref_err, ref_to = _py("ref.py", [], stdin_text=inp, tmo=20)
+            if ref_to or ref_rc != 0:
+                n_skipped += 1  # reference problem; do not blame the solution
+                continue
+            res = self._run_candidate(solution_path, mode, method, inp, timeout=timeout, tag=f"diff{seed}")
+            actual = "" if res["timed_out"] else res["stdout"]
+            stderr = ("TIMEOUT: exceeded %ss\n" % timeout) if res["timed_out"] else res["stderr"]
+            if res["timed_out"] or res["returncode"] != 0:
+                ok = False
+            elif has_checker:
+                in_path = os.path.join(oracle_dir, f"_in_{seed}.txt")
+                out_path = os.path.join(oracle_dir, f"_out_{seed}.txt")
+                with open(in_path, "w") as f:
+                    f.write(inp)
+                with open(out_path, "w") as f:
+                    f.write(actual)
+                crc, cout, _, cto = _py("checker.py", [in_path, out_path], tmo=20)
+                first = (cout or "").strip().splitlines()
+                ok = (not cto) and crc == 0 and bool(first) and first[0].startswith("OK")
+            elif mode == "class":
+                ok = self._outputs_match(actual, expected)
+            else:
+                ok = actual.split() == expected.split()
+            if not ok:
+                n_failures += 1
+                failures.append(
+                    f"=== Failing case (seed {seed}, exit code {res['returncode']}) ===\n"
+                    f"--- input ---\n{self._clip(inp)}\n"
+                    f"--- expected output (from ref.py) ---\n{self._clip(expected)}\n"
+                    f"--- actual output ---\n{self._clip(actual)}\n"
+                    f"--- stderr ---\n{self._clip(stderr)}\n"
+                )
+        header = (
+            f"DIFFERENTIAL TEST: {'ALL PASSED' if n_failures == 0 else 'FAILURES FOUND'} "
+            f"(seeds tried: up to {n_tests}, failures collected: {n_failures}, generator/reference skips: {n_skipped})"
+        )
+        return header + "\n\n" + "\n".join(failures), n_failures
+
+    def _run_interactive_perf(self, solution_path, oracle_dir, timeout=3.0):
+        """
+        Interactive problems: time the solution through the oracle's judge (never on plain stdin).
+        Uses gen_large.py seeds when available, else gen_small.py seeds. Returns (report, needs_repair).
+        """
+        gen = "gen_large.py" if os.path.exists(os.path.join(oracle_dir, "gen_large.py")) else "gen_small.py"
+        blocks = []
+        needs_repair = False
+        for seed in range(4):
+            try:
+                g = subprocess.run(["python3", os.path.join(oracle_dir, gen), str(seed)],
+                                   capture_output=True, text=True, timeout=20, cwd=oracle_dir)
+            except subprocess.TimeoutExpired:
+                continue
+            if g.returncode != 0 or not g.stdout.strip():
+                continue
+            try:
+                proc = subprocess.run(["python3", os.path.join(oracle_dir, "judge.py"), solution_path],
+                                      input=g.stdout, capture_output=True, text=True,
+                                      timeout=timeout * 3, cwd=oracle_dir)
+                verdict = (proc.stdout or "").strip().splitlines()
+                status = verdict[0] if verdict else f"NO VERDICT (exit code {proc.returncode})"
+                if not status.startswith("PASS"):
+                    needs_repair = True
+                blocks.append(f"=== Judge case seed {seed} ({gen}) ===\n--- judge output ---\n{self._clip(proc.stdout)}\n"
+                              f"--- stderr ---\n{self._clip(proc.stderr)}\n")
+            except subprocess.TimeoutExpired:
+                needs_repair = True
+                blocks.append(f"=== Judge case seed {seed} ({gen}) ===\nTIMEOUT (exceeded {timeout * 3:g}s)\n")
+        if not blocks:
+            return "No interactive perf cases could be generated.", False
+        return "\n".join(blocks), needs_repair
+
+    def _run_oracle_phase(self, task, max_rounds=3):
+        """
+        Build the oracle, then run differential tests and up to max_rounds repair rounds.
+        Returns the oracle directory (or None when it could not be built).
