+    def _detect_interactive(self):
+        """
+        Keyword check on the problem statement for interactive / judge-protocol problems.
+        """
+        text = (self.problem_statement or "").lower()
+        return any(k in text for k in ("interactive", "interactor", "judge will respond", "flush the output"))
+
+    def _attempt_memory(self):
+        """
+        Text block with previous hypotheses and their refutations, injected into later prompts.
+        """
+        if not self.attempt_log:
+            return "(no earlier attempts)"
+        return "\n\n".join(f"--- earlier attempt {i + 1} ---\n{entry}" for i, entry in enumerate(self.attempt_log))
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """
+        Extract the text of the last assistant message from a chat history (best effort).
+        """
+        for msg in reversed(msg_history or []):
+            if not isinstance(msg, dict) or msg.get("role") != "assistant":
+                continue
+            content = msg.get("content")
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                parts = []
+                for block in content:
+                    if isinstance(block, dict) and isinstance(block.get("text"), str):
+                        parts.append(block["text"])
+                    elif isinstance(block, str):
+                        parts.append(block)
+                if parts:
+                    return "\n".join(parts)
+        return ""
+
+    @staticmethod
+    def _clip(text, limit=1500):
+        text = text or ""
+        if len(text) <= limit:
+            return text
+        return text[:limit] + f"\n... [truncated, {len(text)} chars total]"
+
+    def _build_oracle(self):
+        """
+        Ask a separate agent session, which sees ONLY the problem statement, to write an independent
+        reference in a temp directory outside the repo. Returns the oracle directory, or None on failure.
+        Contract of the files written:
+          - ref.py: reads stdin, prints the exact expected output (naive, definition-level).
+          - gen_small.py SEED: prints one small valid input (deterministic per seed).
+          - checker.py INPUT_FILE ACTUAL_FILE (optional): prints OK or FAIL: reason; used only when many outputs are valid.
+          - judge.py SOLUTION_PATH (interactive problems only): reads the hidden input on stdin (from gen_small),
+            runs the solution as a subprocess, simulates the interactor, prints PASS or FAIL with details.
+          - gen_large.py SEED (optional): prints a large valid input for timing.
+        """
+        oracle_dir = tempfile.mkdtemp(prefix="oracle_", dir="/tmp")
+        interactive = self._detect_interactive()
+        judge_clause = (
+            "- judge.py: the problem is INTERACTIVE. Write judge.py that takes the solution path as argv[1], reads the "
+            "hidden test (the secret input) from stdin, runs the solution as a subprocess with pipes, plays the interactor "
+            "role exactly as the statement describes, enforces the protocol (valid query format, query limits, flushing, "
+            "answer correctness), uses ref logic for the true answer or minimum, and prints a single line starting with "
+            "PASS or FAIL followed by details. Kill the subprocess on timeout (use a bounded timeout, e.g. 5 seconds)."
+            if interactive else
+            "- judge.py is NOT needed (the problem is not interactive)."
+        )
+        prompt = f"""You are building an independent test oracle for the competitive programming problem below.
+You do NOT have access to any solution; derive everything directly from the problem definition.
+
+<problem_statement>
+{self.problem_statement}
+</problem_statement>
+
+Write the following files into the directory {oracle_dir} ONLY (do not touch any other directory, do not create files in any repository).
+Use the editor tool's `create` command to write each file. Do NOT use bash heredocs or `echo >` to write files.
+Use `python3` to test each file with bash after writing it.
+
+- ref.py: a NAIVE, definition-level reference implementation. It reads the whole input from stdin and prints the exact expected output.
+  For a Solution-class task (a method, not stdin), ref.py and gen_small.py use the same stdin shape as the solution harness:
+  gen_small.py prints one line with a Python-literal list of the method arguments, e.g. [[1, 2], 3]; ref.py reads that line and prints repr() of the expected return value.
+  Derive it directly from the definition in the statement (brute-force search, simulation, exhaustive enumeration). Do NOT use a clever closed-form
+  formula, a known trick, or a shortcut: a formula can be wrong even when it matches tiny cases. Correctness is the only goal here; speed is not.
+  If the problem has a unique answer per input, ref.py output must match exactly.
+- gen_small.py: takes one integer SEED as argv[1] and prints ONE small but VALID input to stdout (respecting every constraint of the statement).
+  Use random.Random(SEED) for determinism. Seeds 0..9 should cover corner cases (minimum sizes, equal values, boundary values); larger seeds give random small inputs.
+  The largest inputs it produces should be as large as ref.py can still brute-force within about 1 second, so that the reference covers the largest feasible domain,
+  not only tiny inputs.
+{judge_clause}
+- checker.py (ONLY if the problem allows multiple valid answers): takes INPUT_FILE and ACTUAL_FILE as argv[1] and argv[2] and prints a line starting with OK
+  if the actual output is valid for the input, otherwise FAIL: <reason>. Do not write checker.py for problems with a unique answer.
+- gen_large.py (optional): takes SEED as argv[1] and prints one input at the maximum allowed size for timing.
+
+Verification you must do before finishing:
+1. Run ref.py on the outputs of gen_small.py for seeds 0..30 and make sure it never crashes and always prints an answer.
+2. Sanity-check ref.py by hand on at least one sample from the statement if any is given in the statement.
+3. If judge.py is present, smoke-test it against a deliberately wrong program (e.g. one that prints nothing and exits) written with the editor tool in {oracle_dir}; confirm judge.py prints FAIL and does not hang.
+
+Finish only after all required files exist in {oracle_dir} and pass these checks. Do not reply with text only.
+"""
+        chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+
+        required = ["ref.py", "gen_small.py"] + (["judge.py"] if interactive else [])
+        missing = [f for f in required if not os.path.exists(os.path.join(oracle_dir, f))]
+        if missing:
+            safe_log(f"[oracle] missing files {missing} in {oracle_dir}; differential testing disabled.")
+            return None
+        try:
+            probe = subprocess.run(
+                ["python3", os.path.join(oracle_dir, "gen_small.py"), "0"],
+                capture_output=True, text=True, timeout=20, cwd=oracle_dir,
+            )
+            if probe.returncode != 0 or not probe.stdout.strip():
+                safe_log(f"[oracle] gen_small.py seed 0 failed: {probe.stderr[-1000:]}")
+                return None
+        except subprocess.TimeoutExpired:
+            safe_log("[oracle] gen_small.py seed 0 timed out.")
+            return None
+        safe_log(f"[oracle] built oracle in {oracle_dir} (interactive={interactive}).")
+        return oracle_dir
