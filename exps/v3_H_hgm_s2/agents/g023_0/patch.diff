+            safe_log(f"[differential round {round_idx}] solution: {solution_path}\n{report}")
+            if n_fail == 0:
+                safe_log(f"[differential round {round_idx}] no discrepancies; stopping.")
+                break
+            if round_idx == max_rounds:
+                safe_log("[differential] repair budget exhausted with failures remaining.")
+                break
+            current_diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+            repair_msg = f"""{task}
+
