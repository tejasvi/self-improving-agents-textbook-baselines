+def sentinel_tokens(text, allowed_text=""):
+    """
+    Tokens of `text` that look like sentinel/overflow values: inf, nan, or numbers with
+    magnitude >= 1e17. Tokens that also appear in `allowed_text` (e.g. the expected output)
+    are legitimate and are not returned.
