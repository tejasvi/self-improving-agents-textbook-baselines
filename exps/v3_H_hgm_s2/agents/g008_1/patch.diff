+EMPTY_MAX_TOKENS_NUDGE = (
+    "Your previous response was cut off. Do not think at length; "
+    "call the editor tool now to write the file."
+)
+EMPTY_MAX_TOKENS_RETRY_LIMIT = 2
+EMPTY_MAX_TOKENS_RETRY_BUDGET = 8192
+
+def _is_empty_max_tokens(response):
+    return getattr(response, 'stop_reason', None) == 'max_tokens' and not response.content
+
+def get_response_handling_empty(client, model, base_messages, tools, logging):
+    """
+    Call the model. If it stops at max_tokens with no content, append a nudge
+    to the conversation and retry a bounded number of times with a larger
+    max_tokens budget. Returns (response, messages_used_for_last_call).
+    """
+    messages = base_messages
+    response = get_response_withtools(
+        client=client, model=model, messages=messages,
+        tool_choice={"type": "auto"}, tools=tools, logging=logging,
+    )
+    for attempt in range(EMPTY_MAX_TOKENS_RETRY_LIMIT):
+        if not _is_empty_max_tokens(response):
+            break
+        logging(f"[empty max_tokens] attempt {attempt + 1}: model produced no output; nudging to call the editor tool.")
+        messages = base_messages + [{
+            "role": "user",
+            "content": [{"type": "text", "text": EMPTY_MAX_TOKENS_NUDGE}],
+        }]
+        response = get_response_withtools(
+            client=client, model=model, messages=messages,
+            tool_choice={"type": "auto"}, tools=tools, logging=logging,
+            max_tokens=EMPTY_MAX_TOKENS_RETRY_BUDGET,
+        )
+    return response, messages
+
