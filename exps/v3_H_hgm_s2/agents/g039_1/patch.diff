+import os
+import sys
+import shutil
+import subprocess
+import tempfile
+
+CLIP = 800
+TIMEOUT = 5
+
+
+def clip(s, n=CLIP):
+    s = s or ""
+    return s if len(s) <= n else s[:n] + "...[clipped]"
+
+
+def run_candidate(path, payload, timeout=TIMEOUT):
+    """Run a stdin-program candidate. Returns (status, stdout_or_err)."""
+    try:
+        r = subprocess.run([sys.executable, path], input=payload,
+                           capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return "timeout", ""
+    if r.returncode != 0:
+        return "crash", clip(r.stderr)
+    return "ok", r.stdout
+
+
+def outputs_match(a, b):
+    return a.split() == b.split()
+
+
+def build_pool(samples, diff_inputs, ref_path, perf_inputs):
+    """samples: list of (input, expected). diff_inputs: list of input str.
+    perf_inputs: list of input str. Expected for diff cases comes from ref."""
+    pool = []
+    for i, (inp, exp) in enumerate(samples):
+        pool.append({"name": f"sample{i}", "payload": inp,
+                     "expected": exp, "kind": "sample"})
+    for i, inp in enumerate(diff_inputs):
+        st, out = run_candidate(ref_path, inp)
+        if st == "ok":
+            pool.append({"name": f"diff{i}", "payload": inp,
+                         "expected": out, "kind": "diff"})
+    for i, inp in enumerate(perf_inputs):
+        pool.append({"name": f"perf{i}", "payload": inp,
+                     "expected": None, "kind": "perf"})
+    return pool
+
+
+def score_candidate(path, pool):
+    """Returns ((sample_fails, diff_fails, perf_fails), failures)."""
+    counts = {"sample": 0, "diff": 0, "perf": 0}
+    failures = []
+    for case in pool:
+        st, out = run_candidate(path, case["payload"])
+        if case["kind"] == "perf":
+            bad = st != "ok"
+        else:
+            bad = st != "ok" or not outputs_match(out, case["expected"])
+        if bad:
+            counts[case["kind"]] += 1
+            failures.append(f"{case['name']} [{st}]: {clip(out)}")
+    return (counts["sample"], counts["diff"], counts["perf"]), failures
+
+
+def cross_check(paths, diff_inputs):
+    """Inputs where candidates disagree; returned for adding to the pool."""
+    disagreeing = []
+    for inp in diff_inputs:
+        outs = [run_candidate(p, inp) for p in paths]
+        norm = [o[1].split() if o[0] == "ok" else ("ERR", o[0]) for o in outs]
+        if any(n != norm[0] for n in norm[1:]):
+            disagreeing.append(inp)
+    return disagreeing
+
+
+def choose_best(paths, pool):
+    """Deterministic: lowest score tuple, ties broken by index."""
+    best = None
+    for idx, p in enumerate(paths):
+        score, _ = score_candidate(p, pool)
+        print(f"candidate {idx}: score={score}")
+        if best is None or score < best[0]:
+            best = (score, idx, p)
+        if score == (0, 0, 0):
+            break
+    print(f"chosen candidate {best[1]} with score {best[0]}")
+    return best
+
+
+def repair_with_revert(target, pool, repair_fn, rounds=3):
+    """repair_fn(target, failures) edits target in place.
+    Reverts to the best snapshot if the score worsens."""
+    best_score, failures = score_candidate(target, pool)
+    with tempfile.TemporaryDirectory() as td:
+        snap = os.path.join(td, "best.py")
+        shutil.copy(target, snap)
+        for r in range(rounds):
+            if best_score == (0, 0, 0) or not failures:
+                break
+            repair_fn(target, failures)
+            score, failures = score_candidate(target, pool)
+            print(f"repair round {r}: score={score}")
+            if score > best_score:
+                print("regression detected; reverting")
+                shutil.copy(snap, target)
+                score, failures = score_candidate(target, pool)
+            else:
+                best_score = score
+                shutil.copy(target, snap)
+        shutil.copy(snap, target)
+    return best_score
