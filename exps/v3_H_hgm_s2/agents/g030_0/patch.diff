+    def _multi_candidate(self, task, solution_path, oracle_dir):
+        """
+        Generate a second candidate, cross-run both on all oracle and adversarial tests, select by
+        (fewest failures, then least time), copy the winner into solution_path, and log the decision.
+        """
+        cand2 = self._second_candidate(task, solution_path, oracle_dir)
+        if not cand2:
+            safe_log("[candidates] second candidate identical to the first; keeping the first.")
+            return
+        with open(solution_path) as f:
+            cand1_src = f.read()
+        cand1 = tempfile.NamedTemporaryFile(mode="w", suffix="_candidate1.py", dir="/tmp", delete=False)
+        cand1.write(cand1_src)
+        cand1.close()
+        adv_files = self._adv_files(oracle_dir)
+        scored = []
+        for label, path in (("candidate1", cand1.name), ("candidate2", cand2)):
+            fails, elapsed = self._score_candidate(path, oracle_dir, adv_files)
+            scored.append({"label": label, "path": path, "failures": fails, "time": elapsed})
+            safe_log(f"[candidates] {label}: failures={fails}, time={elapsed:.1f}s")
+        winner = min(scored, key=lambda c: (c["failures"], c["time"]))
+        with open(winner["path"]) as f:
+            winner_src = f.read()
+        with open(solution_path, "w") as f:
+            f.write(winner_src)
+        safe_log(f"[candidates] selected {winner['label']} (failures={winner['failures']}, "
+                 f"time={winner['time']:.1f}s) and copied it to {solution_path}.")
