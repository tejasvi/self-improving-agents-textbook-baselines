+    def _audit_oracle(self, solution_path, oracle_dir, n_mutants=4, n_tests=60):
+        """
+        Mutation audit: simple_chat writes several deliberately wrong or suboptimal variants of the current solution
+        (separated by '### MUTANT k' lines). Each mutant is saved to oracle_dir/mutants/ and run through the
+        differential pipeline; a mutant that PASSES means the oracle is too weak.
+        Returns the list of (mutant_path, mutant_source) that survived.
+        """
+        if not solution_path or not os.path.exists(solution_path):
+            return []
+        with open(solution_path) as f:
+            source = f.read()
+        prompt = f"""Below is a competitive programming problem and a correct solution. Write {n_mutants} DIFFERENT deliberately
+WRONG or SUBOPTIMAL variants of the solution, to test a test oracle. Good mutants include: an off-by-one error, a dropped term
+or case, a degraded strategy that is correct on small inputs but uses more queries/operations than needed, and an answer that is
+one too large or too small in one case. Each mutant must be a complete program with the same interface as the original.
+Output format: for each mutant print a line '### MUTANT k' followed by the full Python source (optionally in a ```python fence).
+Output nothing else.
+
+<problem_statement>
+{self.problem_statement}
+</problem_statement>
+
+<solution>
+{source}
+</solution>
+"""
+        text = simple_chat(prompt, model=self.code_model, logging=safe_log)
+        parts = re.split(r"^### MUTANT.*$", text or "", flags=re.M)[1:][:n_mutants]
+        mutant_dir = os.path.join(oracle_dir, "mutants")
+        os.makedirs(mutant_dir, exist_ok=True)
+        survivors = []
+        for k, part in enumerate(parts):
+            code = self._strip_fences(part)
+            if not code.strip():
+                continue
+            mpath = os.path.join(mutant_dir, f"mutant_{k}.py")
+            with open(mpath, "w") as f:
+                f.write(code)
+            report, n_fail = self._run_differential(mpath, oracle_dir, n_tests=n_tests, max_failures=1)
+            safe_log(f"[audit] mutant {k}: {'KILLED' if n_fail else 'SURVIVED'} ({n_fail} failure(s))")
+            if n_fail == 0:
+                survivors.append((mpath, code))
+        safe_log(f"[audit] {len(survivors)} surviving mutant(s) out of {len(parts)}.")
+        return survivors
+
