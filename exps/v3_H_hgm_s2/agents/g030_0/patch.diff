+    @staticmethod
+    def _strip_fences(text):
+        text = (text or "").strip()
+        m = re.search(r"```(?:python)?\s*\n(.*?)```", text, re.S)
+        return m.group(1) if m else text
+
+    @staticmethod
+    def _count_bound_lines(judge_output):
+        """Raw counting of verdict lines: returns (upper_bound_lines, total_verdict_lines). No semantic parsing."""
+        verdicts = [ln for ln in (judge_output or "").splitlines() if "(exact)" in ln or "(upper-bound)" in ln]
+        ub = sum(1 for ln in verdicts if "(upper-bound)" in ln)
+        return ub, len(verdicts)
