+    def _score_candidate(self, path, oracle_dir, adv_files, n_tests=200):
+        """Returns (failures, elapsed): oracle differential failures plus adversarial failures."""
+        start = time.time()
+        _, n_fail = self._run_differential(path, oracle_dir, n_tests=n_tests, max_failures=50)
+        for ap in adv_files:
+            with open(ap) as f:
+                inp = f.read()
+            ok, _ = self._run_on_input_text(path, oracle_dir, inp)
+            if not ok:
+                n_fail += 1
+        return n_fail, time.time() - start
