+    def _run_on_input_text(self, solution_path, oracle_dir, inp, timeout=5):
+        """
+        Run one candidate on one input text through the oracle (judge.py if present, else ref.py + compare).
+        Returns (ok, detail_text). Raw text only.
+        """
+        if os.path.exists(os.path.join(oracle_dir, "judge.py")):
+            try:
+                proc = subprocess.run(["python3", os.path.join(oracle_dir, "judge.py"), solution_path],
+                                      input=inp, capture_output=True, text=True, timeout=timeout * 3, cwd=oracle_dir)
+            except subprocess.TimeoutExpired:
+                return False, "JUDGE TIMEOUT"
+            verdict = (proc.stdout or "").strip().splitlines()
+            ok = bool(verdict) and verdict[0].startswith("PASS")
+            return ok, f"--- judge output ---\n{self._clip(proc.stdout)}\n--- stderr ---\n{self._clip(proc.stderr)}"
+        mode, method = self._detect_mode(solution_path)
+        try:
+            ref = subprocess.run(["python3", os.path.join(oracle_dir, "ref.py")], input=inp,
+                                 capture_output=True, text=True, timeout=20, cwd=oracle_dir)
+        except subprocess.TimeoutExpired:
+            return True, "(reference timed out; skipped)"
+        if ref.returncode != 0:
+            return True, "(reference crashed; skipped)"
+        res = self._run_candidate(solution_path, mode, method, inp, timeout=timeout, tag="adv")
+        actual = "" if res["timed_out"] else res["stdout"]
+        if res["timed_out"] or res["returncode"] != 0:
+            ok = False
+        elif mode == "class":
+            ok = self._outputs_match(actual, ref.stdout)
+        else:
