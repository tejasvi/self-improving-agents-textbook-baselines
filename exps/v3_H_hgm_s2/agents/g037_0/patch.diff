+    @staticmethod
+    def _exact_match(actual, expected, mode="stdin"):
+        """Exact comparison after normalizing line endings and trailing whitespace per line."""
+        def _norm(s):
+            return "\n".join(line.rstrip() for line in (s or "").replace("\r\n", "\n").strip().split("\n"))
+        if _norm(actual) == _norm(expected):
+            return True
+        if mode == "class":
+            try:
+                return ast.literal_eval(actual.strip()) == ast.literal_eval(expected.strip())
+            except Exception:
+                return False
+        return False
+
+    _MULTI_KEYWORDS = (
+        "any of them", "multiple solutions", "any valid", "if there are multiple",
+        "multiple answers", "any one of", "print any", "output any", "any such",
+    )
+
+    def _is_multi_answer(self):
+        """
+        Cheap check: does the statement allow several valid outputs? Keyword match first;
+        if no keyword matches but the statement mentions multiple/any/valid, ask the model for a YES/NO.
+        The result is cached on the instance.
+        """
+        if getattr(self, "_multi_cache", None) is not None:
+            return self._multi_cache
+        text = (self.problem_statement or "").lower()
+        text = re.sub(r"\s+", " ", text)
+        if any(k in text for k in self._MULTI_KEYWORDS):
+            self._multi_cache = True
+            return True
+        result = False
+        if re.search(r"\b(multiple|any|valid|several)\b", text):
+            prompt = (
+                "Does the following competitive programming problem allow MULTIPLE different correct outputs for "
+                "some input (so that any valid answer is accepted)? Answer with exactly one word: YES or NO.\n\n"
+                f"<problem_statement>\n{self.problem_statement}\n</problem_statement>"
+            )
+            try:
+                ans = simple_chat(prompt, model=self.code_model, max_tokens=8, logging=safe_log) or ""
+                result = ans.strip().upper().startswith("YES")
+            except Exception as e:
+                safe_log(f"[multi] simple_chat fallback failed: {e}")
+                result = False
+        self._multi_cache = result
+        return result
+
+    def _has_sample_hack(self, diff):
+        """
+        Reviewer call: True when the diff contains constants or branches keyed to sample features
+        without a semantic justification (sample-overfitting). Returns False on empty diff or failure.
+        """
+        if not diff or not diff.strip():
+            return False
+        prompt = (
