+    def _infer_canonical_rule(self, task, solution_path, samples, max_rounds=2):
+        """
+        For multi-answer problems: the outputs are valid but differ from the samples. Ask the agent to infer a
+        uniform construction rule reproducing ALL sample outputs exactly, then re-validate. At most max_rounds
+        agent rounds. Returns True when the samples match exactly afterwards.
+        """
+        for round_idx in range(max_rounds):
