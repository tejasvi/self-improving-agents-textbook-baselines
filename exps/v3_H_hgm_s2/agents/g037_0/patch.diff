+            if self.exact_all_passed:
+                return True
+            current_diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+            before = self._file_hash(solution_path)
+            msg = f"""{task}
+
+Your outputs are valid but differ from the sample outputs. The grader likely compares against the reference solution's exact output.
+Sample report (token-level and exact status per sample):
+
+{self._clip(report, 4000)}
+
+Current diff:
+{current_diff if current_diff.strip() else '(empty)'}
+
+Instructions:
+- List 3-6 principled, uniform construction rules that could have produced ALL sample outputs. Study degenerate samples (such as N=1 or
+  empty/minimal cases) and the structure of non-trivial samples: which bit/index/order each output value corresponds to.
+- Write each candidate as a function in a /tmp script with the editor tool (`create`), run each on ALL samples with bash, and keep the
+  SIMPLEST rule that reproduces every sample exactly (byte-for-byte after trimming trailing whitespace).
+- Implement that rule in {solution_path} with no sample-specific constants or conditionals. It must hold for every valid input.
+- Re-run the checker (checker.py in the oracle directory, if present) on random small inputs to confirm the output is still valid.
+- Do not use bash heredocs; use the editor tool. Do not reply with text only; finish only after the fix is on disk and verified.
+"""
+            chat_with_agent(msg, model=self.code_model, msg_history=[], logging=safe_log)
+            if self._file_hash(solution_path) == before:
+                safe_log(f"[canonical round {round_idx}] no-op round (file unchanged).")
+        report, _ = self._run_samples(solution_path, samples)
+        if self.exact_all_passed:
+            return True
+        # Reviewer guard: one re-prompt to replace sample-overfitting hacks with a uniform rule.
