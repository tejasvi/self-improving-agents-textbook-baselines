@@ -0,0 +1,187 @@
+import importlib.util
+import json
+import subprocess
+import sys
+import os
+import time
+from typing import Any, List
+
+def tool_info() -> dict:
+    """Return tool metadata for the stress_test tool.
+
+    The tool runs a random input generator script repeatedly, feeds the generated
+    input to a candidate solution and a brute‑force reference implementation, and
+    reports mismatches or a success message.
+    """
+    return {
+        "name": "stress_test",
+        "description": (
+            "Run a stress test by generating random inputs and comparing the "
+            "candidate solution with a brute‑force reference. The generator is "
+            "executed with a different seed each iteration. For tasks using a "
+            "Solution class, the generator should emit a JSON list that will be "
+            "passed as arguments to the method. For stdin‑style solutions, the "
+            "generator output is fed to the program via standard input."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the candidate solution file (Python script)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the brute‑force reference solution file (Python script)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to the random input generator script (Python)."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to invoke on the Solution class (default: 'solve')."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (default: 500)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per‑case timeout in seconds (default: 60)."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _load_module(path: str) -> Any:
+    """Dynamically load a Python module from a file path."""
+    spec = importlib.util.spec_from_file_location("mod", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {path}")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["mod"] = mod
+    spec.loader.exec_module(mod)  # type: ignore
+    return mod
+
+
+def _call_solution(module: Any, method_name: str, args: List[Any]) -> str:
+    """Call the appropriate entry point of a solution module.
+
+    If the module defines a ``Solution`` class, instantiate it and call the
+    specified method with ``*args``. Otherwise, raise an error – stdin style is
+    handled elsewhere via subprocess.
+    """
+    if hasattr(module, "Solution"):
+        cls = getattr(module, "Solution")
+        instance = cls()
+        func = getattr(instance, method_name)
+        result = func(*args)
+        return str(result)
+    else:
+        raise RuntimeError("Module does not expose a Solution class; use stdin mode.")
+
+
+def tool_function(
+    solution_path: str,
+    brute_path: str,
+    generator_path: str,
+    method_name: str = "solve",
+    num_tests: int = 500,
+    timeout: int = 60,
+) -> str:
+    """Execute a stress test.
+
+    Returns a raw string containing either ``ALL PASSED (N cases)`` or a report
+    of the first failing case including the generated input, expected output,
+    actual output and per‑case timing.
+    """
+    # Load modules once
+    solution_mod = _load_module(solution_path)
+    brute_mod = _load_module(brute_path)
+
+    for i in range(num_tests):
+        seed = i
+        # Run generator script with seed argument
+        try:
+            gen_proc = subprocess.run(
+                ["python3", generator_path, str(seed)],
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                check=False,
+            )
+        except Exception as e:
+            return f"Generator error on seed {seed}: {e}"
+        if gen_proc.returncode != 0:
+            return (
+                f"Generator failed on seed {seed} with exit code {gen_proc.returncode}\n"
+                f"stderr: {gen_proc.stderr}\n"
+                f"stdout: {gen_proc.stdout}"
+            )
+        generated = gen_proc.stdout.rstrip("\n")
+        start = time.time()
+        # Try JSON args first
+        try:
+            args = json.loads(generated)
+            if not isinstance(args, list):
+                raise ValueError
+            sol_out = _call_solution(solution_mod, method_name, args)
+            brute_out = _call_solution(brute_mod, method_name, args)
+        except Exception:
+            # Fallback: treat generated as raw stdin input
+            try:
+                sol_proc = subprocess.run(
+                    ["python3", solution_path],
+                    input=generated,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                sol_out = sol_proc.stdout.rstrip("\n")
+            except Exception as e:
+                return f"Solution runtime error on seed {seed}: {e}"
+            try:
+                brute_proc = subprocess.run(
+                    ["python3", brute_path],
+                    input=generated,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                brute_out = brute_proc.stdout.rstrip("\n")
+            except Exception as e:
+                return f"Brute runtime error on seed {seed}: {e}"
+        elapsed = time.time() - start
+        if sol_out != brute_out:
+            return (
+                f"FAILURE on seed {seed}\n"
+                f"Generated input: {generated}\n"
+                f"Expected (brute): {brute_out}\n"
+                f"Actual (solution): {sol_out}\n"
+                f"Time: {elapsed:.3f}s"
+            )
+    return f"ALL PASSED ({num_tests} cases)"
+
+if __name__ == "__main__":
+    import argparse
+    parser = argparse.ArgumentParser()
+    parser.add_argument("solution_path")
+    parser.add_argument("brute_path")
+    parser.add_argument("generator_path")
+    parser.add_argument("--method_name", default="solve")
+    parser.add_argument("--num_tests", type=int, default=10)
+    parser.add_argument("--timeout", type=int, default=5)
+    args = parser.parse_args()
+    print(
+        tool_function(
+            args.solution_path,
+            args.brute_path,
+            args.generator_path,
+            method_name=args.method_name,
+            num_tests=args.num_tests,
+            timeout=args.timeout,
+        )
+    )
