@@ -0,0 +1,129 @@
+import subprocess
+import os
+import time
+import json
+from typing import List, Dict, Any
+
+def tool_info():
+    """Return the tool information with JSON schema for the run_solution_tests tool."""
+    return {
+        "name": "run_solution_tests",
+        "description": "Run a solution script against a list of test cases and return a plain-text report.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution Python file to be executed."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of test cases. Each case is an object with an 'input' string and an optional 'expected' string.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The stdin that will be fed to the solution."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Optional expected stdout for the case (exact match)."
+                            }
+                        },
+                        "required": ["input"],
+                        "additionalProperties": False
+                    }
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum number of seconds allowed for each test case execution.",
+                    "default": 5
+                }
+            },
+            "required": ["solution_path", "cases"],
+            "additionalProperties": False
+        }
+    }
+
+def _run_case(solution_path: str, case_input: str, timeout: float) -> Dict[str, Any]:
+    """Execute the solution with given stdin and timeout, returning result details."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=case_input.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            cwd=os.path.dirname(solution_path),
+        )
+        elapsed = time.time() - start
+        return {
+            "status": "OK",
+            "stdout": proc.stdout.decode(errors="ignore"),
+            "stderr": proc.stderr.decode(errors="ignore"),
+            "elapsed": elapsed,
+            "returncode": proc.returncode,
+        }
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start
+        return {
+            "status": "TIMEOUT",
+            "stdout": "",
+            "stderr": "",
+            "elapsed": elapsed,
+            "returncode": None,
+        }
+    except Exception as e:
+        elapsed = time.time() - start
+        return {
+            "status": "ERROR",
+            "error": str(e),
+            "stdout": "",
+            "stderr": "",
+            "elapsed": elapsed,
+            "returncode": None,
+        }
+
+def tool_function(solution_path: str, cases: List[Dict[str, str]], timeout_sec: float = 5) -> str:
+    """Run the solution against each case and produce a plain-text report.
+
+    The report contains for each case:
+    - Case index
+    - Status (PASS, FAIL, TIMEOUT, ERROR)
+    - Elapsed time
+    - Actual output (trimmed)
+    - Expected output (if provided)
+    - Stderr tail (last 200 characters)
+    """
+    reports = []
+    for idx, case in enumerate(cases, start=1):
+        case_input = case.get("input", "")
+        expected = case.get("expected")
+        result = _run_case(solution_path, case_input, timeout_sec)
+        status = result["status"]
+        if status == "OK":
+            actual = result["stdout"].strip()
+            if expected is not None:
+                if actual == expected.strip():
+                    status = "PASS"
+                else:
+                    status = "FAIL"
+            else:
+                status = "PASS"
+        report_lines = [
+            f"Case {idx}: {status}",
+            f"  Elapsed: {result['elapsed']:.3f}s",
+        ]
+        if "error" in result:
+            report_lines.append(f"  Error: {result['error']}")
+        if expected is not None:
+            report_lines.append(f"  Expected: {expected.strip()}")
+        if status not in ("TIMEOUT", "ERROR"):
+            report_lines.append(f"  Actual: {result['stdout'].strip()}")
+        stderr_tail = result['stderr'][-200:]
+        if stderr_tail:
+            report_lines.append(f"  Stderr tail: {stderr_tail}")
+        reports.append("\n".join(report_lines))
+    return "\n\n".join(reports)
