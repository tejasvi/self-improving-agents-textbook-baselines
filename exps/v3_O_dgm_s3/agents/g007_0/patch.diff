index 0000000..91b62d9
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,120 @@
+import subprocess
+import os
+import time
+import random
+from typing import List, Dict, Any
+
+def tool_info():
+    """Return the tool information with JSON schema for the stress_test tool."""
+    return {
+        "name": "stress_test",
+        "description": "Run a solution against randomly generated inputs and compare with a brute-force reference (and optional checker).",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution Python file to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the brute‑force reference implementation."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to a script that generates a single test case on stdout given a seed argument."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "(Optional) Path to a checker script that validates two outputs when multiple correct answers exist."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random test iterations to perform.",
+                    "default": 100
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Base random seed for reproducibility.",
+                    "default": 0
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Maximum seconds allowed for each execution.",
+                    "default": 5
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"],
+            "additionalProperties": False
+        }
+    }
+
+def _run(script_path: str, input_data: str, timeout: float) -> Dict[str, Any]:
+    """Run a python script with given stdin and timeout, return stdout, stderr, elapsed, and status."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", script_path],
+            input=input_data.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            cwd=os.path.dirname(script_path),
+        )
+        elapsed = time.time() - start
+        return {
+            "stdout": proc.stdout.decode(errors="ignore"),
+            "stderr": proc.stderr.decode(errors="ignore"),
+            "elapsed": elapsed,
+            "status": "OK",
+            "returncode": proc.returncode,
+        }
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start
+        return {"stdout": "", "stderr": "", "elapsed": elapsed, "status": "TIMEOUT", "returncode": None}
+    except Exception as e:
+        elapsed = time.time() - start
+        return {"stdout": "", "stderr": str(e), "elapsed": elapsed, "status": "ERROR", "returncode": None}
+
+def _run_checker(checker_path: str, input_data: str, out1: str, out2: str, timeout: float) -> bool:
+    """Run a checker script that returns exit code 0 for equal (or acceptable) outputs.
+    The checker receives three arguments on stdin: the original input, then output1, then output2, each separated by a line containing only '---'."""
+    checker_input = f"{input_data}\n---\n{out1}\n---\n{out2}\n"
+    result = _run(checker_path, checker_input, timeout)
+    return result.get("status") == "OK" and result.get("returncode") == 0
+
+def tool_function(solution_path: str, brute_path: str, generator_path: str, checker_path: str = None, iterations: int = 100, seed: int = 0, timeout_sec: float = 5) -> str:
+    """Run stress test comparing solution with brute-force implementation.
+    Returns a plain‑text report. If a mismatch is found, the first failing case is reported.
+    """
+    random.seed(seed)
+    for i in range(1, iterations + 1):
+        # Generate a seed for this iteration
+        iteration_seed = random.randint(0, 2**31 - 1)
+        # Run generator
+        gen_res = _run(generator_path, str(iteration_seed), timeout_sec)
+        if gen_res["status"] != "OK":
+            return f"Generator failed on iteration {i} (seed {iteration_seed}): {gen_res.get('status')} {gen_res.get('stderr')}"
+        case_input = gen_res["stdout"]
+        # Run both implementations
+        sol_res = _run(solution_path, case_input, timeout_sec)
+        brute_res = _run(brute_path, case_input, timeout_sec)
+        if sol_res["status"] != "OK" or brute_res["status"] != "OK":
+            return f"Execution error on iteration {i} (seed {iteration_seed}). Solution status: {sol_res['status']}, Brute status: {brute_res['status']}"
+        # Compare outputs
+        if checker_path:
+            ok = _run_checker(checker_path, case_input, sol_res["stdout"], brute_res["stdout"], timeout_sec)
+        else:
+            ok = sol_res["stdout"].strip() == brute_res["stdout"].strip()
+        if not ok:
+            report = [
+                f"Mismatch found on iteration {i} (seed {iteration_seed}):",
+                "--- Input ---",
+                case_input,
+                "--- Solution Output ---",
+                sol_res["stdout"].strip(),
+                "--- Brute‑Force Output ---",
+                brute_res["stdout"].strip(),
+            ]
+            return "\n".join(report)
+    return f"All {iterations} iterations passed without mismatches."
