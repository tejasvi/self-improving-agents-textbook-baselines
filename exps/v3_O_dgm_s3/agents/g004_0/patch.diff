@@ -0,0 +1,126 @@
+import subprocess
+import time
+import json
+import os
+from pathlib import Path
+
+def tool_info():
+    """Return metadata for the run_tests tool.
+
+    The tool executes a solution script against multiple test cases, optionally using a checker script.
+    """
+    return {
+        "name": "run_tests",
+        "description": (
+            "Run a solution program against a list of test cases (or a checker script) with a per-case timeout. "
+            "Each case provides an input string and an expected output string. If a checker_path is given, "
+            "the checker script is invoked to validate the solution output instead of a direct string compare."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file to execute (e.g., /repo/sol.py)."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of test case objects.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "The stdin to feed to the solution."},
+                            "expected_output": {"type": "string", "description": "The expected stdout from the solution."}
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a checker script that validates the solution output. "
+                                   "The script should exit with code 0 for success and non-zero for failure, optionally printing a message."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Maximum seconds allowed for each test case (default 20).",
+                    "default": 20
+                }
+            },
+            "required": ["solution_path", "cases"]
+        }
+    }
+
+def _run_single_case(solution_path: str, case_input: str, timeout: float):
+    """Run the solution with given stdin and timeout, returning (stdout, elapsed)."""
+    start = time.time()
+    try:
+        cmd = ["timeout", str(int(timeout)), "python3", solution_path]
+        completed = subprocess.run(
+            cmd,
+            input=case_input,
+            text=True,
+            capture_output=True,
+            cwd=os.path.dirname(solution_path),
+            timeout=timeout + 5,
+        )
+    except subprocess.TimeoutExpired:
+        return "<timeout>", time.time() - start
+    except Exception as e:
+        return f"<error: {e}>", time.time() - start
+    elapsed = time.time() - start
+    output = completed.stdout.strip()
+    return output, elapsed
+
+def _run_checker(checker_path: str, solution_output: str, expected_output: str):
+    """Execute a checker script.
+
+    The checker receives the solution output and the expected output as command-line arguments.
+    It should exit with status 0 for a passing case.
+    """
+    try:
+        cmd = ["python3", checker_path, solution_output, expected_output]
+        result = subprocess.run(
+            cmd,
+            text=True,
+            capture_output=True,
+            timeout=10,
+        )
+        return result.returncode == 0, result.stdout.strip() or result.stderr.strip()
+    except Exception as e:
+        return False, f"Checker error: {e}"
+
+def tool_function(solution_path: str, cases, checker_path: str = None, timeout: float = 20):
+    """Execute the solution against each test case.
+
+    Returns a JSON-encoded string containing an array of results.
+    Each result includes the input, expected output, actual output, pass flag, and elapsed time.
+    """
+    solution_path = os.path.abspath(solution_path)
+    results = []
+    for case in cases:
+        case_input = case.get("input", "")
+        expected = case.get("expected_output", "")
+        actual, elapsed = _run_single_case(solution_path, case_input, timeout)
+        if checker_path:
+            passed, checker_msg = _run_checker(os.path.abspath(checker_path), actual, expected)
+        else:
+            passed = (actual == expected)
+            checker_msg = "" if passed else f"Expected: {expected}" if actual != "<timeout>" and not actual.startswith("<error") else ""
+        results.append({
+            "input": case_input,
+            "expected_output": expected,
+            "actual_output": actual,
+            "passed": passed,
+            "checker_message": checker_msg,
+            "elapsed_seconds": round(elapsed, 4)
+        })
+    return json.dumps({"results": results}, indent=2)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: python run_tests.py <solution_path>")
+        sys.exit(1)
+    sol = sys.argv[1]
+    example_cases = [{"input": "1 2 3", "expected_output": "6"}]
+    print(tool_function(sol, example_cases))
