--- /dev/null
+++ b/utils/check_runner.py
@@ -0,0 +1,148 @@
+import json
+import os
+import subprocess
+import sys
+import time
+import importlib.util
+from typing import Any
+
+def load_module(module_path: str, name: str):
+    spec = importlib.util.spec_from_file_location(name, module_path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+def run_solution(solution_path: str, input_data: Any) -> str:
+    """Run the solution code.
+    Supports two entry points:
+      - a function `solve()` that reads JSON from stdin and prints result
+      - a class `Solution` with a method `solve` that takes the input arguments.
+    Returns the captured stdout as a string.
+    """
+    # Prepare a temporary script to invoke solution safely
+    script = f"""
+import sys, json, io, importlib.util, os
+spec = importlib.util.spec_from_file_location('solution', r'{solution_path}')
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+
+input_data = json.loads('{json.dumps(input_data)}')
+
+if hasattr(mod, 'solve'):
+    # Redirect stdout to capture prints
+    buf = io.StringIO()
+    sys.stdout = buf
+    # Provide stdin if solve reads it
+    sys.stdin = io.StringIO(json.dumps(input_data))
+    mod.solve()
+    output = buf.getvalue()
+else:
+    # Assume class Solution
+    cls = getattr(mod, 'Solution', None)
+    if cls is None:
+        raise RuntimeError('No entry point found')
+    instance = cls()
+    if isinstance(input_data, (list, tuple)):
+        output = instance.solve(*input_data)
+    else:
+        output = instance.solve(input_data)
+    output = str(output)
+print(output)
+"""
+    proc = subprocess.run([sys.executable, '-c', script], capture_output=True, text=True, timeout=10)
+    if proc.returncode != 0:
+        raise RuntimeError(f'Solution error: {proc.stderr.strip()}')
+    return proc.stdout.strip()
+
+def run_brute(brute_path: str, input_data: Any) -> Any:
+    brute_mod = load_module(brute_path, 'brute')
+    if not hasattr(brute_mod, 'brute'):
+        raise RuntimeError('brute function not found')
+    func = brute_mod.brute
+    if isinstance(input_data, (list, tuple)):
+        return func(*input_data)
+    else:
+        return func(input_data)
+
+def main():
+    base = '/tmp/agent_tests'
+    samples_path = os.path.join(base, 'samples.json')
+    brute_path = os.path.join(base, 'brute.py')
+    gen_path = os.path.join(base, 'gen.py')
+    solution_path = os.path.abspath('solution.py')
+
+    with open(samples_path) as f:
+        samples = json.load(f)
+
+    # Sample verification
