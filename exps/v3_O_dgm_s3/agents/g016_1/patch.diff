+# Helper functions for detecting source edits
+
+def _changed_files(diff_text):
+    """Parse a git diff string and return a list of changed file paths.
+    Looks for lines starting with 'diff --git a/... b/...'.
+    Returns the list of destination paths (the 'b/' side).
+    """
+    changed = []
+    for line in diff_text.splitlines():
+        if line.startswith('diff --git'):
+            # Example: diff --git a/path/file.py b/path/file.py
+            parts = line.split(' ')
+            # Find the part that starts with 'b/'
+            b_parts = [p for p in parts if p.startswith('b/')]
+            if b_parts:
+                path = b_parts[0][2:]  # strip leading 'b/'
+                changed.append(path)
+    return changed
+
+def _is_test_file(path):
+    """Return True if the given file path appears to be a test file.
+    Checks common naming conventions and directory names.
+    """
+    basename = os.path.basename(path)
+    # Name patterns
+    if basename.startswith('test_'):
+        return True
+    if basename.endswith('_test.py') or basename.endswith('.spec.js') or basename.endswith('_test.go') or basename.endswith('Test.java'):
+        return True
+    # Directory components
+    test_dirs = {'test', 'tests', 'spec', '__tests__'}
+    components = set(path.split(os.sep))
+    if test_dirs.intersection(components):
+        return True
+    return False
+
+def has_source_edit(diff_text):
+    """Return True if the diff contains at least one non-test file change."""
+    for f in _changed_files(diff_text):
+        if not _is_test_file(f):
+            return True
+    return False
