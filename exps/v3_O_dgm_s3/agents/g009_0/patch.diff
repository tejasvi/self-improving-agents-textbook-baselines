+    # Utility helpers for forced edit flow
+    def _last_assistant_text(self, msg_history):
+        for entry in reversed(msg_history):
+            if entry.get('role') == 'assistant':
+                # content may be list of dicts
+                content = entry.get('content')
+                if isinstance(content, list):
+                    texts = []
+                    for part in content:
+                        if part.get('type') == 'text':
+                            texts.append(part.get('text', ''))
+                    return '\n'.join(texts)
+                elif isinstance(content, str):
+                    return content
+        return ''
+
+    def _extract_code_block(self, text):
+        # Find all ```python ... ``` blocks
+        blocks = re.findall(r'```python\s+(.*?)\s+```', text, re.DOTALL|re.IGNORECASE)
+        if not blocks:
+            return ''
+        # Return the largest block by length
+        return max(blocks, key=len)
+
+    def _find_target_file(self):
+        # Prefer solution.py if present
+        candidate = Path(self.git_tempdir) / 'solution.py'
+        if candidate.is_file():
+            return str(candidate)
+        # Otherwise first non-test .py file
+        for p in Path(self.git_tempdir).rglob('*.py'):
+            if 'test' not in str(p).lower():
+                return str(p)
+        # Fallback: any .py file listed in git (including untracked)
+        for p in Path(self.git_tempdir).rglob('*.py'):
+            return str(p)
