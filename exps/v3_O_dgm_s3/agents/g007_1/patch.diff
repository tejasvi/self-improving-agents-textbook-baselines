+# Solution implementation
+
+def solve(x) -> int:
+    """Return double the input integer. Accepts int or string representation."""
+    if isinstance(x, str):
+        x = int(x)
+    return x * 2
+
+if __name__ == "__main__":
+    import sys
+    data = sys.stdin.read().strip()
+    if data:
+        try:
+            n = int(data)
+            print(solve(n))
+        except ValueError:
+            print(data)
diff --git a/tools/run_examples.py b/tools/run_examples.py
new file mode 100644
index 0000000..ef5a659
--- /dev/null
+++ b/tools/run_examples.py
@@ -0,0 +1,110 @@
+# Tool to run examples against a solution
+
+import json
+import subprocess
+import importlib.util
+import os
+import traceback
+from typing import Any, List, Dict
+
+
+def tool_info():
+    return {
+        "name": "run_examples",
+        "description": "Run the provided examples (input/expected) against a solution file (Python script or class method) and report any failures.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (e.g., /repo/solution.py)."
+                },
+                "examples_path": {
+                    "type": "string",
+                    "description": "Absolute path to a JSON file containing a list of examples. Each example should have an \"input\" (string) and an \"expected\" field."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Optional name of a function/method in the solution file to call instead of running as a script."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Maximum seconds to allow each example execution."
+                }
+            },
+            "required": ["solution_path", "examples_path"]
+        }
+    }
+
+
+def _run_script(solution_path: str, inp: str, timeout: int) -> str:
+    result = subprocess.run(
+        ["python", solution_path],
+        input=inp,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=timeout,
+        text=True,
+        cwd=os.path.dirname(solution_path),
+    )
+    if result.returncode != 0:
+        raise RuntimeError(f"Non‑zero exit code {result.returncode}: {result.stderr.strip()}")
+    return result.stdout.strip()
+
+
+def _run_method(solution_path: str, method_name: str, inp: Any, timeout: int) -> str:
+    spec = importlib.util.spec_from_file_location("solution_mod", solution_path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    func = getattr(mod, method_name)
+    # If the input is a JSON‑encoded list, decode it; otherwise treat as a single argument
+    if isinstance(inp, list):
+        result = func(*inp)
+    else:
+        result = func(inp)
+    return str(result)
+
+
+def tool_function(solution_path: str, examples_path: str, method_name: str = None, timeout: int = 5) -> str:
+    """Execute each example and return a report.
+
+    The function returns a string containing either "ALL EXAMPLES PASSED" or a list of failures.
+    """
+    try:
+        with open(examples_path, "r", encoding="utf-8") as f:
+            examples: List[Dict[str, Any]] = json.load(f)
+    except Exception as e:
+        return f"Error loading examples file: {e}"
+
+    failures = []
+    for idx, ex in enumerate(examples):
+        inp = ex.get("input") or ex.get("args")
+        expected = ex.get("expected")
+        try:
+            if method_name:
+                actual = _run_method(solution_path, method_name, inp, timeout)
+            else:
+                # Ensure input is a string for stdin
+                actual = _run_script(solution_path, str(inp) if inp is not None else "", timeout)
+            if str(actual).strip() != str(expected).strip():
+                failures.append({
+                    "index": idx,
+                    "input": inp,
+                    "expected": expected,
+                    "actual": actual,
+                })
+        except Exception as e:
+            failures.append({
+                "index": idx,
+                "input": inp,
+                "expected": expected,
+                "actual": f"Error: {e}\n{traceback.format_exc()}",
+            })
+    if failures:
+        lines = ["EXAMPLE FAILURES:"]
+        for f in failures:
+            lines.append(
+                f"Example {f['index']}:\n  Input   : {f['input']}\n  Expected: {f['expected']}\n  Actual  : {f['actual']}"
+            )
+        return "\n".join(lines)
+    return "ALL EXAMPLES PASSED"
diff --git a/tools/stress_compare.py b/tools/stress_compare.py
new file mode 100644
index 0000000..07bda4e
--- /dev/null
+++ b/tools/stress_compare.py
@@ -0,0 +1,114 @@
+# Tool to compare solution against brute-force on random generated cases
+
+import importlib.util
+import json
+import os
+import traceback
+from typing import Any, List, Dict
+
+
+def tool_info():
+    return {
+        "name": "stress_compare",
+        "description": "Run N random tests generated by a generator module and compare solution output with a brute-force reference.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (Python script or class method)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the brute-force reference implementation (Python script)."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Absolute path to a generator module that provides a function `generate()` returning input for the problem."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Optional name of the function/method in the solution to call."
+                },
+                "brute_method": {
+                    "type": "string",
+                    "description": "Optional name of function/method in the brute module (default: 'solve')."
+                },
+                "num_trials": {
+                    "type": "integer",
+                    "description": "Number of random trials to run."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Seconds allowed per execution."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path"]
+        }
+    }
+
+
+def _load_module(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _run_solution(solution_path: str, method_name: str, inp: Any):
+    mod = _load_module(solution_path, "solution_mod")
+    if method_name:
+        func = getattr(mod, method_name)
+    else:
+        func = getattr(mod, "solve", None) or getattr(mod, "main", None)
+    if not func:
+        raise AttributeError("Solution function not found")
+    if isinstance(inp, list):
+        return func(*inp)
+    return func(inp)
+
+
+def _run_brute(brute_path: str, brute_method: str, inp: Any):
+    mod = _load_module(brute_path, "brute_mod")
+    if brute_method:
+        func = getattr(mod, brute_method)
+    else:
+        func = getattr(mod, "solve", None) or getattr(mod, "main", None)
+    if not func:
+        raise AttributeError("Brute function not found")
+    if isinstance(inp, list):
+        return func(*inp)
+    return func(inp)
+
+
+def tool_function(
+    solution_path: str,
+    brute_path: str,
+    gen_path: str,
+    method_name: str = None,
+    brute_method: str = None,
+    num_trials: int = 100,
+    timeout: int = 5,
+) -> str:
+    """Run random trials and report first counterexample.
+
+    Returns either "ALL TRIALS PASSED" or a description of the smallest failing input.
+    """
+    try:
+        gen_mod = _load_module(gen_path, "gen_mod")
+        generate = getattr(gen_mod, "generate")
+    except Exception as e:
+        return f"Error loading generator: {e}"
+
+    for i in range(num_trials):
+        try:
+            inp = generate()
+            sol_out = _run_solution(solution_path, method_name, inp)
+            brute_out = _run_brute(brute_path, brute_method, inp)
+            if str(sol_out).strip() != str(brute_out).strip():
+                return (
+                    f"Counterexample found on trial {i}:\nInput: {inp}\nSolution output: {sol_out}\nBrute output: {brute_out}"
+                )
+        except Exception as e:
+            return f"Error during trial {i}: {e}\n{traceback.format_exc()}"
+    return "ALL TRIALS PASSED"
