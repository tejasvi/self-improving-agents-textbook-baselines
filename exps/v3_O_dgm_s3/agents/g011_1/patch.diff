+    def _run_verification(self):
+        """Run the verification script located at /tmp/verify_solution.py if it exists.
+        Returns a tuple (exists, success, output)."""
+        verify_path = '/tmp/verify_solution.py'
+        if not os.path.isfile(verify_path):
+            return (False, False, f"Verification script not found at {verify_path}.")
+        try:
+            # Use subprocess directly; bash tool can be used by the agent, but here we execute.
+            result = subprocess.run(
+                ["python3", verify_path],
+                capture_output=True,
+                text=True,
+                timeout=30,
+            )
+            success = (result.returncode == 0)
+            output = result.stdout + result.stderr
+            return (True, success, output)
+        except subprocess.TimeoutExpired as e:
+            return (True, False, f"Verification timed out: {e}")
+        except Exception as e:
+            return (True, False, f"Error running verification: {e}")
+
