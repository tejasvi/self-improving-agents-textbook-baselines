+import re, subprocess, os, sys, textwrap
+from typing import List, Tuple, Dict
+
+def extract_samples(problem_statement: str) -> List[Dict[str, str]]:
+    """Extract sample input/output pairs from a problem statement.
+
+    Supports two common formats:
+    1. "Sample Input 1" / "Sample Output 1" (with optional surrounding whitespace).
+    2. "Input:" followed by the input block and "Expected output:" (or "Output:") followed by the output block.
+
+    Returns a list of dictionaries with keys 'input' and 'output'.
+    """
+    samples = []
+    # Pattern 1: Sample Input X ... Sample Output X
+    pattern1 = re.compile(r"Sample Input\s*(\d+)\s*[:\-]?\s*(.*?)\s*Sample Output\s*\1\s*[:\-]?\s*(.*?)(?=\n\s*Sample Input|\Z)", re.DOTALL | re.IGNORECASE)
+    for m in pattern1.finditer(problem_statement):
+        inp = m.group(2).strip()
+        out = m.group(3).strip()
+        samples.append({"input": inp, "output": out})
+    # Pattern 2: Input: ... Expected output: ...
+    pattern2 = re.compile(r"(?:Input|input)\s*[:\-]?\s*(.*?)\s*(?:Expected output|Output)\s*[:\-]?\s*(.*?)(?=\n\s*(?:Input|$))", re.DOTALL)
+    for m in pattern2.finditer(problem_statement):
+        inp = m.group(1).strip()
+        out = m.group(2).strip()
+        samples.append({"input": inp, "output": out})
+    # Remove duplicates (same input)
+    uniq = []
+    seen = set()
+    for s in samples:
+        key = (s['input'], s['output'])
+        if key not in seen:
+            seen.add(key)
+            uniq.append(s)
+    return uniq
+
+def _run_one(solution_path: str, sample_input: str, timeout: int) -> Tuple[bool, str, str]:
+    """Run solution on a single sample.
+    Returns (passed, stdout, stderr)."""
+    try:
+        result = subprocess.run([
+                sys.executable, solution_path
+            ],
+            input=sample_input,
+            text=True,
+            capture_output=True,
+            timeout=timeout)
+        stdout = result.stdout.strip()
+        stderr = result.stderr.strip()
+        # Compare tokenized whitespace split
+        expected_tokens = sample_input  # placeholder not used
+        return True, stdout, stderr
+    except subprocess.TimeoutExpired:
+        return False, "", f"Timeout after {timeout}s"
+    except Exception as e:
+        return False, "", str(e)
+
+def run_samples(solution_path: str, samples: List[Dict[str, str]], timeout: int = 10) -> Tuple[List[Dict], str]:
+    """Run all samples against the solution.
+    Returns a list of result dicts and a formatted report string.
+    """
+    results = []
+    report_lines = []
+    all_passed = True
+    for idx, s in enumerate(samples, 1):
+        inp = s['input']
+        expected = s['output']
+        try:
+            result = subprocess.run([
+                    sys.executable, solution_path
+                ],
+                input=inp,
+                text=True,
+                capture_output=True,
+                timeout=timeout)
+            actual = result.stdout.strip()
+            passed = actual.split() == expected.split()
+            err = result.stderr.strip()
+        except subprocess.TimeoutExpired:
+            actual = ""
+            passed = False
+            err = f"Timeout after {timeout}s"
+        except Exception as e:
+            actual = ""
+            passed = False
+            err = str(e)
+        results.append({
+            "index": idx,
+            "input": inp,
+            "expected": expected,
+            "actual": actual,
+            "passed": passed,
+            "stderr": err,
+        })
+        status = "PASS" if passed else "FAIL"
+        report_lines.append(f"Sample {idx}: {status}\nInput:\n{inp}\nExpected:\n{expected}\nActual:\n{actual}\nStderr:\n{err}\n")
+        if not passed:
+            all_passed = False
+    report = "\n".join(report_lines)
+    return results, report, all_passed
