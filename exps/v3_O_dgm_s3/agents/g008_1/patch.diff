+    def _changed_files(self):
+        """Return a set of file paths that have been added/modified relative to base commit."""
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        files = set()
+        for line in diff.splitlines():
+            if line.startswith('diff --git'):
+                parts = line.split(' ')
+                if len(parts) >= 4:
+                    a = parts[2][2:]  # strip a/
+                    b = parts[3][2:]  # strip b/
+                    # Prefer the new path (b)
+                    files.add(b)
+        return files
+
+    def _is_test_or_scratch_path(self, path):
+        """Heuristic to decide if *path* is a test or scratch file.
+        Simple rule: contains 'test' or 'scratch' (case‑insensitive) or lives under a directory named 'tests'."""
+        lowered = path.lower()
+        if 'test' in lowered or 'scratch' in lowered:
+            return True
+        if '/tests/' in f'/{lowered}/':
+            return True
+        return False
+
+    def _has_source_progress(self):
+        """Return True if at least one changed file is NOT a test/scratch file."""
+        for f in self._changed_files():
+            if not self._is_test_or_scratch_path(f):
+                return True
+        return False
+
+    def _find_candidate_files(self):
+        """Return a ranked list of likely target source files.
+        Excludes hidden, test, node_modules, and build directories.
+        Simple ranking: files containing 'class Solution' first, then stubs with pass/TODO/NotImplemented, then keyword match.
+        """
+        # List all tracked files
+        try:
+            result = subprocess.run(['git', '-C', self.git_tempdir, 'ls-files'], capture_output=True, text=True, check=False)
+            all_files = [f for f in result.stdout.splitlines() if f]
+        except Exception:
+            all_files = []
+        candidates = []
+        for f in all_files:
+            if f.startswith('.') or '/.' in f:
+                continue
+            if f.startswith('node_modules') or f.startswith('build') or f.startswith('dist'):
+                continue
+            if self._is_test_or_scratch_path(f):
+                continue
+            candidates.append(f)
+        # Simple ranking based on heuristics
+        ranked = []
+        for f in candidates:
+            try:
+                with open(os.path.join(self.git_tempdir, f), 'r', encoding='utf-8') as fh:
+                    content = fh.read()
+                score = 0
+                if 'class Solution' in content:
+                    score += 100
+                if any(tok in content for tok in ['pass', 'TODO', 'NotImplemented']):
+                    score += 50
+                # keyword match – use problem title words if available
+                if self.problem_statement:
+                    for word in self.problem_statement.split():
+                        if word.lower() in f.lower():
+                            score += 10
+                ranked.append((score, f))
+            except Exception:
+                continue
+        ranked.sort(reverse=True)
+        return [f for _, f in ranked]
+
