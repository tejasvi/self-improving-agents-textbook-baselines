diff --git a/tools/run_program.py b/tools/run_program.py
new file mode 100644
index 0000000..d3fdb5a
--- /dev/null
+++ b/tools/run_program.py
@@ -0,0 +1,104 @@
+"""Tool to run a Python program with given stdin and optional arguments, returning execution details.
+
+The tool follows the required schema: it provides `tool_info()` returning name, description, and input_schema.
+The `tool_function()` executes the program using subprocess.run, applies a timeout, and returns a formatted string.
+"""
+
+import subprocess
+import time
+from typing import List, Optional
+
+def tool_info():
+    """Return the tool information and JSON schema for inputs.
+
+    The schema ensures every property has a type and description, and required fields are at the correct level.
+    """
+    return {
+        "name": "run_program",
+        "description": "Run a Python script with supplied stdin (and optional args) under a timeout, returning exit code, stdout, stderr and elapsed time. Useful for competitive programming where programs read from stdin and write to stdout.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python file to execute (e.g., '/repo/solution.py')."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to provide on the program's standard input."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Maximum number of seconds to allow the program to run before terminating. Default is 10 seconds.",
+                    "default": 10
+                },
+                "args": {
+                    "type": "array",
+                    "description": "Optional list of command-line arguments to pass to the Python script.",
+                    "items": {"type": "string"}
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command that generates large input; if provided, its stdout will be used as stdin_text. This allows the agent to supply a short snippet that creates a big test case."
+                }
+            },
+            "required": ["file_path", "stdin_text"]
+        }
+    }
+
+def _maybe_truncate(content: str, max_length: int = 10000) -> str:
+    if len(content) > max_length:
+        return content[:max_length] + "\n<response clipped>"
+    return content
+
+def tool_function(
+    file_path: str,
+    stdin_text: str,
+    timeout_sec: int = 10,
+    args: Optional[List[str]] = None,
+    gen_cmd: Optional[str] = None,
+) -> str:
+    """Execute the specified Python file.
+
+    If ``gen_cmd`` is supplied, it is executed in a shell and its stdout is used as ``stdin_text``.
+    The function returns a human‑readable summary containing the exit code, truncated stdout, truncated stderr, and elapsed time.
+    In case of a timeout, a clear ``TIMEOUT`` message is returned.
+    """
+    try:
+        # Generate stdin via gen_cmd if provided
+        if gen_cmd:
+            gen_res = subprocess.run(
+                gen_cmd,
+                shell=True,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            if gen_res.returncode != 0:
+                return f"Generator command failed with exit code {gen_res.returncode}: {gen_res.stderr}"
+            stdin_text = gen_res.stdout
+
+        cmd = ["python3", file_path]
+        if args:
+            cmd.extend(args)
+
+        start = time.time()
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text.encode() if isinstance(stdin_text, str) else stdin_text,
+            capture_output=True,
+            timeout=timeout_sec,
+        )
+        elapsed = time.time() - start
+        stdout = _maybe_truncate(proc.stdout.decode(errors='replace'))
+        stderr = _maybe_truncate(proc.stderr.decode(errors='replace'))
+        return (
+            f"Exit code: {proc.returncode}\n"
+            f"Elapsed time: {elapsed:.3f}s\n"
+            f"--- stdout ---\n{stdout}\n"
+            f"--- stderr ---\n{stderr}\n"
+        )
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT: Program exceeded {timeout_sec}s timeout."
+    except Exception as e:
+        return f"Error during execution: {str(e)}"
