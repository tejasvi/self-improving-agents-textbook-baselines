@@ -0,0 +1,194 @@
+from pathlib import Path
+import subprocess
+import time
+import re
+import json
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": "Run a solution against provided sample inputs (or extract them from a problem statement) and optionally perform stress testing against a brute-force solution.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file to execute."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample objects with `input` and `expected` strings.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {"type": "string", "description": "Standard input for the sample."},
+                            "expected": {"type": "string", "description": "Expected stdout for the sample."}
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "statement_text": {
+                    "type": "string",
+                    "description": "Full problem statement text from which sample inputs/outputs will be extracted via regex if `samples` not provided."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Maximum seconds to allow each sample execution. Default 5 seconds.",
+                    "default": 5
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Path to a custom checker script that returns exit code 0 for correct output. Optional."
+                },
+                "stress": {
+                    "type": "boolean",
+                    "description": "If true, perform stress testing mode using brute and generator."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to brute-force solution used in stress mode."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to input generator script used in stress mode."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random tests to generate in stress mode. Default 100.",
+                    "default": 100
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+def _extract_samples_from_text(text: str):
+    # Regex to find Sample Input/Output blocks (tolerant to numbering)
+    pattern = re.compile(r"Sample Input\\s*\\d*\\s*\\n(?P<input>.*?)\\n\\s*Sample Output\\s*\\d*\\s*\\n(?P<output>.*?)(?=\\n\\s*Sample Input|\\Z)", re.DOTALL | re.IGNORECASE)
+    samples = []
+    for m in pattern.finditer(text):
+        inp = m.group('input').strip('\n')
+        out = m.group('output').strip('\n')
+        samples.append({"input": inp, "expected": out})
+    return samples
+
+def _run_one_sample(solution_path: str, sample_input: str, timeout: float):
+    start = time.perf_counter()
+    try:
+        result = subprocess.run(
+            ["python3", solution_path],
+            input=sample_input.encode('utf-8'),
+            capture_output=True,
+            text=True,
+            timeout=timeout
+        )
+    except subprocess.TimeoutExpired as e:
+        return {
+            "status": "TIMEOUT",
+            "actual": "",
+            "stderr": e.stderr or "",
+            "time": time.perf_counter() - start
+        }
+    elapsed = time.perf_counter() - start
+    return {
+        "status": "OK",
+        "actual": result.stdout.rstrip('\n'),
+        "stderr": result.stderr,
+        "time": elapsed,
+        "returncode": result.returncode
+    }
+
+def _run_checker(checker_path: str, input_data: str, actual_output: str, expected_output: str, timeout: float):
+    data = "\n".join([input_data, actual_output, expected_output])
+    try:
+        result = subprocess.run(
+            ["python3", checker_path],
+            input=data.encode('utf-8'),
+            capture_output=True,
+            text=True,
+            timeout=timeout
+        )
+        return result.returncode == 0
+    except Exception:
+        return False
+
+def tool_function(
+    solution_path: str,
+    samples=None,
+    statement_text: str = None,
+    timeout: float = 5,
+    checker_path: str = None,
+    stress: bool = False,
+    brute_path: str = None,
+    generator_path: str = None,
+    iterations: int = 100
+):
+    """Execute the solution against samples or perform stress testing.
+    Returns a JSON-formatted string describing results.
+    """
+    if not Path(solution_path).is_file():
+        return f"Error: solution_path '{solution_path}' does not exist or is not a file."
+
+    if stress:
+        if not (brute_path and generator_path):
+            return "Error: stress mode requires brute_path and generator_path."
+        for i in range(iterations):
+            try:
+                gen_res = subprocess.run(
+                    ["python3", generator_path],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout
+                )
+            except Exception as e:
+                return f"Generator error on iteration {i}: {e}"
+            if gen_res.returncode != 0:
+                return f"Generator exited with code {gen_res.returncode} on iteration {i}: {gen_res.stderr}"
+            inp = gen_res.stdout
+            sol_res = _run_one_sample(solution_path, inp, timeout)
+            brute_res = _run_one_sample(brute_path, inp, timeout)
+            if checker_path:
+                ok = _run_checker(checker_path, inp, sol_res.get('actual',''), brute_res.get('actual',''), timeout)
+            else:
+                ok = sol_res.get('actual','').strip() == brute_res.get('actual','').strip()
+            if not ok:
+                report = {
+                    "iteration": i,
+                    "input": inp,
+                    "solution_output": sol_res.get('actual',''),
+                    "brute_output": brute_res.get('actual',''),
+                    "status": "FAIL"
+                }
+                return json.dumps(report, indent=2)
+        return json.dumps({"status": "ALL_PASS", "iterations": iterations}, indent=2)
+
+    # Sample testing mode
+    if samples is None:
+        if statement_text:
+            samples = _extract_samples_from_text(statement_text)
+        else:
+            return "Error: No samples provided and no statement_text to extract from."
+    if not isinstance(samples, list) or not samples:
+        return "Error: No valid samples extracted or provided."
+
+    results = []
+    for idx, sample in enumerate(samples):
+        inp = sample.get('input', '')
+        expected = sample.get('expected', '')
+        exec_res = _run_one_sample(solution_path, inp, timeout)
+        passed = False
+        if exec_res.get('status') == 'OK' and exec_res.get('returncode') == 0:
+            if checker_path:
+                passed = _run_checker(checker_path, inp, exec_res.get('actual',''), expected, timeout)
+            else:
+                passed = exec_res.get('actual','').strip() == expected.strip()
+        results.append({
+            "sample_index": idx,
+            "passed": passed,
+            "actual": exec_res.get('actual',''),
+            "expected": expected,
+            "stderr": exec_res.get('stderr',''),
+            "time": exec_res.get('time', 0),
+            "status": exec_res.get('status')
+        })
+    return json.dumps({"results": results}, indent=2)
