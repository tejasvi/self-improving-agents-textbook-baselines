+    # ---------- New helper methods ----------
+    def _changed_files(self):
+        """Return a list of file paths that have changed compared to base commit.
+        Uses `git status --porcelain` to detect added, modified, or deleted files.
+        """
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "status", "--porcelain"],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+                check=False,
+            )
+            lines = result.stdout.strip().splitlines()
+            changed = []
+            for line in lines:
+                # The format is "XY path" where XY are status codes
+                if len(line) >= 3:
+                    path = line[3:]
+                    changed.append(path)
+            return changed
+        except Exception as e:
+            safe_log(f"Error obtaining changed files: {e}")
+            return []
+
+    def _has_source_progress(self):
+        """Return True if at least one changed file is NOT a test file.
+        Test files match typical patterns: contain 'test', 'tests', 'spec', 'conftest' or live under a tests directory.
+        """
+        changed = self._changed_files()
+        for f in changed:
+            lower = f.lower()
+            # Exclude files under any tests directory
+            if '/tests/' in lower or lower.startswith('tests/'):
+                continue
+            # Exclude filenames that match common test patterns
+            basename = os.path.basename(lower)
+            if (
+                basename.startswith('test') or
+                basename.startswith('_test') or
+                basename.endswith('_test.py') or
+                basename.endswith('.spec.js') or
+                basename.startswith('spec') or
+                'conftest' in lower
+            ):
+                continue
+            # If we reach here, it's a source file change
+            return True
+        return False
+
+    def _last_assistant_text(self, msg_history):
+        """Extract the final assistant message text from msg_history.
+        Returns the stripped text; if empty (or contains only whitespace) returns ''.
+        """
+        # msg_history is a list of dicts with role/content
+        for entry in reversed(msg_history):
+            if entry.get('role') == 'assistant':
+                # content may be a list of blocks
+                content = entry.get('content')
+                if isinstance(content, list):
+                    # concatenate text fields
+                    parts = []
+                    for block in content:
+                        if block.get('type') == 'text':
+                            parts.append(block.get('text', ''))
+                    combined = ''.join(parts).strip()
+                else:
+                    combined = str(content).strip()
+                return combined
+        return ''
+
