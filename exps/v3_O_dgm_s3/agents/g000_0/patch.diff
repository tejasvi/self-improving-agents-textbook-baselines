+    def _changed_files(self):
+        """Return a list of changed file paths relative to the repo root."""
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "status", "--porcelain"],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            files = []
+            for line in result.stdout.splitlines():
+                # Format: XY path
+                parts = line.strip().split(None, 1)
+                if len(parts) == 2:
+                    files.append(parts[1])
+            return files
+        except Exception as e:
+            safe_log(f"Error getting changed files: {e}")
+            return []
+
+    def _is_test_file(self, path):
+        """Determine if a file path is considered a test file."""
+        import re
+        fname = os.path.basename(path)
+        # Common test filename patterns
+        test_patterns = [
+            r'^test_.*\\.py$',
+            r'.*_test\\.py$',
+            r'^conftest\\.py$',
+            r'^tests?$',  # directory named test or tests
+        ]
+        for pat in test_patterns:
+            if re.match(pat, fname):
+                return True
+        # Also consider files inside a tests/ directory
+        if re.search(r'(?:/|\\)tests?(?:/|\\)', path):
+            return True
+        return False
+
+    def _has_source_edit(self):
+        """Return True if any changed file is not a test file."""
+        for f in self._changed_files():
+            if not self._is_test_file(f):
+                return True
+        return False
+
