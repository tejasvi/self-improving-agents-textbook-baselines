--- a/coding_agent.py
+++ b/coding_agent.py
@@ -141,16 +141,56 @@ class AgenticSystem:
         """
         The forward function for the AgenticSystem.
         """
+        # Initial detailed prompt that asks the agent to perform several steps
         task = f"""I have uploaded a code repository in the directory {self.git_tempdir}. Help solve the following problem.
 
 <problem_description>
 {self.problem_statement}
 </problem_description>
 
-Your task is to make changes to the files in the {self.git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+Your responsibilities are:
+1. Analyze the problem constraints and derive the target time complexity.
+2. Implement the solution in the repository.
+3. Save all sample inputs/outputs from the problem statement to files under /tmp/tests and run them using stdin redirection (e.g., `python solution.py < in.txt`). Do not use heredocs.
+4. Write a brute‑force reference solution, a random small‑input generator, and an output validator.
+5. Execute at least 200 stress tests comparing your solution against the brute force implementation.
+6. Generate a maximum‑size test case based on the problem constraints, run your solution with `timeout 10 < input.txt` and ensure it finishes within the limit. If it exceeds the limit, iterate to improve performance.
+
+After performing these steps, if *all* checks pass, respond with the exact marker `ALL CHECKS PASSED`.
 """
-        instruction = f"{task}\n\nPlease analyze the problem description carefully. Then make edits to the code files to complete the instruction."
-        init_edit = chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+        # First interaction with the agent
+        init_msg = f"{task}\n\nPlease analyze the problem description carefully and make the required edits to the repository."
+        msg_history = []
+        # Call the agent once with the detailed instruction
+        msg_history = chat_with_agent(init_msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+
+        # Verification loop – bounded to a few rounds (e.g., 3)
+        for round_idx in range(3):
+            followup = """Review the work you have done so far. Run all sample tests, the stress tests, and the performance test. If anything fails, fix the code and re‑run the checks. When everything passes, reply with the marker `ALL CHECKS PASSED` and stop."""
+            msg_history = chat_with_agent(followup, model=self.code_model, msg_history=msg_history, logging=safe_log)
+            # Inspect the latest assistant message for the success marker
+            if msg_history:
+                last_msg = msg_history[-1]
+                # The assistant messages are stored with role 'assistant' and content may be a list of dicts
+                if last_msg.get('role') == 'assistant':
+                    content = last_msg.get('content')
+                    # content can be a string or list of blocks
+                    if isinstance(content, str) and 'ALL CHECKS PASSED' in content:
+                        safe_log('All checks passed – terminating verification loop.')
+                        break
+                    elif isinstance(content, list):
+                        # concat text blocks
+                        text_parts = []
+                        for block in content:
+                            if isinstance(block, dict):
+                                text_parts.append(block.get('text', ''))
+                            elif isinstance(block, str):
+                                text_parts.append(block)
+                        if any('ALL CHECKS PASSED' in part for part in text_parts):
+                            safe_log('All checks passed – terminating verification loop.')
+                            break
+        # Forward finished; the repository should now contain the solved code.
+        return msg_history
 
 def main():
     parser = argparse.ArgumentParser(description='Process repository with an agentic system.')
