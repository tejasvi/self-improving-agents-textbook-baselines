+    def _is_test_file(self, path: str) -> bool:
+        """Return True if the given file path appears to be a test file."""
+        # Normalize path
+        lower_path = path.lower()
+        # Check for typical test directories
+        if '/test/' in lower_path or '/tests/' in lower_path:
+            return True
+        # Check filename patterns
+        filename = os.path.basename(lower_path)
+        test_patterns = [
+            r'^test_.*\\.py$', r'.*_test\\.py$', r'^.*\\.spec\\.js$', r'^.*_test\\.go$',
+            r'^.*_test\\.java$', r'^.*_test\\.cpp$', r'^.*_test\\.ts$'
+        ]
+        for pat in test_patterns:
+            if re.match(pat, filename):
+                return True
+        return False
+
+    def _get_patch_status(self):
+        """Compute diff versus base commit and determine if source files were edited.
+        Returns (has_source_edit: bool, files: list of changed file paths)."""
+        diff_text = diff_versus_commit(self.git_tempdir, self.base_commit)
+        changed_files = []
+        for line in diff_text.splitlines():
+            if line.startswith('diff --git'):
+                # Format: diff --git a/<path> b/<path>
+                parts = line.split(' ')
+                if len(parts) >= 4:
+                    a_path = parts[2][2:]  # strip a/
+                    b_path = parts[3][2:]  # strip b/
+                    # Usually a_path == b_path, use b_path
+                    changed_files.append(b_path)
+        # Determine if any non-test file was changed
+        has_source_edit = any(not self._is_test_file(p) for p in changed_files)
+        return has_source_edit, changed_files
+
