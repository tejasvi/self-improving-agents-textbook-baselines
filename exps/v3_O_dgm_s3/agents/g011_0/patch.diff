+import sys
+
+def can_become_nondecreasing(arr):
+    """Determine if the array can be made non‑decreasing using operations that add +1 to A[i]
+    and -1 to A[j] for any i < j.
+    The necessary and sufficient condition is that the maximum prefix sum does not exceed
+    the total sum of the array.
+    """
+    total = sum(arr)
+    pref = 0
+    max_pref = -10**18
+    for a in arr:
+        pref += a
+        if pref > max_pref:
+            max_pref = pref
+    return max_pref <= total
+
+def main():
+    data = sys.stdin.read().strip().split()
+    if not data:
+        return
+    n = int(data[0])
+    arr = list(map(int, data[1:1 + n]))
+    print('Yes' if can_become_nondecreasing(arr) else 'No')
+
+if __name__ == "__main__":
+    main()
