index 0000000..b80563f
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,153 @@
+import importlib.util
+import json
+import os
+import random
+import subprocess
+import sys
+import traceback
+from typing import Any, Callable, Tuple
+
+def tool_info() -> dict:
+    """Return the JSON schema describing the stress_test tool.
+
+    The schema follows the specification required by the coding agent:
+    - name, description, input_schema containing type, properties, required.
+    """
+    return {
+        "name": "stress_test",
+        "description": "Run randomized stress testing comparing a solution implementation against a brute‑force reference. Supports class‑based solutions (Solution.method) or stdin programs.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file to be tested."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to a Python file that defines a function `brute(*args)` returning the correct answer."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Absolute path to a Python file that defines a function `gen(rng)` which returns a tuple/list of arguments to be passed to both the solution and the brute function."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to generate (default 300).",
+                    "default": 300
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "Execution mode: 'class' for a Solution class method, or 'stdin' for a program that reads from standard input.",
+                    "enum": ["class", "stdin"]
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on the Solution class when mode is 'class'. Required for class mode."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Random seed for reproducibility (default 0).",
+                    "default": 0
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path", "mode"]
+        }
+    }
+
+def _load_module_from_path(path: str) -> Any:
+    spec = importlib.util.spec_from_file_location("mod", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"Cannot load module from {path}")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["mod"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+def _run_solution_class(solution_path: str, method_name: str, args: Tuple) -> Any:
+    mod = _load_module_from_path(solution_path)
+    if not hasattr(mod, "Solution"):
+        raise AttributeError("Solution class not found in the solution file.")
+    cls = getattr(mod, "Solution")
+    instance = cls()
+    if not hasattr(instance, method_name):
+        raise AttributeError(f"Method {method_name} not found in Solution class.")
+    method = getattr(instance, method_name)
+    return method(*args)
+
+def _run_solution_stdin(solution_path: str, args: Tuple, timeout: int = 5) -> str:
+    # Build input string by joining args with spaces and newline
+    input_str = " ".join(str(x) for x in args) + "\n"
+    result = subprocess.run(
+        ["python", solution_path],
+        input=input_str,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=timeout,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(f"Solution exited with code {result.returncode}: {result.stderr.strip()}")
+    return result.stdout.strip()
+
+def tool_function(
+    solution_path: str,
+    brute_path: str,
+    generator_path: str,
+    num_tests: int = 300,
+    mode: str = "class",
+    method_name: str = None,
+    seed: int = 0,
+) -> str:
+    """Execute stress testing and return a human‑readable summary.
+
+    Parameters match the schema returned by ``tool_info``.
+    """
+    # Load brute and generator modules
+    brute_mod = _load_module_from_path(brute_path)
+    if not hasattr(brute_mod, "brute"):
+        raise AttributeError("brute function not found in brute module.")
+    brute_fn: Callable = getattr(brute_mod, "brute")
+
+    gen_mod = _load_module_from_path(generator_path)
+    if not hasattr(gen_mod, "gen"):
+        raise AttributeError("gen function not found in generator module.")
+    gen_fn: Callable[[random.Random], Tuple] = getattr(gen_mod, "gen")
+
+    rng = random.Random(seed)
+    for i in range(num_tests):
+        # Derive a fresh RNG for each test to avoid correlation
+        test_rng = random.Random(rng.randint(0, 2**63 - 1))
+        try:
+            args = gen_fn(test_rng)
+            if not isinstance(args, (list, tuple)):
+                args = (args,)
+        except Exception as e:
+            raise RuntimeError(f"Generator raised an exception on test {i}: {e}\n{traceback.format_exc()}")
+
+        # Compute expected answer
+        try:
+            expected = brute_fn(*args)
+        except Exception as e:
+            raise RuntimeError(f"Brute function raised an exception on test {i} with args {args}: {e}\n{traceback.format_exc()}")
+
+        # Run solution
+        try:
+            if mode == "class":
+                if method_name is None:
+                    raise ValueError("method_name must be provided for class mode")
+                got = _run_solution_class(solution_path, method_name, args)
+            elif mode == "stdin":
+                got = _run_solution_stdin(solution_path, args)
+            else:
+                raise ValueError(f"Unsupported mode: {mode}")
+        except Exception as e:
+            return f"MISMATCH: input={args}, expected={expected}, got=EXCEPTION({e})"
+
+        # Normalise outputs for comparison
+        got_cmp = got.strip() if isinstance(got, str) else got
+        exp_cmp = expected.strip() if isinstance(expected, str) else expected
+
+        if got_cmp != exp_cmp:
+            return f"MISMATCH: input={args}, expected={expected}, got={got}"
+    return f"ALL {num_tests} TESTS PASSED"
