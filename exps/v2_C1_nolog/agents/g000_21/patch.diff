@@ -0,0 +1,65 @@
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a Python script with the given stdin text and a wall-clock timeout.\n
+* Returns the stdout, stderr, exit code and elapsed wall time of the run.\n
+* If the script exceeds the timeout it is killed and the result says so (useful for detecting TLE).\n
+* Use it to run solutions on sample inputs, random tests, and max-size inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python script to run."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to feed to the script's standard input. Use an empty string if no input is needed."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Maximum wall-clock seconds the script may run before being killed."
+                }
+            },
+            "required": ["file_path", "stdin_text", "timeout_seconds"]
+        }
+    }
+
+MAX_OUTPUT_CHARS = 10000
+
+def _clip(text):
+    if text is None:
+        return ""
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+def tool_function(file_path, stdin_text, timeout_seconds):
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", file_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=float(timeout_seconds),
+        )
+        elapsed = time.time() - start
+        return (
+            f"Exit code: {proc.returncode}\n"
+            f"Elapsed: {elapsed:.3f}s\n"
+            f"STDOUT:\n{_clip(proc.stdout)}\n"
+            f"STDERR:\n{_clip(proc.stderr)}"
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        return (
+            f"TIMEOUT: killed after {float(timeout_seconds):.3f}s (elapsed {elapsed:.3f}s)\n"
+            f"STDOUT:\n{_clip(e.stdout.decode() if isinstance(e.stdout, bytes) else e.stdout)}\n"
+            f"STDERR:\n{_clip(e.stderr.decode() if isinstance(e.stderr, bytes) else e.stderr)}"
+        )
+    except Exception as e:
+        return f"Error running script: {e}"
