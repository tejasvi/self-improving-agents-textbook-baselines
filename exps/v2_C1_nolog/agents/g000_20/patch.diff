@@ -0,0 +1,70 @@
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 10000
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a shell command with optional stdin text and a hard time limit. Returns stdout, stderr, return code and elapsed time.
+* Use this to run solutions against test inputs, especially for timing checks (TLE) or possibly hanging programs.
+* If the command exceeds the timeout it is killed and the result reports a timeout instead of blocking the shell.
+* Output is truncated if very long.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python3 /tmp/stress/sol.py'."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to feed to the command's standard input. Use an empty string if no input is needed."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Maximum number of seconds the command may run before being killed."
+                }
+            },
+            "required": ["command", "stdin_text", "timeout_seconds"]
+        }
+    }
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + f"\n... [truncated {len(text) - MAX_OUTPUT_CHARS} chars]"
+    return text
+
+def tool_function(command, stdin_text, timeout_seconds):
+    start = time.time()
+    try:
+        timeout_seconds = float(timeout_seconds)
+        proc = subprocess.run(
+            command,
+            shell=True,
+            input=stdin_text or "",
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+        )
+        elapsed = time.time() - start
+        return (
+            f"stdout:\n{_truncate(proc.stdout)}\n"
+            f"stderr:\n{_truncate(proc.stderr)}\n"
+            f"return_code: {proc.returncode}\n"
+            f"elapsed_seconds: {elapsed:.3f}\n"
+            f"timed_out: False"
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return (
+            f"stdout:\n{_truncate(out or '')}\n"
+            f"stderr:\n{_truncate(err or '')}\n"
+            f"return_code: None\n"
+            f"elapsed_seconds: {elapsed:.3f}\n"
+            f"timed_out: True (limit {timeout_seconds}s exceeded; process killed)"
+        )
+    except Exception as e:
+        return f"Error running command: {e}"
