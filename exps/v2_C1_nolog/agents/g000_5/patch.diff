+def _last_assistant_text(msg_history):
+    """Return the concatenated text of the last assistant message in msg_history ('' if none)."""
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            texts = []
+            for b in content:
+                # Raw Claude responses store SDK block objects; converted history stores dicts.
+                t = b.get('text') if isinstance(b, dict) else getattr(b, 'text', None)
+                if isinstance(t, str):
+                    texts.append(t)
+            return "\n".join(texts)
+        return ''
+    return ''
