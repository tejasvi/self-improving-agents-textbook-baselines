+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the most recent assistant message in the history."""
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            texts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and block.get('text'):
+                        texts.append(block['text'])
+                elif getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                    texts.append(block.text)
+            if texts:
+                return "\n".join(texts)
+        return ""
+
+    def forward(self):
+        """
+        Multi-phase, self-verifying workflow:
+          1. Plan
+          2. Implement and run sample tests
+          3. Stress test against a brute-force reference and time a max-size input
+          4. Bounded repair loop until the agent reports VERIFIED: PASS
+          5. Final review
+        The message history is shared across phases.
+        """
+        header = self._header()
+        scratch = "/tmp"
+        model = self.code_model
+        msg_history = []
+
+        # Phase 1: plan
+        plan_prompt = f"""{header}
+## Phase 1: Plan (do not write the solution yet)
+
+Please produce a written plan covering:
+1. Restate the problem in your own words (inputs, outputs, what must be computed).
+2. Parse the constraints (n, value ranges, time limit if given, memory hints).
+3. Choose an algorithm and state its target time and space complexity. Justify why it fits the constraints.
+4. List tricky edge cases (e.g. smallest input, empty input, duplicates, all-equal values, maximum values, negative numbers, overflow-like cases).
+5. Identify the required interface: if the statement gives a `Solution` class with a method signature, keep that exact class name, method name and argument/return types; otherwise the solution must be a complete program reading standard input and writing standard output.
+6. Locate the solution file inside {self.git_tempdir} (an existing file that the task points to, or create a new one such as `{self.git_tempdir}/solution.py` if none exists). Name it and state where it will live.
+
+Do not create any test or scratch files inside {self.git_tempdir}. Scratch files belong in {scratch}.
+"""
+        msg_history = chat_with_agent(plan_prompt, model=model, msg_history=msg_history, logging=safe_log)
+
+        # Phase 2: implement and sample test
+        implement_prompt = f"""Phase 2: Implement the solution and check the examples.
+
+1. Write the solution in the solution file from your plan, following the required interface exactly.
+2. Extract every example input and expected output from the problem statement (all of them, not just the first).
+3. Run each example with bash. For stdin/stdout programs use `python <file> < input_file`; for a `Solution` class, instantiate it in a short Python command and call the method with the example arguments.
+4. Compare the actual output with the expected output token by token (ignore only trailing whitespace differences that the statement allows). Report each example as matched or mismatched with the actual output.
+5. If anything mismatches, fix the solution and rerun until all examples match.
+
+Keep the solution file as the only file you add to {self.git_tempdir}. Put any helper inputs in {scratch}.
+"""
+        msg_history = chat_with_agent(implement_prompt, model=model, msg_history=msg_history, logging=safe_log)
+
+        # Phase 3: stress test
+        stress_prompt = f"""Phase 3: Stress test and performance check. Use only scratch files under {scratch} (NOT inside {self.git_tempdir}).
+
+1. Write `{scratch}/brute.py`: an obviously correct reference solution (exhaustive search or direct simulation, even if exponential). It must implement the same interface/IO format as the real solution.
+2. Write `{scratch}/gen.py`: a random generator of small valid inputs that respect the constraints. Cover edge cases (smallest sizes, duplicates, boundary values) in addition to purely random cases. Accept a seed argument.
+3. Write `{scratch}/stress.sh` or a Python driver `{scratch}/stress.py` that, for a few hundred iterations, generates an input with a new seed, runs both the solution and the brute force, and compares outputs. Stop and print the first failing input on the first mismatch.
+4. Run the stress test. Use `timeout` on every run so nothing hangs.
+5. Performance: generate a maximum-constraint input (largest n and largest values allowed by the statement) into {scratch}, and time the solution on it with `timeout 10 python <file> < input` (or the equivalent for a `Solution` class). Report the elapsed time. If it is slow or times out, the algorithm must be improved to meet the target complexity from your plan.
+
+Report every mismatch and every timing result you observed.
+"""
+        msg_history = chat_with_agent(stress_prompt, model=model, msg_history=msg_history, logging=safe_log)
+
+        # Phase 4: repair loop (bounded)
+        verified = False
+        for attempt in range(3):
+            check_prompt = f"""Phase 4 (attempt {attempt + 1} of 3): Check the current state.
+
+Rerun the sample tests and the stress test on the current solution. If there are mismatches or a TLE was found, fix the solution (fix mismatches or TLE found, then rerun the stress test) and repeat until all checks pass.
+
+When you finish, end your reply with exactly one of these lines on its own:
+VERIFIED: PASS
+VERIFIED: FAIL
+Use VERIFIED: PASS only if all examples match, the stress test showed no mismatches over the full run, and the max-size input runs well within the time limit.
+"""
+            msg_history = chat_with_agent(check_prompt, model=model, msg_history=msg_history, logging=safe_log)
+            reply = self._last_assistant_text(msg_history)
+            if 'VERIFIED: PASS' in reply:
+                verified = True
+                break
+            if 'VERIFIED: FAIL' not in reply:
+                safe_log("Warning: agent did not report a VERIFIED line; continuing repair loop.")
+
+        safe_log(f"Repair loop finished. Verified: {verified}")
+
+        # Phase 5: final review
+        review_prompt = f"""Phase 5: Final review. Check the following and fix anything that fails:
+
+- Output format: exact required output, correct line breaks, no extra spaces or missing newline issues; matches the examples exactly.
+- Edge cases: n=1, empty or minimal input, duplicates, maximum values, negative values if allowed.
+- Fast input: for stdin programs read all input at once via `sys.stdin` (e.g. `sys.stdin.read().split()`); avoid slow per-line `input()` loops for large inputs.
+- Recursion: if the solution is recursive, call `sys.setrecursionlimit` appropriately or use an iterative approach for deep recursion.
+- Interface: the `Solution` class and method signature are exactly as the problem requires (if applicable).
+- No debug prints or leftover logging in the solution.
+- No leftover test, brute-force, generator or scratch files inside {self.git_tempdir}. Remove any you created there; scratch files stay in {scratch}.
+
+Run the examples one final time after any change. End with a short summary of the final solution.
+"""
+        msg_history = chat_with_agent(review_prompt, model=model, msg_history=msg_history, logging=safe_log)
+        return msg_history
 
