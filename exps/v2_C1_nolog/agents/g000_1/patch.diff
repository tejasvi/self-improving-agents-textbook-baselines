@@ -0,0 +1,60 @@
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a Python file with the given stdin text and a time limit.\n
+* Returns stdout, stderr, the exit code and the elapsed wall-clock time in seconds.\n
+* If the program exceeds the timeout it is killed and the result says so.\n
+* Use this to run sample tests and timing checks on solutions.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Path to the Python file to run."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to feed to the program's standard input. Use an empty string if none is needed."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Maximum allowed run time in seconds."
+                }
+            },
+            "required": ["file_path", "stdin_text", "timeout_seconds"]
+        }
+    }
+
+
+def tool_function(file_path, stdin_text, timeout_seconds):
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", file_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=float(timeout_seconds),
+        )
+        elapsed = time.time() - start
+        return (
+            f"exit_code: {proc.returncode}\n"
+            f"elapsed: {elapsed:.3f}s\n"
+            f"stdout:\n{proc.stdout}\n"
+            f"stderr:\n{proc.stderr}"
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return (
+            f"TIMEOUT after {elapsed:.3f}s (limit {timeout_seconds}s)\n"
+            f"stdout:\n{out}\n"
+            f"stderr:\n{err}"
+        )
+    except Exception as e:
+        return f"Error running {file_path}: {e}"
