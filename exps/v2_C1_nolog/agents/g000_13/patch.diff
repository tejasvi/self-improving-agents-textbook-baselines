new file mode 100644
index 0000000..f7f3284
--- /dev/null
+++ b/tools/run_with_timeout.py
@@ -0,0 +1,79 @@
+import subprocess
+import sys
+import time
+
+MAX_OUTPUT_CHARS = 20000
+
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a Python script with the given standard input under a time limit.\n
+* Returns stdout, stderr, the exit code and the elapsed wall-clock time in seconds.\n
+* Use it to check the running time of a solution on large inputs, or to feed sample inputs to a program.\n
+* If the script exceeds the time limit it is killed and the result reports timed_out=True.\n
+* Output longer than 20000 characters is truncated.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "script_path": {
+                    "type": "string",
+                    "description": "Path to the Python script to run."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text to pass to the script's standard input. Use an empty string if no input is needed."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Time limit in seconds before the script is killed. e.g. 10."
+                }
+            },
+            "required": ["script_path", "stdin_text", "timeout_seconds"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n...[truncated]"
+    return text
+
+
+def tool_function(script_path, stdin_text, timeout_seconds):
+    try:
+        timeout = float(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout = 10.0
+    if timeout <= 0:
+        timeout = 10.0
+
+    start = time.monotonic()
+    try:
+        proc = subprocess.run(
+            [sys.executable, script_path],
+            input=(stdin_text or "").encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            check=False,
+        )
+        elapsed = time.monotonic() - start
+        stdout = proc.stdout.decode(errors="replace")
+        stderr = proc.stderr.decode(errors="replace")
+        exit_code = proc.returncode
+        timed_out = False
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.monotonic() - start
+        stdout = (e.stdout or b"").decode(errors="replace")
+        stderr = (e.stderr or b"").decode(errors="replace")
+        exit_code = None
+        timed_out = True
+
+    return (
+        f"exit_code: {exit_code}\n"
+        f"timed_out: {timed_out}\n"
+        f"elapsed_seconds: {elapsed:.3f}\n"
+        f"--- stdout ---\n{_truncate(stdout)}\n"
+        f"--- stderr ---\n{_truncate(stderr)}"
+    )
