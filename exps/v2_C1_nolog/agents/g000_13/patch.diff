@@ -0,0 +1,92 @@
+"""Prompt templates for the competitive-programming coding agent."""
+
+
+def _format_optional(label, value):
+    if value is None or str(value).strip() == "":
+        return ""
+    return f"\n{label}: {value}\n"
+
+
+MAIN_TEMPLATE = """I have uploaded a code repository in the directory {git_tempdir}. Help solve the following competitive programming problem.
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+{language_info}{test_description_info}
+The solution will be graded on hidden tests (correctness, edge cases, I/O handling, time limits, and recursion limits), so be thorough.
+
+## Task format
+First, determine which format the task uses (look at the repository files, any stub or test files, and the statement):
+- **Complete program**: the solution is a full script that reads standard input and writes standard output. Read input with `sys.stdin` (e.g. `sys.stdin.buffer.read().split()`) and write output with a single `print` / `sys.stdout.write` of the joined result. Do not wrap it in an interactive prompt.
+- **`Solution` class method**: the solution must be a method of the given `Solution` class. Keep the EXACT class name, method name, argument names, argument order, and return type. Do not read from stdin or print anything at import time.
+
+Keep any helper code inside the solution file and keep the solution file clean (no debug prints, no leftover experiments).
+
+## Workflow (follow these phases in order)
+
+### Phase 1: Analyze
+- Restate the problem in your own words.
+- Extract the constraints (N, value ranges, number of test cases, time/memory limits if given).
+- Derive the target time complexity and check that it fits the constraints.
+- List edge cases (smallest inputs, single-element inputs, maximum values, duplicates, negative numbers, impossible cases).
+- Identify the I/O format or the required method signature.
+- Locate the target file(s) in the repository (use bash: `ls`, `find`, `cat`, `git status`).
+
+### Phase 2: Implement
+- Write an efficient, correct solution in the target file.
+- For programs: use fast input (`sys.stdin`), avoid deep recursion (prefer iteration or an explicit stack; if recursion is unavoidable, use `sys.setrecursionlimit` together with a thread with a larger `threading.stack_size`).
+- For `Solution` classes: keep the exact signature; no input reading or printing at import time.
+
+### Phase 3: Verify
+- Run every example from the problem statement and confirm the outputs match exactly (including formatting such as spaces, newlines, and YES/NO casing).
+- Write a simple brute-force reference solution in a scratch file under `/tmp` (NOT in the repository).
+- Write a random stress test under `/tmp` that generates many small random inputs (covering edge cases), runs both the solution and the brute force, and compares the outputs. Run it with bash, e.g. `python3 /tmp/stress.py`.
+- Test worst-case-size inputs for timing (generate them under `/tmp`, and time the run with bash `time`) and confirm the solution finishes well within the limits.
+- Keep ALL scratch files (brute force, generators, stress scripts, inputs) in `/tmp`. Never add them to the repository.
+
+### Phase 4: Refine
+- If any check fails, find the root cause, fix the solution, and re-run all checks (examples, stress test, timing) until everything passes.
+- Remove any temporary files you accidentally created inside the repository.
+
+### Phase 5: Final cleanup
+- Make sure the solution file contains only the final solution code.
+- Confirm with `git status` / `git diff` that only the intended solution file(s) changed.
+- Summarize what you implemented and the verification results.
+"""
+
+
+REVIEW_TEMPLATE = """Review pass. Below is the problem statement and the current diff of the repository (the solution written so far).
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+<current_diff>
+{diff}
+</current_diff>
+
+Audit the solution carefully:
+- Check for off-by-one errors, wrong boundary handling, and missed edge cases (smallest/largest inputs, empty cases).
+- Check the I/O format: exact output formatting, reading all input correctly, and the exact method signature for `Solution` classes (with no input reading or printing at import time).
+- Check performance against the largest constraints (time complexity, recursion depth, memory).
+- Re-run the stress tests in `/tmp` (brute force vs. solution on small random inputs), the timing tests on large inputs, and the examples from the statement.
+- If you find any bug or risk, fix it in the solution file, then re-run the checks.
+- Keep scratch files in `/tmp` only; keep the solution file clean.
+
+If the solution is already correct and no changes are needed, make no edits and reply with a short statement that no changes are needed.
+"""
+
+
+def build_main_prompt(problem_statement, git_tempdir, language=None, test_description=None):
+    return MAIN_TEMPLATE.format(
+        problem_statement=problem_statement,
+        git_tempdir=git_tempdir,
+        language_info=_format_optional("Programming language", language),
+        test_description_info=_format_optional("How to test the repository", test_description),
+    )
+
+
+def build_review_prompt(problem_statement, diff):
+    return REVIEW_TEMPLATE.format(problem_statement=problem_statement, diff=diff)
