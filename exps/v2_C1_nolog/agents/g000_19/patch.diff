+"""Phase prompts for the competitive-programming workflow used by AgenticSystem.forward()."""
+
+
+def get_task_header(git_tempdir, problem_statement, test_description=None):
+    """Common task text that is prepended to the first phase prompt."""
+    text = f"""I have uploaded a code repository in the directory {git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+"""
+    if test_description:
+        text += f"""
+<test_description>
+{test_description}
+</test_description>
+"""
+    return text
+
+
+def get_design_prompt(git_tempdir):
+    return f"""Phase 1 of 5: UNDERSTAND AND DESIGN.
+
+Work only inside {git_tempdir} for repository files.
+
+1. Restate the problem in your own words (inputs, outputs, what must be computed).
+2. Determine the required interface:
+   - If the statement asks for a complete program that reads standard input and writes standard output, the solution must read from stdin and print to stdout in exactly the format described.
+   - If the statement gives a `Solution` class with a method signature, keep that exact class name, method name, parameter names, parameter order, and return type. Note any imports the signature needs (for example `from typing import List`).
+   - Inspect the existing files in the repository first to find the expected solution file name and any existing stubs or tests.
+3. List every constraint (ranges of n, value ranges, time limits if given, multiple test cases, guaranteed properties) and every edge case (minimal input, all-equal values, maximum values, duplicates, negative numbers, impossible cases, overflow-prone sums).
+4. Choose an algorithm. Briefly justify it and estimate its time and memory complexity against the largest constraints. Reject approaches that are clearly too slow.
+5. Write the complete solution into the appropriate file in the repository, using fast input handling (sys.stdin) when n is large.
+
+Do not write tests or helper files yet; that happens in the next phase. Finish by briefly summarizing the chosen algorithm and its complexity."""
+
+
+def get_verify_prompt(git_tempdir):
+    return f"""Phase 2 of 5: VERIFY.
+
+Verify the solution you just wrote. Use the tools available to you (bash, editor) as you see fit.
+
+1. Save every example from the problem statement as test cases and run the solution on them. Compare the output exactly with the expected output. If the statement gives no examples, derive small cases by hand and check them.
+2. Write a simple, obviously correct brute-force reference solution for small inputs. Write a random generator of small valid inputs that respects the constraints and includes edge cases (minimum sizes, equal values, extremes).
+3. Stress-compare the solution against the brute force on a few hundred random small cases. For every mismatch, record the failing input and both outputs.
+4. Create a worst-case-size input (maximum n and extreme values allowed by the constraints) and time the solution on it. The target is roughly under 1-2 seconds for a typical Python run. If it is too slow, identify the bottleneck.
+5. Put all helper files (brute force, generator, stress script, large inputs, test files) in /tmp, NOT inside {git_tempdir}, so the repository only contains the final solution.
+
+Report precisely: which examples passed, how many stress cases matched, the worst-case runtime, and any mismatches or slow paths found."""
+
+
+def get_refine_prompt(git_tempdir):
+    return f"""Phase 3 of 5: REFINE.
+
+Based on the verification results above:
+- If any example, stress case, or edge case failed, find the root cause in the solution, fix it, and re-run the failing case.
+- If the solution is too slow on worst-case input, improve the algorithm or implementation (for example, avoid repeated work, use better data structures, use faster input reading, avoid deep recursion).
+- Re-run the examples, the stress comparison, and the timing after every change.
+- If everything already passes and runs fast enough, make no unnecessary changes.
+
+Keep helper files in /tmp, not in {git_tempdir}. When you are done, state clearly whether ALL checks passed (all examples, the full stress comparison, and the timing target)."""
+
+
+def get_check_prompt():
+    return """Quick check: Have ALL of the following passed in the latest run?
+- every example from the problem statement matches the expected output,
+- the stress comparison against the brute force reported no mismatches,
+- the worst-case-size input runs in roughly under 1-2 seconds.
+
+Start your answer with the single word PASS if and only if all of the above passed, or FAIL otherwise. After that word, add one or two sentences; if FAIL, say what remains to fix."""
+
+
+def get_final_review_prompt(git_tempdir, problem_statement):
+    return f"""Phase 5 of 5: FINAL REVIEW.
+
+1. Re-read the problem statement below and check for missed constraints, output format details (spacing, newlines, required order), and multiple test case handling.
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+2. Open the final solution file and check:
+   - there are no debug prints, no leftover test code, and nothing that prints extra output;
+   - for stdin/stdout tasks, input is read with sys.stdin (for example sys.stdin.readline or sys.stdin.buffer.read) when n is large, and output matches the required format exactly;
+   - for `Solution` class tasks, the class name, method name, parameter names, and return type match the required signature exactly, and every import it needs (for example `from typing import List`) is present;
+   - there are no infinite loops.
+3. Remove any stray test, brute-force, generator, or scratch files from {git_tempdir} (anything you created that is not part of the required solution). Helper files should live in /tmp only.
+4. If you change anything, re-run the examples once more to confirm.
+
+Finish with a short summary of the final solution."""
