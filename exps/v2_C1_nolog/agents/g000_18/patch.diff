@@ -0,0 +1,74 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress tester. Repeatedly generates an input with generator_cmd, runs solution_cmd and brute_cmd on it (both read stdin and write stdout), and compares their outputs (whitespace-trimmed). Stops at the first mismatch and returns that input and both outputs, or reports that all iterations matched. Each command is run with a 20 second timeout. Commands run in the current working directory of the tool, so use absolute paths for files.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the optimized solution, e.g. 'python3 /repo/sol.py'. It reads the input from stdin and writes the answer to stdout."
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the simple brute-force reference, e.g. 'python3 /tmp/brute.py'. Same stdin/stdout contract as solution_cmd."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that prints one random test input to stdout each time it is run, e.g. 'python3 /tmp/gen.py'. It should use random values, so each run differs."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random inputs to test. Keep it modest (e.g. 100 to 1000)."
+                }
+            },
+            "required": ["solution_cmd", "brute_cmd", "generator_cmd", "iterations"]
+        }
+    }
+
+
+def _run(cmd, stdin_text):
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True,
+            text=True, timeout=20,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f"TIMEOUT after 20s running: {cmd}"
+    if proc.returncode != 0:
+        return None, f"non-zero exit ({proc.returncode}) running {cmd}\nstderr:\n{proc.stderr}"
+    return proc.stdout, None
+
+
+def tool_function(solution_cmd, brute_cmd, generator_cmd, iterations):
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        return f"Invalid iterations value: {iterations!r}"
+
+    for i in range(iterations):
+        gen_out, err = _run(generator_cmd, "")
+        if err is not None:
+            return f"Generator failed at iteration {i}: {err}"
+        test_input = gen_out
+
+        sol_out, err = _run(solution_cmd, test_input)
+        if err is not None:
+            return f"Solution failed at iteration {i} on input:\n{test_input}\n{err}"
+
+        brute_out, err = _run(brute_cmd, test_input)
+        if err is not None:
+            return f"Brute force failed at iteration {i} on input:\n{test_input}\n{err}"
+
+        if sol_out.strip() != brute_out.strip():
+            return (
+                f"MISMATCH at iteration {i}.\n"
+                f"Input:\n{test_input}\n"
+                f"Solution output:\n{sol_out}\n"
+                f"Brute force output:\n{brute_out}"
+            )
+
+    return f"All {iterations} random tests matched."
