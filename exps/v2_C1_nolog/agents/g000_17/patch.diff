diff --git a/tools/run_with_timeout.py b/tools/run_with_timeout.py
new file mode 100644
index 0000000..5ee389d
--- /dev/null
+++ b/tools/run_with_timeout.py
@@ -0,0 +1,64 @@
+import subprocess
+import sys
+import time
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a Python script with the given stdin input and a time limit.\n
+* Returns stdout, stderr, the return code, and the elapsed wall-clock time in seconds.\n
+* If the script exceeds the timeout it is killed and the result reports a timeout.\n
+* Use it to check that a solution produces the expected output and runs fast enough on max-size inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "script_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python script to run, e.g. `/tmp/sol.py`."
+                },
+                "stdin_input": {
+                    "type": "string",
+                    "description": "Text to feed to the script's standard input. Use an empty string if none is needed."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Maximum number of seconds the script may run. Defaults to 10 if omitted."
+                }
+            },
+            "required": ["script_path", "stdin_input"]
+        }
+    }
+
+def tool_function(script_path: str, stdin_input: str, timeout: float = 10) -> str:
+    if timeout is None:
+        timeout = 10
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, script_path],
+            input=stdin_input,
+            capture_output=True,
+            text=True,
+            timeout=float(timeout),
+        )
+        elapsed = time.time() - start
+        return (
+            f"Return code: {proc.returncode}\n"
+            f"Elapsed: {elapsed:.3f}s\n"
+            f"STDOUT:\n{proc.stdout}\n"
+            f"STDERR:\n{proc.stderr}"
+        )
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return (
+            f"TIMEOUT after {timeout}s (elapsed {elapsed:.3f}s)\n"
+            f"STDOUT:\n{out}\n"
+            f"STDERR:\n{err}"
+        )
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+if __name__ == "__main__":
+    print(tool_function("/dev/null", ""))
