@@ -0,0 +1,76 @@
+"""Phase-specific prompts for the competitive-programming coding agent."""
+
+TASK_HEADER = """I have uploaded a code repository in the directory {git_tempdir}. Help solve the following problem.
+
+<problem_description>
+{problem_statement}
+</problem_description>
+
+Your task is to make changes to the files in the {git_tempdir} directory to address the <problem_description>. I have already taken care of the required dependencies.
+"""
+
+LANGUAGE_NOTE = "\nThe solution must be written in {language}.\n"
+
+TEST_DESCRIPTION_NOTE = "\nHow to test the repository (from the task setup):\n{test_description}\n"
+
+PHASE1_ANALYZE = """# Phase 1: Analysis (no edits yet)
+
+Carefully analyze the problem before writing any code.
+
+1. Restate the problem in your own words.
+2. Extract the constraints (input sizes, value ranges, time/memory limits if given).
+3. Describe the exact input and output format, and work through every sample case by hand.
+4. Locate the target file and starter code. Use bash (`ls -la`, `cat`, `find`, `git -C {git_tempdir} log --oneline -n 3`) to inspect the repository under {git_tempdir}. Identify whether the task expects:
+   - a method of a given `Solution` class: preserve the exact class name, method name, parameters, and return type; or
+   - a complete program reading standard input and writing standard output: preserve the stdin/stdout contract.
+5. Choose an algorithm. State its time and space complexity and check it against the constraints (assume roughly 10^8 simple operations at most in Python).
+6. List tricky edge cases (empty input, minimum/maximum values, duplicates, overflow-sensitive values, single element, worst-case structure).
+
+Do not modify any files in this phase. Reply with a concise summary of your analysis, including the target file path and the chosen algorithm.
+"""
+
+PHASE2_IMPLEMENT = """# Phase 2: Implementation
+
+Now implement the solution in the target file identified in your analysis.
+
+- Keep the required `Solution` method signature or the stdin/stdout contract exactly as the problem specifies.
+- For programs reading stdin, use fast input (`sys.stdin.readline` or `sys.stdin.read().split()`) and buffered output (collect results and print once).
+- Avoid deep recursion; use iteration or an explicit stack, or raise the recursion limit only if truly needed.
+- Do not leave debug prints in the solution file.
+- Only edit the solution file(s) inside the repository. Do not add test files or scratch files to the repository.
+
+When done, reply with a short description of what you implemented.
+"""
+
+PHASE3_VERIFY = """# Phase 3: Verification
+
+The hidden tests are NOT available to you, so you must build your own tests. Create all scratch files in a separate directory outside the repository, e.g. `/tmp/verify/`, so nothing pollutes the patch. Never create test files inside {git_tempdir}.
+
+Do the following:
+
+1. Run the solution on every sample case from the problem statement and compare with the expected output exactly.
+2. Write a brute-force reference solution (simple and obviously correct, even if slow) in `/tmp/verify/brute.py`.
+3. Write a random generator of small valid inputs in `/tmp/verify/gen.py` (respecting the constraints; include tiny and edge-case values).
+4. Stress test: run a loop of a few hundred iterations (e.g. 300) generating an input, running both the solution and the brute force, and comparing outputs. Use bash with `timeout` on every run (e.g. `timeout 5 python3 ...`) so that a hang is detected. Stop and report the first mismatching input.
+5. Run explicit edge cases (minimum sizes, maximum values, duplicates, all-equal, empty-like cases where the format allows).
+6. Benchmark: generate worst-case-size inputs at the maximum constraints and time the solution with `time` under `timeout`. If it is too slow for the constraints, optimize the algorithm and re-verify.
+
+If the task is a `Solution` class method, call the method directly from a small harness in /tmp (import it from the repository path) instead of running a script.
+
+Report clearly which checks passed and which failed (with the failing input and outputs).
+"""
+
+PHASE4_REVIEW = """# Phase 4: Final Review
+
+Review the final state before finishing:
+
+1. Re-read the original problem statement and compare it line by line with the final code.
+2. Check the `Solution` method signature or the stdin/stdout I/O format exactly as specified.
+3. Remove any debug prints, leftover scratch code, and unused imports from the solution file.
+4. Make sure no test or scratch files were created inside the repository (check with `git -C {git_tempdir} status`); remove any you find.
+5. Confirm the final file runs (e.g. run it once on a sample input under `timeout`).
+
+If you find any issue, fix it. When everything is correct, reply with a short summary of the final solution.
+"""
+
+ROUND_FOLLOWUP = """If any check failed, fix the solution and re-run the verification and review steps (use scratch files in /tmp only). If every check passes, reply with the single word DONE on its own line."""
