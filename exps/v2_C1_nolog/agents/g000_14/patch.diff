+        Runs a multi-phase workflow (analyze -> implement -> verify -> review),
+        carrying the message history across all chat_with_agent calls.
+        Verification and review are repeated for a bounded number of rounds.
+        """
+        task = TASK_HEADER.format(git_tempdir=self.git_tempdir, problem_statement=self.problem_statement)
+        if self.language:
+            task += LANGUAGE_NOTE.format(language=self.language)
+        if self.test_description:
+            task += TEST_DESCRIPTION_NOTE.format(test_description=self.test_description)
+
+        def run(msg, msg_history):
+            return chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+
+        # Phase 1: analysis
+        msg_history = run(
+            f"{task}\n\n{PHASE1_ANALYZE.format(git_tempdir=self.git_tempdir)}",
+            [],
+        )
+        # Phase 2: implementation
+        msg_history = run(PHASE2_IMPLEMENT, msg_history)
+
+        # Phases 3-4: verification and review, repeated for a bounded number of rounds
+        for round_idx in range(MAX_ROUNDS):
+            msg_history = run(PHASE3_VERIFY.format(git_tempdir=self.git_tempdir), msg_history)
+            msg_history = run(PHASE4_REVIEW.format(git_tempdir=self.git_tempdir), msg_history)
+            if round_idx == MAX_ROUNDS - 1:
+                break
+            msg_history = run(ROUND_FOLLOWUP, msg_history)
+            if _last_text_contains_done(msg_history):
+                break
+
+        return msg_history
+
+
+def _last_text_contains_done(msg_history):
+    """Return True if the last assistant reply contains the DONE marker."""
+    if not msg_history:
+        return False
+    last = msg_history[-1]
+    content = last.get('content') if isinstance(last, dict) else None
+    if isinstance(content, list):
+        parts = []
+        for block in content:
+            t = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if t:
+                parts.append(str(t))
+        text = " ".join(parts)
+    elif isinstance(content, str):
+        text = content
+    else:
+        text = str(last)
+    return 'DONE' in text
 
