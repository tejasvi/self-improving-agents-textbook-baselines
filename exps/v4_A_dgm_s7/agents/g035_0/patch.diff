+def _extract_python_code(text):
+    """Return code from a ```python block, a plain ``` block, or raw text that parses as Python; else None."""
+    if not text:
+        return None
+    m = re.search(r"```python\s*\n(.*?)```", text, re.DOTALL)
+    if m and m.group(1).strip():
+        return m.group(1)
+    m = re.search(r"```[^\n]*\n(.*?)```", text, re.DOTALL)
+    if m and m.group(1).strip():
+        return m.group(1)
+    try:
+        ast.parse(text)
+        if text.strip():
+            return text
+    except SyntaxError:
+        pass
+    return None
+
