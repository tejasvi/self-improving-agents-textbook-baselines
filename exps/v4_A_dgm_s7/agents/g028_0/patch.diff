+def _sanitize_history(msg_history):
+    """
+    Return a copy of msg_history without assistant messages whose content blocks
+    are all empty/whitespace text blocks (and contain no tool_use blocks).
+    """
+    cleaned = []
+    for msg in (msg_history or []):
+        if msg.get('role') == 'assistant':
+            content = msg.get('content')
+            if isinstance(content, str):
+                if not content.strip():
+                    continue
+            elif isinstance(content, list):
+                blocks = content
+                has_tool = any(
+                    (b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)) == 'tool_use'
+                    for b in blocks
+                )
+                if not has_tool:
+                    all_empty_text = True
+                    for b in blocks:
+                        btype = b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)
+                        text = b.get('text') if isinstance(b, dict) else getattr(b, 'text', None)
+                        if btype != 'text' or (text or '').strip():
+                            all_empty_text = False
+                            break
+                    if all_empty_text:
+                        continue
+        cleaned.append(msg)
+    return cleaned
+
+def _safe_chat(instruction, model, history):
+    """
+    Call chat_with_agent with exception protection. Returns a sanitized history;
+    on failure returns the sanitized input history.
+    """
+    try:
+        new_history = chat_with_agent(instruction, model=model, msg_history=history, logging=safe_log)
+        if new_history is None:
+            new_history = history
+        return _sanitize_history(new_history)
+    except Exception as e:
+        safe_log(f"[safe_chat] exception: {type(e).__name__}: {e}", level=logging.WARNING)
+        return _sanitize_history(history)
+
+def _detect_solution_filename(problem_statement):
+    """
+    Detect a referenced .py filename in the problem statement; default to solution.py.
+    """
+    match = re.search(r'`([\w./-]+\.py)`', problem_statement or '')
+    if match:
+        return match.group(1)
+    return 'solution.py'
+
+def _extract_python_code(text):
+    match = re.search(r'```python\s*\n(.*?)```', text or '', re.DOTALL)
+    if match:
+        return match.group(1)
+    return None
+
