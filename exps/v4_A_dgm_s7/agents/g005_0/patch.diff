+    def _extract_samples(self):
+        """
+        Parse (input, expected_output) sample pairs from self.problem_statement.
+        Primary format: 'Sample Input N' followed by 'Sample Output N'.
+        Fallback: 'Input:' / 'Output:' blocks, and 'Example' blocks.
+        Returns a list of (input_str, expected_str) tuples.
+        """
+        text = self.problem_statement or ''
+        samples = []
+
+        # Primary: "Sample Input k" ... "Sample Output k"
+        pattern = re.compile(
+            r'Sample\s+Input\s*(\d*)\s*:?\s*\n(.*?)\n\s*Sample\s+Output\s*\1\s*:?\s*\n(.*?)(?=\n\s*Sample\s+Input|\Z)',
+            re.IGNORECASE | re.DOTALL,
+        )
+        for m in pattern.finditer(text):
+            samples.append((m.group(2).strip('\n') + '\n', m.group(3).strip()))
+        if samples:
+            return samples
+
+        # Fallback: "Input:" / "Output:" pairs
+        pattern = re.compile(
+            r'(?:^|\n)\s*Input\s*:?\s*\n?(.*?)\n\s*Output\s*:?\s*\n?(.*?)(?=\n\s*Input\s*:|\Z)',
+            re.IGNORECASE | re.DOTALL,
+        )
+        for m in pattern.finditer(text):
+            inp = m.group(1).strip()
+            out = m.group(2).strip()
+            if inp and out:
+                samples.append((inp + '\n', out))
+        if samples:
+            return samples
+
+        # Fallback: "Example" blocks with input then output lines
+        pattern = re.compile(
+            r'Example\s*\d*\s*:?\s*\n(.*?)\n\s*(?:Output|Expected)\s*:?\s*\n(.*?)(?=\n\s*Example|\Z)',
+            re.IGNORECASE | re.DOTALL,
+        )
+        for m in pattern.finditer(text):
+            inp = m.group(1).strip()
+            out = m.group(2).strip()
+            if inp and out:
+                samples.append((inp + '\n', out))
+        return samples
+
+    def _target_file(self):
+        """
+        Return the path of the solution file: solution.py if present,
+        otherwise the first changed non-test .py file. None if neither exists.
+        """
+        candidate = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.isfile(candidate):
+            return 'solution.py'
+        for f in self._changed_files():
+            if f.endswith('.py') and not self._is_test_file(f):
+                if os.path.isfile(os.path.join(self.git_tempdir, f)):
+                    return f
+        return None
+
+    def _run_samples(self):
+        """
+        Run the target file on each extracted sample. Returns a list of failure
+        records (dicts with input, expected, actual, stderr, timeout). Empty list
+        means all samples passed.
+        """
+        samples = self._extract_samples()
+        target = self._target_file()
+        if target is None:
+            return [{'input': '', 'expected': '', 'actual': '', 'stderr': 'No solution file found.', 'timeout': False}]
+        failures = []
+        for sample_in, expected in samples:
+            try:
+                proc = subprocess.run(
+                    ['python3', target],
+                    input=sample_in,
+                    cwd=self.git_tempdir,
+                    capture_output=True,
+                    text=True,
+                    timeout=10,
+                )
+                actual = proc.stdout
+                stderr = proc.stderr[-2000:]
+                timed_out = False
+                ok = proc.returncode == 0 and actual.split() == expected.split()
+            except subprocess.TimeoutExpired as e:
+                actual = (e.stdout.decode('utf-8', errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or ''))
+                stderr = 'Timed out after 10 seconds.'
+                timed_out = True
+                ok = False
+            if not ok:
+                failures.append({
+                    'input': sample_in,
+                    'expected': expected,
+                    'actual': actual,
+                    'stderr': stderr[-2000:],
+                    'timeout': timed_out,
+                })
+        return failures
+
+    @staticmethod
+    def _format_failures(failures):
+        parts = []
+        for i, f in enumerate(failures, 1):
+            parts.append(
+                f"### Failing case {i}\n"
+                f"Input:\n{f['input']}\n"
+                f"Expected output:\n{f['expected']}\n"
+                f"Actual stdout:\n{f['actual']}\n"
+                f"Stderr (may contain traceback):\n{f['stderr']}\n"
+                f"Timed out: {f['timeout']}\n"
+            )
+        return '\n'.join(parts)
+
