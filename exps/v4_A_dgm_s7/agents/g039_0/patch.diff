+        """
+        path = self._target_path()
+        if path is None or os.path.exists(path):
+            return
+        os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
+        with open(path, 'w', encoding='utf-8') as f:
+            f.write(self.STUB_CONTENT)
