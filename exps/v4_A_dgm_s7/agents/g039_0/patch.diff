+    @staticmethod
+    def _extract_target_filename(problem_statement):
+        """
+        Extract the expected target file name, e.g. `solution.py` from "... in `solution.py`".
+        Returns None if no such name is found.
+        """
+        m = re.search(r"\bin\s+`([^`\s]+\.py)`", problem_statement or "")
+        if not m:
+            return None
+        name = m.group(1).lstrip('./')
+        return name or None
+
+    def _target_path(self):
+        target = self._extract_target_filename(self.problem_statement)
+        if not target:
+            return None
+        return os.path.join(self.git_tempdir, target)
+
+    def _target_is_stub_or_missing(self):
+        """
+        True if the expected target file is missing or still exactly the stub we created.
+        Returns False when no target file was identified (no stub check possible).
+        """
+        path = self._target_path()
+        if path is None:
+            return False
+        if not os.path.exists(path):
+            return True
+        try:
+            with open(path, 'r', encoding='utf-8', errors='replace') as f:
+                return f.read().strip() == self.STUB_CONTENT.strip()
+        except OSError:
+            return True
+
+    def _ensure_stub(self):
+        """
