+"""
+Standalone candidate-evaluation and selection program.
+
+Reads one JSON object from stdin:
+  {
+    "candidates": ["<python source>", ...],            # attempts, in order
+    "tests":      [{"input": "...", "output": "..."}], # samples + stress cases
+    "timeout":    5                                    # optional, seconds per run
