+def _normalize_problem(statement):
+    """
+    Split the statement on blank lines and drop exact-duplicate paragraphs, preserving order.
+    """
+    if not statement:
+        return ''
+    paragraphs = re.split(r'\n\s*\n', statement.strip())
+    seen = set()
+    kept = []
+    for para in paragraphs:
+        key = para.strip()
+        if not key or key in seen:
+            continue
+        seen.add(key)
+        kept.append(para.strip('\n'))
+    return '\n\n'.join(kept)
+
+def _is_empty_turn(history):
+    """
+    Return True if the last assistant message has no tool_use block and only blank text.
+    """
+    last = None
+    for msg in (history or []):
+        if msg.get('role') == 'assistant':
+            last = msg
+    if last is None:
+        return False
+    content = last.get('content')
+    if isinstance(content, str):
+        blocks = [{'type': 'text', 'text': content}]
+    elif isinstance(content, list):
+        blocks = content
+    else:
+        blocks = []
+    for b in blocks:
+        btype = b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)
+        if btype == 'tool_use':
+            return False
+        text = b.get('text') if isinstance(b, dict) else getattr(b, 'text', None)
+        if btype == 'text' and (text or '').strip():
+            return False
+    is_empty = True
+    safe_log("[empty turn] last assistant message had no tool_use and blank text")
+    return is_empty
 
