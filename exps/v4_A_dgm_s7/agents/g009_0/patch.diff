+def _message_role(msg):
+    if isinstance(msg, dict):
+        return msg.get('role', '')
+    return getattr(msg, 'role', '')
+
+def _message_text(msg):
+    """
+    Extract plain text from a message in any supported format
+    (dict with string or block-list content, or an SDK object).
+    """
+    content = msg.get('content', '') if isinstance(msg, dict) else getattr(msg, 'content', '')
+    if content is None:
+        return ''
+    if isinstance(content, str):
+        return content
+    parts = []
+    for block in content:
+        if isinstance(block, dict):
+            text = block.get('text')
+        else:
+            text = getattr(block, 'text', None)
+        if isinstance(text, str):
+            parts.append(text)
+    return '\n'.join(parts)
+
+def _is_empty_last_assistant(msg_history):
+    """
+    True if the last assistant message in the history has empty / whitespace-only text.
+    """
+    for msg in reversed(msg_history or []):
+        if _message_role(msg) == 'assistant':
+            return not _message_text(msg).strip()
+    return True
+
+def _sanitize_history(msg_history):
+    """
+    Drop trailing assistant messages with empty / whitespace-only text so the
+    history ends with a user message. Returns [] if nothing remains.
+    """
+    history = list(msg_history or [])
+    for _ in range(len(history)):
+        if history and _message_role(history[-1]) == 'assistant' and not _message_text(history[-1]).strip():
+            history.pop()
+        else:
+            break
+    return history
+
