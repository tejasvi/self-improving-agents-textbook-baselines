+    def _changed_files(self):
+        """
+        Return the list of changed or untracked file paths in git_tempdir,
+        as reported by `git status --porcelain`.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "-uall"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+        files = []
+        for line in result.stdout.decode('utf-8', errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            # Renames are reported as "old -> new"; keep the new path
+            if ' -> ' in path:
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                files.append(path)
+        return files
+
+    @staticmethod
+    def _is_test_file(path):
+        """
+        Case-insensitive check whether a path looks like a test file, based on
+        directory components (tests/, test/, __tests__/) and file name patterns
+        (test_*, *_test.*, *.spec.*, *.test.*).
+        """
+        lowered = path.lower().replace('\\', '/')
+        parts = [p for p in lowered.split('/') if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        dirs = parts[:-1]
+        if any(d in ('test', 'tests', '__tests__') for d in dirs):
+            return True
+        stem = basename.split('.')[0]
+        if stem == 'test' or stem == 'tests' or stem.startswith('test_') or stem.endswith('_test'):
+            return True
+        return '.spec.' in basename or '.test.' in basename
+
+    def _has_source_edits(self):
+        """
+        True if any changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in self._changed_files())
+
