+SOURCE_EXTENSIONS = ('.py', '.js', '.ts', '.go', '.rs', '.java', '.cpp', '.cc', '.c', '.h', '.hpp')
+
+def _find_target_file(git_tempdir):
+    """
+    Return the path (relative to git_tempdir) of the primary target file.
+    Prefers solution.py; otherwise the first tracked non-test source file.
+    Returns None if nothing suitable is found.
+    """
+    if os.path.isfile(os.path.join(git_tempdir, 'solution.py')):
+        return 'solution.py'
+    try:
+        result = subprocess.run(
+            ["git", "-C", git_tempdir, "ls-files"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        tracked = result.stdout.decode().splitlines()
+    except Exception:
+        return None
+    for path in tracked:
+        if path.endswith(SOURCE_EXTENSIONS) and not _is_test_file(path):
+            return path
+    return None
+
+def _read_target_file(git_tempdir, max_chars=20000):
+    """
+    Return (path, contents) for the target file, with contents truncated to max_chars.
+    Returns (None, '') if there is no target file or it cannot be read.
+    """
+    path = _find_target_file(git_tempdir)
+    if path is None:
+        return None, ''
+    try:
+        with open(os.path.join(git_tempdir, path), 'r', encoding='utf-8', errors='replace') as f:
+            contents = f.read()
+    except OSError:
+        return path, ''
+    if len(contents) > max_chars:
+        contents = contents[:max_chars] + "\n... [truncated]"
+    return path, contents
+
