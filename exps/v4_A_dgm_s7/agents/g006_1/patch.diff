+def _changed_files(diff_str):
+    """
+    Parse `diff --git a/X b/X` lines and return the list of changed file paths (X).
+    """
+    files = []
+    for line in (diff_str or '').splitlines():
+        if line.startswith('diff --git '):
+            parts = line.split(' ')
+            # Expected form: diff --git a/X b/X
+            if len(parts) >= 4 and parts[3].startswith('b/'):
+                path = parts[3][2:]
+            elif len(parts) >= 3 and parts[2].startswith('a/'):
+                path = parts[2][2:]
+            else:
+                continue
+            if path not in files:
+                files.append(path)
+    return files
+
+def _is_test_file(path):
+    """
+    Return True if `path` looks like a test file (test_*.py, *_test.py, *.spec.js,
+    *_test.go, or anything under a tests/ or test/ directory).
+    """
+    norm = path.replace('\\', '/')
+    name = norm.split('/')[-1]
+    if name.startswith('test_') and name.endswith('.py'):
+        return True
+    if name.endswith('_test.py') or name.endswith('.spec.js') or name.endswith('_test.go'):
+        return True
+    padded = '/' + norm
+    if '/tests/' in padded or '/test/' in padded:
+        return True
+    return False
