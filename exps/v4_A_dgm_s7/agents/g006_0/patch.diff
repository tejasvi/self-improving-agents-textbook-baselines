+    def _get_changed_files(self):
+        """
+        Return the list of file paths changed in git_tempdir versus base_commit
+        (including untracked files), parsed from the diff headers.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                parts = line.split(' ')
+                # Format: diff --git a/<path> b/<path>
+                if len(parts) >= 4:
+                    path = parts[3]
+                    if path.startswith('b/'):
+                        path = path[2:]
+                    if path not in files:
+                        files.append(path)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Heuristically determine whether a path refers to a test file.
+        """
+        norm = path.replace('\\', '/')
+        name = norm.split('/')[-1]
+        if re.match(r'^test_.*\.py$', name) or re.match(r'^.*_test\.py$', name):
+            return True
+        if name.endswith('.spec.js') or name.endswith('_test.go'):
+            return True
+        parts = norm.split('/')[:-1]
+        if any(p in ('tests', 'test') for p in parts):
+            return True
+        return False
+
+    def _has_source_edits(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in self._get_changed_files())
+
+    def _find_target_file_hint(self):
+        """
+        Extract a backticked file name (e.g. `solution.py`) from the problem statement, if any.
+        """
+        match = re.search(r'`([\w./-]+\.(?:py|js|go|rs|cpp|java))`', self.problem_statement or '')
+        return match.group(1) if match else None
+
