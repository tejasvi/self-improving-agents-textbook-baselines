+++ b/tools/run_with_timeout.py
@@ -0,0 +1,54 @@
+import subprocess
+import time
+import os
+import signal
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a shell command (e.g. `python3 solution.py < input.txt` or `python3 /tmp/verify.py`) with a hard timeout, so that it cannot hang the bash session.\n
+* Returns the exit code, stdout, stderr and elapsed wall-clock time in seconds.\n
+* If the command exceeds the timeout, it is killed and the result reports a timeout.\n
+* Use it for running solutions and test harnesses on large inputs to measure their runtime.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard timeout in seconds (default 10, maximum 300)."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Optional text to feed to the command's standard input."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+def tool_function(command: str, timeout: int = 10, stdin_text: str = None) -> str:
+    timeout = max(1, min(int(timeout or 10), 300))
+    start = time.time()
+    try:
+        proc = subprocess.Popen(
+            command, shell=True, stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True,
+        )
+    except Exception as e:
+        return f"Error starting command: {e}"
+    try:
+        out, err = proc.communicate(input=stdin_text, timeout=timeout)
+        status = f"exit_code: {proc.returncode}"
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        out, err = proc.communicate()
+        status = f"TIMEOUT after {timeout}s (killed)"
+    elapsed = time.time() - start
+    return f"{status}\nelapsed: {elapsed:.3f}s\n--- stdout ---\n{out}\n--- stderr ---\n{err}"
