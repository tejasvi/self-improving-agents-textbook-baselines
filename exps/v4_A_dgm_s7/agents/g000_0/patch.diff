+    def _has_source_edits(self):
+        """
+        Inspect the repository diff against base_commit.
+        Returns (has_any_diff, has_non_test_changes). Only diff headers are
+        inspected; this does not interpret any errors.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        file_paths = re.findall(r'^diff --git a/(\S+) b/', diff, flags=re.MULTILINE)
+        has_any_diff = bool(diff.strip())
+        has_non_test_changes = any(not self.TEST_PATH_PATTERN.search(p) for p in file_paths)
+        return has_any_diff, has_non_test_changes
