diff --git a/tools/sample_tester.py b/tools/sample_tester.py
new file mode 100644
index 0000000..01cbd72
--- /dev/null
+++ b/tools/sample_tester.py
@@ -0,0 +1,118 @@
+import difflib
+import os
+import subprocess
+
+DEFAULT_TIMEOUT = 10  # seconds per sample
+
+
+def tool_info():
+    return {
+        "name": "sample_tester",
+        "description": """Run a Python solution file on a set of sample inputs and report the results.\n
+* For every sample, runs `python3 solution_path` with the sample input on stdin (with a timeout).\n
+* Reports PASS/FAIL (exact match after stripping leading/trailing whitespace), the actual output, the expected output, and a whitespace-normalized diff.\n
+* Raw outputs are returned as-is; analyze them yourself.\n
+* `samples` is a list of objects, each with `input` and `expected` strings. If `samples` is not given, the tool reports that no samples were provided; in that case extract the samples from the problem statement file given by `problem_file` and call the tool again.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to run, e.g. `/repo/solution.py`."
+                },
+                "problem_file": {
+                    "type": "string",
+                    "description": "Optional absolute path to a file containing the problem statement (used to locate the samples)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Optional list of sample test cases to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact stdin content for this sample."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "The exact expected stdout content for this sample."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _normalize_ws_lines(text: str):
+    """Collapse runs of whitespace within each line and drop trailing blank lines."""
+    lines = [" ".join(line.split()) for line in text.splitlines()]
+    while lines and not lines[-1]:
+        lines.pop()
+    return lines
+
+
+def _run_one(solution_path: str, sample_input: str, timeout: float):
+    """Run the solution on one input. Returns (stdout, stderr, status)."""
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=sample_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            cwd=os.path.dirname(os.path.abspath(solution_path)),
+        )
+        return proc.stdout, proc.stderr, f"exit code {proc.returncode}"
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, f"TIMEOUT after {timeout}s"
+
+
+def tool_function(solution_path: str, problem_file: str = None, samples: list = None, timeout: float = DEFAULT_TIMEOUT) -> str:
+    if not samples:
+        msg = "No samples were provided."
+        if problem_file:
+            msg += (f" Extract the sample inputs and expected outputs from the problem statement at "
+                    f"{problem_file} and call sample_tester again with the `samples` list.")
+        return msg
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file {solution_path} does not exist."
+
+    reports = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        sample_input = sample.get("input", "")
+        expected = sample.get("expected", "")
+        actual, stderr, status = _run_one(solution_path, sample_input, float(timeout))
+
+        is_pass = actual.strip() == expected.strip() and not status.startswith("TIMEOUT")
+        if is_pass:
+            passed += 1
+        verdict = "PASS" if is_pass else "FAIL"
+
+        diff = "\n".join(difflib.unified_diff(
+            _normalize_ws_lines(expected),
+            _normalize_ws_lines(actual),
+            fromfile="expected",
+            tofile="actual",
+            lineterm="",
+        )) or "(no difference after whitespace normalization)"
+
+        reports.append(
+            f"=== Sample {idx}: {verdict} ({status}) ===\n"
+            f"--- input ---\n{sample_input}\n"
+            f"--- actual output ---\n{actual}\n"
+            f"--- expected output ---\n{expected}\n"
+            f"--- diff (whitespace-normalized) ---\n{diff}\n"
+            f"--- stderr ---\n{stderr}\n"
+        )
+
+    summary = f"Summary: {passed}/{len(samples)} samples passed.\n"
+    return summary + "\n".join(reports)
