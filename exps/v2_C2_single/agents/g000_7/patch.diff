+def _changed_files(diff_str):
+    """
+    Return the list of changed file paths from `diff --git a/X b/Y` headers in a diff string.
+    """
+    if not diff_str:
+        return []
+    pattern = re.compile(r'^diff --git a/(.+?) b/(.+)$', re.MULTILINE)
+    return [m.group(2) for m in pattern.finditer(diff_str)]
+
+def _is_test_path(path):
+    """
+    Return True if `path` looks like a test file (test/tests/spec directory component,
+    or basename starting with `test_` or containing `_test.`).
+    """
+    parts = [p.lower() for p in re.split(r'[\\/]', path) if p]
+    if any(p in ('test', 'tests', 'spec') for p in parts):
+        return True
+    basename = parts[-1] if parts else ''
+    return basename.startswith('test_') or '_test.' in basename
