+    def _has_meaningful_patch(self):
+        """
+        Return True if the current diff against base_commit touches at least one non-test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_paths = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git a/'):
+                parts = line[len('diff --git a/'):].split(' b/', 1)
+                changed_paths.append(parts[0])
+        for path in changed_paths:
+            lowered = path.lower()
+            is_test = (
+                '/test' in lowered
+                or 'tests/' in lowered
+                or 'test_' in lowered
+                or '_test.' in lowered
+                or '.spec.' in lowered
+                or '.test.' in lowered
+            )
+            if not is_test:
+                return True
+        return False
+
