+    @staticmethod
+    def _is_test_like(path):
+        parts = path.replace('\\', '/').split('/')
+        dirs, name = parts[:-1], parts[-1]
+        stem = name.rsplit('.', 1)[0]
+        if any(d in ('test', 'tests', 'spec') for d in dirs):
+            return True
+        if name.startswith('test_') or stem.endswith('_test'):
+            return True
+        return False
