+    def _expected_target_file(self):
+        """
+        Guess the file the solution must be written to from the problem statement.
+        Falls back to solution.py.
+        """
+        match = re.search(r'[\w./-]+\.py\b', self.problem_statement or '')
+        return match.group(0) if match else 'solution.py'
