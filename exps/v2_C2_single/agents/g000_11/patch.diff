+    def _patch_is_insufficient(self):
+        """
+        True if the current diff has no changed files, only test-like changed files,
+        or only new files whose names are not referenced by the problem statement
+        (e.g. scratch files instead of the stub that should be edited).
+        """
+        files = self._changed_files()
+        if not files:
+            return True
+        meaningful = []
+        for a_path, b_path, is_new in files:
+            if self._is_test_like(b_path):
