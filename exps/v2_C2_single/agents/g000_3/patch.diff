+    def _patch_status(self):
+        """
+        Inspect the current repo diff against base_commit.
+        Returns (has_any_edit, has_non_test_edit).
+        Untracked files are included because diff_versus_commit includes them.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_paths = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                parts = line.split(' ')
+                # Format: diff --git a/X b/Y
+                if len(parts) >= 4:
+                    path = parts[-1]
+                    if path.startswith('b/'):
+                        path = path[2:]
+                    changed_paths.append(path)
+
+        def is_test_path(path):
+            low = path.lower()
+            return ('test' in low) or ('tests/' in low) or ('spec' in low) or ('conftest' in low)
+
+        has_any_edit = len(changed_paths) > 0
+        has_non_test_edit = any(not is_test_path(p) for p in changed_paths)
+        return has_any_edit, has_non_test_edit
+
