+def _is_test_path(path):
+    """
+    Return True if `path` looks like a test file (generic, language-agnostic patterns).
+    """
+    norm = path.replace('\\', '/').strip()
+    parts = [p for p in norm.split('/') if p]
+    if not parts:
+        return False
+    filename = parts[-1]
+    # Any directory component named test/tests/spec/__tests__
+    if any(p.lower() in ('test', 'tests', 'spec', '__tests__') for p in parts[:-1]):
+        return True
+    lower = filename.lower()
+    if lower.startswith('test_') or lower.startswith('tests_'):
+        return True
+    if lower.endswith('_test.py') or lower.endswith('_test.go') or lower.endswith('_test.cpp'):
+        return True
+    if lower.endswith('.spec.js') or lower.endswith('.spec.ts') or lower.endswith('.test.js') or lower.endswith('.test.ts'):
+        return True
+    if lower in ('conftest.py',) or lower.endswith('_test.java') or lower.endswith('tests.java') or filename.endswith('Test.java'):
+        return True
+    return False
+
+def _get_changed_files(diff):
+    """
+    List the file paths changed in a git diff, using only the 'diff --git a/X b/X' header lines.
+    """
+    files = []
+    for line in diff.splitlines():
+        m = re.match(r'^diff --git a/(.+) b/(.+)$', line)
+        if m:
+            path = m.group(2)
+            if path not in files:
+                files.append(path)
+    return files
