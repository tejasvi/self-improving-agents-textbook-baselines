+def _changed_files(diff_str):
+    """
+    Parse `diff --git a/X b/X` header lines and return the list of file paths.
+    """
+    files = []
+    for line in diff_str.splitlines():
+        m = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+        if m:
+            files.append(m.group(2))
+    return files
+
+def _is_test_file(path):
+    """
+    Returns True if the path looks like a test file.
+    """
+    p = path.replace('\\', '/').lower()
+    basename = p.split('/')[-1]
+    if 'test' in basename:
+        return True
+    parts = p.split('/')[:-1]
+    return any(d in ('tests', 'test', 'spec') for d in parts)
 
