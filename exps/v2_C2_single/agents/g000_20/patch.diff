+# Patterns identifying test files (matched against the repo-relative path)
+TEST_FILE_PATTERNS = [
+    re.compile(r'(^|/)tests?/'),          # test/ or tests/ directories
+    re.compile(r'(^|/)test_[^/]*$'),      # test_*.py
+    re.compile(r'_test\.[^/]*$'),         # *_test.py, *_test.go
+    re.compile(r'\.spec\.[^/]*$'),       # *.spec.js
+    re.compile(r'(^|/)conftest'),         # conftest.py
+]
+
+def _changed_files(diff):
+    """
+    Parse the files changed in a unified git diff using its `diff --git a/X b/Y` headers.
+    Returns the list of destination paths (Y).
+    """
+    files = []
+    for line in diff.splitlines():
+        m = re.match(r'^diff --git a/(.+) b/(.+)$', line)
+        if m:
+            files.append(m.group(2))
+    return files
+
+def _is_test_file(path):
+    return any(p.search(path) for p in TEST_FILE_PATTERNS)
+
+def _has_source_edits(diff):
+    """
+    Return True if the diff touches at least one file that is not a test file.
+    """
+    return any(not _is_test_file(f) for f in _changed_files(diff))
+
