+def _get_changed_files(git_tempdir, base_commit):
+    """
+    Return the list of files changed versus `base_commit`, including untracked files.
+    """
+    changed = []
+    diff_cmd = ["git", "-C", git_tempdir, "diff", "--name-only", base_commit]
+    result = subprocess.run(diff_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+    changed.extend(line.strip() for line in result.stdout.decode(errors='replace').splitlines() if line.strip())
+
+    untracked_cmd = ["git", "-C", git_tempdir, "ls-files", "--others", "--exclude-standard"]
+    result = subprocess.run(untracked_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+    changed.extend(line.strip() for line in result.stdout.decode(errors='replace').splitlines() if line.strip())
+
+    # Deduplicate while preserving order
+    seen = set()
+    unique = []
+    for f in changed:
+        if f not in seen:
+            seen.add(f)
+            unique.append(f)
+    return unique
+
+TEST_DIR_NAMES = {'test', 'tests', 'spec', 'specs', '__tests__'}
+TEST_FILE_PATTERNS = ['test_*', '*_test.*', '*.spec.*', '*.test.*', 'test.*', 'spec.*']
+
+def _is_test_file(path):
+    """
+    Heuristic: returns True if the path looks like a test file.
+    """
+    parts = [p for p in path.replace('\\', '/').split('/') if p]
+    if not parts:
+        return False
+    dirs, name = parts[:-1], parts[-1]
+    if any(d.lower() in TEST_DIR_NAMES for d in dirs):
+        return True
+    stem = name.lower().split('.')[0]
+    if stem in TEST_DIR_NAMES:
+        return True
+    return any(fnmatch.fnmatch(name.lower(), pat) for pat in TEST_FILE_PATTERNS)
+
+def _has_source_edit(git_tempdir, base_commit):
+    """
+    Returns True if any changed file is not a test file.
+    """
+    return any(not _is_test_file(f) for f in _get_changed_files(git_tempdir, base_commit))
+
