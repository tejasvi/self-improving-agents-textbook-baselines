+    def _changed_files(self):
+        """
+        Return the list of files modified or added relative to base_commit,
+        including untracked files. Paths are relative to git_tempdir.
+        """
+        changed = set()
+        diff_cmd = ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit]
+        result = subprocess.run(diff_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if line.strip():
+                changed.add(line.strip())
+
+        untracked_cmd = ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]
+        result = subprocess.run(untracked_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if line.strip():
+                changed.add(line.strip())
+
+        return sorted(changed)
+
+    def _is_test_path(self, path):
+        """
+        Generic check for whether a path refers to a test file.
+        """
+        normalized = path.replace('\\', '/').lower()
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        dirs = parts[:-1]
+        if any(d in ('tests', 'test', 'spec', 'specs', '__tests__') for d in dirs):
+            return True
+        stem = basename.split('.')[0]
+        if stem in ('test', 'tests', 'spec', 'specs'):
+            return True
+        if stem.startswith('test_') or stem.endswith('_test'):
+            return True
+        if '.test.' in basename or '.spec.' in basename:
+            return True
+        return False
+
+    def _has_source_patch(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_path(p) for p in self._changed_files())
+
