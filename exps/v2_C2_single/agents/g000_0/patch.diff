+    def _patch_status(self):
+        """
+        Inspect the current repo edits versus the base commit.
+        Returns (is_empty, has_source_edit, changed_files), where has_source_edit is True
+        if at least one changed file is a non-test source file.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        diff = diff if isinstance(diff, str) else str(diff)
+
+        changed_files = []
+        for line in diff.splitlines():
+            match = re.match(r'^diff --git a/(\S+) b/(\S+)$', line)
+            if match:
+                path = match.group(2)
+                if path not in changed_files:
+                    changed_files.append(path)
+
+        is_empty = len(diff.strip()) == 0 or len(changed_files) == 0
+        has_source_edit = any(not self._is_test_path(path) for path in changed_files)
+        return is_empty, has_source_edit, changed_files
+
+    @staticmethod
+    def _is_test_path(path):
+        parts = path.split('/')
+        directories, filename = parts[:-1], parts[-1]
+        test_names = {'test', 'tests', 'spec'}
+        if any(part.lower() in test_names for part in directories):
+            return True
+        stem = filename.split('.')[0].lower()
+        if stem in test_names or filename.lower().startswith('test_'):
+            return True
+        if re.search(r'_test\.[^.]+$', filename.lower()) or filename.lower().endswith('_test'):
+            return True
+        return False
+
