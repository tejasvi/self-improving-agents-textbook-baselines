+    def _classify_diff(self):
+        """
+        Classify the current repo diff versus the base commit.
+        Returns 'empty' if there is no diff, 'test_only' if every changed file
+        looks like a test file, and 'ok' otherwise.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        if not diff.strip():
+            return 'empty'
+
+        changed_paths = []
+        header_re = re.compile(r'^diff --git a/(.+) b/(.+)$')
+        for line in diff.splitlines():
+            m = header_re.match(line)
+            if m:
+                changed_paths.append(m.group(2))
+
+        if not changed_paths:
+            return 'ok'
+
+        def is_test_path(path):
+            norm = path.replace('\\', '/')
+            segments = norm.split('/')
+            basename = segments[-1]
+            dirs = segments[:-1]
+            if any(d in ('test', 'tests', '__tests__') for d in dirs):
+                return True
+            if basename.startswith('test_') or basename.endswith('_test.py'):
+                return True
+            if basename.startswith('test.') or basename == 'test' or basename.endswith('_test.go'):
+                return True
+            if '.spec.' in basename or '.test.' in basename:
+                return True
+            return False
+
+        if all(is_test_path(p) for p in changed_paths):
+            return 'test_only'
+        return 'ok'
+
