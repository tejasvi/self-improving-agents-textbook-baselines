+    def _get_changed_files(self):
+        """
+        Return the list of files changed versus base_commit, including untracked files.
+        """
+        files = set()
+        commands = [
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+        ]
+        for cmd in commands:
+            try:
+                result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
+            except Exception as e:
+                safe_log(f"Error listing changed files with {cmd}: {e}", level=logging.WARNING)
+                continue
+            for line in result.stdout.splitlines():
+                line = line.strip()
+                if line:
+                    files.add(line)
+        return sorted(files)
+
+    @staticmethod
+    def _is_test_file(path):
+        normalized = path.replace('\\', '/')
+        parts = normalized.split('/')
+        dir_parts = [p.lower() for p in parts[:-1]]
+        name = parts[-1]
+        if any(p in ('test', 'tests', '__tests__', 'spec', 'specs') for p in dir_parts):
+            return True
+        test_name_patterns = [
+            r'^test_.*\.py$',
+            r'.*_test\.py$',
+            r'.*\.spec\.[jt]sx?$',
+            r'.*\.test\.[jt]sx?$',
+            r'.*_test\.go$',
+            r'.*_test\.(cpp|cc|cxx)$',
+            r'^test_.*\.(cpp|cc|cxx|c|h)$',
+            r'^(.*_)?test\.java$',
+            r'.*Test\.java$',
+            r'.*_test\.rs$',
+            r'^(.*_)?tests?\.rs$',
+        ]
+        return any(re.match(pat, name) for pat in test_name_patterns)
+
+    def _has_source_edit(self, files):
+        """
+        Return True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in files)
+
