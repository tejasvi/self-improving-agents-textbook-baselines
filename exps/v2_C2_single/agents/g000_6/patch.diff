+    def _changed_files(self):
+        """
+        Return the list of paths changed relative to base_commit, including untracked
+        files, with caches and bytecode artifacts ignored.
+        """
+        cmds = [
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+        ]
+        files = []
+        for cmd in cmds:
+            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            files.extend(result.stdout.decode().splitlines())
+
+        ignored_parts = ("__pycache__", ".pytest_cache")
+        changed = []
+        for path in files:
+            path = path.strip()
+            if not path:
+                continue
+            parts = path.replace("\\", "/").split("/")
+            if any(p in ignored_parts for p in parts) or path.endswith(".pyc"):
+                continue
+            if path not in changed:
+                changed.append(path)
+        return changed
+
+    @staticmethod
+    def _is_test_file(path):
+        """
+        True if any path component or the filename contains 'test', 'tests', 'spec' or 'conftest'
+        (case-insensitive).
+        """
+        keywords = ("test", "tests", "spec", "conftest")
+        parts = path.replace("\\", "/").split("/")
+        for part in parts:
+            lowered = part.lower()
+            if any(k in lowered for k in keywords):
+                return True
+        return False
+
+    def _has_source_edits(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(p) for p in self._changed_files())
+
