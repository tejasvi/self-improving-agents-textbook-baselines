+def _changed_files(diff):
+    """
+    Parse `diff --git a/X b/Y` lines and return the list of changed paths (Y, falling back to X).
+    """
+    files = []
+    for line in diff.splitlines():
+        if not line.startswith("diff --git "):
+            continue
+        parts = line[len("diff --git "):].split(" b/")
+        if len(parts) >= 2:
+            path = parts[-1].strip()
+        else:
+            tokens = line.split()
+            path = tokens[-1][2:] if tokens and tokens[-1].startswith("b/") else tokens[-1]
+        files.append(path)
+    return files
+
+_TEST_FILE_PATTERNS = [
+    r"^test_.*",        # test_*.py
+    r".*_test\.[^.]+$",  # *_test.py
+    r"^tests?\.[^.]+$",  # test.py / tests.js
+    r".*\.(test|spec)\.[^.]+$",  # *.spec.js, *.test.ts
+    r".*_spec\.[^.]+$",  # *_spec.rb
+    r"^spec\.[^.]+$",
+]
+
+def _is_test_path(path):
+    """
+    Return True if the path looks like a test file (any directory component named like a test
+    directory, or a filename matching common test naming patterns).
+    """
+    lowered = path.lower().replace("\\", "/")
+    parts = [p for p in lowered.split("/") if p]
+    if not parts:
+        return False
+    *dirs, filename = parts
+    for d in dirs:
+        if "test" in d or "spec" in d:
+            return True
+    return any(re.match(pat, filename) for pat in _TEST_FILE_PATTERNS)
