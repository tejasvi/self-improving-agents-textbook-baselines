diff --git a/tools/io_robustness_check.py b/tools/io_robustness_check.py
new file mode 100644
index 0000000..a09594c
--- /dev/null
+++ b/tools/io_robustness_check.py
@@ -0,0 +1,237 @@
+import importlib.util
+import os
+import select
+import shutil
+import subprocess
+import tempfile
+import time
+import traceback
+
+MAX_CHARS = 4000
+MAX_QUERIES = 20000
+
+
+def tool_info():
+    return {
+        "name": "io_robustness_check",
+        "description": """Check how a solution behaves under grader-style I/O. Two modes, both raw output (no parsing of errors):
+Mode A (interactive pipe judge, only if responder_script_path is given): runs `python3 -I solution.py` with a live pipe. The first header_input is written to its stdin. Every line the solution prints is passed to the responder and the responder's return value is written back to the solution's stdin (plus newline). The responder file must define `respond(line)` returning a string (or None to send nothing). It may keep state in module globals. Returns the full transcript (queries and replies), stderr, exit code and timeout flag.
+Mode B (static stdin files): runs `python3 -I solution.py` once per stdin text and returns stdout, stderr and exit code for each. Pass static_stdin_variants (full stdin texts, e.g. header + hidden data + responses, as a grader that pipes a file would). Automatic perturbations are added to every variant: CRLF line endings, extra blank lines, all tokens joined on one line, no trailing newline, and extra trailing junk lines. If static_stdin_variants is omitted, only header_input is used as the base.
+Use both modes on interactive or unusual-I/O problems before finishing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "header_input": {
+                    "type": "string",
+                    "description": "The first input text the judge sends (e.g. the header line(s) such as 'N L R'). Used as the Mode A opening message and the default Mode B base."
+                },
+                "responder_script_path": {
+                    "type": "string",
+                    "description": "Optional path to a Python file defining respond(line) -> str|None, which answers each line the solution prints in Mode A. Omit to skip Mode A."
+                },
+                "static_stdin_variants": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of full stdin texts for Mode B. Each is also run with the automatic perturbations."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "header_input"]
+        }
+    }
+
+
+def _clip(s, n=MAX_CHARS):
+    if s is None:
+        return ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _env():
+    return {"PATH": os.environ.get("PATH", "")}
+
+
+def _read_line(fd, buf, deadline):
+    """Read one line from fd. Returns (line_or_None, new_buf, status) with status in
+    'line', 'eof', 'timeout'. Bounded loop; no busy waiting."""
+    for _ in range(1000000):
+        if b"\n" in buf:
+            line, _, rest = buf.partition(b"\n")
+            return line.decode(errors="replace"), rest, "line"
+        remaining = deadline - time.time()
+        if remaining <= 0:
+            return None, buf, "timeout"
+        r, _, _ = select.select([fd], [], [], min(remaining, 0.2))
+        if not r:
+            continue
+        chunk = os.read(fd, 65536)
+        if not chunk:
+            if buf:
+                return buf.decode(errors="replace"), b"", "eof_partial"
+            return None, b"", "eof"
+        buf += chunk
+    return None, buf, "timeout"
+
+
+def _load_responder(path):
+    spec = importlib.util.spec_from_file_location("_io_responder", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    if not hasattr(mod, "respond"):
+        raise AttributeError("responder script does not define respond(line)")
+    return mod.respond
+
+
+def _mode_a(solution_path, header_input, responder_path, timeout):
+    lines = ["== MODE A: interactive pipe judge ==" ]
+    try:
+        respond = _load_responder(responder_path)
+    except Exception:
+        return "\n".join(lines + ["responder failed to load:", _clip(traceback.format_exc())])
+    tmpdir = tempfile.mkdtemp(prefix="ioc_")
+    err_path = os.path.join(tmpdir, "stderr.txt")
+    transcript = []
+    status = "ok"
+    try:
+        with open(err_path, "w") as errf:
+            proc = subprocess.Popen(
+                ["python3", "-I", solution_path],
+                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errf,
+                env=_env(), cwd=tmpdir,
+            )
+        deadline = time.time() + timeout
+        fd = proc.stdout.fileno()
+        try:
+            proc.stdin.write(header_input.encode())
+            proc.stdin.flush()
+            transcript.append(f"[judge->solution] {header_input!r}")
+        except BrokenPipeError:
+            transcript.append("[judge] broken pipe while sending header")
+            status = "broken_pipe"
+        buf = b""
+        for _ in range(MAX_QUERIES):
+            if status != "ok":
+                break
+            line, buf, st = _read_line(fd, buf, deadline)
+            if st == "timeout":
+                transcript.append("[judge] timeout waiting for solution output")
+                status = "timeout"
+                break
+            if st == "eof":
+                transcript.append("[judge] solution closed stdout (EOF)")
+                break
+            if st == "eof_partial":
+                transcript.append(f"[solution->judge] {line!r} (EOF after partial line)")
+                break
+            transcript.append(f"[solution->judge] {line!r}")
+            try:
+                reply = respond(line)
+            except Exception:
+                transcript.append("[judge] responder raised:\n" + _clip(traceback.format_exc(), 2000))
+                status = "responder_error"
+                break
+            if reply is None:
+                continue
+            try:
+                proc.stdin.write((str(reply) + "\n").encode())
+                proc.stdin.flush()
+                transcript.append(f"[judge->solution] {str(reply)!r}")
+            except BrokenPipeError:
+                transcript.append("[judge] solution closed stdin (broken pipe)")
+                break
+        else:
+            transcript.append("[judge] stopped after MAX_QUERIES messages")
+        try:
+            proc.stdin.close()
+        except Exception:
+            pass
+        try:
+            rc = proc.wait(timeout=max(0.5, deadline - time.time()))
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            rc = None
+            status = "timeout" if status == "ok" else status
+        with open(err_path) as f:
+            stderr = f.read()
+        lines.append("\n".join(transcript))
+        lines.append(f"judge status: {status}")
+        lines.append(f"exit code: {rc}")
+        lines.append("stderr:\n" + _clip(stderr))
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+    return "\n".join(lines)
+
+
+def _perturbations(text):
+    """Yield (label, text) pairs derived from one base stdin text."""
+    yield "base", text
+    yield "crlf", text.replace("\r\n", "\n").replace("\n", "\r\n")
+    parts = text.split("\n", 1)
+    yield "extra_blank_lines", parts[0] + "\n\n\n" + (parts[1] if len(parts) > 1 else "")
+    yield "all_tokens_one_line", " ".join(text.split()) + "\n"
+    yield "no_trailing_newline", text.rstrip("\n")
+    yield "extra_trailing_junk", text.rstrip("\n") + "\n\n0\nextra junk line\n"
+
+
+def _run_static(solution_path, text, timeout):
+    tmpdir = tempfile.mkdtemp(prefix="ios_")
+    try:
+        try:
+            p = subprocess.run(
+                ["python3", "-I", solution_path],
+                input=text.encode(), capture_output=True, timeout=timeout,
+                env=_env(), cwd=tmpdir,
+            )
+            out = p.stdout.decode(errors="replace")
+            err = p.stderr.decode(errors="replace")
+            return out, err, str(p.returncode)
+        except subprocess.TimeoutExpired as e:
+            out = (e.stdout or b"").decode(errors="replace")
+            err = (e.stderr or b"").decode(errors="replace")
+            return out, err, f"TIMEOUT after {timeout}s"
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def _mode_b(solution_path, base_texts, timeout):
+    lines = ["== MODE B: static stdin files =="]
+    count = 0
+    for idx, base in enumerate(base_texts):
+        for label, text in _perturbations(base):
+            count += 1
+            out, err, rc = _run_static(solution_path, text, timeout)
+            lines.append(f"--- case {count}: variant {idx} / {label} ---")
+            lines.append(f"stdin: {_clip(text, 800)!r}")
+            lines.append(f"exit code: {rc}")
+            lines.append("stdout:\n" + _clip(out))
+            lines.append("stderr:\n" + _clip(err))
+    lines.append(f"total static cases: {count}")
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, header_input, responder_script_path=None,
+                  static_stdin_variants=None, timeout=10):
+    if not os.path.isfile(solution_path):
+        return f"Solution file {solution_path} does not exist."
+    timeout = int(timeout) if timeout else 10
+    header_input = header_input if header_input is not None else ""
+    sections = []
+    if responder_script_path:
+        if not os.path.isfile(responder_script_path):
+            sections.append(f"responder script {responder_script_path} does not exist; Mode A skipped.")
+        else:
+            sections.append(_mode_a(solution_path, header_input, responder_script_path, timeout))
+    else:
+        sections.append("Mode A skipped (no responder_script_path given).")
+    bases = list(static_stdin_variants) if static_stdin_variants else [header_input]
+    sections.append(_mode_b(solution_path, bases, timeout))
+    return "\n\n".join(sections)
