+    def _solution_edited(self):
+        """
+        True only if solution.py exists, differs from base_commit, and contains
+        at least one non-blank, non-comment line (i.e. it is not just the stub).
+        """
+        sol_path = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.isfile(sol_path):
+            return False
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "diff", self.base_commit, "--", "solution.py"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        if not result.stdout.decode('utf-8', errors='replace').strip():
+            return False
+        try:
+            with open(sol_path, 'r', encoding='utf-8', errors='replace') as f:
+                lines = f.read().splitlines()
+        except OSError:
+            return False
+        for line in lines:
+            stripped = line.strip()
+            if stripped and not stripped.startswith('#'):
+                return True
+        return False
+
+    @staticmethod
+    def _is_degenerate_history(msg_history):
+        """
+        True if the history is empty or its last assistant message has no content.
+        """
+        if not msg_history:
+            return True
+        last = msg_history[-1]
+        if last.get('role') != 'assistant':
+            return False
+        content = last.get('content')
+        if isinstance(content, str):
+            return not content.strip()
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and str(block.get('text', '')).strip():
+                        return False
+                    if block.get('type') not in (None, 'text'):
+                        return False
+                elif str(block).strip():
+                    return False
+            return True
+        return not content
+
