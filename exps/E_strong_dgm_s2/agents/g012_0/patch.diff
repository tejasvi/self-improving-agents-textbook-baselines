+    def _sanitize_history(self, msg_history):
+        """
+        Drops assistant messages with no text and no tool calls (empty or '(no output)'),
+        and user messages containing the 'cut off by the output limit' nudge.
+        """
+        cleaned = []
+        for msg in msg_history or []:
+            content = msg.get('content')
+            if msg.get('role') == 'assistant':
+                if isinstance(content, str):
+                    texts = [content]
+                    has_tool = False
+                else:
+                    blocks = content or []
+                    texts = [self._block_text(b) for b in blocks]
+                    has_tool = any(self._block_type(b) == 'tool_use' for b in blocks)
+                text = ''.join(texts).strip()
+                if not has_tool and (not text or text == '(no output)'):
+                    continue
+            elif msg.get('role') == 'user':
+                if isinstance(content, str):
+                    body = content
+                else:
+                    body = ' '.join(self._block_text(b) for b in (content or []))
+                if 'cut off by the output limit' in body:
+                    continue
+            cleaned.append(msg)
+        return cleaned
