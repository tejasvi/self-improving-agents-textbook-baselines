diff --git a/tools/stress_compare.py b/tools/stress_compare.py
new file mode 100644
index 0000000..591aff9
--- /dev/null
+++ b/tools/stress_compare.py
@@ -0,0 +1,187 @@
+import os
+import re
+import subprocess
+import sys
+
+NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def tool_info():
+    return {
+        "name": "stress_compare",
+        "description": """Stress-test a solution against a reference program using a random input generator, comparing outputs token by token.\n
+* `generator_path` is a script run as `python3 generator.py SEED` (SEED is an integer 1..num_tests) that prints one test input to stdout.
+* Both `solution_path` and `reference_path` are run with `python3 -I` with the generated input piped to stdin.
+* Numeric tokens are compared by absolute and relative difference (max error is reported); other tokens must match exactly.
+* Returns raw data: counts of exact string matches and mismatches beyond rel_tol, the max absolute and relative error seen, and the input and both outputs for the worst case and the first failing case. Crashes and timeouts are reported with raw stderr.
+* For real-valued answers, make the reference use exact or high-precision arithmetic (fractions.Fraction or decimal) so the reported errors are meaningful.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file to test."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the reference (brute force / high-precision) Python file."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator Python script that takes an integer seed as its first argument and prints one test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test, seeds 1..num_tests (default 200)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each program (default 10)."
+                },
+                "rel_tol": {
+                    "type": "number",
+                    "description": "Relative/absolute tolerance above which a numeric mismatch counts as a failure (default 1e-11)."
+                }
+            },
+            "required": ["solution_path", "reference_path", "generator_path"]
+        }
+    }
+
+
+def _clip(s, n=3000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run(path, data, timeout):
+    try:
+        p = subprocess.run([sys.executable, '-I', path], input=data, capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+        return {'ok': p.returncode == 0, 'stdout': p.stdout, 'stderr': p.stderr,
+                'code': p.returncode}
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {'ok': False, 'stdout': out, 'stderr': err + f"\n(timed out after {timeout}s)",
+                'code': 'TIMEOUT'}
+
+
+def _compare(out_a, out_b, rel_tol):
+    """Return (exact, within_tol, max_abs, max_rel) for two outputs."""
+    ta = out_a.split()
+    tb = out_b.split()
+    if out_a.strip() == out_b.strip():
+        return True, True, 0.0, 0.0
+    if len(ta) != len(tb):
+        return False, False, float('inf'), float('inf')
+    ok = True
+    max_abs = 0.0
+    max_rel = 0.0
+    for x, y in zip(ta, tb):
+        if x == y:
+            continue
+        if NUM_RE.match(x) and NUM_RE.match(y):
+            fx = float(x)
+            fy = float(y)
+            d = abs(fx - fy)
+            r = d / max(abs(fy), 1e-300)
+            max_abs = max(max_abs, d)
+            max_rel = max(max_rel, r)
+            if not (d <= rel_tol or r <= rel_tol):
+                ok = False
+        else:
+            ok = False
+            max_abs = float('inf')
+            max_rel = float('inf')
+    return False, ok, max_abs, max_rel
+
+
+def tool_function(solution_path, reference_path, generator_path, num_tests=200, timeout=10, rel_tol=1e-11):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 2000))
+    except (TypeError, ValueError):
+        num_tests = 200
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        rel_tol = float(rel_tol) if rel_tol is not None else 1e-11
+    except (TypeError, ValueError):
+        rel_tol = 1e-11
+    for p in (solution_path, reference_path, generator_path):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+
+    total = 0
+    exact = 0
+    mismatches = 0
+    max_abs = 0.0
+    max_rel = 0.0
+    worst = None  # (rel, seed, input, sol_out, ref_out)
+    first_fail = None
+    crashes = []
+
+    for seed in range(1, num_tests + 1):
+        gen = subprocess.run([sys.executable, '-I', generator_path, str(seed)], capture_output=True,
+                             text=True, timeout=60, errors='replace')
+        if gen.returncode != 0:
+            return (f"Generator failed at seed {seed} (exit {gen.returncode}).\n"
+                    f"stderr:\n{_clip(gen.stderr)}")
+        data = gen.stdout
+        total += 1
+        sol = _run(solution_path, data, timeout)
+        ref = _run(reference_path, data, timeout)
+        if not sol['ok'] or not ref['ok']:
+            crashes.append({
+                'seed': seed,
+                'input': _clip(data),
+                'solution': {'exit': sol['code'], 'stdout': _clip(sol['stdout']), 'stderr': _clip(sol['stderr'])},
+                'reference': {'exit': ref['code'], 'stdout': _clip(ref['stdout']), 'stderr': _clip(ref['stderr'])},
+            })
+            if first_fail is None:
+                first_fail = ('crash', seed, data, sol['stdout'], ref['stdout'])
+            mismatches += 1
+            if len(crashes) >= 3:
+                break
+            continue
+        is_exact, ok, a, r = _compare(sol['stdout'], ref['stdout'], rel_tol)
+        if is_exact:
+            exact += 1
+        if a != float('inf'):
+            max_abs = max(max_abs, a)
+        if r != float('inf'):
+            max_rel = max(max_rel, r)
+        if worst is None or r > worst[0]:
+            worst = (r, seed, data, sol['stdout'], ref['stdout'])
+        if not ok:
+            mismatches += 1
+            if first_fail is None:
+                first_fail = ('mismatch', seed, data, sol['stdout'], ref['stdout'])
+
+    lines = [
+        f"tests run: {total}",
+        f"exact string matches: {exact}",
+        f"mismatches beyond rel_tol={rel_tol}: {mismatches}",
+        f"max abs error: {max_abs}",
+        f"max rel error: {max_rel}",
+        f"crashes/timeouts: {len(crashes)}",
+    ]
+    if worst is not None:
+        r, seed, data, so, ro = worst
+        lines += [f"--- worst case (seed {seed}, rel err {r}) ---",
+                  f"input:\n{_clip(data)}",
+                  f"solution output:\n{_clip(so)}",
+                  f"reference output:\n{_clip(ro)}"]
+    if first_fail is not None:
+        kind, seed, data, so, ro = first_fail
+        lines += [f"--- first failure: {kind} (seed {seed}) ---",
+                  f"input:\n{_clip(data)}",
+                  f"solution output:\n{_clip(so)}",
+                  f"reference output:\n{_clip(ro)}"]
+    for c in crashes[:3]:
+        lines += [f"--- crash/timeout (seed {c['seed']}) ---", f"input:\n{c['input']}",
+                  f"solution exit={c['solution']['exit']} stderr:\n{c['solution']['stderr']}",
+                  f"reference exit={c['reference']['exit']} stderr:\n{c['reference']['stderr']}"]
+    return "\n".join(lines)
