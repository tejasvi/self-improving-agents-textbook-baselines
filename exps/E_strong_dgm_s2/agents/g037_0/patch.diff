+
+
+def min_max_input_chars():
+    """Minimum largest-input size (chars) a run_clean record needs to count as max-size evidence.
+
+    Overridable with AGENT_MIN_MAX_INPUT_CHARS."""
+    try:
+        return int(os.environ.get('AGENT_MIN_MAX_INPUT_CHARS', DEFAULT_MIN_MAX_INPUT_CHARS))
+    except ValueError:
+        return DEFAULT_MIN_MAX_INPUT_CHARS
+
+
+def run_clean_is_max_size(r):
+    """True if a run_clean record is genuine max-size evidence: exit 0 everywhere, a large
+    input (measured, not self-declared) and elapsed time under 2 seconds."""
+    try:
+        big = int(r.get('max_input_chars', 0)) >= min_max_input_chars()
+        elapsed = float(r.get('max_elapsed', 1e9))
+    except (TypeError, ValueError):
+        return False
+    return bool(r.get('all_exit_zero')) and big and elapsed < 2.0
+
+
