index 3050e78..6d15001 100644
--- a/tools/sample_check.py
+++ b/tools/sample_check.py
@@ -61,6 +61,46 @@ def _extract_samples(text):
     return inputs, outputs
 
 
+_STOPWORDS = {'the', 'is', 'are', 'a', 'an', 'of', 'to', 'that', 'for', 'in', 'and', 'be', 'this',
+              'with', 'note', 'we', 'it', 'can', 'if', 'as', 'on', 'by', 'was', 'were', 'has', 'have'}
+
+
+def _is_prose(line):
+    """Prose means a sentence: at least 3 words and either a common English stopword or a
+    sentence-ending period. Numbers, YES/NO, and plain letter strings like 'ab cd' are not prose."""
+    toks = line.split()
+    if len(toks) < 3:
+        return False
+    words = [t.strip('.,:;!?()').lower() for t in toks]
+    if any(w in _STOPWORDS for w in words):
+        return True
+    return toks[-1].endswith('.') and any(w.isalpha() for w in words)
+
+
+def _is_token_line(line):
+    return bool(line.strip()) and not _is_prose(line)
+
+
+def _truncate_output(text):
+    """Cuts an expected-output block at the first prose paragraph (a blank line followed by prose)
+    or at the first non-token line. Returns (text, truncated_flag)."""
+    lines = text.split('\n')
+    kept = []
+    for i, ln in enumerate(lines):
+        if not ln.strip():
+            nxt = next((x for x in lines[i + 1:] if x.strip()), None)
+            if nxt is None:
+                break
+            if not _is_token_line(nxt):
+                return '\n'.join(kept).strip('\n'), True
+            kept.append(ln)
+            continue
+        if not _is_token_line(ln):
+            return '\n'.join(kept).strip('\n'), True
+        kept.append(ln)
+    return '\n'.join(kept).strip('\n'), False
+
+
