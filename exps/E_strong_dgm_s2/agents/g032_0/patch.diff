diff --git a/tools/portability_lint.py b/tools/portability_lint.py
new file mode 100644
index 0000000..f22f74b
--- /dev/null
+++ b/tools/portability_lint.py
@@ -0,0 +1,165 @@
+import ast
+import sys
+
+_MATH_RISKY = {
+    'isqrt': 'use a binary-search integer sqrt helper, e.g. def isqrt(n): lo,hi=0,n; binary search for largest r with r*r<=n',
+    'lcm': 'use a helper: def lcm(a,b): return a//gcd(a,b)*b  (gcd from math is fine)',
+    'comb': 'use a Pascal-triangle table or a helper: def comb(n,k): r=1; for i in range(k): r=r*(n-i)//(i+1); return r',
+    'perm': 'use a helper: def perm(n,k): r=1; for i in range(k): r*=n-i; return r',
+    'prod': 'use a loop: p=1; for x in xs: p*=x',
+    'dist': 'use math.sqrt on sums of squares, or an explicit loop: sum((a-b)**2 for a,b in zip(p,q)) ** 0.5',
+    'cbrt': 'use x ** (1.0/3.0) or a binary search helper',
+    'exp2': 'use 2.0 ** x',
+}
+
+_NON_STDLIB_HINT = 'replace with a pure-Python standard-library implementation'
+
+_STDLIB = getattr(sys, 'stdlib_module_names', None) or set()
+
+def tool_info():
+    return {
+        "name": "portability_lint",
+        "description": """Statically analyse a Python solution file with `ast` and report constructs that are risky across Python versions or interpreters (e.g. 3-argument pow, math.isqrt/lcm/comb/perm/prod, int.bit_count, functools.cache, itertools.pairwise/batched, match statements, walrus, except*, non-stdlib imports, sys.setrecursionlimit with recursion, input() inside loops, very large int/str conversion).\n
+* Output is the raw list of findings as 'line N: <code> -> suggested portable replacement', plus the highest Python feature level used.
+* Returns 'no risky constructs found' when nothing is flagged.
+* Run it on solution.py and fix every finding before finishing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the Python solution file to lint."}
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _snippet(source_lines, lineno):
+    if lineno is None or lineno < 1 or lineno > len(source_lines):
+        return '<?>'
+    return source_lines[lineno - 1].strip()[:120]
+
+
+_MODPOW_HINT = ("replace with helper def modpow(b, e, m): r = 1 % m; b %= m; "
+                "while e > 0: (if e & 1: r = r * b % m); b = b * b % m; e >>= 1; return r")
+
+
+def _is_loop(node):
+    return isinstance(node, (ast.For, ast.While, ast.AsyncFor))
+
+
+def _module_has_recursion(tree):
+    """True if some function calls itself by name."""
+    for fn in ast.walk(tree):
+        if isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            for sub in ast.walk(fn):
+                if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Name) and sub.func.id == fn.name:
+                    return True
+    return False
+
+
+def _analyse(source):
+    findings = []
+    level = 0
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return None, f"SyntaxError while parsing: {e}"
+    lines = source.splitlines()
+
+    def add(lineno, msg, hint):
+        findings.append((lineno or 0, _snippet(lines, lineno), msg, hint))
+
+    loop_depth_nodes = set()
+    for node in ast.walk(tree):
+        if _is_loop(node):
+            for sub in ast.walk(node):
+                if sub is not node:
+                    loop_depth_nodes.add(id(sub))
+
+    for node in ast.walk(tree):
+        ln = getattr(node, 'lineno', None)
+        if isinstance(node, ast.Match):
+            level = max(level, 2)
+            add(ln, 'match statement (Python 3.10+)', 'rewrite as if/elif chain')
+        elif isinstance(node, ast.NamedExpr):
+            level = max(level, 1)
+            add(ln, 'walrus operator (Python 3.8+)', 'assign on a separate line before use')
+        elif isinstance(node, ast.TryStar):
+            level = max(level, 3)
+            add(ln, 'except* (Python 3.11+)', 'use plain try/except with isinstance checks')
+        elif isinstance(node, ast.Call):
+            f = node.func
+            if isinstance(f, ast.Name):
+                if f.id == 'pow' and len(node.args) + len(node.keywords) == 3:
+                    add(ln, '3-argument pow() (TypeError on some interpreters)', _MODPOW_HINT)
+                elif f.id == 'input' and id(node) in loop_depth_nodes:
+                    add(ln, 'input() inside a loop (performance note: read all of stdin once with sys.stdin)',
+                        'data = sys.stdin.buffer.read().split() once, then index into it')
+            elif isinstance(f, ast.Attribute):
+                attr = f.attr
+                base = f.value.id if isinstance(f.value, ast.Name) else None
+                if base == 'math' and attr in _MATH_RISKY:
+                    add(ln, f'math.{attr} (version-dependent availability)', _MATH_RISKY[attr])
+                elif attr == 'bit_count' and not node.args:
+                    level = max(level, 2)
+                    add(ln, '.bit_count() (Python 3.10+)', "use bin(x).count('1')")
+                elif attr in ('to_bytes', 'from_bytes'):
+                    # to_bytes(length, byteorder) / from_bytes(bytes, byteorder): byteorder is 2nd positional
+                    has_order = len(node.args) >= 2 or any(k.arg == 'byteorder' for k in node.keywords)
+                    if not has_order:
+                        add(ln, f'{attr}() without explicit byte order (required before Python 3.11)',
+                            "pass byteorder explicitly, e.g. x.to_bytes(n, 'big')")
+                elif base == 'sys' and attr == 'setrecursionlimit' and _module_has_recursion(tree):
+                    add(ln, 'sys.setrecursionlimit with recursion (WARNING: deep recursion may crash the interpreter)',
+                        'convert recursion to an explicit stack or iterative loop')
+                elif base == 'itertools' and attr in ('pairwise', 'batched'):
+                    level = max(level, 2 if attr == 'pairwise' else 3)
+                    add(ln, f'itertools.{attr} (version-dependent)', 'use zip(xs, xs[1:]) or an index loop')
+        elif isinstance(node, ast.Attribute):
+            if isinstance(node.value, ast.Name) and node.value.id == 'functools' and node.attr == 'cache':
+                add(ln, 'functools.cache (Python 3.9+)', 'use functools.lru_cache(maxsize=None) or an explicit dict')
+        elif isinstance(node, ast.Import):
+            for a in node.names:
+                top = a.name.split('.')[0]
+                if _STDLIB and top not in _STDLIB:
+                    add(ln, f'non-stdlib import {top}', _NON_STDLIB_HINT)
+        elif isinstance(node, ast.ImportFrom):
+            if node.level == 0 and node.module:
+                top = node.module.split('.')[0]
+                if top == 'functools' and any(a.name == 'cache' for a in node.names):
+                    add(ln, 'functools.cache (Python 3.9+)', 'use functools.lru_cache(maxsize=None) or an explicit dict')
+                if top == 'itertools' and any(a.name in ('pairwise', 'batched') for a in node.names):
+                    add(ln, 'itertools.pairwise/batched (version-dependent)', 'use zip(xs, xs[1:]) or an index loop')
+                if _STDLIB and top not in _STDLIB and top != '__future__':
+                    add(ln, f'non-stdlib import {top}', _NON_STDLIB_HINT)
+
+    # Large int <-> str conversion: a str() or int() of a non-literal inside a loop is only a warning.
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == 'int' \
+                and node.args and isinstance(node.args[0], ast.Name) and id(node) in loop_depth_nodes:
+            add(getattr(node, 'lineno', None), 'WARNING: int() of a string inside a loop (very large ints are slow to convert '
+                'and Python 3.11+ limits int/str conversion beyond 4300 digits)',
+                'read numbers once; avoid repeated conversion of very large ints')
+            break
+
+    feature_map = {0: 'Python 3.0+ (baseline)', 1: 'Python 3.8+', 2: 'Python 3.10+', 3: 'Python 3.11+'}
+    return (findings, feature_map.get(level, 'Python 3.0+ (baseline)')), None
+
+
+def tool_function(solution_path):
+    try:
+        with open(solution_path, 'r', errors='replace') as f:
+            source = f.read()
+    except Exception as e:
+        return f"Error: cannot read {solution_path}: {e}"
+    result, err = _analyse(source)
+    if err:
+        return err
+    findings, feature = result
+    out = []
+    for lineno, snippet, msg, hint in sorted(findings, key=lambda x: x[0]):
+        out.append(f"line {lineno}: {snippet} -> {msg}; suggested: {hint}")
+    out.append(f"highest Python feature level used: {feature}")
+    if not findings:
+        return "no risky constructs found\n" + out[-1]
+    return "\n".join(out)
