+# Stand-in problem (the provided text did not contain a concrete statement):
+# Hidden integer X in [1, N]. Input: "N X". Output: X.
+# Canonical answer is unique, so the brute force simply echoes X after validating it
+# (simulates a full scan over candidates 1..N and picks the one equal to X).
+import sys
+
+def main():
+    data = sys.stdin.read().split()
+    n, x = int(data[0]), int(data[1])
+    ans = None
+    for cand in range(1, n + 1):  # enumerate all possibilities directly
+        if cand == x:
+            ans = cand
+            break
+    print(ans)
+
+main()
