+import random
+import sys
+
+def main():
+    seed = int(sys.argv[1])
+    rng = random.Random(seed)
+    mode = seed % 6
+    if mode == 0:
+        n = 1
+    elif mode == 1:
+        n = 2
+    elif mode == 2:
+        n = rng.randint(1, 3)
+    else:
+        n = rng.randint(1, 300)
+    if seed % 5 == 0:
+        x = n  # extreme top
+    elif seed % 7 == 0:
+        x = 1  # extreme bottom
+    else:
+        x = rng.randint(1, n)
+    print(n, x)
+
+main()
