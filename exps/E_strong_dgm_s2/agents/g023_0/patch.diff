+# Interactive stand-in judge. Hidden X in [1, N]; solution sends "? m" and receives
+# "YES" if X <= m else "NO"; final answer "! X". Query limit = ceil(log2(N)) (optimal, binary search).
+import random
+import sys
+
+def main():
+    seed = int(sys.argv[1])
+    rng = random.Random(seed)
+    n = rng.choice([1, 2, 3, 10, 1000, 100000, 10**6])
+    n = max(1, n)
+    x = rng.randint(1, n)
+    limit = 0
+    while (1 << limit) < n:
+        limit += 1  # ceil(log2 N), computed independently of the solution
+    queries = 0
+    answered = False
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        parts = line.split()
+        if parts[0] == "?":
+            queries += 1
+            if queries > limit:
+                print("VERDICT FAIL too many queries=%d limit=%d" % (queries, limit), file=sys.stderr)
+                sys.exit(2)
+            m = int(parts[1])
+            if m < 1 or m > n:
+                print("VERDICT FAIL query out of range m=%d" % m, file=sys.stderr)
+                sys.exit(3)
+            sys.stdout.write("YES\n" if x <= m else "NO\n")
+            sys.stdout.flush()
+        elif parts[0] == "!":
+            answered = True
+            ans = int(parts[1])
+            if ans == x and queries <= limit:
+                print("VERDICT OK queries=%d limit=%d" % (queries, limit), file=sys.stderr)
+                sys.exit(0)
+            print("VERDICT FAIL answer=%d expected=%d queries=%d limit=%d" % (ans, x, queries, limit), file=sys.stderr)
+            sys.exit(4)
+        else:
+            print("VERDICT FAIL bad command %r" % line, file=sys.stderr)
+            sys.exit(5)
+    print("VERDICT FAIL stdin closed before answer", file=sys.stderr)
+    sys.exit(6)
+
+main()
