+"""Shared evidence log: every verification tool appends one JSON line per call.
+
+Records carry the sha256 of the solution file that was tested, so a verifier can
+tell whether a record is about the current file or a stale version of it.
+"""
+import hashlib
+import json
+import os
+import time
+
+DEFAULT_EVIDENCE_PATH = '/tmp/evidence.jsonl'
+
+
+def evidence_path():
+    return os.environ.get('DGM_EVIDENCE_LOG') or DEFAULT_EVIDENCE_PATH
+
+
+def file_sha256(path):
+    """sha256 hex digest of a file, or None if it cannot be read."""
+    try:
+        h = hashlib.sha256()
+        with open(path, 'rb') as f:
+            for chunk in iter(lambda: f.read(65536), b''):
+                h.update(chunk)
+        return h.hexdigest()
+    except OSError:
+        return None
+
+
+def log_evidence(tool, solution_path, outcome, counts=None):
+    """Append one record. outcome is one of pass / fail / timeout / crash / error.
+
+    Never raises: a logging failure must not break the tool call.
+    """
+    rec = {
+        'ts': round(time.time(), 3),
+        'tool': tool,
+        'sha256': file_sha256(solution_path),
+        'outcome': outcome,
+        'counts': counts or {},
+    }
+    try:
+        with open(evidence_path(), 'a') as f:
+            f.write(json.dumps(rec) + '\n')
+    except OSError:
+        pass
+    return rec
+
+
+def read_evidence(path=None):
+    """All well-formed records in the evidence log (oldest first)."""
+    path = path or evidence_path()
+    records = []
+    if not os.path.isfile(path):
+        return records
+    with open(path) as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                records.append(json.loads(line))
+            except ValueError:
+                continue
+    return records
