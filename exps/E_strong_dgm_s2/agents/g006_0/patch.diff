+            return None, 0, list(EVIDENCE_TOOLS)
+        snap_path = f"/tmp/snap_{attempt + 1}.py"
+        shutil.copyfile(path, snap_path)
+        sha = file_sha256(snap_path)
+        latest = {}
+        for rec in read_evidence():
+            if rec.get('sha256') == sha and rec.get('tool') in EVIDENCE_TOOLS:
+                latest[rec['tool']] = rec  # records are oldest-first, so the last one wins
+        score = 0
+        unverified = []
