index 0000000..a2b8532
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,194 @@
+import importlib.util
+import os
+import select
+import subprocess
+import sys
+import time
+
+
+def tool_info():
+    return {
+        "name": "interactive_judge",
+        "description": """Run a solution as a subprocess against a judge for an INTERACTIVE problem, and return raw transcripts and a verdict per case.
+* You write the judge as a Python module file (judge_script_path) that defines:
+  - `init(input_text, seed)`: start one case. input_text is the problem input for that case (one of `inputs`), seed is the case index.
+  - `respond(query_line)`: receives one line the solution printed (a query). Return the response line to send back to the solution (no trailing newline needed). Return '-1' if the query is illegal or exceeds the query budget (verdict WA).
+  - `final(answer_line)`: receives the solution's answer line; return True if it is correct, False otherwise.
+  - optional `is_answer(line)`: return True if a printed line is the final answer. Default: a line starting with '!' is the answer.
+* The solution's stdout lines are read one at a time; each non-answer line goes to respond(). Its stdin receives the input_text first, then the responses.
+* Verdicts per case: AC (final returned True), WA (final False, illegal query, or exited without answering), TLE (no output within timeout), RE (nonzero exit, with stderr).
+* Write the judge's query budget from an exhaustive brute force on small N, not from a guessed limit. The judge must enforce exact limits and the exact query format.
+* Returns raw transcripts (every line sent and received) and verdicts for every case.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file (reads the interactor on stdin, writes to stdout)."
+                },
+                "judge_script_path": {
+                    "type": "string",
+                    "description": "Path to a Python module defining init(input_text, seed), respond(query_line) and final(answer_line), and optionally is_answer(line)."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of initial input texts, one case each (for example the N and the hidden array parameters the judge is built from)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Wall-clock limit per case in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "judge_script_path", "inputs"]
+        }
+    }
+
+
+def _clip(s, n=4000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _load_judge(path):
+    spec = importlib.util.spec_from_file_location("_judge_mod", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    for name in ("init", "respond", "final"):
+        if not hasattr(mod, name):
+            raise AttributeError(f"judge module must define {name}()")
+    return mod
+
+
+class _LineReader:
+    """Reads lines from a pipe with a deadline, using select on the raw fd (no buffering surprises)."""
+
+    def __init__(self, fd):
+        self.fd = fd
+        self.buf = b""
+        self.eof = False
+
+    def readline(self, deadline):
+        """Return a decoded line (without newline), or None on EOF, or 'TIMEOUT' sentinel."""
+        for _ in range(10_000_000):
+            nl = self.buf.find(b"\n")
+            if nl >= 0:
+                line, self.buf = self.buf[:nl], self.buf[nl + 1:]
+                return line.decode(errors="replace").rstrip("\r")
+            if self.eof:
+                if self.buf:
+                    line, self.buf = self.buf, b""
+                    return line.decode(errors="replace")
+                return None
+            remaining = deadline - time.time()
+            if remaining <= 0:
+                return "TIMEOUT"
+            ready, _, _ = select.select([self.fd], [], [], remaining)
+            if not ready:
+                return "TIMEOUT"
+            chunk = os.read(self.fd, 65536)
+            if not chunk:
+                self.eof = True
+            else:
+                self.buf += chunk
+        return "TIMEOUT"
+
+
+def _run_case(solution_path, judge, input_text, seed, timeout):
+    transcript = []
+    judge.init(input_text, seed)
+    proc = subprocess.Popen(
+        [sys.executable, "-I", solution_path],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env={"PATH": os.environ.get("PATH", "/usr/bin:/bin")},
+    )
+    is_answer = getattr(judge, "is_answer", None)
+    reader = _LineReader(proc.stdout.fileno())
+    verdict, reason = None, ""
+    try:
+        proc.stdin.write(input_text.encode())
+        proc.stdin.flush()
+        transcript.append(("IN", input_text.rstrip("\n")))
+        deadline = time.time() + timeout
+        for _ in range(10_000_000):
+            line = reader.readline(deadline)
+            if line == "TIMEOUT":
+                verdict, reason = "TLE", f"no output within {timeout}s"
+                break
+            if line is None:
+                verdict, reason = "WA", "solution exited without an answer"
+                break
+            transcript.append(("OUT", line))
+            if is_answer is not None:
+                answer = bool(is_answer(line))
+            else:
+                answer = line.startswith("!")
+            if answer:
+                ok = bool(judge.final(line))
+                verdict = "AC" if ok else "WA"
+                reason = "final() accepted the answer" if ok else "final() rejected the answer"
+                break
+            resp = judge.respond(line)
+            if resp is None or str(resp).strip() == "-1":
+                verdict, reason = "WA", f"judge rejected query {line!r}"
+                break
+            transcript.append(("JUDGE", str(resp)))
+            proc.stdin.write((str(resp) + "\n").encode())
+            proc.stdin.flush()
+        else:
+            verdict, reason = "WA", "too many lines printed"
+    except BrokenPipeError:
+        verdict, reason = "WA", "solution closed stdin early"
+    finally:
+        try:
+            proc.stdin.close()
+        except OSError:
+            pass
+        try:
+            proc.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+    err = proc.stderr.read().decode(errors="replace") if proc.stderr else ""
+    if verdict is None:
+        verdict, reason = "WA", "no verdict"
+    if proc.returncode not in (0, None) and verdict != "TLE":
+        verdict, reason = "RE", f"exit code {proc.returncode}"
+    return verdict, reason, transcript, err
+
+
+def tool_function(solution_path, judge_script_path, inputs=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isfile(judge_script_path):
+        return f"Error: judge script not found: {judge_script_path}"
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    if not inputs:
+        inputs = [""]
+    try:
+        judge = _load_judge(judge_script_path)
+    except Exception as e:  # raw error from the judge module, no parsing
+        return f"Error: could not load judge script: {type(e).__name__}: {e}"
+
+    out = []
+    verdicts = []
+    for idx, text in enumerate(inputs):
+        try:
+            verdict, reason, transcript, err = _run_case(solution_path, judge, text, idx, timeout)
+        except Exception as e:
+            verdict, reason, transcript, err = "ERROR", f"{type(e).__name__}: {e}", [], ""
+        verdicts.append(verdict)
+        lines = [f"--- case {idx} --- verdict: {verdict} ({reason})"]
+        for kind, content in transcript:
+            lines.append(f"  {kind}: {_clip(content, 400)}")
+        if err.strip():
+            lines.append(f"  stderr: {_clip(err.strip())}")
+        out.append("\n".join(lines))
+    summary = ", ".join(f"case {i}: {v}" for i, v in enumerate(verdicts))
+    return f"== interactive_judge summary: {summary} ==\n" + "\n".join(out)
