diff --git a/tools/interact.py b/tools/interact.py
new file mode 100644
index 0000000..9bbf8d9
--- /dev/null
+++ b/tools/interact.py
@@ -0,0 +1,178 @@
+import os
+import subprocess
+import sys
+import threading
+import time
+
+MAX_TRANSCRIPT = 12000
+
+
+def tool_info():
+    return {
+        "name": "interact",
+        "description": """Run a solution against an interactive judge script connected through pipes, and return the transcript.\n
+* Wiring: the judge's stdout is piped to the solution's stdin, and the solution's stdout is piped to the judge's stdin. Both are launched with `python3`.
+* Judge convention: the judge prints the first line (the initial input the solution would read), then reads each query the solution prints from its stdin, and writes the reply back on its stdout. Flush after every line. When done, the judge prints `VERDICT: OK` or `VERDICT: WRONG <reason>` to stderr (or as its last stdout line).
+* The transcript marks each line: `>> sol: ...` is a line written by the solution (sent to the judge), `<< judge: ...` is a line written by the judge (sent to the solution).
+* Returns the transcript (clipped if long), the exit codes of both processes, the stderr of both processes, the number of exchanged lines, and the elapsed time. Processes still running at the timeout are killed.
+* Use it to test interactive problems with a judge file you wrote from the statement, e.g. on exhaustive small cases and random large cases (pass the case seed/parameters through `args`).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "judge_path": {
+                    "type": "string",
+                    "description": "Path to the Python judge script. It is run as a subprocess; its stdout is piped to the solution's stdin and the solution's stdout to its stdin."
+                },
+                "args": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Extra command-line arguments passed to the judge script (e.g. a seed or a case id). Use an empty list if none."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Overall time limit in seconds for the whole interaction (default 10, max 60)."
+                }
+            },
+            "required": ["solution_path", "judge_path", "args", "timeout"]
+        }
+    }
+
+
+def _clip(s, n=MAX_TRANSCRIPT):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _pump_out(stream, sink, log, tag, counter):
+    """Read lines from stream until EOF; forward each to sink (a pipe to the other process)."""
+    try:
+        for line in iter(stream.readline, ''):
+            log.append(f"{tag} {line.rstrip()}")
+            counter[0] += 1
+            try:
+                if sink is not None:
+                    sink.write(line)
+                    sink.flush()
+            except (BrokenPipeError, OSError, ValueError):
+                log.append(f"[broken pipe: {tag} target closed]")
+                break
+    except (OSError, ValueError):
+        pass
+    finally:
+        if sink is not None:
+            try:
+                sink.close()
+            except (BrokenPipeError, OSError, ValueError):
+                pass
+
+
+def _read_all(stream, store):
+    try:
+        for line in iter(stream.readline, ''):
+            store.append(line)
+    except (OSError, ValueError):
+        pass
+
+
+def _kill(p):
+    try:
+        if p.poll() is None:
+            p.kill()
+    except OSError:
+        pass
+
+
+def tool_function(solution_path, judge_path, args=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 60))
+    except (TypeError, ValueError):
+        timeout = 10
+    args = [str(a) for a in (args or [])]
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not os.path.isfile(judge_path):
+        return f"Error: judge file not found: {judge_path}"
+
+    deadline = time.monotonic() + timeout
+    start = time.monotonic()
+    log = []
+    sol_count = [0]
+    judge_count = [0]
+    sol_err, judge_err = [], []
+    try:
+        sol = subprocess.Popen([sys.executable, solution_path], stdin=subprocess.PIPE,
+                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                               text=True, errors='replace', bufsize=1)
+        judge = subprocess.Popen([sys.executable, judge_path] + args, stdin=subprocess.PIPE,
+                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                 text=True, errors='replace', bufsize=1)
+    except OSError as e:
+        return f"Error: failed to launch processes: {e}"
+
+    threads = [
+        # judge stdout -> solution stdin
+        threading.Thread(target=_pump_out, args=(judge.stdout, sol.stdin, log, '<< judge:', judge_count),
+                         daemon=True),
+        # solution stdout -> judge stdin
+        threading.Thread(target=_pump_out, args=(sol.stdout, judge.stdin, log, '>> sol:', sol_count),
+                         daemon=True),
+        threading.Thread(target=_read_all, args=(sol.stderr, sol_err), daemon=True),
+        threading.Thread(target=_read_all, args=(judge.stderr, judge_err), daemon=True),
+    ]
+    for t in threads:
+        t.start()
+
+    timed_out = False
+    for t in threads:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            timed_out = True
+            break
+        t.join(remaining)
+        if t.is_alive():
+            timed_out = True
+            break
+
+    if timed_out:
+        log.append(f"[timeout after {timeout}s: killing both processes]")
+    _kill(sol)
+    _kill(judge)
+    for t in threads:
+        t.join(2)
+    for p in (sol, judge):
+        try:
+            p.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            pass
+        for s in (p.stdin,):
+            try:
+                if s is not None:
+                    s.close()
+            except (BrokenPipeError, OSError, ValueError):
+                pass
+
+    elapsed = time.monotonic() - start
+    transcript = "\n".join(log)
+    sol_rc = sol.returncode
+    judge_rc = judge.returncode
+    res = [
+        "TRANSCRIPT:",
+        _clip(transcript) if transcript else "(no lines exchanged)",
+        "",
+        f"Lines from solution: {sol_count[0]}, lines from judge: {judge_count[0]}",
+        f"Solution exit code: {sol_rc}",
+        f"Judge exit code: {judge_rc}",
+        "SOLUTION STDERR:",
+        _clip("".join(sol_err).rstrip()) or "(empty)",
+        "JUDGE STDERR:",
+        _clip("".join(judge_err).rstrip()) or "(empty)",
+        f"Elapsed: {elapsed:.2f}s",
+    ]
+    if timed_out:
+        res.append(f"Error: interaction timed out after {timeout} seconds (processes were killed).")
+    return "\n".join(res)
