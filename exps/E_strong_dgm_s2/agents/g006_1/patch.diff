diff --git a/tools/exact_compare.py b/tools/exact_compare.py
new file mode 100644
index 0000000..e1c9446
--- /dev/null
+++ b/tools/exact_compare.py
@@ -0,0 +1,168 @@
+import subprocess
+import sys
+import os
+import math
+import struct
+from decimal import Decimal, getcontext
+
+getcontext().prec = 80
+
+
+def tool_info():
+    return {
+        "name": "exact_compare",
+        "description": """Compare a solution against an exact reference script (e.g. one using fractions.Fraction or decimal.Decimal with high precision) on a list of stdin inputs.
+* Runs both programs with `python3 -I` on each input and prints their outputs side by side, line by line.
+* For every pair of differing numeric tokens it prints a digit-aligned diff, the number of agreeing leading significant digits, and the ULP distance between the two values as doubles (when both parse as floats).
+* Reports the worst agreement over all inputs (fewest agreeing significant digits, largest ULP distance).
+* Returns raw data only; it does not judge correctness beyond exact text equality per input.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test (reads stdin, writes stdout)."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the exact reference Python script (reads stdin, writes stdout; may use fractions or decimal)."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin texts; each entry is run as a separate test input."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path", "reference_path", "inputs"]
+        }
+    }
+
+
+def _run(path, data, timeout):
+    try:
+        p = subprocess.run([sys.executable, "-I", path], input=data, capture_output=True,
+                           text=True, timeout=timeout, env={"PATH": os.environ.get("PATH", "")})
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return out, err, None, True
+
+
+def _ulp_distance(a, b):
+    """ULP distance between two doubles (None if not finite)."""
+    if not (math.isfinite(a) and math.isfinite(b)):
+        return None
+    def key(x):
+        i = struct.unpack("<q", struct.pack("<d", x))[0]
+        return i if i >= 0 else -(i & 0x7FFFFFFFFFFFFFFF)
+    return abs(key(a) - key(b))
+
+
+def _agree_digits(sa, sb):
+    """Number of leading significant digits (sign ignored) on which two decimal strings agree."""
+    try:
+        da, db = Decimal(sa), Decimal(sb)
+    except Exception:
+        return None
+    if da == db:
+        return "identical"
+    if da == 0 or db == 0 or (da < 0) != (db < 0):
+        return 0
+    diff = abs(da - db)
+    mx = max(abs(da), abs(db))
+    r = diff / mx
+    if r == 0:
+        return "identical"
+    return max(int(math.floor(-float(r.log10()))), 0)
+
+
+def _digit_diff(sa, sb):
+    """Digit-aligned diff: two lines, with '^' under the first differing character."""
+    n = max(len(sa), len(sb))
+    a, b = sa.ljust(n), sb.ljust(n)
+    marks = []
+    first = None
+    for i in range(n):
+        if a[i] != b[i]:
+            if first is None:
+                first = i
+            marks.append("^")
+        else:
+            marks.append(" ")
+    return f"  sol: {a}\n  ref: {b}\n       {''.join(marks)}"
+
+
+def _describe_pair(x, y):
+    lines = []
+    fx = fy = None
+    try:
+        fx, fy = float(x), float(y)
+    except ValueError:
+        pass
+    agree = _agree_digits(x, y)
+    lines.append(f"    tokens {x!r} vs {y!r}: agreeing significant digits = {agree}")
+    if fx is not None:
+        u = _ulp_distance(fx, fy)
+        lines.append(f"    ULP distance (as doubles) = {u}")
+    return "\n".join(lines), agree
+
+
+def tool_function(solution_path, reference_path, inputs, timeout=10):
+    timeout = int(timeout)
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    report = []
+    worst_digits = None
+    worst_ulp = None
+    n_exact = 0
+    for idx, inp in enumerate(inputs):
+        s_out, s_err, s_rc, s_to = _run(solution_path, inp, timeout)
+        r_out, r_err, r_rc, r_to = _run(reference_path, inp, timeout)
+        header = f"=== input {idx} ==="
+        if s_to or r_to or s_rc != 0 or r_rc != 0:
+            report.append(f"{header}\nRUN FAILURE: solution rc={s_rc} timeout={s_to}, reference rc={r_rc} timeout={r_to}\n"
+                          f"sol stderr:\n{s_err}\nref stderr:\n{r_err}")
+            continue
+        sl, rl = s_out.rstrip("\n").split("\n"), r_out.rstrip("\n").split("\n")
+        if s_out.split() == r_out.split():
+            n_exact += 1
+            if s_out == r_out:
+                report.append(f"{header}\nIDENTICAL output:\n" + "\n".join(f"  {l}" for l in sl))
+            else:
+                report.append(f"{header}\nSame tokens, whitespace differs.\n  sol: {s_out!r}\n  ref: {r_out!r}")
+            continue
+        block = [header, "side by side (sol | ref):"]
+        width = max([len(l) for l in sl] + [10])
+        for i in range(max(len(sl), len(rl))):
+            a = sl[i] if i < len(sl) else "<missing>"
+            b = rl[i] if i < len(rl) else "<missing>"
+            block.append(f"  {a.ljust(width)} | {b}")
+        # per-token diff
+        st, rt = s_out.split(), r_out.split()
+        if len(st) != len(rt):
+            block.append(f"token count differs: sol {len(st)}, ref {len(rt)}")
+        for x, y in zip(st, rt):
+            if x == y:
+                continue
+            block.append(_digit_diff(x, y))
+            desc, agree = _describe_pair(x, y)
+            block.append(desc)
+            if isinstance(agree, int):
+                worst_digits = agree if worst_digits is None else min(worst_digits, agree)
+            try:
+                u = _ulp_distance(float(x), float(y))
+                if u is not None:
+                    worst_ulp = u if worst_ulp is None else max(worst_ulp, u)
+            except ValueError:
+                pass
+        if s_err.strip():
+            block.append(f"sol stderr:\n{s_err}")
+        report.append("\n".join(block))
+    summary = (f"SUMMARY: {len(inputs)} inputs, {n_exact} with identical tokens, "
+               f"worst agreeing significant digits = {worst_digits}, worst ULP distance = {worst_ulp}")
+    return "\n\n".join(report) + "\n\n" + summary
