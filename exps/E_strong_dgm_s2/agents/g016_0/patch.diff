+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """
+        Return the concatenated text blocks of the last assistant message in msg_history,
+        or '' if there is none. Handles dict blocks, SDK block objects, and plain strings.
+        """
+        if not msg_history:
+            return ''
+        for msg in reversed(msg_history):
+            role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+            if role != 'assistant':
+                continue
+            content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+            if content is None:
+                return ''
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') == 'text' and block.get('text'):
+                        parts.append(block['text'])
+                elif getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                    parts.append(block.text)
+            return '\n'.join(parts)
+        return ''
