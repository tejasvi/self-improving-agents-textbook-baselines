diff --git a/tools/interactive_test.py b/tools/interactive_test.py
new file mode 100644
index 0000000..c470efd
--- /dev/null
+++ b/tools/interactive_test.py
@@ -0,0 +1,143 @@
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+def tool_info():
+    return {
+        "name": "interactive_test",
+        "description": """Run a Python solution of an interactive (or unusual I/O) problem in two modes, with raw output returned.\n
+* Copies the solution to a temp directory as `_sol.py` and runs it with `python3 -I` and a scrubbed environment (only PATH is kept).
+* Live-pipe mode (if `judge_path` is given): runs your judge script in a second process. The solution's stdout is piped into the judge's stdin, and the judge's stdout is piped into the solution's stdin. The judge must read the solution's queries from stdin, write replies to stdout (flushing after each reply), and log anything it wants reported (e.g. every query and the final answer line it received) to stderr. Both processes get the same overall timeout.
+* Static transcript mode (if `transcripts` is given): runs the solution once per entry, with that entry as the full stdin (first line plus replies, as the grader will feed it).
+* Returns raw stdout, stderr and exit code for every run, plus the judge's stderr log in live mode. Errors are NOT parsed: tracebacks are returned as-is for you to analyze and fix.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test (e.g. /path/to/solution.py)."
+                },
+                "judge_path": {
+                    "type": "string",
+                    "description": "Optional path to a Python judge script that talks to the solution through pipes (live mode). Omit to skip live mode."
+                },
+                "transcripts": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of full stdin texts for static transcript mode (each is the first line plus replies, with any extra lines). Omit to skip static mode."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each run (default 10)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clip(s, n=6000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _read(f):
+    f.flush()
+    f.seek(0)
+    return f.read()
+
+
+def _live(py, sol_file, judge_path, timeout, tmp, env):
+    """Run solution and judge connected by two pipes. Returns raw report text."""
+    a_r, a_w = os.pipe()  # solution stdout -> judge stdin
+    b_r, b_w = os.pipe()  # judge stdout -> solution stdin
+    sol_err = tempfile.TemporaryFile(mode='w+', dir=tmp)
+    judge_err = tempfile.TemporaryFile(mode='w+', dir=tmp)
+    start = time.time()
+    sol = judge = None
+    status = []
+    try:
+        sol = subprocess.Popen([py, '-I', sol_file], stdin=b_r, stdout=a_w, stderr=sol_err,
+                               cwd=tmp, env=env)
+        judge = subprocess.Popen([py, '-I', judge_path], stdin=a_r, stdout=b_w, stderr=judge_err,
+                                 cwd=tmp, env=env)
+    finally:
+        for fd in (a_r, a_w, b_r, b_w):
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+    for name, p in (('solution', sol), ('judge', judge)):
+        if p is None:
+            continue
+        try:
+            p.wait(timeout=timeout)
+            status.append(f"{name} exit code: {p.returncode}")
+        except subprocess.TimeoutExpired:
+            p.kill()
+            p.wait()
+            status.append(f"{name} exit code: TIMEOUT (killed after {timeout}s)")
+    parts = [
+        "== Live-pipe mode ==",
+        "\n".join(status),
+        f"elapsed: {round(time.time() - start, 3)}s",
+        "--- solution stderr ---",
+        _clip(_read(sol_err)) or "(empty)",
+        "--- judge stderr (query log) ---",
+        _clip(_read(judge_err)) or "(empty)",
+    ]
+    sol_err.close()
+    judge_err.close()
+    return "\n".join(parts)
+
+
+def _static(py, sol_file, transcripts, timeout, tmp, env):
+    parts = ["== Static transcript mode =="]
+    for idx, data in enumerate(transcripts, 1):
+        start = time.time()
+        parts.append(f"--- transcript {idx} ---")
+        try:
+            p = subprocess.run([py, '-I', sol_file], input=data, capture_output=True, text=True,
+                               cwd=tmp, env=env, timeout=timeout, errors='replace')
+            parts.append(f"exit code: {p.returncode}")
+            parts.append(f"elapsed: {round(time.time() - start, 3)}s")
+            parts.append("stdout:\n" + (_clip(p.stdout) or "(empty)"))
+            parts.append("stderr:\n" + (_clip(p.stderr) or "(empty)"))
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout if isinstance(e.stdout, str) else ''
+            err = e.stderr if isinstance(e.stderr, str) else ''
+            parts.append(f"exit code: TIMEOUT (killed after {timeout}s)")
+            parts.append("stdout:\n" + (_clip(out) or "(empty)"))
+            parts.append("stderr:\n" + (_clip(err) or "(empty)"))
+    return "\n".join(parts)
+
+
+def tool_function(solution_path, judge_path=None, transcripts=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    if judge_path is not None and judge_path != '' and not os.path.isfile(judge_path):
+        return f"Error: judge file not found: {judge_path}"
+    if isinstance(transcripts, str):
+        transcripts = [transcripts]
+    if not judge_path and not transcripts:
+        return "Error: provide judge_path (live mode) and/or transcripts (static mode)."
+
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    py = sys.executable
+    out_parts = []
+    with tempfile.TemporaryDirectory() as tmp:
+        sol_file = os.path.join(tmp, '_sol.py')
+        shutil.copyfile(solution_path, sol_file)
+        if judge_path:
+            out_parts.append(_live(py, sol_file, os.path.abspath(judge_path), timeout, tmp, env))
+        if transcripts:
+            out_parts.append(_static(py, sol_file, transcripts, timeout, tmp, env))
+    return _clip("\n\n".join(out_parts), 20000)
