+    def _has_real_edit(self):
+        """True if the diff versus base_commit touches at least one non-test file."""
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                parts = line.split(' ')
+                # Format: diff --git a/X b/X
+                if len(parts) >= 4:
+                    path = parts[2][2:] if parts[2].startswith('a/') else parts[2]
+                    if 'test' not in path:
+                        return True
+        return False
