+    def _solution_ready(self):
+        """True if solution.py exists, is non-empty, and appears in the repo diff."""
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.exists(path):
+            return False
+        try:
+            with open(path, 'r') as f:
+                if not f.read().strip():
+                    return False
+        except OSError:
+            return False
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        for line in diff.splitlines():
+            if line.startswith('diff --git') and 'solution.py' in line:
+                return True
+        return False
+
+    def _recover(self, task):
+        """Bounded retries: fresh conversation asking the agent to create solution.py."""
+        has_diff = bool(str(diff_versus_commit(self.git_tempdir, self.base_commit)).strip())
+        if has_diff:
+            extra = "Your previous attempt edited files but not solution.py. solution.py must be created or edited."
+        else:
+            extra = "Your previous attempt produced no solution.py."
+        recovery = (
+            f"{task}\n\n{extra} Your next action MUST be an editor tool call creating or editing "
+            f"{self.git_tempdir}/solution.py. A reply with no tool call counts as failure. Keep messages short."
+        )
+        for attempt in range(3):
+            if self._solution_ready():
+                break
+            chat_with_agent(recovery, model=self.code_model, msg_history=[], logging=safe_log)
+
