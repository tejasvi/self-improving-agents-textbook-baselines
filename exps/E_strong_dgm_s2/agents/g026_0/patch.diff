+++ b/tools/sample_match.py
@@ -0,0 +1,108 @@
+import difflib
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "sample_match",
+        "description": """Run a solution program on the sample inputs from the problem statement and compare its stdout with the expected sample outputs.\n
+* Pass the sample inputs and expected outputs verbatim, as two parallel arrays of strings: `inputs[i]` is fed on stdin and `expected_outputs[i]` is the matching expected output. Both arrays must have the same length.\n
+* For each sample the report is one of: 'EXACT MATCH' (stdout identical to the expected output, ignoring only trailing whitespace of the whole output), 'MATCH IGNORING WHITESPACE' (same tokens but different spacing/newlines), or 'DIFFERENT' (with a unified diff, the raw program output and the expected output; stderr is included on crash or timeout).\n
+* A 'DIFFERENT' result is reported even when the difference is only a different-but-valid answer (e.g. when the problem accepts any valid answer). The tool does not judge validity; use a separate checker for that. The goal is usually to make the output match the sample exactly.\n
+* Ends with a summary line 'k/N samples match exactly'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program. It is run as `python3 <solution_path>` with the sample input on stdin."
+                },
+                "inputs": {
+                    "type": "array",
+                    "description": "Sample inputs, verbatim from the problem statement. One string per sample."
+                },
+                "expected_outputs": {
+                    "type": "array",
+                    "description": "Expected sample outputs, verbatim from the problem statement. Must be the same length as `inputs`; expected_outputs[i] belongs to inputs[i]."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each sample run. Default 10."
+                }
+            },
+            "required": ["solution_path", "inputs", "expected_outputs"]
+        }
+    }
+
+
+def _run(solution_path, stdin_text, timeout):
+    """Returns (status, stdout, stderr). status is 'ok', 'timeout' or 'crash'."""
+    try:
+        p = subprocess.run([sys.executable, solution_path], input=stdin_text,
+                           capture_output=True, text=True, timeout=timeout,
+                           errors='replace')
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b'').decode('utf-8', 'replace')
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b'').decode('utf-8', 'replace')
+        return 'timeout', out or '', err or ''
+    if p.returncode != 0:
+        return 'crash', p.stdout, p.stderr
+    return 'ok', p.stdout, p.stderr
+
+
+def _rstrip_all(s):
+    return s.rstrip()
+
+
+def tool_function(solution_path, inputs, expected_outputs, timeout=10):
+    if timeout is None:
+        timeout = 10
+    if len(inputs) != len(expected_outputs):
+        return (f"Error: inputs has {len(inputs)} entries but expected_outputs has "
+                f"{len(expected_outputs)}. They must be parallel arrays of equal length.")
+
+    n = len(inputs)
+    exact = 0
+    blocks = []
+    for i, (inp, exp) in enumerate(zip(inputs, expected_outputs), start=1):
+        status, out, err = _run(solution_path, inp, timeout)
+        header = f"=== Sample {i} ==="
+        if status != 'ok':
+            reason = 'timed out' if status == 'timeout' else 'crashed (non-zero exit)'
+            lines = [header, f"DIFFERENT: program {reason}."]
+            lines.append("--- raw stdout ---")
+            lines.append(out.rstrip() if out.strip() else "(empty)")
+            lines.append("--- stderr ---")
+            lines.append(err.rstrip() if err.strip() else "(empty)")
+            blocks.append("\n".join(lines))
+            continue
+
+        if _rstrip_all(out) == _rstrip_all(exp):
+            exact += 1
+            blocks.append(f"{header}\nEXACT MATCH")
+            continue
+
+        if out.split() == exp.split():
+            verdict = "MATCH IGNORING WHITESPACE"
+        else:
+            verdict = "DIFFERENT"
+
+        lines = [header, verdict]
+        if verdict == "DIFFERENT":
+            diff = difflib.unified_diff(
+                _rstrip_all(exp).splitlines(), _rstrip_all(out).splitlines(),
+                fromfile='expected', tofile='actual', lineterm='')
+            lines.append("--- unified diff (expected -> actual) ---")
+            lines.extend(diff)
+        lines.append("--- raw expected output ---")
+        lines.append(_rstrip_all(exp) if exp.strip() else "(empty)")
+        lines.append("--- raw actual output ---")
+        lines.append(_rstrip_all(out) if out.strip() else "(empty)")
+        if err.strip():
+            lines.append("--- stderr ---")
+            lines.append(err.rstrip())
+        blocks.append("\n".join(lines))
+
+    blocks.append(f"{exact}/{n} samples match exactly")
+    return "\n\n".join(blocks)
