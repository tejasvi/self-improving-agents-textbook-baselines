+    def solve(self, attempt_id, repo):
+        """Phase 1: solve in the given repo copy. Returns the path of its solution.py."""
+        instruction = self._task_text(repo) + "\n\n" + COMPETITIVE_METHOD
+        if _is_interactive(self.problem_statement):
+            instruction += INTERACTIVE_SOLVE_CLAUSE
+        instruction += SOLVE_SUFFIX.format(repo=repo, k=attempt_id)
+        safe_log(f"=== solve attempt {attempt_id} in {repo} ===")
+        chat_with_agent(instruction, model=self.code_model, msg_history=[], logging=safe_log)
+        return os.path.join(repo, 'solution.py')
+
+    def write_tests(self, tests_dir):
+        """Phase 2: independent test writing. Fresh history, statement only, never sees solutions."""
+        os.makedirs(tests_dir, exist_ok=True)
+        clause = ''
+        if _is_interactive(self.problem_statement):
+            clause = INTERACTIVE_TESTS_CLAUSE.format(tests_dir=tests_dir)
+        prompt = WRITE_TESTS_PROMPT.format(statement=self.problem_statement, tests_dir=tests_dir,
+                                           interactive_clause=clause)
+        safe_log(f"=== write tests in {tests_dir} ===")
+        chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        return tests_dir
+
+    def _tests_ready(self, tests_dir):
+        """Return (mode, paths) where mode is 'judge' or 'stress', or (None, reason)."""
+        brute = os.path.join(tests_dir, 'brute.py')
+        gen = os.path.join(tests_dir, 'gen.py')
+        judge = os.path.join(tests_dir, 'judge.py')
+        if _is_interactive(self.problem_statement):
+            if os.path.isfile(judge):
+                return 'judge', {'judge': judge}
+            return None, f"missing {judge} (interactive problem needs a judge)"
+        missing = [p for p in (brute, gen) if not os.path.isfile(p)]
+        if missing:
+            return None, f"missing test files: {missing}"
+        return 'stress', {'brute': brute, 'gen': gen}
+
+    def run_tests(self, solution_path, tests_dir, num_seeds):
+        """Phase 3 helper: run the shared tests directly through the tool functions.
+
+        Returns a dict with raw counts, the test mode, and the raw report text.
+        """
+        mode, info = self._tests_ready(tests_dir)
+        if mode is None:
+            return {'mode': None, 'seeds_run': 0, 'passed': 0, 'failed': 1, 'sol_time': 0.0,
+                    'report': f"TESTS NOT RUN: {info}"}
+        if not os.path.isfile(solution_path):
+            return {'mode': mode, 'seeds_run': 0, 'passed': 0, 'failed': 1, 'sol_time': 0.0,
+                    'report': f"TESTS NOT RUN: no solution file at {solution_path}"}
+        if mode == 'judge':
+            res = judge_sim.run_seeds(solution_path, info['judge'], num_seeds=num_seeds, timeout=10)
+            report = f"seeds run: {res['seeds_run']}\npassed: {res['passed']}\nfailed: {res['failed']}\n"
+            if res['first_fail'] is not None:
+                seed, r = res['first_fail']
+                report += (f"FIRST FAILING SEED: {seed}\nsolution exit code: {r['sol_rc']}\n"
+                           f"judge exit code: {r['judge_rc']}\n--- solution stderr ---\n{r['sol_err'][-3000:]}\n"
+                           f"--- judge stderr ---\n{r['judge_err'][-3000:]}\n")
+            return {'mode': mode, 'seeds_run': res['seeds_run'], 'passed': res['passed'],
+                    'failed': res['failed'], 'sol_time': 0.0, 'report': report}
+        res = stress_test.run_seeds(solution_path, info['brute'], info['gen'],
+                                    num_tests=num_seeds, timeout=10)
+        report = f"seeds run: {res['seeds_run']}\npassed: {res['passed']}\nfailed: {res['failed']}\n"
+        if res['first_fail'] is not None:
+            report += "FIRST FAILURE:\n" + res['first_fail']
+        return {'mode': mode, 'seeds_run': res['seeds_run'], 'passed': res['passed'],
+                'failed': res['failed'], 'sol_time': res['sol_time'], 'report': report}
+
+    def _passes(self, result):
+        return result['seeds_run'] >= MIN_SEEDS and result['failed'] == 0
+
+    def repair(self, repo, tests_dir, result, round_no):
+        """Phase 4: one repair call with diff, test files and raw failure output."""
+        tests_text = []
+        for name in sorted(os.listdir(tests_dir)):
+            path = os.path.join(tests_dir, name)
+            if os.path.isfile(path):
+                tests_text.append(f"--- {name} ---\n{_read_text(path)}")
+        prompt = REPAIR_PROMPT.format(
+            repo=repo, statement=self.problem_statement,
+            diff=str(diff_versus_commit(repo, self.base_commit))[:20000],
+            tests="\n".join(tests_text), test_output=result['report'][-8000:])
+        safe_log(f"=== repair round {round_no} in {repo} ===")
+        chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+
+    def _solve_and_repair(self, k, tests_dir):
+        """Solve one candidate in a fresh copy of the repo, then repair until tests pass."""
+        work = tempfile.mkdtemp(prefix=f'cand{k}_')
+        repo = os.path.join(work, 'repo')
+        _copy_repo(self.git_tempdir, repo)
+        sol = self.solve(k, repo)
+        result = self.run_tests(sol, tests_dir, MIN_SEEDS)
+        rounds = 0
+        for round_no in range(1, MAX_REPAIR_ROUNDS + 1):
+            if self._passes(result):
+                break
+            rounds = round_no
+            self.repair(repo, tests_dir, result, round_no)
+            sol = os.path.join(repo, 'solution.py')
+            result = self.run_tests(sol, tests_dir, MIN_SEEDS)
+        result['repo'] = repo
+        result['solution'] = sol
+        result['rounds'] = rounds
+        safe_log(f"candidate {k}: seeds={result['seeds_run']} passed={result['passed']} "
+                 f"failed={result['failed']} repair_rounds={rounds} sol_time={result['sol_time']:.2f}s")
+        return result
+
+    def forward(self):
+        """
+        The forward function for the AgenticSystem.
+
+        Bounded phases: write independent tests once, solve K candidates (each in a fresh repo copy),
+        evaluate each on the shared tests with repair rounds, then keep the best candidate.
+        """
+        base_dir = os.path.dirname(os.path.abspath(self.chat_history_file))
+        tests_dir = tempfile.mkdtemp(prefix='agent_tests_', dir=base_dir)
+        self.write_tests(tests_dir)
+
+        best = None
+        for k in range(1, self.num_candidates + 1):
+            result = self._solve_and_repair(k, tests_dir)
+            # Highest pass rate first; ties broken by speed (lower sol_time is better).
+            rate = result['passed'] / result['seeds_run'] if result['seeds_run'] else -1.0
+            key = (rate, -result['sol_time'])
+            result['key'] = key
+            if best is None or key > best['key']:
+                best = result
+
+        if best is not None and os.path.isfile(best['solution']):
+            shutil.copyfile(best['solution'], os.path.join(self.git_tempdir, 'solution.py'))
+            safe_log(f"selected candidate solution with key {best['key']}")
+        else:
+            safe_log("no candidate produced solution.py")
+        final = self.run_tests(os.path.join(self.git_tempdir, 'solution.py'), tests_dir, MIN_SEEDS) \
+            if best is not None else None
+        if final is not None:
+            safe_log(f"final verification: seeds={final['seeds_run']} passed={final['passed']} failed={final['failed']}")
+            if final['seeds_run'] < MIN_SEEDS:
+                safe_log(f"TESTS INCOMPLETE: only {final['seeds_run']} seeds run (need {MIN_SEEDS})")
+        return best
+
 
