diff --git a/tools/judge_sim.py b/tools/judge_sim.py
new file mode 100644
index 0000000..774ea30
--- /dev/null
+++ b/tools/judge_sim.py
@@ -0,0 +1,96 @@
+import os
+import shutil
+import sys
+import tempfile
+
+from tools.interactive_test import _live_run, _clip, _fmt_rc
+
+
+def tool_info():
+    return {
+        "name": "judge_sim",
+        "description": """Run an interactive solution against a judge script over pipes, once per seed, and report raw aggregated results.
+* The judge is a Python script that is called as `judge.py <seed>`. It must read the solution's queries from stdin, write replies to stdout (flushing after each reply), derive its hidden data from the seed, and log its verdict to stderr as plain text. The judge MUST exit with a non-zero code on a wrong answer or a query-limit violation, since a seed passes only when both the judge and the solution exit with code 0.
+* The solution is run as `python3 -I _sol.py` with a scrubbed environment (only PATH). Its stdout feeds the judge's stdin and the judge's stdout feeds the solution's stdin.
+* For each seed 0..num_seeds-1 the tool reports whether the judge exited with code 0 and the solution exited with code 0 (a timeout counts as failure).
+* Returns the number of seeds passed and failed, and for the first failing seed: the seed, exit codes, elapsed time, and the raw solution stderr and judge stderr. No error parsing is done.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test (e.g. /path/to/solution.py)."
+                },
+                "judge_path": {
+                    "type": "string",
+                    "description": "Path to the judge Python script. It is called as `judge.py <seed>`."
+                },
+                "num_seeds": {
+                    "type": "integer",
+                    "description": "Number of seeds to run (seeds 0..num_seeds-1). Default 100."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "judge_path"]
+        }
+    }
+
+
+def run_seeds(solution_path, judge_path, num_seeds=100, timeout=10):
+    """Run every seed (no early stop). Returns raw counts and the first failing run's raw data."""
+    res = {'seeds_run': 0, 'passed': 0, 'failed': 0, 'first_fail': None}
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    py = sys.executable
+    with tempfile.TemporaryDirectory() as tmp:
+        sol_file = os.path.join(tmp, '_sol.py')
+        shutil.copyfile(solution_path, sol_file)
+        judge_abs = os.path.abspath(judge_path)
+        for seed in range(int(num_seeds)):
+            res['seeds_run'] += 1
+            r = _live_run(py, sol_file, judge_abs, timeout, tmp, env, args=(seed,))
+            if r['sol_rc'] == 0 and r['judge_rc'] == 0:
+                res['passed'] += 1
+            else:
+                res['failed'] += 1
+                if res['first_fail'] is None:
+                    res['first_fail'] = (seed, r)
+    return res
+
+
+def tool_function(solution_path, judge_path, num_seeds=100, timeout=10):
+    try:
+        num_seeds = max(1, min(int(num_seeds or 100), 1000))
+    except (TypeError, ValueError):
+        num_seeds = 100
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    if not os.path.isfile(judge_path):
+        return f"Error: judge file not found: {judge_path}"
+    res = run_seeds(solution_path, judge_path, num_seeds=num_seeds, timeout=timeout)
+    lines = [
+        f"seeds run: {res['seeds_run']}",
+        f"passed: {res['passed']}",
+        f"failed: {res['failed']}",
+    ]
+    if res['first_fail'] is None:
+        lines.append("All seeds passed (both exit codes 0).")
+    else:
+        seed, r = res['first_fail']
+        lines += [
+            f"FIRST FAILING SEED: {seed}",
+            f"solution exit code: {_fmt_rc(r['sol_rc'], timeout)}",
+            f"judge exit code: {_fmt_rc(r['judge_rc'], timeout)}",
+            f"elapsed: {r['elapsed']}s",
+            "--- solution stderr ---",
+            _clip(r['sol_err'], 4000) or "(empty)",
+            "--- judge stderr (verdict / query log) ---",
+            _clip(r['judge_err'], 4000) or "(empty)",
+        ]
+    return _clip("\n".join(lines), 20000)
