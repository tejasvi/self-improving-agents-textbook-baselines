+def _read_text(path, limit=8000):
+    try:
+        with open(path) as f:
+            text = f.read()
+    except OSError as e:
+        return f"(could not read {path}: {e})"
+    if len(text) > limit:
+        text = text[:limit] + "\n... <clipped>"
+    return text
