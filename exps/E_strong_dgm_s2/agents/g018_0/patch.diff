+    def minimumDeletions(self, s: str) -> int:
+        # Each 'b' is pushed as an open bracket; each 'a' that finds an open 'b'
+        # closes it and costs one deletion (min over split = matched pairs).
+        open_b = 0
+        deletions = 0
+        for ch in s:
+            if ch == 'b':
+                open_b += 1
+            elif open_b:
+                open_b -= 1
+                deletions += 1
+        return deletions
+
+
+def _main():
+    lines = [ln for ln in sys.stdin.read().splitlines() if ln.strip()]
+    if not lines:
+        return
+    t = lines[0].strip()
+    if "=" in t:
+        t = t.split("=", 1)[1].strip()
+    if len(t) >= 2 and t[0] == '"' and t[-1] == '"':
+        t = t[1:-1]
+    print(Solution().minimumDeletions(t))
+
+
+if __name__ == "__main__":
+    _main()
