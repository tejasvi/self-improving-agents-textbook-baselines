+import os
+import sys
+import json
+import subprocess
+import time
+
+# Driver executed as `python3 -I -c DRIVER SOL_PATH METHOD`; reads a JSON list of call strings on stdin.
+# Each call string is a comma-separated list of python literals, e.g. `s = "acab", k = 2`.
+# Prints one tab-separated line per call: RESULT\ti\telapsed\trepr  or  ERROR\ti\telapsed\tmessage
+DRIVER = r'''
+import sys, json, time, ast, traceback, importlib.util, os
+sol_path, method_name = sys.argv[1], sys.argv[2]
+sys.path.insert(0, os.path.dirname(sol_path))
+calls = json.loads(sys.stdin.read())
+try:
+    spec = importlib.util.spec_from_file_location("_candidate_solution", sol_path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    sol = mod.Solution()
+    fn = getattr(sol, method_name)
+except Exception as e:
+    traceback.print_exc()
+    print("LOADERROR\t" + type(e).__name__ + ": " + str(e).replace("\n", " "), flush=True)
+    sys.exit(0)
+for i, text in enumerate(calls):
+    try:
+        node = ast.parse("_f(" + text + ")", mode="eval").body
+        args = [ast.literal_eval(a) for a in node.args]
+        kwargs = {k.arg: ast.literal_eval(k.value) for k in node.keywords}
+        t0 = time.time()
+        res = fn(*args, **kwargs)
+        el = time.time() - t0
+        print("RESULT\t%d\t%.3f\t%s" % (i, el, repr(res)), flush=True)
+    except Exception as e:
+        traceback.print_exc()
+        print("ERROR\t%d\t0.000\t%s: %s" % (i, type(e).__name__, str(e).replace("\n", " ")), flush=True)
+'''
+
+
+def tool_info():
+    return {
+        "name": "run_method",
+        "description": (
+            "Import a Python solution file in an isolated subprocess (python3 -I), instantiate its `Solution` class, "
+            "and call the named method once per entry of `calls`. Each entry is a string of python literal arguments "
+            "written like a call, e.g. 'nums = [1, 2, 3], target = 4' or '\"acab\"'. Returns the raw stdout "
+            "(one RESULT line per call with elapsed seconds and repr(result), or an ERROR line), the exit code and "
+            "the raw stderr (tracebacks). Use it to check a Solution-class method on example inputs and to time it on max-size inputs."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python file that defines class Solution."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on a Solution() instance."
+                },
+                "calls": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of argument strings; each is comma-separated python literals (keyword or positional)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Hard time limit in seconds for the whole subprocess (default 10)."
+                }
+            },
+            "required": ["solution_path", "method_name", "calls"]
+        }
+    }
+
+
+def _to_text(x):
+    if x is None:
+        return ''
+    if isinstance(x, bytes):
+        return x.decode('utf-8', errors='replace')
+    return x
+
+
+def _clip(s, n=4000):
+    if s is None:
+        return ''
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def run_calls(solution_path, method_name, calls, timeout=10):
+    """Structured runner. Returns a dict with keys:
+    rc ('TIMEOUT' or int), stdout, stderr, elapsed, results {i: (elapsed, repr)}, errors {i: msg}, load_error."""
+    sol_abs = os.path.abspath(solution_path)
+    start = time.time()
+    payload = json.dumps([str(c) for c in calls])
+    try:
+        p = subprocess.run([sys.executable, '-I', '-c', DRIVER, sol_abs, str(method_name)],
+                           input=payload, capture_output=True, text=True, timeout=timeout,
+                           cwd=os.path.dirname(sol_abs), env={'PATH': os.environ.get('PATH', '/usr/bin:/bin')},
+                           errors='replace')
+        out, err, rc = p.stdout, p.stderr, p.returncode
+    except subprocess.TimeoutExpired as e:
+        out = _to_text(e.stdout)
+        err = _to_text(e.stderr) + f"\n(timed out after {timeout} seconds)"
+        rc = 'TIMEOUT'
+    results, errors, load_error = {}, {}, None
+    for line in out.splitlines():
+        parts = line.split('\t', 3)
+        try:
+            if parts[0] == 'RESULT' and len(parts) == 4:
+                results[int(parts[1])] = (float(parts[2]), parts[3])
+            elif parts[0] == 'ERROR' and len(parts) == 4:
+                errors[int(parts[1])] = parts[3]
+            elif parts[0] == 'LOADERROR' and len(parts) >= 2:
+                load_error = line.split('\t', 1)[1]
+        except ValueError:
+            continue
+    return {'rc': rc, 'stdout': out, 'stderr': err, 'elapsed': round(time.time() - start, 3),
+            'results': results, 'errors': errors, 'load_error': load_error}
+
+
+def tool_function(solution_path, method_name, calls, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if isinstance(calls, str):
+        calls = [calls]
+    if not calls:
+        return "Error: calls is empty"
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    r = run_calls(solution_path, method_name, calls, timeout=timeout)
+    return (f"rc={r['rc']} total_elapsed={r['elapsed']}s\n"
+            f"--- stdout\n{_clip(r['stdout'])}\n--- stderr\n{_clip(r['stderr'])}")
