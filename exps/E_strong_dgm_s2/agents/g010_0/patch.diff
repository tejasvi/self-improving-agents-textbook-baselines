@@ -0,0 +1,198 @@
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+CLIP_INPUT = 400
+CLIP_OUTPUT = 1500
+CLIP_STDERR = 1000
+MAX_FAILS_SHOWN = 3
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a reference solution using a generator and an optional checker.\n
+* `gen_path` is a script run as `python3 gen.py MODE SEED` (in a clean subprocess) that prints ONE test input to stdout.
+* For every mode in `modes` and every seed in 0..seeds_per_mode-1, the input is generated, then solution_path and ref_path are run on it in clean subprocesses (`python3 -I`, scrubbed env).
+* If `checker_path` is given it is run as `python3 checker.py input_file solution_output_file ref_output_file` and must exit 0 when the solution output is valid. Otherwise the whitespace-separated tokens of the solution output and the reference output must match exactly.
+* Returns RAW text only: per-mode pass/fail counts, the max elapsed time per mode, the elapsed time and length of the largest input per mode, and the first few failing cases with the input, both outputs, the checker output and stderr (all clipped). Nothing is parsed or interpreted.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the generator script; it is called as `python3 gen_path MODE SEED` and prints one input to stdout."
+                },
+                "ref_path": {
+                    "type": "string",
+                    "description": "Path to the reference (trusted, slow-but-correct) solution Python file reading stdin."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a checker script called as `python3 checker_path input_file solution_output_file ref_output_file`; exit code 0 means the solution output is acceptable."
+                },
+                "modes": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Generator mode names to test, e.g. [\"tiny\", \"duplicates\", \"all_equal\", \"planted\", \"no_answer\", \"max_tiny\", \"max_planted\"]."
+                },
+                "seeds_per_mode": {
+                    "type": "integer",
+                    "description": "Number of random seeds (0..seeds_per_mode-1) to run for each mode."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for generator, solution, reference and checker (default 10)."
+                }
+            },
+            "required": ["solution_path", "gen_path", "ref_path", "modes", "seeds_per_mode"]
+        }
+    }
+
+
+def _clip(s, n):
+    if s is None:
+        return ''
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _env():
+    return {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+
+
+def _run(cmd, cwd, data=None, timeout=10):
+    start = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, text=True, cwd=cwd,
+                           env=_env(), timeout=timeout, errors='replace')
+        return {'stdout': p.stdout, 'stderr': p.stderr, 'rc': p.returncode,
+                'elapsed': round(time.time() - start, 3)}
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {'stdout': out, 'stderr': err + f"\n(timed out after {timeout} seconds)",
+                'rc': 'TIMEOUT', 'elapsed': round(time.time() - start, 3)}
+
+
+def _tokens_equal(a, b):
+    return a.split() == b.split()
+
+
+def tool_function(solution_path, gen_path, ref_path, modes, seeds_per_mode,
+                  checker_path=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        seeds_per_mode = max(1, min(int(seeds_per_mode), 2000))
+    except (TypeError, ValueError):
+        return "Error: seeds_per_mode must be an integer"
+    if isinstance(modes, str):
+        modes = [modes]
+    if not modes:
+        return "Error: modes is empty"
+    for p in [solution_path, gen_path, ref_path] + ([checker_path] if checker_path else []):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+    solution_path = os.path.abspath(solution_path)
+    gen_path = os.path.abspath(gen_path)
+    ref_path = os.path.abspath(ref_path)
+    checker_path = os.path.abspath(checker_path) if checker_path else None
+
+    stats = {}
+    fails = []  # (mode, seed, reason, input, sol_out, ref_out, stderr)
+    with tempfile.TemporaryDirectory() as tmp:
+        for mode in modes:
+            st = {'pass': 0, 'fail': 0, 'max_elapsed': 0.0,
+                  'largest_len': -1, 'largest_elapsed': None, 'largest_seed': None}
+            stats[mode] = st
+            for seed in range(seeds_per_mode):
+                g = _run([sys.executable, '-I', gen_path, str(mode), str(seed)], tmp, timeout=timeout)
+                if g['rc'] != 0:
+                    st['fail'] += 1
+                    fails.append((mode, seed, f"generator failed (rc={g['rc']})", '', '', '', g['stderr']))
+                    continue
+                inp = g['stdout']
+                in_file = os.path.join(tmp, 'input.txt')
+                with open(in_file, 'w') as f:
+                    f.write(inp)
+
+                s = _run([sys.executable, '-I', solution_path], tmp, data=inp, timeout=timeout)
+                r = _run([sys.executable, '-I', ref_path], tmp, data=inp, timeout=max(timeout, 30))
+                st['max_elapsed'] = max(st['max_elapsed'], s['elapsed'])
+                if len(inp) > st['largest_len']:
+                    st['largest_len'] = len(inp)
+                    st['largest_elapsed'] = s['elapsed']
+                    st['largest_seed'] = seed
+
+                if r['rc'] != 0:
+                    st['fail'] += 1
+                    fails.append((mode, seed, f"REFERENCE failed (rc={r['rc']})", inp, s['stdout'], r['stdout'], r['stderr']))
+                    continue
+                if s['rc'] != 0:
+                    st['fail'] += 1
+                    fails.append((mode, seed, f"solution crashed or timed out (rc={s['rc']})", inp, s['stdout'], r['stdout'], s['stderr']))
+                    continue
+
+                ok = True
+                reason = ''
+                checker_out = ''
+                if checker_path:
+                    sol_file = os.path.join(tmp, 'sol_out.txt')
+                    ref_file = os.path.join(tmp, 'ref_out.txt')
+                    with open(sol_file, 'w') as f:
+                        f.write(s['stdout'])
+                    with open(ref_file, 'w') as f:
+                        f.write(r['stdout'])
+                    c = _run([sys.executable, '-I', checker_path, in_file, sol_file, ref_file], tmp, timeout=timeout)
+                    if c['rc'] != 0:
+                        ok = False
+                        reason = f"checker rejected (rc={c['rc']})"
+                        checker_out = c['stdout'] + c['stderr']
+                else:
+                    if not _tokens_equal(s['stdout'], r['stdout']):
+                        ok = False
+                        reason = "output tokens differ from reference"
+
+                if ok:
+                    st['pass'] += 1
+                else:
+                    st['fail'] += 1
+                    fails.append((mode, seed, reason, inp, s['stdout'], r['stdout'],
+                                  (checker_out + '\n' + s['stderr']) if checker_out else s['stderr']))
+
+    out = []
+    out.append("== Stress test summary ==")
+    out.append(f"solution: {solution_path}")
+    out.append(f"generator: {gen_path}  reference: {ref_path}  checker: {checker_path or '(token comparison)'}")
+    out.append(f"seeds per mode: {seeds_per_mode}, timeout: {timeout}s")
+    for mode, st in stats.items():
+        out.append(
+            f"mode {mode}: pass={st['pass']} fail={st['fail']} "
+            f"max_elapsed={st['max_elapsed']}s "
+            f"largest_input(seed={st['largest_seed']}, chars={st['largest_len']}) solution_elapsed={st['largest_elapsed']}s"
+        )
+    total_fail = sum(st['fail'] for st in stats.values())
+    out.append(f"total failures: {total_fail}")
+    out.append("")
+    if not fails:
+        out.append("ALL CASES PASSED")
+    else:
+        out.append(f"== First {min(MAX_FAILS_SHOWN, len(fails))} failing cases (of {len(fails)}) ==")
+        for mode, seed, reason, inp, sol_out, ref_out, err in fails[:MAX_FAILS_SHOWN]:
+            out.append(f"--- mode={mode} seed={seed}: {reason}")
+            out.append(f"input:\n{_clip(inp, CLIP_INPUT)}")
+            out.append(f"solution output:\n{_clip(sol_out, CLIP_OUTPUT)}")
+            out.append(f"reference output:\n{_clip(ref_out, CLIP_OUTPUT)}")
+            out.append(f"stderr / checker output:\n{_clip(err, CLIP_STDERR) if err else '(empty)'}")
+            out.append("")
+    return "\n".join(out)
