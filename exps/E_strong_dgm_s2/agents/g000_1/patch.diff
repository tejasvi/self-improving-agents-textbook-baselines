diff --git a/tools/run_clean.py b/tools/run_clean.py
new file mode 100644
index 0000000..d73098b
--- /dev/null
+++ b/tools/run_clean.py
@@ -0,0 +1,148 @@
+import ast
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+FRAGILE_MODULES = {'threading', 'resource', 'multiprocessing', 'signal', 'ctypes'}
+FRAGILE_CALLS = {'setrecursionlimit', 'setswitchinterval', 'stack_size'}
+
+
+def tool_info():
+    return {
+        "name": "run_clean",
+        "description": """Run a Python solution in a clean subprocess, mimicking the grader's environment.\n
+* Copies the file to a temp directory as `_sol.py` and runs it with `python3 -I` (isolated mode) and a scrubbed environment (only PATH is kept), so local env vars, user site-packages and the current directory do not leak in.
+* Runs the solution once per entry of `inputs` (each entry is the stdin text), and additionally once per input with the trailing newline stripped. If `pypy3` is installed it is also run on each input.
+* Returns, for every run: stdout, stderr (full traceback), exit code and elapsed time.
+* Also returns a raw list of potentially fragile constructs found by a static AST scan (e.g. 3-argument pow, sys.setrecursionlimit, threading). These are informational only.
+* Use it on all samples and a max-size input before finishing, and read all stderr output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin texts; each entry is run as a separate test input. Use an empty list or omit to run once with empty stdin."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clip(s, n=6000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _static_scan(source):
+    """Collect raw informational lines about fragile constructs."""
+    notes = []
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return [f"AST scan skipped, source does not parse: {e.msg} (line {e.lineno})"]
+    for node in ast.walk(tree):
+        lineno = getattr(node, 'lineno', '?')
+        if isinstance(node, ast.Call):
+            func = node.func
+            if isinstance(func, ast.Name) and func.id == 'pow' and len(node.args) + len(node.keywords) == 3:
+                notes.append(f"line {lineno}: 3-argument pow(...) call (fails on some runtimes; consider a hand-written modular power loop)")
+            elif isinstance(func, ast.Name) and func.id in FRAGILE_CALLS:
+                notes.append(f"line {lineno}: call to {func.id}(...)")
+            elif isinstance(func, ast.Attribute) and func.attr in FRAGILE_CALLS:
+                notes.append(f"line {lineno}: call to .{func.attr}(...)")
+        elif isinstance(node, ast.Import):
+            for a in node.names:
+                if a.name.split('.')[0] in FRAGILE_MODULES:
+                    notes.append(f"line {lineno}: import of {a.name}")
+        elif isinstance(node, ast.ImportFrom):
+            if node.module and node.module.split('.')[0] in FRAGILE_MODULES:
+                notes.append(f"line {lineno}: import from {node.module}")
+    return notes
+
+
+def _run(cmd, data, cwd, env, timeout):
+    start = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, text=True, cwd=cwd, env=env,
+                           timeout=timeout, errors='replace')
+        return {
+            'stdout': _clip(p.stdout),
+            'stderr': _clip(p.stderr),
+            'exit_code': p.returncode,
+            'elapsed': round(time.time() - start, 3),
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {
+            'stdout': _clip(out),
+            'stderr': _clip(err) + f"\n(timed out after {timeout} seconds)",
+            'exit_code': 'TIMEOUT',
+            'elapsed': round(time.time() - start, 3),
+        }
+
+
+def _fmt(idx, label, r):
+    return (f"--- input {idx} [{label}] ---\n"
+            f"exit code: {r['exit_code']}\n"
+            f"elapsed: {r['elapsed']}s\n"
+            f"stdout:\n{r['stdout']}\n"
+            f"stderr:\n{r['stderr'] if r['stderr'] else '(empty)'}\n")
+
+
+def tool_function(solution_path, inputs=None, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    with open(solution_path, 'r', errors='replace') as f:
+        source = f.read()
+
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    if not inputs:
+        inputs = ['']
+
+    out_parts = []
+    notes = _static_scan(source)
+    out_parts.append("== Static scan (informational) ==")
+    out_parts.extend(notes if notes else ["no fragile constructs found"])
+
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    pypy = shutil.which('pypy3')
+
+    with tempfile.TemporaryDirectory() as tmp:
+        dst = os.path.join(tmp, '_sol.py')
+        shutil.copyfile(solution_path, dst)
+        py_cmd = [sys.executable, '-I', '_sol.py']
+        runners = [('python', py_cmd)]
+        if pypy:
+            runners.append(('pypy3', [pypy, '_sol.py']))
+
+        for idx, data in enumerate(inputs, 1):
+            variants = [('as given', data)]
+            stripped = data.rstrip('\n')
+            if stripped != data:
+                variants.append(('trailing newline stripped', stripped))
+            for vlabel, vdata in variants:
+                for rname, cmd in runners:
+                    r = _run(cmd, vdata, tmp, env, timeout)
+                    out_parts.append(_fmt(idx, f"{rname}, {vlabel}", r))
+
+    return _clip("\n".join(out_parts), 20000)
