+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Extract every 'Sample Input N' / 'Sample Output N' block from a problem statement and run a solution on each sample.
+* Pass the full statement text and the path to the solution file.
+* Runs the solution with `python3 -I` on each sample input (stdin) in an isolated subprocess.
+* Returns, for each sample: the raw stdout, stderr, exit code, the expected text, whether the output matches exactly, and a character-level diff (unified style) between expected and actual output. No judgement is made: read the diff yourself.
+* Use it instead of hand-transcribing sample inputs. Exact match is required; a float that differs in any printed digit is a mismatch.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "statement_text": {
+                    "type": "string",
+                    "description": "The full problem statement text containing 'Sample Input N' and 'Sample Output N' blocks."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["statement_text", "solution_path"]
+        }
+    }
+
+
+_HEADER_RE = re.compile(r'^[ \t#*_`]*Sample\s+(Input|Output)\s+(\d+)[ \t*_`:]*$', re.IGNORECASE | re.MULTILINE)
+
+
+def _strip_fences(block):
+    lines = block.strip("\n").split("\n")
+    if lines and lines[0].strip().startswith("```"):
+        lines = lines[1:]
+    if lines and lines[-1].strip().startswith("```"):
+        lines = lines[:-1]
+    text = "\n".join(lines)
+    return text.strip("\n") + "\n" if text.strip() else ""
+
+
+def extract_samples(statement_text):
+    """Return a sorted list of (index, input_text, output_text) from the statement."""
+    headers = list(_HEADER_RE.finditer(statement_text or ""))
+    ins, outs = {}, {}
+    for i, m in enumerate(headers):
+        end = headers[i + 1].start() if i + 1 < len(headers) else len(statement_text)
+        body = _strip_fences(statement_text[m.end():end])
+        idx = int(m.group(2))
+        if m.group(1).lower() == "input":
+            ins[idx] = body
+        else:
+            outs[idx] = body
+    return [(k, ins[k], outs[k]) for k in sorted(ins) if k in outs]
+
+
+def _char_diff(expected, actual):
+    """Raw character-level diff: list the first differing positions and a difflib-style summary."""
+    import difflib
+    e_lines = expected.splitlines(keepends=True)
+    a_lines = actual.splitlines(keepends=True)
+    diff = list(difflib.unified_diff(e_lines, a_lines, fromfile="expected", tofile="actual", n=0))
+    pos = None
+    for i, (x, y) in enumerate(zip(expected, actual)):
+        if x != y:
+            pos = i
+            break
+    if pos is None and len(expected) != len(actual):
+        pos = min(len(expected), len(actual))
+    char_info = "identical" if pos is None else (
+        f"first difference at char {pos}: expected {expected[pos:pos+20]!r} vs actual {actual[pos:pos+20]!r}")
+    return char_info + ("\n" + "".join(diff) if diff else "")
+
+
+def tool_function(statement_text, solution_path, timeout=10):
+    timeout = int(timeout)
+    samples = extract_samples(statement_text)
+    if not samples:
+        return "No 'Sample Input N' / 'Sample Output N' blocks found in statement_text."
+    if not os.path.exists(solution_path):
+        return f"Solution file not found: {solution_path}"
+
+    out_parts = []
+    all_ok = True
+    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
+    workdir = tempfile.mkdtemp(prefix="sample_check_")
+    for idx, inp, expected in samples:
+        try:
+            proc = subprocess.run(
+                [sys.executable, "-I", os.path.abspath(solution_path)],
+                input=inp, capture_output=True, text=True, timeout=timeout,
+                cwd=workdir, env=env,
+            )
+            stdout, stderr, code = proc.stdout, proc.stderr, proc.returncode
+            timed_out = False
+        except subprocess.TimeoutExpired:
+            stdout, stderr, code, timed_out = "", "", None, True
+        exact = (not timed_out) and code == 0 and stdout.rstrip() == expected.rstrip()
+        all_ok = all_ok and exact
+        part = [f"=== Sample {idx} ===",
+                f"input: {inp!r}",
+                f"expected: {expected!r}",
+                f"actual:   {stdout!r}",
+                f"exit_code: {code}  timed_out: {timed_out}  exact_match: {exact}"]
+        if stderr.strip():
+            part.append("stderr:\n" + stderr[-3000:])
+        if not exact:
+            part.append("diff:\n" + _char_diff(expected.rstrip() + "\n", stdout.rstrip() + "\n"))
+        out_parts.append("\n".join(part))
+    out_parts.append(f"ALL SAMPLES EXACT: {all_ok}")
+    return "\n\n".join(out_parts)
