+    def _solution_written(self):
+        """True if solution.py exists, is non-trivial, and appears in the diff versus base commit."""
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.isfile(path):
+            return False
+        try:
+            with open(path, 'r') as f:
+                content = f.read()
+        except Exception:
+            return False
+        if len(''.join(content.split())) <= 20:
+            return False
+        return 'solution.py' in str(diff_versus_commit(self.git_tempdir, self.base_commit))
+
+    def _solution_file_exists(self):
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        return os.path.isfile(path)
+
+    @staticmethod
+    def _last_assistant_text(msg_history):
+        """Return the text of the last assistant message ('' if none), handling str/list/None content."""
+        for m in reversed(msg_history or []):
+            if m.get('role') != 'assistant':
+                continue
+            content = m.get('content')
+            if isinstance(content, str):
+                return content
+            texts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    t = block.get('text')
+                else:
+                    t = getattr(block, 'text', None)
+                if t:
+                    texts.append(t)
+            return '\n'.join(texts)
+        return ''
+
+    def _reply_failed(self, msg_history):
+        text = self._last_assistant_text(msg_history).strip()
+        return text == '' or text == '(no output)'
+
+    def _retry_prompt(self, attempt, file_exists):
+        """Progressively terser retry prompts."""
+        if file_exists:
+            head = (f"solution.py must contain the final solution; you have not edited it. "
+                    f"The file {self.git_tempdir}/solution.py currently has no real solution. "
+                    f"Use the editor tool `create` to write the full program to {self.git_tempdir}/solution.py now.")
+        else:
+            head = (f"Previous attempts produced no solution.py. Your FIRST action must be a single editor `create` tool call "
+                    f"writing the full program to {self.git_tempdir}/solution.py. Do not write long plans or explanations first. "
+                    f"After it is written, run it on the samples with bash and fix errors.")
+        if attempt == 0:
+            return (f"Problem statement:\n<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+                    f"{head}")
+        if attempt == 1:
+            return f"{head}\n\nProblem:\n{self.problem_statement}"
+        return f"{head}\n\nTool call first. Keep text minimal.\n\n{self.problem_statement}"
+
+    def _fallback_code_write(self):
+        """Last resort: ask for only code, extract the first ```python block and write it directly."""
+        prompt = (f"Reply with ONLY the complete Python program for this problem inside a single ```python code block. "
+                  f"No other text.\n\n<problem_description>\n{self.problem_statement}\n</problem_description>")
+        reply_history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        text = self._last_assistant_text(reply_history)
+        safe_log(f"Fallback reply length: {len(text)}")
+        start = text.find('```python')
+        if start == -1:
+            return False
+        start = text.find('\n', start)
+        end = text.find('```', start + 1)
+        if start == -1 or end == -1:
+            return False
+        code = text[start + 1:end]
+        if not code.strip():
+            return False
+        with open(os.path.join(self.git_tempdir, 'solution.py'), 'w') as f:
+            f.write(code)
+        return True
+
