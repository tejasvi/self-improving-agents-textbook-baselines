+SAMPLE_RE = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n## Task|\Z)',
+    re.S)
+N_CAND = 2      # candidates generated in Phase A
+MAX_CAND = 3    # extended to this many if no candidate passes the samples
+MAX_FIX_ITERS = 4
+
+
+def _extract_samples(problem_statement):
+    """Return a list of (input_text, expected_output_text) from 'Sample Input N / Sample Output N' blocks."""
+    samples = []
+    for m in SAMPLE_RE.finditer(problem_statement or ''):
+        inp = m.group(2).strip('\n') + '\n'
+        exp = m.group(3).strip()
+        samples.append((inp, exp))
+    return samples
+
+
+def _validate_solution(sol_path, stub_text, samples):
+    """Deterministic check of a solution file. Returns (n_passed, n_total, raw_report).
+    raw_report is '' when the file exists, differs from the stub, parses and passes every sample."""
+    n_total = len(samples)
+    if not os.path.isfile(sol_path):
+        return 0, n_total, f"missing file: {sol_path} does not exist"
+    with open(sol_path) as f:
+        text = f.read()
+    if text.strip() == (stub_text or '').strip():
+        return 0, n_total, f"{sol_path} is still the original stub (no solution written)"
+    try:
+        ast.parse(text)
+    except SyntaxError as e:
+        return 0, n_total, f"syntax error in {sol_path}:\n{type(e).__name__}: {e}"
+    sol_abs = os.path.abspath(sol_path)
+    n_pass = 0
+    reports = []
+    for i, (inp, exp) in enumerate(samples, 1):
+        try:
+            p = subprocess.run([sys.executable, '-I', sol_abs], input=inp, capture_output=True,
+                               text=True, timeout=10, cwd=os.path.dirname(sol_abs), errors='replace')
+            out, err, rc = p.stdout, p.stderr, p.returncode
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout if isinstance(e.stdout, str) else ''
+            err = (e.stderr if isinstance(e.stderr, str) else '') + '\n(timed out after 10 seconds)'
+            rc = 'TIMEOUT'
+        if rc == 0 and out.split() == exp.split():
+            n_pass += 1
+        else:
+            reports.append(f"sample {i} FAILED (rc={rc})\n--- stdin\n{inp}--- expected\n{exp}\n"
+                           f"--- stdout\n{out}\n--- stderr\n{err}")
+    if n_pass == n_total:
+        return n_pass, n_total, ''
+    return n_pass, n_total, "\n".join(reports)
+
+
+def _last_reply_empty(msg_history):
+    """True if there is no history or the last assistant message has no non-whitespace text."""
+    if not msg_history:
+        return True
+    last = msg_history[-1]
+    if last.get('role') != 'assistant':
+        return False
+    content = last.get('content')
+    if isinstance(content, str):
+        return content.strip() == ''
+    texts = [b.get('text') or '' for b in (content or []) if isinstance(b, dict)]
+    return ''.join(texts).strip() == ''
+
+
+def _fail_count(stress_report):
+    """Failure total from the stress_test summary line; unknown counts as worst."""
+    found = re.findall(r'total failures: (\d+)', stress_report or '')
+    return sum(int(x) for x in found) if found else 10 ** 9
+
