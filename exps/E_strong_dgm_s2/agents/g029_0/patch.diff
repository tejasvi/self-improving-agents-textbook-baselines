diff --git a/tools/float_fidelity.py b/tools/float_fidelity.py
new file mode 100644
index 0000000..17c5b16
--- /dev/null
+++ b/tools/float_fidelity.py
@@ -0,0 +1,171 @@
+import os
+import subprocess
+import sys
+import glob
+from decimal import Decimal, localcontext
+
+
+def tool_info():
+    return {
+        "name": "float_fidelity",
+        "description": """Check how well solution variants reproduce the sample outputs for real-valued answers.
+* `samples_dir` contains N.in / N.out pairs (the expected output text is N.out).
+* Each solution (solution_path and every entry of variant_paths) is run with `python3 -I` on every sample input.
+* For every (variant, sample) pair it returns raw data: expected text, actual text, the number of leading characters that match, and the absolute and relative difference of the numbers (computed with decimal at 50 digits, max over tokens; 'n/a' if the tokens are not numeric).
+* Also returns a matrix (variant x sample) of exact character-for-character matches and, per variant, whether it reproduces ALL samples exactly.
+* Use it to choose among computation variants (e.g. accumulated DP value, direct recomputation, math.fsum, Fraction rounded) whose printed digits must equal the reference output.
+* Returns raw data only; no error interpretation.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the main solution Python file."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing N.in and N.out sample files."
+                },
+                "variant_paths": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of alternative solution Python files to compare against the samples."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def _run(path, data, timeout):
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", path], input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        return out, "", None, True
+
+
+def _numeric_diff(actual, expected):
+    """Max absolute and relative difference over tokens (decimal, 50 digits). None if not comparable."""
+    a_tok = actual.split()
+    e_tok = expected.split()
+    if not a_tok or len(a_tok) != len(e_tok):
+        return None
+    max_abs = Decimal(0)
+    max_rel = Decimal(0)
+    with localcontext() as ctx:
+        ctx.prec = 50
+        for a, e in zip(a_tok, e_tok):
+            try:
+                da = Decimal(a)
+                de = Decimal(e)
+            except Exception:
+                return None
+            if not (da.is_finite() and de.is_finite()):
+                return None
+            d = abs(da - de)
+            scale = max(abs(da), abs(de))
+            r = d / scale if scale != 0 else Decimal(0)
+            max_abs = max(max_abs, d)
+            max_rel = max(max_rel, r)
+    return max_abs, max_rel
+
+
+def _leading_match(a, b):
+    n = 0
+    for x, y in zip(a, b):
+        if x != y:
+            break
+        n += 1
+    return n
+
+
+def _run_variant(path, samples, timeout):
+    rows = []
+    for in_file, out_file in samples:
+        with open(in_file) as f:
+            data = f.read()
+        with open(out_file) as f:
+            expected = f.read()
+        out, err, rc, to = _run(path, data, timeout)
+        exact = (not to) and rc == 0 and out == expected
+        nd = None if (to or rc != 0) else _numeric_diff(out, expected)
+        rows.append({
+            "sample": os.path.basename(in_file)[:-3],
+            "expected": expected,
+            "actual": out,
+            "exact": exact,
+            "leading_matching_chars": _leading_match(out, expected),
+            "abs_diff": "n/a" if nd is None else format(nd[0], "e"),
+            "rel_diff": "n/a" if nd is None else format(nd[1], "e"),
+            "status": "timeout" if to else (f"exit code {rc}" if rc != 0 else ""),
+            "stderr_tail": "\n".join(err.strip().splitlines()[-5:]) if err else "",
+        })
+    return rows
+
+
+def _fmt_block(text, limit=12):
+    lines = text.splitlines()
+    if len(lines) > limit:
+        lines = lines[:limit] + [f"... <{len(lines) - limit} more lines>"]
+    return "\n".join("    " + l for l in lines) if lines else "    <empty>"
+
+
+def tool_function(solution_path, samples_dir, variant_paths=None, timeout=10, true_value_script=None):
+    timeout = int(timeout)
+    samples = []
+    for in_file in sorted(glob.glob(os.path.join(samples_dir, "*.in"))):
+        out_file = in_file[:-3] + ".out"
+        if os.path.isfile(out_file):
+            samples.append((in_file, out_file))
+    if not samples:
+        return f"No N.in/N.out pairs found in {samples_dir}."
+    paths = [solution_path] + list(variant_paths or [])
+    results = {}
+    for p in paths:
+        if not os.path.isfile(p):
+            results[p] = None
+            continue
+        results[p] = _run_variant(p, samples, timeout)
+
+    lines = []
+    sample_names = [os.path.basename(s[0])[:-3] for s in samples]
+    # Summary matrix
+    lines.append("MATRIX (E = exact text match, X = differs), rows = variants, columns = samples")
+    header = "variant".ljust(40) + " " + " ".join(n[-6:].rjust(6) for n in sample_names) + "  all_exact"
+    lines.append(header)
+    for p in paths:
+        label = os.path.basename(p)[:40].ljust(40)
+        if results[p] is None:
+            lines.append(label + " file not found")
+            continue
+        cells = " ".join(("E" if r["exact"] else "X").rjust(6) for r in results[p])
+        all_exact = all(r["exact"] for r in results[p])
+        lines.append(label + " " + cells + "  " + ("YES" if all_exact else "no"))
+    lines.append("")
+    # Raw details
+    for p in paths:
+        lines.append(f"=== {p} ===")
+        if results[p] is None:
+            lines.append("  file not found")
+            continue
+        for r in results[p]:
+            lines.append(f"[{r['sample']}] exact={r['exact']} leading_matching_chars={r['leading_matching_chars']} "
+                         f"abs_diff={r['abs_diff']} rel_diff={r['rel_diff']} {r['status']}".rstrip())
+            if not r["exact"]:
+                lines.append("  expected:")
+                lines.append(_fmt_block(r["expected"]))
+                lines.append("  actual:")
+                lines.append(_fmt_block(r["actual"]))
+                if r["stderr_tail"]:
+                    lines.append("  stderr (tail):")
+                    lines.append(_fmt_block(r["stderr_tail"], 5))
+    return "\n".join(lines)
