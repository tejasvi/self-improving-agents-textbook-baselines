diff --git a/tools/portability_lint.py b/tools/portability_lint.py
new file mode 100644
index 0000000..6cdaca4
--- /dev/null
+++ b/tools/portability_lint.py
@@ -0,0 +1,222 @@
+import ast
+
+# ---------------------------------------------------------------------------
+# Rule table. Each rule is a dict with:
+#   id          : short identifier shown in the report
+#   kind        : how the rule matches (see _match)
+#   name        : the name / attribute / module member it targets
+#   nargs       : optional exact positional-argument count to match (None = any)
+#   keyword     : optional keyword-argument name that must be present
+#   no_args     : if True, match only calls with zero positional args and no keywords
+#   reason      : why this construct is risky for a grader on another interpreter
+#   replacement : suggested portable replacement
+#
+# Kinds:
+#   'builtin_call'  : bare call  name(...)                       (e.g. pow(a,b,c))
+#   'method_call'   : attribute call  <expr>.name(...)           (e.g. x.bit_count())
+#   'module_call'   : attribute call  <module>.name(...)         (e.g. math.isqrt(x))
+#   'module_attr'   : any attribute access  <module>.name        (e.g. functools.cache)
+#   'bare_import'   : bare name imported via `from <module> import name`
+#                     and then used (e.g. cache as decorator)
+#   'walrus'        : assignment expression  (:=)
+#   'match'         : match/case statement
+#   'future'        : `from __future__ import X` for any X other than annotations
+# To extend the lint, append a new dict to RULES.
+# ---------------------------------------------------------------------------
+RULES = [
+    dict(id="pow3", kind="builtin_call", name="pow", nargs=3, reason="3-argument pow() is rejected by some interpreters/graders (TypeError: pow expected 2 arguments, got 3)", replacement="def modpow(b, e, m):\n    r = 1 % m\n    b %= m\n    while e > 0:\n        if e & 1:\n            r = r * b % m\n        b = b * b % m\n        e >>= 1\n    return r"),
+    dict(id="math_comb", kind="module_call", module="math", name="comb", reason="math.comb is Python 3.8+ only", replacement="hand-written nCr via factorial tables or Pascal rows"),
+    dict(id="math_perm", kind="module_call", module="math", name="perm", reason="math.perm is Python 3.8+ only", replacement="hand-written product loop"),
+    dict(id="math_isqrt", kind="module_call", module="math", name="isqrt", reason="math.isqrt is Python 3.8+ only", replacement="def isqrt(n):\n    r = int(n ** 0.5)\n    while r * r > n:\n        r -= 1\n    while (r + 1) * (r + 1) <= n:\n        r += 1\n    return r"),
+    dict(id="math_lcm", kind="module_call", module="math", name="lcm", reason="math.lcm is Python 3.9+ only", replacement="def lcm(a, b):\n    g = a\n    h = b\n    while h:\n        g, h = h, g % h\n    return a // g * b"),
+    dict(id="math_prod", kind="module_call", module="math", name="prod", reason="math.prod is Python 3.8+ only", replacement="hand-written loop multiplying into a variable"),
+    dict(id="math_cbrt", kind="module_call", module="math", name="cbrt", reason="math.cbrt is Python 3.11+ only", replacement="integer search or round(x ** (1/3)) with an exact check"),
+    dict(id="math_exp2", kind="module_call", module="math", name="exp2", reason="math.exp2 is Python 3.11+ only", replacement="2.0 ** x or 1 << k for integers"),
+    dict(id="bit_count", kind="method_call", name="bit_count", no_args=True, reason="int.bit_count is Python 3.10+ only", replacement="bin(x).count('1')"),
+    dict(id="is_integer", kind="method_call", name="is_integer", no_args=True, reason="float.is_integer is Python 3.12+ on some builds; not portable", replacement="x == int(x)"),
+    dict(id="removeprefix", kind="method_call", name="removeprefix", reason="str.removeprefix is Python 3.9+ only", replacement="s[len(p):] if s.startswith(p) else s"),
+    dict(id="removesuffix", kind="method_call", name="removesuffix", reason="str.removesuffix is Python 3.9+ only", replacement="s[:-len(p)] if p and s.endswith(p) else s"),
+    dict(id="functools_cache", kind="module_attr", module="functools", name="cache", reason="functools.cache is Python 3.9+ only", replacement="functools.lru_cache(maxsize=None) or an explicit dict memo"),
+    dict(id="functools_cache_bare", kind="bare_import", module="functools", name="cache", reason="functools.cache is Python 3.9+ only", replacement="functools.lru_cache(maxsize=None) or an explicit dict memo"),
+    dict(id="itertools_pairwise", kind="module_attr", module="itertools", name="pairwise", reason="itertools.pairwise is Python 3.10+ only", replacement="zip(xs, xs[1:])"),
+    dict(id="itertools_batched", kind="module_attr", module="itertools", name="batched", reason="itertools.batched is Python 3.12+ only", replacement="explicit index slicing loop"),
+    dict(id="itertools_pairwise_bare", kind="bare_import", module="itertools", name="pairwise", reason="itertools.pairwise is Python 3.10+ only", replacement="zip(xs, xs[1:])"),
+    dict(id="itertools_batched_bare", kind="bare_import", module="itertools", name="batched", reason="itertools.batched is Python 3.12+ only", replacement="explicit index slicing loop"),
+    dict(id="zip_strict", kind="builtin_call", name="zip", keyword="strict", reason="zip(strict=...) is Python 3.10+ only", replacement="zip(a, b) after an explicit length check"),
+    dict(id="walrus", kind="walrus", reason="assignment expressions (:=) are Python 3.8+ only", replacement="separate assignment statement"),
+    dict(id="match_stmt", kind="match", reason="match/case statements are Python 3.10+ only", replacement="if/elif chain"),
+    dict(id="sys_int_max_str_digits", kind="module_call", module="sys", name="set_int_max_str_digits", reason="sys.set_int_max_str_digits exists only on newer patched interpreters", replacement="remove the call; avoid converting huge ints to str"),
+    dict(id="to_bytes_noargs", kind="method_call", name="to_bytes", no_args=True, reason="int.to_bytes() without arguments is Python 3.11+ only", replacement="x.to_bytes(length, 'big')"),
+    dict(id="future_import", kind="future", reason="unusual __future__ import; only 'annotations' is safe", replacement="remove the __future__ import"),
+]
+
+
+def tool_info():
+    return {
+        "name": "portability_lint",
+        "description": """Statically scan a Python solution file for constructs that are narrowly supported (version-specific or interpreter-specific) and may crash on a grader running a different Python version. Parses the file with ast and returns a raw report: one entry per hit with line number, code snippet, the reason, and a suggested portable replacement. Returns 'no portability issues found' if clean.
+* Checks 3-argument pow(), math.comb/perm/isqrt/lcm/prod/cbrt/exp2, int.bit_count(), float.is_integer(), str.removeprefix/removesuffix, functools.cache, itertools.pairwise/batched, zip(strict=...), walrus (:=), match statements, sys.set_int_max_str_digits, int.to_bytes() with no args, and unusual __future__ imports.
+* Use extra_banned to additionally flag any name or attribute (e.g. a function name you want to forbid) in this file.
+* Output is raw; read each hit and replace it with a hand-written portable helper.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the Python solution file to lint."},
+                "extra_banned": {"type": "array", "items": {"type": "string"}, "description": "Optional extra names or attributes to flag wherever they appear as a name, attribute, or call target."}
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _snippet(source_lines, lineno):
+    if lineno is None or lineno < 1 or lineno > len(source_lines):
+        return ""
+    return source_lines[lineno - 1].strip()
+
+
+def _callee_parts(func):
+    """Return (base_name, attr) for a call target: pow -> (None,'pow'), math.comb -> ('math','comb'),
+    x.bit_count -> ('?', 'bit_count'). base_name is None for bare names."""
+    if isinstance(func, ast.Name):
+        return None, func.id
+    if isinstance(func, ast.Attribute):
+        base = func.value.id if isinstance(func.value, ast.Name) else "?"
+        return base, func.attr
+    return None, None
+
+
+def _module_aliases(tree):
+    """Map local alias -> real module name for plain `import x [as y]` statements."""
+    aliases = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for a in node.names:
+                aliases[a.asname or a.name.split('.')[0]] = a.name.split('.')[0]
+    return aliases
+
+
+def _bare_imports(tree):
+    """Map local name -> module for `from <module> import name [as alias]`."""
+    names = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+            for a in node.names:
+                names[a.asname or a.name] = (node.module.split('.')[0], a.name)
+    return names
+
+
+def _check_rules(tree, extra_banned):
+    """Yield (lineno, rule_id, reason, replacement) for each hit."""
+    aliases = _module_aliases(tree)
+    bare = _bare_imports(tree)
+    for node in ast.walk(tree):
+        lineno = getattr(node, 'lineno', None)
+
+        if isinstance(node, ast.Call):
+            base, attr = _callee_parts(node.func)
+            real_base = aliases.get(base, base) if base else None
+            n_pos = len(node.args)
+            kw_names = [k.arg for k in node.keywords]
+            no_args = (n_pos == 0 and not node.keywords)
+            for rule in RULES:
+                kind = rule['kind']
+                if kind == 'builtin_call':
+                    if base is None and attr == rule['name']:
+                        if rule.get('nargs') is not None and n_pos != rule['nargs']:
+                            continue
+                        if rule.get('keyword') and rule['keyword'] not in kw_names:
+                            continue
+                        yield lineno, rule['id'], rule['reason'], rule['replacement']
+                elif kind == 'method_call':
+                    if base is not None and attr == rule['name']:
+                        if rule.get('no_args') and not no_args:
+                            continue
+                        if real_base in ('math', 'sys', 'functools', 'itertools'):
+                            continue  # module functions are handled by module_call rules
+                        yield lineno, rule['id'], rule['reason'], rule['replacement']
+                elif kind == 'module_call':
+                    if attr == rule['name'] and real_base == rule['module']:
+                        yield lineno, rule['id'], rule['reason'], rule['replacement']
+                    elif base is None and attr == rule['name'] and bare.get(attr, (None,))[0] == rule['module']:
+                        yield lineno, rule['id'], rule['reason'], rule['replacement']
+                # 'bare_import' rules are handled on Name nodes below
+
+        if isinstance(node, ast.Attribute):
+            base = node.value.id if isinstance(node.value, ast.Name) else None
+            real_base = aliases.get(base, base) if base else None
+            for rule in RULES:
+                if rule['kind'] == 'module_attr' and node.attr == rule['name'] and real_base == rule['module']:
+                    yield lineno, rule['id'], rule['reason'], rule['replacement']
+
+        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
+            info = bare.get(node.id)
+            for rule in RULES:
+                if rule['kind'] == 'bare_import' and info and info[0] == rule['module'] and info[1] == rule['name']:
+                    yield lineno, rule['id'], rule['reason'], rule['replacement']
+
+        if isinstance(node, ast.NamedExpr):
+            for rule in RULES:
+                if rule['kind'] == 'walrus':
+                    yield lineno, rule['id'], rule['reason'], rule['replacement']
+
+        if type(node).__name__ == 'Match':  # ast.Match is absent before Python 3.10
+            for rule in RULES:
+                if rule['kind'] == 'match':
+                    yield lineno, rule['id'], rule['reason'], rule['replacement']
+
+        if isinstance(node, ast.ImportFrom) and node.module == '__future__':
+            for a in node.names:
+                if a.name != 'annotations':
+                    for rule in RULES:
+                        if rule['kind'] == 'future':
+                            yield lineno, rule['id'], rule['reason'], rule['replacement']
+
+        if extra_banned:
+            ident = None
+            if isinstance(node, ast.Name):
+                ident = node.id
+            elif isinstance(node, ast.Attribute):
+                ident = node.attr
+            elif isinstance(node, ast.alias):
+                ident = node.name.split('.')[0]
+            if ident is not None and ident in extra_banned:
+                yield lineno, 'extra_banned', f"'{ident}' is on the extra_banned list", "use a different construct"
+
+
+def tool_function(solution_path, extra_banned=None):
+    try:
+        with open(solution_path, 'r', errors='replace') as f:
+            source = f.read()
+    except Exception as e:
+        return f"Error: cannot read {solution_path}: {e}"
+
+    if isinstance(extra_banned, str):
+        extra_banned = [extra_banned]
+    extra_banned = [str(x) for x in (extra_banned or [])]
+
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return f"SyntaxError while parsing {solution_path}: line {e.lineno}: {e.msg}"
+
+    lines = source.splitlines()
+    hits = []
+    seen = set()
+    for lineno, rid, reason, repl in _check_rules(tree, extra_banned):
+        key = (lineno, rid)
+        if key in seen:
+            continue
+        seen.add(key)
+        hits.append((lineno if lineno is not None else 0, rid, reason, repl))
+    hits.sort(key=lambda h: (h[0], h[1]))
+
+    if not hits:
+        return "no portability issues found"
+
+    out = [f"{len(hits)} portability hit(s) in {solution_path}:"]
+    for lineno, rid, reason, repl in hits:
+        out.append(f"line {lineno} [{rid}]: {_snippet(lines, lineno)}")
+        out.append(f"  reason: {reason}")
+        out.append(f"  replacement: {repl}")
+    return "\n".join(out)
