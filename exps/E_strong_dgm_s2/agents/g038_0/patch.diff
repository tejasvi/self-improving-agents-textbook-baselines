+# ---------------------------------------------------------------------------
+# Compliance scan (utils/compliance.py equivalent)
+# ---------------------------------------------------------------------------
+
+BANNED_MODULES = {"threading", "multiprocessing"}
+
+
+def find_violations(source):
+    """Return a list of (lineno, message) for rule violations in the source."""
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return [(e.lineno or 0, "syntax error: %s" % e.msg)]
+
+    out = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            f = node.func
+            if isinstance(f, ast.Name) and f.id == "pow":
+                if len(node.args) + len(node.keywords) >= 3:
+                    out.append((node.lineno,
+                                "3-argument pow() is not supported by the grader; "
+                                "use a hand-written modular exponentiation loop"))
+            if isinstance(f, ast.Attribute) and f.attr == "setrecursionlimit":
+                out.append((node.lineno,
+                            "sys.setrecursionlimit is not allowed; use an iterative approach"))
+        elif isinstance(node, ast.Import):
+            for a in node.names:
+                root = a.name.split(".")[0]
+                if root in BANNED_MODULES:
+                    out.append((node.lineno, "import of '%s' is not allowed" % root))
+                if root == "numpy":
+                    out.append((node.lineno, "numpy is not allowed; use pure Python"))
+        elif isinstance(node, ast.ImportFrom):
+            root = (node.module or "").split(".")[0]
+            if root in BANNED_MODULES:
+                out.append((node.lineno, "import of '%s' is not allowed" % root))
+            if root == "numpy":
+                out.append((node.lineno, "numpy is not allowed; use pure Python"))
+        elif isinstance(node, ast.While):
+            if isinstance(node.test, ast.Constant) and node.test.value is True:
+                out.append((node.lineno, "'while True' loops are not allowed; use bounded loops"))
+    out.sort()
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Statement parsing (method_check equivalent)
+# ---------------------------------------------------------------------------
+
+def is_method_task(statement):
+    return "class Solution" in statement or "Implement the method" in statement
+
+
+def split_top_level(s):
+    """Split on commas that are not nested in brackets or quotes."""
+    parts, depth, cur, quote = [], 0, [], None
+    for ch in s:
+        if quote:
+            cur.append(ch)
+            if ch == quote:
+                quote = None
+            continue
+        if ch in "\"'":
+            quote = ch
+            cur.append(ch)
+            continue
+        if ch in "([{":
+            depth += 1
+        elif ch in ")]}":
+            depth -= 1
+        if ch == "," and depth == 0:
+            parts.append("".join(cur).strip())
+            cur = []
+        else:
+            cur.append(ch)
+    tail = "".join(cur).strip()
+    if tail:
+        parts.append(tail)
+    return parts
+
+
+def parse_examples(statement):
+    """Return list of dicts: {'input': str, 'args': [str], 'expected': str}."""
+    examples = []
+    pattern = re.compile(r'Input:\s*(.+?)\s+Output:\s*(.+?)\s*(?:\n|$)')
+    for m in pattern.finditer(statement):
+        inp, exp = m.group(1).strip(), m.group(2).strip()
+        args = []
+        for part in split_top_level(inp):
+            if "=" in part:
+                args.append(part.split("=", 1)[1].strip())
+            else:
+                args.append(part)
+        examples.append({"input": inp, "args": args, "expected": exp})
+    return examples
+
+
+# ---------------------------------------------------------------------------
+# Child runner for method calls
+# ---------------------------------------------------------------------------
+
+CHILD = r'''
+import sys, json, ast, importlib.util, traceback
+path = sys.argv[1]
+args_reprs = json.loads(sys.argv[2])
+try:
+    spec = importlib.util.spec_from_file_location("_sol", path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    cls = getattr(mod, "Solution")
+    obj = cls()
+    names = [n for n, v in vars(cls).items() if not n.startswith("_") and callable(v)]
+    if not names:
+        raise RuntimeError("no public method found in Solution")
+    name = names[0]
+    args = [ast.literal_eval(a) for a in args_reprs]
+    res = getattr(obj, name)(*args)
+    print(json.dumps({"method": name, "result": repr(res)}))
+except Exception:
+    traceback.print_exc()
+    sys.exit(1)
+'''
+
+
+def run_method(solution_src, args, timeout):
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "_sol.py")
+        with open(p, "w", encoding="utf-8") as f:
+            f.write(solution_src)
+        try:
+            r = subprocess.run(
+                [sys.executable, "-I", "-c", CHILD, p, json.dumps(args)],
+                stdin=subprocess.DEVNULL, capture_output=True, text=True,
+                timeout=timeout, cwd=d)
+        except subprocess.TimeoutExpired:
+            return None, "TIMEOUT after %ss" % timeout
+        if r.returncode != 0:
+            return None, (r.stderr or "").strip() or "non-zero exit %d" % r.returncode
+        try:
+            data = json.loads(r.stdout.strip().splitlines()[-1])
+            return data["result"], None
+        except Exception:
+            return None, "could not parse child output: %r" % r.stdout[:500]
+
+
+def values_equal(expected_text, actual_text):
+    try:
+        exp = ast.literal_eval(expected_text)
+    except Exception:
+        exp = expected_text
+    try:
+        act = ast.literal_eval(actual_text)
+    except Exception:
+        act = actual_text
+    if exp == act:
+        return True
+    return str(exp).strip() == str(act).strip()
+
+
+def check_method(solution_src, statement, timeout):
+    results = []
+    for ex in parse_examples(statement):
+        rec = {"input": ex["input"], "expected": ex["expected"]}
+        actual, err = run_method(solution_src, ex["args"], timeout)
+        if err is not None:
+            rec.update({"status": "FAIL", "actual": None, "traceback": err})
+        else:
+            rec["actual"] = actual
+            ok = values_equal(ex["expected"], actual)
+            rec.update({"status": "PASS" if ok else "FAIL", "traceback": ""})
+        results.append(rec)
+    return results
+
+
+# ---------------------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------------------
+
+def main():
+    raw = sys.stdin.read()
+    try:
+        data = json.loads(raw)
+    except Exception:
+        data = None
+    if not isinstance(data, dict):
+        print(json.dumps({"error": "input must be a JSON object with 'solution' and 'statement'"}))
+        return
+    solution = data.get("solution", "") or ""
+    statement = data.get("statement", "") or ""
+    timeout = int(data.get("timeout", 10) or 10)
+
+    violations = [{"line": ln, "message": msg} for ln, msg in find_violations(solution)]
+    method = is_method_task(statement)
+
+    report = {
+        "method_task": method,
+        "compliance_violations": violations,
+        "examples": [],
+        "ok": not violations,
+    }
+
+    if method:
+        examples = check_method(solution, statement, timeout)
+        report["examples"] = examples
+        if any(e["status"] != "PASS" for e in examples):
+            report["ok"] = False
+    else:
+        report["note"] = ("not a class-method task: stdin-based sample checking "
+                          "is not performed by this checker")
+
+    if violations:
+        report["repair_hint"] = ("Fix these lines before finalizing: " +
+                                 "; ".join("line %d: %s" % (v["line"], v["message"])
+                                           for v in violations))
+
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
