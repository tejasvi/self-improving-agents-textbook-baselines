diff --git a/tools/method_check.py b/tools/method_check.py
new file mode 100644
index 0000000..9c7a6c8
--- /dev/null
+++ b/tools/method_check.py
@@ -0,0 +1,272 @@
+import ast
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import time
+
+
+MARK = '__METHOD_CHECK_RESULT__:'
+
+# Child process: imports the solution file by path, instantiates Solution, calls one public
+# method positionally with the parsed arguments and prints repr(result) with a marker.
+CHILD_SCRIPT = r'''
+import ast, importlib.util, sys
+path, method, marker = sys.argv[1], sys.argv[2], sys.argv[3]
+args = ast.literal_eval(sys.stdin.read())
+spec = importlib.util.spec_from_file_location("_method_sol", path)
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+sol = mod.Solution()
+result = getattr(sol, method)(*args)
+print(marker + repr(result), flush=True)
+'''
+
+
+def tool_info():
+    return {
+        "name": "method_check",
+        "description": """Check a class-method solution (LeetCode style: `class Solution` with one public method called by hidden tests) against the examples in the problem statement.
+* Parses every 'Input: name = value, ...' followed by 'Output: value' example in the statement.
+* Imports Solution from solution_path in a clean `python3 -I` child process, calls the public method with the parsed arguments (positionally, in the order written in the statement), and compares the returned value with the expected output by value.
+* Returns raw PASS/FAIL per example with the expected value, the actual value, and any traceback.
+* Use this instead of sample_check for method tasks. Do NOT add a stdin `__main__` block to such solutions; sample_check and fuzz tools that run solution.py as a stdin program are not meaningful for method tasks.
+* If the statement is not a method task (no 'class Solution' or 'Implement the method'), it falls back to sample_check.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file that defines class Solution."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the 'Input:' / 'Output:' examples."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-example time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+
+def is_method_task(statement):
+    return 'class Solution' in statement or 'Implement the method' in statement
+
+
+EXAMPLE_RE = re.compile(
+    r'Input:[ \t]*(?P<inp>.+?)\s+Output:[ \t]*(?P<out>[^\n]*?)[ \t]*(?=\n|$|Explanation:)',
+    re.DOTALL,
+)
+
+
+def extract_examples(statement):
+    """Return a list of (input_text, output_text) pairs found in 'Input: ... Output: ...' blocks."""
+    text = (statement or '').replace('\r\n', '\n').replace('\r', '\n')
+    examples = []
+    for m in EXAMPLE_RE.finditer(text):
+        inp = m.group('inp').strip()
+        out = m.group('out').strip()
+        if inp and out:
+            examples.append((inp, out))
+    return examples
+
+
+def split_top_level(text, sep=','):
+    """Split text at separators that are not inside brackets or quotes."""
+    parts = []
+    depth = 0
+    quote = None
+    cur = []
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if quote:
+            cur.append(ch)
+            if ch == '\\' and i + 1 < len(text):
+                cur.append(text[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                quote = None
+        elif ch in '"\'':
+            quote = ch
+            cur.append(ch)
+        elif ch in '([{':
+            depth += 1
+            cur.append(ch)
+        elif ch in ')]}':
+            depth -= 1
+            cur.append(ch)
+        elif ch == sep and depth == 0:
+            parts.append(''.join(cur).strip())
+            cur = []
+        else:
+            cur.append(ch)
+        i += 1
+    tail = ''.join(cur).strip()
+    if tail:
+        parts.append(tail)
+    return parts
+
+
+def _literal(text):
+    """Parse a Python/JSON-like literal. Returns (ok, value_or_error)."""
+    try:
+        return True, ast.literal_eval(text)
+    except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError) as e:
+        pass
+    fixed = re.sub(r'\btrue\b', 'True', text)
+    fixed = re.sub(r'\bfalse\b', 'False', fixed)
+    fixed = re.sub(r'\bnull\b', 'None', fixed)
+    try:
+        return True, ast.literal_eval(fixed)
+    except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError) as e:
+        return False, f"not a literal: {text!r} ({e})"
+
+
+def parse_input(inp):
+    """Parse 'name = value, name2 = value2' into (ok, list_of_(name, value)_or_error)."""
+    pairs = []
+    for piece in split_top_level(inp, ','):
+        if '=' not in piece:
+            return False, f"cannot parse argument (no '='): {piece!r}"
+        name, _, raw = piece.partition('=')
+        name = name.strip()
+        if not re.fullmatch(r'[A-Za-z_][A-Za-z_0-9]*', name):
+            return False, f"invalid argument name: {name!r}"
+        ok, val = _literal(raw.strip())
+        if not ok:
+            return False, val
+        pairs.append((name, val))
+    return True, pairs
+
+
+def _public_method(source):
+    """Return the name of the single public method of class Solution (first one if several)."""
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return None, f"solution does not parse: {e.msg} (line {e.lineno})"
+    for node in tree.body:
+        if isinstance(node, ast.ClassDef) and node.name == 'Solution':
+            names = [n.name for n in node.body
+                     if isinstance(n, ast.FunctionDef) and not n.name.startswith('_')]
+            if not names:
+                return None, "class Solution has no public method"
+            return names[0], None
+    return None, "no class Solution found in the solution file"
+
+
+def _call(solution_path, method, args_pairs, timeout):
+    """Run one example in a clean child process. Returns dict with status and raw text."""
+    args_literal = repr([v for _, v in args_pairs])
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    start = time.time()
+    with tempfile.TemporaryDirectory() as tmp:
+        child = os.path.join(tmp, '_child.py')
+        with open(child, 'w') as f:
+            f.write(CHILD_SCRIPT)
+        try:
+            p = subprocess.run(
+                [sys.executable, '-I', child, solution_path, method, MARK],
+                input=args_literal, capture_output=True, text=True, cwd=tmp, env=env,
+                timeout=timeout, errors='replace')
+        except subprocess.TimeoutExpired as e:
+            err = e.stderr if isinstance(e.stderr, str) else ''
+            return {'ok': False, 'timeout': True, 'stderr': err, 'value': None,
+                    'elapsed': time.time() - start}
+    value_text = None
+    for line in p.stdout.splitlines():
+        if line.startswith(MARK):
+            value_text = line[len(MARK):]
+    if p.returncode != 0 or value_text is None:
+        return {'ok': False, 'timeout': False, 'stderr': p.stderr, 'value': None,
+                'elapsed': time.time() - start, 'returncode': p.returncode}
+    try:
+        value = ast.literal_eval(value_text)
+    except (ValueError, SyntaxError, TypeError, MemoryError, RecursionError):
+        return {'ok': True, 'timeout': False, 'stderr': p.stderr, 'value': None,
+                'raw_value': value_text, 'elapsed': time.time() - start}
+    return {'ok': True, 'timeout': False, 'stderr': p.stderr, 'value': value,
+            'raw_value': value_text, 'elapsed': time.time() - start}
+
+
+def _clip(s, n=3000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def tool_function(solution_path, problem_statement, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    statement = problem_statement or ''
+    if not is_method_task(statement):
+        from tools import sample_check
+        return sample_check.tool_function(solution_path, statement, timeout=timeout)
+
+    solution_path = os.path.abspath(solution_path)
+    with open(solution_path, 'r', errors='replace') as f:
+        source = f.read()
+    method, err = _public_method(source)
+    if err:
+        return f"Method check: FAIL (cannot locate the method)\n{err}"
+
+    examples = extract_examples(statement)
+    if not examples:
+        return "No 'Input: ... Output: ...' examples found in the problem statement."
+
+    reports = []
+    passed = failed = suspect = 0
+    for idx, (inp, exp_text) in enumerate(examples, 1):
+        ok_in, parsed = parse_input(inp)
+        ok_exp, expected = _literal(exp_text)
+        block = [f"Example {idx}:", "--- input ---", inp, "--- expected output ---", exp_text]
+        if not ok_in:
+            suspect += 1
+            reports.append('\n'.join(block + [f"Example {idx}: SUSPECT (could not parse input: {parsed})"]))
+            continue
+        if not ok_exp:
+            suspect += 1
+            reports.append('\n'.join(block + [f"Example {idx}: SUSPECT (could not parse expected output: {expected})"]))
+            continue
+        res = _call(solution_path, method, parsed, timeout)
+        if res.get('timeout'):
+            failed += 1
+            reports.append('\n'.join(block + [f"Example {idx}: FAIL (timed out after {timeout} seconds)",
+                                              "--- stderr ---", _clip(res['stderr'] or '(empty)')]))
+            continue
+        if not res['ok']:
+            failed += 1
+            reports.append('\n'.join(block + [f"Example {idx}: FAIL (exception or exit code {res.get('returncode')})",
+                                              "--- traceback ---", _clip(res['stderr'].rstrip() or '(empty)')]))
+            continue
+        if res['value'] is None and 'raw_value' in res:
+            suspect += 1
+            reports.append('\n'.join(block + [f"Example {idx}: SUSPECT (returned value is not a literal: {res['raw_value']})"]))
+            continue
+        actual = res['value']
+        match = actual == expected
+        if match:
+            passed += 1
+            label = 'PASS'
+        else:
+            failed += 1
+            label = 'FAIL'
+        block += ["--- actual output (repr) ---", res.get('raw_value', repr(actual))]
+        if res['stderr'].strip():
+            block += ["--- stderr ---", _clip(res['stderr'].rstrip())]
+        reports.append('\n'.join(block + [f"Example {idx}: {label}"]))
+
+    summary = (f"Method check of {method}(): examples: {len(examples)}, passed: {passed}, "
+               f"failed: {failed}, suspect (not counted): {suspect}")
+    return summary + "\n\n" + "\n\n".join(reports)
diff --git a/utils/compliance.py b/utils/compliance.py
new file mode 100644
index 0000000..b30c56d
--- /dev/null
+++ b/utils/compliance.py
@@ -0,0 +1,48 @@
+"""Static compliance scan for generated solutions.
+
+`find_violations(source)` returns a list of (lineno, message) tuples. Each message is a raw,
+human-readable description. Violations are hard errors for the grader (for example 3-argument
+pow fails on the grading runtime), so the coding agent must fix them.
+"""
+import ast
+
+FRAGILE_MODULES = {'threading', 'resource', 'multiprocessing', 'signal', 'ctypes'}
+FRAGILE_CALLS = {'setrecursionlimit', 'setswitchinterval', 'stack_size'}
+FORBIDDEN_MODULES = {'numpy'}
+
+
+def find_violations(source):
+    """Return a list of (lineno, message) for constructs the grader does not accept."""
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return [(e.lineno or 0, f"source does not parse: {e.msg}")]
+    found = []
+    for node in ast.walk(tree):
+        lineno = getattr(node, 'lineno', 0)
+        if isinstance(node, ast.Call):
+            func = node.func
+            if isinstance(func, ast.Name) and func.id == 'pow' and len(node.args) + len(node.keywords) == 3:
+                found.append((lineno, "3-argument pow(...) is rejected by the grader (TypeError: pow expected 2 arguments, got 3); write a loop-based modular power instead"))
+            elif isinstance(func, ast.Name) and func.id in FRAGILE_CALLS:
+                found.append((lineno, f"call to {func.id}(...) is not allowed"))
+            elif isinstance(func, ast.Attribute) and func.attr in FRAGILE_CALLS:
+                found.append((lineno, f"call to .{func.attr}(...) is not allowed"))
+        elif isinstance(node, ast.Import):
+            for a in node.names:
+                top = a.name.split('.')[0]
+                if top in FRAGILE_MODULES:
+                    found.append((lineno, f"import of {a.name} is not allowed"))
+                elif top in FORBIDDEN_MODULES:
+                    found.append((lineno, f"import of {a.name} is not allowed (only the standard library is guaranteed)"))
+        elif isinstance(node, ast.ImportFrom):
+            top = (node.module or '').split('.')[0]
+            if top in FRAGILE_MODULES:
+                found.append((lineno, f"import from {node.module} is not allowed"))
+            elif top in FORBIDDEN_MODULES:
+                found.append((lineno, f"import from {node.module} is not allowed (only the standard library is guaranteed)"))
+        elif isinstance(node, ast.While):
+            if isinstance(node.test, ast.Constant) and node.test.value is True:
+                found.append((lineno, "'while True' loop is not allowed; use a bounded for loop"))
+    found.sort()
+    return found
