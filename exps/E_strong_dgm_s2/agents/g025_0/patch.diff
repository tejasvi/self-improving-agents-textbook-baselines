index 0000000..be185fc
--- /dev/null
+++ b/tools/precision_audit.py
@@ -0,0 +1,177 @@
+import os
+import sys
+import math
+from decimal import Decimal, getcontext
+
+_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if _ROOT not in sys.path:
+    sys.path.insert(0, _ROOT)
+
+from tools.stress_compare import NUM_RE, _run, _clip  # reuse number parsing and subprocess runner
+
+getcontext().prec = 80
+
+
+def tool_info():
+    return {
+        "name": "precision_audit",
+        "description": """Audit the numeric precision of a solution against a high-precision reference on explicit inputs.\n
+* `inputs` is an array of stdin texts (e.g. max-size random, all-max-value, extreme-value and near-tie inputs). Each one is run through both programs with `python3 -I`.
+* For every numeric token pair it reports the absolute error, the relative error and the ULP distance (error divided by math.ulp of the reference value).
+* Cases whose ULP distance exceeds `max_ulp` are flagged as FAIL. Outputs with fewer than 15 significant digits are flagged as WARN.
+* Raw input, solution output and reference output are printed for every flagged case. Only numeric comparison is done; no other error interpretation.
+* The reference should use exact or high-precision arithmetic (fractions.Fraction or decimal) of the same algorithm.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file to audit."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the high-precision reference Python file (Fraction/Decimal based)."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin texts to run both programs on."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each program (default 20)."
+                },
+                "max_ulp": {
+                    "type": "number",
+                    "description": "Maximum allowed ULP distance per numeric token before a case is flagged (default 4)."
+                }
+            },
+            "required": ["solution_path", "reference_path", "inputs"]
+        }
+    }
+
+
+def _sig_digits(tok):
+    """Number of significant digits printed in a numeric token (only for tokens with a decimal point)."""
+    t = tok.lstrip('+-')
+    mant = t.split('e')[0].split('E')[0]
+    if '.' not in mant:
+        return None
+    digits = mant.replace('.', '').lstrip('0')
+    return len(digits)
+
+
+def _ulp_error(sol_tok, ref_tok):
+    """Return (abs_err, rel_err, ulp_dist) as floats, computed with Decimal for the difference."""
+    ds = Decimal(sol_tok)
+    dr = Decimal(ref_tok)
+    diff = abs(ds - dr)
+    abs_err = float(diff)
+    ref_f = float(dr)
+    rel_err = abs_err / max(abs(ref_f), 1e-300) if ref_f != 0 else abs_err
+    u = math.ulp(ref_f) if ref_f != 0 else math.ulp(1e-300)
+    ulp_dist = float(diff / Decimal(u))
+    return abs_err, rel_err, ulp_dist
+
+
+def _audit_one(sol_out, ref_out, max_ulp):
+    """Compare two outputs token by token. Returns dict with worst stats and flags."""
+    ta = sol_out.split()
+    tb = ref_out.split()
+    res = {'tokens': len(ta), 'max_abs': 0.0, 'max_rel': 0.0, 'max_ulp': 0.0,
+           'fail': False, 'warn_digits': False, 'notes': []}
+    if len(ta) != len(tb):
+        res['fail'] = True
+        res['notes'].append(f"token count differs: solution {len(ta)} vs reference {len(tb)}")
+        return res
+    for x, y in zip(ta, tb):
+        if x == y:
+            continue
+        if NUM_RE.match(x) and NUM_RE.match(y):
+            a, r, u = _ulp_error(x, y)
+            res['max_abs'] = max(res['max_abs'], a)
+            res['max_rel'] = max(res['max_rel'], r)
+            res['max_ulp'] = max(res['max_ulp'], u)
+            if u > max_ulp:
+                res['fail'] = True
+            sd = _sig_digits(x)
+            if sd is not None and sd < 15:
+                res['warn_digits'] = True
+        else:
+            res['fail'] = True
+            res['notes'].append(f"non-numeric mismatch: {x[:60]!r} vs {y[:60]!r}")
+            res['max_abs'] = float('inf')
+            res['max_rel'] = float('inf')
+            res['max_ulp'] = float('inf')
+    # Digit check also applies to tokens that matched exactly
+    for x in ta:
+        if NUM_RE.match(x):
+            sd = _sig_digits(x)
+            if sd is not None and sd < 15:
+                res['warn_digits'] = True
+                break
+    return res
+
+
+def tool_function(solution_path, reference_path, inputs, timeout=20, max_ulp=4):
+    try:
+        timeout = max(1, min(int(timeout or 20), 120))
+    except (TypeError, ValueError):
+        timeout = 20
+    try:
+        max_ulp = float(max_ulp) if max_ulp is not None else 4.0
+    except (TypeError, ValueError):
+        max_ulp = 4.0
+    if isinstance(inputs, str):
+        inputs = [inputs]
+    if not inputs:
+        return "Error: no inputs given."
+    for p in (solution_path, reference_path):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+
+    lines = [f"cases: {len(inputs)} (max_ulp={max_ulp})"]
+    worst_ulp = 0.0
+    n_fail = 0
+    n_warn = 0
+    n_crash = 0
+    details = []
+    for idx, data in enumerate(inputs, 1):
+        data = data if isinstance(data, str) else str(data)
+        sol = _run(solution_path, data, timeout)
+        ref = _run(reference_path, data, timeout)
+        if not sol['ok'] or not ref['ok']:
+            n_crash += 1
+            details.append(
+                f"--- case {idx}: CRASH/TIMEOUT ---\n"
+                f"input:\n{_clip(data)}\n"
+                f"solution exit={sol['code']} stderr:\n{_clip(sol['stderr'])}\n"
+                f"reference exit={ref['code']} stderr:\n{_clip(ref['stderr'])}")
+            continue
+        res = _audit_one(sol['stdout'], ref['stdout'], max_ulp)
+        worst_ulp = max(worst_ulp, res['max_ulp'])
+        line = (f"case {idx}: tokens={res['tokens']} max_abs={res['max_abs']:.3e} "
+                f"max_rel={res['max_rel']:.3e} max_ulp={res['max_ulp']:.3g}")
+        flags = []
+        if res['fail']:
+            flags.append('FAIL')
+            n_fail += 1
+        if res['warn_digits']:
+            flags.append('WARN(<15 significant digits)')
+            n_warn += 1
+        if flags:
+            line += ' ' + ' '.join(flags)
+        lines.append(line)
+        if res['fail'] or res['warn_digits']:
+            notes = ('\nnotes: ' + '; '.join(res['notes'])) if res['notes'] else ''
+            details.append(
+                f"--- case {idx} flagged ---{notes}\n"
+                f"input:\n{_clip(data)}\n"
+                f"solution output:\n{_clip(sol['stdout'])}\n"
+                f"reference output:\n{_clip(ref['stdout'])}")
+
+    summary = [f"worst max_ulp over all cases: {worst_ulp:.3g}",
+               f"failing cases (> {max_ulp} ulp): {n_fail}",
+               f"warn cases (< 15 significant digits): {n_warn}",
+               f"crashes/timeouts: {n_crash}"]
+    return "\n".join(summary + lines + details)
