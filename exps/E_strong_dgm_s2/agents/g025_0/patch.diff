+import sys
+from decimal import Decimal, getcontext
+
+# Assumed problem: given N contest performances P_1..P_N (in time order), choose a
+# non-empty subset of size k (keeping time order). The rating is
+#   sum_{j} 0.9^{k-j} Q_j / sum_{j} 0.9^{k-j} - 1200 / sqrt(k)
+# where Q_1..Q_k are the chosen performances in order. Output the maximum.
 #
-# If a problem statement is supplied, replace this file with the solution.
-# Fallback behaviour: read all of stdin and echo it back unchanged.
+# DP from the end: dp[t] = max numerator using t chosen items from the suffix,
+# where the item chosen as the (t+1)-th from the end has weight 0.9^t.
+# Each dp[k] gives the best numerator for exactly k items, so the best value is
+# max_k dp[k]/den_k - 1200/sqrt(k). The optimal subsets are reconstructed and the
+# final value is recomputed exactly with Decimal.
 
-import sys
+getcontext().prec = 60
+
+
+def solve(p):
+    n = len(p)
+    NEG = float('-inf')
+    w = [1.0] * (n + 1)
+    for t in range(1, n + 1):
+        w[t] = w[t - 1] * 0.9
+    dp = [NEG] * (n + 1)
+    dp[0] = 0.0
+    take = [None] * n  # take[i][t]: item i taken when count after step i is t
+    for idx in range(n - 1, -1, -1):
+        pv = p[idx]
+        tk = [False] * (n + 1)
+        new = dp[:]
+        for t in range(n - 1, -1, -1):
+            if dp[t] == NEG:
+                continue
+            c = dp[t] + w[t] * pv
+            if c > new[t + 1]:
+                new[t + 1] = c
+                tk[t + 1] = True
+        dp = new
+        take[idx] = tk
+
+    # Candidate k values by float score
+    scores = []
+    for k in range(1, n + 1):
+        if dp[k] == NEG:
+            continue
+        den = sum(w[:k])
+        scores.append((dp[k] / den - 1200.0 / (k ** 0.5), k))
+    if not scores:
+        return None
+    best = max(s for s, _ in scores)
+    cands = [k for s, k in scores if s >= best - 1e-6]
+
+    getcontext().prec = 60
+    best_val = None
+    for k in cands:
+        # reconstruct chosen indices
+        c = k
+        chosen = []
+        for i in range(n):
+            if c > 0 and take[i][c]:
+                chosen.append(i)
+                c -= 1
+        chosen.sort()
+        # exact evaluation with Decimal
+        num = Decimal(0)
+        den = Decimal(0)
+        kk = len(chosen)
+        for j, i in enumerate(chosen):
+            wt = Decimal('0.9') ** (kk - 1 - j)
+            num += wt * Decimal(p[i])
+            den += wt
+        val = num / den - Decimal(1200) / Decimal(kk).sqrt()
+        if best_val is None or val > best_val:
+            best_val = val
+    return best_val
 
 
