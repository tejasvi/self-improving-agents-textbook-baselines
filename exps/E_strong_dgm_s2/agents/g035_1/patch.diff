+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def tool_info():
+    return {
+        "name": "fuzz_validate",
+        "description": """Fuzz-test a solution on generated inputs using a validator (for problems with several valid outputs) and optionally a brute-force decision check.
+* `generator_path`: Python script taking a seed integer as argv[1] and an optional mode string as argv[2]; it prints one input to stdout. Seeds run 0..num_tests-1, and the modes list (if given) is cycled through so each mode is tested.
+* `validator_path`: Python script run as `python3 -I validator.py input_file output_file`. It must exit 0 if the output is valid for the input, and nonzero (printing a reason) otherwise.
+* `solution_path`: program that reads stdin and writes stdout; run with `python3 -I`.
+* `brute_path` (optional): reference program; if given, the first whitespace token of the solution output must equal the first token of the brute output (decision agreement, e.g. YES/NO or a count).
+* Returns the first K failing cases (default 3) with the raw input, solution output, stderr, timeouts and validator output. If everything passes, returns a summary with the number of tests and the maximum solution run time.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test."
+                },
+                "validator_path": {
+                    "type": "string",
+                    "description": "Path to a validator script run as: validator input_file output_file. Exit code 0 means the output is valid."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator script run as: generator SEED [MODE]. Prints one input to stdout."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional path to a brute-force reference; compares the first token of the outputs (decision agreement)."
+                },
+                "modes": {
+                    "type": "string",
+                    "description": "Optional comma-separated generator modes (e.g. empty,complete,tree,cycle,disconnected,max). Cycled through across seeds."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test (seeds 0..num_tests-1). Default 300."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                },
+                "max_failures": {
+                    "type": "integer",
+                    "description": "Number of failing cases to report in full. Default 3."
+                }
+            },
+            "required": ["solution_path", "validator_path", "generator_path"]
+        }
+    }
+
+
+def _run_py(args, data, timeout):
+    """Run `python3 -I` on args with stdin data. Returns dict with raw outputs and status."""
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", *args],
+            input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")}, errors="replace",
+        )
+        return {"stdout": p.stdout, "stderr": p.stderr, "rc": p.returncode, "timeout": False}
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return {"stdout": out, "stderr": err, "rc": None, "timeout": True}
+
+
+def _clip(s, n=3000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _first_token(s):
+    toks = s.split()
+    return toks[0] if toks else ""
+
+
+def tool_function(solution_path, validator_path, generator_path, brute_path=None, modes=None,
+                  num_tests=300, timeout=10, max_failures=3):
+    try:
+        num_tests = max(1, int(num_tests or 300))
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        timeout = max(1, min(int(timeout or 10), 300))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        max_failures = max(1, int(max_failures or 3))
+    except (TypeError, ValueError):
+        max_failures = 3
+    if isinstance(modes, str):
+        modes = [m.strip() for m in modes.split(",") if m.strip()]
+    modes = [str(m) for m in (modes or [])]
+
+    for path in (solution_path, validator_path, generator_path) + ((brute_path,) if brute_path else ()):
+        if not os.path.isfile(path):
+            return f"Error: file not found: {path}"
+
+    failures = []
+    max_time = 0.0
+    with tempfile.TemporaryDirectory() as workdir:
+        for seed in range(num_tests):
+            gen_args = [generator_path, str(seed)]
+            if modes:
+                gen_args.append(modes[seed % len(modes)])
+            gen = _run_py(gen_args, "", timeout)
+            if gen["timeout"] or gen["rc"] != 0 or not gen["stdout"].strip():
+                failures.append(
+                    f"[seed {seed}] GENERATOR failed: timeout={gen['timeout']} exit={gen['rc']} "
+                    f"empty={not gen['stdout'].strip()}\nstderr:\n{_clip(gen['stderr'])}")
+                if len(failures) >= max_failures:
+                    break
+                continue
+            inp = gen["stdout"]
+
+            t0 = time.time()
+            sol = _run_py([solution_path], inp, timeout)
+            max_time = max(max_time, time.time() - t0)
+            problem = None
+            if sol["timeout"]:
+                problem = "SOLUTION timed out"
+            elif sol["rc"] != 0:
+                problem = f"SOLUTION exit code {sol['rc']}"
+
+            if problem is None:
+                in_path = os.path.join(workdir, "in.txt")
+                out_path = os.path.join(workdir, "out.txt")
+                with open(in_path, "w") as f:
+                    f.write(inp)
+                with open(out_path, "w") as f:
+                    f.write(sol["stdout"])
+                val = _run_py([validator_path, in_path, out_path], "", timeout)
+                if val["timeout"] or val["rc"] != 0:
+                    problem = (f"VALIDATOR rejected output (timeout={val['timeout']}, exit={val['rc']})\n"
+                               f"validator stdout:\n{_clip(val['stdout'])}\nvalidator stderr:\n{_clip(val['stderr'])}")
+
+            if problem is None and brute_path:
+                br = _run_py([brute_path], inp, timeout)
+                if br["timeout"] or br["rc"] != 0:
+                    problem = f"BRUTE failed (timeout={br['timeout']}, exit={br['rc']})\nbrute stderr:\n{_clip(br['stderr'])}"
+                elif _first_token(br["stdout"]) != _first_token(sol["stdout"]):
+                    problem = (f"DECISION mismatch: solution first token {_first_token(sol['stdout'])!r}, "
+                               f"brute first token {_first_token(br['stdout'])!r}\n"
+                               f"brute stdout:\n{_clip(br['stdout'])}")
+
+            if problem is not None:
+                failures.append(
+                    f"[seed {seed}{', mode ' + gen_args[2] if len(gen_args) > 2 else ''}] {problem}\n"
+                    f"INPUT:\n{_clip(inp)}\n"
+                    f"SOLUTION stdout:\n{_clip(sol['stdout'])}\n"
+                    f"SOLUTION stderr:\n{_clip(sol['stderr'])}")
+                if len(failures) >= max_failures:
+                    break
+
+    if failures:
+        return (f"FAILED: {len(failures)} failing case(s) reported (stopped after {max_failures}).\n\n"
+                + "\n\n".join(failures))
+    return (f"PASSED: {num_tests} generated tests all accepted by the validator"
+            + (" and agreed with the brute force" if brute_path else "")
+            + f". Max solution run time: {max_time:.3f}s.")
