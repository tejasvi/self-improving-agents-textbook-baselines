+    def _synthetic_input(self):
+        """Best-effort tiny input built from the first line of the statement's input format
+        (the first non-empty line after an 'Input' heading). Integer tokens are kept; a name
+        becomes 3 for the first token and 1 otherwise. Returns None if no format line is found."""
+        import re
+        lines = self.problem_statement.splitlines()
+        start = None
+        for i, line in enumerate(lines):
+            if re.match(r'^[\W_]*input[\W_]*$', line.strip(), re.IGNORECASE):
+                start = i + 1
+                break
+        if start is None:
+            return None
+        fmt = next((l for l in lines[start:start + 15] if re.search(r'[A-Za-z0-9]', l)), None)
+        if fmt is None:
+            return None
+        tokens = [t for t in re.findall(r'[A-Za-z]+|\d+', fmt)
+                  if t.isdigit() or (t.isupper() or len(t) == 1)]
+        if not tokens:
+            return None
+        vals = [t if t.isdigit() else ("3" if k == 0 else "1") for k, t in enumerate(tokens)]
+        head = " ".join(vals)
+        # a few filler lines so that reads of the arrays that follow are less likely to hit EOF
+        filler = " ".join(["1"] * len(tokens))
+        return head + "\n" + (filler + "\n") * 3
+
