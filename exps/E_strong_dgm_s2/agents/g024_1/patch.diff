diff --git a/tools/replay_test.py b/tools/replay_test.py
new file mode 100644
index 0000000..9b329dd
--- /dev/null
+++ b/tools/replay_test.py
@@ -0,0 +1,259 @@
+import os
+import select
+import subprocess
+import sys
+import tempfile
+import time
+
+_MAX_ROUNDS = 100000
+_CLIP = 4000
+
+
+def tool_info():
+    return {
+        "name": "replay_test",
+        "description": """Run a Python solution under `python3 -I` and return the raw results (no judging).\n
+* mode 'flat': runs the solution once with `stdin_text` as its entire standard input (like `python3 solution.py < flat_input.txt`). Use this to mimic a grader that replays a static stdin file, e.g. for interactive problems whose hidden data is streamed as plain lines.
+* mode 'pipe': starts the solution as an interactive process. `stdin_text` (may be empty) is written to its stdin first. If `responder_script` (path to a Python file) is given, that file is started as a second process; each line the solution prints is forwarded to the responder's stdin, and the responder's next stdout line is written back to the solution's stdin. Without a responder, the solution just gets `stdin_text` and its output is recorded.
+* Returns the raw STDOUT, STDERR, exit code, whether the run timed out, and whether it was blocked (still waiting for input when the timeout hit). Also returns the pipe transcript in pipe mode. It does not check correctness; compare the output yourself.
+* Each call uses a clean environment (only PATH is kept).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Text used as standard input (flat mode), or written first to the solution's stdin (pipe mode). Use an empty string if not needed."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for the run (default 10)."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "'flat' (default) to run with stdin_text as complete stdin, or 'pipe' for an interactive session."
+                },
+                "responder_script": {
+                    "type": "string",
+                    "description": "Optional path to a Python script used only in pipe mode. It reads each solution output line from stdin and prints exactly one reply line to stdout per input line."
+                }
+            },
+            "required": ["solution_path", "stdin_text"]
+        }
+    }
+
+
+def _clip(s, n=_CLIP):
+    if s is None:
+        return ""
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _env():
+    return {"PATH": os.environ.get("PATH", "")}
+
+
+def _read_file(f):
+    f.seek(0)
+    return f.read().decode(errors="replace")
+
+
+def _run_flat(solution_path, stdin_text, timeout):
+    start = time.time()
+    try:
+        p = subprocess.run([sys.executable, "-I", solution_path], input=stdin_text.encode(),
+                           capture_output=True, timeout=timeout, env=_env())
+        return {
+            "stdout": p.stdout.decode(errors="replace"), "stderr": p.stderr.decode(errors="replace"),
+            "exit_code": p.returncode, "timed_out": False, "blocked": False,
+            "elapsed": time.time() - start, "transcript": None,
+        }
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout or b""
+        err = e.stderr or b""
+        return {
+            "stdout": out.decode(errors="replace") if isinstance(out, bytes) else str(out),
+            "stderr": err.decode(errors="replace") if isinstance(err, bytes) else str(err),
+            "exit_code": None, "timed_out": True, "blocked": True,
+            "elapsed": time.time() - start, "transcript": None,
+        }
+
+
+def _run_pipe(solution_path, stdin_text, timeout, responder_script):
+    start = time.time()
+    deadline = start + timeout
+    prog_err = tempfile.TemporaryFile()
+    resp_err = tempfile.TemporaryFile()
+    resp = None
+    prog = subprocess.Popen([sys.executable, "-I", solution_path], stdin=subprocess.PIPE,
+                            stdout=subprocess.PIPE, stderr=prog_err, env=_env(), bufsize=0)
+    if responder_script:
+        resp = subprocess.Popen([sys.executable, "-I", responder_script], stdin=subprocess.PIPE,
+                                stdout=subprocess.PIPE, stderr=resp_err, env=_env(), bufsize=0)
+    transcript = []
+    stdout_chunks = []
+    pbuf = b""
+    rbuf = b""
+    timed_out = False
+    resp_eof = False
+    prog_eof = False
+    try:
+        if stdin_text:
+            try:
+                prog.stdin.write(stdin_text.encode())
+                prog.stdin.flush()
+            except (BrokenPipeError, OSError):
+                pass
+        if resp is None:
+            # no responder: the solution gets only the given text, then EOF
+            try:
+                prog.stdin.close()
+            except OSError:
+                pass
+        for _ in range(_MAX_ROUNDS):
+            remaining = deadline - time.time()
+            if remaining <= 0:
+                timed_out = True
+                break
+            ready, _, _ = select.select([prog.stdout], [], [], remaining)
+            if not ready:
+                timed_out = True
+                break
+            chunk = os.read(prog.stdout.fileno(), 65536)
+            if not chunk:
+                prog_eof = True
+                break
+            stdout_chunks.append(chunk)
+            pbuf += chunk
+            while b"\n" in pbuf:
+                line, _, pbuf = pbuf.partition(b"\n")
+                text = line.decode(errors="replace")
+                transcript.append(("SOLUTION", text))
+                if resp is None or resp_eof:
+                    continue
+                reply = None
+                try:
+                    resp.stdin.write(line + b"\n")
+                    resp.stdin.flush()
+                except (BrokenPipeError, OSError):
+                    resp_eof = True
+                    continue
+                # wait for the responder's reply line
+                while b"\n" not in rbuf:
+                    remaining = deadline - time.time()
+                    if remaining <= 0:
+                        timed_out = True
+                        break
+                    ready, _, _ = select.select([resp.stdout], [], [], remaining)
+                    if not ready:
+                        timed_out = True
+                        break
+                    chunk_r = os.read(resp.stdout.fileno(), 65536)
+                    if not chunk_r:
+                        resp_eof = True
+                        break
+                    rbuf += chunk_r
+                if timed_out:
+                    break
+                if b"\n" in rbuf:
+                    reply, _, rbuf = rbuf.partition(b"\n")
+                if reply is None:
+                    resp_eof = True
+                    continue
+                transcript.append(("RESPONDER", reply.decode(errors="replace")))
+                try:
+                    prog.stdin.write(reply + b"\n")
+                    prog.stdin.flush()
+                except (BrokenPipeError, OSError):
+                    prog_eof = True
+                    break
+            if timed_out or prog_eof:
+                break
+        else:
+            timed_out = True
+        if pbuf and not timed_out:
+            transcript.append(("SOLUTION", pbuf.decode(errors="replace")))
+    finally:
+        for proc in (prog, resp):
+            if proc is None:
+                continue
+            try:
+                if proc.stdin:
+                    proc.stdin.close()
+            except OSError:
+                pass
+        # give the solution a moment to exit on its own, then kill
+        exit_code = None
+        was_alive = prog.poll() is None
+        try:
+            exit_code = prog.wait(timeout=1.0)
+        except subprocess.TimeoutExpired:
+            prog.kill()
+            prog.wait()
+            exit_code = None
+        if resp is not None:
+            try:
+                resp.wait(timeout=1.0)
+            except subprocess.TimeoutExpired:
+                resp.kill()
+                resp.wait()
+        if prog.stdout:
+            prog.stdout.close()
+        if resp is not None and resp.stdout:
+            resp.stdout.close()
+    if timed_out:
+        exit_code = None
+    stdout_text = b"".join(stdout_chunks).decode(errors="replace")
+    stderr_text = _read_file(prog_err)
+    resp_stderr = _read_file(resp_err) if resp is not None else ""
+    # the solution might still be running after a timeout; blocked = timed out while alive
+    return {
+        "stdout": stdout_text, "stderr": stderr_text, "exit_code": exit_code,
+        "timed_out": timed_out, "blocked": bool(timed_out and was_alive),
+        "elapsed": time.time() - start, "transcript": transcript,
+        "responder_stderr": resp_stderr if resp is not None else None,
+        "responder_exit_code": resp.returncode if resp is not None else None,
+    }
+
+
+def _format(res, mode):
+    lines = [f"mode: {mode}", f"exit_code: {res['exit_code']}", f"timed_out: {res['timed_out']}",
+             f"blocked: {res['blocked']}", f"elapsed_seconds: {res['elapsed']:.3f}"]
+    if res.get("transcript") is not None:
+        lines.append("TRANSCRIPT (direction, line):")
+        for direction, text in res["transcript"][:400]:
+            lines.append(f"  {direction}: {text}")
+        if len(res["transcript"]) > 400:
+            lines.append(f"  ... {len(res['transcript']) - 400} more lines not shown")
+        if res.get("responder_exit_code") is not None:
+            lines.append(f"responder_exit_code: {res['responder_exit_code']}")
+        if res.get("responder_stderr"):
+            lines.append("RESPONDER STDERR:\n" + _clip(res["responder_stderr"]))
+    lines.append("STDOUT:\n" + _clip(res["stdout"]))
+    lines.append("STDERR:\n" + _clip(res["stderr"]))
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, stdin_text, timeout=10, mode='flat', responder_script=None):
+    try:
+        timeout = max(1, min(int(timeout or 10), 60))
+    except (TypeError, ValueError):
+        timeout = 10
+    mode = (mode or 'flat').strip().lower()
+    stdin_text = stdin_text if isinstance(stdin_text, str) else ("" if stdin_text is None else str(stdin_text))
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file {solution_path} does not exist."
+    if mode not in ('flat', 'pipe'):
+        return f"Error: unknown mode {mode!r}; use 'flat' or 'pipe'."
+    if responder_script and not os.path.isfile(responder_script):
+        return f"Error: responder script {responder_script} does not exist."
+    if mode == 'flat':
+        res = _run_flat(solution_path, stdin_text, timeout)
+    else:
+        res = _run_pipe(solution_path, stdin_text, timeout, responder_script or None)
+    return _format(res, mode)
