diff --git a/tools/minimize_failure.py b/tools/minimize_failure.py
new file mode 100644
index 0000000..fc60622
--- /dev/null
+++ b/tools/minimize_failure.py
@@ -0,0 +1,254 @@
+import re
+import subprocess
+import sys
+
+from utils.verify_common import compare_outputs
+
+INT_RE = re.compile(r'^[+-]?\d+$')
+REL_TOL = 1e-11
+
+
+def tool_info():
+    return {
+        "name": "minimize_failure",
+        "description": """Shrink a failing test input while keeping the disagreement between solution and reference.\n
+* Give the failing input (e.g. the `input` of a stress_compare first failure). Both programs are run with `python3 -I` on each candidate.
+* A candidate is kept if the outputs still differ beyond tolerance, or if only one program crashes/times out. Inputs on which both programs crash identically are treated as invalid and rejected.
+* Reductions: delta-debugging over body lines (the first line is kept as header), dropping body lines while decrementing the matching count in the header, decrementing other header values, and shrinking integer tokens (halve, then decrement).
+* The search is bounded by max_rounds (total number of candidate evaluations).
+* Returns raw text: the minimal failing input, and the raw stdout/stderr and exit codes of both programs on it. No error classification is done; read the raw output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the reference (brute force) Python file."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "The failing input text on which solution and reference disagree or crash."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each program (default 5)."
+                },
+                "max_rounds": {
+                    "type": "integer",
+                    "description": "Maximum total number of candidate evaluations (default 200)."
+                }
+            },
+            "required": ["solution_path", "reference_path", "input_text"]
+        }
+    }
+
+
+def _run(path, data, timeout):
+    try:
+        p = subprocess.run([sys.executable, '-I', path], input=data, capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+        return {'ok': p.returncode == 0, 'stdout': p.stdout, 'stderr': p.stderr, 'code': p.returncode}
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {'ok': False, 'stdout': out, 'stderr': err + f"\n(timed out after {timeout}s)", 'code': 'TIMEOUT'}
+
+
+def _to_text(lines):
+    return "\n".join(lines) + "\n"
+
+
+def _shrink_int(v):
+    """Candidate smaller values for integer v (halve toward zero, then step toward zero)."""
+    cands = []
+    if abs(v) > 1:
+        half = v // 2 if v > 0 else -((-v) // 2)
+        cands.append(half)
+    if v > 0:
+        cands.append(v - 1)
+    elif v < 0:
+        cands.append(v + 1)
+    out = []
+    for c in cands:
+        if c != v and c not in out:
+            out.append(c)
+    return out
+
+
+class _Budget:
+    def __init__(self, n):
+        self.left = n
+
+    def take(self):
+        if self.left <= 0:
+            return False
+        self.left -= 1
+        return True
+
+
+def tool_function(solution_path, reference_path, input_text, timeout=5, max_rounds=200):
+    try:
+        timeout = max(1, min(int(timeout or 5), 60))
+    except (TypeError, ValueError):
+        timeout = 5
+    try:
+        max_rounds = max(1, min(int(max_rounds or 200), 5000))
+    except (TypeError, ValueError):
+        max_rounds = 200
+    budget = _Budget(max_rounds)
+
+    def fails(lines):
+        """True if the candidate (list of lines) is a genuine failure. Spends one evaluation."""
+        if not budget.take():
+            return False
+        data = _to_text(lines)
+        sol = _run(solution_path, data, timeout)
+        ref = _run(reference_path, data, timeout)
+        if not sol['ok'] and not ref['ok']:
+            # Both crash: invalid input if they crash identically, otherwise a failure.
+            # Compare only the final stderr line (exception type and message); file paths differ.
+            last_s = sol['stderr'].strip().splitlines()[-1:] or ['']
+            last_r = ref['stderr'].strip().splitlines()[-1:] or ['']
+            same = last_s == last_r
+            return not same
+        if not sol['ok'] or not ref['ok']:
+            return True
+        _, ok, _, _ = compare_outputs(sol['stdout'], ref['stdout'], REL_TOL)
+        return not ok
+
+    lines = [ln for ln in input_text.split('\n')]
+    for _ in range(len(lines)):
+        if not lines or lines[-1] != '':
+            break
+        lines.pop()
+    if not lines:
+        return "input_text is empty; nothing to minimize."
+    if not fails(lines):
+        return ("The given input does not make solution and reference disagree (or crash), "
+                "or it is invalid for both programs. Nothing minimized.\n"
+                f"Input used:\n{_to_text(lines)}")
+
+    def changed_pass_ddmin():
+        """Delta debugging over body lines (lines[1:]); keeps the header line."""
+        nonlocal lines
+        changed = False
+        n = 2
+        for _ in range(max_rounds):
+            body_len = len(lines) - 1
+            if body_len < 2 or budget.left <= 0 or n > 2 * body_len:
+                break
+            chunk = max(1, body_len // n)
+            removed_any = False
+            start = 0
+            for _s in range(body_len + 1):
+                body = lines[1:]
+                if start >= len(body) or budget.left <= 0:
+                    break
+                cand_body = body[:start] + body[start + chunk:]
+                cand = [lines[0]] + cand_body
+                if cand_body and fails(cand):
+                    lines = cand
+                    removed_any = True
+                    changed = True
+                else:
+                    start += chunk
+            if removed_any:
+                n = max(2, n - 1)
+            elif chunk == 1:
+                break
+            else:
+                n *= 2
+        return changed
+
+    def header_count_pass():
+        """Drop one body line and decrement the header count equal to the body length; also try
+        decrementing other header integers."""
+        nonlocal lines
+        changed = False
+        header = lines[0].split()
+        if not header:
+            return False
+        for j in range(1, len(lines)):
+            if budget.left <= 0:
+                break
+            body_len = len(lines) - 1
+            hdr = lines[0].split()
+            idxs = [i for i, t in enumerate(hdr) if INT_RE.match(t) and int(t) == body_len]
+            if not idxs:
+                break
+            i = idxs[0]
+            new_hdr = list(hdr)
+            new_hdr[i] = str(body_len - 1)
+            cand = [" ".join(new_hdr)] + lines[1:j] + lines[j + 1:]
+            if fails(cand):
+                lines = cand
+                changed = True
+                break
+        for i, t in enumerate(lines[0].split() if lines else []):
+            if budget.left <= 0:
+                break
+            if INT_RE.match(t) and int(t) > 0:
+                hdr = lines[0].split()
+                hdr[i] = str(int(t) - 1)
+                cand = [" ".join(hdr)] + lines[1:]
+                if fails(cand):
+                    lines = cand
+                    changed = True
+        return changed
+
+    def int_shrink_pass():
+        """Shrink integer tokens in every line toward smaller values."""
+        nonlocal lines
+        changed = False
+        for li in range(len(lines)):
+            toks = lines[li].split()
+            for ti in range(len(toks)):
+                if budget.left <= 0:
+                    return changed
+                if not INT_RE.match(toks[ti]):
+                    continue
+                v = int(toks[ti])
+                for c in _shrink_int(v):
+                    if budget.left <= 0:
+                        return changed
+                    t2 = list(toks)
+                    t2[ti] = str(c)
+                    cand = list(lines)
+                    cand[li] = " ".join(t2)
+                    if fails(cand):
+                        lines = cand
+                        toks = t2
+                        changed = True
+                        break
+        return changed
+
+    # Bounded outer loop over passes; stops early when a full sweep changes nothing.
+    for _ in range(max_rounds):
+        if budget.left <= 0:
+            break
+        c1 = changed_pass_ddmin()
+        c2 = header_count_pass()
+        c3 = int_shrink_pass()
+        if not (c1 or c2 or c3):
+            break
+
+    final = _to_text(lines)
+    so = _run(solution_path, final, timeout)
+    ro = _run(reference_path, final, timeout)
+    lines_out = [
+        f"evaluations used: {max_rounds - budget.left}/{max_rounds}",
+        f"minimal failing input ({len(lines)} lines):",
+        final.rstrip('\n'),
+        f"--- solution exit={so['code']} stdout ---",
+        so['stdout'],
+        f"--- solution stderr ---",
+        so['stderr'],
+        f"--- reference exit={ro['code']} stdout ---",
+        ro['stdout'],
+        f"--- reference stderr ---",
+        ro['stderr'],
+    ]
+    return "\n".join(lines_out)
