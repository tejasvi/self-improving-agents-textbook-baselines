 import sys
+from fractions import Fraction
+from decimal import Decimal, getcontext
 
 
 def main():
-    data = sys.stdin.read()
-    sys.stdout.write(data)
+    data = sys.stdin.read().split()
+    idx = 0
+    n = int(data[idx]); idx += 1
+    m = int(data[idx]); idx += 1
+    wheels = []
+    for _ in range(n):
+        p = int(data[idx]); idx += 1
+        c = int(data[idx]); idx += 1
+        s = [int(x) for x in data[idx: idx + p]]
+        idx += p
+        wheels.append((p, c, s))
+    # State: points x in [0, m). E[x] = min over wheels of
+    # (P*C + sum_{S>0, x+S<m} E[x+S]) / (P - z), z = number of zero sections.
+    # Exact rational arithmetic avoids float drift in the DP.
+    E = [Fraction(0)] * (m + 1)
+    for x in range(m - 1, -1, -1):
+        best = None
+        for p, c, s in wheels:
+            z = s.count(0)
+            if z == p:
+                continue
+            total = Fraction(p * c)
+            for v in s:
+                if v > 0 and x + v < m:
+                    total += E[x + v]
+            val = total / (p - z)
+            if best is None or val < best:
+                best = val
+        E[x] = best
+    getcontext().prec = 60
+    d = Decimal(E[0].numerator) / Decimal(E[0].denominator)
+    print("%.15f" % float(d))
 
 
-if __name__ == "__main__":
-    main()
