+SIG_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def _sig_digits(tok):
+    """Number of significant digits written in a numeric token (leading zeros not counted)."""
+    t = tok.lstrip('+-')
+    t = re.split(r'[eE]', t)[0]
+    digits = t.replace('.', '').lstrip('0')
+    return len(digits)
+
+
+def _digit_info(out, expected):
+    """Significant-digit summary over numeric tokens paired by position."""
+    ta = out.split()
