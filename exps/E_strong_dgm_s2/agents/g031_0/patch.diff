index 0000000..5790623
--- /dev/null
+++ b/tools/answer_rule_finder.py
@@ -0,0 +1,186 @@
+import glob
+import os
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        "name": "answer_rule_finder",
+        "description": """Infer which selection rule the official expected outputs follow, for problems that accept multiple valid answers.
+* `enumerator_path` is a Python program that reads one input (stdin) and prints ALL valid answers for it, one answer per line, answer tokens whitespace-separated.
+* For every N.in / N.out pair in `sample_dir`, the enumerator is run on N.in. The expected output N.out is compared against the enumerated answers.
+* For each sample it reports: the number of valid answers, whether the expected output is among them (False means the enumerator is wrong), and the rank of the expected output under each rule (rank 0 means the expected answer is a best answer under that rule; rank is the number of answers strictly better under that rule, or the enumeration index for the first/last rules).
+* Rules: lex-min, lex-max, min sum, max sum, min by last element then tuple, min by middle element, min of reversed tuple, max of reversed tuple, minimize max-min spread, first in enumeration order, last in enumeration order.
+* At the end it lists the rules that have rank 0 on every sample with more than one valid answer, or prints 'NO RULE MATCHES' with the table.
+Output is raw data only.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "enumerator_path": {
+                    "type": "string",
+                    "description": "Path to a Python program that prints all valid answers for a stdin input, one per line."
+                },
+                "sample_dir": {
+                    "type": "string",
+                    "description": "Directory with N.in / N.out sample pairs. Relative paths are resolved against the current working directory. Default 'dev/samples'."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for the enumerator. Default 10."
+                }
+            },
+            "required": ["enumerator_path"]
+        }
+    }
+
+
+def _to_token(tok):
+    try:
+        return int(tok)
+    except ValueError:
+        return tok
+
+
+def _parse_line(line):
+    return tuple(_to_token(t) for t in line.split())
+
+
+def _parse_answers(text):
+    answers = []
+    for line in text.splitlines():
+        if line.strip():
+            answers.append(_parse_line(line))
+    return answers
+
+
+def _is_numeric(t):
+    return all(isinstance(x, int) for x in t)
+
+
+def _sum_key(t):
+    return sum(t) if _is_numeric(t) else None
+
+
+def _spread_key(t):
+    return (max(t) - min(t)) if (t and _is_numeric(t)) else None
+
+
+def _mid_key(t):
+    if not t:
+        return None
+    return t[len(t) // 2]
+
+
+def _rev(t):
+    return tuple(reversed(t))
+
+
+# Each rule: (name, key function or None, reverse flag). key None with special marker handled separately.
+# Rule keys are used to sort answers; the expected answer's rank is the count of answers strictly better.
+RULES = [
+    ("lex-min", lambda t: t, False),
+    ("lex-max", lambda t: t, True),
+    ("min sum", _sum_key, False),
+    ("max sum", _sum_key, True),
+    ("min last element then tuple", lambda t: (t[-1], t) if t else (), False),
+    ("min middle element then tuple", lambda t: (_mid_key(t), t) if t else (), False),
+    ("min of reversed tuple", lambda t: _rev(t), False),
+    ("max of reversed tuple", lambda t: _rev(t), True),
+    ("minimize max-min spread", _spread_key, False),
+    ("first in enumeration order", None, False),
+    ("last in enumeration order", None, True),
+]
+
+
+def _rank(name, key, reverse, answers, expected):
+    """Rank of expected under the rule: number of answers strictly better. None if not applicable."""
+    if name == "first in enumeration order":
+        return answers.index(expected)
+    if name == "last in enumeration order":
+        return len(answers) - 1 - answers[::-1].index(expected)
+    keys = [key(a) for a in answers]
+    if any(k is None for k in keys):
+        return None
+    ek = key(expected)
+    if ek is None:
+        return None
+    try:
+        if reverse:
+            return sum(1 for k in keys if k > ek)
+        return sum(1 for k in keys if k < ek)
+    except TypeError:
+        return None
+
+
+def _run_enumerator(enumerator_path, data, timeout):
+    try:
+        p = subprocess.run([sys.executable, "-I", enumerator_path], input=data, capture_output=True,
+                           text=True, timeout=timeout, env={"PATH": os.environ.get("PATH", "")})
+    except subprocess.TimeoutExpired:
+        return None, "enumerator timed out after %s seconds" % timeout
+    if p.returncode != 0:
+        return None, "enumerator exit code %d; stderr tail: %s" % (
+            p.returncode, "\n".join(p.stderr.strip().splitlines()[-10:]))
+    return p.stdout, None
+
+
+def tool_function(enumerator_path, sample_dir='dev/samples', timeout=10):
+    timeout = int(timeout) if timeout is not None else 10
+    if sample_dir is None or sample_dir == "":
+        sample_dir = 'dev/samples'
+    lines = []
+    pairs = sorted(glob.glob(os.path.join(sample_dir, '*.in')))
+    if not pairs:
+        return f"No N.in files found in {sample_dir}."
+    if not os.path.isfile(enumerator_path):
+        return f"Enumerator {enumerator_path} does not exist."
+
+    rule_ok = {name: True for name, _, _ in RULES}
+    informative = 0
+    table = []
+    for in_file in pairs:
+        out_file = in_file[:-3] + '.out'
+        if not os.path.isfile(out_file):
+            continue
+        with open(in_file) as f:
+            data = f.read()
+        with open(out_file) as f:
+            expected_text = f.read()
+        expected = tuple(_to_token(t) for t in expected_text.split())
+        name = os.path.basename(in_file)
+        out, err = _run_enumerator(enumerator_path, data, timeout)
+        if err is not None:
+            table.append(f"{name}: ERROR {err}")
+            rule_ok = {k: False for k in rule_ok}
+            continue
+        answers = _parse_answers(out)
+        n_valid = len(answers)
+        in_set = expected in answers
+        if n_valid > 1:
+            informative += 1
+        ranks = {}
+        for rname, key, rev in RULES:
+            r = _rank(rname, key, rev, answers, expected) if in_set else None
+            ranks[rname] = r
+            if n_valid > 1 and (r is None or r != 0):
+                rule_ok[rname] = False
+        if not in_set:
+            # enumerator missed the expected answer: the enumerator (or the rule search) is unreliable
+            table.append(f"{name}: answers={n_valid} expected_in_answers=False (ENUMERATOR MISMATCH)")
+            rule_ok = {k: False for k in rule_ok}
+            continue
+        rank_str = ", ".join(f"{k}={'NA' if v is None else v}" for k, v in ranks.items())
+        table.append(f"{name}: answers={n_valid} expected_in_answers=True informative={n_valid > 1} | {rank_str}")
+
+    lines.append(f"Samples checked: {len(table)}; informative (more than one valid answer): {informative}")
+    lines.extend(table)
+    if informative == 0:
+        lines.append("NO INFORMATIVE SAMPLES: every sample has at most one valid answer, so no rule can be checked.")
+        return "\n".join(lines)
+    matching = [k for k, v in rule_ok.items() if v]
+    if matching:
+        lines.append("MATCHING RULES (rank 0 on every informative sample): " + "; ".join(matching))
+    else:
+        lines.append("NO RULE MATCHES")
+    return "\n".join(lines)
