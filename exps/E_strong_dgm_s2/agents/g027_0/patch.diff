diff --git a/tools/precision_check.py b/tools/precision_check.py
new file mode 100644
index 0000000..00a15d1
--- /dev/null
+++ b/tools/precision_check.py
@@ -0,0 +1,191 @@
+import math
+import re
+import struct
+from fractions import Fraction
+
+from tools.stress_test import _run_py, _clip_lines
+
+
+_NUM_RE = re.compile(r'[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?(?:/\d+)?')
+
+
+def tool_info():
+    return {
+        "name": "precision_check",
+        "description": """Measure the numeric error of a solution against a high-precision oracle on generated inputs.
+* `oracle_path` is a Python program (written by you, using fractions.Fraction or decimal.Decimal with prec 60) that reads the same stdin as the solution and prints the true answer with at least 20 significant digits.
+* `generator_path` takes one integer seed argument and prints one input. Seeds 0..num_tests-1 are used.
+* For each seed, the generator, the solution and the oracle are run in isolated subprocesses. All number tokens in the solution output and the oracle output are paired in order, and the absolute error, relative error and ULP distance (between the float64 values) are computed against the oracle's exact value.
+* Returns raw data only: the worst absolute error and worst relative error (with the seed, input, and both outputs of that test), counts of pairs whose relative error exceeds 1e-12 and 1e-9, token-count mismatches, and any crash or timeout info.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test."
+                },
+                "oracle_path": {
+                    "type": "string",
+                    "description": "Path to a high-precision oracle Python program (Fraction/Decimal) that prints the exact answer."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator script taking a seed integer and printing one input."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test (seeds 0..num_tests-1). Default 100."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path", "oracle_path", "generator_path"]
+        }
+    }
+
+
+def float_tokens(text):
+    """All number tokens in text, as strings (e.g. '-96.602298824998968', '1e-5', or an exact 'p/q')."""
+    return _NUM_RE.findall(text)
+
+
+def _ulp_distance(a, b):
+    """Number of float64 steps between two finite floats (sign-aware ordering)."""
+    def key(x):
+        bits = struct.unpack('>q', struct.pack('>d', x))[0]
+        return bits if bits >= 0 else -(bits & 0x7FFFFFFFFFFFFFFF)
+    return abs(key(a) - key(b))
+
+
+def pair_errors(sol_text, oracle_text):
+    """Compare number tokens pairwise. Returns (pairs, count_mismatch) where pairs is a list of
+    (abs_err, rel_err, ulp, sol_token, oracle_token). Errors are Fractions/floats computed exactly."""
+    st = float_tokens(sol_text)
+    ot = float_tokens(oracle_text)
+    pairs = []
+    for s, o in zip(st, ot):
+        try:
+            fs, fo = Fraction(s), Fraction(o)
+        except (ValueError, ZeroDivisionError):
+            continue
+        absf = abs(fs - fo)
+        rel = absf / abs(fo) if fo != 0 else absf
+        try:
+            ulp = _ulp_distance(float(fs), float(fo))
+        except (ValueError, OverflowError):
+            ulp = None
+        pairs.append((float(absf), float(rel), ulp, s, o))
+    return pairs, len(st) != len(ot)
+
+
+def _is_decimal(tok):
+    return ('.' in tok) or ('e' in tok.lower())
+
+
+def compare_outputs(expected, actual, tol=1e-9):
+    """Float-aware comparison used by the agent harness.
+    Returns (ok, max_rel_err, float_only). Whitespace-normalized exact equality passes with error 0.0.
+    Otherwise both outputs must have the same token count; each token pair must be exactly equal, or both
+    parse as numbers with relative error <= tol. max_rel_err is over numeric pairs (None if none).
+    float_only is True when every mismatching pair was a numeric (float) difference."""
+    canon = lambda t: "\n".join(line.rstrip() for line in t.strip().splitlines())
+    if canon(expected) == canon(actual):
+        return True, 0.0, False
+    el, al = canon(expected).splitlines(), canon(actual).splitlines()
+    if len(el) != len(al) or any(len(x.split()) != len(y.split()) for x, y in zip(el, al)):
+        return False, None, False
+    et, at = " ".join(el).split(), " ".join(al).split()
+    ok = True
+    float_only = True
+    max_rel = None
+    for e, a in zip(et, at):
+        if e == a:
+            continue
+        try:
+            fe, fa = float(e), float(a)
+        except ValueError:
+            ok = False
+            float_only = False
+            continue
+        if not (_is_decimal(e) or _is_decimal(a)):
+            # integer-looking tokens must match exactly; a tolerance would accept off-by-one answers
+            ok = False
+            float_only = False
+            continue
+        if math.isnan(fe) or math.isnan(fa) or math.isinf(fe) or math.isinf(fa):
+            ok = False
+            continue
+        denom = abs(fe) if fe != 0 else 1.0
+        rel = abs(fa - fe) / denom
+        max_rel = rel if max_rel is None else max(max_rel, rel)
+        if rel > tol:
+            ok = False
+    return ok, max_rel, (float_only and not ok)
+
+
+def tool_function(solution_path, oracle_path, generator_path, num_tests=100, timeout=10):
+    num_tests = int(num_tests)
+    timeout = int(timeout)
+    worst = None  # (rel, abs, seed, inp, sol_out, oracle_out, ulp)
+    worst_abs = 0.0
+    worst_abs_seed = None
+    n_over_12 = 0
+    n_over_9 = 0
+    n_pairs = 0
+    count_mismatch_seeds = []
+    problems = []
+    tests_run = 0
+    for i in range(num_tests):
+        gen_out, gen_err, gen_rc, gen_to = _run_py(generator_path, "", timeout, args=(str(i),))
+        if gen_to or gen_rc != 0:
+            problems.append(f"seed {i}: generator failed (timeout={gen_to}, exit={gen_rc}) "
+                            f"stderr: {_clip_lines(gen_err, 10)}")
+            break
+        inp = gen_out
+        s_out, s_err, s_rc, s_to = _run_py(solution_path, inp, timeout)
+        o_out, o_err, o_rc, o_to = _run_py(oracle_path, inp, timeout)
+        tests_run += 1
+        if o_to or o_rc != 0:
+            problems.append(f"seed {i}: ORACLE failed (timeout={o_to}, exit={o_rc}) "
+                            f"stderr: {_clip_lines(o_err, 10)}")
+            break
+        if s_to or s_rc != 0:
+            problems.append(f"seed {i}: SOLUTION failed ({'timeout' if s_to else 'exit ' + str(s_rc)}) "
+                            f"stderr: {_clip_lines(s_err, 10)}")
+            if len(problems) >= 5:
+                break
+            continue
+        pairs, mismatch = pair_errors(s_out, o_out)
+        if mismatch:
+            count_mismatch_seeds.append(i)
+        for abs_e, rel_e, ulp, s_tok, o_tok in pairs:
+            n_pairs += 1
+            if rel_e > 1e-12:
+                n_over_12 += 1
+            if rel_e > 1e-9:
+                n_over_9 += 1
+            if worst_abs_seed is None or abs_e > worst_abs:
+                worst_abs = abs_e
+                worst_abs_seed = i
+            if worst is None or rel_e > worst[0]:
+                worst = (rel_e, abs_e, i, inp, s_out, o_out, ulp)
+
+    lines = [f"precision_check: ran {tests_run} seeds, compared {n_pairs} number pairs."]
+    if worst is None:
+        lines.append("No comparable number pairs found.")
+    else:
+        rel_e, abs_e, seed, inp, s_out, o_out, ulp = worst
+        lines.append(f"Worst absolute error: {worst_abs:.6e} (seed {worst_abs_seed})")
+        lines.append(f"Worst relative error: {rel_e:.6e} (seed {seed}), ULP distance {ulp}")
+        lines.append(f"Pairs with relative error > 1e-12: {n_over_12}; > 1e-9: {n_over_9}")
+        lines.append(f"INPUT of worst relative-error seed {seed}:\n{_clip_lines(inp, 40)}")
+        lines.append(f"SOLUTION output:\n{_clip_lines(s_out, 40)}")
+        lines.append(f"ORACLE output:\n{_clip_lines(o_out, 40)}")
+    if count_mismatch_seeds:
+        lines.append(f"Token-count mismatch (solution vs oracle) at seeds: {count_mismatch_seeds[:20]}"
+                     f"{' ...' if len(count_mismatch_seeds) > 20 else ''}")
+    if problems:
+        lines.append("Problems:\n" + "\n".join(problems[:5]))
+    return "\n".join(lines)
