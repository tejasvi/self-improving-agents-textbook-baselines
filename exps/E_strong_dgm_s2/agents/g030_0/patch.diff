+    def _write_fallback_solution(self):
+        """Write a minimal valid stdin program to solution.py if it has no real code."""
+        path = self._solution_path()
+        existing = ''
+        if os.path.isfile(path):
+            with open(path, 'r', errors='replace') as f:
+                existing = f.read()
+        has_code = any(
+            line.strip() and not line.strip().startswith('#') for line in existing.splitlines()
+        )
+        if has_code:
+            return
+        stub = (
+            "import sys\n\n"
+            "def main():\n"
+            "    sys.stdin.read()\n"
+            "    print(0)\n\n"
+            "main()\n"
+        )
+        with open(path, 'w') as f:
+            f.write(stub)
+        safe_log("[forward] wrote fallback solution.py stub (no real code was produced)")
+
+    @staticmethod
+    def _is_synthetic_nudge(msg):
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content.strip().startswith('Your last reply was cut off')
+        if isinstance(content, list):
+            texts = [b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text']
+            return bool(texts) and all(t.strip().startswith('Your last reply was cut off') for t in texts) \
+                and not any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content)
+        return False
+
+    @staticmethod
+    def _is_empty_assistant(msg):
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content.strip() in ('', '(no output)')
+        if not isinstance(content, list):
+            return True
+        for block in content:
+            btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+            if btype == 'tool_use':
+                return False
+            text = block.get('text', '') if isinstance(block, dict) else getattr(block, 'text', '')
+            if str(text or '').strip() not in ('', '(no output)'):
+                return False
+        return True
+
+    def _clean_history(self, msg_history):
+        """Copy of msg_history without empty assistant turns and synthetic cut-off nudges.
+        Adjacent same-role messages are merged so roles keep alternating; returns [] if
+        nothing meaningful remains."""
+        kept = []
+        for msg in msg_history or []:
+            if not isinstance(msg, dict):
+                continue
+            if msg.get('role') == 'assistant' and self._is_empty_assistant(msg):
+                continue
+            if msg.get('role') == 'user' and self._is_synthetic_nudge(msg):
+                continue
+            kept.append(msg)
+        merged = []
+        for msg in kept:
+            if merged and merged[-1].get('role') == msg.get('role'):
+                prev = merged[-1]
+                prev_content = prev.get('content')
+                new_content = msg.get('content')
+                def as_list(c):
+                    if isinstance(c, list):
+                        return list(c)
+                    return [{"type": "text", "text": str(c or '')}]
+                merged[-1] = {"role": prev.get('role'), "content": as_list(prev_content) + as_list(new_content)}
+            else:
+                merged.append(dict(msg))
+        # The history must start with a user turn and end with an assistant turn,
+        # so that the next prompt keeps roles alternating.
+        while merged and merged[0].get('role') != 'user':
+            merged.pop(0)
+        while merged and merged[-1].get('role') != 'assistant':
+            merged.pop()
+        if not any(m.get('role') == 'assistant' for m in merged):
+            return []
+        return merged
+
