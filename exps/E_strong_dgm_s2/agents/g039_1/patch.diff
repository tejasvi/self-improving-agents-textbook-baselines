+    def _solution_ok(self):
+        """
+        Return True iff solution.py exists in git_tempdir, is non-empty, compiles,
+        and appears in the diff versus base_commit.
+        """
+        path = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.isfile(path):
+            return False
+        try:
+            with open(path, 'r') as f:
+                src = f.read()
+        except Exception:
+            return False
+        if not src.strip():
+            return False
+        try:
+            compile(src, 'solution.py', 'exec')
+        except Exception:
+            return False
+        try:
+            diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        except Exception:
+            return False
+        return 'diff --git a/solution.py' in diff
+
+    def _has_tool_use(self, msg_history):
+        """
+        Return True iff the last assistant message in msg_history contains a tool_use block.
+        """
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return False
+            for block in content or []:
+                btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+                if btype == 'tool_use':
+                    return True
+            return False
+        return False
