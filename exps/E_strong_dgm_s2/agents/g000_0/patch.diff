diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..f7b3e80
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,161 @@
+import os
+import re
+import subprocess
+import sys
+
+MAX_SHOW = 1500
+MAX_SHRINK_RUNS = 300
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a stdin-based solution against a brute-force reference using a random input generator.\n
+* `generator_path` is a Python (or other) program run as `<generator> <seed>` that prints ONE test input to stdout. Seeds 0..num_tests-1 are used, so make the generator produce small, edge-case-rich inputs for seeds (e.g. choose sizes/values from the seed).\n
+* `solution_path` and `brute_path` are run as `python3 <file>` with the input on stdin. Outputs are compared token by token (whitespace-insensitive).\n
+* Returns 'all N passed' if every test matches. Otherwise returns the first failing input (shrunk to a smaller counterexample when possible) with both outputs and any raw stderr/tracebacks. Read the raw output yourself to diagnose.\n
+* Use this after writing solution.py and brute.py; re-run it after every change to solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution program (reads stdin, writes stdout)."},
+                "brute_path": {"type": "string", "description": "Path to the brute-force reference program (reads stdin, writes stdout)."},
+                "generator_path": {"type": "string", "description": "Path to the generator program; invoked as `<generator> <seed>` and prints one test input to stdout."},
+                "num_tests": {"type": "integer", "description": "Number of random tests to run (seeds 0..num_tests-1). Default 200."},
+                "timeout_per_test": {"type": "integer", "description": "Time limit in seconds for each program run. Default 10."}
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a command. Returns (ok, stdout, stderr, note). ok is False on timeout or nonzero exit."""
+    try:
+        p = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True,
+                           timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        return False, '', '', f"timed out after {timeout} seconds"
+    if p.returncode != 0:
+        return False, p.stdout, p.stderr, f"exit code {p.returncode}"
+    return True, p.stdout, p.stderr, ''
+
+
+def _program_cmd(path):
+    if path.endswith('.py'):
+        return [sys.executable, path]
+    return [path]
+
+
+def _same(a, b):
+    return a.split() == b.split()
+
+
+def _clip(s, n=MAX_SHOW):
+    s = s.rstrip()
+    if len(s) <= n:
+        return s
+    return s[:n] + f"\n... <{len(s) - n} characters clipped>"
+
+
+def _check(sol_cmd, brute_cmd, text, timeout):
+    """Returns None if the solution agrees with the brute force (or the brute force itself
+    cannot run on this input, which means the input is invalid), else a dict describing the failure."""
+    b_ok, b_out, b_err, b_note = _run(brute_cmd, text, timeout)
+    if not b_ok:
+        return None  # brute cannot handle this input; not a valid counterexample
+    s_ok, s_out, s_err, s_note = _run(sol_cmd, text, timeout)
+    if s_ok and _same(s_out, b_out):
+        return None
+    return {
+        'input': text,
+        'sol_out': s_out,
+        'sol_err': s_err,
+        'sol_note': s_note if not s_ok else 'wrong answer',
+        'brute_out': b_out,
+    }
+
+
+def _candidates(text):
+    """Shrink candidates that keep the input shape: only integer values on lines after the first
+    (the first line usually holds counts, which must stay consistent with the data).
+    Each value is replaced by 0 or by half its magnitude."""
+    lines = text.split('\n')
+    seen = set()
+    for i in range(1, len(lines)):
+        line = lines[i]
+        for m in reversed(list(re.finditer(r'-?\d+', line))):
+            v = int(m.group())
+            options = [0, v // 2] if abs(v) > 1 else [0]
+            for nv in options:
+                if nv == v:
+                    continue
+                new_line = line[:m.start()] + str(nv) + line[m.end():]
+                cand = '\n'.join(lines[:i] + [new_line] + lines[i + 1:])
+                if cand not in seen:
+                    seen.add(cand)
+                    yield cand
+
+
+def _shrink(sol_cmd, brute_cmd, failure, timeout):
+    """Greedy shrinking: keep accepting any smaller input that still fails. Bounded in runs."""
+    current = failure
+    runs = 0
+    for _round in range(MAX_SHRINK_RUNS):  # bounded: at most MAX_SHRINK_RUNS accepted steps
+        accepted = False
+        for cand in _candidates(current['input']):
+            if runs >= MAX_SHRINK_RUNS:
+                return current
+            if len(cand) > len(current['input']):
+                continue
+            runs += 1
+            f = _check(sol_cmd, brute_cmd, cand, timeout)
+            if f is not None:
+                current = f
+                accepted = True
+                break
+        if not accepted:
+            break
+    return current
+
+
+def _format_failure(seed, failure, original, shrunk):
+    parts = [f"FAILED on seed {seed}."]
+    if shrunk:
+        parts.append("ORIGINAL FAILING INPUT:\n" + _clip(original['input'].rstrip()))
+        parts.append("Shrunk counterexample below only lowers values (header counts are kept); verify it is legal before trusting it.")
+    parts.append("INPUT:\n" + _clip(failure['input'].rstrip()))
+    parts.append("SOLUTION OUTPUT (" + failure['sol_note'] + "):\n" + _clip(failure['sol_out']))
+    if failure['sol_err'].strip():
+        parts.append("SOLUTION STDERR:\n" + _clip(failure['sol_err']))
+    parts.append("BRUTE OUTPUT:\n" + _clip(failure['brute_out']))
+    return "\n".join(parts)
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, timeout_per_test=10):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 5000))
+        timeout = max(1, min(int(timeout_per_test or 10), 120))
+    except (TypeError, ValueError):
+        return "Error: num_tests and timeout_per_test must be integers."
+
+    for label, path in (('solution_path', solution_path), ('brute_path', brute_path), ('generator_path', generator_path)):
+        if not os.path.isfile(path):
+            return f"Error: {label} does not exist: {path}"
+
+    sol_cmd = _program_cmd(os.path.abspath(solution_path))
+    brute_cmd = _program_cmd(os.path.abspath(brute_path))
+    gen_cmd = _program_cmd(os.path.abspath(generator_path))
+
+    for seed in range(num_tests):
+        g_ok, g_out, g_err, g_note = _run(gen_cmd + [str(seed)], '', timeout)
+        if not g_ok:
+            return f"Error: generator failed on seed {seed} ({g_note}).\nSTDERR:\n{_clip(g_err)}"
+        text = g_out
+        failure = _check(sol_cmd, brute_cmd, text, timeout)
+        if failure is None:
+            continue
+        shrunk = _shrink(sol_cmd, brute_cmd, failure, timeout)
+        return _format_failure(seed, shrunk, failure, shrunk is not failure)
+
+    return f"all {num_tests} passed"
