@@ -0,0 +1,78 @@
+import json
+import os
+import sys
+
+import pytest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+if ROOT not in sys.path:
+    sys.path.insert(0, ROOT)
+
+import coding_agent  # noqa: E402
+from utils.verify_common import file_sha256, candidate_dir, candidate_path  # noqa: E402
+
+REAL_CODE = "import sys\nprint(sys.stdin.read().strip())\n"
+HELPER_CODE = "from hidden import judge\nprint(judge())\n"
+
+
+def _make_agent(tmp_path):
+    agent = coding_agent.AgenticSystem.__new__(coding_agent.AgenticSystem)
+    agent.git_tempdir = str(tmp_path / 'repo')
+    os.makedirs(agent.git_tempdir)
+    agent._initial_code = REAL_CODE
+    return agent
+
+
+def _write_state(tmp_path, records):
+    state = tmp_path / 'state.json'
+    state.write_text(json.dumps(records))
+    return state
+
+
+def _store_candidate(code):
+    import hashlib
+    sha = hashlib.sha256(code.encode()).hexdigest()
+    os.makedirs(candidate_dir(), exist_ok=True)
+    with open(candidate_path(sha), 'w') as f:
+        f.write(code)
+    return sha
+
+
+def test_restore_ignores_helper_record(tmp_path, monkeypatch):
+    state = _write_state(tmp_path, [])
+    monkeypatch.setenv('AGENT_VERIFY_STATE', str(state))
+    agent = _make_agent(tmp_path)
+    sol = agent._solution_path()
+    helper = tmp_path / 'wrap.py'
+    helper.write_text(HELPER_CODE)
+    with open(sol, 'w') as f:
+        f.write(REAL_CODE)
+    real_sha = _store_candidate(REAL_CODE)
+    helper_sha = _store_candidate(HELPER_CODE)
+
+    records = [
+        # real solution: stress_compare with a harness failure (1 crash)
+        {'tool': 'stress_compare', 'solution_path': os.path.abspath(sol), 'solution_sha256': real_sha,
+         'num_tests': 100, 'mismatches': 0, 'crashes': 1, 'reference_path': '/nonexistent'},
+        # helper wrapper: looks perfect, but is not the solution file
+        {'tool': 'stress_compare', 'solution_path': os.path.abspath(helper), 'solution_sha256': helper_sha,
+         'num_tests': 100, 'mismatches': 0, 'crashes': 0, 'reference_path': '/nonexistent'},
+    ]
+    state.write_text(json.dumps(records))
+
+    before = open(sol).read()
+    snapshots = [{'label': 'initial', 'sha': real_sha, 'code': REAL_CODE, 'score': None}]
+    agent._restore_best(snapshots)
+    assert open(sol).read() == before
+    assert file_sha256(sol) == real_sha
+
+
+def test_sanity_gate_rejects_helper_code():
+    assert not coding_agent.sanity_gate(HELPER_CODE, REAL_CODE)
+    assert not coding_agent.sanity_gate("import sys\nsys.path.insert(0, '/x')\n", REAL_CODE)
+    assert not coding_agent.sanity_gate("x = '/tmp/data.txt'\n", REAL_CODE)
+    assert not coding_agent.sanity_gate("def f(:\n", REAL_CODE)
+    assert coding_agent.sanity_gate(REAL_CODE, REAL_CODE)
+    # a construct already present in the original file is allowed
+    original = "from hidden import judge\n"
+    assert coding_agent.sanity_gate(original + "print(1)\n", original)
