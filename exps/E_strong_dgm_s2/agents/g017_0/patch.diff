+def _hits_of_code(code):
+    """Set of suspicious constructs in `code`, as stable strings. Empty set if it does not parse."""
+    try:
+        tree = ast.parse(code)
+    except (SyntaxError, ValueError):
+        return None
+    stdlib = set(getattr(sys, 'stdlib_module_names', ())) | set(sys.builtin_module_names)
+    hits = set()
+    if 'sys.path.insert' in code:
+        hits.add('sys.path.insert')
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom):
+            top = (node.module or '').split('.')[0]
+            if node.level > 0 or (top and top not in stdlib):
+                hits.add(f"from-import:{'.' * node.level}{node.module}")
+        elif isinstance(node, ast.Import):
+            for alias in node.names:
+                top = alias.name.split('.')[0]
+                if top not in stdlib:
+                    hits.add(f"import:{alias.name}")
+        elif isinstance(node, ast.Constant) and isinstance(node.value, str):
+            if node.value.startswith('/work/') or node.value.startswith('/tmp/'):
+                hits.add(f"path-literal:{node.value}")
+        elif isinstance(node, ast.Call):
+            fn = node.func
+            name = fn.attr if isinstance(fn, ast.Attribute) else (fn.id if isinstance(fn, ast.Name) else '')
+            if name in SUBPROCESS_FUNCS:
+                for sub in ast.walk(node):
+                    if isinstance(sub, ast.Constant) and isinstance(sub.value, str) and sub.value.endswith('.py'):
+                        hits.add(f"subprocess-py:{sub.value}")
+    return hits
+
+
+def sanity_gate(code, original_code=''):
+    """True if `code` may replace solution.py.
+
+    It must parse, and must not contain any suspicious construct (sys.path.insert,
+    non-stdlib imports, /work or /tmp literals, subprocess launches of .py files)
+    unless the same construct already appeared in the original solution at the start of the run.
+    """
+    hits = _hits_of_code(code)
+    if hits is None:
+        return False
+    base = _hits_of_code(original_code or '') or set()
+    return not (hits - base)
+
