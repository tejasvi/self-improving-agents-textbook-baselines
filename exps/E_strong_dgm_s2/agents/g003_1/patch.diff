diff --git a/tools/check_samples.py b/tools/check_samples.py
new file mode 100644
index 0000000..c0b3aea
--- /dev/null
+++ b/tools/check_samples.py
@@ -0,0 +1,220 @@
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+TOL = 1e-6
+NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def tool_info():
+    return {
+        "name": "check_samples",
+        "description": """Run a Python solution on several sample inputs and compare each output with the expected output from the statement, reporting raw details.\n
+* Runs `python3 -I` on a temporary copy of the solution for each sample's `input` (isolated, scrubbed environment, like the grader).
+* For every sample reports one status: EXACT_MATCH (equal after trailing-whitespace normalisation), TOKEN_MATCH (same tokens, different whitespace), NUMERIC_MATCH_ONLY (tokens differ but numbers agree within 1e-6 relative/absolute tolerance, so the text itself is NOT identical), or MISMATCH.
+* Also returns the raw expected and actual outputs, the max relative error across numeric tokens, runtime, stderr, and raw warning lines for float formatting (decimal digit count differences, int vs float style, scientific notation). Treat every warning as something to fix: the hidden checker may compare text strictly.
+* Use it with every sample from the problem statement (extract each sample's input and expected output).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/solution.py)."
+                },
+                "samples": {
+                    "type": "array",
+                    "items": {"type": "object"},
+                    "description": "List of samples. Each object has 'input' (stdin text, string) and 'expected_output' (expected stdout text, string), copied from the problem statement."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _clip(s, n=4000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _norm_lines(s):
+    lines = [ln.rstrip() for ln in s.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def _to_float(tok):
+    if NUM_RE.match(tok):
+        try:
+            return float(tok)
+        except ValueError:
+            return None
+    return None
+
+
+def _decimals(tok):
+    """Number of digits after the decimal point in the mantissa, or None."""
+    mant = tok.lower().split('e')[0]
+    if '.' not in mant:
+        return 0
+    return len(mant.split('.', 1)[1])
+
+
+def _style(tok):
+    if 'e' in tok.lower() and _to_float(tok) is not None:
+        return 'scientific'
+    if '.' in tok:
+        return 'float-like'
+    return 'int-like'
+
+
+def _compare(expected, actual):
+    """Return (status, max_rel_err, warnings) with raw facts only."""
+    warnings = []
+    exp_lines = _norm_lines(expected)
+    act_lines = _norm_lines(actual)
+    if exp_lines == act_lines:
+        status = 'EXACT_MATCH'
+    else:
+        exp_tok = expected.split()
+        act_tok = actual.split()
+        if exp_tok == act_tok:
+            status = 'TOKEN_MATCH'
+        elif len(exp_tok) == len(act_tok):
+            status = 'NUMERIC_MATCH_ONLY'
+            for e, a in zip(exp_tok, act_tok):
+                if e == a:
+                    continue
+                fe, fa = _to_float(e), _to_float(a)
+                if fe is None or fa is None:
+                    status = 'MISMATCH'
+                    break
+                if abs(fe - fa) > TOL * max(1.0, abs(fe)):
+                    status = 'MISMATCH'
+                    break
+        else:
+            status = 'MISMATCH'
+
+    max_rel = None
+    exp_tok = expected.split()
+    act_tok = actual.split()
+    if len(exp_tok) == len(act_tok):
+        for e, a in zip(exp_tok, act_tok):
+            fe, fa = _to_float(e), _to_float(a)
+            if fe is None or fa is None:
+                continue
+            rel = abs(fe - fa) / max(abs(fe), 1e-18)
+            if max_rel is None or rel > max_rel:
+                max_rel = rel
+        # Format warnings for token pairs.
+        for e, a in zip(exp_tok, act_tok):
+            if e == a:
+                continue
+            fe, fa = _to_float(e), _to_float(a)
+            if fe is None or fa is None:
+                continue
+            se, sa = _style(e), _style(a)
+            if se != sa:
+                warnings.append(f"format differs: expected {se}, got {sa} (expected '{e}', actual '{a}')")
+                continue
+            de, da = _decimals(e), _decimals(a)
+            if de != da:
+                warnings.append(f"expected has {de} decimals, actual has {da} (expected '{e}', actual '{a}')")
+    elif status != 'EXACT_MATCH':
+        warnings.append(f"token count differs: expected {len(exp_tok)}, actual {len(act_tok)}")
+    return status, max_rel, warnings[:20]
+
+
+def _run_one(cmd, data, cwd, env, timeout):
+    start = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, text=True, cwd=cwd, env=env,
+                           timeout=timeout, errors='replace')
+        return p.stdout, p.stderr, p.returncode, round(time.time() - start, 3)
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return out, err + f"\n(timed out after {timeout} seconds)", 'TIMEOUT', round(time.time() - start, 3)
+
+
+def _parse_samples(samples):
+    if isinstance(samples, str):
+        try:
+            samples = json.loads(samples)
+        except ValueError:
+            return None, "Error: 'samples' is a string but not valid JSON"
+    if isinstance(samples, dict):
+        samples = [samples]
+    if not isinstance(samples, list):
+        return None, "Error: 'samples' must be a list of objects with 'input' and 'expected_output'"
+    return samples, None
+
+
+def tool_function(solution_path, samples, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    samples, err = _parse_samples(samples)
+    if err:
+        return err
+    if not samples:
+        return "Error: no samples given"
+
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    parts = []
+    summary = {}
+    with tempfile.TemporaryDirectory() as tmp:
+        dst = os.path.join(tmp, '_sol.py')
+        shutil.copyfile(solution_path, dst)
+        cmd = [sys.executable, '-I', '_sol.py']
+        for idx, s in enumerate(samples, 1):
+            if not isinstance(s, dict):
+                parts.append(f"--- sample {idx} ---\nSKIPPED: sample is not an object")
+                summary['SKIPPED'] = summary.get('SKIPPED', 0) + 1
+                continue
+            data = s.get('input', '')
+            expected = s.get('expected_output', '')
+            data = '' if data is None else str(data)
+            expected = '' if expected is None else str(expected)
+            out, errtext, code, elapsed = _run_one(cmd, data, tmp, env, timeout)
+            status, max_rel, warnings = _compare(expected, out)
+            if code != 0 and status != 'EXACT_MATCH':
+                status_note = f"(exit code {code})"
+            else:
+                status_note = ''
+            summary[status] = summary.get(status, 0) + 1
+            block = [
+                f"--- sample {idx}: {status} {status_note}".rstrip(),
+                f"exit code: {code}",
+                f"elapsed: {elapsed}s",
+                f"max relative error: {'n/a' if max_rel is None else f'{max_rel:.3g}'}",
+                "expected output (raw):",
+                repr(expected),
+                "actual output (raw):",
+                repr(_clip(out)),
+            ]
+            if warnings:
+                block.append("warnings:")
+                block.extend(f"  - {w}" for w in warnings)
+            else:
+                block.append("warnings: none")
+            block.append("stderr:")
+            block.append(_clip(errtext) if errtext else '(empty)')
+            parts.append('\n'.join(block))
+
+    head = "== Sample check summary: " + ", ".join(f"{k}={v}" for k, v in summary.items()) + " =="
+    return head + "\n\n" + "\n\n".join(parts)
