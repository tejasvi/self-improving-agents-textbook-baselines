+    def _fixed_inputs_from_dir(self, dir_path, max_files=300, max_chars=200000):
+        fixed, total = [], 0
+        if not os.path.isdir(dir_path):
+            return fixed
+        for name in sorted(os.listdir(dir_path))[:max_files]:
+            p = os.path.join(dir_path, name)
+            if not os.path.isfile(p):
+                continue
+            with open(p) as f:
+                text = f.read()
+            total += len(text)
+            if total > max_chars:
+                break
+            fixed.append(text)
+        return fixed
