+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_CLIP = 1500
+MAX_SHOWN_FAILURES = 3
+
+
+def tool_info():
+    return {
+        "name": "cross_check",
+        "description": """Cross-check several candidate solutions on the same generated and fixed inputs. Returns raw data only.
+* `solution_paths`: list of candidate Python files. Each is run as `python3 -I <file>` with the input on stdin, for every input.
+* `generator_path`: Python script run as `python3 -I <generator_path> <seed>`; its stdout is one input. Seeds 0..num_tests-1 are used.
+* `fixed_inputs`: optional list of input texts that are always tested too (e.g. the samples and hand-made edge cases).
+* `checker_path`: optional checker run as `python3 -I <checker_path> <input_file> <output_file>`; exit 0 means the output is valid. If given, pass/fail is decided by the checker (valid output). If not given, pass means: exit code 0, no timeout, and the output agrees with the output group that most candidates produced for that input (exact mode, whitespace-normalized).
+* Returns a per-candidate table: passes, fails, total time, max time, and exit codes; the output-equality groups per input (exact mode); the first few failing cases with each candidate's raw stdout, stderr, and exit code; and a final line `CROSS_CHECK_JSON {...}` with per-candidate pass counts and total times, so the best candidate can be chosen (most passes, ties broken by smaller total time).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_paths": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of candidate Python solution file paths to cross-check."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator script that takes a seed integer argument and prints one input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of generated inputs (seeds 0..num_tests-1). Default 50."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional. Path to a checker script run as `python3 -I checker.py <input_file> <output_file>`; exit 0 if the output is valid for the input, non-zero otherwise."
+                },
+                "fixed_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional. List of fixed input texts tested in addition to the generated ones."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each candidate, generator and checker. Default 5."
+                }
+            },
+            "required": ["solution_paths", "generator_path"]
+        }
+    }
+
+
+def _env():
+    return {"PATH": os.environ.get("PATH", "")}
+
+
+def _text(x):
+    if x is None:
+        return ""
+    if isinstance(x, bytes):
+        return x.decode(errors="replace")
+    return x
+
+
+def _clip(s, n=MAX_CLIP):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n...[clipped {len(s) - n} chars]...\n" + s[-n // 2:]
+
+
+def _run(cmd, data, timeout):
+    """Returns (stdout, stderr, returncode, timed_out, elapsed)."""
+    t0 = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, text=True,
+                           timeout=timeout, env=_env())
+        return p.stdout, p.stderr, p.returncode, False, time.time() - t0
+    except subprocess.TimeoutExpired as e:
+        return _text(e.stdout), _text(e.stderr), None, True, time.time() - t0
+
+
+def _norm(s):
+    return " ".join(s.split())
+
+
+def _checker_ok(checker_path, inp, out, timeout):
+    with tempfile.TemporaryDirectory() as td:
+        in_f = os.path.join(td, "input.txt")
+        out_f = os.path.join(td, "output.txt")
+        with open(in_f, "w") as f:
+            f.write(inp)
+        with open(out_f, "w") as f:
+            f.write(out)
+        so, se, rc, to, _ = _run([sys.executable, "-I", checker_path, in_f, out_f], None, timeout)
+        return rc == 0, so, se, rc, to
+
+
+def tool_function(solution_paths, generator_path, num_tests=50, checker_path=None,
+                  fixed_inputs=None, timeout=5):
+    num_tests = int(num_tests)
+    timeout = int(timeout)
+    if isinstance(solution_paths, str):
+        solution_paths = [solution_paths]
+    solution_paths = list(solution_paths or [])
+    if not solution_paths:
+        return "Error: solution_paths is empty."
+    for p in solution_paths:
+        if not os.path.isfile(p):
+            return f"Error: solution file not found: {p}"
+
+    inputs = []
+    for i in range(num_tests):
+        so, se, rc, to, _ = _run([sys.executable, "-I", generator_path, str(i)], None, timeout)
+        if to or rc != 0:
+            return f"Generator failed for seed {i}: timeout={to}, exit code={rc}\nstderr:\n{se}"
+        inputs.append((f"seed {i}", so))
+    for j, text in enumerate(fixed_inputs or []):
+        inputs.append((f"fixed input #{j}", str(text)))
+
+    n = len(solution_paths)
+    names = [os.path.basename(p) for p in solution_paths]
+    passes = [0] * n
+    fails = [0] * n
+    total_time = [0.0] * n
+    max_time = [0.0] * n
+    failures = []          # raw records for the first few failing cases
+    group_lines = []       # exact-mode output groups per input (only groups with >1 candidate or all)
+    mode = "checker" if checker_path else "exact"
+
+    for label, inp in inputs:
+        results = []
+        for k, path in enumerate(solution_paths):
+            so, se, rc, to, el = _run([sys.executable, "-I", path], inp, timeout)
+            total_time[k] += el
+            max_time[k] = max(max_time[k], el)
+            results.append({"out": so, "err": se, "rc": rc, "to": to, "el": el})
+
+        if checker_path is None:
+            # Majority output group among clean runs (exact mode reference).
+            groups = {}
+            for k, r in enumerate(results):
+                if r["rc"] == 0 and not r["to"]:
+                    groups.setdefault(_norm(r["out"]), []).append(k)
+            ref = None
+            if groups:
+                ref = max(groups.items(), key=lambda kv: (len(kv[1]), -min(kv[1])))[0]
+            oks = [r["rc"] == 0 and not r["to"] and ref is not None and _norm(r["out"]) == ref for r in results]
+            if groups:
+                desc = "; ".join(
+                    f"[{', '.join(names[k] for k in ks)}] -> {len(_norm(o))} chars"
+                    for o, ks in groups.items()
+                )
+                group_lines.append(f"{label}: {len(groups)} output group(s): {desc}")
+            else:
+                group_lines.append(f"{label}: no candidate ran cleanly")
+        else:
+            oks = []
+            for r in results:
+                if r["rc"] != 0 or r["to"]:
+                    oks.append(False)
+                    r["check"] = None
+                    continue
+                ok, co, ce, crc, cto = _checker_ok(checker_path, inp, r["out"], timeout)
+                r["check"] = {"out": co, "err": ce, "rc": crc, "to": cto}
+                oks.append(ok)
+
+        for k, ok in enumerate(oks):
+            if ok:
+                passes[k] += 1
+            else:
+                fails[k] += 1
+        if not all(oks) and len(failures) < MAX_SHOWN_FAILURES:
+            failures.append((label, inp, results, oks))
+
+    lines = []
+    lines.append(f"Cross-check: {len(inputs)} inputs ({num_tests} generated, {len(fixed_inputs or [])} fixed), mode={mode}, timeout={timeout}s")
+    lines.append("")
+    lines.append(f"{'candidate':<24}{'passes':>8}{'fails':>8}{'total_s':>10}{'max_s':>10}")
+    for k in range(n):
+        lines.append(f"{names[k]:<24}{passes[k]:>8}{fails[k]:>8}{total_time[k]:>10.3f}{max_time[k]:>10.3f}")
+    lines.append("")
+
+    if mode == "exact":
+        lines.append("Output-equality groups per input (exact mode, whitespace-normalized):")
+        lines.extend(group_lines[:50])
+        if len(group_lines) > 50:
+            lines.append(f"...({len(group_lines) - 50} more inputs)")
+        lines.append("")
+
+    if failures:
+        lines.append(f"First {len(failures)} failing input(s):")
+        for label, inp, results, oks in failures:
+            lines.append(f"=== {label} ===")
+            lines.append("INPUT:")
+            lines.append(_clip(inp, 800))
+            for k, r in enumerate(results):
+                status = "PASS" if oks[k] else "FAIL"
+                lines.append(f"--- {names[k]}: {status}, exit code={r['rc']}, timed out={r['to']}, time={r['el']:.3f}s")
+                lines.append("stdout:")
+                lines.append(_clip(r["out"]))
+                lines.append("stderr:")
+                lines.append(_clip(r["err"]))
+                if r.get("check") is not None:
+                    lines.append(f"checker exit code={r['check']['rc']}, timed out={r['check']['to']}")
+                    lines.append("checker stdout:")
+                    lines.append(_clip(r["check"]["out"]))
+                    lines.append("checker stderr:")
+                    lines.append(_clip(r["check"]["err"]))
+            lines.append("")
+    else:
+        lines.append("No failing inputs.")
+
+    summary = {
+        "candidates": {names[k]: {"path": solution_paths[k], "passes": passes[k], "fails": fails[k],
+                                  "total_time": round(total_time[k], 3)} for k in range(n)},
+        "num_inputs": len(inputs),
+    }
+    lines.append("CROSS_CHECK_JSON " + json.dumps(summary, sort_keys=True))
+    return "\n".join(lines)
