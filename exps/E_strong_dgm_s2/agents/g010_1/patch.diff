diff --git a/tools/exact_eval.py b/tools/exact_eval.py
new file mode 100644
index 0000000..a2fcdbc
--- /dev/null
+++ b/tools/exact_eval.py
@@ -0,0 +1,98 @@
+import subprocess
+import sys
+import os
+
+
+def tool_info():
+    return {
+        "name": "exact_eval",
+        "description": """Evaluate a numeric Python expression or small snippet with exact arithmetic, for building exact brute forces of real-valued answers.
+* Runs in a fresh `python3 -I` subprocess. Available names: `Fraction` (fractions.Fraction), `Decimal` and `getcontext` (decimal), `math`.
+* `code` is either a single expression (e.g. `Fraction(1,3) + Fraction(2,7)` or `Decimal(2).sqrt()`), or a multi-line snippet. For a snippet, the value is taken from the variable `result` if it is defined, otherwise from the last line if that is an expression.
+* `precision` sets the Decimal context precision (significant digits, default 50). Fractions are always exact. Use Fraction for rationals; use Decimal with enough precision when the computation involves roots, logs or exp.
+* Returns: the exact value as a string (Fraction as p/q, Decimal with its digits), the correctly rounded Python float and its repr, and the value formatted to 20 decimal places. Use the float repr or the fixed-decimal string to compare against solution output text; do not round to the statement's tolerance.
+* Errors (syntax, exceptions) are returned raw in the output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "code": {
+                    "type": "string",
+                    "description": "A Python expression, or a snippet whose result is in variable `result` (or the last expression line)."
+                },
+                "precision": {
+                    "type": "integer",
+                    "description": "Decimal context precision in significant digits. Default 50."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds. Default 10."
+                }
+            },
+            "required": ["code"]
+        }
+    }
+
+
+_RUNNER = r'''
+import sys, math
+from fractions import Fraction
+from decimal import Decimal, getcontext, localcontext
+prec = int(sys.argv[1])
+getcontext().prec = prec
+code = sys.stdin.read()
+ns = {"Fraction": Fraction, "Decimal": Decimal, "getcontext": getcontext, "math": math}
+lines = [l for l in code.strip("\n").split("\n")]
+try:
+    import ast
+    tree = ast.parse(code, mode="exec")
+    last_expr = None
+    if tree.body and isinstance(tree.body[-1], ast.Expr):
+        last_expr = tree.body.pop()
+    exec(compile(tree, "<snippet>", "exec"), ns)
+    if last_expr is not None:
+        ns["result"] = eval(compile(ast.Expression(last_expr.value), "<snippet>", "eval"), ns)
+    if "result" not in ns:
+        print("ERROR: no `result` variable and no final expression")
+        sys.exit(0)
+    val = ns["result"]
+    if isinstance(val, Fraction):
+        print("EXACT: " + str(val))
+        f = float(val)
+        scaled = (abs(val.numerator) * 10**20 * 2 + val.denominator) // (2 * val.denominator)
+        sign = "-" if val < 0 and scaled != 0 else ""
+        ip, fp = divmod(scaled, 10**20)
+        fixed = f"{sign}{ip}.{fp:020d}"
+        print("FLOAT: " + repr(f))
+        print("FIXED20: " + fixed)
+    elif isinstance(val, Decimal):
+        print("EXACT: " + str(val))
+        f = float(val)
+        print("FLOAT: " + repr(f))
+        print("FIXED20: " + format(val, ".20f"))
+    else:
+        f = float(val)
+        print("EXACT: " + repr(val))
+        print("FLOAT: " + repr(f))
+        print("FIXED20: " + format(Decimal(f), ".20f"))
+except SystemExit:
+    raise
+except Exception as e:
+    print("ERROR: " + type(e).__name__ + ": " + str(e))
+'''
+
+
+def tool_function(code, precision=50, timeout=10):
+    precision = int(precision)
+    timeout = int(timeout)
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", "-c", _RUNNER, str(precision)],
+            input=code, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s"
+    out = p.stdout
+    if p.returncode != 0 or p.stderr.strip():
+        out += f"\nSTDERR:\n{p.stderr}\nexit code: {p.returncode}"
+    return out.strip() or "(no output)"
