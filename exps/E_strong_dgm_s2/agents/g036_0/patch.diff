diff --git a/tools/precision_check.py b/tools/precision_check.py
new file mode 100644
index 0000000..4a091f9
--- /dev/null
+++ b/tools/precision_check.py
@@ -0,0 +1,251 @@
+import os
+import subprocess
+import sys
+from decimal import Decimal, InvalidOperation
+from fractions import Fraction
+
+TIMEOUT_DEFAULT = 10
+MAX_SHOW = 1500
+FLAG_ULP = 1  # flag when the solution's error exceeds this many ulps
+MAX_PAIRS_SHOWN = 5
+
+
+def tool_info():
+    return {
+        "name": "precision_check",
+        "description": """Check the numeric precision of a real-valued output against an exact-arithmetic reference.\n
+* `solution_path` is the solution program (run as `python3 <file>`, input on stdin).
+* `reference_path` is an exact reference program YOU write (e.g. using fractions.Fraction or decimal with >= 40 digits of precision). It must print the exact answer with at least 30 significant digits.
+* `input_paths` is a list of input files; each is fed to both programs via stdin.
+* For each input it parses the first numeric token of each output and reports: both printed strings, the relative error computed exactly, the error in ulps (units in the last place of the double nearest the reference value), the number of matching significant digits, and whether the solution's printed digits equal the reference correctly rounded to the same number of decimals.
+* Inputs are FLAGGED when the solution's error exceeds about 1 ulp or its printed digits differ from the correctly rounded reference.
+* Ends with a summary: number of inputs, number whose printed strings differ, number flagged, max ulp error, max relative error.
+* Output is raw text. Passing a tolerance-based checker is NOT sufficient evidence that the hidden grader will accept the output: aim for printed digits that equal the correctly rounded exact value.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout)."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the exact-arithmetic reference program (reads stdin, prints the exact answer with >= 30 significant digits)."
+                },
+                "input_paths": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of paths to input files; each file is fed to both programs via stdin."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Time limit in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_path", "reference_path", "input_paths"]
+        }
+    }
+
+
+def _run(path, in_path, timeout):
+    """Runs `python3 path` with in_path as stdin. Returns (ok, stdout, stderr, note)."""
+    try:
+        with open(in_path) as fin:
+            p = subprocess.run(['python3', path], stdin=fin, capture_output=True, text=True,
+                               timeout=timeout, errors='replace')
+    except subprocess.TimeoutExpired:
+        return False, '', '', f"timed out after {timeout} seconds"
+    if p.returncode != 0:
+        return False, p.stdout, p.stderr, f"exit code {p.returncode}"
+    return True, p.stdout, p.stderr, ''
+
+
+def _clip(s, n=MAX_SHOW):
+    s = s.rstrip()
+    if len(s) <= n:
+        return s
+    return s[:n] + f"\n... <{len(s) - n} characters clipped>"
+
+
+def _first_number(out):
+    """Returns (token, Fraction) for the first token of the output that is an exact decimal, else (None, None)."""
+    for tok in out.split():
+        try:
+            val = Fraction(Decimal(tok))
+        except (InvalidOperation, ValueError, TypeError):
+            continue
+        if not val.denominator:
+            continue
+        return tok, val
+    return None, None
+
+
+def _floor_log2(q):
+    """floor(log2(q)) for a positive Fraction q, computed exactly."""
+    e = q.numerator.bit_length() - q.denominator.bit_length()
+    if Fraction(2) ** e > q:
+        e -= 1
+    elif Fraction(2) ** (e + 1) <= q:
+        e += 1
+    return e
+
+
+def _ulp_of(r):
+    """Unit in the last place of the double nearest |r| (r a nonzero Fraction)."""
+    a = abs(r)
+    e = max(_floor_log2(a), -1022)
+    return Fraction(2) ** (e - 52)
+
+
+def _decimals(tok):
+    """Number of digits after the decimal point in the printed token (exponent taken into account)."""
+    try:
+        exp = Decimal(tok).as_tuple().exponent
+    except (InvalidOperation, ValueError):
+        return 0
+    return max(0, -exp) if isinstance(exp, int) else 0
+
+
+def _sig_form(tok):
+    """(digits, point) such that the value is 0.<digits> * 10^point with no leading or trailing zeros."""
+    d = Decimal(tok)
+    t = d.as_tuple()
+    if d == 0:
+        return '', 0
+    orig = ''.join(str(x) for x in t.digits)
+    lead = len(orig) - len(orig.lstrip('0'))
+    digits = orig.lstrip('0').rstrip('0')
+    point = len(orig) + t.exponent - lead
+    return digits, point
+
+
+def _matching_sig_digits(tok_a, tok_b):
+    da, pa = _sig_form(tok_a)
+    db, pb = _sig_form(tok_b)
+    if da == '' or db == '':
+        return len(da) if da == db else 0
+    if pa != pb:
+        return 0
+    n = 0
+    for x, y in zip(da, db):
+        if x != y:
+            break
+        n += 1
+    return n
+
+
+def _correctly_rounded(ref, decimals):
+    """ref rounded half-even to `decimals` digits after the point, as an exact Fraction."""
+    scale = Fraction(10) ** decimals
+    return Fraction(round(ref * scale), 1) / scale
+
+
+def _fmt(x):
+    try:
+        return f"{float(x):.6e}"
+    except (OverflowError, ValueError):
+        return str(x)
+
+
+def _compare_one(sol_out, ref_out):
+    """Returns a dict with the comparison of one input. Raw strings are kept for display."""
+    s_tok, s_val = _first_number(sol_out)
+    r_tok, r_val = _first_number(ref_out)
+    info = {'s_tok': s_tok, 'r_tok': r_tok}
+    if s_tok is None or r_tok is None:
+        info['error'] = 'no numeric token found in ' + ('solution' if s_tok is None else 'reference') + ' output'
+        return info
+    diff = abs(s_val - r_val)
+    if r_val != 0:
+        rel = diff / abs(r_val)
+        ulp = _ulp_of(r_val)
+    else:
+        rel = None
+        ulp = Fraction(1, 2 ** 1074)
+    info['rel'] = rel if rel is not None else (0 if diff == 0 else None)
+    info['abs'] = diff
+    info['ulp_err'] = diff / ulp
+    info['match_sig'] = _matching_sig_digits(s_tok, r_tok)
+    info['strings_equal'] = s_tok == r_tok
+    dec = _decimals(s_tok)
+    info['correct_round'] = (s_val == _correctly_rounded(r_val, dec))
+    info['flag'] = (info['ulp_err'] > FLAG_ULP) or (not info['correct_round'])
+    return info
+
+
+def tool_function(solution_path, reference_path, input_paths, timeout=TIMEOUT_DEFAULT):
+    try:
+        timeout = max(1, min(int(timeout or TIMEOUT_DEFAULT), 120))
+    except (TypeError, ValueError):
+        return "Error: timeout must be an integer."
+    if isinstance(input_paths, str):
+        input_paths = [input_paths]
+    if not input_paths:
+        return "Error: input_paths is empty."
+    for label, path in (('solution_path', solution_path), ('reference_path', reference_path)):
+        if not os.path.isfile(path):
+            return f"Error: {label} does not exist: {path}"
+    for p in input_paths:
+        if not os.path.isfile(p):
+            return f"Error: input file does not exist: {p}"
+    solution_path = os.path.abspath(solution_path)
+    reference_path = os.path.abspath(reference_path)
+
+    lines = []
+    n_differ = 0
+    n_flag = 0
+    n_bad = 0
+    max_ulp = None
+    max_rel = None
+    differing = []  # (path, s_tok, r_tok, match_sig)
+    for path in input_paths:
+        lines.append(f"== input: {path}")
+        ok_s, s_out, s_err, s_note = _run(solution_path, path, timeout)
+        ok_r, r_out, r_err, r_note = _run(reference_path, path, timeout)
+        if not ok_r:
+            n_bad += 1
+            lines.append(f"  REFERENCE FAILED: {r_note}\n  stderr:\n{_clip(r_err)}")
+            continue
+        if not ok_s:
+            n_bad += 1
+            lines.append(f"  SOLUTION FAILED: {s_note}\n  stderr:\n{_clip(s_err)}")
+            continue
+        info = _compare_one(s_out, r_out)
+        if 'error' in info:
+            n_bad += 1
+            lines.append(f"  {info['error']}\n  solution output:\n{_clip(s_out) or '(empty)'}\n  reference output:\n{_clip(r_out) or '(empty)'}")
+            continue
+        if not info['strings_equal']:
+            n_differ += 1
+            differing.append((path, info['s_tok'], info['r_tok'], info['match_sig']))
+        if info['flag']:
+            n_flag += 1
+        if info['ulp_err'] is not None and (max_ulp is None or info['ulp_err'] > max_ulp):
+            max_ulp = info['ulp_err']
+        if info['rel'] is not None and (max_rel is None or info['rel'] > max_rel):
+            max_rel = info['rel']
+        lines.append(f"  solution printed: {info['s_tok']}")
+        lines.append(f"  reference printed: {info['r_tok']}")
+        lines.append(f"  relative error: {_fmt(info['rel']) if info['rel'] is not None else 'n/a (reference is 0)'}  "
+                     f"abs error: {_fmt(info['abs'])}  ulp error: {float(info['ulp_err']):.3f}")
+        lines.append(f"  matching significant digits: {info['match_sig']}  "
+                     f"strings equal: {'yes' if info['strings_equal'] else 'no'}  "
+                     f"equal to correctly rounded reference: {'yes' if info['correct_round'] else 'no'}")
+        lines.append("  FLAG" if info['flag'] else "  ok")
+        if info['flag'] and not info['correct_round']:
+            lines.append("  (printed digits differ from the reference rounded to the same number of decimals)")
+
+    lines.append("== summary")
+    lines.append(f"inputs: {len(input_paths)}, printed strings differ: {n_differ}, flagged: {n_flag}, failed runs: {n_bad}")
+    if max_ulp is not None:
+        lines.append(f"max ulp error: {float(max_ulp):.3f}")
+    if max_rel is not None:
+        lines.append(f"max relative error: {_fmt(max_rel)}")
+    if differing:
+        lines.append("first differing pairs (solution vs reference, matching significant digits):")
+        for path, s_tok, r_tok, ms in differing[:MAX_PAIRS_SHOWN]:
+            lines.append(f"  {path}: {s_tok} vs {r_tok}  matching digits: {ms}")
+    if n_flag:
+        lines.append("FLAGGED: the printed digits are not the correctly rounded exact value. Recompute the final value exactly "
+                     "(e.g. Fraction/Decimal with >= 40 digits) and print with at least 15 decimals.")
+    return '\n'.join(lines)
