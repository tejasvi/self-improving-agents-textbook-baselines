+    Returns None when no such pair exists."""
+    best = None
+    for ta, tb in zip(a.split(), b.split()):
+        if ta == tb:
+            continue
+        try:
+            fa, fb = float(ta), float(tb)
+        except ValueError:
+            continue
+        if fa != fa or fb != fb:  # NaN
+            continue
