+    def _added_line_numbers(self, patch):
+        """New-file line numbers of the '+' lines in a single-file unified diff."""
+        added = set()
+        new_no = None
+        for line in patch.splitlines():
+            if line.startswith('@@'):
+                m = re.match(r'@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@', line)
+                new_no = int(m.group(1)) if m else None
+                continue
+            if new_no is None:
+                continue  # file header lines before the first hunk
+            if line.startswith('diff --git'):
+                new_no = None
+            elif line.startswith('+'):
+                added.add(new_no)
+                new_no += 1
+            elif line.startswith(' '):
+                new_no += 1
+            # '-' and '\\ No newline' lines do not advance the new-file counter
+        return added
+
