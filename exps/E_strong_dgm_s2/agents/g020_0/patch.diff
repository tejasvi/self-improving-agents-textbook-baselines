+import re
+
+_CUT_OFF_PHRASE = 'Your last reply was cut off by the output limit'
+_EMPTY_REPLIES = ('', '(no output)')
+
+
+def _get(obj, key):
+    """Read `key` from a dict block or an SDK object block."""
+    if isinstance(obj, dict):
+        return obj.get(key)
+    return getattr(obj, key, None)
+
+
+def _content_blocks(msg):
+    content = _get(msg, 'content')
+    if content is None:
+        return []
+    if isinstance(content, str):
+        return [{'type': 'text', 'text': content}]
+    return list(content)
+
+
+def _block_text(block):
+    if isinstance(block, str):
+        return block
+    if _get(block, 'type') == 'text':
+        return _get(block, 'text') or ''
+    return ''
+
+
+def _has_tool_blocks(msg):
+    return any(_get(b, 'type') in ('tool_use', 'tool_result') for b in _content_blocks(msg))
+
+
+def _sanitize_history(msg_history):
+    """Drop empty / '(no output)' assistant turns and injected 'cut off' user turns.
+
+    Messages containing tool_use or tool_result blocks are always kept.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        role = _get(msg, 'role')
+        if _has_tool_blocks(msg):
+            cleaned.append(msg)
+            continue
+        text = "\n".join(_block_text(b) for b in _content_blocks(msg)).strip()
+        if role == 'assistant' and text in _EMPTY_REPLIES:
+            continue
+        if role == 'user' and text.startswith(_CUT_OFF_PHRASE):
+            continue
+        cleaned.append(msg)
+    return cleaned
+
+
+def _made_tool_call(msg_history):
+    """True if the history contains a tool call (tool_use block or '<tool_use>' text marker)."""
+    for msg in msg_history or []:
+        for block in _content_blocks(msg):
+            if _get(block, 'type') == 'tool_use':
+                return True
+            if '<tool_use>' in _block_text(block):
+                return True
+    return False
+
+
