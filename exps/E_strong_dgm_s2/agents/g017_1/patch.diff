+import hashlib
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import time
+
+PROFILES = ['tiny', 'boundary', 'degenerate', 'medium', 'max']
+MAX_CORPUS = 50          # max saved failing inputs kept in corpus_dir
+REPLAY_BUDGET_S = 90.0   # wall-clock budget for one replay pass
+NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def tool_info():
+    return {
+        "name": "diff_test",
+        "description": """Differential tester: runs candidate Python solutions (and optionally a trusted reference) on generated inputs and returns a RAW report.
+
+* Generator: `python3 generator_path <seed> <profile>` must print one test input to stdout. Profiles cycle through: tiny, boundary, degenerate, medium, max. Case i uses profile i mod 5 and seed i + seed_offset.
+* Each solution runs as `python3 -I <file>` with a timeout. Outputs are compared token by token: non-numeric tokens must match exactly, numeric tokens match within rel_tol.
+* If reference_path is given, its output is the expected output; otherwise the first solution's output is used as the expected output.
+* Report: per-candidate pass/fail counts, the first failing inputs in full with every candidate's output and the expected output, timeouts, crashes with stderr, and max runtime per profile.
+* Failing inputs are saved to corpus_dir as fail_*.txt (input) and fail_*.expected.txt (expected output) so they persist for later replay.
+* mode='replay' re-runs only the saved corpus in corpus_dir on the given solutions. Use it on every new candidate.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_paths": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Paths to candidate Python solution files to test (e.g. [\"/dgm/solution.py\", \"/work/repo_tests/cand2.py\"])."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator script. Invoked as `python3 generator_path <seed> <profile>`; prints one input to stdout. Profiles: tiny, boundary, degenerate, medium, max."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Optional path to a trusted reference (brute force or exact) Python program. Its output is the expected output."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of generated cases in run mode (default 200)."
+                },
+                "seed_offset": {
+                    "type": "integer",
+                    "description": "Added to every generator seed in run mode, to get fresh inputs (default 0)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds (default 10)."
+                },
+                "rel_tol": {
+                    "type": "number",
+                    "description": "Relative/absolute tolerance for numeric tokens (default 1e-6)."
+                },
+                "corpus_dir": {
+                    "type": "string",
+                    "description": "Directory where failing inputs are saved (fail_*.txt) and replayed from. Use a persistent path outside solution.py, e.g. /work/repo_tests/corpus."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["run", "replay"],
+                    "description": "'run' generates num_cases new inputs and saves failures to corpus_dir; 'replay' only re-runs the saved corpus in corpus_dir. Default 'run'."
+                }
+            },
+            "required": ["solution_paths", "generator_path"]
+        }
+    }
+
+
+def _clip(s, n=20000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _as_float(tok):
+    if NUM_RE.match(tok):
+        try:
+            return float(tok)
+        except ValueError:
+            return None
+    return None
+
+
+def outputs_match(a, b, rel_tol=1e-6):
+    """Token-wise comparison: exact for non-numeric tokens, tolerance for numeric ones."""
+    ta, tb = a.split(), b.split()
+    if len(ta) != len(tb):
+        return False
+    for x, y in zip(ta, tb):
+        if x == y:
+            continue
+        fx, fy = _as_float(x), _as_float(y)
+        if fx is None or fy is None:
+            return False
+        if abs(fx - fy) > rel_tol * max(1.0, abs(fx), abs(fy)):
+            return False
+    return True
+
+
+def _run_cmd(cmd, data, timeout, env, cwd):
+    start = time.time()
+    try:
+        p = subprocess.run(cmd, input=data, capture_output=True, text=True,
+                           timeout=timeout, env=env, cwd=cwd)
+        status = 'ok' if p.returncode == 0 else f'exit {p.returncode}'
+        return {'status': status, 'stdout': p.stdout or '', 'stderr': p.stderr or '',
+                'elapsed': round(time.time() - start, 3)}
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+        err = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return {'status': 'TIMEOUT', 'stdout': out, 'stderr': err,
+                'elapsed': round(time.time() - start, 3)}
+
+
+def _candidate_names(solution_paths):
+    names, paths = [], {}
+    for i, p in enumerate(solution_paths):
+        name = f"{i + 1}:{os.path.basename(p)}"
+        names.append(name)
+        paths[name] = p
+    return names, paths
+
+
+def _verdicts(results, names, expected, rel_tol):
+    out = {}
+    for n in names:
+        r = results[n]
+        if r['status'] != 'ok':
+            out[n] = (False, r['status'])
+        elif expected is None:
+            out[n] = (True, 'no expected')
+        elif outputs_match(r['stdout'], expected, rel_tol):
+            out[n] = (True, 'match')
+        else:
+            out[n] = (False, 'wrong answer')
+    return out
+
+
+def _evaluate_input(data, names, paths, reference, saved_expected, env, cwd, timeout, rel_tol):
+    """Runs reference (if any) and candidates on data. Returns (expected, ref_result, results, verdicts)."""
+    ref_res = _run_cmd([sys.executable, '-I', reference], data, timeout, env, cwd) if reference else None
+    results = {n: _run_cmd([sys.executable, '-I', paths[n]], data, timeout, env, cwd) for n in names}
+    if ref_res is not None:
+        expected = ref_res['stdout'] if ref_res['status'] == 'ok' else None
+    elif saved_expected is not None:
+        expected = saved_expected
+    else:
+        ok_outs = [results[n]['stdout'] for n in names if results[n]['status'] == 'ok']
+        expected = ok_outs[0] if ok_outs else None
+    return expected, ref_res, results, _verdicts(results, names, expected, rel_tol)
+
+
+def _fmt_case(label, data, expected, results, names):
+    lines = [f"=== failing case [{label}] ===", "input:", data.rstrip('\n') or '(empty)']
+    lines += ["expected:", (expected or '(none)').rstrip('\n') or '(empty)']
+    for n in names:
+        r = results[n]
+        lines.append(f"--- {n}: {r['status']}, {r['elapsed']}s")
+        lines.append("stdout:")
+        lines.append(r['stdout'].rstrip('\n') or '(empty)')
+        if r['stderr'].strip():
+            lines.append("stderr:")
+            lines.append(r['stderr'].rstrip('\n')[-1500:])
+    return "\n".join(lines)
+
+
+def _save_failure(corpus_dir, data, expected):
+    os.makedirs(corpus_dir, exist_ok=True)
+    key = hashlib.sha1(data.encode('utf-8', 'replace')).hexdigest()[:12]
+    base = os.path.join(corpus_dir, f'fail_{key}')
+    with open(base + '.txt', 'w') as f:
+        f.write(data)
+    if expected is not None:
+        with open(base + '.expected.txt', 'w') as f:
+            f.write(expected)
+    return base + '.txt'
+
+
+def _corpus_files(corpus_dir):
+    if not corpus_dir or not os.path.isdir(corpus_dir):
+        return []
+    return sorted(os.path.join(corpus_dir, f) for f in os.listdir(corpus_dir)
+                  if f.startswith('fail_') and f.endswith('.txt') and not f.endswith('.expected.txt'))
+
+
+def run_suite(solution_paths, generator_path, reference_path=None, num_cases=200, timeout=10,
+              rel_tol=1e-6, corpus_dir=None, seed_offset=0):
+    """Generates num_cases inputs, runs all candidates, saves failures to corpus_dir (if given).
+    Returns a dict with structured counts plus the raw report text."""
+    names, paths = _candidate_names(solution_paths)
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    counts = {n: {'pass': 0, 'fail': 0} for n in names}
+    fail_kinds = {n: {} for n in names}
+    timeouts = {n: 0 for n in names}
+    crashes = {n: 0 for n in names}
+    max_time = {p: {n: 0.0 for n in names} for p in PROFILES}
+    shown, saved, gen_errors = [], [], []
+    ran = 0
+    with tempfile.TemporaryDirectory() as cwd:
+        for i in range(num_cases):
+            profile = PROFILES[i % len(PROFILES)]
+            seed = i + int(seed_offset or 0)
+            g = _run_cmd([sys.executable, '-I', generator_path, str(seed), profile], '', timeout, env, cwd)
+            if g['status'] != 'ok':
+                gen_errors.append(f"seed {seed} [{profile}] generator {g['status']}: {g['stderr'][-500:]}")
+                continue
+            ran += 1
+            data = g['stdout']
+            expected, ref_res, results, verdicts = _evaluate_input(
+                data, names, paths, reference_path, None, env, cwd, timeout, rel_tol)
+            if reference_path and (ref_res is None or ref_res['status'] != 'ok'):
+                gen_errors.append(f"seed {seed} [{profile}] reference "
+                                  f"{ref_res['status'] if ref_res else 'missing'}: "
+                                  f"{(ref_res or {}).get('stderr', '')[-500:]}")
+            any_fail = False
+            for n in names:
+                r = results[n]
+                max_time[profile][n] = max(max_time[profile][n], r['elapsed'])
+                if verdicts[n][0]:
+                    counts[n]['pass'] += 1
+                    continue
+                any_fail = True
+                counts[n]['fail'] += 1
+                kind = verdicts[n][1]
+                fail_kinds[n][kind] = fail_kinds[n].get(kind, 0) + 1
+                if r['status'] == 'TIMEOUT':
+                    timeouts[n] += 1
+                elif r['status'] != 'ok':
+                    crashes[n] += 1
+            if any_fail:
+                if corpus_dir and len(_corpus_files(corpus_dir)) < MAX_CORPUS:
+                    saved.append(_save_failure(corpus_dir, data, expected))
+                if len(shown) < 5:
+                    label = f"seed {seed}, profile {profile}; " + ", ".join(f"{n}={verdicts[n][1]}" for n in names)
+                    shown.append(_fmt_case(label, data, expected, results, names))
+
+    report = [f"== diff_test run: candidates={len(names)} cases={ran}/{num_cases} "
+              f"reference={'yes' if reference_path else 'no'} timeout={timeout}s rel_tol={rel_tol} "
+              f"seed_offset={seed_offset}",
+              "== pass/fail per candidate"]
+    for n in names:
+        report.append(f"{n}: pass={counts[n]['pass']} fail={counts[n]['fail']} "
+                      f"kinds={fail_kinds[n] or '{}'} timeouts={timeouts[n]} crashes={crashes[n]}")
+    report.append("== max runtime per profile (seconds)")
+    for p in PROFILES:
+        report.append(p + ": " + ", ".join(f"{n}={max_time[p][n]}" for n in names))
+    if gen_errors:
+        report.append("== generator/reference errors")
+        report.extend(gen_errors[:10])
+    if corpus_dir:
+        report.append(f"== saved {len(saved)} new failing inputs to {corpus_dir} "
+                      f"(corpus holds {len(_corpus_files(corpus_dir))}/{MAX_CORPUS})")
+    if shown:
+        report.append(f"== first {len(shown)} failing cases in full")
+        report.extend(shown)
+    else:
+        report.append("no failing cases in this run")
+    return {
+        'names': names,
+        'pass': {n: counts[n]['pass'] for n in names},
+        'fail': {n: counts[n]['fail'] for n in names},
+        'cases': ran,
+        'saved': saved,
+        'text': "\n".join(report),
+    }
+
+
+def replay_suite(solution_paths, reference_path=None, timeout=10, rel_tol=1e-6, corpus_dir=None):
+    """Re-runs every saved failing input in corpus_dir. Returns dict with per-candidate pass counts."""
+    names, paths = _candidate_names(solution_paths)
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    files = _corpus_files(corpus_dir)
+    passes = {n: 0 for n in names}
+    fails = {n: 0 for n in names}
+    shown = []
+    replayed = 0
+    start = time.time()
+    with tempfile.TemporaryDirectory() as cwd:
+        for fpath in files:
+            if time.time() - start > REPLAY_BUDGET_S:
+                break
+            replayed += 1
+            with open(fpath) as f:
+                data = f.read()
+            exp_path = fpath[:-4] + '.expected.txt'
+            saved_expected = None
+            if os.path.exists(exp_path):
+                with open(exp_path) as f:
+                    saved_expected = f.read()
+            expected, _, results, verdicts = _evaluate_input(
+                data, names, paths, reference_path, saved_expected, env, cwd, timeout, rel_tol)
+            for n in names:
+                if verdicts[n][0]:
+                    passes[n] += 1
+                else:
+                    fails[n] += 1
+            if not all(v[0] for v in verdicts.values()) and len(shown) < 5:
+                label = os.path.basename(fpath) + "; " + ", ".join(f"{n}={verdicts[n][1]}" for n in names)
+                shown.append(_fmt_case(label, data, expected, results, names))
+    report = [f"== diff_test replay: candidates={len(names)} saved_inputs={len(files)} "
+              f"replayed={replayed} reference={'yes' if reference_path else 'no'}"]
+    if replayed < len(files):
+        report.append(f"replay time budget ({REPLAY_BUDGET_S}s) reached; {len(files) - replayed} inputs skipped")
+    if not files:
+        report.append(f"corpus {corpus_dir} is empty; nothing to replay")
+    for n in names:
+        report.append(f"{n}: passed {passes[n]}/{replayed}")
+    report.extend(shown)
+    return {'names': names, 'total': replayed, 'pass': passes, 'fail': fails,
+            'text': "\n".join(report)}
+
+
+def tool_function(solution_paths, generator_path, reference_path=None, num_cases=200, timeout=10,
+                  rel_tol=1e-6, corpus_dir=None, mode='run', seed_offset=0):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        num_cases = max(1, min(int(num_cases or 200), 2000))
+    except (TypeError, ValueError):
+        num_cases = 200
+    try:
+        seed_offset = int(seed_offset or 0)
+    except (TypeError, ValueError):
+        seed_offset = 0
+    try:
+        rel_tol = float(rel_tol) if rel_tol is not None else 1e-6
+    except (TypeError, ValueError):
+        rel_tol = 1e-6
+    if isinstance(solution_paths, str):
+        solution_paths = [solution_paths]
+    if not solution_paths:
+        return "Error: solution_paths is empty"
+    for p in solution_paths:
+        if not os.path.isfile(p):
+            return f"Error: solution file not found: {p}"
+    mode = (mode or 'run').lower()
+    if mode not in ('run', 'replay'):
+        return f"Error: unknown mode {mode!r}; use 'run' or 'replay'"
+    if corpus_dir is None:
+        corpus_dir = os.path.join(tempfile.gettempdir(), 'diff_test_corpus')
+    solution_paths = [os.path.abspath(p) for p in solution_paths]
+    if reference_path:
+        if not os.path.isfile(reference_path):
+            return f"Error: reference file not found: {reference_path}"
+        reference_path = os.path.abspath(reference_path)
+
+    if mode == 'replay':
+        res = replay_suite(solution_paths, reference_path, timeout, rel_tol, corpus_dir)
+        return _clip(res['text'])
+
+    if not generator_path or not os.path.isfile(generator_path):
+        return f"Error: generator file not found: {generator_path}"
+    res = run_suite(solution_paths, os.path.abspath(generator_path), reference_path, num_cases,
+                    timeout, rel_tol, corpus_dir, seed_offset)
+    return _clip(res['text'])
