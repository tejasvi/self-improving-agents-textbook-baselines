diff --git a/tools/precision_check.py b/tools/precision_check.py
new file mode 100644
index 0000000..b9d0bb3
--- /dev/null
+++ b/tools/precision_check.py
@@ -0,0 +1,169 @@
+import subprocess
+import sys
+import os
+import decimal
+from decimal import Decimal, getcontext
+
+def tool_info():
+    return {
+        "name": "precision_check",
+        "description": """Check the numerical accuracy of a floating-point output solution against a high-precision reference.
+* `generator_path` is a Python script that takes one integer argument (the seed) and prints one test input to stdout. It is run for seeds 0..num_tests-1.
+* `solution_path` and `reference_path` are Python programs that read stdin and write stdout. `reference_path` should compute the exact answer with fractions.Fraction or decimal at 50+ digits and print it with many digits (17+).
+* For each seed, the generator, solution and reference are run in isolated subprocesses (`python3 -I`, scrubbed environment).
+* The first float token of each output is parsed with decimal.Decimal. Returns raw data only (it does NOT judge pass/fail): per-test absolute error, relative error, number of matching leading significant digits, and whether the solution's printed text equals the reference value correctly rounded to the same number of decimals as the solution printed.
+* Lists the 5 worst cases (by relative error) with input and both outputs, and a summary line such as 'K of M tests are not correctly rounded; max relative error = X'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test (prints a real number)."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the high-precision reference Python program (Fraction/Decimal, 50+ digits) that prints the exact answer with many digits."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python script that takes a seed integer as its argument and prints one input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test (seeds 0..num_tests-1). Default 100."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                },
+                "sig_digits": {
+                    "type": "integer",
+                    "description": "Number of significant digits used for the 'matching leading significant digits' count. Default 15."
+                }
+            },
+            "required": ["solution_path", "reference_path", "generator_path"]
+        }
+    }
+
+
+def _run_py(path, data, timeout, args=()):
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", path, *args],
+            input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return out, err, None, True
+
+
+def _first_float(text):
+    """Parse the first numeric token of text as Decimal. Returns (Decimal or None, number of decimals in token)."""
+    for tok in text.split():
+        try:
+            d = Decimal(tok)
+        except decimal.InvalidOperation:
+            continue
+        if not d.is_finite():
+            continue
+        exp = d.as_tuple().exponent
+        ndec = -exp if exp < 0 else 0
+        return d, ndec
+    return None, 0
+
+
+def _leading_matching_digits(a, b, sig):
+    """Number of leading significant digits (out of sig) that match between Decimals a and b."""
+    if a == b:
+        return sig
+    if a == 0 or b == 0:
+        return 0
+    fa = format(a, f".{sig - 1}e")
+    fb = format(b, f".{sig - 1}e")
+    ma = fa.split("e")[0].replace("-", "").replace(".", "")
+    mb = fb.split("e")[0].replace("-", "").replace(".", "")
+    if fa.split("e")[0].startswith("-") != fb.split("e")[0].startswith("-"):
+        return 0
+    n = 0
+    for x, y in zip(ma, mb):
+        if x != y:
+            break
+        n += 1
+    return n
+
+
+def _correctly_rounded_text(ref, ndec):
+    q = Decimal(1).scaleb(-ndec)
+    return ref.quantize(q, rounding=decimal.ROUND_HALF_EVEN)
+
+
+def tool_function(solution_path, reference_path, generator_path, num_tests=100, timeout=10, sig_digits=15):
+    num_tests = int(num_tests)
+    timeout = int(timeout)
+    getcontext().prec = 120
+    rows = []
+    not_rounded = 0
+    compared = 0
+    for i in range(num_tests):
+        gen_out, gen_err, gen_rc, gen_to = _run_py(generator_path, "", timeout, args=(str(i),))
+        if gen_to or gen_rc != 0:
+            return f"Generator failed for seed {i}: timeout={gen_to}, exit code={gen_rc}\nstderr:\n{gen_err}"
+        inp = gen_out
+        r_out, r_err, r_rc, r_to = _run_py(reference_path, inp, timeout)
+        s_out, s_err, s_rc, s_to = _run_py(solution_path, inp, timeout)
+        if r_to or r_rc != 0:
+            return f"Reference failed at seed {i}: timeout={r_to}, exit code={r_rc}\nINPUT:\n{inp}\nstderr:\n{r_err}"
+        ref, _ = _first_float(r_out)
+        if ref is None:
+            return f"Could not parse a number from reference output at seed {i}:\n{r_out}"
+        sol, ndec = _first_float(s_out) if (not s_to and s_rc == 0) else (None, 0)
+        row = {
+            "seed": i, "input": inp, "ref_out": r_out.strip(), "sol_out": s_out.strip(),
+            "sol_err": s_err, "sol_rc": s_rc, "sol_timeout": s_to,
+        }
+        if sol is None:
+            row["abs"] = None
+            row["rel"] = None
+            row["digits"] = 0
+            row["rounded_ok"] = False
+            not_rounded += 1
+            compared += 1
+            rows.append(row)
+            continue
+        absdiff = abs(sol - ref)
+        rel = (absdiff / abs(ref)) if ref != 0 else (Decimal(0) if absdiff == 0 else Decimal("Infinity"))
+        digits = _leading_matching_digits(sol, ref, int(sig_digits))
+        expected_text = _correctly_rounded_text(ref, ndec)
+        rounded_ok = (sol == expected_text)
+        row.update({
+            "abs": float(absdiff), "rel": float(rel), "digits": digits,
+            "rounded_ok": rounded_ok, "ndec": ndec, "ref_rounded": str(expected_text),
+        })
+        compared += 1
+        if not rounded_ok:
+            not_rounded += 1
+        rows.append(row)
+
+    if compared == 0:
+        return "No tests were run."
+    max_rel = max((r["rel"] for r in rows if r["rel"] is not None), default=None)
+    worst = sorted(rows, key=lambda r: (r["rel"] is None, -(r["rel"] or 0)))[:5]
+    lines = []
+    lines.append(f"SUMMARY: {not_rounded} of {compared} tests are not correctly rounded; max relative error = {max_rel}")
+    lines.append(f"Matching significant digits (min over tests): {min((r['digits'] for r in rows), default=0)}")
+    lines.append("")
+    lines.append("WORST 5 CASES (by relative error):")
+    for r in worst:
+        lines.append(f"--- seed {r['seed']}: abs err={r['abs']}, rel err={r['rel']}, matching sig digits={r['digits']}, "
+                     f"solution printed {r.get('ndec', '?')} decimals, correctly rounded match={r['rounded_ok']}")
+        lines.append(f"INPUT:\n{r['input']}")
+        lines.append(f"SOLUTION output: {r['sol_out']}")
+        lines.append(f"REFERENCE output: {r['ref_out']}")
+        if 'ref_rounded' in r:
+            lines.append(f"REFERENCE correctly rounded to solution's decimals: {r['ref_rounded']}")
+        if r['sol_rc'] != 0 or r['sol_timeout']:
+            lines.append(f"SOLUTION exit code={r['sol_rc']}, timed out={r['sol_timeout']}, stderr:\n{r['sol_err']}")
+    return "\n".join(lines)
