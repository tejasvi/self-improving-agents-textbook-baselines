+def _append(path, text):
+    with open(path, 'a') as f:
+        f.write(text)
+
+
+def _reply_text(msg_history):
+    """Text of the last assistant message, or '' if the last message is not an assistant reply."""
+    if not msg_history or msg_history[-1].get('role') != 'assistant':
+        return ''
+    content = msg_history[-1].get('content')
+    if isinstance(content, str):
+        return content.strip()
+    parts = []
+    for block in content or []:
+        if isinstance(block, dict) and block.get('type') == 'text':
+            parts.append(block.get('text') or '')
+        elif isinstance(block, str):
+            parts.append(block)
+    return '\n'.join(parts).strip()
+
+
+def _nonempty_file(path):
+    return os.path.isfile(path) and os.path.getsize(path) > 0
+
+
+def _compiles(path):
+    """Smoke check: the file must at least byte-compile. Returns an error string or None."""
+    try:
+        p = subprocess.run([sys.executable, '-I', '-c',
+                            'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")', path],
+                           capture_output=True, text=True, timeout=30)
+    except subprocess.TimeoutExpired:
+        return f"{os.path.basename(path)} did not compile in time"
+    if p.returncode != 0:
+        return f"{os.path.basename(path)} has a syntax error: {p.stderr.strip()[-400:]}"
+    return None
+
+
+def _smoke_all(*names):
+    """Build a smoke check that byte-compiles each named file in helper_dir."""
+    def check(helper_dir):
+        for n in names:
+            err = _compiles(os.path.join(helper_dir, n))
+            if err:
+                return err
+        return None
+    return check
+
+
+def _smoke_modes(helper_dir):
+    path = os.path.join(helper_dir, 'modes.txt')
+    with open(path) as f:
+        n = len([line for line in f if line.strip()])
+    return None if n > 0 else "modes.txt has no mode names"
