diff --git a/tools/precision_check.py b/tools/precision_check.py
new file mode 100644
index 0000000..a08b735
--- /dev/null
+++ b/tools/precision_check.py
@@ -0,0 +1,160 @@
+import subprocess
+import sys
+import os
+from decimal import Decimal, getcontext, InvalidOperation
+
+REL_TOL = Decimal("1e-12")
+
+
+def tool_info():
+    return {
+        "name": "precision_check",
+        "description": """Compare a floating-point solution against a high-precision reference program on explicit inputs or on seeded generated inputs.
+* `reference_path` should compute the answer in exact or high-precision arithmetic (fractions.Fraction or decimal with ~50 digits).
+* If `generator_path` is given, it is run with seeds 0..num_tests-1 (one integer argument, prints one input to stdout). Otherwise the explicit `inputs` list is used.
+* Both programs are run with `python3 -I`. Every whitespace-separated token of both outputs is parsed as a Decimal and compared.
+* Returns raw data per input: both raw outputs, max absolute error, max relative error, and the position of the first differing character. The first input whose relative error exceeds 1e-12 is highlighted with its raw outputs.
+* Raw stderr and exit codes are returned as-is.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file under test."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the high-precision reference Python file (exact arithmetic)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Optional path to a generator script taking a seed integer argument and printing one input to stdout."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of explicit stdin texts to test (used when generator_path is not given)."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test when generator_path is given (seeds 0..num_tests-1). Default 50."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 10."
+                }
+            },
+            "required": ["solution_path", "reference_path"]
+        }
+    }
+
+
+def _run_py(path, data, timeout, args=()):
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", path, *args],
+            input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return out, err, None, True
+
+
+def _first_diff_pos(a, b):
+    n = min(len(a), len(b))
+    for i in range(n):
+        if a[i] != b[i]:
+            return i
+    return n if len(a) != len(b) else -1
+
+
+def _compare(sol_out, ref_out):
+    """Compare token lists numerically; returns (max_abs, max_rel, note)."""
+    getcontext().prec = 120
+    st = sol_out.split()
+    rt = ref_out.split()
+    if len(st) != len(rt):
+        return None, None, f"token count differs: solution={len(st)} reference={len(rt)}"
+    max_abs = Decimal(0)
+    max_rel = Decimal(0)
+    for x, y in zip(st, rt):
+        try:
+            dx = Decimal(x)
+            dy = Decimal(y)
+        except (InvalidOperation, ValueError):
+            if x != y:
+                return None, None, f"non-numeric token differs: {x!r} vs {y!r}"
+            continue
+        diff = abs(dx - dy)
+        if diff > max_abs:
+            max_abs = diff
+        if dy != 0:
+            rel = diff / abs(dy)
+        else:
+            rel = diff
+        if rel > max_rel:
+            max_rel = rel
+    return max_abs, max_rel, None
+
+
+def tool_function(solution_path, reference_path, generator_path=None, inputs=None, num_tests=50, timeout=10):
+    timeout = int(timeout)
+    if generator_path:
+        cases = []
+        for i in range(int(num_tests)):
+            gen_out, gen_err, gen_rc, gen_to = _run_py(generator_path, "", timeout, args=(str(i),))
+            if gen_to or gen_rc != 0:
+                return f"Generator failed for seed {i}: timeout={gen_to}, exit code={gen_rc}\nstderr:\n{gen_err}"
+            cases.append((f"seed {i}", gen_out))
+    else:
+        cases = [(f"input {i}", s) for i, s in enumerate(inputs or [])]
+    if not cases:
+        return "No inputs to test (provide generator_path or inputs)."
+
+    lines = []
+    worst_rel = Decimal(0)
+    worst_abs = Decimal(0)
+    first_bad = None
+    for label, inp in cases:
+        ref_out, ref_err, ref_rc, ref_to = _run_py(reference_path, inp, timeout)
+        sol_out, sol_err, sol_rc, sol_to = _run_py(solution_path, inp, timeout)
+        if ref_to or ref_rc != 0 or sol_to or sol_rc != 0:
+            first_bad = first_bad or (label, inp)
+            lines.append(
+                f"[{label}] RUN FAILURE: reference timeout={ref_to} rc={ref_rc}; solution timeout={sol_to} rc={sol_rc}\n"
+                f"INPUT:\n{inp}\nREF stdout:\n{ref_out}\nREF stderr:\n{ref_err}\n"
+                f"SOL stdout:\n{sol_out}\nSOL stderr:\n{sol_err}"
+            )
+            continue
+        max_abs, max_rel, note = _compare(sol_out, ref_out)
+        if note is not None:
+            lines.append(
+                f"[{label}] {note}; first differing char index={_first_diff_pos(sol_out, ref_out)}\n"
+                f"INPUT:\n{inp}\nREFERENCE output:\n{ref_out}\nSOLUTION output:\n{sol_out}"
+            )
+            first_bad = first_bad or (label, inp)
+            continue
+        if max_abs > worst_abs:
+            worst_abs = max_abs
+        if max_rel > worst_rel:
+            worst_rel = max_rel
+        diff_pos = _first_diff_pos(sol_out.strip(), ref_out.strip())
+        status = "ok" if max_rel <= REL_TOL else "REL>1e-12"
+        lines.append(
+            f"[{label}] max_abs_err={max_abs:.3E} max_rel_err={max_rel:.3E} {status} first_diff_char_index={diff_pos}"
+        )
+        if max_rel > REL_TOL and first_bad is None:
+            first_bad = (label, inp)
+            lines.append(
+                f"  >>> first input exceeding rel 1e-12 ({label}):\n"
+                f"INPUT:\n{inp}\nREFERENCE output:\n{ref_out}\nSOLUTION output:\n{sol_out}"
+            )
+
+    summary = (
+        f"Tested {len(cases)} inputs. Worst max_abs_err={worst_abs:.3E}, worst max_rel_err={worst_rel:.3E}.\n"
+        + ("All inputs within rel 1e-12." if first_bad is None else "Some inputs failed; see details below.")
+    )
+    return summary + "\n" + "\n".join(lines)
