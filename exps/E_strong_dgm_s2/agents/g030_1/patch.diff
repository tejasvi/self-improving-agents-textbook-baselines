diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..3050e78
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,125 @@
+import os
+import re
+import subprocess
+import tempfile
+
+TIMEOUT_DEFAULT = 10
+MAX_SHOW = 1500
+
+_IN_HDR = re.compile(r'Sample\s+Input\s*(\d+)\s*:?[ \t]*\r?\n')
+_OUT_HDR = re.compile(r'Sample\s+Output\s*(\d+)\s*:?[ \t]*\r?\n')
+_ANY_HDR = re.compile(r'Sample\s+(?:Input|Output)\s*\d+\s*:?[ \t]*\r?\n')
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Parse the sample tests ('Sample Input k' / 'Sample Output k' blocks) from the problem statement, run a solution file on each sample input via stdin, and compare its output with the expected sample output.\n
+* For each sample it reports EXACT MATCH (whitespace-normalized tokens equal) or MISMATCH, with the expected and the actual output shown raw.
+* Ends with a summary line 'X/Y samples match exactly'.
+* A MISMATCH is a failure even if the statement says any valid answer is accepted: the hidden grader may compare against the reference output exactly.
+* Pass the full problem statement text as problem_statement.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_statement": {"type": "string", "description": "The full problem statement text, including the 'Sample Input k' and 'Sample Output k' blocks."},
+                "solution_path": {"type": "string", "description": "Path to the solution program (a Python file run as `python3 <file>`, reading stdin and writing stdout)."},
+                "timeout": {"type": "integer", "description": "Time limit in seconds for each sample run. Default 10."}
+            },
+            "required": ["problem_statement", "solution_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_SHOW):
+    s = s.rstrip()
+    if len(s) <= n:
+        return s
+    return s[:n] + f"\n... <{len(s) - n} characters clipped>"
+
+
+def _strip_fences(block):
+    """Drops markdown code-fence lines (``` or ```text) that may wrap a sample block."""
+    lines = [ln for ln in block.split('\n') if not ln.strip().startswith('```')]
+    return '\n'.join(lines)
+
+
+def _extract_samples(text):
+    """Returns (inputs, outputs) as dicts {k: text}. A block runs from its header to the next
+    'Sample Input/Output' header or to the end of the text."""
+    headers = list(_ANY_HDR.finditer(text))
+    inputs, outputs = {}, {}
+    for i, m in enumerate(headers):
+        end = headers[i + 1].start() if i + 1 < len(headers) else len(text)
+        block = _strip_fences(text[m.end():end]).strip('\n')
+        k = int(re.match(r'Sample\s+(?:Input|Output)\s*(\d+)', m.group(0)).group(1))
+        kind = 'in' if re.match(r'Sample\s+Input', m.group(0)) else 'out'
+        if kind == 'in':
+            inputs.setdefault(k, block)
+        else:
+            outputs.setdefault(k, block)
+    return inputs, outputs
+
+
+def _run_solution(solution_path, stdin_text, timeout):
+    """Runs the solution on stdin_text. Returns (stdout, note) where note is '' on success,
+    else the raw failure reason with stderr."""
+    with tempfile.TemporaryDirectory() as tmp:
+        in_path = os.path.join(tmp, 'sample_input.txt')
+        with open(in_path, 'w') as f:
+            f.write(stdin_text if stdin_text.endswith('\n') else stdin_text + '\n')
+        try:
+            with open(in_path) as fin:
+                p = subprocess.run(['python3', solution_path], stdin=fin,
+                                   capture_output=True, text=True, timeout=timeout,
+                                   errors='replace', cwd=tmp)
+        except subprocess.TimeoutExpired:
+            return '', f"timed out after {timeout} seconds"
+    if p.returncode != 0:
+        return p.stdout, f"exit code {p.returncode}\nSTDERR:\n{_clip(p.stderr)}"
+    return p.stdout, ''
+
+
+def tool_function(problem_statement, solution_path, timeout=TIMEOUT_DEFAULT):
+    try:
+        timeout = max(1, min(int(timeout or TIMEOUT_DEFAULT), 120))
+    except (TypeError, ValueError):
+        return "Error: timeout must be an integer."
+    if not isinstance(problem_statement, str) or not problem_statement.strip():
+        return "Error: problem_statement is empty."
+    if not os.path.isfile(solution_path):
+        return f"Error: solution_path does not exist: {solution_path}"
+    solution_path = os.path.abspath(solution_path)
+
+    inputs, outputs = _extract_samples(problem_statement.replace('\r\n', '\n'))
+    keys = sorted(set(inputs) & set(outputs))
+    if not keys:
+        return ("No samples found: could not parse 'Sample Input k' / 'Sample Output k' blocks from the "
+                "problem statement. Extract the sample inputs and expected outputs manually from the "
+                "statement and run the solution on them yourself (e.g. `python3 solution.py < sample1.txt`).")
+
+    lines = []
+    matched = 0
+    any_mismatch = False
+    for k in keys:
+        exp = outputs[k]
+        act, note = _run_solution(solution_path, inputs[k], timeout)
+        if not note and act.split() == exp.split():
+            matched += 1
+            lines.append(f"Sample {k}: EXACT MATCH")
+        else:
+            any_mismatch = True
+            lines.append(f"Sample {k}: MISMATCH")
+            lines.append(f"  input:\n{_clip(inputs[k])}")
+            lines.append(f"  expected output:\n{_clip(exp)}")
+            lines.append(f"  actual output:\n{_clip(act) if act.strip() else '(empty)'}")
+            if note:
+                lines.append(f"  run failure: {note}")
+    lines.append(f"{matched}/{len(keys)} samples match exactly")
+    if any_mismatch:
+        lines.append(
+            "REMINDER: a sample mismatch is a failure. Even if the statement says any valid answer is accepted, "
+            "the hidden grader may compare your output against the reference output exactly. Try deterministic "
+            "constructions (different elimination/iteration order, bit assignment order, scaling, largest or "
+            "smallest valid values) until every sample matches exactly.")
+    return '\n'.join(lines)
