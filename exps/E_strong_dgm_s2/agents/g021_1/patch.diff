+def tool_function(solution_path, reference_path, generator_path, num_tests=200, timeout=10, rel_tol=1e-11,
+                  mode=None, modes=None):
+    try:
+        num_tests = max(1, min(int(num_tests or 200), 2000))
+    except (TypeError, ValueError):
+        num_tests = 200
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        rel_tol = float(rel_tol) if rel_tol is not None else 1e-11
+    except (TypeError, ValueError):
+        rel_tol = 1e-11
+    for p in (solution_path, reference_path, generator_path):
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+    if isinstance(modes, str):
+        modes = [modes]
+    if modes:
+        mode_list = [str(m) for m in modes][:10]
+    else:
+        mode_list = [str(mode)] if mode else [None]
+
+    out = []
+    for m in mode_list:
+        out += _run_mode(solution_path, reference_path, generator_path, num_tests, timeout, rel_tol, m)
+    return "\n".join(out)
