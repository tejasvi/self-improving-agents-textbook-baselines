+    @staticmethod
+    def _message_text(msg):
+        """Return the concatenated text of a message history entry (dict or object)."""
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            return content
+        if not isinstance(content, list):
+            content = []
+        parts = []
+        for block in content:
+            text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if isinstance(text, str):
+                parts.append(text)
+        return "\n".join(parts)
+
+    def _last_assistant_text(self, msg_history):
+        """Return the text of the last assistant message, or '' if none."""
+        for msg in reversed(msg_history or []):
+            role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+            if role == 'assistant':
+                return self._message_text(msg)
+        return ''
+
+    def _extract_code_block(self, msg_history):
+        """Return the first ```python ... ``` block in the last assistant message, or None."""
+        text = self._last_assistant_text(msg_history)
+        match = re.search(r'```python[ \t]*\n(.*?)```', text, re.DOTALL)
+        if not match:
+            return None
+        code = match.group(1)
+        return code if code.strip() else None
+
