@@ -0,0 +1,148 @@
+import ast
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+_FALLBACK_STDLIB = {
+    'abc', 'argparse', 'array', 'ast', 'bisect', 'collections', 'copy', 'csv', 'dataclasses',
+    'datetime', 'decimal', 'fractions', 'functools', 'heapq', 'io', 'itertools', 'json', 'math',
+    'operator', 'os', 're', 'random', 'signal', 'string', 'struct', 'sys', 'time', 'typing',
+    'threading', 'queue', 'types', 'unittest', 'warnings', 'gc', 'statistics', 'enum', 'numbers',
+    'types', 'hashlib', 'base64', 'pprint', 'textwrap', 'traceback', 'codecs', 'locale',
+    'resource', 'select', 'socket', 'tempfile', 'shutil', 'subprocess', 'glob', 'pathlib',
+    'difflib', 'contextlib', 'inspect', 'builtins', 'weakref', 'timeit', 'cmath', 'secrets',
+}
+
+_CANDIDATES = ['python3', 'python', 'pypy3', 'python3.8', 'python3.9', 'python3.10',
+               'python3.11', 'python3.12', 'python3.13']
+
+_STDLIB = getattr(sys, 'stdlib_module_names', None) or _FALLBACK_STDLIB
+_SHOW = 300
+
+
+def tool_info():
+    return {
+        "name": "grader_sim",
+        "description": """Simulate the grader: run a solution file under every available Python interpreter, in isolated mode (`-I`), with a minimal environment, from a different directory and under a different filename, on each given input file (fed via stdin).\n
+* Reports, for each (interpreter, input) pair: interpreter version, exit code, first 300 chars of stdout, full stderr (including tracebacks), and elapsed time.
+* Lists the solution's imported top-level modules and flags any that are not in the standard library.
+* Output is raw; read it yourself to decide whether something is wrong. Treat crashes, non-stdlib imports, and disagreement between interpreters as failures.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {"type": "string", "description": "Path to the solution Python file to simulate."},
+                "input_paths": {"type": "array", "items": {"type": "string"}, "description": "Paths to input files; each is fed to the solution via stdin, one run per file."},
+                "timeout": {"type": "integer", "description": "Time limit in seconds for each run. Default 10."}
+            },
+            "required": ["solution_path", "input_paths"]
+        }
+    }
+
+
+def _interpreters():
+    """Find interpreters, deduplicated by resolved path and version string."""
+    found = []
+    seen_paths = set()
+    seen_versions = set()
+    for name in _CANDIDATES:
+        path = shutil.which(name)
+        if not path:
+            continue
+        real = os.path.realpath(path)
+        if real in seen_paths:
+            continue
+        seen_paths.add(real)
+        try:
+            p = subprocess.run([path, '-c', 'import sys; print(sys.version.split()[0], sys.implementation.name)'],
+                               capture_output=True, text=True, timeout=20,
+                               env={'PATH': '/usr/bin:/bin'})
+            version = (p.stdout or p.stderr).strip() or f"(no version output, rc={p.returncode})"
+        except Exception as e:
+            version = f"(version probe failed: {e})"
+        if version in seen_versions:
+            continue
+        seen_versions.add(version)
+        found.append((path, version))
+    return found
+
+
+def _imports(source):
+    """Top-level module names imported by the source, sorted."""
+    try:
+        tree = ast.parse(source)
+    except SyntaxError as e:
+        return None, f"SyntaxError while parsing for imports: {e}"
+    mods = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for a in node.names:
+                mods.add(a.name.split('.')[0])
+        elif isinstance(node, ast.ImportFrom):
+            if node.level == 0 and node.module:
+                mods.add(node.module.split('.')[0])
+    return sorted(mods), None
+
+
+def tool_function(solution_path, input_paths, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except Exception:
+        timeout = 10
+    if isinstance(input_paths, str):
+        input_paths = [input_paths]
+
+    try:
+        with open(solution_path, 'r', errors='replace') as f:
+            source = f.read()
+    except Exception as e:
+        return f"Error: cannot read solution file {solution_path}: {e}"
+
+    tmpdir = tempfile.mkdtemp()
+    tmp_sol = os.path.join(tmpdir, '_sol.py')
+    with open(tmp_sol, 'w') as f:
+        f.write(source)
+
+    out = []
+    mods, err = _imports(source)
+    if err:
+        out.append(err)
+    else:
+        nonstd = [m for m in mods if m not in _STDLIB]
+        out.append(f"Imported top-level modules: {', '.join(mods) if mods else '(none)'}")
+        out.append(f"Non-stdlib imports: {', '.join(nonstd) if nonstd else '(none)'}")
+
+    interps = _interpreters()
+    out.append("Interpreters: " + (", ".join(f"{p} [{v}]" for p, v in interps) if interps else "(none found)"))
+
+    for inp in input_paths:
+        try:
+            with open(inp, 'rb') as f:
+                data = f.read()
+        except Exception as e:
+            out.append(f"\n== input {inp}: cannot read: {e}")
+            continue
+        for path, version in interps:
+            header = f"\n== interpreter {path} [{version}] | input {inp}"
+            t0 = time.time()
+            try:
+                with open(inp, 'rb') as stdin_f:
+                    p = subprocess.run([path, '-I', tmp_sol], stdin=stdin_f, capture_output=True,
+                                       env={'PATH': '/usr/bin:/bin'}, cwd=tmpdir, timeout=timeout)
+                elapsed = time.time() - t0
+                stdout = p.stdout.decode('utf-8', errors='replace')
+                stderr = p.stderr.decode('utf-8', errors='replace')
+                out.append(f"{header}\nreturn code: {p.returncode}\nelapsed: {elapsed:.3f}s\n"
+                           f"stdout (first {_SHOW} chars):\n{stdout[:_SHOW]}\n"
+                           f"stderr:\n{stderr if stderr.strip() else '(empty)'}")
+            except subprocess.TimeoutExpired as e:
+                elapsed = time.time() - t0
+                stdout = (e.stdout or b'').decode('utf-8', errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+                out.append(f"{header}\nTIMEOUT after {timeout}s (elapsed {elapsed:.3f}s)\n"
+                           f"stdout (first {_SHOW} chars):\n{stdout[:_SHOW]}")
+            except Exception as e:
+                out.append(f"{header}\nfailed to launch: {e}")
+
+    return "\n".join(out)
