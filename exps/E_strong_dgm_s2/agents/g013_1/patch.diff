+import os
+import subprocess
+import sys
+import time
+
+MAX_CLIP = 4000
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Benchmark a Python solution on one input and report raw results.\n
+* Runs the solution with `python3 -I` (isolated mode) and a scrubbed environment (only PATH is kept).
+* Provide the stdin either as `input_text` (inline text) or as `generator_path`: a Python script that is run as `python3 -I <generator_path> <seed>` and whose stdout becomes the input (use `seed` to vary the generated input).
+* Returns raw stdout (clipped), raw stderr, elapsed wall-clock seconds, the exit code and whether the run timed out. No interpretation is performed; read the numbers yourself.
+* `time_limit` is only echoed back for reference against the elapsed time; it does not kill the process. `timeout` kills the process.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to benchmark."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "Inline stdin text for the solution. Ignored if generator_path is given."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator script; it is run with one argument (the seed) and its stdout is used as stdin."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Seed passed to the generator script (default 0)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Kill the solution after this many seconds (default 10, max 120)."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Reference time limit in seconds, echoed back in the report (optional)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clip(s, n=MAX_CLIP):
+    if s is None:
+        return ''
+    if len(s) <= n:
+        return s
+    return s[:n // 2] + f"\n...[clipped {len(s) - n} chars]...\n" + s[-n // 2:]
+
+
+def _text(x):
+    if x is None:
+        return ''
+    if isinstance(x, bytes):
+        return x.decode('utf-8', errors='replace')
+    return x
+
+
+def tool_function(solution_path, input_text=None, generator_path=None, seed=0, timeout=10, time_limit=None):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        seed = int(seed or 0)
+    except (TypeError, ValueError):
+        seed = 0
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    env = {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+    report = []
+
+    if generator_path:
+        if not os.path.isfile(generator_path):
+            return f"Error: generator file not found: {generator_path}"
+        try:
+            g = subprocess.run([sys.executable, '-I', generator_path, str(seed)],
+                               capture_output=True, text=True, env=env, timeout=60,
+                               errors='replace')
+        except subprocess.TimeoutExpired:
+            return "Error: generator timed out after 60 seconds"
+        if g.returncode != 0:
+            return f"Generator failed (exit code {g.returncode}).\nstderr:\n{_clip(g.stderr)}"
+        data = g.stdout
+        report.append(f"generator: {generator_path} seed={seed}")
+        report.append(f"input size: {len(data)} chars")
+    else:
+        data = input_text if input_text is not None else ''
+        report.append(f"input size: {len(data)} chars (inline)")
+
+    start = time.time()
+    timed_out = False
+    try:
+        p = subprocess.run([sys.executable, '-I', solution_path], input=data,
+                           capture_output=True, text=True, env=env, timeout=timeout,
+                           errors='replace')
+        stdout, stderr, code = p.stdout, p.stderr, p.returncode
+    except subprocess.TimeoutExpired as e:
+        timed_out = True
+        stdout, stderr, code = _text(e.stdout), _text(e.stderr), 'TIMEOUT'
+    elapsed = round(time.time() - start, 3)
+
+    report.append(f"exit code: {code}")
+    report.append(f"elapsed: {elapsed}s")
+    report.append(f"timed out: {timed_out}")
+    if time_limit is not None:
+        report.append(f"reference time limit: {time_limit}s")
+    report.append("stdout:")
+    report.append(_clip(stdout) if stdout else '(empty)')
+    report.append("stderr:")
+    report.append(_clip(stderr) if stderr else '(empty)')
+    return "\n".join(report)
