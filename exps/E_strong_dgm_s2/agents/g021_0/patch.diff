index 0000000..82fb5d0
--- /dev/null
+++ b/tools/float_formula_search.py
@@ -0,0 +1,175 @@
+import json
+import os
+import subprocess
+import sys
+
+_RUNNER = r'''
+import sys, json, importlib.util, math
+from fractions import Fraction
+from decimal import Decimal
+
+def fmt(v, d):
+    # exact formatting for Fraction/Decimal, '%.nf' for floats/ints
+    if isinstance(v, bool):
+        raise TypeError("bool result")
+    if isinstance(v, Fraction):
+        neg = v < 0
+        a = abs(v)
+        scaled = (a.numerator * 10 ** d * 2 + a.denominator) // (2 * a.denominator)
+        ip, fp = divmod(scaled, 10 ** d)
+        s = f"{ip}." + (f"{fp:0{d}d}" if d > 0 else "")
+        if d == 0:
+            s = f"{ip}"
+        return ("-" if neg and scaled != 0 else "") + s
+    if isinstance(v, Decimal):
+        return format(v, "." + str(d) + "f")
+    return ("%." + str(d) + "f") % float(v)
+
+def exact(v):
+    if isinstance(v, Fraction):
+        return v
+    if isinstance(v, Decimal):
+        return Fraction(v)
+    if isinstance(v, int):
+        return Fraction(v)
+    return Fraction(float(v))
+
+req = json.loads(sys.stdin.read())
+d = int(req["decimals"])
+spec = importlib.util.spec_from_file_location("cand_module", req["path"])
+mod = importlib.util.module_from_spec(spec)
+try:
+    spec.loader.exec_module(mod)
+except Exception as e:
+    print(json.dumps({"load_error": type(e).__name__ + ": " + str(e)}))
+    sys.exit(0)
+names = sorted(n for n in dir(mod) if n.startswith("cand_") and callable(getattr(mod, n)))
+out = {"names": names, "results": {}, "extra": {}}
+def run_one(fn, text):
+    try:
+        v = fn(text)
+        return {"ok": True, "text": fmt(v, d), "val": str(exact(v))}
+    except Exception as e:
+        return {"ok": False, "text": "ERROR " + type(e).__name__ + ": " + str(e)[:200]}
+for n in names:
+    fn = getattr(mod, n)
+    out["results"][n] = [run_one(fn, t) for t in req["inputs"]]
+for t in req.get("extra_inputs", []):
+    out["extra"][t] = {n: run_one(getattr(mod, n), t) for n in names}
+print(json.dumps(out))
+'''
+
+
+def tool_info():
+    return {
+        "name": "float_formula_search",
+        "description": """Compare several candidate formulas for a real-valued output against the expected sample texts, to find which floating-point evaluation order reproduces the reference output digits.
+* `candidates_path`: path to a Python file defining functions whose names start with `cand_`. Each takes the input text (a single string, the whole stdin) and returns a float, int or fractions.Fraction. Example: `def cand_horner(s): ...`. Write each candidate as a different evaluation order (e.g. DP order, Horner form, explicit powers, exact Fraction rounded).
+* `inputs` / `expected_outputs`: parallel arrays of sample input texts and their exact expected output texts.
+* `decimals`: number of decimals to print with '%.{decimals}f' (Fraction values are formatted exactly). Default 15.
+* `extra_inputs`: optional extra input texts; for each, every candidate's printed value and the spread (max-min) across candidates are shown, and inputs on which candidates disagree are marked DISCRIMINATING.
+* Candidates run in an isolated `python3 -I` subprocess. Output is raw data only: per-candidate counts of exact matches, per-input outputs, and the discriminating flags. No judgement is given.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidates_path": {
+                    "type": "string",
+                    "description": "Path to a Python file defining functions named cand_* that take the input text and return a float or Fraction."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Sample input texts."
+                },
+                "expected_outputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Expected output texts, parallel to inputs."
+                },
+                "decimals": {
+                    "type": "integer",
+                    "description": "Number of decimals to print. Default 15."
+                },
+                "extra_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional extra input texts to compare candidate values on (no expected output)."
+                }
+            },
+            "required": ["candidates_path", "inputs", "expected_outputs"]
+        }
+    }
+
+
+def tool_function(candidates_path, inputs, expected_outputs, decimals=15, extra_inputs=None):
+    decimals = int(decimals if decimals is not None else 15)
+    extra_inputs = list(extra_inputs or [])
+    inputs = list(inputs or [])
+    expected_outputs = list(expected_outputs or [])
+    if len(inputs) != len(expected_outputs):
+        return "Error: inputs and expected_outputs must have the same length."
+    if not os.path.isfile(candidates_path):
+        return f"Error: candidates file not found: {candidates_path}"
+    req = {"path": os.path.abspath(candidates_path), "decimals": decimals,
+           "inputs": inputs, "extra_inputs": extra_inputs}
+    try:
+        p = subprocess.run([sys.executable, "-I", "-c", _RUNNER], input=json.dumps(req),
+                           capture_output=True, text=True, timeout=120,
+                           env={"PATH": os.environ.get("PATH", "")})
+    except subprocess.TimeoutExpired:
+        return "TIMEOUT after 120s"
+    if p.returncode != 0:
+        return f"Runner crashed (exit {p.returncode}):\n{p.stderr[-4000:]}"
+    try:
+        data = json.loads(p.stdout.strip().splitlines()[-1])
+    except Exception:
+        return f"Could not parse runner output:\n{p.stdout[-2000:]}\n{p.stderr[-2000:]}"
+    if "load_error" in data:
+        return "Candidates file failed to load: " + data["load_error"]
+    names = data["names"]
+    if not names:
+        return "No cand_* functions found in the candidates file."
+    lines = []
+    lines.append(f"Candidates ({len(names)}): " + ", ".join(names))
+    lines.append(f"Decimals: {decimals}")
+    lines.append("")
+    lines.append("== Sample matches (exact text equality) ==")
+    full_match = {}
+    for n in names:
+        res = data["results"][n]
+        cnt = 0
+        mism = []
+        for i, r in enumerate(res):
+            exp = expected_outputs[i].strip()
+            if r["ok"] and r["text"].strip() == exp:
+                cnt += 1
+            else:
+                mism.append(i)
+        full_match[n] = (cnt == len(inputs))
+        lines.append(f"{n}: {cnt}/{len(inputs)} exact matches" + (f"; mismatched sample indices {mism}" if mism else ""))
+    lines.append("")
+    lines.append("== Per-sample printed values ==")
+    for i, t in enumerate(inputs):
+        lines.append(f"sample {i}: expected {expected_outputs[i].strip()!r}")
+        for n in names:
+            r = data["results"][n][i]
+            lines.append(f"  {n}: {r['text']}")
+    if extra_inputs:
+        lines.append("")
+        lines.append("== Extra inputs (candidate values and spread) ==")
+        for j, t in enumerate(extra_inputs):
+            vals = data["extra"][t]
+            ok = [(n, vals[n]) for n in names if vals[n]["ok"]]
+            lines.append(f"extra {j}:")
+            for n in names:
+                lines.append(f"  {n}: {vals[n]['text']}")
+            texts = set(v["text"] for _, v in ok)
+            if len(ok) >= 2:
+                from fractions import Fraction
+                exs = [Fraction(v["val"]) for _, v in ok]
+                spread = float(max(exs) - min(exs))
+                flag = "DISCRIMINATING" if len(texts) > 1 else "agree"
+                lines.append(f"  spread (max-min over exact values) = {spread!r}; printed texts distinct = {len(texts)}; {flag}")
+            else:
+                lines.append("  not enough successful candidates for spread")
+    return "\n".join(lines)
