diff --git a/tools/interactive_judge.py b/tools/interactive_judge.py
new file mode 100644
index 0000000..7764f32
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,239 @@
+import os
+import select
+import subprocess
+import tempfile
+import time
+
+
+def tool_info():
+    return {
+        "name": "interactive_judge",
+        "description": """Run a solution of an interactive problem, either against a user-written judge over pipes ('live') or by replaying full stdin texts ('transcript'). Returns raw data only.\n
+* mode='live': runs solution_path and judge_path, both with `python3 -I` in a scrubbed environment. The judge is a Python script that writes to its stdout and reads the solution's output from its stdin. Its FIRST stdout line is the test parameters and is forwarded to the solution as the solution's first input line; later judge lines are forwarded as they are written (e.g. query replies). Every line the solution prints is forwarded to the judge and counted as a query. Output: the full message transcript (S> = solution line, J> = judge line), query count, both exit codes, raw stderr of both processes, and notes about timeouts, exceeding max_queries, or unterminated (unflushed) partial output left by the solution.
+* mode='transcript': runs solution_path once per entry of transcript_inputs. Each entry is the FULL stdin text (e.g. input line, hidden data lines, and reply lines all together), fed at once and then closed. Output: stdout, stderr and exit code per entry.
+* timeout is the per-read / per-run limit in seconds; max_queries caps the number of solution lines in live mode.
+* The tool does not interpret errors; read the raw stderr and transcript yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file."
+                },
+                "judge_path": {
+                    "type": "string",
+                    "description": "Path to the judge Python script (required for mode='live'). Its first stdout line is the test parameters."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "Either 'live' (judge over pipes) or 'transcript' (replay full stdin texts)."
+                },
+                "transcript_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of full stdin texts for mode='transcript'; each entry is run as a separate test."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-read (live) or per-run (transcript) time limit in seconds (default 10)."
+                },
+                "max_queries": {
+                    "type": "integer",
+                    "description": "Maximum number of solution lines in live mode before the run is stopped (default 1000)."
+                }
+            },
+            "required": ["solution_path", "mode"]
+        }
+    }
+
+
+MAX_CHARS = 8000
+
+
+def _clip(s, n=MAX_CHARS):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _env():
+    return {'PATH': os.environ.get('PATH', '/usr/bin:/bin')}
+
+
+def _decode(b):
+    return (b or b'').decode('utf-8', errors='replace')
+
+
+def _tail_file(f):
+    f.seek(0)
+    return _decode(f.read())
+
+
+def _live(solution_path, judge_path, timeout, max_queries, workdir):
+    notes = []
+    transcript = []
+    queries = 0
+    env = _env()
+    err_sol = tempfile.TemporaryFile()
+    err_judge = tempfile.TemporaryFile()
+    sol = subprocess.Popen(['python3', '-I', solution_path], stdin=subprocess.PIPE,
+                           stdout=subprocess.PIPE, stderr=err_sol, cwd=workdir, env=env)
+    judge = subprocess.Popen(['python3', '-I', judge_path], stdin=subprocess.PIPE,
+                             stdout=subprocess.PIPE, stderr=err_judge, cwd=workdir, env=env)
+    sol_buf = b''
+    judge_buf = b''
+    open_fds = {judge.stdout.fileno(): 'judge', sol.stdout.fileno(): 'sol'}
+    overall_deadline = time.time() + max(timeout, 1) * 5
+    sol_stdin_ok = True
+    judge_stdin_ok = True
+    stop = False
+
+    def send(pipe, data):
+        try:
+            pipe.write(data)
+            pipe.flush()
+            return True
+        except OSError:
+            return False
+
+    while open_fds and not stop:
+        remaining = overall_deadline - time.time()
+        if remaining <= 0:
+            notes.append("overall time limit reached; stopping both processes")
+            break
+        ready, _, _ = select.select(list(open_fds.keys()), [], [], min(remaining, max(timeout, 1)))
+        if not ready:
+            notes.append(f"no output from either process for {timeout} seconds (read timeout)")
+            if sol_buf:
+                notes.append(f"solution has unterminated partial output (possibly not flushed or missing newline): {sol_buf[:200]!r}")
+            break
+        for fd in ready:
+            which = open_fds[fd]
+            data = os.read(fd, 65536)
+            if not data:
+                del open_fds[fd]
+                notes.append(f"{which} closed its stdout (EOF)")
+                if which == 'judge' and sol_stdin_ok:
+                    try:
+                        sol.stdin.close()
+                    except OSError:
+                        pass
+                    sol_stdin_ok = False
+                continue
+            if which == 'judge':
+                judge_buf += data
+                while b'\n' in judge_buf:
+                    line, judge_buf = judge_buf.split(b'\n', 1)
+                    transcript.append('J> ' + _decode(line))
+                    if sol_stdin_ok:
+                        if not send(sol.stdin, line + b'\n'):
+                            notes.append("solution stdin is closed (solution probably exited)")
+                            sol_stdin_ok = False
+                    else:
+                        notes.append("judge wrote a line after solution stdin closed; dropped")
+            else:
+                sol_buf += data
+                while b'\n' in sol_buf:
+                    line, sol_buf = sol_buf.split(b'\n', 1)
+                    queries += 1
+                    transcript.append('S> ' + _decode(line))
+                    if queries > max_queries:
+                        notes.append(f"max_queries={max_queries} exceeded; stopping")
+                        stop = True
+                        break
+                    if judge_stdin_ok:
+                        if not send(judge.stdin, line + b'\n'):
+                            notes.append("judge stdin is closed (judge probably exited)")
+                            judge_stdin_ok = False
+                    else:
+                        notes.append("solution wrote a line after judge stdin closed; dropped")
+                if stop:
+                    break
+    if judge_buf:
+        transcript.append('J> (unterminated) ' + _decode(judge_buf))
+    if sol_buf:
+        transcript.append('S> (unterminated) ' + _decode(sol_buf))
+
+    for pipe in (sol.stdin, judge.stdin):
+        try:
+            pipe.close()
+        except Exception:
+            pass
+
+    for proc, label in ((sol, 'solution'), (judge, 'judge')):
+        try:
+            proc.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            try:
+                proc.wait(timeout=2)
+            except subprocess.TimeoutExpired:
+                pass
+            notes.append(f"{label} was still running and was killed")
+    for p in (sol, judge):
+        for s in (p.stdout,):
+            try:
+                s.close()
+            except Exception:
+                pass
+
+    out = []
+    out.append(f"mode: live | solution: {solution_path} | judge: {judge_path}")
+    out.append("transcript (S> = solution line, J> = judge line):")
+    if transcript:
+        out.extend(transcript)
+    else:
+        out.append("(no messages)")
+    out.append(f"query count (solution lines): {queries}")
+    out.append(f"solution exit code: {sol.returncode}")
+    out.append(f"judge exit code: {judge.returncode}")
+    if notes:
+        out.append("notes: " + "; ".join(notes))
+    out.append("--- solution stderr ---")
+    out.append(_clip(_tail_file(err_sol)) or "(empty)")
+    out.append("--- judge stderr ---")
+    out.append(_clip(_tail_file(err_judge)) or "(empty)")
+    err_sol.close()
+    err_judge.close()
+    return _clip("\n".join(out), 12000)
+
+
+def _transcript(solution_path, transcript_inputs, timeout, workdir):
+    env = _env()
+    out = []
+    for i, text in enumerate(transcript_inputs):
+        out.append(f"=== transcript input {i} ({len(text)} chars) ===")
+        try:
+            p = subprocess.run(['python3', '-I', solution_path], input=text.encode('utf-8'),
+                               capture_output=True, timeout=timeout, cwd=workdir, env=env)
+            out.append(f"stdout:\n{_clip(_decode(p.stdout)) or '(empty)'}")
+            out.append(f"stderr:\n{_clip(_decode(p.stderr)) or '(empty)'}")
+            out.append(f"exit code: {p.returncode}")
+        except subprocess.TimeoutExpired as e:
+            out.append(f"stdout (partial):\n{_clip(_decode(e.stdout)) or '(empty)'}")
+            out.append(f"stderr (partial):\n{_clip(_decode(e.stderr)) or '(empty)'}")
+            out.append(f"TIMEOUT after {timeout} seconds")
+    return _clip("\n".join(out), 12000) if out else "(no transcript_inputs given)"
+
+
+def tool_function(solution_path, mode, judge_path=None, transcript_inputs=None, timeout=10, max_queries=1000):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        max_queries = int(max_queries) if max_queries is not None else 1000
+    except (TypeError, ValueError):
+        max_queries = 1000
+    if not os.path.isfile(solution_path):
+        return f"Error: solution_path does not exist: {solution_path}"
+    workdir = tempfile.mkdtemp(prefix='ijudge_')
+    if mode == 'live':
+        if not judge_path or not os.path.isfile(judge_path):
+            return f"Error: judge_path missing or does not exist: {judge_path}"
+        return _live(solution_path, judge_path, timeout, max_queries, workdir)
+    if mode == 'transcript':
+        if not transcript_inputs:
+            return "Error: transcript mode needs a non-empty transcript_inputs list."
+        return _transcript(solution_path, list(transcript_inputs), timeout, workdir)
+    return f"Error: mode must be 'live' or 'transcript', got {mode!r}"
