+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator script. It is called as `python3 -I gen.py SEED MODE` and prints one input to stdout."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional path to the brute-force reference Python file that prints the canonical answer."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test per mode (seeds 0..num_tests-1). Default 100."
+                },
+                "modes": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of generator modes (e.g. small, edge, adversarial, max). If empty, the generator is called with the seed only."
+                },
+                "sample_dir": {
+                    "type": "string",
+                    "description": "Optional directory containing sample files NAME.in and NAME.out, used for sample pass/fail checks."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds. Default 5."
+                }
+            },
+            "required": ["candidate_paths", "generator_path"]
+        }
+    }
+
+
+def _run_py(path, data, timeout, args=()):
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", path, *[str(a) for a in args]],
+            input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+        return p.stdout, p.stderr, p.returncode, False, 0.0
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return out or "", err or "", None, True, float(timeout)
+
+
+def _run_timed(path, data, timeout):
+    start = time.time()
+    out, err, rc, to, _ = _run_py(path, data, timeout)
+    return out, err, rc, to, time.time() - start
+
+
+def _norm(s):
+    return " ".join((s or "").split())
+
+
+def _clip(s):
+    s = s or ""
+    return s if len(s) <= CLIP else s[:CLIP] + f"\n...[clipped, {len(s)} chars total]"
+
+
+def _ok(rc, to):
+    return (not to) and rc == 0
+
+
+def collect(candidate_paths, generator_path, brute_path=None, num_tests=100,
+            modes=None, sample_dir=None, timeout=5):
+    """Run everything and return raw structured data (used by tool_function and by agent code)."""
+    if isinstance(candidate_paths, str):
+        candidate_paths = [candidate_paths]
+    candidate_paths = list(candidate_paths or [])
+    num_tests = int(num_tests)
+    timeout = int(timeout)
+    modes = list(modes or [])
+    n_cand = len(candidate_paths)
+    names = list(candidate_paths)
+
+    # ---- samples ----
+    sample_pass = [0] * n_cand
+    sample_total = 0
+    sample_fail_details = []
+    if sample_dir:
+        for in_path in sorted(glob.glob(os.path.join(sample_dir, "*.in"))):
+            out_path = in_path[:-3] + ".out"
+            if not os.path.exists(out_path):
+                continue
+            sample_total += 1
+            with open(in_path) as f:
+                sin = f.read()
+            with open(out_path) as f:
+                sexp = f.read()
+            for k, cp in enumerate(candidate_paths):
+                so, se, src, sto, _ = _run_timed(cp, sin, timeout)
+                if _ok(src, sto) and _norm(so) == _norm(sexp):
+                    sample_pass[k] += 1
+                else:
+                    sample_fail_details.append(
+                        f"[{names[k]}] sample {os.path.basename(in_path)} FAILED: rc={src} timeout={sto}\n"
+                        f"expected: {_clip(sexp)}\nactual: {_clip(so)}\nstderr: {_clip(se)}"
+                    )
+
+    # ---- random tests ----
+    run_modes = modes if modes else [None]
+    agree_brute = [0] * n_cand
+    agree_major = [0] * n_cand
+    brute_checked = 0
+    total = 0
+    max_time = [0.0] * n_cand
+    crashes = [[] for _ in range(n_cand)]
+    disagree = []
+    gen_failures = []
+
+    for mode in run_modes:
+        for seed in range(num_tests):
+            args = [seed] if mode is None else [seed, mode]
+            tag = f"seed={seed}" + ("" if mode is None else f" mode={mode}")
+            g_out, g_err, g_rc, g_to, _ = _run_py(generator_path, "", timeout, args=args)
+            if g_to or g_rc != 0:
+                if len(gen_failures) < 3:
+                    gen_failures.append(f"generator failed at {tag}: rc={g_rc} timeout={g_to}\n{_clip(g_err)}")
+                continue
+            inp = g_out
+            total += 1
+
+            brute_out = None
+            if brute_path:
+                b_out, b_err, b_rc, b_to, _ = _run_timed(brute_path, inp, timeout)
+                if _ok(b_rc, b_to):
+                    brute_out = _norm(b_out)
+                    brute_checked += 1
+                elif len(gen_failures) < 3:
+                    gen_failures.append(f"brute failed at {tag}: rc={b_rc} timeout={b_to}\n{_clip(b_err)}")
+
+            outs = [None] * n_cand
+            for k, cp in enumerate(candidate_paths):
+                c_out, c_err, c_rc, c_to, el = _run_timed(cp, inp, timeout)
+                max_time[k] = max(max_time[k], el)
+                if _ok(c_rc, c_to):
+                    outs[k] = _norm(c_out)
+                elif len(crashes[k]) < MAX_CRASH_SHOWN:
+                    crashes[k].append(
+                        f"[{tag}] rc={c_rc} timeout={c_to}\nINPUT:\n{_clip(inp)}\nstderr:\n{_clip(c_err)}"
+                    )
+
+            counts = Counter(o for o in outs if o is not None)
+            majority = counts.most_common(1)[0][0] if counts else None
+            all_agree = True
+            for k in range(n_cand):
+                if outs[k] is not None and majority is not None and outs[k] == majority:
+                    agree_major[k] += 1
+                if brute_out is not None and outs[k] is not None and outs[k] == brute_out:
+                    agree_brute[k] += 1
+                if brute_out is not None and outs[k] != brute_out:
+                    all_agree = False
+                if brute_out is None and (outs[k] is None or outs[k] != majority):
+                    all_agree = False
+            if not all_agree and len(disagree) < MAX_DISAGREE_SHOWN:
+                kind = "DISAGREEMENT" if brute_out is not None else "DISAGREEMENT (no brute)"
+                detail = [f"{kind} at {tag}", f"INPUT:\n{_clip(inp)}"]
+                if brute_out is not None:
+                    detail.append(f"BRUTE: {_clip(brute_out)}")
+                for k in range(n_cand):
+                    detail.append(f"  {names[k]} -> {_clip(outs[k]) if outs[k] is not None else 'CRASH/TIMEOUT'}")
+                disagree.append("\n".join(detail))
+
+    return {
+        "names": names,
+        "sample_dir": sample_dir,
+        "sample_total": sample_total,
+        "sample_pass": sample_pass,
+        "sample_fail_details": sample_fail_details,
+        "total": total,
+        "brute_used": bool(brute_path),
+        "brute_checked": brute_checked,
+        "agree_brute": agree_brute,
+        "agree_major": agree_major,
+        "max_time": max_time,
+        "crashes": crashes,
+        "disagree": disagree,
+        "gen_failures": gen_failures,
+    }
+
+
+def format_report(d):
+    n_cand = len(d["names"])
+    lines = [f"SAMPLES: {d['sample_total']} sample(s) in {d['sample_dir'] or '(none)'}"]
+    for k in range(n_cand):
+        lines.append(f"  {d['names'][k]} passed {d['sample_pass'][k]}/{d['sample_total']}")
+    for s in d["sample_fail_details"][:MAX_CRASH_SHOWN * max(n_cand, 1)]:
+        lines.append(s)
+    lines.append(f"RANDOM TESTS: {d['total']} generated input(s), brute outputs available on {d['brute_checked']}")
+    for k in range(n_cand):
+        if d["brute_used"]:
+            lines.append(f"  {d['names'][k]} agrees_with_brute {d['agree_brute'][k]}/{d['brute_checked']}"
+                         f" agrees_with_majority {d['agree_major'][k]}/{d['total']}"
+                         f" max_time {d['max_time'][k]:.3f}s")
+        else:
+            lines.append(f"  {d['names'][k]} agrees_with_majority {d['agree_major'][k]}/{d['total']}"
+                         f" max_time {d['max_time'][k]:.3f}s")
+    if d["gen_failures"]:
+        lines.append("GENERATOR/BRUTE FAILURES (first few):")
+        lines.extend(d["gen_failures"])
+    if d["disagree"]:
+        lines.append(f"FIRST DISAGREEING INPUTS (up to {MAX_DISAGREE_SHOWN}):")
+        lines.extend(d["disagree"])
+    else:
+        lines.append("No disagreements among compared outputs.")
+    for k in range(n_cand):
+        if d["crashes"][k]:
+            lines.append(f"CRASHES/TIMEOUTS for {d['names'][k]} (first few):")
+            lines.extend(d["crashes"][k])
+    return "\n".join(lines)
+
+
+def tool_function(candidate_paths, generator_path, brute_path=None, num_tests=100,
+                  modes=None, sample_dir=None, timeout=5):
+    if not candidate_paths:
+        return "No candidate_paths given."
+    d = collect(candidate_paths, generator_path, brute_path=brute_path, num_tests=num_tests,
+                modes=modes, sample_dir=sample_dir, timeout=timeout)
+    return format_report(d)
