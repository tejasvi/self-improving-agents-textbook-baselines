diff --git a/tools/match_expected_output.py b/tools/match_expected_output.py
new file mode 100644
index 0000000..287feb5
--- /dev/null
+++ b/tools/match_expected_output.py
@@ -0,0 +1,261 @@
+import re
+import subprocess
+import sys
+import os
+from decimal import Decimal, ROUND_HALF_EVEN, ROUND_DOWN, localcontext
+from fractions import Fraction
+import math
+
+
+NUM_RE = re.compile(r'^[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?$')
+
+
+def tool_info():
+    return {
+        "name": "match_expected_output",
+        "description": """Find how a real-valued (or integer) program output must be formatted to match the reference output text EXACTLY (the grader compares text, not tolerances).
+* `solution_path` is a Python stdin program. Each sample has `input` (stdin text) and `expected` (the exact expected stdout text).
+* Each sample is run with `python3 -I`. If the whitespace-normalized output equals `expected`, it is reported as EXACT.
+* Otherwise, every numeric token of the output is re-rendered with a set of candidate formatters and compared with the numeric tokens of `expected` (the numeric token counts must match). Candidate formatters: repr(x); '%.Nf' for N in 0..40; '%.Ng' for N in 1..40; str(Decimal(x)) (exact binary expansion); format(Decimal(x),'f') truncated to the expected token length; integer-style printing when x is integral; the exact binary expansion truncated or rounded (half-even) to the number of decimals in the expected token.
+* Optional `exact_values`: one string per sample, containing whitespace-separated exact values ('p/q' fractions or high-precision decimals) for that sample's numeric tokens in order. These are rendered at the expected number of decimals, rounded half-even ('exact_round_half_even') and truncated ('exact_trunc').
+* Returns raw data only: per sample, the status, the numeric tokens of output and expected, for each token the best near-miss candidate and its common-prefix length with the expected token, and the list of formatters that reproduce ALL samples exactly. No judgement is given.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python stdin program (solution.py) whose output should be matched."
+                },
+                "samples": {
+                    "type": "array",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact stdin text for this sample."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected stdout text for this sample."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    },
+                    "description": "List of samples, each with the stdin 'input' and the exact 'expected' output text."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds. Default 10."
+                },
+                "exact_values": {
+                    "type": "array",
+                    "items": {
+                        "type": "string"
+                    },
+                    "description": "Optional. One string per sample (same order as samples): whitespace-separated exact answers ('p/q' or high-precision decimal) for that sample's numeric tokens, in order. Leave empty to skip."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _norm(s):
+    return " ".join(s.split())
+
+
+def _run(solution_path, data, timeout):
+    try:
+        p = subprocess.run(
+            [sys.executable, "-I", solution_path],
+            input=data, capture_output=True, text=True, timeout=timeout,
+            env={"PATH": os.environ.get("PATH", "")},
+        )
+        return p.stdout, p.stderr, p.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+        return out, err, None, True
+
+
+def _decimals_in(tok):
+    """Number of digits after the decimal point in a numeric token (0 if none)."""
+    base = tok.split('e')[0].split('E')[0]
+    if '.' in base:
+        return len(base.split('.')[1])
+    return 0
+
+
+def _render_exact(exact_str, d, mode):
+    """Render an exact value (p/q or decimal string) with d decimals."""
+    try:
+        v = Fraction(exact_str)
+    except (ValueError, ZeroDivisionError):
+        return None
+    scaled = v * (10 ** d)
+    if mode == 'half_even':
+        n = round(scaled)  # Fraction rounding is half-even in Python
+    else:
+        n = math.trunc(scaled)
+    sign = '-' if n < 0 else ''
+    n = abs(n)
+    s = str(n).rjust(d + 1, '0')
+    if d == 0:
+        return sign + s
+    return sign + s[:-d] + '.' + s[-d:]
+
+
+def _float_candidates(tok, exp_tok, exact_str):
+    """Return dict formatter_name -> rendered string (or None) for one numeric token."""
+    c = {}
+    x = float(tok)
+    d = _decimals_in(exp_tok)
+    c['repr'] = repr(x)
+    for n in range(0, 41):
+        c[f'fixed_{n}'] = '%.*f' % (n, x)
+    for n in range(1, 41):
+        c[f'general_{n}'] = '%.*g' % (n, x)
+    dx = Decimal(x)
+    c['decimal_str'] = str(dx) if math.isfinite(x) else None
+    full_f = format(dx, 'f')
+    c['decimal_f_trimmed_to_expected_len'] = full_f[:len(exp_tok)]
+    c['int_if_integral'] = str(int(x)) if (math.isfinite(x) and x == math.floor(x)) else None
+    if math.isfinite(x):
+        with localcontext() as ctx:
+            ctx.prec = 1500
+            q = Decimal(1).scaleb(-d)
+            c['exact_binary_trunc_expected_decimals'] = str(dx.quantize(q, rounding=ROUND_DOWN))
+            c['exact_binary_round_half_even_expected_decimals'] = str(dx.quantize(q, rounding=ROUND_HALF_EVEN))
+    else:
+        c['exact_binary_trunc_expected_decimals'] = None
+        c['exact_binary_round_half_even_expected_decimals'] = None
+    if exact_str is not None:
+        c['exact_round_half_even'] = _render_exact(exact_str, d, 'half_even')
+        c['exact_trunc'] = _render_exact(exact_str, d, 'trunc')
+    else:
+        c['exact_round_half_even'] = None
+        c['exact_trunc'] = None
+    return c
+
+
+def _common_prefix(a, b):
+    k = 0
+    for ca, cb in zip(a, b):
+        if ca != cb:
+            break
+        k += 1
+    return k
+
+
+def _numeric_tokens(text):
+    return [t for t in text.split() if NUM_RE.match(t)]
+
+
+def _replace_numeric(text, render):
+    """Replace each numeric whitespace-token in text (in order) by render(k, tok). Returns normalized text."""
+    out = []
+    k = 0
+    for t in text.split():
+        if NUM_RE.match(t):
+            out.append(render(k, t))
+            k += 1
+        else:
+            out.append(t)
+    return " ".join(out)
+
+
+def tool_function(solution_path, samples, timeout=10, exact_values=None):
+    lines = []
+    exact_values = exact_values or []
+    all_formatters = None
+    per_sample_match_sets = []  # for each sample, set of formatter names matching it fully
+    tables = []
+
+    for i, s in enumerate(samples):
+        inp = s.get('input', '')
+        exp = s.get('expected', '')
+        out, err, rc, timed_out = _run(solution_path, inp, timeout)
+        header = f"=== sample {i} ==="
+        lines.append(header)
+        if timed_out:
+            lines.append("STATUS: TIMEOUT")
+            lines.append(f"stderr: {err[-1000:]}")
+            per_sample_match_sets.append(set())
+            continue
+        if rc != 0:
+            lines.append(f"STATUS: NONZERO EXIT {rc}")
+            lines.append(f"stderr: {err[-2000:]}")
+            per_sample_match_sets.append(set())
+            continue
+        if _norm(out) == _norm(exp):
+            lines.append("STATUS: EXACT")
+            per_sample_match_sets.append(None)  # matches everything
+            continue
+
+        out_nums = _numeric_tokens(out)
+        exp_nums = _numeric_tokens(exp)
+        lines.append(f"output:   {_norm(out)[:500]}")
+        lines.append(f"expected: {_norm(exp)[:500]}")
+        if len(out_nums) != len(exp_nums):
+            lines.append(f"STATUS: MISMATCH (numeric token count differs: output {len(out_nums)}, expected {len(exp_nums)})")
+            per_sample_match_sets.append(set())
+            continue
+        lines.append("STATUS: MISMATCH")
+
+        exact_list = exact_values[i].split() if i < len(exact_values) and exact_values[i] else []
+
+        # Per-token candidates
+        token_cands = []
+        for k, (ot, et) in enumerate(zip(out_nums, exp_nums)):
+            ex = exact_list[k] if k < len(exact_list) else None
+            token_cands.append(_float_candidates(ot, et, ex))
+
+        # Names of formatters available for every token
+        names = set()
+        for c in token_cands:
+            names |= set(c.keys())
+        matched = set()
+        for name in sorted(names):
+            ok = True
+            def render(k, t, name=name):
+                v = token_cands[k].get(name)
+                return v if v is not None else "\x00"
+            rendered_text = _replace_numeric(out, render)
+            if "\x00" in rendered_text:
+                ok = False
+            elif _norm(rendered_text) != _norm(exp):
+                ok = False
+            if ok:
+                matched.add(name)
+        per_sample_match_sets.append(matched)
+
+        lines.append(f"formatters matching this sample fully: {sorted(matched) if matched else 'NONE'}")
+        for k, (ot, et, c) in enumerate(zip(out_nums, exp_nums, token_cands)):
+            best_name, best_val, best_len = None, None, -1
+            for name, v in c.items():
+                if v is None:
+                    continue
+                L = _common_prefix(v, et)
+                if L > best_len or (L == best_len and v == et):
+                    best_name, best_val, best_len = name, v, L
+            exact_hit = [n for n, v in c.items() if v == et]
+            lines.append(
+                f"  token {k}: out={ot} expected={et} "
+                f"exact_hits={exact_hit if exact_hit else 'NONE'} "
+                f"best_near_miss={best_name}->{best_val} common_prefix={best_len}/{len(et)}"
+            )
+
+    # Formatters matching ALL samples (samples that are EXACT match everything)
+    sets = [m for m in per_sample_match_sets if m is not None]
+    if not sets:
+        lines.append("FORMATTERS MATCHING ALL SAMPLES: ALL (every sample already EXACT)")
+    else:
+        common = set(sets[0])
+        for m in sets[1:]:
+            common &= m
+        if common:
+            lines.append(f"FORMATTERS MATCHING ALL SAMPLES: {sorted(common)}")
+        else:
+            lines.append("FORMATTERS MATCHING ALL SAMPLES: NONE (fixed-precision printing cannot reproduce all samples; consider Fraction/Decimal high-precision arithmetic and re-run with exact_values)")
+    return "\n".join(lines)
