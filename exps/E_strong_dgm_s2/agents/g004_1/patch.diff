new file mode 100644
index 0000000..dc625b7
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,178 @@
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import time
+
+_HEADER_IO = re.compile(
+    r'^[ \t]*(?:Sample[ \t]+)?(Input|Output)(?:[ \t]+\d+)?[ \t]*(?::(.*)|$)', re.IGNORECASE)
+_HEADER_EXAMPLE = re.compile(r'^[ \t]*(?:Sample[ \t]+)?Example(?:[ \t]+\d+)?[ \t]*:?[ \t]*$', re.IGNORECASE)
+_SECTION = re.compile(
+    r'^[ \t]*(Explanation|Note|Notes|Constraints|Example|Sample|Input|Output|Problem)\b.*$', re.IGNORECASE)
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Check a Python solution against every sample input/output pair in the problem statement.\n
+* Extracts each sample from the statement (patterns such as 'Sample Input N' / 'Sample Output N', 'Input:' / 'Output:', 'Example N').
+* Runs `python3 -I solution.py` on each sample input in a temporary directory.
+* For each sample reports PASS or FAIL, using exact comparison after trimming trailing whitespace on each line, plus the raw expected output, the raw actual output, stderr and exit code.
+* The raw results are returned without interpretation. A FAIL is a failure even if the output is a valid alternative answer, because the grader compares text exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test (e.g. /path/to/solution.py)."
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The full text of the problem statement containing the samples."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+
+def _rstrip_lines(text):
+    lines = [ln.rstrip() for ln in text.replace('\r\n', '\n').replace('\r', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _clip(s, n=6000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def extract_samples(statement):
+    """Return a list of (input_text, expected_output_text) pairs, in statement order."""
+    lines = statement.replace('\r\n', '\n').split('\n')
+    samples = []
+    cur_in = None
+    cur_out = None
+    mode = None  # 'in' or 'out' or None
+    buf = []
+
+    def flush_pair():
+        nonlocal cur_in, cur_out
+        if cur_in is not None and cur_out is not None:
+            samples.append((cur_in, cur_out))
+        cur_in = None
+        cur_out = None
+
+    def close_block():
+        nonlocal mode, buf, cur_in, cur_out
+        if mode == 'in':
+            cur_in = _rstrip_lines('\n'.join(buf)).strip('\n')
+        elif mode == 'out':
+            cur_out = _rstrip_lines('\n'.join(buf)).strip('\n')
+        mode = None
+        buf = []
+
+    for line in lines:
+        m = _HEADER_IO.match(line)
+        if m:
+            kind = m.group(1).lower()
+            # A new Input header closes any previous complete pair.
+            if kind == 'input':
+                close_block()
+                if cur_in is not None and cur_out is not None:
+                    flush_pair()
+                elif cur_in is not None and cur_out is None:
+                    # Input without output: drop the dangling input.
+                    cur_in = None
+                mode = 'in'
+                buf = []
+                rest = (m.group(2) or '').strip()
+                if rest and rest.strip():
+                    buf.append(rest)
+            else:
+                close_block()
+                if mode is None and cur_in is None:
+                    # Output with no preceding input.
+                    continue
+                mode = 'out'
+                buf = []
+                rest = (m.group(2) or '').strip()
+                if rest and rest.strip():
+                    buf.append(rest)
+            continue
+        if _HEADER_EXAMPLE.match(line):
+            close_block()
+            flush_pair()
+            continue
+        if mode is not None and _SECTION.match(line) and not line.strip().lower().startswith(('input', 'output')):
+            # Section header (e.g. Explanation, Constraints) ends the current block.
+            close_block()
+            if cur_in is not None and cur_out is not None:
+                flush_pair()
+            continue
+        if mode is not None:
+            buf.append(line)
+    close_block()
+    flush_pair()
+    return samples
+
+
+def _run_one(solution_path, stdin_text, timeout, workdir):
+    start = time.time()
+    try:
+        p = subprocess.run(
+            [sys.executable, '-I', solution_path],
+            input=stdin_text, capture_output=True, text=True, cwd=workdir,
+            timeout=timeout, errors='replace',
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return {'stdout': out, 'stderr': err + f"\n(timed out after {timeout} seconds)", 'returncode': None,
+                'elapsed': time.time() - start}
+    return {'stdout': p.stdout, 'stderr': p.stderr, 'returncode': p.returncode,
+            'elapsed': time.time() - start}
+
+
+def tool_function(solution_path, problem_statement, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 300))
+    except (TypeError, ValueError):
+        timeout = 10
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    samples = extract_samples(problem_statement or '')
+    if not samples:
+        return "No samples found in the problem statement."
+
+    solution_path = os.path.abspath(solution_path)
+    reports = []
+    passed = 0
+    with tempfile.TemporaryDirectory() as workdir:
+        for idx, (inp, expected) in enumerate(samples, 1):
+            res = _run_one(solution_path, inp + '\n', timeout, workdir)
+            actual = _rstrip_lines(res['stdout'])
+            exp = _rstrip_lines(expected)
+            ok = actual == exp and res['returncode'] == 0
+            if ok:
+                passed += 1
+            block = [f"Sample {idx}: {'PASS' if ok else 'FAIL'}",
+                     "--- input ---", inp,
+                     "--- expected output ---", exp,
+                     "--- actual output ---", actual]
+            if res['returncode'] != 0:
+                block.append(f"--- exit code: {res['returncode']} ---")
+            if res['stderr'].strip():
+                block.append("--- stderr ---")
+                block.append(_clip(res['stderr'].rstrip()))
+            reports.append('\n'.join(block))
+
+    summary = f"Samples: {len(samples)}, passed: {passed}, failed: {len(samples) - passed}"
+    return summary + "\n\n" + "\n\n".join(reports)
