+def _clean_history(msg_history):
+    """
+    Drop assistant messages whose text is empty or '(no output)', so the model
+    is not conditioned on its own empty replies.
+    """
+    def _text_of(msg):
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, dict):
+                    parts.append(str(block.get('text', '') or ''))
+                else:
+                    parts.append(str(getattr(block, 'text', '') or ''))
+            return ''.join(parts)
+        return ''
+
+    cleaned = []
+    for msg in msg_history or []:
+        if msg.get('role') == 'assistant':
+            text = _text_of(msg).strip()
+            if not text or text == '(no output)':
+                continue
+        cleaned.append(msg)
+    return cleaned
+
