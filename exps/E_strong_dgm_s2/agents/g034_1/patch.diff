+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from collections import Counter
+
+from tools.stress_compare import _run, _clip, _compare
+
+
+def tool_info():
+    return {
+        "name": "judge_candidates",
+        "description": """Judge several candidate solutions on the same generated inputs and report raw results.\n
+* `generator_path` is run as `python3 generator.py SEED` for SEED = 1..num_tests and prints one input.
+* `extra_inputs` are extra test inputs; each entry is either the literal input text or a path to a file holding the input (e.g. samples, max-size input).
+* Each candidate is run with `python3 -I` on each input with a timeout.
+* Verdict per candidate and input: if `checker_path` is given, it is run as `python3 checker.py input_file output_file`; exit code 0 means accepted and stderr holds the reason. Otherwise, if `reference_path` is given, the output is compared token by token with the reference output (numeric tokens with tolerance 1e-9). Otherwise, a candidate passes when its output equals the most common output among the successful candidates.
+* Returns raw data: per candidate pass/fail/timeout/crash counts, max elapsed time, the first failing input with the candidate's output and the checker message, the first crash stderr, and the seeds where candidates disagree. The last line is a JSON summary (prefixed with JUDGE_SUMMARY_JSON:).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidate_paths": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Paths to the candidate Python solution files to judge."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator script; run as `python3 generator.py SEED`, prints one input."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a validator script run as `python3 checker.py input_file output_file`. Exit 0 = accepted; stderr gives the reason."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Optional path to a reference program used for token diff when no checker is given."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to test, seeds 1..num_tests (default 300, at least 300 recommended)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run time limit in seconds for each candidate, checker and reference (default 10)."
+                },
+                "extra_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Extra inputs run in addition to the generated ones: each entry is input text or a path to an input file (samples, max-size input)."
+                }
+            },
+            "required": ["candidate_paths", "generator_path"]
+        }
+    }
+
+
+def _norm(s):
+    return " ".join((s or "").split())
+
+
+def _read_extra(entries):
+    inputs = []
+    for i, e in enumerate(entries or []):
+        if not isinstance(e, str):
+            continue
+        is_file = False
+        if len(e) < 1024 and '\n' not in e:
+            try:
+                is_file = os.path.isfile(e)
+            except (ValueError, OSError):
+                is_file = False
+        if is_file:
+            with open(e, errors='replace') as f:
+                inputs.append((f"extra[{i}]:{e}", f.read()))
+        else:
+            inputs.append((f"extra[{i}]", e))
+    return inputs
+
+
+def _run_checker(checker_path, in_text, out_text, timeout, tmpdir):
+    inp = os.path.join(tmpdir, 'check_in.txt')
+    outp = os.path.join(tmpdir, 'check_out.txt')
+    with open(inp, 'w') as f:
+        f.write(in_text)
+    with open(outp, 'w') as f:
+        f.write(out_text)
+    try:
+        p = subprocess.run([sys.executable, '-I', checker_path, inp, outp], capture_output=True,
+                           text=True, timeout=timeout, errors='replace')
+        msg = (p.stderr or p.stdout or '').strip()
+        return p.returncode == 0, msg
+    except subprocess.TimeoutExpired:
+        return False, f"checker timed out after {timeout}s"
+
+
+def _timed_run(path, data, timeout):
+    t0 = time.time()
+    r = _run(path, data, timeout)
+    r['elapsed'] = time.time() - t0
+    return r
+
+
+def tool_function(candidate_paths, generator_path, checker_path=None, reference_path=None,
+                  num_tests=300, timeout=10, extra_inputs=None):
+    try:
+        num_tests = max(1, min(int(num_tests or 300), 2000))
+    except (TypeError, ValueError):
+        num_tests = 300
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    if isinstance(candidate_paths, str):
+        candidate_paths = [candidate_paths]
+    candidate_paths = list(candidate_paths or [])
+    if not candidate_paths:
+        return "Error: no candidate_paths given"
+    for p in candidate_paths + [generator_path]:
+        if not os.path.isfile(p):
+            return f"Error: file not found: {p}"
+    if checker_path and not os.path.isfile(checker_path):
+        return f"Error: file not found: {checker_path}"
+    if reference_path and not os.path.isfile(reference_path):
+        return f"Error: file not found: {reference_path}"
+
+    names = [os.path.basename(p) for p in candidate_paths]
+    stats = {n: {'pass': 0, 'fail': 0, 'timeouts': 0, 'crashes': 0, 'max_elapsed': 0.0,
+                 'first_fail': None, 'first_crash': None} for n in names}
+    disagree_seeds = []
+    ref_failures = 0
+    checker_failures_only = 0
+    total = 0
+
+    tmpdir = tempfile.mkdtemp(prefix='judge_')
+
+    tests = []  # (label, seed or None, input_text)
+    for seed in range(1, num_tests + 1):
+        gen = subprocess.run([sys.executable, '-I', generator_path, str(seed)], capture_output=True,
+                             text=True, timeout=60, errors='replace')
+        if gen.returncode != 0:
+            return (f"Generator failed at seed {seed} (exit {gen.returncode}).\n"
+                    f"stderr:\n{_clip(gen.stderr)}")
+        tests.append((f"seed {seed}", seed, gen.stdout))
+    for label, text in _read_extra(extra_inputs):
+        tests.append((label, None, text))
+
+    for label, seed, data in tests:
+        total += 1
+        outs = {n: _timed_run(p, data, timeout) for n, p in zip(names, candidate_paths)}
+        ref = _run(reference_path, data, timeout) if reference_path else None
+        if ref is not None and not ref['ok']:
+            ref_failures += 1
+            ref = None
+
+        # Verdicts: True / False for each successful candidate, None for crashed/timed out
+        verdict = {}
+        reason = {}
+        for n in names:
+            r = outs[n]
+            st = stats[n]
+            st['max_elapsed'] = max(st['max_elapsed'], r['elapsed'])
+            if not r['ok']:
+                verdict[n] = False
+                reason[n] = 'timeout' if r['code'] == 'TIMEOUT' else f"exit {r['code']}"
+                if r['code'] == 'TIMEOUT':
+                    st['timeouts'] += 1
+                else:
+                    st['crashes'] += 1
+                if st['first_crash'] is None:
+                    st['first_crash'] = {'test': label, 'exit': str(r['code']),
+                                         'stderr': _clip(r['stderr'], 1500)}
+                continue
+            if checker_path:
+                ok, msg = _run_checker(checker_path, data, r['stdout'], timeout, tmpdir)
+                verdict[n] = ok
+                reason[n] = msg
+            elif ref is not None:
+                _, ok, _, _ = _compare(r['stdout'], ref['stdout'], 1e-9)
+                verdict[n] = ok
+                reason[n] = 'output differs from reference' if not ok else ''
+            else:
+                verdict[n] = None  # decided below by consensus
+                reason[n] = ''
+
+        if not checker_path and ref is None:
+            ok_outs = [_norm(outs[n]['stdout']) for n in names if outs[n]['ok']]
+            if ok_outs:
+                majority = Counter(ok_outs).most_common(1)[0][0]
+                for n in names:
+                    if outs[n]['ok']:
+                        verdict[n] = _norm(outs[n]['stdout']) == majority
+                        if not verdict[n]:
+                            reason[n] = 'output differs from the majority of candidates'
+            if len(set(ok_outs)) > 1 or len(ok_outs) < len(names):
+                disagree_seeds.append(label)
+        elif checker_path:
+            vals = set(verdict.values())
+            if len(vals) > 1:
+                disagree_seeds.append(label)
+        else:
+            ok_outs = set(_norm(outs[n]['stdout']) for n in names if outs[n]['ok'])
+            if len(ok_outs) > 1 or len(ok_outs) < len(names):
+                disagree_seeds.append(label)
+
+        for n in names:
+            st = stats[n]
+            if verdict[n]:
+                st['pass'] += 1
+            else:
+                st['fail'] += 1
+                if st['first_fail'] is None:
+                    st['first_fail'] = {
+                        'test': label,
+                        'input': _clip(data, 2000),
+                        'output': _clip(outs[n]['stdout'], 1500),
+                        'reason': _clip(reason[n] or outs[n]['stderr'], 1500),
+                    }
+
+    summary_cands = []
+    for n in names:
+        st = stats[n]
+        summary_cands.append({'name': n, 'pass': st['pass'], 'fail': st['fail'],
+                              'timeouts': st['timeouts'], 'crashes': st['crashes'],
+                              'all_pass': st['fail'] == 0 and st['pass'] > 0})
+    lines = [
+        f"tests run: {total} (generated seeds {num_tests}, extra inputs {total - num_tests})",
+        f"judge mode: {'checker' if checker_path else ('reference' if reference_path else 'agreement only')}",
+    ]
+    if reference_path and ref_failures:
+        lines.append(f"reference failed (crashed/timed out) on {ref_failures} inputs; those used agreement only")
+    lines.append(f"seeds where candidates disagree: {len(disagree_seeds)} {disagree_seeds[:50]}")
+    for n in names:
+        st = stats[n]
+        lines += [
+            f"=== candidate {n} ===",
+            f"pass={st['pass']} fail={st['fail']} timeouts={st['timeouts']} crashes={st['crashes']} "
+            f"max_elapsed={st['max_elapsed']:.3f}s",
+        ]
+        if st['first_fail']:
+            ff = st['first_fail']
+            lines += [f"first failing test: {ff['test']}",
+                      f"input:\n{ff['input']}",
+                      f"candidate output:\n{ff['output']}",
+                      f"checker/judge message:\n{ff['reason']}"]
+        if st['first_crash']:
+            fc = st['first_crash']
+            lines += [f"first crash/timeout: {fc['test']} exit={fc['exit']}",
+                      f"stderr:\n{fc['stderr']}"]
+    shutil.rmtree(tmpdir, ignore_errors=True)
+    lines.append("JUDGE_SUMMARY_JSON: " + json.dumps({
+        'tests': total,
+        'disagree_seeds': len(disagree_seeds),
+        'candidates': summary_cands,
+    }))
+    return "\n".join(lines)
