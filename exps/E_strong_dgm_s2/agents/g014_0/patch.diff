+"""Shared helpers for verification evidence (used by tools and coding_agent)."""
+import hashlib
+import json
+import os
+import re
+import shutil
+import time
+
+DEFAULT_STATE_FILE = '/tmp/agent_verify_state.json'
+MAX_RECORDS = 2000
+NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def state_path():
+    """Path of the JSON evidence file. Overridable with AGENT_VERIFY_STATE."""
+    return os.environ.get('AGENT_VERIFY_STATE') or DEFAULT_STATE_FILE
+
+
+def file_sha256(path):
+    """sha256 hex digest of a file, or None if the file does not exist."""
+    if not path or not os.path.isfile(path):
+        return None
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for chunk in iter(lambda: f.read(65536), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def load_records():
+    """All evidence records (list of dicts). Empty list if missing or corrupt."""
+    path = state_path()
+    if not os.path.isfile(path):
+        return []
+    try:
+        with open(path, 'r') as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return []
+    return data if isinstance(data, list) else []
+
+
+def candidate_dir():
+    """Directory holding a copy of every solution version that was verified."""
+    return state_path() + '.candidates'
+
+
+def candidate_path(sha):
+    return os.path.join(candidate_dir(), f"{sha}.py")
+
+
+def append_record(record):
+    """Append one record (adds a timestamp) to the evidence file. Never raises.
+
+    If the record names a solution file and its hash, a copy of that file is kept
+    in the candidate directory so the exact verified version can be restored later.
+    """
+    try:
+        sha = record.get('solution_sha256')
+        src = record.get('solution_path')
+        if sha and src and os.path.isfile(src):
+            os.makedirs(candidate_dir(), exist_ok=True)
+            dst = candidate_path(sha)
+            if not os.path.isfile(dst):
+                shutil.copyfile(src, dst)
+        records = load_records()
+        record = dict(record)
+        record['timestamp'] = time.time()
+        records.append(record)
+        records = records[-MAX_RECORDS:]
+        path = state_path()
+        d = os.path.dirname(path)
+        if d:
+            os.makedirs(d, exist_ok=True)
+        tmp = path + '.tmp'
+        with open(tmp, 'w') as f:
+            json.dump(records, f)
+        os.replace(tmp, path)
+    except OSError:
+        pass
+
+
+def compare_outputs(out_a, out_b, rel_tol):
+    """Compare two outputs token by token.
+
+    Returns (exact, ok, max_abs, max_rel). Numeric tokens pass if the absolute
+    or relative error is within rel_tol; other tokens must match exactly.
+    """
+    if out_a.strip() == out_b.strip():
+        return True, True, 0.0, 0.0
+    ta = out_a.split()
+    tb = out_b.split()
+    if len(ta) != len(tb):
+        return False, False, float('inf'), float('inf')
+    ok = True
+    max_abs = 0.0
+    max_rel = 0.0
+    for x, y in zip(ta, tb):
+        if x == y:
+            continue
+        if NUM_RE.match(x) and NUM_RE.match(y):
+            fx = float(x)
+            fy = float(y)
+            d = abs(fx - fy)
+            r = d / max(abs(fy), 1e-300)
+            max_abs = max(max_abs, d)
+            max_rel = max(max_rel, r)
+            if not (d <= rel_tol or r <= rel_tol):
+                ok = False
+        else:
+            ok = False
+            max_abs = float('inf')
+            max_rel = float('inf')
+    return False, ok, max_abs, max_rel
