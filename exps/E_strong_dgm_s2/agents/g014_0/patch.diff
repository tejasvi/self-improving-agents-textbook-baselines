@@ -0,0 +1,134 @@
+import os
+import subprocess
+import sys
+import time
+
+from utils.verify_common import compare_outputs, file_sha256, append_record
+
+
+def tool_info():
+    return {
+        "name": "check_samples",
+        "description": """Mechanically check a solution against sample tests with known expected outputs.\n
+* Runs solution_path once per sample with `python3 -I`, feeding `input` on stdin.
+* Compares each stdout with `expected_output` token by token: tokens must match exactly, except numeric tokens which pass if their absolute or relative error is within `tolerance`.
+* Returns raw per-sample results: the actual output, the expected output, mismatching tokens, exit code and runtime.
+* Use this for every sample in the statement instead of comparing outputs by eye. Re-run it after every edit of solution.py.
+* The result is recorded as verification evidence for the current contents of solution.py.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to check (e.g. /path/to/solution.py)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of samples. Each item is an object with 'input' (stdin text) and 'expected_output' (expected stdout text).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact stdin text for the sample."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Exact expected stdout text for the sample."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "tolerance": {
+                    "type": "number",
+                    "description": "Relative/absolute tolerance for numeric tokens (default 0, i.e. exact match). Use e.g. 1e-6 only when the statement allows an error."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _clip(s, n=2000):
+    if len(s) <= n:
+        return s
+    return s[: n // 2] + f"\n... <{len(s) - n} characters clipped> ...\n" + s[-n // 2:]
+
+
+def _run_one(path, data, timeout):
+    start = time.time()
+    try:
+        p = subprocess.run([sys.executable, '-I', path], input=data, capture_output=True,
+                           text=True, timeout=timeout, errors='replace',
+                           env={'PATH': os.environ.get('PATH', '/usr/bin:/bin')})
+        return p.stdout, p.stderr, p.returncode, round(time.time() - start, 3)
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ''
+        err = e.stderr if isinstance(e.stderr, str) else ''
+        return out, err + f"\n(timed out after {timeout}s)", 'TIMEOUT', round(time.time() - start, 3)
+
+
+def tool_function(solution_path, samples=None, tolerance=0.0, timeout=10):
+    try:
+        timeout = max(1, min(int(timeout or 10), 120))
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        tolerance = float(tolerance) if tolerance is not None else 0.0
+    except (TypeError, ValueError):
+        tolerance = 0.0
+    if not os.path.isfile(solution_path):
+        return f"Error: file not found: {solution_path}"
+    if not samples or not isinstance(samples, list):
+        return "Error: 'samples' must be a non-empty list of {input, expected_output} objects."
+
+    lines = []
+    passed = 0
+    first_failure = None
+    results = []
+    for idx, s in enumerate(samples, 1):
+        if not isinstance(s, dict) or 'input' not in s or 'expected_output' not in s:
+            lines.append(f"--- sample {idx}: malformed (needs input and expected_output) ---")
+            results.append(False)
+            continue
+        data = str(s['input'])
+        expected = str(s['expected_output'])
+        out, err, code, elapsed = _run_one(solution_path, data, timeout)
+        exact, ok, max_abs, max_rel = compare_outputs(out, expected, tolerance)
+        ok = ok and code == 0
+        results.append(ok)
+        if ok:
+            passed += 1
+        status = 'PASS (exact)' if exact and ok else ('PASS (within tolerance)' if ok else 'FAIL')
+        lines.append(f"--- sample {idx}: {status} | exit={code} | elapsed={elapsed}s ---")
+        if not ok:
+            if first_failure is None:
+                first_failure = {'sample': idx, 'input': _clip(data, 1500),
+                                 'expected_output': _clip(expected, 800),
+                                 'actual_output': _clip(out, 800)}
+            lines.append(f"input:\n{_clip(data)}")
+            lines.append(f"expected_output:\n{_clip(expected)}")
+            lines.append(f"actual stdout:\n{_clip(out)}")
+            lines.append(f"stderr:\n{_clip(err) if err else '(empty)'}")
+            if max_rel not in (0.0, float('inf')) or max_abs == float('inf'):
+                lines.append(f"max abs error: {max_abs}, max rel error: {max_rel}")
+
+    all_ok = bool(results) and all(results)
+    sha = file_sha256(solution_path)
+    append_record({
+        'tool': 'check_samples',
+        'solution_path': os.path.abspath(solution_path),
+        'solution_sha256': sha,
+        'samples_total': len(results),
+        'samples_passed': passed,
+        'samples_ok': all_ok,
+        'tolerance': tolerance,
+        'first_failure': first_failure,
+    })
+    header = f"samples passed: {passed}/{len(results)}" + ("  (ALL PASSED)" if all_ok else "")
+    return header + "\n" + "\n".join(lines)
