@@ -0,0 +1,259 @@
+import subprocess
+import json
+import os
+import signal
+import tempfile
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "run_method_tests",
+        "description": """Run differential tests between a solution and a brute-force reference for class Solution methods.
+Executes random test cases generated by a generator script, comparing outputs between the solution and brute-force reference.
+Each test is run with a timeout to detect TLE. Returns 'ALL PASSED' (with details) or the first failing case with both outputs and timing info.
+
+Generator contract:
+  The generator is invoked with no arguments. Each invocation should print one JSON array of positional arguments to stdout.
+  
+Harness contract:
+  The solution and brute-force files are each loaded in an isolated subprocess. The harness:
+  - Pre-injects `from typing import *` and common typing names so type hints work
+  - Imports the module with importlib
+  - Instantiates Solution()
+  - Calls the method with *args (unpacked from the JSON array)
+  - Prints repr() of the result and any exceptions""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file containing class Solution"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation with class Solution)"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to test (e.g., 'solve' or 'countSubsequences')"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the gen.py script; each invocation prints one JSON array of positional arguments"
+                },
+                "num_iterations": {
+                    "type": "integer",
+                    "description": "Number of random test cases to run (default: 200)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Optional: List of sample test cases, each with 'args' (array) and 'expected' keys"
+                }
+            },
+            "required": ["solution_path", "brute_path", "method_name", "generator_path"]
+        }
+    }
+
+
+def _run_method_in_harness(file_path, method_name, args, timeout_sec):
+    """
+    Run a method in an isolated harness subprocess.
+    Returns (success: bool, output: str, time_taken: float, exception: str or None)
+    """
+    import time
+    
+    # Build the harness script
+    harness_code = f'''
+import sys
+import importlib.util
+import time
+
+# Pre-inject typing names so type hints work
+from typing import *
+List = list
+Optional = type(None)
+
+# Load the module
+spec = importlib.util.spec_from_file_location("solution", {repr(str(file_path))})
+module = importlib.util.module_from_spec(spec)
+sys.modules['solution'] = module
+spec.loader.exec_module(module)
+
+# Instantiate and call
+try:
+    instance = module.Solution()
+    method = getattr(instance, {repr(method_name)})
+    args = {repr(args)}
+    start = time.time()
+    result = method(*args)
+    elapsed = time.time() - start
+    print(repr(result))
+    print(f"TIME:{{elapsed}}")
+except Exception as e:
+    import traceback
+    print(f"EXCEPTION:{{type(e).__name__}}: {{e}}")
+    print(f"TIME:{{0}}")
+    traceback.print_exc(file=sys.stderr)
+'''
+    
+    try:
+        start = time.time()
+        result = subprocess.run(
+            ["python3", "-c", harness_code],
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec
+        )
+        elapsed = time.time() - start
+        
+        output = result.stdout.strip()
+        stderr = result.stderr.strip()
+        
+        if result.returncode != 0 and not output.startswith("EXCEPTION:"):
+            return (False, output, elapsed, f"Non-zero exit code {result.returncode}. Stderr: {stderr}")
+        
+        return (True, output, elapsed, None)
+        
+    except subprocess.TimeoutExpired:
+        return (False, "", timeout_sec, f"Timeout exceeded {timeout_sec}s")
+    except Exception as e:
+        return (False, "", 0, str(e))
+
+
+def tool_function(
+    solution_path,
+    brute_path,
+    method_name,
+    generator_path,
+    num_iterations=200,
+    timeout_sec=5.0,
+    samples=None
+):
+    """
+    Run differential tests between solution and brute-force reference for class Solution methods.
+    
+    Args:
+        solution_path: Path to solution.py with class Solution
+        brute_path: Path to brute.py with class Solution
+        method_name: Name of method to test
+        generator_path: Path to gen.py (prints one JSON array per invocation)
+        num_iterations: Number of random tests (default 200)
+        timeout_sec: Timeout per test case (default 5.0)
+        samples: Optional list of dicts with 'args' (list) and 'expected' keys
+    
+    Returns:
+        String with test results: 'ALL PASSED' or first failure with args and both outputs
+    """
+    try:
+        solution_path = Path(solution_path)
+        brute_path = Path(brute_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths exist
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        # Run samples first if provided
+        if samples:
+            for sample_idx, sample in enumerate(samples):
+                if not isinstance(sample, dict) or 'args' not in sample or 'expected' not in sample:
+                    return f"Error: sample {sample_idx} must have 'args' (list) and 'expected' keys"
+                
+                args = sample['args']
+                expected = sample['expected']
+                
+                # Run solution
+                sol_success, sol_output, sol_time, sol_exception = _run_method_in_harness(
+                    solution_path, method_name, args, timeout_sec
+                )
+                
+                # Run brute
+                brute_success, brute_output, brute_time, brute_exception = _run_method_in_harness(
+                    brute_path, method_name, args, timeout_sec
+                )
+                
+                # Check if solution matches expected
+                if sol_success:
+                    # Extract the result line (before TIME:)
+                    sol_result = sol_output.split('\n')[0] if sol_output else ""
+                else:
+                    sol_result = sol_output
+                
+                expected_str = repr(expected)
+                
+                if sol_result != expected_str:
+                    return (
+                        f"Sample {sample_idx} FAILED:\n"
+                        f"Args: {args}\n"
+                        f"Expected: {expected_str}\n"
+                        f"Got: {sol_result}\n"
+                        f"Solution time: {sol_time:.3f}s"
+                    )
+        
+        # Run random differential tests
+        for test_num in range(num_iterations):
+            try:
+                # Generate test case
+                gen_result = subprocess.run(
+                    ["python3", str(generator_path)],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if gen_result.returncode != 0:
+                    return f"Error in test case generation: {gen_result.stderr}"
+                
+                args = json.loads(gen_result.stdout.strip())
+                
+                if not isinstance(args, list):
+                    return f"Generator error on test {test_num}: expected JSON array, got {type(args)}"
+                
+                # Run solution
+                sol_success, sol_output, sol_time, sol_exception = _run_method_in_harness(
+                    solution_path, method_name, args, timeout_sec
+                )
+                
+                # Run brute-force
+                brute_success, brute_output, brute_time, brute_exception = _run_method_in_harness(
+                    brute_path, method_name, args, timeout_sec
+                )
+                
+                # Extract results (first line before TIME: or EXCEPTION:)
+                sol_result = sol_output.split('\n')[0] if sol_output else ""
+                brute_result = brute_output.split('\n')[0] if brute_output else ""
+                
+                # Compare outputs
+                if sol_result != brute_result:
+                    return (
+                        f"Test {test_num} FAILED (output mismatch):\n"
+                        f"Args: {args}\n"
+                        f"Expected: {brute_result}\n"
+                        f"Got: {sol_result}\n"
+                        f"Solution time: {sol_time:.3f}s, Brute time: {brute_time:.3f}s"
+                    )
+            
+            except json.JSONDecodeError as e:
+                return f"Generator error on test {test_num}: invalid JSON - {str(e)}"
+            except Exception as e:
+                return f"Error during test {test_num}: {str(e)}"
+        
+        # All tests passed
+        return f"ALL PASSED: {num_iterations} random tests completed successfully"
+        
+    except Exception as e:
+        return f"Fatal error in run_method_tests: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
