+import subprocess
+import tempfile
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "explore_small",
+        "description": """Explore small test cases using a brute-force reference to discover patterns and structure.
+Runs the brute force on each provided input (or generates num_cases small inputs from a generator),
+returns a compact table 'input -> output' sorted by input size, including timing and error info.
+Purpose: let the agent discover patterns/recurrences from small cases and check candidate formulas.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation)"
+                },
+                "inputs": {
+                    "type": "array",
+                    "description": "List of input strings to test. If provided, these are used; otherwise generator_path and num_cases are used."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the gen.py file for generating small test cases (used if inputs not provided)"
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of test cases to generate (used if inputs not provided, default: 10)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                }
+            },
+            "required": ["brute_path"]
+        }
+    }
+
+
+def tool_function(brute_path, inputs=None, generator_path=None, num_cases=10, timeout_sec=5.0):
+    """
+    Explore small test cases using brute force to discover patterns.
+    
+    Args:
+        brute_path: Path to the brute.py file
+        inputs: Optional list of input strings to test
+        generator_path: Optional path to gen.py for generating test cases
+        num_cases: Number of cases to generate (if generator_path is used)
+        timeout_sec: Timeout per test in seconds
+    
+    Returns:
+        String with a compact table of 'input -> output', sorted by input size
+    """
+    try:
+        brute_path = Path(brute_path)
+        
+        # Validate path exists
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        
+        # Determine which inputs to test
+        test_inputs = []
+        if inputs:
+            # Use provided inputs
+            if not isinstance(inputs, list):
+                return f"Error: inputs must be a list of strings"
+            test_inputs = inputs
+        elif generator_path:
+            # Generate inputs
+            generator_path = Path(generator_path)
+            if not generator_path.exists():
+                return f"Error: generator_path {generator_path} does not exist"
+            
+            for _ in range(num_cases):
+                try:
+                    gen_result = subprocess.run(
+                        ["python3", str(generator_path)],
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec
+                    )
+                    if gen_result.returncode != 0:
+                        return f"Error in test case generation: {gen_result.stderr}"
+                    test_inputs.append(gen_result.stdout)
+                except subprocess.TimeoutExpired:
+                    return f"Error: generator timed out after {timeout_sec}s"
+                except Exception as e:
+                    return f"Error during test case generation: {str(e)}"
+        else:
+            return "Error: either inputs or generator_path must be provided"
+        
+        # Run brute force on each input
+        results = []
+        
+        for idx, test_input in enumerate(test_inputs):
+            if not isinstance(test_input, str):
+                results.append({
+                    'index': idx,
+                    'input_len': 0,
+                    'input_preview': f'ERROR: non-string input',
+                    'output': 'ERROR',
+                    'stderr': '',
+                    'timeout': False,
+                    'time_sec': 0
+                })
+                continue
+            
+            result_entry = {
+                'index': idx,
+                'input_len': len(test_input),
+                'input_preview': test_input if len(test_input) <= 80 else test_input[:80] + '...',
+                'output': '',
+                'stderr': '',
+                'timeout': False,
+                'time_sec': 0
+            }
+            
+            # Run brute-force
+            try:
+                import time
+                start_time = time.time()
+                brute_result = subprocess.run(
+                    ["python3", str(brute_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                elapsed = time.time() - start_time
+                result_entry['time_sec'] = elapsed
+                
+                if brute_result.returncode != 0:
+                    result_entry['output'] = f"EXIT {brute_result.returncode}"
+                    result_entry['stderr'] = brute_result.stderr.strip()
+                else:
+                    result_entry['output'] = brute_result.stdout.strip()
+                    if brute_result.stderr:
+                        result_entry['stderr'] = brute_result.stderr.strip()
+            
+            except subprocess.TimeoutExpired:
+                result_entry['output'] = 'TIMEOUT'
+                result_entry['timeout'] = True
+            except Exception as e:
+                result_entry['output'] = f"ERROR: {str(e)}"
+            
+            results.append(result_entry)
+        
+        # Sort by input length
+        results.sort(key=lambda x: x['input_len'])
+        
+        # Build output table
+        output_lines = []
+        output_lines.append("=" * 120)
+        output_lines.append("SMALL CASE EXPLORATION")
+        output_lines.append("=" * 120)
+        output_lines.append("")
+        
+        # Table of results
+        for result in results:
+            input_marker = "⏱ TIMEOUT" if result['timeout'] else ""
+            output_lines.append(f"[Case {result['index']}] Input size: {result['input_len']} {input_marker}")
+            
+            # Show input (truncated if needed)
+            output_lines.append(f"  Input: {repr(result['input_preview'])}")
+            
+            # Show output (truncated if needed)
+            output_str = result['output']
+            if len(output_str) > 200:
+                output_str = output_str[:200] + f"... (total {len(result['output'])} chars)"
+            output_lines.append(f"  Output: {repr(output_str)}")
+            
+            # Show timing
+            output_lines.append(f"  Time: {result['time_sec']:.3f}s")
+            
+            # Show stderr if present
+            if result['stderr']:
+                stderr_display = result['stderr']
+                if len(stderr_display) > 200:
+                    stderr_display = stderr_display[:200] + "..."
+                output_lines.append(f"  Stderr: {stderr_display}")
+            
+            output_lines.append("")
+        
+        output_lines.append("=" * 120)
+        output_lines.append("Analysis tips:")
+        output_lines.append("- Look for patterns in outputs across input sizes")
+        output_lines.append("- Check if outputs match expected formulas (e.g., O(n), O(n^2), Fibonacci, etc.)")
+        output_lines.append("- Identify edge cases and boundary conditions")
+        output_lines.append("=" * 120)
+        
+        return '\n'.join(output_lines)
+        
+    except Exception as e:
+        return f"Fatal error in explore_small: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
