index 0000000..6d05579
--- /dev/null
+++ b/tests/test_stress_test.py
@@ -0,0 +1,67 @@
+import pytest
+import tempfile
+from pathlib import Path
+from tools.stress_test import tool_function, tool_info
+
+class TestStressTestTool:
+    
+    def test_tool_info(self):
+        """Test that tool_info returns expected structure."""
+        info = tool_info()
+        assert info['name'] == 'stress_test'
+        assert 'input_schema' in info
+        assert 'properties' in info['input_schema']
+        
+    def test_input_schema_has_input_file(self):
+        """Test that input_file parameter is in the schema."""
+        info = tool_info()
+        properties = info['input_schema']['properties']
+        assert 'input_file' in properties
+        assert properties['input_file']['type'] == 'string'
+        
+    def test_input_file_is_optional(self):
+        """Test that input_file is not in required list."""
+        info = tool_info()
+        required = info['input_schema']['required']
+        assert 'input_file' not in required
+        # But the other fields should be required
+        assert 'solution_cmd' in required
+        assert 'reference_cmd' in required
+        assert 'generator_cmd' in required
+        assert 'num_tests' in required
+        assert 'timeout_sec' in required
+        
+    def test_required_fields_are_correct(self):
+        """Test that exactly the right fields are required."""
+        info = tool_info()
+        required = set(info['input_schema']['required'])
+        expected = {'solution_cmd', 'reference_cmd', 'generator_cmd', 'num_tests', 'timeout_sec'}
+        assert required == expected
+        
+    def test_input_file_timing(self):
+        """Test that input_file parameter skips generator and times solution."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            tmpdir = Path(tmpdir)
+            
+            # Create a test input file
+            input_file = tmpdir / "test_input.txt"
+            input_file.write_text("5\n")
+            
+            # Create a simple solution that reads a number and outputs it
+            solution_file = tmpdir / "solution.py"
+            solution_file.write_text("n = int(input())\nprint(n)\n")
+            
+            # Run with input_file parameter
+            result = tool_function(
+                solution_cmd=f"python {solution_file}",
+                reference_cmd=f"python {solution_file}",  # Unused when input_file given
+                generator_cmd="echo 'unused'",  # Unused when input_file given
+                num_tests=1,  # Unused when input_file given
+                timeout_sec=5,
+                input_file=str(input_file)
+            )
+            
+            # Should mention timing
+            assert "TIMING TEST PASS" in result or "SOLUTION TIMEOUT" in result or ".4f" in result or str(float) in str(type(float))
+            assert str(input_file) in result
+
