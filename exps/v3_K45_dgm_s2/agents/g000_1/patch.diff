+"""
+Stress test tool for validating competitive programming solutions.
+Compares a solution against a brute-force reference using generated inputs,
+and tests performance on large inputs.
+"""
+
+import subprocess
+import os
+import time
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress test a competitive programming solution against a brute-force reference and measure performance.
+
+- If brute_path and generator_path are provided: generates random inputs using the generator (seeds 0..num_tests-1) and compares solution output against brute-force output using a checker_path if provided for problems with multiple valid answers. Returns the first mismatching seed, input, and both outputs.
+- If large_input_path is provided: runs the solution with a time limit, reports wall time, peak memory, and any timeout/crash stderr.
+- Returns raw output strings without parsing error messages.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution script (run with python3)"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference script (run with python3)"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the test case generator script (takes seed argument and prints random input)"
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of test cases to generate (seeds 0..num_tests-1)"
+                },
+                "time_limit_sec": {
+                    "type": "number",
+                    "description": "Time limit for solution execution in seconds"
+                },
+                "large_input_path": {
+                    "type": "string",
+                    "description": "Path to a large input file for timing/memory testing"
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Path to a checker script that validates output (optional, for problems with multiple valid answers). Takes input file and output file as arguments, prints OK or error reason."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def run_program_with_input(program_path, input_text, time_limit_sec=10):
+    """
+    Run a program with given input and return (stdout, stderr, returncode, wall_time, peak_memory).
+    
+    peak_memory is in MB, or None if not available.
+    """
+    start_time = time.time()
+    peak_memory = None
+    
+    try:
+        process = subprocess.Popen(
+            ['python3', program_path],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True
+        )
+        
+        try:
+            stdout, stderr = process.communicate(input=input_text, timeout=time_limit_sec)
+            returncode = process.returncode
+        except subprocess.TimeoutExpired:
+            process.kill()
+            stdout, stderr = process.communicate()
+            returncode = -1  # Indicate timeout
+            stderr = (stderr or "") + "\nTimeout exceeded"
+        
+        wall_time = time.time() - start_time
+        
+        # Try to get peak memory from /proc if available
+        try:
+            if process.pid:
+                with open(f'/proc/{process.pid}/status', 'r') as f:
+                    for line in f:
+                        if line.startswith('VmPeak:'):
+                            peak_memory = int(line.split()[1]) / 1024.0  # Convert KB to MB
+                            break
+        except (FileNotFoundError, OSError, ValueError):
+            pass
+        
+        return stdout, stderr, returncode, wall_time, peak_memory
+    except Exception as e:
+        return "", str(e), -1, time.time() - start_time, None
+
+
+def tool_function(
+    solution_path,
+    brute_path=None,
+    generator_path=None,
+    num_tests=10,
+    time_limit_sec=10,
+    large_input_path=None,
+    checker_path=None
+):
+    """
+    Main stress test function.
+    """
+    result = []
+    
+    # Validate that solution_path exists
+    if not os.path.exists(solution_path):
+        return f"Error: solution_path {solution_path} does not exist"
+    
+    # Phase 1: Brute-force comparison if brute_path and generator_path are provided
+    if brute_path and generator_path:
+        if not os.path.exists(brute_path):
+            return f"Error: brute_path {brute_path} does not exist"
+        if not os.path.exists(generator_path):
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        result.append("=== Brute-Force Comparison ===")
+        
+        for seed in range(num_tests):
+            # Generate input
+            gen_stdout, gen_stderr, gen_returncode, _, _ = run_program_with_input(
+                generator_path, str(seed), time_limit_sec=5
+            )
+            
+            if gen_returncode != 0:
+                result.append(f"Seed {seed}: Generator failed with return code {gen_returncode}")
+                result.append(f"Stderr: {gen_stderr}")
+                return "\n".join(result)
+            
+            test_input = gen_stdout
+            
+            # Run brute-force
+            brute_stdout, brute_stderr, brute_returncode, _, _ = run_program_with_input(
+                brute_path, test_input, time_limit_sec=time_limit_sec
+            )
+            
+            if brute_returncode != 0:
+                result.append(f"Seed {seed}: Brute-force failed with return code {brute_returncode}")
+                result.append(f"Stderr: {brute_stderr}")
+                return "\n".join(result)
+            
+            # Run solution
+            sol_stdout, sol_stderr, sol_returncode, _, _ = run_program_with_input(
+                solution_path, test_input, time_limit_sec=time_limit_sec
+            )
+            
+            if sol_returncode != 0:
+                result.append(f"Seed {seed}: Solution failed with return code {sol_returncode}")
+                result.append(f"Stderr: {sol_stderr}")
+                return "\n".join(result)
+            
+            # Compare outputs
+            if checker_path:
+                # Use checker script to validate
+                if not os.path.exists(checker_path):
+                    return f"Error: checker_path {checker_path} does not exist"
+                
+                # Write output to temp file
+                import tempfile
+                with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f:
+                    f.write(sol_stdout)
+                    output_file = f.name
+                
+                with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f:
+                    f.write(test_input)
+                    input_file = f.name
+                
+                try:
+                    check_result = subprocess.run(
+                        ['python3', checker_path, input_file, output_file],
+                        capture_output=True,
+                        text=True,
+                        timeout=5
+                    )
+                    if "OK" not in check_result.stdout:
+                        result.append(f"Seed {seed}: Checker failed")
+                        result.append(f"Input:\n{test_input}")
+                        result.append(f"Output:\n{sol_stdout}")
+                        result.append(f"Checker output:\n{check_result.stdout}")
+                        return "\n".join(result)
+                finally:
+                    os.unlink(output_file)
+                    os.unlink(input_file)
+            else:
+                # Direct string comparison
+                brute_output = brute_stdout.strip()
+                sol_output = sol_stdout.strip()
+                
+                if brute_output != sol_output:
+                    result.append(f"Seed {seed}: Outputs differ")
+                    result.append(f"Input:\n{test_input}")
+                    result.append(f"Brute-force output:\n{brute_output}")
+                    result.append(f"Solution output:\n{sol_output}")
+                    return "\n".join(result)
+        
+        result.append(f"All {num_tests} tests passed!")
+    
+    # Phase 2: Large input performance test
+    if large_input_path:
+        if not os.path.exists(large_input_path):
+            return f"Error: large_input_path {large_input_path} does not exist"
+        
+        result.append("\n=== Large Input Performance Test ===")
+        
+        with open(large_input_path, 'r') as f:
+            large_input = f.read()
+        
+        stdout, stderr, returncode, wall_time, peak_memory = run_program_with_input(
+            solution_path, large_input, time_limit_sec=time_limit_sec
+        )
+        
+        result.append(f"Wall time: {wall_time:.3f} seconds")
+        if peak_memory is not None:
+            result.append(f"Peak memory: {peak_memory:.1f} MB")
+        else:
+            result.append("Peak memory: Not available")
+        
+        if returncode != 0:
+            result.append(f"Return code: {returncode}")
+            if stderr:
+                result.append(f"Stderr:\n{stderr}")
+        else:
+            result.append("Return code: 0 (success)")
+        
+        result.append(f"Output (first 500 chars):\n{stdout[:500]}")
+    
+    return "\n".join(result)
+
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    
+    if len(sys.argv) > 1:
+        solution_path = sys.argv[1]
+        brute_path = sys.argv[2] if len(sys.argv) > 2 else None
+        generator_path = sys.argv[3] if len(sys.argv) > 3 else None
+        num_tests = int(sys.argv[4]) if len(sys.argv) > 4 else 10
+        time_limit_sec = float(sys.argv[5]) if len(sys.argv) > 5 else 10
+        large_input_path = sys.argv[6] if len(sys.argv) > 6 else None
+        checker_path = sys.argv[7] if len(sys.argv) > 7 else None
+        
+        result = tool_function(
+            solution_path=solution_path,
+            brute_path=brute_path,
+            generator_path=generator_path,
+            num_tests=num_tests,
+            time_limit_sec=time_limit_sec,
+            large_input_path=large_input_path,
+            checker_path=checker_path
+        )
+        print(result)
+    else:
+        print("Usage: python stress_test.py <solution_path> [brute_path] [generator_path] [num_tests] [time_limit_sec] [large_input_path] [checker_path]")
