+#!/usr/bin/env python3
+"""Test script to verify the implementation of stress_test tool and coding_agent updates."""
+
+import sys
+sys.path.insert(0, '/dgm')
+
+def test_stress_test_tool():
+    """Test 1: Verify stress_test tool loads"""
+    from tools.stress_test import tool_info, tool_function
+    print("✓ stress_test tool imports successfully")
+    
+    # Test 2: Verify tool_info has correct structure
+    info = tool_info()
+    assert info['name'] == 'stress_test'
+    assert 'description' in info
+    assert 'input_schema' in info
+    print("✓ stress_test tool_info has correct structure")
+    
+    # Test 3: Verify schema structure
+    schema = info['input_schema']
+    assert schema['type'] == 'object'
+    assert 'properties' in schema
+    assert 'required' in schema
+    assert 'solution_path' in schema['required']
+    print("✓ stress_test input_schema has correct structure")
+    
+    # Test 4: Verify all properties have type and description
+    for prop_name, prop_info in schema['properties'].items():
+        assert 'type' in prop_info, f"{prop_name} missing 'type'"
+        assert 'description' in prop_info, f"{prop_name} missing 'description'"
+    print("✓ All properties have type and description")
+    
+    # Test 5: Verify tool_function is callable
+    assert callable(tool_function)
+    print("✓ tool_function is callable")
+
+def test_coding_agent_source():
+    """Test 6: Verify coding_agent has proper workflow (source code check)"""
+    import inspect
+    
+    # Read the source file directly to avoid import issues
+    with open('/dgm/coding_agent.py', 'r') as f:
+        forward_source = f.read()
+    
+    assert 'class AgenticSystem' in forward_source
+    assert 'def forward(self)' in forward_source
+    assert 'Constraint Analysis' in forward_source
+    assert 'Implementation Setup' in forward_source
+    assert 'Validation via Stress Testing' in forward_source
+    assert 'Performance Validation' in forward_source
+    assert 'while True' not in forward_source
+    print("✓ forward() method has correct workflow and no while True loops")
+
+def test_load_all_tools():
+    """Test 7: Verify tool loads via load_all_tools"""
+    from tools import load_all_tools
+    tools = load_all_tools()
+    tool_names = [t['info']['name'] for t in tools]
+    assert 'stress_test' in tool_names
+    print("✓ stress_test loads via load_all_tools")
+    
+    # Verify schema validity for Claude compatibility
+    stress_test_tool = next(t for t in tools if t['info']['name'] == 'stress_test')
+    schema = stress_test_tool['info']['input_schema']
+    
+    # Check that 'required' and 'type' are at the correct nesting level
+    assert 'type' in schema, "'type' should be at schema level"
+    assert 'properties' in schema, "'properties' should be at schema level"
+    assert 'required' in schema, "'required' should be at schema level"
+    
+    # Check that each property has both type and description
+    for prop_name, prop_def in schema['properties'].items():
+        assert 'type' in prop_def, f"Property '{prop_name}' missing 'type'"
+        assert 'description' in prop_def, f"Property '{prop_name}' missing 'description'"
+    
+    print("✓ stress_test schema is valid for Claude tool use")
+
+if __name__ == '__main__':
+    try:
+        test_stress_test_tool()
+        print()
+        test_coding_agent_source()
+        print()
+        test_load_all_tools()
+        print()
+        print("✓✓✓ All validation tests passed! ✓✓✓")
+    except Exception as e:
+        print(f"✗ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
