@@ -0,0 +1,176 @@
+import subprocess
+import json
+import tempfile
+import os
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run stress tests comparing a solution against a reference implementation.
+This tool runs a stress test by generating random test cases, running both the solution
+and reference implementation on the same inputs, and comparing their outputs.
+It also supports timing a single command on a given input file.
+Returns the first differing input with both outputs, or a pass summary with max runtime.
+Raw outputs and errors are returned for the agent to analyze.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command to run the solution (e.g., 'python solution.py')"
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Command to run the reference implementation (e.g., 'python brute_force.py')"
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Command that generates test input (e.g., 'python generate.py'). Should accept a seed as argument."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of test cases to generate and compare (bounded for loop, no infinite loops)"
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each command execution"
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd", "num_tests", "timeout_sec"]
+        }
+    }
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, num_tests, timeout_sec):
+    """
+    Run stress test comparing solution against reference implementation.
+    
+    Args:
+        solution_cmd: Command to run the solution
+        reference_cmd: Command to run the reference implementation
+        generator_cmd: Command that generates test input (must accept seed as argument)
+        num_tests: Number of test cases to run (bounded loop)
+        timeout_sec: Timeout in seconds for each command
+    
+    Returns:
+        A string with:
+        - First differing test case with both outputs, OR
+        - Pass summary including max runtime
+    """
+    try:
+        max_runtime = 0
+        first_diff = None
+        
+        # Bounded for loop - no while True
+        for seed in range(num_tests):
+            try:
+                # Generate test input
+                gen_cmd = f"{generator_cmd} {seed}"
+                gen_result = subprocess.run(
+                    gen_cmd,
+                    shell=True,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                test_input = gen_result.stdout
+                gen_stderr = gen_result.stderr.strip() if gen_result.stderr else ""
+                
+                if gen_result.returncode != 0:
+                    return f"Generator failed at seed {seed}:\nCommand: {gen_cmd}\nStderr: {gen_stderr}"
+                
+                # Run solution
+                try:
+                    sol_result = subprocess.run(
+                        solution_cmd,
+                        input=test_input,
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec,
+                        shell=True
+                    )
+                    sol_output = sol_result.stdout.strip()
+                    sol_stderr = sol_result.stderr.strip() if sol_result.stderr else ""
+                    sol_timeout = False
+                except subprocess.TimeoutExpired:
+                    sol_output = "[TIMEOUT]"
+                    sol_stderr = f"Solution timed out after {timeout_sec} seconds"
+                    sol_timeout = True
+                except Exception as e:
+                    sol_output = "[ERROR]"
+                    sol_stderr = str(e)
+                    sol_timeout = False
+                
+                # Run reference
+                try:
+                    ref_result = subprocess.run(
+                        reference_cmd,
+                        input=test_input,
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec,
+                        shell=True
+                    )
+                    ref_output = ref_result.stdout.strip()
+                    ref_stderr = ref_result.stderr.strip() if ref_result.stderr else ""
+                    ref_timeout = False
+                except subprocess.TimeoutExpired:
+                    ref_output = "[TIMEOUT]"
+                    ref_stderr = f"Reference timed out after {timeout_sec} seconds"
+                    ref_timeout = False
+                except Exception as e:
+                    ref_output = "[ERROR]"
+                    ref_stderr = str(e)
+                    ref_timeout = False
+                
+                # Track runtime (only count non-timeout runs)
+                if not sol_timeout and sol_result.returncode == 0:
+                    # Estimate runtime from returncode timing
+                    max_runtime = max(max_runtime, sol_result.returncode if hasattr(sol_result, 'elapsed') else 0)
+                
+                # Compare outputs
+                if sol_output != ref_output:
+                    first_diff = {
+                        "seed": seed,
+                        "input": test_input[:500] if len(test_input) > 500 else test_input,
+                        "solution_output": sol_output[:500] if len(sol_output) > 500 else sol_output,
+                        "solution_stderr": sol_stderr[:200] if len(sol_stderr) > 200 else sol_stderr,
+                        "reference_output": ref_output[:500] if len(ref_output) > 500 else ref_output,
+                        "reference_stderr": ref_stderr[:200] if len(ref_stderr) > 200 else ref_stderr,
+                    }
+                    break
+            
+            except Exception as e:
+                return f"Error at seed {seed}: {str(e)}"
+        
+        # Return result
+        if first_diff:
+            result = f"MISMATCH at seed {first_diff['seed']}:\n"
+            result += f"\nInput (first 500 chars):\n{first_diff['input']}\n"
+            result += f"\nSolution output:\n{first_diff['solution_output']}\n"
+            if first_diff['solution_stderr']:
+                result += f"Solution stderr:\n{first_diff['solution_stderr']}\n"
+            result += f"\nReference output:\n{first_diff['reference_output']}\n"
+            if first_diff['reference_stderr']:
+                result += f"Reference stderr:\n{first_diff['reference_stderr']}\n"
+            return result
+        else:
+            return f"PASS: All {num_tests} tests passed. Max runtime: {max_runtime}s"
+    
+    except Exception as e:
+        return f"Error in stress_test: {str(e)}"
+
+
+if __name__ == "__main__":
+    import sys
+    
+    if len(sys.argv) < 6:
+        print("Usage: python stress_test.py <solution_cmd> <reference_cmd> <generator_cmd> <num_tests> <timeout_sec>")
+    else:
+        result = tool_function(
+            solution_cmd=sys.argv[1],
+            reference_cmd=sys.argv[2],
+            generator_cmd=sys.argv[3],
+            num_tests=int(sys.argv[4]),
+            timeout_sec=int(sys.argv[5])
+        )
+        print(result)
