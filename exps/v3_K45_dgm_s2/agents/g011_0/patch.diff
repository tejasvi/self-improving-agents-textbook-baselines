+"""
+Stress testing tool for class-method based tasks.
+
+This tool runs differential testing on class methods by:
+1. Loading solution and brute-force implementations
+2. Generating test cases with deterministic seeds for reproducibility
+3. Comparing outputs on deep-copied arguments
+4. Reporting failures with the smallest failing input
+"""
+
+import subprocess
+import tempfile
+import os
+import json
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "stress_method",
+        "description": """Run differential stress tests on class-method implementations.
+For class-based tasks (e.g., Solution.minDamage(...)), loads both solution and brute-force modules,
+generates random test arguments using a generator function, and compares method outputs.
+Uses deterministic seeds for reproducibility, deep-copies arguments to protect against mutation.
+Returns 'ALL PASSED (N iterations)' or the failing case with expected vs actual outputs.
+Auto-detects the method if method_name is omitted.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file containing the Solution class"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file with the reference implementation"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator file that exports a gen() function returning list of method arguments"
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the class to instantiate (default: Solution)"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to test. If omitted, auto-detects the single public method"
+                },
+                "num_iterations": {
+                    "type": "integer",
+                    "description": "Number of test iterations with different seeds (default: 200)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the entire stress test (default: 60.0)"
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def tool_function(
+    solution_path,
+    brute_path,
+    generator_path,
+    class_name="Solution",
+    method_name=None,
+    num_iterations=200,
+    timeout_sec=60.0
+):
+    """
+    Run differential stress tests on class methods.
+    
+    Returns:
+        String with 'ALL PASSED (N iterations)' or failure details with:
+        - Arguments that failed (smallest by repr length)
+        - Expected output from brute force
+        - Actual output from solution
+        - Exception details if any
+    """
+    try:
+        solution_path = Path(solution_path)
+        brute_path = Path(brute_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths exist
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        # Create a temporary driver script for subprocess isolation
+        driver_code = _create_driver_script(
+            solution_path, brute_path, generator_path,
+            class_name, method_name, num_iterations
+        )
+        
+        # Write driver to temp file and run in subprocess with timeout
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+            f.write(driver_code)
+            driver_path = f.name
+        
+        try:
+            result = subprocess.run(
+                ["python3", driver_path],
+                capture_output=True,
+                text=True,
+                timeout=timeout_sec
+            )
+            
+            output = result.stdout.strip()
+            
+            if result.returncode != 0:
+                # Check if it's a JSON error or exception
+                if output:
+                    try:
+                        error_obj = json.loads(output)
+                        if error_obj.get("status") == "error":
+                            return f"Driver error: {error_obj.get('message', 'Unknown error')}"
+                    except:
+                        pass
+                stderr = result.stderr.strip()
+                if stderr:
+                    return f"Driver execution failed:\n{stderr}\nStdout:\n{output}"
+                return f"Driver execution failed with no output"
+            
+            # Parse results
+            if not output:
+                return "Driver produced no output"
+            
+            # Try to parse as JSON for failure details
+            try:
+                result_obj = json.loads(output)
+                if result_obj.get("status") == "all_passed":
+                    return f"ALL PASSED ({result_obj.get('iterations', num_iterations)} iterations)"
+                elif result_obj.get("status") == "failed":
+                    args_repr = result_obj.get("args_repr", "")
+                    expected = result_obj.get("expected", "")
+                    actual = result_obj.get("actual", "")
+                    error = result_obj.get("error", "")
+                    iteration = result_obj.get("iteration", "?")
+                    
+                    msg = f"Test failed at iteration {iteration}:\n"
+                    msg += f"Arguments: {args_repr}\n"
+                    if error:
+                        msg += f"Exception: {error}\n"
+                    else:
+                        msg += f"Expected: {expected}\n"
+                        msg += f"Got: {actual}\n"
+                    return msg
+            except json.JSONDecodeError:
+                pass
+            
+            # If output doesn't parse as JSON, return it as-is
+            return output
+        
+        finally:
+            # Clean up temp file
+            try:
+                os.unlink(driver_path)
+            except:
+                pass
+    
+    except subprocess.TimeoutExpired:
+        return f"Stress test timed out after {timeout_sec}s (infinite loop or very slow)"
+    except Exception as e:
+        return f"Fatal error in stress_method: {str(e)}"
+
+
+def _create_driver_script(solution_path, brute_path, generator_path, class_name, method_name, num_iterations):
+    """Create a driver script that will be run in a subprocess."""
+    
+    script = f'''
+import sys
+import json
+import copy
+import random
+import importlib.util
+
+# Add paths to sys.path
+sys.path.insert(0, str({repr(str(solution_path.parent))}))
+sys.path.insert(0, str({repr(str(brute_path.parent))}))
+sys.path.insert(0, str({repr(str(generator_path.parent))}))
+
+def load_module(path):
+    """Load a Python module from a file path."""
+    spec = importlib.util.spec_from_file_location("module", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+try:
+    # Load modules
+    solution_module = load_module({repr(str(solution_path))})
+    brute_module = load_module({repr(str(brute_path))})
+    generator_module = load_module({repr(str(generator_path))})
+    
+    # Get the class/function references
+    if hasattr(solution_module, {repr(class_name)}):
+        solution_class = getattr(solution_module, {repr(class_name)})
+    else:
+        print(json.dumps({{"status": "error", "message": "Solution class {{}} not found".format({repr(class_name)})}}))
+        sys.exit(1)
+    
+    if hasattr(brute_module, {repr(class_name)}):
+        brute_class = getattr(brute_module, {repr(class_name)})
+    else:
+        print(json.dumps({{"status": "error", "message": "Brute class {{}} not found".format({repr(class_name)})}}))
+        sys.exit(1)
+    
+    if not hasattr(generator_module, 'gen'):
+        print(json.dumps({{"status": "error", "message": "Generator module does not have gen() function"}}))
+        sys.exit(1)
+    
+    gen_func = generator_module.gen
+    
+    # Detect method name if not provided
+    method_name_to_use = {repr(method_name)}
+    if not method_name_to_use:
+        # Find the single public method
+        methods = [m for m in dir(solution_class) if not m.startswith('_')]
+        if len(methods) == 1:
+            method_name_to_use = methods[0]
+        elif len(methods) > 1:
+            # Filter to likely test methods (not __init__ or builtins)
+            public_methods = [m for m in methods if not m.startswith('_')]
+            if public_methods:
+                method_name_to_use = public_methods[0]
+    
+    if not method_name_to_use:
+        print(json.dumps({{"status": "error", "message": "Could not auto-detect method name"}}))
+        sys.exit(1)
+    
+    # Run tests with deterministic seeds
+    failures = []
+    for iteration in range({num_iterations}):
+        try:
+            # Use deterministic seed for reproducibility
+            random.seed(iteration)
+            
+            # Generate arguments
+            args = gen_func()
+            if not isinstance(args, (list, tuple)):
+                print(json.dumps({{"status": "error", "message": "gen() must return a list or tuple"}}))
+                sys.exit(1)
+            
+            # Deep copy for each call to protect against mutation
+            args_solution = copy.deepcopy(args)
+            args_brute = copy.deepcopy(args)
+            
+            # Get method and run on both
+            solution_instance = solution_class()
+            brute_instance = brute_class()
+            
+            solution_method = getattr(solution_instance, method_name_to_use)
+            brute_method = getattr(brute_instance, method_name_to_use)
+            
+            # Call methods
+            try:
+                brute_result = brute_method(*args_brute)
+            except Exception as e:
+                print(json.dumps({{"status": "error", "message": "Brute force threw exception: {{}}".format(str(e))}}))
+                sys.exit(1)
+            
+            try:
+                solution_result = solution_method(*args_solution)
+            except Exception as e:
+                failures.append({{
+                    "iteration": iteration,
+                    "args": args,
+                    "args_repr": repr(args),
+                    "expected": str(brute_result),
+                    "actual": None,
+                    "error": str(e)
+                }})
+                continue
+            
+            # Compare results
+            if solution_result != brute_result:
+                failures.append({{
+                    "iteration": iteration,
+                    "args": args,
+                    "args_repr": repr(args),
+                    "expected": str(brute_result),
+                    "actual": str(solution_result),
+                    "error": None
+                }})
+        except Exception as e:
+            failures.append({{
+                "iteration": iteration,
+                "args": None,
+                "args_repr": "error during gen()",
+                "expected": None,
+                "actual": None,
+                "error": str(e)
+            }})
+    
+    # Report results
+    if not failures:
+        print(json.dumps({{"status": "all_passed", "iterations": {num_iterations}}}))
+    else:
+        # Find the failure with smallest args repr
+        best_failure = min(failures, key=lambda f: len(f.get("args_repr", "")))
+        print(json.dumps({{
+            "status": "failed",
+            "iteration": best_failure.get("iteration"),
+            "args_repr": best_failure.get("args_repr"),
+            "expected": best_failure.get("expected"),
+            "actual": best_failure.get("actual"),
+            "error": best_failure.get("error")
+        }}))
+        sys.exit(1)
+
+except Exception as e:
+    print(json.dumps({{"status": "error", "message": str(e)}}))
+    sys.exit(1)
+'''
+    
+    return script
