+import subprocess
+import tempfile
+import json
+import os
+import time
+import sys
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run differential stress tests between a solution and a brute-force reference.
+Tests with multiple random seeds and modes (tiny/random/edge/max), comparing outputs and measuring timing.
+For max mode, reports solution wall time and flags TLE. Supports both stdin-based and class-based (LeetCode-style) tasks.
+Returns the first failing input with expected/actual outputs and timings, or success message with max-size timing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file to test"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation)"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the gen.py file (test case generator)"
+                },
+                "num_seeds": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default: 10)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                },
+                "modes": {
+                    "type": "string",
+                    "description": "Comma-separated list of modes: tiny,random,edge,max (default: 'tiny,random,edge,max')"
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to checker.py for custom output validation"
+                },
+                "entry_mode": {
+                    "type": "string",
+                    "description": "Entry point type: 'stdin' for standard input/output, 'class' for LeetCode-style Solution class (default: 'stdin')"
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the Solution class (required if entry_mode is 'class')"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on the Solution class (required if entry_mode is 'class')"
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _run_stdin_solution(solution_path, test_input, timeout_sec):
+    """Run solution that reads from stdin."""
+    start_time = time.time()
+    result = subprocess.run(
+        ["python3", str(solution_path)],
+        input=test_input,
+        capture_output=True,
+        text=True,
+        timeout=timeout_sec
+    )
+    elapsed = time.time() - start_time
+    return result, elapsed
+
+
+def _run_class_solution(solution_path, test_input, class_name, method_name, timeout_sec):
+    """Run class-based solution with JSON input parsing."""
+    # Create a temporary harness script
+    with tempfile.TemporaryDirectory() as tmpdir:
+        harness_path = Path(tmpdir) / "harness.py"
+        
+        # Read the solution module
+        solution_module = Path(solution_path).read_text()
+        
+        # Create harness script
+        harness_code = f"""
+import json
+import sys
+
+# Import the solution module
+import importlib.util
+spec = importlib.util.spec_from_file_location("solution", "{solution_path}")
+solution_mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(solution_mod)
+
+# Get the class and instantiate
+SolutionClass = getattr(solution_mod, "{class_name}")
+solver = SolutionClass()
+method = getattr(solver, "{method_name}")
+
+# Read input
+test_input = sys.stdin.read().strip()
+if test_input:
+    try:
+        # Try to parse as JSON array
+        args = json.loads(test_input)
+        if isinstance(args, list):
+            result = method(*args)
+        else:
+            result = method(args)
+    except json.JSONDecodeError:
+        # If not JSON, try raw string
+        result = method(test_input)
+else:
+    result = method()
+
+# Output result
+print(json.dumps(result) if not isinstance(result, (str, int, float, bool, type(None))) else result)
+"""
+        harness_path.write_text(harness_code)
+        
+        start_time = time.time()
+        result = subprocess.run(
+            ["python3", str(harness_path)],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec
+        )
+        elapsed = time.time() - start_time
+        return result, elapsed
+
+
+def _generate_test(generator_path, seed, mode, timeout_sec):
+    """Generate a test case using gen.py with seed and mode."""
+    result = subprocess.run(
+        ["python3", str(generator_path), str(seed), mode],
+        capture_output=True,
+        text=True,
+        timeout=timeout_sec
+    )
+    if result.returncode != 0:
+        raise Exception(f"Generator failed: {result.stderr}")
+    return result.stdout
+
+
+def tool_function(
+    solution_path,
+    brute_path,
+    generator_path,
+    num_seeds=10,
+    timeout_sec=5.0,
+    modes="tiny,random,edge,max",
+    checker_path=None,
+    entry_mode="stdin",
+    class_name=None,
+    method_name=None
+):
+    """
+    Run differential stress tests.
+    
+    Returns plain-text report: either 'ALL PASSED' or failure details with expected/actual outputs and timing.
+    """
+    try:
+        solution_path = Path(solution_path)
+        brute_path = Path(brute_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        if checker_path and not Path(checker_path).exists():
+            return f"Error: checker_path {checker_path} does not exist"
+        
+        # Validate class mode
+        if entry_mode == "class":
+            if not class_name or not method_name:
+                return "Error: class_name and method_name required for entry_mode='class'"
+        
+        # Parse modes
+        mode_list = [m.strip() for m in modes.split(",")]
+        
+        # Track results
+        max_mode_time = None
+        
+        # Run tests for each mode and seed
+        for mode in mode_list:
+            if mode not in ["tiny", "random", "edge", "max"]:
+                return f"Error: unknown mode '{mode}'. Valid modes: tiny, random, edge, max"
+            
+            # For 'max' mode, run only once; for others, use num_seeds
+            num_test_runs = 1 if mode == "max" else num_seeds
+            
+            for seed in range(num_test_runs):
+                try:
+                    # Generate test
+                    test_input = _generate_test(generator_path, seed, mode, timeout_sec)
+                    
+                    # Run solution
+                    if entry_mode == "stdin":
+                        sol_result, sol_time = _run_stdin_solution(solution_path, test_input, timeout_sec)
+                    else:  # class
+                        sol_result, sol_time = _run_class_solution(
+                            solution_path, test_input, class_name, method_name, timeout_sec
+                        )
+                    
+                    if sol_result.returncode != 0:
+                        return (
+                            f"Solution failed on {mode} mode (seed {seed}):\n"
+                            f"Input:\n{test_input}\n"
+                            f"Error:\n{sol_result.stderr}"
+                        )
+                    
+                    sol_output = sol_result.stdout.strip()
+                    
+                    # Run brute-force
+                    brute_result, brute_time = _run_stdin_solution(brute_path, test_input, timeout_sec)
+                    
+                    if brute_result.returncode != 0:
+                        return (
+                            f"Brute-force failed on {mode} mode (seed {seed}):\n"
+                            f"Input:\n{test_input}\n"
+                            f"Error:\n{brute_result.stderr}"
+                        )
+                    
+                    brute_output = brute_result.stdout.strip()
+                    
+                    # Validate outputs
+                    if checker_path:
+                        check_result = subprocess.run(
+                            ["python3", str(checker_path)],
+                            input=f"{test_input}\n{sol_output}\n{brute_output}",
+                            capture_output=True,
+                            text=True,
+                            timeout=timeout_sec
+                        )
+                        if check_result.returncode != 0 or "FAIL" in check_result.stdout.upper():
+                            return (
+                                f"Test failed on {mode} mode (seed {seed}) - checker validation:\n"
+                                f"Input:\n{test_input}\n"
+                                f"Solution output:\n{sol_output}\n"
+                                f"Expected output:\n{brute_output}\n"
+                                f"Checker feedback:\n{check_result.stdout}\n"
+                                f"Solution time: {sol_time:.3f}s, Brute time: {brute_time:.3f}s"
+                            )
+                    else:
+                        if sol_output != brute_output:
+                            return (
+                                f"Test failed on {mode} mode (seed {seed}) - output mismatch:\n"
+                                f"Input:\n{test_input}\n"
+                                f"Expected output:\n{brute_output}\n"
+                                f"Got output:\n{sol_output}\n"
+                                f"Solution time: {sol_time:.3f}s, Brute time: {brute_time:.3f}s"
+                            )
+                    
+                    # For max mode, record timing (continue to complete all modes)
+                    if mode == "max":
+                        max_mode_time = sol_time
+                        if sol_time > timeout_sec:
+                            return (
+                                f"Max input test TIMED OUT (exceeded {timeout_sec}s):\n"
+                                f"Solution wall time: {sol_time:.3f}s\n"
+                                f"Input length: {len(test_input)} bytes"
+                            )
+                    
+                except subprocess.TimeoutExpired:
+                    return (
+                        f"Test TIMED OUT on {mode} mode (seed {seed}) - exceeded {timeout_sec}s:\n"
+                        f"Input (first 500 chars):\n{test_input[:500]}\n..."
+                    )
+                except Exception as e:
+                    return f"Error during test on {mode} mode (seed {seed}): {str(e)}"
+        
+        # All tests passed
+        if max_mode_time is not None:
+            return f"ALL PASSED. Max input test completed in {max_mode_time:.3f}s"
+        else:
+            return f"ALL PASSED ({num_seeds} seeds per mode tested)"
+        
+    except Exception as e:
+        return f"Fatal error in stress_test: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
