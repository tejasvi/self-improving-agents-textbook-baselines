@@ -0,0 +1,127 @@
+import subprocess
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "explore_small",
+        "description": """Run a brute-force script on multiple small test inputs to discover patterns.
+This tool generates N random inputs from a generator and runs the brute-force solution on each,
+collecting input-output pairs in compact form for pattern discovery.
+Use this to inspect the structure of solutions on small instances before deriving an efficient algorithm.
+
+Each test case is printed as:
+  INPUT: <compact representation>
+  OUTPUT: <output>
+
+This helps identify patterns like cycles, invariants, parity, or greedy structure.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation)"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the gen.py file (test case generator)"
+                },
+                "num_samples": {
+                    "type": "integer",
+                    "description": "Number of small test cases to generate and analyze (default: 10)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                }
+            },
+            "required": ["brute_path", "generator_path"]
+        }
+    }
+
+
+def tool_function(brute_path, generator_path, num_samples=10, timeout_sec=5.0):
+    """
+    Run a brute-force solution on multiple small test inputs and display patterns.
+    
+    Returns a string showing input-output pairs and any patterns discovered.
+    """
+    try:
+        brute_path = Path(brute_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths exist
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        results = []
+        results.append(f"Exploring {num_samples} small test cases:\n")
+        
+        for test_num in range(num_samples):
+            try:
+                # Generate test case
+                gen_result = subprocess.run(
+                    ["python3", str(generator_path)],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if gen_result.returncode != 0:
+                    return f"Error in test case generation at test {test_num}: {gen_result.stderr}"
+                
+                test_input = gen_result.stdout
+                
+                # Run brute-force
+                brute_result = subprocess.run(
+                    ["python3", str(brute_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if brute_result.returncode != 0:
+                    results.append(
+                        f"Test {test_num}: FAILED\n"
+                        f"  Input: {test_input.strip()}\n"
+                        f"  Error: {brute_result.stderr}\n"
+                    )
+                else:
+                    test_output = brute_result.stdout.strip()
+                    # Compact format: replace newlines with spaces for readability
+                    input_compact = ' '.join(test_input.strip().split())
+                    output_compact = ' '.join(test_output.split())
+                    results.append(
+                        f"Test {test_num}:\n"
+                        f"  INPUT:  {input_compact}\n"
+                        f"  OUTPUT: {output_compact}\n"
+                    )
+            
+            except subprocess.TimeoutExpired:
+                results.append(
+                    f"Test {test_num}: TIMEOUT (exceeded {timeout_sec}s)\n"
+                    f"  Input: {test_input.strip()}\n"
+                )
+            except Exception as e:
+                results.append(f"Test {test_num}: ERROR - {str(e)}\n")
+        
+        results.append("\n--- Pattern Analysis Instructions ---")
+        results.append("Look for:")
+        results.append("  1. Cycles or periodic patterns in outputs")
+        results.append("  2. Invariants (properties that always hold)")
+        results.append("  3. Parity or modular arithmetic patterns")
+        results.append("  4. Greedy structures (optimal choice per step)")
+        results.append("  5. Mathematical relationships (e.g., linear, quadratic)")
+        
+        return '\n'.join(results)
+        
+    except Exception as e:
+        return f"Fatal error in explore_small: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
