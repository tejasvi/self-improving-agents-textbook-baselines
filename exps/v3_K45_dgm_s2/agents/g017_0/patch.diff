+import subprocess
+import tempfile
+import os
+from pathlib import Path
+from collections import defaultdict
+
+
+def tool_info():
+    return {
+        "name": "analyze_cases",
+        "description": """Analyze output distribution and patterns from brute-force test cases.
+Runs brute.py over many generator-produced small inputs and returns aggregate statistics:
+- Distribution of distinct outputs (count of each output, fraction of -1/'impossible')
+- Min/max output values
+- Optional feature-based grouping using a user-supplied Python feature function
+This helps the agent quickly test hypotheses about problem structure.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation)"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the gen.py file for generating test cases"
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of test cases to generate and analyze"
+                },
+                "feature_path": {
+                    "type": "string",
+                    "description": "Optional path to a Python file defining feature(input_str) -> dict. If provided, outputs are grouped by feature values."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                }
+            },
+            "required": ["brute_path", "generator_path", "num_cases"]
+        }
+    }
+
+
+def tool_function(brute_path, generator_path, num_cases, feature_path=None, timeout_sec=5.0):
+    """
+    Analyze output distribution and patterns from brute-force test cases.
+    
+    Args:
+        brute_path: Path to the brute.py file
+        generator_path: Path to the gen.py file
+        num_cases: Number of test cases to generate
+        feature_path: Optional path to a Python file with feature(input_str) -> dict
+        timeout_sec: Timeout per test in seconds
+    
+    Returns:
+        String with aggregate statistics and optional feature-grouped table
+    """
+    try:
+        brute_path = Path(brute_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths exist
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        if feature_path and not Path(feature_path).exists():
+            return f"Error: feature_path {feature_path} does not exist"
+        
+        # Load feature function if provided
+        feature_func = None
+        if feature_path:
+            try:
+                import importlib.util
+                spec = importlib.util.spec_from_file_location("feature_module", feature_path)
+                feature_module = importlib.util.module_from_spec(spec)
+                spec.loader.exec_module(feature_module)
+                if hasattr(feature_module, 'feature'):
+                    feature_func = feature_module.feature
+                else:
+                    return f"Error: feature_path {feature_path} does not define feature(input_str) function"
+            except Exception as e:
+                return f"Error loading feature function: {str(e)}"
+        
+        # Collect outputs
+        output_counts = defaultdict(int)
+        outputs_list = []
+        outputs_by_feature = defaultdict(list)
+        errors = []
+        timeouts = 0
+        
+        for case_idx in range(num_cases):
+            try:
+                # Generate test case
+                env = os.environ.copy()
+                env['SEED'] = str(case_idx)
+                
+                gen_result = subprocess.run(
+                    ["python3", str(generator_path), str(case_idx)],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec,
+                    env=env
+                )
+                
+                if gen_result.returncode != 0:
+                    errors.append(f"Generator error at case {case_idx}: {gen_result.stderr[:100]}")
+                    continue
+                
+                test_input = gen_result.stdout
+                
+                # Run brute force
+                brute_result = subprocess.run(
+                    ["python3", str(brute_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if brute_result.returncode != 0:
+                    errors.append(f"Brute error at case {case_idx}: {brute_result.stderr[:100]}")
+                    continue
+                
+                output = brute_result.stdout.strip()
+                outputs_list.append((test_input, output))
+                output_counts[output] += 1
+                
+                # Apply feature function if provided
+                if feature_func:
+                    try:
+                        features = feature_func(test_input)
+                        if isinstance(features, dict):
+                            feature_key = tuple(sorted(features.items()))
+                        else:
+                            feature_key = str(features)
+                        outputs_by_feature[feature_key].append(output)
+                    except Exception as e:
+                        pass  # Skip this case for feature analysis
+            
+            except subprocess.TimeoutExpired:
+                timeouts += 1
+            except Exception as e:
+                errors.append(f"Error at case {case_idx}: {str(e)}")
+        
+        # Build output
+        output_lines = []
+        output_lines.append("=" * 100)
+        output_lines.append("CASE ANALYSIS SUMMARY")
+        output_lines.append("=" * 100)
+        output_lines.append("")
+        
+        # Basic statistics
+        successful_cases = len(outputs_list)
+        output_lines.append(f"Successful cases: {successful_cases} / {num_cases}")
+        if timeouts > 0:
+            output_lines.append(f"Timeouts: {timeouts}")
+        if errors:
+            output_lines.append(f"Errors: {len(errors)}")
+        output_lines.append("")
+        
+        # Output distribution
+        output_lines.append("OUTPUT DISTRIBUTION:")
+        output_lines.append("-" * 100)
+        
+        # Sort by count (descending) then by output value
+        sorted_outputs = sorted(output_counts.items(), key=lambda x: (-x[1], x[0]))
+        
+        # Special tracking for -1 and 'impossible'
+        count_minus1 = output_counts.get('-1', 0)
+        count_impossible = sum(output_counts[k] for k in output_counts if 'impossible' in k.lower())
+        
+        for output_val, count in sorted_outputs[:20]:  # Show top 20
+            percentage = (count / successful_cases) * 100 if successful_cases > 0 else 0
+            output_lines.append(f"  '{output_val}': {count} times ({percentage:.1f}%)")
+        
+        if len(sorted_outputs) > 20:
+            output_lines.append(f"  ... and {len(sorted_outputs) - 20} more distinct outputs")
+        
+        output_lines.append("")
+        output_lines.append(f"Total distinct outputs: {len(output_counts)}")
+        if count_minus1 > 0:
+            output_lines.append(f"Fraction of '-1': {count_minus1 / successful_cases * 100:.1f}%")
+        if count_impossible > 0:
+            output_lines.append(f"Fraction of 'impossible': {count_impossible / successful_cases * 100:.1f}%")
+        
+        if outputs_list:
+            # Try to get numeric outputs for min/max
+            numeric_outputs = []
+            for output_val, _ in output_counts.items():
+                try:
+                    numeric_outputs.append((int(output_val), output_val))
+                except ValueError:
+                    pass
+            
+            if numeric_outputs:
+                numeric_outputs.sort()
+                min_output = numeric_outputs[0][0]
+                max_output = numeric_outputs[-1][0]
+                output_lines.append(f"Min numeric output: {min_output}")
+                output_lines.append(f"Max numeric output: {max_output}")
+        
+        output_lines.append("")
+        
+        # Feature-based grouping if provided
+        if feature_func and outputs_by_feature:
+            output_lines.append("OUTPUT GROUPING BY FEATURES:")
+            output_lines.append("-" * 100)
+            
+            for feature_key, outputs in list(outputs_by_feature.items())[:10]:  # Show top 10 feature groups
+                feature_dict = dict(feature_key)
+                distinct_outputs = set(outputs)
+                output_lines.append(f"Feature {feature_dict}:")
+                output_lines.append(f"  Cases: {len(outputs)}")
+                output_lines.append(f"  Distinct outputs: {len(distinct_outputs)}")
+                output_lines.append(f"  Outputs: {', '.join(sorted(distinct_outputs)[:5])}")
+                if len(distinct_outputs) > 5:
+                    output_lines.append(f"    ... and {len(distinct_outputs) - 5} more")
+                output_lines.append("")
+        
+        output_lines.append("=" * 100)
+        
+        if errors:
+            output_lines.append("Errors encountered:")
+            for err in errors[:5]:
+                output_lines.append(f"  {err}")
+            if len(errors) > 5:
+                output_lines.append(f"  ... and {len(errors) - 5} more errors")
+        
+        return "\n".join(output_lines)
+    
+    except Exception as e:
+        return f"Fatal error in analyze_cases: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
