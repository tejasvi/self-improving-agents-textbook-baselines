@@ -0,0 +1,181 @@
+import subprocess
+import os
+import time
+
+def tool_info():
+    return {
+        "name": "perf_check",
+        "description": """Run performance check on a solution with a given input.
+Executes a solution command on either a pre-generated input file or the stdout of a generator command.
+Measures wall-clock time using time.perf_counter and tracks timeout/OK status.
+Returns elapsed time, status (TIMEOUT/OK), exit code, truncated stdout (first 300 chars), and stderr.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command to run the solution (e.g., 'python solution.py')"
+                },
+                "input_file": {
+                    "type": "string",
+                    "description": "Optional: path to a pre-generated input file"
+                },
+                "input_generator_cmd": {
+                    "type": "string",
+                    "description": "Optional: command that generates test input to stdout (e.g., 'python generate_max_input.py'). If neither input_file nor input_generator_cmd is provided, solution_cmd runs without input."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the solution execution"
+                },
+                "repeat": {
+                    "type": "integer",
+                    "description": "Number of times to repeat the execution (takes the max time). Defaults to 1."
+                }
+            },
+            "required": ["solution_cmd", "timeout_sec"]
+        }
+    }
+
+def tool_function(solution_cmd, timeout_sec, input_file=None, input_generator_cmd=None, repeat=1):
+    """
+    Run performance check on a solution.
+    
+    Args:
+        solution_cmd: Command to run the solution
+        timeout_sec: Timeout in seconds for each execution
+        input_file: Optional path to pre-generated input file
+        input_generator_cmd: Optional command that generates input to stdout
+        repeat: Number of times to run (takes max time). Defaults to 1.
+    
+    Returns:
+        A string with:
+        - Elapsed time (max if repeat > 1)
+        - Status (TIMEOUT or OK)
+        - Exit code
+        - Truncated stdout (first 300 chars)
+        - Truncated stderr (first 300 chars)
+    """
+    try:
+        # Determine input source
+        test_input = None
+        input_source = "no input"
+        
+        if input_file is not None:
+            if not os.path.exists(input_file):
+                return f"Error: Input file not found: {input_file}"
+            try:
+                with open(input_file, 'r') as f:
+                    test_input = f.read()
+                input_source = f"file {input_file}"
+            except Exception as e:
+                return f"Error reading input file: {str(e)}"
+        
+        elif input_generator_cmd is not None:
+            try:
+                gen_result = subprocess.run(
+                    input_generator_cmd,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec,
+                    shell=True
+                )
+                if gen_result.returncode != 0:
+                    return f"Error: Generator command failed:\nCommand: {input_generator_cmd}\nStderr: {gen_result.stderr}"
+                test_input = gen_result.stdout
+                input_source = f"generator: {input_generator_cmd}"
+            except subprocess.TimeoutExpired:
+                return f"Error: Generator command timed out after {timeout_sec} seconds"
+            except Exception as e:
+                return f"Error running generator: {str(e)}"
+        
+        # Run solution repeat times and track max runtime
+        max_elapsed = 0
+        total_result = None
+        timed_out = False
+        exit_code = None
+        sol_stdout = ""
+        sol_stderr = ""
+        
+        # Bounded for loop - no while True
+        for iteration in range(repeat):
+            try:
+                start_time = time.perf_counter()
+                sol_result = subprocess.run(
+                    solution_cmd,
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec,
+                    shell=True
+                )
+                elapsed_time = time.perf_counter() - start_time
+                
+                # Track the run with max elapsed time
+                if elapsed_time > max_elapsed:
+                    max_elapsed = elapsed_time
+                    exit_code = sol_result.returncode
+                    sol_stdout = sol_result.stdout
+                    sol_stderr = sol_result.stderr if sol_result.stderr else ""
+                    timed_out = False
+                
+            except subprocess.TimeoutExpired:
+                elapsed_time = timeout_sec
+                if elapsed_time > max_elapsed:
+                    max_elapsed = elapsed_time
+                    exit_code = -1
+                    sol_stdout = "[TIMEOUT]"
+                    sol_stderr = f"Solution timed out after {timeout_sec} seconds"
+                    timed_out = True
+            except Exception as e:
+                return f"Error running solution: {str(e)}"
+        
+        # Format result
+        status = "TIMEOUT" if timed_out else "OK"
+        stdout_trunc = sol_stdout[:300] if len(sol_stdout) > 300 else sol_stdout
+        stderr_trunc = sol_stderr[:300] if len(sol_stderr) > 300 else sol_stderr
+        
+        result = f"PERF_CHECK: Elapsed time: {max_elapsed:.4f}s ({status})\n"
+        result += f"Exit code: {exit_code}\n"
+        result += f"Input source: {input_source}\n"
+        result += f"Repeat count: {repeat}\n"
+        result += f"Output (first 300 chars):\n{stdout_trunc}\n"
+        if stderr_trunc:
+            result += f"Stderr (first 300 chars):\n{stderr_trunc}\n"
+        
+        return result
+    
+    except Exception as e:
+        return f"Unexpected error in perf_check: {str(e)}"
+
+if __name__ == "__main__":
+    import sys
+    
+    # Simple command-line interface for testing
+    if len(sys.argv) < 3:
+        print("Usage: python perf_check.py <solution_cmd> <timeout_sec> [--input_file FILE] [--input_generator_cmd CMD] [--repeat N]")
+        sys.exit(1)
+    
+    solution_cmd = sys.argv[1]
+    timeout_sec = int(sys.argv[2])
+    input_file = None
+    input_generator_cmd = None
+    repeat = 1
+    
+    # Parse optional arguments
+    for i in range(3, len(sys.argv), 2):
+        if sys.argv[i] == "--input_file" and i + 1 < len(sys.argv):
+            input_file = sys.argv[i + 1]
+        elif sys.argv[i] == "--input_generator_cmd" and i + 1 < len(sys.argv):
+            input_generator_cmd = sys.argv[i + 1]
+        elif sys.argv[i] == "--repeat" and i + 1 < len(sys.argv):
+            repeat = int(sys.argv[i + 1])
+    
+    result = tool_function(
+        solution_cmd=solution_cmd,
+        timeout_sec=timeout_sec,
+        input_file=input_file,
+        input_generator_cmd=input_generator_cmd,
+        repeat=repeat
+    )
+    print(result)
