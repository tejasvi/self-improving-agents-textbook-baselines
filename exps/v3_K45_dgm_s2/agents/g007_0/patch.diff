@@ -0,0 +1,137 @@
+import subprocess
+import tempfile
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "run_python",
+        "description": """Run Python code with optional stdin and capture output.
+Takes either inline code or a path to a Python file, runs it with optional stdin input,
+and returns stdout/stderr with timeout protection. Useful for debugging, running small scripts, 
+and executing code with captured output without bash subprocess issues.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "code": {
+                    "type": "string",
+                    "description": "Python code to execute (alternative to path)"
+                },
+                "path": {
+                    "type": "string",
+                    "description": "Path to a Python file to execute (alternative to code)"
+                },
+                "stdin": {
+                    "type": "string",
+                    "description": "Optional stdin input to pass to the program"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds (default: 10.0)"
+                }
+            },
+            "required": []
+        }
+    }
+
+
+def tool_function(code=None, path=None, stdin="", timeout_sec=10.0):
+    """
+    Run Python code or file with optional stdin.
+    
+    Args:
+        code: Python code string to execute
+        path: Path to a Python file to execute
+        stdin: String to pass as stdin
+        timeout_sec: Timeout in seconds
+    
+    Returns:
+        String with stdout and stderr, or error/timeout message
+    """
+    try:
+        if not code and not path:
+            return "Error: either 'code' or 'path' must be provided"
+        
+        if code and path:
+            return "Error: provide only one of 'code' or 'path', not both"
+        
+        # Prepare the command
+        if code:
+            # Write code to a temporary file
+            with tempfile.NamedTemporaryFile(
+                mode='w',
+                suffix='.py',
+                delete=False,
+                dir='/tmp'
+            ) as code_file:
+                code_file.write(code)
+                code_path = code_file.name
+            
+            try:
+                result = subprocess.run(
+                    ['python3', code_path],
+                    input=stdin,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+            finally:
+                # Clean up the temporary file
+                try:
+                    Path(code_path).unlink()
+                except OSError:
+                    pass
+        
+        else:
+            # Execute the provided file path
+            path_obj = Path(path)
+            if not path_obj.exists():
+                return f"Error: file {path} does not exist"
+            
+            result = subprocess.run(
+                ['python3', str(path_obj)],
+                input=stdin,
+                capture_output=True,
+                text=True,
+                timeout=timeout_sec
+            )
+        
+        # Build output
+        output_parts = []
+        
+        if result.stdout:
+            output_parts.append(result.stdout)
+        
+        if result.stderr:
+            output_parts.append(f"Stderr:\n{result.stderr}")
+        
+        # Include return code if non-zero
+        if result.returncode != 0:
+            output_parts.append(f"Exit code: {result.returncode}")
+        
+        return '\n'.join(output_parts).strip() if output_parts else "(no output)"
+    
+    except subprocess.TimeoutExpired as e:
+        # Return partial output on timeout
+        output_parts = []
+        
+        if e.stdout:
+            stdout_text = e.stdout.decode('utf-8', errors='ignore') if isinstance(e.stdout, bytes) else e.stdout
+            output_parts.append(stdout_text)
+        
+        if e.stderr:
+            stderr_text = e.stderr.decode('utf-8', errors='ignore') if isinstance(e.stderr, bytes) else e.stderr
+            output_parts.append(f"Stderr:\n{stderr_text}")
+        
+        timeout_msg = f"TIMEOUT (exceeded {timeout_sec}s)"
+        output_parts.append(timeout_msg)
+        
+        return '\n'.join(output_parts).strip() if output_parts else timeout_msg
+    
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
