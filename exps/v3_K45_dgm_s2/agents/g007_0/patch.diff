+import subprocess
+import tempfile
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "compare_outputs",
+        "description": """Run both solution and brute-force on specified inputs and return a compact comparison table.
+For each input, runs both programs and shows: input, brute output, solution output, MATCH/MISMATCH.
+Results are sorted by input length (smallest first) to highlight the minimal failing input.
+Includes stderr and timeout information.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file to test"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute.py file (reference implementation)"
+                },
+                "inputs": {
+                    "type": "array",
+                    "description": "List of input strings to test"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                }
+            },
+            "required": ["solution_path", "brute_path", "inputs"]
+        }
+    }
+
+
+def tool_function(solution_path, brute_path, inputs, timeout_sec=5.0):
+    """
+    Run solution and brute-force on each input and return a comparison table.
+    
+    Args:
+        solution_path: Path to the solution.py file
+        brute_path: Path to the brute.py file
+        inputs: List of input strings to test
+        timeout_sec: Timeout per test in seconds
+    
+    Returns:
+        String with comparison table, sorted by input length, flagging mismatches first
+    """
+    try:
+        solution_path = Path(solution_path)
+        brute_path = Path(brute_path)
+        
+        # Validate paths exist
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        if not brute_path.exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        
+        # Validate inputs format
+        if not isinstance(inputs, list):
+            return f"Error: inputs must be a list of strings"
+        
+        results = []
+        
+        for idx, test_input in enumerate(inputs):
+            if not isinstance(test_input, str):
+                results.append({
+                    'index': idx,
+                    'input': str(test_input),
+                    'input_len': len(str(test_input)),
+                    'brute_output': 'ERROR',
+                    'solution_output': f'Error: input {idx} is not a string',
+                    'match': False,
+                    'brute_stderr': '',
+                    'solution_stderr': '',
+                    'brute_timeout': False,
+                    'solution_timeout': False
+                })
+                continue
+            
+            result_entry = {
+                'index': idx,
+                'input': test_input,
+                'input_len': len(test_input),
+                'brute_output': '',
+                'solution_output': '',
+                'match': False,
+                'brute_stderr': '',
+                'solution_stderr': '',
+                'brute_timeout': False,
+                'solution_timeout': False
+            }
+            
+            # Run brute-force
+            try:
+                brute_result = subprocess.run(
+                    ["python3", str(brute_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if brute_result.returncode != 0:
+                    result_entry['brute_output'] = f"EXIT {brute_result.returncode}"
+                    result_entry['brute_stderr'] = brute_result.stderr.strip()
+                else:
+                    result_entry['brute_output'] = brute_result.stdout.strip()
+                    if brute_result.stderr:
+                        result_entry['brute_stderr'] = brute_result.stderr.strip()
+            
+            except subprocess.TimeoutExpired:
+                result_entry['brute_output'] = 'TIMEOUT'
+                result_entry['brute_timeout'] = True
+            except Exception as e:
+                result_entry['brute_output'] = f"ERROR: {str(e)}"
+            
+            # Run solution
+            try:
+                sol_result = subprocess.run(
+                    ["python3", str(solution_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if sol_result.returncode != 0:
+                    result_entry['solution_output'] = f"EXIT {sol_result.returncode}"
+                    result_entry['solution_stderr'] = sol_result.stderr.strip()
+                else:
+                    result_entry['solution_output'] = sol_result.stdout.strip()
+                    if sol_result.stderr:
+                        result_entry['solution_stderr'] = sol_result.stderr.strip()
+            
+            except subprocess.TimeoutExpired:
+                result_entry['solution_output'] = 'TIMEOUT'
+                result_entry['solution_timeout'] = True
+            except Exception as e:
+                result_entry['solution_output'] = f"ERROR: {str(e)}"
+            
+            # Check if outputs match
+            result_entry['match'] = (
+                result_entry['brute_output'] == result_entry['solution_output']
+            )
+            
+            results.append(result_entry)
+        
+        # Sort by: mismatches first (False before True), then by input length
+        results.sort(key=lambda x: (x['match'], x['input_len']))
+        
+        # Build output table
+        output_lines = []
+        output_lines.append("=" * 120)
+        output_lines.append("COMPARISON RESULTS (sorted by mismatch status, then input length)")
+        output_lines.append("=" * 120)
+        
+        # Summary
+        num_passed = sum(1 for r in results if r['match'])
+        num_failed = len(results) - num_passed
+        output_lines.append(f"Results: {num_passed} MATCH, {num_failed} MISMATCH")
+        output_lines.append("")
+        
+        # Table of results
+        for result in results:
+            status = "✓ MATCH" if result['match'] else "✗ MISMATCH"
+            output_lines.append(f"[Test {result['index']}] {status} | Input length: {result['input_len']}")
+            
+            # Truncate long inputs for display
+            input_display = result['input']
+            if len(input_display) > 100:
+                input_display = input_display[:100] + f"... (total {len(result['input'])} chars)"
+            output_lines.append(f"  Input: {repr(input_display)}")
+            
+            output_lines.append(f"  Brute output:    {repr(result['brute_output'][:150])}")
+            if result['brute_stderr']:
+                output_lines.append(f"    stderr: {result['brute_stderr'][:150]}")
+            
+            output_lines.append(f"  Solution output: {repr(result['solution_output'][:150])}")
+            if result['solution_stderr']:
+                output_lines.append(f"    stderr: {result['solution_stderr'][:150]}")
+            
+            output_lines.append("")
+        
+        output_lines.append("=" * 120)
+        
+        return '\n'.join(output_lines)
+        
+    except Exception as e:
+        return f"Fatal error in compare_outputs: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
