new file mode 100644
index 0000000..2ea4019
--- /dev/null
+++ b/tools/check_scaling.py
@@ -0,0 +1,194 @@
+import subprocess
+import time
+import math
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "check_scaling",
+        "description": """Validate that a solution's runtime scales appropriately for the maximum constraints.
+Runs the solution at geometrically increasing input sizes, measures timing, fits a log-log slope,
+and extrapolates to predict runtime at max_n. Returns a table of size vs time, estimated exponent,
+projected time at max_n, and a verdict line starting with 'SCALING PASS' or 'SCALING FAIL'.
+Use this to ensure algorithms don't have asymptotic complexity too high for the problem constraints.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file to test"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to the generator script that accepts N as argv[1] and produces a worst-case input of size N"
+                },
+                "max_n": {
+                    "type": "integer",
+                    "description": "Maximum N from the problem constraints"
+                },
+                "time_limit_sec": {
+                    "type": "number",
+                    "description": "Time limit in seconds for the full solve (default: 2.0)"
+                },
+                "per_run_timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds per individual run (default: 10.0)"
+                }
+            },
+            "required": ["solution_path", "generator_path", "max_n"]
+        }
+    }
+
+
+def tool_function(
+    solution_path,
+    generator_path,
+    max_n,
+    time_limit_sec=2.0,
+    per_run_timeout=10.0
+):
+    """
+    Check if a solution's runtime scales appropriately for max_n.
+    
+    Runs the solution at geometrically increasing sizes (roughly max_n/1000, /300, /100, /30, /10, /3, 1x),
+    measures actual runtimes, fits a log-log slope on the last 2-3 successful points,
+    and extrapolates to predict runtime at max_n.
+    
+    Returns a string containing:
+      - A table of N vs time for each run
+      - Estimated exponent (complexity class)
+      - Projected time at max_n
+      - Final verdict: 'SCALING PASS' or 'SCALING FAIL'
+    """
+    try:
+        solution_path = Path(solution_path)
+        generator_path = Path(generator_path)
+        
+        # Validate paths exist
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        if not generator_path.exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        
+        # Generate geometric series of input sizes up to max_n
+        sizes = []
+        divisors = [1000, 300, 100, 30, 10, 3, 1]
+        for div in divisors:
+            n = max(1, max_n // div)
+            if n not in sizes:
+                sizes.append(n)
+        # Add max_n itself if not already there
+        if max_n not in sizes:
+            sizes.append(max_n)
+        
+        sizes = sorted(set(sizes))
+        
+        # Run solution at each size and measure time
+        measurements = []  # (n, time_sec)
+        result_lines = []
+        
+        for n in sizes:
+            try:
+                # Generate input of size n
+                gen_result = subprocess.run(
+                    ["python3", str(generator_path), str(n)],
+                    capture_output=True,
+                    text=True,
+                    timeout=per_run_timeout
+                )
+                
+                if gen_result.returncode != 0:
+                    result_lines.append(f"Generator error at N={n}: {gen_result.stderr[:200]}")
+                    break
+                
+                test_input = gen_result.stdout
+                
+                # Run solution and time it
+                start_time = time.time()
+                sol_result = subprocess.run(
+                    ["python3", str(solution_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=per_run_timeout
+                )
+                elapsed = time.time() - start_time
+                
+                if sol_result.returncode != 0:
+                    result_lines.append(f"Solution error at N={n}: {sol_result.stderr[:200]}")
+                    break
+                
+                measurements.append((n, elapsed))
+                result_lines.append(f"N={n:>10} : {elapsed:>8.4f}s")
+                
+                # If we've exceeded the time limit, stop
+                if elapsed > time_limit_sec:
+                    result_lines.append(f"(exceeded time limit of {time_limit_sec}s, stopping)")
+                    break
+            
+            except subprocess.TimeoutExpired:
+                result_lines.append(f"N={n:>10} : TIMEOUT (>{per_run_timeout}s)")
+                break
+            except Exception as e:
+                result_lines.append(f"Error at N={n}: {str(e)}")
+                break
+        
+        # Fit log-log slope on last 2-3 successful points
+        if len(measurements) < 2:
+            result_lines.append("\nError: need at least 2 successful measurements to estimate scaling")
+            return "\n".join(result_lines) + "\n\nSCALING FAIL: insufficient data"
+        
+        # Use last 2-3 points (prefer 3 if available)
+        fit_points = measurements[-3:] if len(measurements) >= 3 else measurements[-2:]
+        
+        # Log-log fit: log(t) = exponent * log(n) + intercept
+        log_ns = [math.log(n) for n, t in fit_points]
+        log_ts = [math.log(t) for n, t in fit_points]
+        
+        # Linear regression in log space
+        mean_log_n = sum(log_ns) / len(log_ns)
+        mean_log_t = sum(log_ts) / len(log_ts)
+        
+        numerator = sum((log_ns[i] - mean_log_n) * (log_ts[i] - mean_log_t) for i in range(len(log_ns)))
+        denominator = sum((log_ns[i] - mean_log_n) ** 2 for i in range(len(log_ns)))
+        
+        if denominator == 0:
+            result_lines.append("\nWarning: cannot fit slope (all measurements at same size)")
+            exponent = 1.0
+        else:
+            exponent = numerator / denominator
+        
+        # Compute intercept: log(t) = exponent * log(n) + intercept
+        intercept = mean_log_t - exponent * mean_log_n
+        
+        # Extrapolate to max_n
+        projected_log_t = exponent * math.log(max_n) + intercept
+        projected_time = math.exp(projected_log_t)
+        
+        result_lines.append(f"\n{'='*60}")
+        result_lines.append(f"Fit points (last {len(fit_points)}):")
+        for n, t in fit_points:
+            result_lines.append(f"  N={n}, time={t:.4f}s")
+        result_lines.append(f"\nEstimated exponent (log-log slope): {exponent:.2f}")
+        result_lines.append(f"Projected time at N={max_n}: {projected_time:.2f}s")
+        result_lines.append(f"Time limit: {time_limit_sec}s")
+        result_lines.append(f"{'='*60}")
+        
+        # Verdict
+        if projected_time <= time_limit_sec:
+            verdict = f"SCALING PASS (exponent={exponent:.2f}, projected {projected_time:.2f}s at N={max_n})"
+        else:
+            verdict = f"SCALING FAIL (exponent={exponent:.2f}, projected {projected_time:.2f}s at N={max_n}, exceeds {time_limit_sec}s limit)"
+        
+        result_lines.append(verdict)
+        
+        return "\n".join(result_lines)
+    
+    except Exception as e:
+        return f"Fatal error in check_scaling: {str(e)}\n\nSCALING FAIL"
+
+
+if __name__ == "__main__":
+    # Example usage
+    print(tool_info())
