@@ -0,0 +1,238 @@
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution against provided test samples and verify outputs.
+For each sample, runs the command with the input on stdin, measures wall time, compares the 
+whitespace-normalized output with the expected output (or invokes a checker if given), and 
+returns a plain-text report listing per-sample PASS/FAIL, raw actual and expected outputs, 
+stderr and elapsed time. If checker_cmd is provided, it pipes 'input\\n---\\noutput' to the 
+checker and reports its verdict.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "Command to run the solution (e.g., 'python solution.py')"
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Array of test samples, each with 'input' and 'expected' strings",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The input to provide to the solution"
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "The expected output"
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each sample execution"
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional: command that validates output. Receives 'input\\n---\\noutput' on stdin and should exit 0 for valid output."
+                }
+            },
+            "required": ["command", "samples", "timeout_sec"]
+        }
+    }
+
+def normalize_output(text):
+    """Normalize output by stripping and splitting on whitespace for comparison."""
+    return text.strip().split()
+
+def tool_function(command, samples, timeout_sec, checker_cmd=None):
+    """
+    Run a solution against provided test samples.
+    
+    Args:
+        command: Command to run the solution
+        samples: List of dicts with 'input' and 'expected' keys
+        timeout_sec: Timeout in seconds for each sample
+        checker_cmd: Optional command to validate output instead of simple comparison
+    
+    Returns:
+        A string with a report listing per-sample PASS/FAIL, raw outputs, stderr, and timing.
+    """
+    try:
+        if not isinstance(samples, list):
+            return "Error: samples must be an array"
+        
+        if len(samples) == 0:
+            return "Error: samples array is empty"
+        
+        results = []
+        passed = 0
+        failed = 0
+        
+        # Bounded for loop - no while True
+        for sample_idx in range(len(samples)):
+            sample = samples[sample_idx]
+            
+            # Validate sample structure
+            if not isinstance(sample, dict) or 'input' not in sample or 'expected' not in sample:
+                results.append(f"Sample {sample_idx}: ERROR - Invalid sample structure (missing 'input' or 'expected')")
+                failed += 1
+                continue
+            
+            sample_input = sample['input']
+            expected_output = sample['expected']
+            
+            # Run the solution
+            try:
+                start_time = time.perf_counter()
+                result = subprocess.run(
+                    command,
+                    input=sample_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec,
+                    shell=True
+                )
+                elapsed_time = time.perf_counter() - start_time
+                actual_output = result.stdout
+                stderr = result.stderr.strip() if result.stderr else ""
+                timeout_occurred = False
+            except subprocess.TimeoutExpired:
+                elapsed_time = timeout_sec
+                actual_output = "[TIMEOUT]"
+                stderr = f"Command timed out after {timeout_sec} seconds"
+                timeout_occurred = True
+            except Exception as e:
+                elapsed_time = 0
+                actual_output = "[ERROR]"
+                stderr = str(e)
+                timeout_occurred = False
+            
+            # Compare outputs or use checker
+            status = "FAIL"
+            reason = ""
+            
+            if timeout_occurred:
+                status = "FAIL"
+                reason = "TIMEOUT"
+            elif actual_output == "[ERROR]" or stderr:
+                # Check if it's an error
+                if actual_output == "[ERROR]":
+                    status = "FAIL"
+                    reason = "ERROR"
+                elif checker_cmd:
+                    # Try the checker even if there's stderr
+                    status, reason = check_with_cmd(checker_cmd, sample_input, actual_output, timeout_sec)
+                else:
+                    # No checker, compare outputs
+                    actual_normalized = normalize_output(actual_output)
+                    expected_normalized = normalize_output(expected_output)
+                    if actual_normalized == expected_normalized:
+                        status = "PASS"
+                    else:
+                        status = "FAIL"
+                        reason = "OUTPUT_MISMATCH"
+            elif checker_cmd:
+                # Use checker
+                status, reason = check_with_cmd(checker_cmd, sample_input, actual_output, timeout_sec)
+            else:
+                # Simple comparison
+                actual_normalized = normalize_output(actual_output)
+                expected_normalized = normalize_output(expected_output)
+                if actual_normalized == expected_normalized:
+                    status = "PASS"
+                else:
+                    status = "FAIL"
+                    reason = "OUTPUT_MISMATCH"
+            
+            if status == "PASS":
+                passed += 1
+            else:
+                failed += 1
+            
+            # Build result for this sample
+            result_str = f"Sample {sample_idx}: {status}"
+            if reason:
+                result_str += f" ({reason})"
+            result_str += f" - Time: {elapsed_time:.4f}s"
+            
+            # Add details for failed samples
+            if status == "FAIL":
+                result_str += f"\n  Input (first 200 chars): {sample_input[:200] if len(sample_input) > 200 else sample_input}"
+                result_str += f"\n  Expected output: {expected_output[:200] if len(expected_output) > 200 else expected_output}"
+                result_str += f"\n  Actual output: {actual_output[:200] if len(actual_output) > 200 else actual_output}"
+                if stderr:
+                    result_str += f"\n  Stderr: {stderr[:200] if len(stderr) > 200 else stderr}"
+            
+            results.append(result_str)
+        
+        # Summary
+        summary = f"\n{'='*60}\nSummary: {passed} passed, {failed} failed out of {len(samples)} samples\n{'='*60}"
+        
+        return "\n\n".join(results) + summary
+    
+    except Exception as e:
+        return f"Error in run_samples: {str(e)}"
+
+def check_with_cmd(checker_cmd, sample_input, actual_output, timeout_sec):
+    """
+    Run a checker command with 'input\\n---\\noutput' format.
+    
+    Returns:
+        Tuple of (status, reason) where status is "PASS" or "FAIL"
+    """
+    try:
+        checker_input = f"{sample_input}\n---\n{actual_output}"
+        result = subprocess.run(
+            checker_cmd,
+            input=checker_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec,
+            shell=True
+        )
+        
+        # Checker should exit with 0 for valid output
+        if result.returncode == 0:
+            return ("PASS", "")
+        else:
+            # Checker indicated invalid output
+            return ("FAIL", f"CHECKER_FAILED: {result.stderr.strip()[:100]}")
+    except subprocess.TimeoutExpired:
+        return ("FAIL", "CHECKER_TIMEOUT")
+    except Exception as e:
+        return ("FAIL", f"CHECKER_ERROR: {str(e)[:100]}")
+
+if __name__ == "__main__":
+    import sys
+    import json
+    
+    if len(sys.argv) < 2:
+        print("Usage: python run_samples.py <command> <json_samples> <timeout_sec> [checker_cmd]")
+        print("  json_samples should be a JSON array of {\"input\": ..., \"expected\": ...}")
+    else:
+        command = sys.argv[1]
+        samples_json = sys.argv[2]
+        timeout_sec = int(sys.argv[3])
+        checker_cmd = sys.argv[4] if len(sys.argv) > 4 else None
+        
+        try:
+            samples = json.loads(samples_json)
+        except json.JSONDecodeError as e:
+            print(f"Error parsing samples JSON: {e}")
+            sys.exit(1)
+        
+        result = tool_function(
+            command=command,
+            samples=samples,
+            timeout_sec=timeout_sec,
+            checker_cmd=checker_cmd
+        )
+        print(result)
