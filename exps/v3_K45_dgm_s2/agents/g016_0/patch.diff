+def _test_generator_modes(solution_path, brute_path, generator_path, checker_path, num_seeds, timeout_sec):
+    """Test solution with generator in tiny/random/edge modes."""
+    try:
+        modes = ["tiny", "random", "edge"]
+        
+        for mode in modes:
+            for seed in range(num_seeds):
+                try:
+                    # Generate test case
+                    gen_result = subprocess.run(
+                        ["python3", str(generator_path), str(seed), mode],
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec
+                    )
+                    
+                    if gen_result.returncode != 0:
+                        return f"{mode.upper()}: FAIL (generator error: {gen_result.stderr})"
+                    
+                    test_input = gen_result.stdout
+                    
+                    # Run solution
+                    sol_result = subprocess.run(
+                        ["python3", str(solution_path)],
+                        input=test_input,
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec
+                    )
+                    
+                    if sol_result.returncode != 0:
+                        return f"{mode.upper()}: FAIL (solution runtime error: {sol_result.stderr})"
+                    
+                    sol_output = sol_result.stdout.strip()
+                    
+                    # Run brute
+                    brute_result = subprocess.run(
+                        ["python3", str(brute_path)],
+                        input=test_input,
+                        capture_output=True,
+                        text=True,
+                        timeout=timeout_sec
+                    )
+                    
+                    if brute_result.returncode != 0:
+                        return f"{mode.upper()}: FAIL (brute runtime error: {brute_result.stderr})"
+                    
+                    brute_output = brute_result.stdout.strip()
+                    
+                    # Check outputs
+                    if checker_path:
+                        # Use checker to validate
+                        with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_input:
+                            f_input.write(test_input)
+                            f_input.flush()
+                            input_tmp = f_input.name
+                        
+                        with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_actual:
+                            f_actual.write(sol_output)
+                            f_actual.flush()
+                            actual_tmp = f_actual.name
+                        
+                        with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_expected:
+                            f_expected.write(brute_output)
+                            f_expected.flush()
+                            expected_tmp = f_expected.name
+                        
+                        try:
+                            check_result = subprocess.run(
+                                ["python3", str(checker_path), input_tmp, actual_tmp, expected_tmp],
+                                capture_output=True,
+                                text=True,
+                                timeout=timeout_sec
+                            )
+                            
+                            if check_result.returncode != 0:
+                                return f"{mode.upper()}: FAIL (seed {seed}, checker validation failed)"
+                        finally:
+                            os.unlink(input_tmp)
+                            os.unlink(actual_tmp)
+                            os.unlink(expected_tmp)
+                    else:
+                        # Direct comparison
+                        if sol_output != brute_output:
+                            return f"{mode.upper()}: FAIL (seed {seed}, input: {test_input[:100]}..., expected: {brute_output[:100]}..., got: {sol_output[:100]}...)"
+                
+                except subprocess.TimeoutExpired:
+                    return f"{mode.upper()}: FAIL (seed {seed} timed out)"
+                except Exception as e:
+                    return f"{mode.upper()}: FAIL (seed {seed}: {str(e)})"
+        
+        return "RANDOM: PASS"
+    
+    except Exception as e:
+        return f"RANDOM: ERROR ({str(e)})"
+
