+def _test_max_input(solution_path, max_input_path, timeout_sec):
+    """Test solution with max input and measure wall time."""
+    try:
+        with open(max_input_path, 'r') as f:
+            max_input = f.read()
+        
+        start_time = time.time()
+        result = subprocess.run(
+            ["python3", str(solution_path)],
+            input=max_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout_sec
+        )
+        elapsed = time.time() - start_time
+        
+        if result.returncode != 0:
+            return f"MAX: FAIL (runtime error: {result.stderr})"
+        
+        return f"MAX: PASS ({elapsed:.2f}s)"
+    
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start_time
+        return f"MAX: TLE ({elapsed:.2f}s)"
+    except Exception as e:
+        return f"MAX: ERROR ({str(e)})"
