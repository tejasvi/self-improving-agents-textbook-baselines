+import subprocess
+import tempfile
+import os
+import time
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "verify_solution",
+        "description": """Verify a solution by testing against samples, generator modes, and max input.
+Runs every sample file pair (sample_N.txt / sample_N_expected.txt) and compares them, or uses the checker when given.
+Runs the generator with '<seed> <mode>' for tiny/random/edge modes against brute (or the checker) for num_seeds seeds.
+Runs max_input_path (or generator mode 'max') with the timeout and records wall time.
+Returns a text report with lines like 'SAMPLES: PASS', 'RANDOM: FAIL (input..., expected..., got...)', 'MAX: TLE 7.1s'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution.py file to test"
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Path to directory containing sample_N.txt and sample_N_expected.txt files"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to brute.py file (reference implementation)"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to gen.py file (test case generator)"
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to checker.py file for custom output validation"
+                },
+                "max_input_path": {
+                    "type": "string",
+                    "description": "Optional path to max-size input file for timing test"
+                },
+                "num_seeds": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default: 10)"
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds per test case (default: 5.0)"
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def tool_function(
+    solution_path,
+    samples_dir,
+    brute_path=None,
+    generator_path=None,
+    checker_path=None,
+    max_input_path=None,
+    num_seeds=10,
+    timeout_sec=5.0
+):
+    """
+    Verify a solution by testing against samples, generator modes, and max input.
+    
+    Returns a plain-text report with lines like 'SAMPLES: PASS', 'RANDOM: FAIL', 'MAX: TLE'.
+    """
+    try:
+        solution_path = Path(solution_path)
+        samples_dir = Path(samples_dir)
+        
+        # Validate solution exists
+        if not solution_path.exists():
+            return f"Error: solution_path {solution_path} does not exist"
+        
+        # Validate samples_dir exists
+        if not samples_dir.exists():
+            return f"Error: samples_dir {samples_dir} does not exist"
+        
+        # Validate optional paths
+        if brute_path and not Path(brute_path).exists():
+            return f"Error: brute_path {brute_path} does not exist"
+        if generator_path and not Path(generator_path).exists():
+            return f"Error: generator_path {generator_path} does not exist"
+        if checker_path and not Path(checker_path).exists():
+            return f"Error: checker_path {checker_path} does not exist"
+        if max_input_path and not Path(max_input_path).exists():
+            return f"Error: max_input_path {max_input_path} does not exist"
+        
+        report = []
+        
+        # Phase 1: Test samples
+        samples_result = _test_samples(solution_path, samples_dir, checker_path, timeout_sec)
+        report.append(samples_result)
+        
+        # Phase 2: Test with generator (if provided)
+        if generator_path and brute_path:
+            gen_result = _test_generator_modes(
+                solution_path, Path(brute_path), Path(generator_path),
+                checker_path, num_seeds, timeout_sec
+            )
+            report.append(gen_result)
+        
+        # Phase 3: Test max input (if provided)
+        if max_input_path:
+            max_result = _test_max_input(solution_path, max_input_path, timeout_sec * 3)
+            report.append(max_result)
+        
+        return "\n".join(report)
+    
+    except Exception as e:
+        return f"Fatal error in verify_solution: {str(e)}"
+
+
+def _test_samples(solution_path, samples_dir, checker_path=None, timeout_sec=5.0):
+    """Test solution against all sample files in samples_dir."""
+    try:
+        # Find all sample input files (sample_N.txt)
+        sample_files = sorted([f for f in samples_dir.glob("sample_*.txt") if "_expected" not in f.name])
+        
+        if not sample_files:
+            return "SAMPLES: No sample files found"
+        
+        for sample_file in sample_files:
+            expected_file = sample_file.parent / sample_file.name.replace(".txt", "_expected.txt")
+            
+            if not expected_file.exists():
+                return f"SAMPLES: FAIL (missing expected file for {sample_file.name})"
+            
+            try:
+                # Read input and expected output
+                with open(sample_file, 'r') as f:
+                    test_input = f.read()
+                with open(expected_file, 'r') as f:
+                    expected_output = f.read().strip()
+                
+                # Run solution
+                result = subprocess.run(
+                    ["python3", str(solution_path)],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                
+                if result.returncode != 0:
+                    return f"SAMPLES: FAIL (runtime error on {sample_file.name}: {result.stderr})"
+                
+                actual_output = result.stdout.strip()
+                
+                # Check output
+                if checker_path:
+                    # Use checker to validate
+                    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_input:
+                        f_input.write(test_input)
+                        f_input.flush()
+                        input_tmp = f_input.name
+                    
+                    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_actual:
+                        f_actual.write(actual_output)
+                        f_actual.flush()
+                        actual_tmp = f_actual.name
+                    
+                    with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt') as f_expected:
+                        f_expected.write(expected_output)
+                        f_expected.flush()
+                        expected_tmp = f_expected.name
+                    
+                    try:
+                        check_result = subprocess.run(
+                            ["python3", str(checker_path), input_tmp, actual_tmp, expected_tmp],
+                            capture_output=True,
+                            text=True,
+                            timeout=timeout_sec
+                        )
+                        
+                        if check_result.returncode != 0:
+                            return f"SAMPLES: FAIL (checker validation failed on {sample_file.name})"
+                    finally:
+                        os.unlink(input_tmp)
+                        os.unlink(actual_tmp)
+                        os.unlink(expected_tmp)
+                else:
+                    # Direct comparison
+                    if actual_output != expected_output:
+                        return f"SAMPLES: FAIL ({sample_file.name}: expected '{expected_output}', got '{actual_output}')"
+            
+            except subprocess.TimeoutExpired:
+                return f"SAMPLES: FAIL ({sample_file.name} timed out)"
+            except Exception as e:
+                return f"SAMPLES: FAIL ({sample_file.name}: {str(e)})"
+        
+        return "SAMPLES: PASS"
+    
+    except Exception as e:
+        return f"SAMPLES: ERROR ({str(e)})"
+
