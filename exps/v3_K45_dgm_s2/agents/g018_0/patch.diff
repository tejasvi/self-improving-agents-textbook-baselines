+            repair_prompt = """Re-run all example tests and the stress test. If anything fails or is too slow, debug using the raw output and fix solution.py; reply with the exact text ALL_TESTS_PASSED only if everything passes."""
+            
+            msg_history = chat_with_agent(
+                repair_prompt,
+                model=self.code_model,
+                msg_history=msg_history,
+                logging=safe_log
+            )
+            
+            # Check if the agent reported success
+            # Get the last assistant message
+            for msg in reversed(msg_history):
+                if msg.get('role') == 'assistant':
+                    response_text = ""
+                    if isinstance(msg.get('content'), list):
+                        for block in msg['content']:
+                            if isinstance(block, dict) and block.get('type') == 'text':
+                                response_text += block.get('text', '')
+                    elif isinstance(msg.get('content'), str):
+                        response_text = msg['content']
+                    
+                    if "ALL_TESTS_PASSED" in response_text:
+                        safe_log("\n" + "="*80)
+                        safe_log("SUCCESS: All tests passed!")
+                        safe_log("="*80)
+                        return
+                    break
+        
+        safe_log("\n" + "="*80)
+        safe_log("REPAIR LOOP EXHAUSTED: Maximum attempts reached")
+        safe_log("="*80)
 
 def main():
