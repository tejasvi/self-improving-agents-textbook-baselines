diff --git a/tools/run_examples.py b/tools/run_examples.py
new file mode 100644
index 0000000..105b6bb
--- /dev/null
+++ b/tools/run_examples.py
@@ -0,0 +1,200 @@
+import subprocess
+import json
+import sys
+import time
+
+def tool_info():
+    return {
+        "name": "run_examples",
+        "description": """Run a method of a Solution class on given inputs with expected outputs.
+This tool is useful for testing class-based tasks by importing a Solution class,
+running its methods on provided test cases, and comparing outputs.
+Returns raw pass/fail results for each test case.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "module_path": {
+                    "type": "string",
+                    "description": "Path to the Python module containing the Solution class (e.g., '/tmp/work/solution.py')"
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the class to instantiate (e.g., 'Solution')"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call (e.g., 'solve')"
+                },
+                "test_cases": {
+                    "type": "string",
+                    "description": "JSON string containing list of test cases in format: [{\"args\": [...], \"expected\": ...}, ...]"
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the entire test run"
+                },
+                "compare_mode": {
+                    "type": "string",
+                    "description": "Output comparison mode: 'exact' (default) or 'whitespace' (ignores whitespace differences)",
+                    "enum": ["exact", "whitespace"]
+                }
+            },
+            "required": ["module_path", "class_name", "method_name", "test_cases", "timeout_sec"]
+        }
+    }
+
+def normalize_whitespace(text):
+    """Normalize whitespace by splitting into tokens and comparing."""
+    return ' '.join(str(text).split())
+
+def compare_outputs(actual, expected, compare_mode="exact"):
+    """Compare outputs based on the specified mode."""
+    if compare_mode == "whitespace":
+        return normalize_whitespace(actual) == normalize_whitespace(expected)
+    else:  # exact
+        return str(actual).strip() == str(expected).strip()
+
+def tool_function(module_path, class_name, method_name, test_cases, timeout_sec, compare_mode="exact"):
+    """
+    Run tests on a Solution class method.
+    
+    Args:
+        module_path: Path to the Python module containing the Solution class
+        class_name: Name of the class to instantiate
+        method_name: Name of the method to call
+        test_cases: JSON string containing test cases
+        timeout_sec: Timeout in seconds for the test run
+        compare_mode: Either 'exact' or 'whitespace' for output comparison
+    
+    Returns:
+        A string with pass/fail results for each test case
+    """
+    try:
+        # Parse test cases
+        try:
+            tests = json.loads(test_cases)
+        except json.JSONDecodeError as e:
+            return f"Error parsing test_cases JSON: {str(e)}"
+        
+        if not isinstance(tests, list):
+            return f"Error: test_cases must be a JSON array, got {type(tests).__name__}"
+        
+        # Build and run test script
+        script = f"""
+import sys
+sys.path.insert(0, '{module_path.rsplit('/', 1)[0]}')
+
+from {module_path.split('/')[-1].replace('.py', '')} import {class_name}
+
+test_cases = {json.dumps(tests)}
+results = []
+
+for i, test_case in enumerate(test_cases):
+    args = test_case.get('args', [])
+    if not isinstance(args, list):
+        args = [args]
+    expected = test_case.get('expected')
+    
+    try:
+        instance = {class_name}()
+        method = getattr(instance, '{method_name}')
+        actual = method(*args)
+        
+        # Compare
+        actual_str = str(actual).strip()
+        expected_str = str(expected).strip()
+        
+        if '{compare_mode}' == 'whitespace':
+            actual_norm = ' '.join(actual_str.split())
+            expected_norm = ' '.join(expected_str.split())
+            passed = actual_norm == expected_norm
+        else:
+            passed = actual_str == expected_str
+        
+        results.append({{
+            'test': i,
+            'passed': passed,
+            'args': str(args),
+            'expected': str(expected),
+            'actual': str(actual),
+        }})
+    except Exception as e:
+        results.append({{
+            'test': i,
+            'passed': False,
+            'args': str(args),
+            'expected': str(expected),
+            'error': str(e),
+        }})
+
+import json
+print(json.dumps(results, indent=2))
+"""
+        
+        # Run script with timeout
+        try:
+            result = subprocess.run(
+                ['python', '-c', script],
+                capture_output=True,
+                text=True,
+                timeout=timeout_sec
+            )
+            
+            if result.returncode != 0:
+                return f"Error running tests:\nStderr: {result.stderr}"
+            
+            # Parse results
+            try:
+                results = json.loads(result.stdout)
+            except json.JSONDecodeError:
+                return f"Error parsing test results:\n{result.stdout}"
+            
+            # Format output
+            output = ""
+            passed_count = 0
+            failed_count = 0
+            
+            for result_item in results:
+                test_num = result_item['test']
+                passed = result_item['passed']
+                
+                if passed:
+                    output += f"Test {test_num}: PASS\n"
+                    passed_count += 1
+                else:
+                    output += f"Test {test_num}: FAIL\n"
+                    output += f"  Args: {result_item['args']}\n"
+                    output += f"  Expected: {result_item['expected']}\n"
+                    if 'error' in result_item:
+                        output += f"  Error: {result_item['error']}\n"
+                    else:
+                        output += f"  Actual: {result_item['actual']}\n"
+                    failed_count += 1
+            
+            output += f"\nSummary: {passed_count} passed, {failed_count} failed out of {len(results)} tests\n"
+            
+            return output
+        
+        except subprocess.TimeoutExpired:
+            return f"Tests timed out after {timeout_sec} seconds"
+        except Exception as e:
+            return f"Error running tests: {str(e)}"
+    
+    except Exception as e:
+        return f"Error in run_examples: {str(e)}"
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 6:
+        print("Usage: python run_examples.py <module_path> <class_name> <method_name> <test_cases_json> <timeout_sec> [compare_mode]")
+    else:
+        compare_mode = sys.argv[6] if len(sys.argv) > 6 else "exact"
+        result = tool_function(
+            module_path=sys.argv[1],
+            class_name=sys.argv[2],
+            method_name=sys.argv[3],
+            test_cases=sys.argv[4],
+            timeout_sec=int(sys.argv[5]),
+            compare_mode=compare_mode
+        )
+        print(result)
