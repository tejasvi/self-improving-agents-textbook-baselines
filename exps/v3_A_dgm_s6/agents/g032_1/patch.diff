+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Starting seed for the generator (default 0)."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path"]
+        }
+    }
+
+
+def _run(path, inp, timeout):
+    try:
+        r = subprocess.run([sys.executable, path], input=inp, capture_output=True,
+                           text=True, timeout=timeout)
+        return r.stdout, r.stderr, None
+    except subprocess.TimeoutExpired:
+        return "", "", "TIMEOUT"
+
+
+def tool_function(solution_path, brute_path, gen_path, num_tests=200,
+                  per_test_timeout=10, seed=0):
+    num_tests = int(num_tests)
+    per_test_timeout = float(per_test_timeout)
+    seed = int(seed)
+    for i in range(num_tests):
+        s = seed + i
