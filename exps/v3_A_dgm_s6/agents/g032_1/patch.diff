+def _cap(s):
+    s = s or ""
+    if len(s) > MAX_CHARS:
+        return s[:MAX_CHARS] + "\n...[truncated]"
+    return s
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": (
+            "Compare a solution against a brute-force reference on randomly generated inputs. "
+            "The generator is called as `python gen.py <seed>` and must print one test input to stdout. "
+            "Runs solution and brute with per-test timeouts, compares whitespace-normalised tokens. "
+            "Returns 'ALL OK n tests' or the first mismatch (input, expected, actual, stderr), truncated. "
+            "Keep brute-force sizes small. Use `timeout 60` for long commands and store artifacts in /tmp/work."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate solution Python file."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the trusted brute-force Python file."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator Python file; takes an integer seed argument."
+                },
+                "num_tests": {
