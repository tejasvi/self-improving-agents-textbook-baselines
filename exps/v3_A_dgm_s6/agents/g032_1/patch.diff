@@ -0,0 +1,126 @@
+import os
+import subprocess
+import sys
+
+MAX_REPORT_CHARS = 4000
+MAX_FIELD_CHARS = 1200
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution against a brute-force reference on random inputs.\n
+* The generator is run as `python3 gen_path <seed>` (the seed is passed as the first command-line argument; it prints one test input to standard output). Test i uses seed (seed + i).\n
+* For every generated input, both solution_path and brute_path are run with a per-run timeout and their outputs are compared as whitespace-separated tokens.\n
+* Returns 'ALL OK n tests' if every test matches, otherwise the first mismatch with the input, expected (brute-force) output, actual (solution) output and stderr. Output is truncated.\n
+* Keep brute-force sizes small so that the whole run finishes quickly. Use `timeout 60` on long shell commands. Store brute.py and gen.py in /tmp/work so they can be reused.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the candidate Python solution file to test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the trusted brute-force Python reference file."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Absolute path to the random input generator. It is run as `python3 gen_path <seed>` and prints one test input to standard output."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run. Defaults to 200."
+                },
+                "per_test_timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run on each test. Defaults to 10."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Base seed. Test i uses seed (seed + i). Defaults to 0."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path"]
+        }
+    }
+
+
+def _clip(text, limit=MAX_FIELD_CHARS):
+    text = text or ""
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n...[truncated {len(text) - limit} chars]"
+
+
+def _run(argv, stdin_text, timeout, cwd):
+    """Run argv; return (stdout, stderr, returncode, timed_out_flag)."""
+    try:
+        proc = subprocess.run(argv, input=stdin_text, capture_output=True, text=True,
+                              timeout=timeout, cwd=cwd)
+        return proc.stdout, proc.stderr, proc.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout if isinstance(e.stdout, str) else ""
+        err = e.stderr if isinstance(e.stderr, str) else ""
+        return out, err, None, True
+
+
+def tool_function(solution_path: str, brute_path: str, gen_path: str, num_tests: int = 200,
+                  per_test_timeout: float = 10, seed: int = 0) -> str:
+    for label, path in (("solution_path", solution_path), ("brute_path", brute_path), ("gen_path", gen_path)):
+        if not path or not os.path.isfile(path):
+            return f"Error: {label} does not exist: {path}"
+    try:
+        num_tests = int(num_tests)
+        per_test_timeout = float(per_test_timeout)
+        seed = int(seed)
+    except (TypeError, ValueError) as e:
+        return f"Error: invalid numeric argument: {e}"
+    if num_tests <= 0:
+        return "Error: num_tests must be positive."
+    if per_test_timeout <= 0:
+        return "Error: per_test_timeout must be positive."
+
+    cwd = os.path.dirname(os.path.abspath(solution_path)) or None
+    py = sys.executable or "python3"
+
+    # Bounded loop: exactly num_tests iterations.
+    for i in range(num_tests):
+        cur_seed = seed + i
+        gen_out, gen_err, gen_rc, gen_timeout = _run(
+            [py, gen_path, str(cur_seed)], None, per_test_timeout, cwd)
+        if gen_timeout or gen_rc != 0:
+            return (f"Generator failed on seed {cur_seed} (test {i + 1}): "
+                    f"{'timed out' if gen_timeout else f'exit code {gen_rc}'}\n"
+                    f"stderr:\n{_clip(gen_err)}")
+        test_input = gen_out if gen_out.endswith("\n") else gen_out + "\n"
+
+        exp_out, exp_err, exp_rc, exp_timeout = _run([py, brute_path], test_input, per_test_timeout, cwd)
+        if exp_timeout or exp_rc != 0:
+            return (f"Brute force failed on test {i + 1} (seed {cur_seed}): "
+                    f"{'timed out' if exp_timeout else f'exit code {exp_rc}'}. "
+                    "Keep brute-force sizes small or fix brute_path.\n"
+                    f"--- input ---\n{_clip(test_input)}\n"
+                    f"stderr:\n{_clip(exp_err)}")
+
+        act_out, act_err, act_rc, act_timeout = _run([py, solution_path], test_input, per_test_timeout, cwd)
+        if act_timeout:
+            status = f"timed out after {per_test_timeout}s"
+        elif act_rc != 0:
+            status = f"exit code {act_rc}"
+        elif act_out.split() == exp_out.split():
+            continue
+        else:
+            status = "wrong output"
+
+        report = (
+            f"MISMATCH on test {i + 1} (seed {cur_seed}): {status}\n"
+            f"--- input ---\n{_clip(test_input)}\n"
+            f"--- expected (brute force) ---\n{_clip(exp_out)}\n"
+            f"--- actual (solution) ---\n{_clip(act_out)}\n"
+            f"--- stderr ---\n{_clip(act_err)}"
+        )
+        return report[:MAX_REPORT_CHARS]
+
+    return f"ALL OK {num_tests} tests"
