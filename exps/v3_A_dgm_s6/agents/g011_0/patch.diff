+    @staticmethod
+    def _is_test_file(path):
+        """
+        Return True if the path looks like a test file.
+        """
+        import fnmatch
+        import re
+        normalized = path.replace('\\', '/')
+        parts = [p for p in normalized.split('/') if p]
+        basename = parts[-1] if parts else normalized
+        dirs = parts[:-1]
+        if any(d in ('tests', 'test') for d in dirs):
+            return True
+        if fnmatch.fnmatch(basename, 'test_*.py') or fnmatch.fnmatch(basename, '*_test.py'):
+            return True
+        if fnmatch.fnmatch(basename, '*.spec.js') or fnmatch.fnmatch(basename, '*Test.java'):
+            return True
+        if 'test' in basename.lower():
+            return True
+        return False
+
+    def _classify_diff(self, diff):
+        """
+        Classify a git diff as 'empty', 'tests_only' or 'ok'.
+        """
+        import re
+        files = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.+?) b/(.+)$', line)
+            if m:
+                files.append(m.group(2))
+        if not files:
+            return 'empty'
+        if all(self._is_test_file(f) for f in files):
+            return 'tests_only'
+        return 'ok'
+
