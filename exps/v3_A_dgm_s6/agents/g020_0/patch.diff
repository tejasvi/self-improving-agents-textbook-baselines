+    def _run_performance_gate(self, timeout=10):
+        """
+        Run the deliverable on /tmp/max_input.txt and return (ok, output_tail).
+        The output is passed through raw, without parsing.
+        """
+        max_input = '/tmp/max_input.txt'
+        if not os.path.isfile(max_input):
+            return False, f"max-size input not found at {max_input}; write a generator /tmp/gen_max.py that writes it"
+        deliverable = self._find_deliverable() or 'solution.py'
+        script = os.path.join(self.git_tempdir, deliverable)
+        if not os.path.isfile(script):
+            return False, f"deliverable {deliverable} not found"
+        try:
+            with open(max_input, 'r') as fin:
+                proc = subprocess.run(
+                    ['python3', script],
+                    stdin=fin,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                    cwd=self.git_tempdir,
+                )
+            output = (proc.stdout or '') + (proc.stderr or '')
+            return proc.returncode == 0, output[-3000:]
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout if isinstance(e.stdout, str) else ''
+            err = e.stderr if isinstance(e.stderr, str) else ''
+            return False, f"timeout after {timeout}s\n" + (out + err)[-3000:]
+
