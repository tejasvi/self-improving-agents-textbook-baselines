+    def _extract_target_filename(self):
+        """
+        Find the required output file named in the problem statement (e.g. ``solution.py``).
+        Falls back to TARGET_FILE_DEFAULT.
+        """
+        text = self.problem_statement or ''
+        for m in TARGET_FILE_RE.finditer(text):
+            name = m.group(1)
+            if name.endswith('.py') or '.' in name:
+                return name
+        return TARGET_FILE_DEFAULT
+
+    def _target_file_ok(self):
+        """
+        True if the target file exists in git_tempdir and has non-whitespace content.
+        """
+        path = os.path.join(self.git_tempdir, self._extract_target_filename())
+        if not os.path.isfile(path):
+            return False
+        try:
+            with open(path, 'r', encoding='utf-8', errors='replace') as f:
+                return bool(f.read().strip())
+        except OSError:
+            return False
