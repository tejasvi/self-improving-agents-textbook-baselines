+def _has_tool_use(msg):
+    """
+    True if the message carries any tool-call block (Claude tool_use or OpenAI function_call items).
+    """
+    if isinstance(msg, dict):
+        if msg.get('type') in ('function_call', 'tool_use'):
+            return True
+        content = msg.get('content')
+    else:
+        if getattr(msg, 'type', None) in ('function_call', 'tool_use'):
+            return True
+        content = getattr(msg, 'content', None)
+    if isinstance(content, list):
+        for block in content:
+            btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+            if btype in ('tool_use', 'function_call'):
+                return True
+    return False
+
+def _sanitize_history(msg_history):
+    """
+    Drop assistant messages that have only empty/whitespace text and no tool-use blocks.
+    """
+    cleaned = []
+    for msg in msg_history or []:
+        if _message_role(msg) == 'assistant' and not _has_tool_use(msg):
+            if not any(t.strip() for t in _message_texts(msg)):
+                continue
+        cleaned.append(msg)
+    return cleaned
+
+TARGET_FILE_DEFAULT = 'solution.py'
+TARGET_FILE_RE = re.compile(r"`([A-Za-z0-9_][A-Za-z0-9_./-]*\.[A-Za-z0-9]+)`")
