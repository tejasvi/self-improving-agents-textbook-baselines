+    def _infer_target_filename(self):
+        """Infer the target file name from a backticked filename in the problem statement, default solution.py."""
+        default = 'solution.py'
+        matches = re.findall(r'`([\w./-]+\.(?:py|js|cpp|java|go|rs))`', self.problem_statement or '')
+        for name in matches:
+            normalized = name.replace('\\', '/')
+            basename = normalized.split('/')[-1]
+            if normalized.startswith('/') or '..' in normalized.split('/'):
+                continue
+            if basename.startswith('test_') or re.search(r'_test\.[^.]+$', basename) or 'tests/' in normalized:
+                continue
+            return normalized
+        return default
+
+    def _direct_file_generation(self, task):
+        """
+        Last-resort fallback: ask the model (no tool use required) for the full contents of the
+        target file in one fenced code block, then write it under git_tempdir.
+        Returns the written path or None.
+        """
+        target = self._infer_target_filename()
+        safe_log(f"Direct file generation: target file is {target}")
+        prompt = (
+            f"{task}\n\nReply only with the full contents of {target} in one ```python block "
+            f"(or the appropriate language block). Do not use any tools. Do not include any other text."
+        )
+        try:
+            history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        except Exception as e:
+            safe_log(f"Error during direct file generation: {repr(e)}", level=logging.ERROR)
+            return None
+
+        reply = _extract_assistant_text(history)
+        match = re.search(r'```[\w+-]*\n(.*?)```', reply, re.DOTALL)
+        if not match:
+            safe_log("Direct file generation: no fenced code block found in reply.", level=logging.WARNING)
+            return None
+        code = match.group(1)
+        if not code.strip():
+            safe_log("Direct file generation: fenced code block was empty.", level=logging.WARNING)
+            return None
+
+        path = os.path.join(self.git_tempdir, target)
+        try:
+            os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
+            with open(path, 'w') as f:
+                f.write(code if code.endswith('\n') else code + '\n')
+            safe_log(f"Direct file generation: wrote {path}")
+            return path
+        except Exception as e:
+            safe_log(f"Error writing direct-generated file: {repr(e)}", level=logging.ERROR)
+            return None
+
