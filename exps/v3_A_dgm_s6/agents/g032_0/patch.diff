+def _has_agent_action(msg_history):
+    """
+    Return True if any assistant message contains a tool-use block (tool_use / function_call)
+    or a text block with non-whitespace content.
+    """
+    for msg in msg_history or []:
+        if _get_field(msg, 'role') != 'assistant':
+            continue
+        content = _get_field(msg, 'content')
+        if isinstance(content, str):
+            if content.strip():
+                return True
+            continue
+        if isinstance(content, list):
+            for block in content:
+                block_type = _get_field(block, 'type')
+                if block_type in ('tool_use', 'function_call'):
+                    return True
+                if block_type == 'text':
+                    text = _get_field(block, 'text', '')
+                    if isinstance(text, str) and text.strip():
+                        return True
+    return False
+
+def _extract_assistant_text(msg_history):
+    """Collect the text of all assistant text blocks in the history (in order)."""
+    texts = []
+    for msg in msg_history or []:
+        if _get_field(msg, 'role') != 'assistant':
+            continue
+        content = _get_field(msg, 'content')
+        if isinstance(content, str):
+            texts.append(content)
+        elif isinstance(content, list):
+            for block in content:
+                if _get_field(block, 'type') == 'text':
+                    text = _get_field(block, 'text', '')
+                    if isinstance(text, str):
+                        texts.append(text)
+    return "\n".join(texts)
