new file mode 100644
index 0000000..bc7ffc7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,96 @@
+# tools/edit.py
+# Editor tool: view / create / edit files.
+# - create: writes the file (creating parent directories) and overwrites existing content.
+# - edit:   replaces the entire content of an existing file.
+# - view:   shows the numbered contents of an existing file.
+
+from pathlib import Path
+
+
+def tool_info():
+    return {
+        "name": "editor",
+        "description": (
+            "File editor. Commands: "
+            "'view' shows the numbered contents of an existing file (path required). "
+            "'create' writes the file with file_text and overwrites existing content if the file already exists; "
+            "parent directories are created automatically (path and file_text required). "
+            "'edit' replaces the entire file with file_text; the file must already exist (path and file_text required). "
+            "Only regular files can be written; a directory path is an error."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "One of: 'view', 'create', 'edit'."
+                },
+                "path": {
+                    "type": "string",
+                    "description": "Path of the file to view, create, or edit."
+                },
+                "file_text": {
+                    "type": "string",
+                    "description": "Full new content of the file. Required for 'create' and 'edit'; ignored for 'view'."
+                }
+            },
+            "required": ["command", "path"]
+        }
+    }
+
+
+def validate_path(path, command):
+    """Validate the path for the given command and return a Path object."""
+    if not path or not str(path).strip():
+        raise ValueError("Error: path must be a non-empty string.")
+    p = Path(str(path)).expanduser()
+    if p.is_dir():
+        raise IsADirectoryError(f"Error: {p} is a directory, not a file.")
+    if command in ("view", "edit") and not p.exists():
+        raise FileNotFoundError(f"Error: {p} does not exist.")
+    if command == "view" and not p.is_file():
+        raise IsADirectoryError(f"Error: {p} is not a regular file.")
+    return p
+
+
+def _view(p):
+    text = p.read_text(encoding="utf-8")
+    lines = text.splitlines()
+    if not lines:
+        return f"File {p} is empty."
+    width = len(str(len(lines)))
+    return "\n".join(f"{i:>{width}}\t{line}" for i, line in enumerate(lines, start=1))
+
+
+def _write(p, content):
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with open(p, "w", encoding="utf-8") as f:
+        f.write(content)
+
+
+def tool_function(command, path, file_text=None):
+    """Execute an editor command and return a result string."""
+    try:
+        if command not in ("view", "create", "edit"):
+            return f"Error: unknown command '{command}'. Use 'view', 'create', or 'edit'."
+
+        p = validate_path(path, command)
+
+        if command == "view":
+            return _view(p)
+
+        if file_text is None:
+            return f"Error: file_text is required for command '{command}'."
+
+        if command == "create":
+            existed = p.exists()
+            _write(p, file_text)
+            action = "overwritten" if existed else "created"
+            return f"File {action} successfully at: {p}"
+
+        # command == "edit": replace entire content of an existing file
+        _write(p, file_text)
+        return f"File edited successfully (entire content replaced): {p}"
+
+    except Exception as e:
+        return f"Error: {type(e).__name__}: {e}"
