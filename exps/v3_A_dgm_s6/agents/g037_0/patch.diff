+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + f"\n... [output truncated, {len(text) - limit} chars omitted] ...\n" + text[-half:]
+
+
+def run_command(command, timeout=COMMAND_TIMEOUT):
+    """Run a bash command in its own process group; kill the whole group on timeout."""
+    proc = subprocess.Popen(
+        ["bash", "-lc", command],
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        start_new_session=True,
+    )
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        try:
+            proc.communicate(timeout=5)
+        except Exception:
+            pass
+        return (
+            f"Error: command timed out after {timeout} seconds and was killed. "
+            "Use short, bounded commands (e.g. `timeout 20 python3 sol.py < in.txt`); "
+            "avoid whole-repo `find`/`grep -r` and programs that wait for stdin or run forever."
         )
+    out = stdout.decode(errors='replace').strip()
+    err = filter_error(stderr.decode(errors='replace')).strip()
+    result = ""
+    if out:
+        result += out
+    if err:
+        result += ("\n" if result else "") + "Error:\n" + err
+    if proc.returncode != 0 and not err:
+        result += ("\n" if result else "") + f"(exit code {proc.returncode})"
+    return _truncate(result.strip())
+
