diff --git a/stress_empty_reply.py b/stress_empty_reply.py
new file mode 100644
index 0000000..c706add
--- /dev/null
+++ b/stress_empty_reply.py
@@ -0,0 +1,79 @@
+"""Stress test: the repair loop must see an empty final model reply.
+
+Compares coding_agent's empty-reply detection against a reference over random
+histories (including the smallest counterexample), and checks that
+AgenticSystem.forward() runs a repair round when the model replies with whitespace.
+Prints 'ALL OK' or the first MISMATCH.
+"""
+import os, random, subprocess, sys, tempfile
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import coding_agent as ca
+
+
+def text_msg(role, text):
+    return {"role": role, "content": [{"type": "text", "text": text}]}
+
+
+def reference_empty(raw):
+    """Reference: is the final assistant turn in the raw reply blank?"""
+    asst = [m for m in raw if m["role"] == "assistant"]
+    if not asst:
+        return True
+    return not any(b["text"].strip() for b in asst[-1]["content"])
+
+
+def random_history(rng):
+    msgs = [text_msg("user", "task")]
+    for _ in range(rng.randint(0, 5)):
+        role = rng.choice(["user", "assistant"])
+        msgs.append(text_msg(role, rng.choice(["", "  ", "\n", "plan", "ok"])))
+    return msgs
+
+
+def check_helpers():
+    # Smallest counterexample: non-empty plan, then whitespace-only reply.
+    smallest = [text_msg("user", "task"), text_msg("assistant", "plan"),
+                text_msg("user", "continue"), text_msg("assistant", "  ")]
+    if ca._last_message_empty(smallest) is not True:
+        return "smallest counterexample: raw reply should be empty"
+    rng = random.Random(0)
+    for i in range(20000):
+        raw = random_history(rng)
+        if ca._last_message_empty(raw) != reference_empty(raw):
+            return f"helper mismatch on case {i}: {raw}"
+    return None
+
+
+def check_forward():
+    repo = tempfile.mkdtemp()
+    subprocess.run(["git", "init", "-q", repo], check=True)
+    open(os.path.join(repo, "README.md"), "w").write("x\n")
+    subprocess.run(["git", "-C", repo, "add", "."], check=True)
+    subprocess.run(["git", "-C", repo, "-c", "user.email=a@b", "-c", "user.name=n",
+                    "commit", "-qm", "init"], check=True)
+    base = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"],
+                          capture_output=True, text=True).stdout.strip()
+    calls = {"n": 0}
+
+    def fake_chat(prompt, model=None, msg_history=None, logging=None):
+        calls["n"] += 1
+        reply = "Plan: write solution.py" if calls["n"] == 1 else "   "
+        return (msg_history or []) + [text_msg("user", prompt), text_msg("assistant", reply)]
+
+    ca.chat_with_agent = fake_chat
+    logf = os.path.join(repo, "chat.md")
+    agent = ca.AgenticSystem(problem_statement="Write `solution.py`.", git_tempdir=repo,
+                             base_commit=base, chat_history_file=logf)
+    agent.forward()
+    log = open(logf).read() if os.path.exists(logf) else ""
+    if "Repair round" not in log:
+        return f"forward() did not run a repair round for an empty reply (calls={calls['n']})"
+    return None
+
+
+if __name__ == "__main__":
+    err = check_helpers() or check_forward()
+    if err:
+        print("MISMATCH:", err)
+        sys.exit(1)
+    print("ALL OK")
diff --git a/stress_filter_error.py b/stress_filter_error.py
new file mode 100644
index 0000000..f369b07
--- /dev/null
+++ b/stress_filter_error.py
@@ -0,0 +1,41 @@
+"""Stress test: bounds-safe filter_error must match the original wherever the
+original does not crash, and must never raise. Prints 'ALL OK' or MISMATCH."""
+import importlib.util, os, random, sys
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from tools.bash import filter_error as new_filter
+
+# Original implementation, loaded from the pre-change snapshot
+ORIG = "/tmp/bash.orig.py"
+if os.path.exists(ORIG):
+    spec = importlib.util.spec_from_file_location("bash_orig", ORIG)
+    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+    old_filter = m.filter_error
+else:
+    old_filter = None
+
+PIECES = ["Inappropriate ioctl for device", "<<exit>>", "real error", "", "warn", "  x  "]
+
+def random_err(rng):
+    return "\n".join(rng.choice(PIECES) for _ in range(rng.randint(0, 7)))
+
+rng = random.Random(1)
+compared = 0
+for i in range(50000):
+    s = random_err(rng)
+    try:
+        got = new_filter(s)
+    except Exception as e:
+        print(f"MISMATCH: new filter_error raised {e!r} on {s!r}")
+        sys.exit(1)
+    if old_filter is not None:
+        try:
+            want = old_filter(s)
+        except IndexError:
+            continue  # original crashed; new behaviour is the fix
+        compared += 1
+        if got != want:
+            print(f"MISMATCH on {s!r}: new={got!r} old={want!r}")
+            sys.exit(1)
+print(f"compared={compared}")
+print("ALL OK")
