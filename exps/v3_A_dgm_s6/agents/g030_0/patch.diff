+    _STUB_MARKERS = ('pass', 'TODO', 'unimplemented', 'NotImplemented')
+
+    def _language_extensions(self):
+        return {
+            'python': ('.py',),
+            'cpp': ('.cpp', '.cc', '.h', '.hpp'),
+            'java': ('.java',),
+            'go': ('.go',),
