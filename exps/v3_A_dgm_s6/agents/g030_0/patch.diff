+    def _snapshot_repo(self, max_chars=6000, max_listing=200):
+        """
+        Deterministically locate the primary solution file in the repo (no LLM).
+        Returns (path, contents, file_listing); path is None if no candidate found.
+        """
+        files = []
+        for root, dirs, names in os.walk(self.git_tempdir):
+            dirs[:] = [d for d in dirs if d not in self._SNAPSHOT_SKIP_DIRS]
+            for name in names:
+                full = os.path.join(root, name)
+                rel = os.path.relpath(full, self.git_tempdir).replace('\\', '/')
+                files.append(rel)
+        files.sort()
+        listing = '\n'.join(files[:max_listing])
+
+        exts = self._language_extensions()
+        candidates = [f for f in files if not self._is_test_file(f) and f.endswith(exts)]
+        if not candidates:
+            return None, '', listing
+
+        def read(rel):
+            try:
+                with open(os.path.join(self.git_tempdir, rel), 'r', errors='ignore') as fh:
+                    return fh.read()
+            except OSError:
+                return ''
+
+        preferred_names = ('solution', 'main', 'lib', 'src')
+        def stem(rel):
+            return os.path.splitext(os.path.basename(rel))[0].lower()
+
+        named = [f for f in candidates if stem(f) in preferred_names]
+        pool = named if named else candidates
+        with_stub = [f for f in pool if any(m in read(f) for m in self._STUB_MARKERS)]
+        pool = with_stub if with_stub else pool
+        chosen = min(pool, key=lambda f: (len(read(f)), f))
+        contents = read(chosen)
+        if len(contents) > max_chars:
+            contents = contents[:max_chars] + '\n... [truncated]'
+        return chosen, contents, listing
+
+    @staticmethod
+    def _last_assistant_is_empty(msg_history):
+        """
+        Returns True if the last assistant message has no non-whitespace text.
+        """
+        if not isinstance(msg_history, list):
+            return False
+        for msg in reversed(msg_history):
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return not content.strip()
+            if isinstance(content, list):
+                text = ''.join(
+                    b.get('text', '') for b in content
+                    if isinstance(b, dict) and isinstance(b.get('text'), str)
+                )
+                has_tool = any(isinstance(b, dict) and b.get('type') == 'tool_use' for b in content)
+                return not text.strip() and not has_tool
+            return True
+        return False
