+def _block_type(block):
+    if isinstance(block, dict):
+        return block.get('type')
+    return getattr(block, 'type', None)
+
+def _block_text(block):
+    if isinstance(block, dict):
+        return block.get('text')
+    return getattr(block, 'text', None)
+
+def _summarize_history(msg_history):
+    """Return (num_messages, num_tool_use_blocks, last_assistant_text_empty) for logging."""
+    if not isinstance(msg_history, list):
+        return 0, 0, True
+    tool_uses = 0
+    for msg in msg_history:
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, list):
+            tool_uses += sum(1 for b in content if _block_type(b) == 'tool_use')
+    return len(msg_history), tool_uses, _last_turn_was_empty(msg_history)
+
+def _last_turn_was_empty(msg_history):
+    """
+    Returns True if the last message is an assistant message with no tool_use blocks
+    and no non-whitespace text. Falls back to True if the history is not a list.
+    """
+    if not isinstance(msg_history, list):
+        return True
+    if not msg_history:
+        return False
+    last = msg_history[-1]
+    role = last.get('role') if isinstance(last, dict) else getattr(last, 'role', None)
+    if role != 'assistant':
+        return False
+    content = last.get('content') if isinstance(last, dict) else getattr(last, 'content', None)
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return not content.strip()
+    if not isinstance(content, list):
+        return True
+    for block in content:
+        if _block_type(block) == 'tool_use':
+            return False
+        text = _block_text(block)
+        if isinstance(text, str) and text.strip():
+            return False
+    return True
+
+def _strip_trailing_empty_assistant(msg_history):
+    """Pops trailing empty assistant messages so they do not prime further empty replies."""
+    if not isinstance(msg_history, list):
+        return []
+    for _ in range(len(msg_history)):
+        if not _last_turn_was_empty(msg_history):
+            break
+        msg_history.pop()
+    return msg_history
+
