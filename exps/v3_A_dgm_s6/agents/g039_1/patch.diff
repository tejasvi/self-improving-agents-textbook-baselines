+    @staticmethod
+    def _sanitize_history(msg_history):
+        """
+        Removes trailing assistant messages with no non-whitespace text and no tool_use blocks,
+        and merges consecutive messages of the same role. Returns a new list.
+        """
+        if not isinstance(msg_history, list):
+            return []
+        cleaned = [m for m in msg_history if isinstance(m, dict)]
+
+        def is_empty_assistant(msg):
+            if msg.get('role') != 'assistant':
+                return False
+            content = msg.get('content')
+            if isinstance(content, str):
+                return not content.strip()
+            if isinstance(content, list):
+                text = ''.join(
+                    b.get('text', '') for b in content
+                    if isinstance(b, dict) and isinstance(b.get('text'), str)
+                )
+                has_tool = any(isinstance(b, dict) and b.get('type') == 'tool_use' for b in content)
+                return not text.strip() and not has_tool
+            return not content
+
+        for _ in range(len(cleaned)):
+            if not cleaned or not is_empty_assistant(cleaned[-1]):
+                break
+            cleaned.pop()
+
+        merged = []
+        for msg in cleaned:
+            if merged and merged[-1].get('role') == msg.get('role'):
+                prev = merged[-1]
+                prev_content = prev.get('content')
+                new_content = msg.get('content')
+                if isinstance(prev_content, str):
+                    prev_content = [{"type": "text", "text": prev_content}]
+                if isinstance(new_content, str):
+                    new_content = [{"type": "text", "text": new_content}]
+                merged[-1] = {**prev, "content": list(prev_content or []) + list(new_content or [])}
+            else:
+                merged.append(dict(msg))
+        return merged
+
+    def _force_write_solution(self, path):
+        """
+        Last resort: ask the model in a fresh context for the full file contents and write them directly.
+        Returns True if a non-empty file was written.
+        """
+        if not path:
+            return False
+        prompt = (
+            f"Solve this competitive programming problem.\n\n<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            f"Output ONLY the complete contents of {path} in one ```python code block, with no explanation."
+        )
+        msg_history = chat_with_agent(prompt, model=self.code_model, msg_history=[], logging=safe_log)
+        msg_history = self._sanitize_history(msg_history)
+        text = ''
+        for msg in reversed(msg_history):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                text = content
+            elif isinstance(content, list):
+                text = ''.join(
+                    b.get('text', '') for b in content
+                    if isinstance(b, dict) and isinstance(b.get('text'), str)
+                )
+            break
+        blocks = re.findall(r"```[ \t]*(?:python|py)?[ \t]*\n(.*?)```", text, flags=re.DOTALL)
+        if not blocks or not blocks[-1].strip():
+            safe_log("[forward] Forced write: no fenced code block found in reply.")
+            return False
+        code = blocks[-1]
+        if re.search(r'\bList\b', code) and 'from typing import' not in code and 'import typing' not in code:
+            code = 'from typing import List\n' + code
+        full_path = os.path.join(self.git_tempdir, path)
+        os.makedirs(os.path.dirname(full_path) or '.', exist_ok=True)
+        with open(full_path, 'w') as fh:
+            fh.write(code if code.endswith('\n') else code + '\n')
+        safe_log(f"[forward] Forced write of {path} from fenced code block.")
+        return True
+
