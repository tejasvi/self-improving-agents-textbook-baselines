     def _mentioned_deliverables(self):
         """
         Python file names mentioned in backticks in the problem statement, e.g. `solution.py`.
+        For stdin/stdout problems with no backticked file, defaults to solution.py.
+        """
+        found = re.findall(r'`([\w./-]+\.py)`', self.problem_statement or '')
+        if not found and self._is_stdio_problem():
