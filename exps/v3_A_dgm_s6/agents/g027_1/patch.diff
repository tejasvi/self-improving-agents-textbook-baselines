+    @staticmethod
+    def _is_empty_block(block):
+        if isinstance(block, dict):
+            block_type = block.get('type')
+            text = block.get('text')
+        else:
+            block_type = getattr(block, 'type', None)
+            text = getattr(block, 'text', None)
+        if block_type == 'tool_use':
+            return False
+        if block_type == 'text':
+            return not (text or '').strip()
+        return False
+
+    def _sanitize_history(self, msg_history):
+        """
+        Drop assistant messages that are empty: no content, or only blank text blocks
+        with no tool_use blocks. Keeps all other messages unchanged.
+        """
+        if not isinstance(msg_history, list):
+            return []
+        cleaned = []
+        for msg in msg_history:
+            if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                content = msg.get('content')
+                if content is None or (isinstance(content, str) and not content.strip()):
+                    continue
+                if isinstance(content, list):
+                    has_tool_use = any(
+                        (b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)) == 'tool_use'
+                        for b in content
+                    )
+                    if not has_tool_use and all(self._is_empty_block(b) for b in content):
+                        continue
+            cleaned.append(msg)
+        return cleaned
+
+    def _find_solution_class_file(self):
+        """
+        Path of a .py file under git_tempdir that defines `class Solution`, or None.
+        """
+        for root, dirs, files in os.walk(self.git_tempdir):
+            dirs[:] = [d for d in dirs if d != '.git']
+            for name in files:
+                if not name.endswith('.py'):
+                    continue
+                path = os.path.join(root, name)
+                try:
+                    with open(path, 'r', encoding='utf-8', errors='replace') as f:
+                        if re.search(r'^\s*class\s+Solution\b', f.read(), re.MULTILINE):
+                            return path
+                except OSError:
+                    continue
+        return None
