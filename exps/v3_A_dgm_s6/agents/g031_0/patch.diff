+    def _py_compiles(self, rel_path):
+        """True if `python -m py_compile` succeeds on the file under git_tempdir."""
+        full = os.path.join(self.git_tempdir, rel_path)
+        if not os.path.isfile(full):
+            return False
+        try:
+            result = subprocess.run(
+                ['python', '-m', 'py_compile', full],
+                cwd=self.git_tempdir, capture_output=True, text=True, timeout=60,
+            )
+            return result.returncode == 0
+        except (OSError, subprocess.SubprocessError) as e:
+            safe_log(f"[compile] py_compile could not run on {rel_path}: {e}")
+            return False
