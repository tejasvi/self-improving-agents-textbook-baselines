+    def _changed_files(self):
+        """
+        Return the list of files changed or untracked in git_tempdir (from `git status --porcelain`).
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+        files = []
+        for line in result.stdout.decode('utf-8', errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            # Renames appear as "old -> new"; the new path is the one that matters
+            if ' -> ' in path:
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                files.append(path)
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Heuristically decide whether a path refers to a test file.
+        """
+        norm = path.replace('\\', '/')
+        parts = [p for p in norm.split('/') if p]
+        if not parts:
+            return False
+        # Files inside test directories
+        if any(p.lower() in ('test', 'tests', '__tests__', 'spec', 'specs') for p in parts[:-1]):
+            return True
+        name = parts[-1].lower()
+        test_patterns = (
+            name.startswith('test_'),
+            name.endswith('_test.py'),
+            name.endswith('_test.go'),
+            name.endswith('_test.rs'),
+            name.endswith('.test.js'),
+            name.endswith('.test.ts'),
+            name.endswith('.spec.js'),
+            name.endswith('.spec.ts'),
+            name.endswith('test.java'),
+            name.endswith('tests.java'),
+            name == 'conftest.py',
+        )
+        return any(test_patterns)
+
+    def _has_source_edit(self):
+        """
+        True only if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in self._changed_files())
+
