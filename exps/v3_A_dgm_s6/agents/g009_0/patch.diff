+    def _find_target_file(self):
+        """
+        Returns the primary solution file in the repo: solution.py if present,
+        otherwise the first non-test .py file in the repo root, or None.
+        """
+        solution = os.path.join(self.git_tempdir, 'solution.py')
+        if os.path.isfile(solution):
+            return solution
+        try:
+            names = sorted(os.listdir(self.git_tempdir))
+        except OSError:
+            return None
+        for name in names:
+            path = os.path.join(self.git_tempdir, name)
+            if name.endswith('.py') and os.path.isfile(path) and not self._is_test_file(name):
+                return path
+        return None
+
+    @staticmethod
+    def _extract_text(msg):
+        """
+        Returns the concatenated text of a message (dict or object form), or ''.
+        """
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if isinstance(content, str):
+            return content
+        if not isinstance(content, list):
+            return ''
+        parts = []
+        for block in content:
+            if isinstance(block, dict):
+                if block.get('type') == 'text' and block.get('text'):
+                    parts.append(block['text'])
+            elif getattr(block, 'type', None) == 'text' and getattr(block, 'text', None):
+                parts.append(block.text)
+        return ''.join(parts)
+
+    @staticmethod
+    def _has_tool_use(msg):
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if not isinstance(content, list):
+            return False
+        for block in content:
+            btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+            if btype in ('tool_use', 'function_call'):
+                return True
+        return False
+
+    def _is_empty_response(self, msg_history):
+        """
+        True if the last assistant message has no tool-use blocks and near-empty text.
+        """
+        last = None
+        for msg in msg_history or []:
+            role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+            if role == 'assistant':
+                last = msg
+        if last is None:
+            empty = True
+        else:
+            empty = (not self._has_tool_use(last)) and len(self._extract_text(last).strip()) < 20
+        safe_log(f"[forward] Empty response check: {empty}")
+        return empty
+
+    def _has_real_progress(self, msg_history):
+        """
+        True if the history contains at least one tool call and some non-empty assistant text.
+        """
+        has_tool = any(self._has_tool_use(m) for m in msg_history or [])
+        has_text = any(len(self._extract_text(m).strip()) >= 20 for m in msg_history or [])
+        return has_tool and has_text
+
+    def _run_chat(self, msg, msg_history):
+        result = chat_with_agent(msg, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        if not isinstance(result, list):
+            safe_log("[forward] chat_with_agent did not return a history list; using empty history.")
+            return []
+        return result
+
+    def _check_compile(self, target):
+        """
+        Runs py_compile on target; returns the raw stderr on failure, else None.
+        """
+        result = subprocess.run(
+            ["python", "-m", "py_compile", target],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
+        )
+        if result.returncode != 0:
+            return result.stderr
+        return None
+
