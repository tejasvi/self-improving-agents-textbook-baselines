+TARGET_FILE_RE = re.compile(r'`([\w./-]+\.(py|js|go|rs|java|cpp))`')
+
+def _guess_target_file(problem_statement):
+    """
+    Return the first backticked source filename mentioned in the problem statement, or None.
+    """
+    if not problem_statement:
+        return None
+    m = TARGET_FILE_RE.search(problem_statement)
+    return m.group(1) if m else None
+
+def _is_empty_assistant_message(msg):
+    """
+    True for a dict assistant message with no tool_use blocks and no non-whitespace text.
+    """
+    if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+        return False
+    content = msg.get('content')
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ''
+    if isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict):
+                if block.get('type') == 'tool_use':
+                    return False
+                if isinstance(block.get('text'), str) and block['text'].strip():
+                    return False
+                if block.get('type') not in (None, 'text'):
+                    return False
+            elif isinstance(block, str):
+                if block.strip():
+                    return False
+            else:
+                return False
+        return True
+    return False
+
+def _to_block_list(content):
+    if content is None:
+        return []
+    if isinstance(content, str):
+        return [{'type': 'text', 'text': content}]
+    if isinstance(content, list):
+        return list(content)
+    return None
+
+def _sanitize_history(msg_history):
+    """
+    Drop empty assistant messages (no tool_use, whitespace-only text) and merge
+    adjacent dict messages with the same role. Non-dict shapes are kept unchanged.
+    """
+    if not msg_history:
+        return []
+    cleaned = []
+    for msg in msg_history:
+        if not isinstance(msg, dict):
+            cleaned.append(msg)
+            continue
+        if _is_empty_assistant_message(msg):
+            continue
+        if cleaned and isinstance(cleaned[-1], dict) and cleaned[-1].get('role') == msg.get('role'):
+            prev_blocks = _to_block_list(cleaned[-1].get('content'))
+            new_blocks = _to_block_list(msg.get('content'))
+            if prev_blocks is not None and new_blocks is not None:
+                merged = dict(cleaned[-1])
+                merged['content'] = prev_blocks + new_blocks
+                cleaned[-1] = merged
+                continue
+        cleaned.append(msg)
+    return cleaned
+
