+    @staticmethod
+    def _is_test_file(path):
+        normalized = path.replace('\\', '/')
+        parts = normalized.split('/')
+        basename = parts[-1]
+        if fnmatch.fnmatch(basename, 'test_*') or fnmatch.fnmatch(basename, '*_test.*') or fnmatch.fnmatch(basename, '*.spec.*'):
+            return True
+        return any(p in ('tests', 'test') for p in parts[:-1])
+
+    def _has_source_edits(self, diff):
+        """
+        Returns True if at least one changed file in the diff is not a test file.
+        """
+        if not diff:
+            return False
+        for line in str(diff).splitlines():
+            match = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+            if match:
+                changed_path = match.group(2).strip()
+                if not self._is_test_file(changed_path):
+                    return True
+        return False
+
