+def _get_field(obj, key, default=None):
+    """Read a field from a dict-like or attribute-style block/message."""
+    if isinstance(obj, dict):
+        return obj.get(key, default)
+    return getattr(obj, key, default)
+
+def _is_tool_block(block):
+    block_type = _get_field(block, 'type')
+    return block_type in ('tool_use', 'tool_result', 'function_call', 'function_call_output')
+
+def _sanitize_history(msg_history):
+    """
+    Remove empty/whitespace-only text blocks, drop messages left without content,
+    and strip trailing assistant messages that have no tool use and no non-blank text.
+    Handles both string content and list-of-block content.
+    """
+    if not msg_history:
+        return []
+
+    sanitized = []
+    for msg in msg_history:
+        content = _get_field(msg, 'content')
+        if isinstance(content, str):
+            if not content.strip():
+                continue
+            new_msg = dict(msg) if isinstance(msg, dict) else msg
+        elif isinstance(content, list):
+            new_blocks = []
+            for block in content:
+                if _get_field(block, 'type') == 'text':
+                    text = _get_field(block, 'text', '')
+                    if not isinstance(text, str) or not text.strip():
+                        continue
+                new_blocks.append(block)
+            if not new_blocks:
+                continue
+            if isinstance(msg, dict):
+                new_msg = dict(msg)
+                new_msg['content'] = new_blocks
+            else:
+                new_msg = msg
+        else:
+            if content is None:
+                continue
+            new_msg = msg
+        sanitized.append(new_msg)
+
+    # Strip trailing assistant messages with no tool use and no non-blank text
+    while sanitized:
+        last = sanitized[-1]
+        if _get_field(last, 'role') != 'assistant':
+            break
+        content = _get_field(last, 'content')
+        if isinstance(content, str):
+            has_real = bool(content.strip())
+        elif isinstance(content, list):
+            has_real = any(
+                _is_tool_block(b) or (
+                    _get_field(b, 'type') == 'text' and str(_get_field(b, 'text', '')).strip()
+                )
+                for b in content
+            )
+        else:
+            has_real = False
+        if has_real:
+            break
+        sanitized.pop()
+    return sanitized
+
