+    def _run_chat(self, instruction, msg_history):
+        """
+        Call chat_with_agent safely. Returns the sanitized resulting history,
+        or the previous sanitized history if the call fails.
+        """
+        previous = _sanitize_history(msg_history)
+        try:
+            new_history = chat_with_agent(
+                instruction,
+                model=self.code_model,
+                msg_history=previous,
+                logging=safe_log,
+            )
+            return _sanitize_history(new_history)
+        except Exception as e:
+            safe_log(f"Error during retry chat call: {repr(e)}", level=logging.ERROR)
+            return previous
+
