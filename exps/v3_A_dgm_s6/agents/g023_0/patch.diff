@@ -0,0 +1,59 @@
+import difflib
+import subprocess
+
+def tool_info():
+    return {
+        "name": "sample_diff",
+        "description": """Run a command on a sample input and compare its stdout byte for byte with the expected output.\n
+* The command is executed with a shell; the sample input is piped to its stdin.\n
+* Returns 'PASS' if stdout exactly equals the expected output (ignoring only trailing newlines), otherwise 'FAIL' followed by a unified diff (expected vs actual).\n
+* Use this for EVERY sample in the problem statement. Pass the sample input and expected output exactly as given in the problem statement.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command that runs the solution, e.g. 'python3 /path/to/solution.py'."
+                },
+                "sample_input": {
+                    "type": "string",
+                    "description": "The exact sample input to feed to the program's stdin."
+                },
+                "expected_output": {
+                    "type": "string",
+                    "description": "The exact expected output from the problem statement for this sample."
+                }
+            },
+            "required": ["command", "sample_input", "expected_output"]
+        }
+    }
+
+def tool_function(command, sample_input, expected_output):
+    stdin_text = sample_input if sample_input.endswith("\n") else sample_input + "\n"
+    try:
+        proc = subprocess.run(
+            command,
+            shell=True,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=60,
+        )
+    except subprocess.TimeoutExpired:
+        return "FAIL: command timed out after 60 seconds."
+
+    actual = proc.stdout
+    if actual.rstrip("\n") == expected_output.rstrip("\n"):
+        return "PASS"
+
+    diff_lines = difflib.unified_diff(
+        expected_output.rstrip("\n").split("\n"),
+        actual.rstrip("\n").split("\n"),
+        fromfile="expected",
+        tofile="actual",
+        lineterm="",
+    )
+    result = "FAIL\n" + "\n".join(diff_lines)
+    if proc.returncode != 0:
+        result += f"\n[exit code {proc.returncode}]\nstderr:\n{proc.stderr}"
+    return result
