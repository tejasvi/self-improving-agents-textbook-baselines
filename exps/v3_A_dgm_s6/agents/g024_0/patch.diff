+import glob
+import os
+import subprocess
+import sys
+
+MAX_SHOW = 600
+
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python solution against the test directory built for the problem.\n
+* Runs the solution on every *.in file in tests_dir and compares its stdout with the matching *.out file (whitespace-tolerant).\n
+* If brute.py and gen.py exist in tests_dir, it also runs gen.py with seeds 0..num_random-1, then compares the solution's output with brute.py's output on each generated input.\n
+* Reports sample pass counts, mismatch counts, timeouts, and the first counterexample (input, expected output, actual output).\n
+* Use it after writing or changing the solution file to check correctness.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the Python solution file to test, e.g. /repo/solution.py."
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Absolute path to the directory containing *.in, *.out, brute.py and gen.py."
+                },
+                "num_random": {
+                    "type": "integer",
+                    "description": "Number of random seeds to run through gen.py and brute.py. Defaults to 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Per-run timeout in seconds. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "tests_dir"]
+        }
+    }
+
+
+def _run_py(script, stdin_text, timeout, args=None):
+    """Run a Python script with stdin. Returns (status, stdout) where status is 'ok', 'timeout', or 'error'."""
+    cmd = [sys.executable, script] + (args or [])
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", ""
+    if proc.returncode != 0:
+        return "error", proc.stderr
+    return "ok", proc.stdout
+
+
+def _same_output(a, b):
+    return a.split() == b.split()
+
+
+def _clip(text):
+    text = text or ""
+    if len(text) > MAX_SHOW:
+        return text[:MAX_SHOW] + "...(truncated)"
+    return text
+
+
+def evaluate(solution_path, tests_dir, num_random=200, timeout=10):
+    """
+    Deterministic scoring. Returns a dict with:
+      samples_total, samples_passed, random_total, mismatches, timeouts,
+      first_failure (dict or None), score (tuple: higher is better).
+    """
+    result = {
+        "samples_total": 0,
+        "samples_passed": 0,
+        "random_total": 0,
+        "mismatches": 0,
+        "timeouts": 0,
+        "first_failure": None,
+        "errors": [],
+    }
+
+    if not os.path.isfile(solution_path):
+        result["errors"].append(f"solution file not found: {solution_path}")
+        result["score"] = (0, -1, 0)
+        return result
+
+    # 1. Samples
+    in_files = sorted(glob.glob(os.path.join(tests_dir, "*.in")))
+    for in_path in in_files:
+        out_path = in_path[:-3] + ".out"
+        if not os.path.isfile(out_path):
+            continue
+        result["samples_total"] += 1
+        with open(in_path) as f:
+            sample_in = f.read()
+        with open(out_path) as f:
+            expected = f.read()
+        status, actual = _run_py(solution_path, sample_in, timeout)
+        if status == "timeout":
+            result["timeouts"] += 1
+            if result["first_failure"] is None:
+                result["first_failure"] = {"source": os.path.basename(in_path), "input": sample_in,
+                                           "expected": expected, "actual": "TIMEOUT"}
+        elif status == "error":
+            if result["first_failure"] is None:
+                result["first_failure"] = {"source": os.path.basename(in_path), "input": sample_in,
+                                           "expected": expected, "actual": "RUNTIME ERROR: " + _clip(actual)}
+        elif _same_output(actual, expected):
+            result["samples_passed"] += 1
+        elif result["first_failure"] is None:
+            result["first_failure"] = {"source": os.path.basename(in_path), "input": sample_in,
+                                       "expected": expected, "actual": actual}
+
+    # 2. Random stress against brute.py and gen.py
+    brute_path = os.path.join(tests_dir, "brute.py")
+    gen_path = os.path.join(tests_dir, "gen.py")
+    if os.path.isfile(brute_path) and os.path.isfile(gen_path):
+        for seed in range(max(0, int(num_random))):
+            gen_status, gen_input = _run_py(gen_path, "", timeout, args=[str(seed)])
+            if gen_status != "ok":
+                result["errors"].append(f"gen.py failed for seed {seed} ({gen_status})")
+                break
+            brute_status, expected = _run_py(brute_path, gen_input, timeout)
+            if brute_status != "ok":
+                result["errors"].append(f"brute.py failed on seed {seed} ({brute_status})")
+                continue
+            result["random_total"] += 1
+            status, actual = _run_py(solution_path, gen_input, timeout)
+            if status == "timeout":
+                result["timeouts"] += 1
+                actual_text = "TIMEOUT"
+            elif status == "error":
+                result["mismatches"] += 1
+                actual_text = "RUNTIME ERROR: " + _clip(actual)
+            elif _same_output(actual, expected):
+                continue
+            else:
+                result["mismatches"] += 1
+                actual_text = actual
+            if result["first_failure"] is None:
+                result["first_failure"] = {"source": f"gen.py seed {seed}", "input": gen_input,
+                                           "expected": expected, "actual": actual_text}
+
+    result["score"] = (result["samples_passed"], -result["mismatches"], -result["timeouts"])
+    return result
+
+
+def format_result(res):
+    lines = []
+    lines.append(f"Samples: {res['samples_passed']}/{res['samples_total']} passed.")
+    if res["random_total"]:
+        lines.append(f"Random: {res['random_total'] - res['mismatches'] - res['timeouts']}/{res['random_total']} matched brute.py "
+                     f"({res['mismatches']} mismatches, {res['timeouts']} timeouts).")
+    elif res["timeouts"]:
+        lines.append(f"Timeouts: {res['timeouts']}.")
+    for err in res["errors"][:3]:
+        lines.append(f"Harness note: {err}")
+    ff = res["first_failure"]
+    if ff is None:
+        lines.append("All checks passed.")
+    else:
+        lines.append(f"First failure ({ff['source']}):")
+        lines.append(f"Input:\n{_clip(ff['input'])}")
+        lines.append(f"Expected:\n{_clip(ff['expected'])}")
+        lines.append(f"Actual:\n{_clip(ff['actual'])}")
+    return "\n".join(lines)
+
+
+def tool_function(solution_path, tests_dir, num_random=200, timeout=10):
+    res = evaluate(solution_path, tests_dir, num_random=num_random, timeout=timeout)
+    return format_result(res)
