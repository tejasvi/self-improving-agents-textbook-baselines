diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..ed8c8de
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,196 @@
+import os
+import re
+import subprocess
+import sys
+import time
+
+DEFAULT_TIMEOUT = 10.0
+MAX_SAMPLE_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution file against a list of sample test cases and check the output for exact conformance.
+
+* For each sample, runs `python3 <solution_path>` with the sample's `input` on stdin.
+* Compares the actual stdout with `expected_output` ignoring only trailing whitespace at the end of lines and at the end of the output. Any other difference is a FAIL.
+* Returns, for every sample, PASS/FAIL, the actual output, the expected output, and the runtime, followed by a summary count.
+* Extract every sample input and expected output from the problem statement yourself and pass them in `samples`. Each sample is an object with `input` and `expected_output` strings. Use the exact text from the statement.
+* Optionally pass `problem_statement_path` (a text file containing the statement) instead of or in addition to `samples`; the sample blocks labelled 'Sample Input N' / 'Sample Output N' are then parsed from that file.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run, e.g. solution.py."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases. Each item is an object with 'input' (stdin text) and 'expected_output' (exact expected stdout text).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact stdin text for this sample."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "The exact expected stdout text for this sample."
+                            }
+                        },
+                        "required": ["input", "expected_output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each sample run. Defaults to 10."
+                },
+                "problem_statement_path": {
+                    "type": "string",
+                    "description": "Optional path to a text file with the problem statement. Sample blocks 'Sample Input N' / 'Sample Output N' are parsed from it and appended to `samples`."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def parse_samples_from_text(text):
+    """
+    Parse 'Sample Input N' / 'Sample Output N' blocks from text.
+
+    A block starts at a header line (case-insensitive, e.g. 'Sample Input 1' or
+    'Sample Input #1' ) and continues until the next header line or a section
+    marker such as 'Note' / 'Explanation'. Returns a list of
+    {'input': str, 'expected_output': str} dicts ordered by sample number.
+    """
+    header_re = re.compile(r'^\s*sample\s+(input|output)\s*#?\s*(\d+)\s*:?\s*$', re.IGNORECASE)
+    end_re = re.compile(r'^\s*(note|notes|explanation)\b', re.IGNORECASE)
+
+    blocks = {}  # number -> {'input': [...], 'output': [...]}
+    current = None  # (kind, number)
+    for line in text.splitlines():
+        m = header_re.match(line)
+        if m:
+            kind = m.group(1).lower()
+            num = int(m.group(2))
+            blocks.setdefault(num, {'input': None, 'output': None})
+            blocks[num][kind] = []
+            current = (kind, num)
+            continue
+        if end_re.match(line) or re.match(r'^\s*#{1,6}\s', line):
+            current = None
+            continue
+        if current is not None:
+            blocks[current[1]][current[0]].append(line)
+
+    samples = []
+    for num in sorted(blocks):
+        b = blocks[num]
+        if b['input'] is None or b['output'] is None:
+            continue
+        inp = '\n'.join(b['input']).strip('\n') + '\n'
+        out = '\n'.join(b['output']).strip('\n')
+        samples.append({'input': inp, 'expected_output': out})
+    return samples
+
+
+def _normalize(text):
+    lines = [ln.rstrip() for ln in text.replace('\r\n', '\n').split('\n')]
+    return '\n'.join(lines).rstrip()
+
+
+def _truncate(text):
+    if len(text) > MAX_SAMPLE_CHARS:
+        return text[:MAX_SAMPLE_CHARS] + f"\n...[truncated, {len(text) - MAX_SAMPLE_CHARS} more chars]"
+    return text
+
+
+def _coerce_samples(samples):
+    if isinstance(samples, str):
+        import json
+        samples = json.loads(samples)
+    result = []
+    for s in samples or []:
+        if not isinstance(s, dict):
+            raise ValueError("each sample must be an object with 'input' and 'expected_output'")
+        if 'input' not in s or 'expected_output' not in s:
+            raise ValueError("each sample must have 'input' and 'expected_output'")
+        result.append({'input': str(s['input']), 'expected_output': str(s['expected_output'])})
+    return result
+
+
+def tool_function(solution_path, samples=None, timeout=None, problem_statement_path=None):
+    """
+    Run solution_path on each sample and report PASS/FAIL with outputs and runtime.
+    """
+    try:
+        samples = _coerce_samples(samples)
+    except Exception as e:
+        return f"Error: invalid samples argument: {e}"
+
+    if problem_statement_path:
+        if not os.path.isfile(problem_statement_path):
+            return f"Error: problem_statement_path not found: {problem_statement_path}"
+        with open(problem_statement_path, 'r', encoding='utf-8', errors='replace') as f:
+            samples.extend(parse_samples_from_text(f.read()))
+
+    if not samples:
+        return "Error: no samples provided (pass `samples` or a `problem_statement_path` containing 'Sample Input N' / 'Sample Output N' blocks)."
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    try:
+        timeout = float(timeout) if timeout is not None else DEFAULT_TIMEOUT
+    except (TypeError, ValueError):
+        timeout = DEFAULT_TIMEOUT
+    if timeout <= 0:
+        timeout = DEFAULT_TIMEOUT
+
+    python_exe = sys.executable or 'python3'
+    abs_solution = os.path.abspath(solution_path)
+    cwd = os.path.dirname(abs_solution)
+
+    reports = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        stdin_text = sample['input']
+        if stdin_text and not stdin_text.endswith('\n'):
+            stdin_text += '\n'
+        expected = _normalize(sample['expected_output'])
+        start = time.time()
+        try:
+            proc = subprocess.run(
+                [python_exe, abs_solution],
+                input=stdin_text,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                cwd=cwd,
+            )
+            elapsed = time.time() - start
+            actual_raw = proc.stdout
+            status_note = ''
+            if proc.returncode != 0:
+                status_note = f" (exit code {proc.returncode}, stderr:\n{_truncate(proc.stderr.strip())})"
+        except subprocess.TimeoutExpired as e:
+            elapsed = time.time() - start
+            actual_raw = e.stdout.decode('utf-8', 'replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+            status_note = f" (timed out after {timeout}s)"
+        actual = _normalize(actual_raw)
+        ok = (actual == expected) and not status_note
+        if ok:
+            passed += 1
+        status = 'PASS' if ok else 'FAIL'
+        reports.append(
+            f"=== Sample {idx}: {status} (runtime {elapsed:.3f}s){status_note}\n"
+            f"--- expected output:\n{_truncate(expected)}\n"
+            f"--- actual output:\n{_truncate(actual)}\n"
+        )
+
+    total = len(samples)
+    summary = f"Summary: {passed}/{total} samples passed, {total - passed} failed."
+    return "\n".join(reports) + "\n" + summary
