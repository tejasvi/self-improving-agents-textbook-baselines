+FAILURE_MARKER_RE = re.compile(
+    r"MISMATCH|Traceback|AssertionError|FAIL|wrong answer|Error:", re.IGNORECASE
+)
+RECENT_MESSAGE_WINDOW = 6
+
+def _message_role(msg):
+    if isinstance(msg, dict):
+        return msg.get('role', '') or ''
+    return getattr(msg, 'role', '') or ''
+
+def _message_texts(msg):
+    """
+    Extract raw text pieces from a message of any supported shape
+    (Claude-style dict with content blocks, OpenAI dict/object items, plain strings).
+    """
+    texts = []
+    if isinstance(msg, str):
+        return [msg]
+    if isinstance(msg, dict):
+        content = msg.get('content', None)
+        if content is None:
+            content = msg.get('output', None)
+    else:
+        content = getattr(msg, 'content', None)
+        if content is None:
+            content = getattr(msg, 'output_text', None)
+    if isinstance(content, str):
+        texts.append(content)
+    elif isinstance(content, list):
+        for block in content:
+            if isinstance(block, str):
+                texts.append(block)
+            elif isinstance(block, dict):
+                if isinstance(block.get('text'), str):
+                    texts.append(block['text'])
+                if isinstance(block.get('content'), str):
+                    texts.append(block['content'])
+            else:
+                if isinstance(getattr(block, 'text', None), str):
+                    texts.append(block.text)
+    elif content is None and isinstance(msg, dict) and isinstance(msg.get('output'), str):
+        texts.append(msg['output'])
+    return texts
+
+def _tool_result_texts(msg):
+    """
+    Raw tool-result texts from a message (Claude tool_result blocks or OpenAI function_call_output items).
+    Injected user prompts are deliberately excluded.
+    """
+    texts = []
+    if isinstance(msg, dict):
+        if msg.get('type') == 'function_call_output' and isinstance(msg.get('output'), str):
+            texts.append(msg['output'])
+        content = msg.get('content')
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    c = block.get('content')
+                    if isinstance(c, str):
+                        texts.append(c)
+                    elif isinstance(c, list):
+                        for sub in c:
+                            if isinstance(sub, dict) and isinstance(sub.get('text'), str):
+                                texts.append(sub['text'])
+    return texts
+
+def _last_run_failed(msg_history, window=RECENT_MESSAGE_WINDOW):
+    """
+    Scan the last few messages (tool results and assistant text) for generic failure
+    markers. Returns the raw text around the first match, or None. No error parsing.
+    """
+    if not msg_history:
+        return None
+    for msg in reversed(msg_history[-window:]):
+        role = _message_role(msg)
+        if role == 'assistant':
+            candidates = _message_texts(msg)
+        else:
+            candidates = _tool_result_texts(msg)
+        for text in candidates:
+            m = FAILURE_MARKER_RE.search(text)
+            if m:
+                ctx_start = max(0, m.start() - 300)
+                ctx_end = min(len(text), m.end() + 300)
+                return text[ctx_start:ctx_end].strip()
+    return None
+
+def _last_message_empty(msg_history):
+    """
+    True if the most recent assistant message has no non-whitespace text.
+    """
+    if not msg_history:
+        return True
+    for msg in reversed(msg_history):
+        if _message_role(msg) == 'assistant':
+            texts = _message_texts(msg)
+            return not any(t.strip() for t in texts)
+    return True
+
