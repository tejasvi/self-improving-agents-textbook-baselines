+    def _get_patch_status(self):
+        """
+        Inspect the current diff against base_commit.
+        Returns 'empty' if no files changed, 'test_only' if every changed file is a
+        test file, and 'ok' otherwise.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_paths = []
+        for line in diff.splitlines():
+            match = re.match(r'^diff --git a/(.+) b/(.+)$', line)
+            if match:
+                changed_paths.append(match.group(2))
+
+        if not changed_paths:
+            return 'empty'
+
+        def is_test_path(path):
+            normalized = path.replace('\\', '/')
+            basename = normalized.split('/')[-1]
+            if 'tests/' in normalized or normalized.startswith('tests/'):
+                return True
+            if basename.startswith('test_'):
+                return True
+            if re.search(r'_test\.[^.]+$', basename):
+                return True
+            if basename.endswith('.spec.js'):
+                return True
+            return False
+
+        if all(is_test_path(p) for p in changed_paths):
+            return 'test_only'
+        return 'ok'
+
