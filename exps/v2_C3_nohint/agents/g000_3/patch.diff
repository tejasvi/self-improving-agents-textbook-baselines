+import json
+import subprocess
+
+TIMEOUT_SECONDS = 10
+
+
+def tool_info():
+    return {
+        "name": "sample_runner",
+        "description": """Run a Python solution against a list of sample test cases and report results.\n
+* `samples_path` must be a JSON file containing a list of objects of the form {"input": str, "expected_output": str}.\n
+* For each sample, `python3 solution_path` is run with the sample input on stdin (timeout 10 seconds).\n
+* Stdout is compared to expected_output after whitespace normalisation (all whitespace runs are collapsed, so line breaks and spacing differences are ignored).\n
+* Returns a report with PASS/FAIL for each case, plus the input, expected output, actual output and stderr.\n
+* A final summary line states how many samples matched exactly (whitespace-normalised).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run, e.g. /repo/solution.py."
+                },
+                "samples_path": {
+                    "type": "string",
+                    "description": "Path to a JSON file containing a list of {\"input\": str, \"expected_output\": str} objects."
+                }
+            },
+            "required": ["solution_path", "samples_path"]
+        }
+    }
+
+
+def _normalise(text):
+    return " ".join(text.split())
+
+
+def tool_function(solution_path, samples_path):
+    try:
+        with open(samples_path, "r") as f:
+            samples = json.load(f)
+    except Exception as e:
+        return f"Error: could not load samples from {samples_path}: {e}"
+
+    if not isinstance(samples, list):
+        return f"Error: {samples_path} must contain a JSON list of samples."
+
+    reports = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        sample_input = str(sample.get("input", ""))
+        expected = str(sample.get("expected_output", ""))
+        timed_out = False
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=sample_input,
+                capture_output=True,
+                text=True,
+                timeout=TIMEOUT_SECONDS,
+            )
+            actual = proc.stdout
+            stderr = proc.stderr
+            status_note = "" if proc.returncode == 0 else f" (exit code {proc.returncode})"
+        except subprocess.TimeoutExpired as e:
+            actual = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+            stderr = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+            status_note = f" (timed out after {TIMEOUT_SECONDS}s)"
+            timed_out = True
+        ok = (not timed_out) and _normalise(actual) == _normalise(expected)
+        if ok:
+            passed += 1
+        status = "PASS" if ok else "FAIL"
+        reports.append(
+            f"=== Sample {idx}: {status}{status_note} ===\n"
+            f"--- input ---\n{sample_input}\n"
+            f"--- expected output ---\n{expected}\n"
+            f"--- actual output ---\n{actual}\n"
+            f"--- stderr ---\n{stderr}\n"
+        )
+
+    summary = f"{passed}/{len(samples)} samples passed (whitespace-normalised comparison)."
+    return "\n".join(reports) + "\n" + summary
