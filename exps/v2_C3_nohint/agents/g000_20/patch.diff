@@ -0,0 +1,119 @@
+import os
+import subprocess
+import sys
+
+MAX_OUTPUT_CHARS = 1000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a solution program against a reference (brute-force) program.\n
+* The generator script is run as `python generator_path SEED` for SEED in 0..num_tests-1 and must print one test input to stdout.
+* Each input is fed to both the solution and the reference program (via stdin) with a timeout.
+* Outputs are compared token by token (whitespace-insensitive).
+* Returns 'All N tests passed' if all match, otherwise the first mismatching input with both outputs (truncated), plus any runtime errors or timeouts.
+* Use absolute paths for all file arguments. Programs are run with `python`.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the Python brute-force reference file (obviously correct, possibly slow)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python script that takes an integer seed as its first command-line argument and prints one test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of tests to run, using seeds 0..num_tests-1."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each individual run of the generator, solution, or reference."
+                }
+            },
+            "required": ["solution_path", "reference_path", "generator_path", "num_tests", "timeout_sec"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    if len(text) > limit:
+        return text[:limit] + f"... [truncated, {len(text) - limit} more chars]"
+    return text
+
+
+def _run(args, stdin_text=None, timeout=10):
+    """Run a command; returns (returncode, stdout, stderr) or raises subprocess.TimeoutExpired."""
+    proc = subprocess.run(
+        args,
+        input=stdin_text,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+def tool_function(solution_path, reference_path, generator_path, num_tests, timeout_sec):
+    try:
+        num_tests = int(num_tests)
+        timeout_sec = int(timeout_sec)
+    except (TypeError, ValueError):
+        return "Error: num_tests and timeout_sec must be integers."
+    if num_tests <= 0:
+        return "Error: num_tests must be positive."
+    if timeout_sec <= 0:
+        timeout_sec = 10
+
+    for label, path in [("solution", solution_path), ("reference", reference_path), ("generator", generator_path)]:
+        if not os.path.isfile(path):
+            return f"Error: {label} file not found: {path}"
+
+    python = sys.executable or "python3"
+
+    for seed in range(num_tests):
+        # 1. Generate input
+        try:
+            rc, gen_out, gen_err = _run([python, generator_path, str(seed)], timeout=timeout_sec)
+        except subprocess.TimeoutExpired:
+            return f"Generator timed out (>{timeout_sec}s) on seed {seed}."
+        if rc != 0:
+            return f"Generator failed on seed {seed} (exit code {rc}).\nstderr:\n{_truncate(gen_err)}"
+        test_input = gen_out
+
+        # 2. Run solution
+        try:
+            rc, sol_out, sol_err = _run([python, solution_path], stdin_text=test_input, timeout=timeout_sec)
+        except subprocess.TimeoutExpired:
+            return (f"Solution TIMED OUT (>{timeout_sec}s) on seed {seed}.\n"
+                    f"Input:\n{_truncate(test_input)}")
+        if rc != 0:
+            return (f"Solution RUNTIME ERROR (exit code {rc}) on seed {seed}.\n"
+                    f"Input:\n{_truncate(test_input)}\nstderr:\n{_truncate(sol_err)}")
+
+        # 3. Run reference
+        try:
+            rc, ref_out, ref_err = _run([python, reference_path], stdin_text=test_input, timeout=timeout_sec)
+        except subprocess.TimeoutExpired:
+            return (f"Reference TIMED OUT (>{timeout_sec}s) on seed {seed}. "
+                    f"Make sure the reference is fast enough for this input size.\n"
+                    f"Input:\n{_truncate(test_input)}")
+        if rc != 0:
+            return (f"Reference RUNTIME ERROR (exit code {rc}) on seed {seed}.\n"
+                    f"Input:\n{_truncate(test_input)}\nstderr:\n{_truncate(ref_err)}")
+
+        # 4. Compare token by token
+        if sol_out.split() != ref_out.split():
+            return (f"MISMATCH on seed {seed}.\n"
+                    f"Input:\n{_truncate(test_input)}\n"
+                    f"Solution output:\n{_truncate(sol_out.strip())}\n"
+                    f"Reference output:\n{_truncate(ref_out.strip())}")
+
+    return f"All {num_tests} tests passed"
