+def has_solution_file(patch):
+    """
+    Return True if the patch creates or modifies a solution.py file.
+    """
+    if not patch:
+        return False
+    for line in patch.splitlines():
+        if line.startswith('+++ ') and os.path.basename(line.strip().split()[-1]) == 'solution.py':
+            return True
+    return False
