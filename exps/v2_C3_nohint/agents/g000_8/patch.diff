@@ -0,0 +1,112 @@
+import difflib
+import shlex
+import subprocess
+
+TIMEOUT_SECONDS = 10
+
+
+def tool_info():
+    return {
+        "name": "sample_tester",
+        "description": """Run a program on sample test cases and compare its stdout against the expected output exactly.
+
+* Provide the path to the solution file and a list of samples; each sample has an 'input' (fed to stdin) and an 'expected' (expected stdout), both copied verbatim from the problem statement.
+* Each sample is run with a timeout. Output is compared after normalizing trailing whitespace on each line and trailing blank lines.
+* Returns PASS/FAIL for each sample, and a unified diff (expected vs actual) for every failing sample.
+* Use this after implementing the solution to check every sample from the problem statement. A FAIL on a problem with multiple valid answers still needs to be explained or fixed, since the grader may compare output exactly.
+* 'command' is optional; it defaults to 'python3 <solution_path>'.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program file to run."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact standard input for the sample."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected standard output for the sample."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Optional shell command used to run the solution. Defaults to 'python3 <solution_path>'."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.splitlines()]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def tool_function(solution_path, samples, command=None):
+    if command is None or not str(command).strip():
+        command = f"python3 {shlex.quote(str(solution_path))}"
+
+    if not samples:
+        return "Error: no samples provided."
+
+    results = []
+    passed = 0
+    for i, sample in enumerate(samples, start=1):
+        sample_input = sample.get("input", "")
+        expected = sample.get("expected", "")
+        try:
+            proc = subprocess.run(
+                command,
+                shell=True,
+                input=sample_input,
+                capture_output=True,
+                text=True,
+                timeout=TIMEOUT_SECONDS,
+            )
+        except subprocess.TimeoutExpired:
+            results.append(f"Sample {i}: FAIL (timeout after {TIMEOUT_SECONDS}s)")
+            continue
+        except Exception as e:
+            results.append(f"Sample {i}: FAIL (error running command: {e})")
+            continue
+
+        actual = proc.stdout
+        exp_lines = _normalize(expected)
+        act_lines = _normalize(actual)
+        if exp_lines == act_lines and proc.returncode == 0:
+            passed += 1
+            results.append(f"Sample {i}: PASS")
+            continue
+
+        block = [f"Sample {i}: FAIL (exit code {proc.returncode})"]
+        if proc.returncode != 0 and proc.stderr:
+            block.append("stderr:\n" + proc.stderr.rstrip())
+        diff = difflib.unified_diff(
+            exp_lines,
+            act_lines,
+            fromfile=f"sample {i} expected",
+            tofile=f"sample {i} actual",
+            lineterm="",
+        )
+        diff_text = "\n".join(diff)
+        if diff_text:
+            block.append(diff_text)
+        results.append("\n".join(block))
+
+    summary = f"{passed}/{len(samples)} samples passed."
+    return summary + "\n\n" + "\n\n".join(results)
