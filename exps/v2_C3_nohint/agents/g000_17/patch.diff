@@ -0,0 +1,101 @@
+import os
+import subprocess
+import sys
+import time
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run a Python program against a list of test cases and report pass/fail.\n
+* Each case provides an `input` string that is fed to the program's standard input, and an `expected` string for its standard output.\n
+* Outputs are compared after stripping leading/trailing whitespace on each line and ignoring trailing blank lines.\n
+* Each case runs with a timeout. The result reports PASS/FAIL, the actual output, the expected output on failure, stderr on errors, and the elapsed time.\n
+* Use this to check a solution against the sample tests from the problem statement, brute-force comparisons, and random stress tests.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python program to run (e.g. /repo/solution.py)."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of test cases to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text fed to the program's standard input."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Expected text the program writes to standard output."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "cases"]
+        }
+    }
+
+def _normalize(text):
+    lines = [line.strip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+def tool_function(solution_path, cases, timeout=10):
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not isinstance(cases, list) or not cases:
+        return "Error: 'cases' must be a non-empty list of {input, expected} objects."
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    results = []
+    passed = 0
+    for idx, case in enumerate(cases):
+        case_input = str(case.get("input", ""))
+        expected = str(case.get("expected", ""))
+        start = time.time()
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=case_input,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                cwd=cwd,
+            )
+            elapsed = time.time() - start
+            actual = proc.stdout
+            if proc.returncode != 0:
+                status = "FAIL (runtime error)"
+                details = f"stderr:\n{proc.stderr.strip()[-2000:]}"
+            elif _normalize(actual) == _normalize(expected):
+                status = "PASS"
+                passed += 1
+                details = ""
+            else:
+                status = "FAIL (wrong answer)"
+                details = f"expected:\n{expected.strip()}"
+        except subprocess.TimeoutExpired:
+            elapsed = time.time() - start
+            actual = ""
+            status = f"FAIL (timeout after {timeout}s)"
+            details = ""
+        results.append(
+            f"Case {idx + 1}: {status} in {elapsed:.3f}s\n"
+            f"actual:\n{actual.strip()[-2000:]}\n{details}".rstrip()
+        )
+
+    summary = f"{passed}/{len(cases)} cases passed."
+    return summary + "\n\n" + "\n\n".join(results)
