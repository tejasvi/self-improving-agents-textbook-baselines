+import subprocess
+import sys
+import time
+import os
+import tempfile
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution file against a list of sample tests and report pass/fail, actual output and elapsed time for each sample.
+* Each sample has an 'input' (text fed to standard input) and an 'expected' output (compared after stripping trailing whitespace).
+* The solution is executed as a standalone program with `python3 <solution_path>`.
+* Use this to check the solution against every sample from the problem statement, and against stress-test cases.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (must read stdin and write stdout)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of samples, each an object with 'input' and 'expected' string fields.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Text to feed to the program's standard input."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Expected standard output of the program."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-sample timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_path", "samples"]
+        }
+    }
+
+def tool_function(solution_path, samples, timeout=10):
+    solution_path = os.path.abspath(solution_path)
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if isinstance(samples, str):
+        try:
+            import json
+            samples = json.loads(samples)
+        except Exception as e:
+            return f"Error: samples must be a list of objects with 'input' and 'expected': {e}"
+    timeout = float(timeout) if timeout else 10.0
+    lines = []
+    passed = 0
+    for i, sample in enumerate(samples, 1):
+        sample_input = str(sample.get("input", ""))
+        expected = str(sample.get("expected", ""))
+        start = time.time()
+        try:
+            proc = subprocess.run(
+                [sys.executable, solution_path],
+                input=sample_input,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                cwd=os.path.dirname(solution_path),
+            )
+            elapsed = time.time() - start
+            actual = proc.stdout
+            ok = actual.rstrip() == expected.rstrip() and proc.returncode == 0
+            status = "PASS" if ok else "FAIL"
+            extra = f"\n  stderr: {proc.stderr.strip()[-2000:]}" if proc.returncode != 0 else ""
+        except subprocess.TimeoutExpired:
+            elapsed = time.time() - start
+            actual = ""
+            ok = False
+            status = "FAIL"
+            extra = f"\n  TIMEOUT after {timeout}s"
+        if ok:
+            passed += 1
+        lines.append(
+            f"Sample {i}: {status} (time {elapsed:.3f}s)\n"
+            f"  expected: {expected.rstrip()!r}\n"
+            f"  actual:   {actual.rstrip()!r}{extra}"
+        )
+    summary = f"{passed}/{len(samples)} samples passed."
+    return summary + "\n" + "\n".join(lines)
+
+if __name__ == "__main__":
+    print(tool_info()["name"])
