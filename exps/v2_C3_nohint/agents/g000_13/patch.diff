+    def get_last_reply_text(self, msg_history):
+        """
+        Extract the text of the most recent assistant reply from a message history
+        returned by chat_with_agent (supports Claude dict messages and OpenAI response objects).
+        """
+        for message in reversed(msg_history):
+            if isinstance(message, dict):
+                if message.get('role') != 'assistant':
+                    continue
+                content = message.get('content')
+                if isinstance(content, str):
+                    return content
+                if isinstance(content, list):
+                    texts = []
+                    for block in content:
+                        if isinstance(block, dict) and isinstance(block.get('text'), str):
+                            texts.append(block['text'])
+                        elif isinstance(getattr(block, 'text', None), str):
+                            texts.append(block.text)
+                    if texts:
+                        return '\n'.join(texts)
+            else:
+                output_text = getattr(message, 'output_text', None)
+                if isinstance(output_text, str) and output_text:
+                    return output_text
+        return ''
+
