@@ -0,0 +1,102 @@
+import subprocess
+
+MAX_OUTPUT_CHARS = 10000
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Compare a fast solution against a reference (brute-force) solution on randomly generated inputs.\n
+* solution_cmd: shell command that runs the fast solution, reading the test input from stdin and writing the answer to stdout.\n
+* reference_cmd: shell command that runs the trusted reference/brute-force solution with the same stdin/stdout contract.\n
+* generator_cmd: shell command for a script that prints one random test input to stdout. The seed is passed as its first argument (e.g. `python3 /work/gen.py <seed>`).\n
+* num_tests: number of seeds to test (default 200 if omitted). Seeds 1..num_tests are used.\n
+* timeout: seconds allowed per program run (default 10 if omitted).\n
+* Outputs are compared after whitespace normalization. On the first mismatch, the seed, the generated input, and both raw outputs are returned. Timeouts and crashes are reported with the raw stderr.\n
+* Returns 'All N tests passed' if every seed matches.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command running the fast solution (reads stdin, writes stdout)."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Shell command running the reference/brute-force solution (reads stdin, writes stdout)."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the input generator; receives the seed as its first argument and prints one test input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default 200)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each program run (default 10)."
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+def _truncate(text):
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n<response clipped>"
+    return text
+
+def _run(cmd, stdin_text, timeout):
+    """Run a shell command with stdin_text. Returns (status, stdout, stderr)
+    where status is 'ok', 'timeout', or 'crash'."""
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True,
+            text=True, timeout=timeout
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", "", f"Timed out after {timeout} seconds"
+    if proc.returncode != 0:
+        return "crash", proc.stdout, proc.stderr
+    return "ok", proc.stdout, proc.stderr
+
+def _normalize(text):
+    return " ".join(text.split())
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, num_tests=200, timeout=10):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 200
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError) as e:
+        return f"Error: invalid num_tests/timeout: {e}"
+
+    for seed in range(1, num_tests + 1):
+        gen_status, test_input, gen_err = _run(f"{generator_cmd} {seed}", "", timeout)
+        if gen_status != "ok":
+            return (
+                f"Generator failed on seed {seed} ({gen_status}).\n"
+                f"stderr:\n{_truncate(gen_err)}"
+            )
+
+        sol_status, sol_out, sol_err = _run(solution_cmd, test_input, timeout)
+        ref_status, ref_out, ref_err = _run(reference_cmd, test_input, timeout)
+
+        if sol_status != "ok" or ref_status != "ok":
+            return (
+                f"Failure on seed {seed}.\n"
+                f"Input:\n{_truncate(test_input)}\n"
+                f"Solution status: {sol_status}\n"
+                f"Solution stderr:\n{_truncate(sol_err)}\n"
+                f"Reference status: {ref_status}\n"
+                f"Reference stderr:\n{_truncate(ref_err)}"
+            )
+
+        if _normalize(sol_out) != _normalize(ref_out):
+            return (
+                f"Mismatch on seed {seed}.\n"
+                f"Input:\n{_truncate(test_input)}\n"
+                f"Solution output:\n{_truncate(sol_out)}\n"
+                f"Reference output:\n{_truncate(ref_out)}"
+            )
+
+    return f"All {num_tests} tests passed"
