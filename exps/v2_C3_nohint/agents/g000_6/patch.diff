@@ -0,0 +1,57 @@
+import sys
+import os
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+
+from tools.run_samples import tool_info, tool_function, parse_samples
+
+
+PROBLEM = """Some statement.
+Sample Input 1
+4 4
+Sample Output 1
+Yes
+4 4 4
+Note: explanation here.
+Sample Input 2
+0
+Sample Output 2
+No
+"""
+
+
+def test_tool_info_schema():
+    info = tool_info()
+    assert info["name"] == "run_samples"
+    schema = info["input_schema"]
+    assert schema["type"] == "object"
+    assert schema["required"] == ["solution_path"]
+    for name, prop in schema["properties"].items():
+        assert "type" in prop and "description" in prop, name
+
+
+def test_parse_samples():
+    samples = parse_samples(PROBLEM)
+    assert samples == [(1, "4 4\n", "Yes\n4 4 4\n"), (2, "0\n", "No\n")]
+
+
+def test_run_pass_and_fail(tmp_path):
+    sol = tmp_path / "solution.py"
+    # Sample 1 (n=4) prints "Yes\n4 4 4" -> PASS; sample 2 (n=0) prints "Yes" -> FAIL
+    sol.write_text(
+        "n = int(input().split()[0])\n"
+        "print('Yes')\n"
+        "if n == 4:\n"
+        "    print('4 4 4')\n"
+    )
+    report = tool_function(str(sol), problem_text=PROBLEM)
+    assert "Sample 1: PASS" in report
+    assert "Sample 2: FAIL" in report
+
+
+def test_whitespace_note(tmp_path):
+    sol = tmp_path / "solution.py"
+    sol.write_text("print('Yes   ')\nprint('4 4 4')\n")
+    problem = "Sample Input 1\n1\nSample Output 1\nYes\n4 4 4\n"
+    report = tool_function(str(sol), problem_text=problem)
+    assert "whitespace" in report
diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..21afb6b
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,125 @@
+import os
+import re
+import subprocess
+
+PROBLEM_FILE = "/tmp/problem.md"
+RUN_TIMEOUT = 10  # seconds per sample
+
+_IN_RE = re.compile(r"Sample\s+Input\s*(\d+)\s*:?[ \t]*\n?", re.IGNORECASE)
+_OUT_RE = re.compile(r"Sample\s+Output\s*(\d+)\s*:?[ \t]*\n?", re.IGNORECASE)
+_STOP_RE = re.compile(
+    r"^\s*(?:#+\s*)?(?:Sample\s+Input|Sample\s+Output|Note|Explanation|Examples?|Constraints?)\b",
+    re.IGNORECASE | re.MULTILINE,
+)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution against the sample test cases of the problem statement.\n
+* Parses every 'Sample Input N' / 'Sample Output N' block from the problem statement (saved at /tmp/problem.md by default).\n
+* Runs the command (default 'python3 <solution file name>') with each sample input on stdin, with a timeout.\n
+* Reports PASS/FAIL per sample with the expected and actual output.\n
+* If a sample matches only up to whitespace, a NOTE is printed: the grader may compare output byte for byte, so such cases must be fixed to match the expected output exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to test, e.g. /repo/solution.py."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Command used to run the solution, e.g. 'python3 solution.py'. Executed in the solution's directory. Defaults to 'python3 <solution file name>'."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "Optional problem statement text containing the samples. Defaults to the problem statement saved on disk at /tmp/problem.md."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clean_block(text):
+    lines = [ln for ln in text.split("\n") if not ln.strip().startswith("```")]
+    return "\n".join(lines).strip("\n") + "\n"
+
+
+def parse_samples(text):
+    """Return a list of (index, input_str, expected_output_str)."""
+    ins = {int(m.group(1)): m for m in _IN_RE.finditer(text)}
+    outs = {int(m.group(1)): m for m in _OUT_RE.finditer(text)}
+    samples = []
+    for idx in sorted(ins):
+        if idx not in outs:
+            continue
+        in_m = ins[idx]
+        out_m = outs[idx]
+        if out_m.start() < in_m.end():
+            continue
+        inp_raw = text[in_m.end():out_m.start()]
+        rest = text[out_m.end():]
+        stop = _STOP_RE.search(rest)
+        out_raw = rest[:stop.start()] if stop else rest
+        samples.append((idx, _clean_block(inp_raw), _clean_block(out_raw)))
+    return samples
+
+
+def _normalize_ws(s):
+    return " ".join(s.split())
+
+
+def tool_function(solution_path, command=None, problem_text=None):
+    if problem_text is None:
+        try:
+            with open(PROBLEM_FILE, "r") as f:
+                problem_text = f.read()
+        except OSError as e:
+            return f"Error: could not read problem statement from {PROBLEM_FILE}: {e}"
+    if not os.path.exists(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not command:
+        command = f"python3 {os.path.basename(solution_path)}"
+
+    samples = parse_samples(problem_text)
+    if not samples:
+        return "Error: no 'Sample Input N' / 'Sample Output N' blocks found in the problem statement."
+
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    reports = []
+    passed = 0
+    for idx, inp, expected in samples:
+        try:
+            proc = subprocess.run(
+                command, shell=True, input=inp, capture_output=True, text=True,
+                timeout=RUN_TIMEOUT, cwd=cwd,
+            )
+        except subprocess.TimeoutExpired:
+            reports.append(f"Sample {idx}: FAIL (timed out after {RUN_TIMEOUT}s)\nInput:\n{inp}")
+            continue
+        actual = proc.stdout
+        if actual == expected:
+            passed += 1
+            reports.append(f"Sample {idx}: PASS")
+            continue
+        if _normalize_ws(actual) == _normalize_ws(expected):
+            passed += 1
+            reports.append(
+                f"Sample {idx}: PASS (whitespace-normalized only)\n"
+                "NOTE: the exact byte-for-byte match FAILED; output differs only in whitespace. "
+                "Make the output identical to the expected output.\n"
+                f"Expected output:\n{expected}\nActual output:\n{actual}"
+            )
+            continue
+        report = [f"Sample {idx}: FAIL (exit code {proc.returncode})",
+                  f"Expected output:\n{expected}",
+                  f"Actual output:\n{actual}"]
+        if proc.stderr.strip():
+            report.append(f"Stderr:\n{proc.stderr[-2000:]}")
+        reports.append("\n".join(report))
+
+    header = (f"Ran {len(samples)} sample(s) with `{command}` in {cwd}: "
+              f"{passed} passed, {len(samples) - passed} failed.")
+    return header + "\n\n" + "\n\n".join(reports)
