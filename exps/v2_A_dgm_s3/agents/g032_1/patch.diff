+    def _extract_samples(self):
+        """
+        Parse 'Sample Input N' / 'Sample Output N' headings from the problem statement.
+        Each block is the text following its heading up to the next heading. Returns a list
+        of (index, input_text, expected_output_text) for indices that have both parts; [] if none.
+        """
+        text = self.problem_statement or ''
+        heading = re.compile(r'^[#*_\s]*Sample\s+(Input|Output)\s*(\d+)[*_\s:]*$',
+                             re.IGNORECASE | re.MULTILINE)
+        matches = list(heading.finditer(text))
+        blocks = {}
+        for pos, m in enumerate(matches):
+            end = matches[pos + 1].start() if pos + 1 < len(matches) else len(text)
+            body = text[m.end():end]
+            lines = [l for l in body.splitlines() if not l.strip().startswith('```')]
+            content = '\n'.join(lines).strip('\n')
+            kind, idx = m.group(1).lower(), int(m.group(2))
+            blocks.setdefault(idx, {})[kind] = content
+        samples = []
+        for idx in sorted(blocks):
+            parts = blocks[idx]
+            if 'input' in parts and 'output' in parts:
+                samples.append((idx, parts['input'].strip() + '\n', parts['output'].strip()))
+        return samples
+
+    def _run_samples(self):
+        """
+        Run the target file with python3 on every parsed sample (wall-clock timeout and address
+        space limit). Returns a list of dicts with keys: index, ok, reason, stdout, stderr,
+        runtime. Errors are returned raw; nothing is parsed out of them.
+        """
+        target_path = os.path.join(self.git_tempdir, self._target_file())
+        results = []
+
+        def limit_memory():
+            resource.setrlimit(resource.RLIMIT_AS,
+                               (SAMPLE_MEMORY_LIMIT_BYTES, SAMPLE_MEMORY_LIMIT_BYTES))
+
+        for idx, sample_in, expected in self._extract_samples():
+            result = {'index': idx, 'ok': False, 'reason': '', 'stdout': '', 'stderr': '', 'runtime': 0.0}
+            if not os.path.isfile(target_path):
+                result['reason'] = f"target file {target_path} does not exist"
+                results.append(result)
+                continue
+            start = time.time()
+            try:
+                proc = subprocess.run(
+                    [sys.executable, target_path],
+                    input=sample_in, capture_output=True, text=True,
+                    timeout=SAMPLE_TIMEOUT_SECONDS, cwd=self.git_tempdir,
+                    preexec_fn=limit_memory,
+                )
+                result['runtime'] = time.time() - start
+                result['stdout'] = proc.stdout
+                result['stderr'] = proc.stderr
+                if proc.returncode != 0:
+                    result['reason'] = f"exit code {proc.returncode}"
+                else:
+                    got = [l.rstrip() for l in proc.stdout.strip().splitlines()]
+                    want = [l.rstrip() for l in expected.strip().splitlines()]
+                    if got == want:
+                        result['ok'] = True
+                        result['reason'] = 'matches expected output'
+                    else:
+                        result['reason'] = 'wrong output'
+            except subprocess.TimeoutExpired as e:
+                result['runtime'] = time.time() - start
+                result['stdout'] = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+                result['stderr'] = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+                result['reason'] = f"timed out after {SAMPLE_TIMEOUT_SECONDS}s"
+            except Exception as e:
+                result['runtime'] = time.time() - start
+                result['reason'] = f"failed to run: {e}"
+            results.append(result)
+        return results
+
