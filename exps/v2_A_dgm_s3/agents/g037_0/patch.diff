+    def _extract_samples(self):
+        """
+        Parse the problem statement for sample (input, expected_output) pairs.
+        Primary format: 'Sample Input k' / 'Sample Output k'. Fallbacks: 'Input:'/'Output:' and 'Example' blocks.
+        """
+        text = self.problem_statement or ''
+        pattern = r'Sample Input (\d+)\s*\n(.*?)\n\s*Sample Output \1\s*\n(.*?)(?=\n\s*Sample Input|\n## |\Z)'
+        samples = []
+        for m in re.finditer(pattern, text, re.DOTALL):
+            samples.append((m.group(2).strip() + '\n', m.group(3).strip()))
+        if samples:
+            return samples
+
+        pattern = r'(?:^|\n)\s*Input:?\s*\n(.*?)\n\s*Output:?\s*\n(.*?)(?=\n\s*Input:?\s*\n|\n\s*Example|\Z)'
+        for m in re.finditer(pattern, text, re.DOTALL):
+            inp, out = m.group(1).strip(), m.group(2).strip()
+            if inp and out:
+                samples.append((inp + '\n', out))
+        if samples:
+            return samples
+
+        pattern = r'Example[^\n]*\n\s*Input\s*\n(.*?)\n\s*Output\s*\n(.*?)(?=\n\s*Example|\Z)'
+        for m in re.finditer(pattern, text, re.DOTALL):
+            inp, out = m.group(1).strip(), m.group(2).strip()
+            if inp and out:
+                samples.append((inp + '\n', out))
+        return samples
+
+    def _run_samples(self, samples=None, timeout=10, max_chars=3000):
+        """
+        Run the solution file on every sample via stdin and compare whitespace-separated tokens.
+        Returns a list of failure reports (empty list means all samples passed).
+        """
+        if samples is None:
+            samples = self._extract_samples()
+        path = self._find_solution_file()
+        failures = []
+        if not os.path.isfile(path):
+            return [{
+                'index': None, 'input': '', 'expected': '', 'actual': '',
+                'stderr': f'Solution file not found: {path}',
+            }]
+        for idx, (inp, expected) in enumerate(samples, start=1):
+            try:
+                result = subprocess.run(
+                    [sys.executable, path],
+                    input=inp.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                    cwd=self.git_tempdir, timeout=timeout, check=False,
+                )
+                actual = result.stdout.decode(errors='replace')
+                stderr = result.stderr.decode(errors='replace')
+                if result.returncode != 0 and not stderr:
+                    stderr = f'exit code {result.returncode}'
+            except subprocess.TimeoutExpired:
+                actual, stderr = '', f'Timeout after {timeout}s'
+            if stderr.startswith('Timeout'):
+                failures.append({'index': idx, 'input': inp[:max_chars], 'expected': expected,
+                                 'actual': actual, 'stderr': stderr})
+            elif actual.split() != expected.split():
+                failures.append({'index': idx, 'input': inp[:max_chars], 'expected': expected,
+                                 'actual': actual, 'stderr': stderr[-max_chars:]})
+        safe_log(f"Sample check: {len(samples) - len(failures)}/{len(samples)} passed.")
+        return failures
+
+    def _format_sample_failures(self, failures):
+        parts = []
+        for f in failures:
+            parts.append(
+                f"Sample {f['index']} FAILED.\n"
+                f"Input (truncated to 3000 chars):\n{f['input']}\n"
+                f"Expected output:\n{f['expected']}\n"
+                f"Actual output:\n{f['actual']}\n"
+                f"Stderr:\n{f['stderr']}\n"
+            )
+        return "\n".join(parts)
