diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..705b667
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,131 @@
+import os
+import re
+import signal
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution command on the sample tests found in a problem statement and report raw results.\n
+* Pass the problem statement (or any text) in `samples`; blocks labelled 'Sample Input N' / 'Sample Output N' (or 'Input:' / 'Expected output:') are extracted.\n
+* Each sample is fed to `solution_cmd` via stdin. Reported per sample: PASS, FAIL or TIMEOUT, the runtime, stderr, and the first differing lines.\n
+* The result is raw output; no interpretation is applied. Use it to check timing as well as correctness.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; reads the sample input on stdin and writes the answer to stdout."
+                },
+                "samples": {
+                    "type": "string",
+                    "description": "Text containing the sample input/output blocks (usually the full problem statement)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-sample timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_cmd"]
+        }
+    }
+
+_INPUT_OUTPUT_RE = re.compile(
+    r'(?:Sample Input\s*(\d*)\s*:?|Input:)[ \t]*\n(.*?)\n[ \t]*'
+    r'(?:Sample Output\s*\1\s*:?|Expected output:|Output:)[ \t]*\n(.*?)(?=\n[ \t]*\n|\n[ \t]*(?:Sample Input|Input:)|\Z)',
+    re.DOTALL | re.IGNORECASE,
+)
+
+def parse_samples(text):
+    """Return a list of (input_text, expected_output_text) pairs found in text."""
+    pairs = []
+    if not text:
+        return pairs
+    for m in _INPUT_OUTPUT_RE.finditer(text):
+        inp = m.group(2).strip('\n') + '\n'
+        out = m.group(3).strip()
+        pairs.append((inp, out))
+    return pairs
+
+def _run_one(cmd, stdin_text, timeout):
+    """Run cmd in its own session; kill the whole process group on timeout."""
+    start = time.time()
+    proc = subprocess.Popen(
+        cmd, shell=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        text=True, start_new_session=True,
+    )
+    try:
+        out, err = proc.communicate(stdin_text, timeout=timeout)
+        return {"timed_out": False, "stdout": out, "stderr": err,
+                "returncode": proc.returncode, "elapsed": time.time() - start}
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError, OSError):
+            proc.kill()
+        out, err = proc.communicate()
+        return {"timed_out": True, "stdout": out or "", "stderr": err or "",
+                "returncode": None, "elapsed": time.time() - start}
+
+def _first_diff(expected, actual, max_lines=5):
+    exp_lines = expected.strip().splitlines()
+    act_lines = actual.strip().splitlines()
+    diffs = []
+    for i in range(max(len(exp_lines), len(act_lines))):
+        e = exp_lines[i] if i < len(exp_lines) else '<missing>'
+        a = act_lines[i] if i < len(act_lines) else '<missing>'
+        if e != a:
+            diffs.append(f"line {i + 1}: expected {e!r}, got {a!r}")
+            if len(diffs) >= max_lines:
+                break
+    return diffs
+
+def tool_function(solution_cmd: str, samples: str = None, timeout: float = 10.0, **kwargs) -> str:
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Error: timeout must be a number, got {timeout!r}"
+    if not solution_cmd or not str(solution_cmd).strip():
+        return "Error: solution_cmd must be a non-empty command string."
+
+    pairs = parse_samples(samples or '')
+    if not pairs:
+        return "Error: no sample input/output blocks found in the provided text."
+
+    lines = []
+    all_ok = True
+    for idx, (inp, expected) in enumerate(pairs, start=1):
+        res = _run_one(solution_cmd, inp, timeout)
+        elapsed = f"{res['elapsed']:.2f}s"
+        if res["timed_out"]:
+            all_ok = False
+            status = "TIMEOUT"
+            lines.append(f"Sample {idx}: {status} after {timeout}s (elapsed {elapsed})")
+            if res["stdout"].strip():
+                lines.append(f"  partial stdout: {res['stdout'].strip()[:500]!r}")
+            continue
+        if res["returncode"] != 0:
+            all_ok = False
+            status = f"FAIL (exit code {res['returncode']})"
+        elif res["stdout"].strip() == expected.strip():
+            status = "PASS"
+        else:
+            all_ok = False
+            status = "FAIL (wrong answer)"
+        lines.append(f"Sample {idx}: {status} (runtime {elapsed})")
+        if status != "PASS":
+            lines.append(f"  expected: {expected.strip()[:500]!r}")
+            lines.append(f"  got:      {res['stdout'].strip()[:500]!r}")
+            for d in _first_diff(expected, res["stdout"]):
+                lines.append(f"  {d}")
+        if res["stderr"].strip():
+            lines.append(f"  stderr: {res['stderr'].strip()[-1000:]}")
+
+    header = "ALL SAMPLES PASSED" if all_ok else "SAMPLES NOT PASSED"
+    return f"{header} ({len(pairs)} samples, timeout {timeout}s)\n" + "\n".join(lines)
+
+if __name__ == "__main__":
+    import sys
+    text = sys.stdin.read()
+    print(tool_function(solution_cmd=sys.argv[1], samples=text))
