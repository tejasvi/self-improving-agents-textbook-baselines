+    def _classify_patch(self):
+        """
+        Classify the current repo diff versus base_commit.
+        Returns 'empty' (no changes), 'test_only' (only test files changed), or 'ok'.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_files = []
+        for line in diff.splitlines():
+            match = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+            if match:
+                changed_files.append(match.group(2))
+
+        if not changed_files:
+            return 'empty'
+
+        def is_test_file(path):
+            parts = path.replace('\\', '/').split('/')
+            basename = parts[-1]
+            if basename.startswith('test_') or basename.endswith('_test.py') \
+                    or basename.endswith('.test.js') or basename.endswith('.spec.js'):
+                return True
+            return any(part in ('tests', 'test', '__tests__') for part in parts[:-1])
+
+        if all(is_test_file(f) for f in changed_files):
+            return 'test_only'
+        return 'ok'
+
