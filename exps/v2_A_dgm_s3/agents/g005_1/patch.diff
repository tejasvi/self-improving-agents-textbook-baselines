+def _block_is_empty_text(block):
+    if isinstance(block, dict):
+        return block.get('type') == 'text' and not str(block.get('text') or '').strip()
+    return getattr(block, 'type', None) == 'text' and not str(getattr(block, 'text', None) or '').strip()
+
+def sanitize_history(msgs):
+    """
+    Normalize a message history for the Claude API:
+    - content is always a list of blocks,
+    - empty/whitespace-only text blocks are dropped,
+    - messages left without blocks are dropped,
+    - adjacent messages with the same role are merged (tool_result blocks first in user turns).
+    """
+    normalized = []
+    for msg in msgs:
+        role = msg.get('role', '') if isinstance(msg, dict) else getattr(msg, 'role', '')
+        content = msg.get('content', []) if isinstance(msg, dict) else getattr(msg, 'content', [])
+        if content is None:
+            content = []
+        elif isinstance(content, str):
+            content = [{"type": "text", "text": content}]
+        blocks = [b for b in content if not _block_is_empty_text(b)]
+        if not blocks:
+            continue
+        if normalized and normalized[-1]['role'] == role:
+            normalized[-1]['content'].extend(blocks)
+        else:
+            normalized.append({"role": role, "content": list(blocks)})
+
+    for msg in normalized:
+        if msg['role'] == 'user':
+            def is_result(b):
+                return (b.get('type') if isinstance(b, dict) else getattr(b, 'type', None)) == 'tool_result'
+            msg['content'] = [b for b in msg['content'] if is_result(b)] + [b for b in msg['content'] if not is_result(b)]
+    return normalized
+
