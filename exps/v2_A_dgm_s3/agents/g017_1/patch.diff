diff --git a/tools/scale_test.py b/tools/scale_test.py
new file mode 100644
index 0000000..0a0e515
--- /dev/null
+++ b/tools/scale_test.py
@@ -0,0 +1,104 @@
+import subprocess
+import time
+
+HEAD_CHARS = 500
+GENERATOR_PREFIX = "$ "
+
+
+def tool_info():
+    return {
+        "name": "scale_test",
+        "description": """Run a solution on several large or skewed inputs and report raw measurements.\n
+* `solution_cmd` is a shell command that reads the input on stdin and writes the answer to stdout (e.g. `python3 /tmp/stress/slow.py` or `python3 /dgm/solution.py`).\n
+* `inputs` is a list of entries. An entry starting with "$ " is a shell command whose stdout is used as the input (a generator, e.g. "$ python3 /tmp/stress/gen_max.py skewed"). Any other entry is used as the literal input text.\n
+* Each input is run with a wall-clock timeout of `time_limit` seconds.\n
+* For every input it reports the wall time in seconds, whether it timed out, the exit code, and the first characters of stdout and stderr. No pass/fail judgement is made; compare the wall times with the time limit yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; reads the test input on stdin and writes the answer to stdout."
+                },
+                "inputs": {
+                    "type": "array",
+                    "items": {
+                        "type": "string",
+                        "description": "Literal input text, or a shell command prefixed with '$ ' whose stdout is the input."
+                    },
+                    "description": "List of inputs to run the solution on (e.g. max-size, skewed, all-equal inputs)."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Per-input wall-clock timeout in seconds for the solution run (e.g. 2)."
+                }
+            },
+            "required": ["solution_cmd", "inputs", "time_limit"]
+        }
+    }
+
+
+def _head(text):
+    text = text or ""
+    return text[:HEAD_CHARS] + ("...[truncated]" if len(text) > HEAD_CHARS else "")
+
+
+def _decode(data):
+    if data is None:
+        return ""
+    if isinstance(data, bytes):
+        return data.decode(errors="replace")
+    return data
+
+
+def tool_function(solution_cmd, inputs, time_limit):
+    try:
+        limit = float(time_limit)
+    except (TypeError, ValueError):
+        return f"Error: time_limit must be a number, got {time_limit!r}"
+    if not isinstance(inputs, list):
+        return "Error: inputs must be a list of strings"
+
+    lines = []
+    for idx, entry in enumerate(inputs):
+        entry = str(entry)
+        label = f"Input {idx + 1}"
+        # Generate the input text.
+        if entry.startswith(GENERATOR_PREFIX):
+            gen_cmd = entry[len(GENERATOR_PREFIX):]
+            try:
+                gen = subprocess.run(gen_cmd, shell=True, capture_output=True, timeout=max(limit, 10.0))
+            except subprocess.TimeoutExpired:
+                lines.append(f"{label}: generator timed out ({gen_cmd})")
+                continue
+            if gen.returncode != 0:
+                lines.append(f"{label}: generator exit={gen.returncode} stderr={_head(_decode(gen.stderr))!r}")
+                continue
+            input_text = _decode(gen.stdout)
+            label = f"{label} (generated by `{gen_cmd}`, {len(input_text)} chars)"
+        else:
+            input_text = entry
+
+        # Run the solution.
+        start = time.monotonic()
+        try:
+            proc = subprocess.run(
+                solution_cmd, shell=True, input=input_text.encode(),
+                capture_output=True, timeout=limit,
+            )
+            elapsed = time.monotonic() - start
+            lines.append(
+                f"{label}: wall_time={elapsed:.3f}s timed_out=False exit_code={proc.returncode}\n"
+                f"  stdout_head={_head(_decode(proc.stdout))!r}\n"
+                f"  stderr_head={_head(_decode(proc.stderr))!r}"
+            )
+        except subprocess.TimeoutExpired as e:
+            elapsed = time.monotonic() - start
+            lines.append(
+                f"{label}: wall_time={elapsed:.3f}s timed_out=True exit_code=None\n"
+                f"  stdout_head={_head(_decode(e.stdout))!r}\n"
+                f"  stderr_head={_head(_decode(e.stderr))!r}"
+            )
+    if not lines:
+        return "No inputs given."
+    return "\n".join(lines)
