+    def _extract_target_file(self):
+        """
+        Find a backticked source filename in the problem statement (e.g. `solution.py`).
+        Defaults to 'solution.py' for Python tasks. Returns None otherwise.
+        """
+        match = re.search(r'`([\w./-]+\.(?:py|js|cpp|java|go|rs))`', self.problem_statement or '')
+        if match:
+            return match.group(1)
+        if self.language == 'python':
+            return 'solution.py'
+        return None
+
+    def _fallback_write_solution(self):
+        """
+        Tool-free fallback: ask the LLM for only the solution code and write it to the target file.
+        """
+        target_file = self._extract_target_file()
+        if not target_file:
+            safe_log("Fallback skipped: no target file could be determined.")
+            return
+        prompt = (f"Solve the following problem.\n\n<problem_description>\n{self.problem_statement}\n"
+                  f"</problem_description>\n\nOutput ONLY the complete {self.language} solution in one ```{self.language} code block. "
+                  f"No explanation.")
+        try:
+            client, client_model = create_client(self.code_model)
+            content, _ = get_response_from_llm(
+                prompt, client=client, model=client_model,
+                system_message="You are an expert competitive programmer.", msg_history=[],
+            )
+        except Exception as e:
+            safe_log(f"Fallback LLM call failed: {e}")
+            return
+        match = re.search(r'```(?:[\w+-]*)\s*\n(.*?)```', content or '', re.DOTALL)
+        if not match:
