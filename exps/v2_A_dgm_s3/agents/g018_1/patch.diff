+def _message_text(msg):
+    """Return the concatenated text of a message's content (string or list of blocks)."""
+    content = msg.get('content') if isinstance(msg, dict) else None
+    if content is None:
+        return ''
+    if isinstance(content, str):
+        return content
+    parts = []
+    for block in content:
+        if isinstance(block, dict):
+            if block.get('type') == 'text':
+                parts.append(str(block.get('text', '')))
+        elif getattr(block, 'type', None) == 'text':
+            parts.append(str(getattr(block, 'text', '')))
+    return ''.join(parts)
+
+def _sanitize_history(msg_history):
+    """
+    Remove trailing assistant messages whose content is empty or whitespace-only.
+    Returns [] if nothing useful remains.
+    """
+    if not msg_history:
+        return []
+    history = list(msg_history)
+    while history and history[-1].get('role') == 'assistant' and not _message_text(history[-1]).strip():
+        history.pop()
+    return history
+
