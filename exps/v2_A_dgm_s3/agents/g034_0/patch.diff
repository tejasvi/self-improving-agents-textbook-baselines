diff --git a/tools/compare_solutions.py b/tools/compare_solutions.py
new file mode 100644
index 0000000..9745e27
--- /dev/null
+++ b/tools/compare_solutions.py
@@ -0,0 +1,135 @@
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 2000
+MAX_INPUT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "compare_solutions",
+        "description": """Differential testing of two programs on generated inputs. Returns raw results, no parsing.\n
+* `generator_cmd` is a shell command that takes one integer seed as its single argument and prints one test input to stdout (e.g. `python gen.py`; the seed is appended as an argument).\n
+* For each seed in 0..num_cases-1, the input is piped to both `reference_cmd` (trusted, e.g. a brute force) and `candidate_cmd` (the solution under test), each under `timeout_sec`.\n
+* Outputs are compared after stripping trailing whitespace. Returns the number of mismatches, the first failing input with both raw outputs, and the max runtime observed for each program.\n
+* Use 0 mismatches over 300+ cases as the bar before adopting a solution.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the trusted reference program, e.g. `python /tmp/w/brute.py`. Reads stdin, writes stdout."
+                },
+                "candidate_cmd": {
+                    "type": "string",
+                    "description": "Shell command for the candidate program under test, e.g. `python solution.py`. Reads stdin, writes stdout."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that takes an integer seed as its last argument and prints one test input to stdout, e.g. `python /tmp/w/gen.py`."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of generated cases to run (seeds 0 to num_cases-1)."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Per-case timeout in seconds for each program."
+                }
+            },
+            "required": ["reference_cmd", "candidate_cmd", "generator_cmd", "num_cases", "timeout_sec"]
+        }
+    }
+
+
+def _run(cmd, stdin_text, timeout_sec):
+    """Run a shell command with stdin_text. Returns (status, stdout, elapsed)."""
+    start = time.monotonic()
+    try:
+        result = subprocess.run(
+            ["timeout", "-k", "1", str(timeout_sec), "sh", "-c", cmd],
+            input=stdin_text.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            timeout=timeout_sec + 10,
+        )
+        status = result.returncode
+        stdout = result.stdout.decode(errors='replace')
+        stderr = result.stderr.decode(errors='replace')
+    except subprocess.TimeoutExpired:
+        status = 'TIMEOUT (wrapper)'
+        stdout = ''
+        stderr = ''
+    elapsed = time.monotonic() - start
+    if status in (124, 137, 'TIMEOUT (wrapper)'):
+        status = f"TIMEOUT({timeout_sec}s)"
+    return status, stdout, stderr, elapsed
+
+
+def _clip(text, limit):
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... ({len(text) - limit} more chars)"
+
+
+def tool_function(reference_cmd, candidate_cmd, generator_cmd, num_cases, timeout_sec):
+    try:
+        num_cases = int(num_cases)
+        timeout_sec = int(timeout_sec)
+    except (TypeError, ValueError):
+        return "Error: num_cases and timeout_sec must be integers."
+    if num_cases <= 0:
+        return "Error: num_cases must be positive."
+    if timeout_sec <= 0:
+        timeout_sec = 10
+
+    mismatches = 0
+    first_fail = None
+    max_ref = 0.0
+    max_cand = 0.0
+    gen_errors = 0
+
+    for seed in range(num_cases):
+        gstatus, gin, gerr, _ = _run(f"{generator_cmd} {seed}", "", timeout_sec)
+        if gstatus != 0 or not gin.strip():
+            gen_errors += 1
+            if gen_errors == 1:
+                first_gen_error = f"seed={seed} status={gstatus} stderr={_clip(gerr, 500)}"
+            continue
+
+        rstatus, rout, rerr, rt = _run(reference_cmd, gin, timeout_sec)
+        cstatus, cout, cerr, ct = _run(candidate_cmd, gin, timeout_sec)
+        max_ref = max(max_ref, rt)
+        max_cand = max(max_cand, ct)
+
+        same = (rstatus == 0 and cstatus == 0 and rout.rstrip() == cout.rstrip())
+        if not same:
+            mismatches += 1
+            if first_fail is None:
+                first_fail = {
+                    "seed": seed,
+                    "input": gin,
+                    "ref_status": rstatus, "ref_stdout": rout, "ref_stderr": rerr,
+                    "cand_status": cstatus, "cand_stdout": cout, "cand_stderr": cerr,
+                }
+
+    cases_run = num_cases - gen_errors
+    lines = [
+        f"cases_run: {cases_run} of {num_cases}",
+        f"mismatches: {mismatches}",
+        f"max_runtime_reference_sec: {max_ref:.3f}",
+        f"max_runtime_candidate_sec: {max_cand:.3f}",
+    ]
+    if gen_errors:
+        lines.append(f"generator_failures: {gen_errors} (first: {first_gen_error})")
+    if first_fail is None:
+        lines.append("RESULT: all cases matched." if cases_run > 0 else "RESULT: no cases ran.")
+    else:
+        f = first_fail
+        lines.append(f"first_failing_seed: {f['seed']}")
+        lines.append(f"first_failing_input:\n{_clip(f['input'], MAX_INPUT_CHARS)}")
+        lines.append(f"reference status={f['ref_status']} stdout:\n{_clip(f['ref_stdout'], MAX_OUTPUT_CHARS)}")
+        if f['ref_stderr'].strip():
+            lines.append(f"reference stderr:\n{_clip(f['ref_stderr'], 500)}")
+        lines.append(f"candidate status={f['cand_status']} stdout:\n{_clip(f['cand_stdout'], MAX_OUTPUT_CHARS)}")
+        if f['cand_stderr'].strip():
+            lines.append(f"candidate stderr:\n{_clip(f['cand_stderr'], 500)}")
+    return "\n".join(lines)
