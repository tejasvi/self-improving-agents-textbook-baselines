+    def _design_prompt(self, instruction):
+        """Design-first prompt: constraints -> complexity budget -> algorithm -> slow reference."""
+        target_path = os.path.join(self.git_tempdir, self._target_file())
+        return instruction + f"""Design phase (do this BEFORE writing the solution).
+
+1. Constraints: list every input size and value limit from the problem statement (maximum n, maximum values, time limit if given).
+2. Complexity budget: from the maximum constraints, derive the affordable cost. Plain Python does roughly 1e7-1e8 basic operations in a few seconds; numpy vector operations and precomputed factorials/inverses mod p are allowed.
+3. Algorithm: state the intended algorithm and its complexity in one or two sentences. If a naive method (e.g. O(W*H) or O(n^2) over large values) exceeds the budget, choose a different method (closed form, prefix sums, two pointers, sorting, DP with a smaller state, combinatorics, convolution) BEFORE coding.
+4. Slow reference: write an obviously-correct but slow solution to /tmp/ref/ref.py (scratch, NOT inside {self.git_tempdir}). It may be exponential or O(n^3); its only purpose is to validate the efficient solution on small inputs.
+
+Only after steps 1-4 are done, write the efficient solution to {target_path} with the editor tool, then test it on the samples and against /tmp/ref/ref.py on small inputs."""
+
+    def _run_timing(self, target_path, limit=1.0):
+        """Deterministically time the solution on /tmp/stress/max_input.txt if the agent wrote it.
+        Returns (ran, too_slow_or_failed, detail)."""
+        max_input = '/tmp/stress/max_input.txt'
+        if not os.path.isfile(max_input) or not os.path.isfile(target_path):
+            return False, False, 'no max-size input or target file'
+        try:
+            with open(max_input, 'rb') as fh:
+                data = fh.read()
+            start = time.monotonic()
+            proc = subprocess.run(['python3', target_path], input=data, stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE, timeout=limit * 5)
+            elapsed = time.monotonic() - start
+        except subprocess.TimeoutExpired:
+            return True, True, f'timed out (> {limit * 5:.0f}s)'
+        except Exception as e:
+            return True, True, f'could not run: {e}'
+        if proc.returncode != 0:
+            return True, True, f'runtime error (exit {proc.returncode}): {proc.stderr.decode(errors="replace")[-300:]}'
+        return True, elapsed > limit, f'{elapsed:.2f}s'
+
+    SLOW_PATTERN = re.compile(r'\b(not efficient|too slow|time[ -]?out|timed out|tle)\b', re.IGNORECASE)
+
+    def _complexity_gate(self, msg_history, max_rounds=3):
+        """
+        Timing gate before verification. Asks the agent to time a max-size input; also checks the
+        agent-written /tmp/stress/max_input.txt deterministically. Runs a bounded redesign round when the
+        solution is too slow or the agent's last text says so. Keeps /tmp/stress/best_solution.py updated.
+        """
+        target_path = os.path.join(self.git_tempdir, self._target_file())
+        os.makedirs('/tmp/stress', exist_ok=True)
+        for round_idx in range(max_rounds):
+            ran, failed, detail = self._run_timing(target_path)
+            text = self._last_message_text(msg_history)
+            says_slow = bool(self.SLOW_PATTERN.search(text))
+            safe_log(f"Complexity gate round {round_idx + 1}/{max_rounds}: timing={detail}, "
+                     f"says_slow={says_slow}, timing_failed={failed}")
+            if not failed and not says_slow:
+                if os.path.isfile(target_path):
+                    shutil.copyfile(target_path, '/tmp/stress/best_solution.py')
+                return msg_history
+            prompt = (
+                "Complexity check failed: " + (f"the timing test reported: {detail}. " if ran else "")
+                + ("Your last message says the solution is too slow or not efficient. " if says_slow else "")
+                + f"\n\nRedesign round (bounded, keep reasoning brief). Target: {target_path}\n"
+                "1. Tabulate the slow reference (/tmp/ref/ref.py) on small inputs and look for patterns.\n"
+                "2. Look for closed forms, inclusion-exclusion, prefix sums, two pointers, convolution, "
+                "or combinatorics with precomputed factorials mod p.\n"
+                "3. Implement the faster algorithm in the target file with the editor tool.\n"
+                "4. Validate it against /tmp/ref/ref.py on small and medium inputs, then regenerate a max-size "
+                "input at /tmp/stress/max_input.txt and time it with the time_check tool.\n"
+                "Do not stop until the max-size run is OK."
+            )
+            backup = '/tmp/stress/best_solution.py'
+            if os.path.isfile(target_path) and not failed:
+                shutil.copyfile(target_path, backup)
+            msg_history = chat_with_agent(prompt, model=self.code_model, msg_history=msg_history, logging=safe_log)
+        # Final check: restore the last verified solution if the redesign never got fast enough.
+        ran, failed, detail = self._run_timing(target_path)
+        if failed and os.path.isfile('/tmp/stress/best_solution.py'):
+            safe_log(f"Complexity gate: still failing ({detail}); restoring /tmp/stress/best_solution.py.")
+            shutil.copyfile('/tmp/stress/best_solution.py', target_path)
+        return msg_history
+
     def _verification_prompt(self, round_idx, max_rounds):
