+def _message_contains_text(msg, text):
+    """True if the text is already present in the message content (string or block list)."""
+    content = msg.get("content")
+    if isinstance(content, str):
+        return text in content
+    if isinstance(content, list):
+        for block in content:
+            block_text = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+            if block_text and text in block_text:
+                return True
+    return False
+
+
 def _append_nudge(msg_history, text):
     """
     Add a nudge without stacking consecutive user messages: merge it into the last
     message if that is a user message (tool_result or text), otherwise append a new user message.
+    An identical nudge already present in that user message is not added again.
     """
     if msg_history and msg_history[-1].get("role") == "user":
         last = msg_history[-1]
+        if _message_contains_text(last, text):
+            return msg_history
         content = last.get("content")
         if isinstance(content, str):
             last["content"] = content + "\n\n" + text
diff --git a/tools/time_check.py b/tools/time_check.py
new file mode 100644
index 0000000..4d02c90
--- /dev/null
+++ b/tools/time_check.py
@@ -0,0 +1,128 @@
+import os
+import signal
+import subprocess
+import time
+
+
+def _run_killable(cmd, data, timeout):
+    """Run a shell command in its own process group; kill the whole group on timeout."""
+    proc = subprocess.Popen(cmd, shell=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, start_new_session=True)
+    try:
+        out, err = proc.communicate(data, timeout=timeout)
+        return proc.returncode, out, err
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        proc.communicate()
+        raise
+
+MAX_OUTPUT_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "time_check",
+        "description": """Time a solution program on a large input with a hard time limit and report a verdict.
+* Provide the input either as `input_text` (short inputs) or as `generator_cmd` (a shell command that prints the input to stdout, e.g. `python3 /tmp/stress/max_gen.py`). Prefer `generator_cmd` for max-size inputs.
+* The solution command is run through the shell and receives the input on stdin.
+* Returns the wall time of each run, the exit code, a truncated stdout, and a verdict: 'OK' or 'TOO SLOW (> limit)' (also 'TIMEOUT', 'RUNTIME ERROR').
+* Use it to check that the solution fits the time limit on maximum-size inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution, e.g. 'python3 /dgm/solution.py'. It reads the input on stdin."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Optional. Shell command that prints a (max-size) test input to stdout. The generator output is regenerated for each run."
+                },
+                "input_text": {
+                    "type": "string",
+                    "description": "Optional. The test input as literal text. Used only when generator_cmd is not given."
+                },
+                "time_limit_seconds": {
+                    "type": "number",
+                    "description": "Optional. Time limit in seconds for each run. Defaults to 2."
+                },
+                "runs": {
+                    "type": "integer",
+                    "description": "Optional. Number of timed runs (the worst time is reported). Defaults to 1."
+                }
+            },
+            "required": ["solution_cmd"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... (truncated, {len(text) - limit} more characters)"
+
+
+def tool_function(solution_cmd, generator_cmd=None, input_text=None, time_limit_seconds=2, runs=1):
+    try:
+        limit = float(time_limit_seconds) if time_limit_seconds is not None else 2.0
+    except (TypeError, ValueError):
+        limit = 2.0
+    try:
+        runs = int(runs) if runs is not None else 1
+    except (TypeError, ValueError):
+        runs = 1
+    runs = max(1, min(runs, 5))
+
+    # The generator is re-run for each timed run so every run gets a fresh input.
+    lines = []
+    worst = 0.0
+    verdict = 'OK'
+    last_code = None
+    last_out = ''
+    last_err = ''
+    for i in range(runs):
+        if generator_cmd:
+            try:
+                gcode, gout, gerr = _run_killable(generator_cmd, None, max(limit * 5, 60))
+            except subprocess.TimeoutExpired:
+                return f"Verdict: GENERATOR TIMEOUT. The generator command did not finish: {generator_cmd}"
+            if gcode != 0:
+                return (f"Verdict: GENERATOR FAILED (exit {gcode}).\n"
+                        f"stderr: {_truncate(gerr.decode(errors='replace'))}")
+            data = gout
+        else:
+            data = (input_text or '').encode()
+        start = time.monotonic()
+        try:
+            code, out, err = _run_killable(solution_cmd, data, limit)
+            elapsed = time.monotonic() - start
+            last_code = code
+            last_out = out.decode(errors='replace')
+            last_err = err.decode(errors='replace')
+        except subprocess.TimeoutExpired:
+            elapsed = time.monotonic() - start
+            last_code = None
+            last_out = ''
+            last_err = ''
+            worst = max(worst, elapsed)
+            verdict = f'TIMEOUT (> {limit:g}s limit)'
+            lines.append(f"run {i + 1}: killed after {elapsed:.2f}s")
+            break
+        worst = max(worst, elapsed)
+        lines.append(f"run {i + 1}: {elapsed:.2f}s, exit code {last_code}")
+        if last_code != 0:
+            verdict = 'RUNTIME ERROR'
+            break
+        if elapsed > limit:
+            verdict = f'TOO SLOW (> {limit:g}s limit)'
+            break
+
+    report = [f"Verdict: {verdict}", f"Time limit: {limit:g}s", f"Worst wall time: {worst:.2f}s"]
+    report.extend(lines)
+    report.append(f"stdout (truncated):\n{_truncate(last_out)}")
+    if last_err:
+        report.append(f"stderr (truncated):\n{_truncate(last_err)}")
+    return "\n".join(report)
