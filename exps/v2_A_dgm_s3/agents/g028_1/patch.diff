diff --git a/tools/time_check.py b/tools/time_check.py
new file mode 100644
index 0000000..e4cee54
--- /dev/null
+++ b/tools/time_check.py
@@ -0,0 +1,88 @@
+import os
+import subprocess
+import time
+
+DEFAULT_LEVELS = ["max_random", "max_equal", "max_adversarial"]
+DEFAULT_TIMEOUT = 2.0
+TAIL_CHARS = 800
+
+
+def tool_info():
+    return {
+        "name": "time_check",
+        "description": """Time a solution on large generated inputs, one run per size level.\n
+* For each level in `size_levels`, runs `<generator_cmd> <level>` to produce an input, pipes it into `solution_cmd` via stdin, and measures wall time.\n
+* Returns raw lines like `max_random: 0.43s` or `max_random: TIMEOUT after 2s`, followed by raw stderr tails of failing runs. No parsing is done.\n
+* For a `Solution` class method, write a small wrapper under /tmp (e.g. /tmp/stress/wrapper.py) that reads the input from stdin, calls the method, and prints the result; pass it as `wrapper_cmd` (it is run instead of `solution_cmd`).\n
+* Keep scratch files outside the repository, e.g. under /tmp.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; reads the test input on stdin. Example: `python3 /repo/solution.py`."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that generates a max-size input on stdout when called as `<generator_cmd> <level>`. Example: `python3 /tmp/stress/gen.py`."
+                },
+                "size_levels": {
+                    "type": "array",
+                    "items": {
+                        "type": "string",
+                        "description": "A size level name passed to the generator, e.g. `max_random`, `max_equal`, `max_adversarial`, or `max`."
+                    },
+                    "description": "Optional. Size levels to time. Defaults to max_random, max_equal, max_adversarial."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional. Per-run timeout in seconds. Defaults to 2."
+                },
+                "wrapper_cmd": {
+                    "type": "string",
+                    "description": "Optional. Shell command used instead of solution_cmd (for Solution-class methods wrapped under /tmp)."
+                }
+            },
+            "required": ["solution_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _tail(text):
+    text = text or ""
+    return text[-TAIL_CHARS:] if len(text) > TAIL_CHARS else text
+
+
+def tool_function(solution_cmd, generator_cmd, size_levels=None, timeout=None, wrapper_cmd=None):
+    levels = list(size_levels) if size_levels else list(DEFAULT_LEVELS)
+    limit = float(timeout) if timeout is not None else DEFAULT_TIMEOUT
+    run_cmd = wrapper_cmd or solution_cmd
+    lines = []
+    details = []
+    for level in levels:
+        gen = subprocess.run(
+            f"{generator_cmd} {level}", shell=True,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+        )
+        if gen.returncode != 0:
+            lines.append(f"{level}: GENERATOR FAILED (exit {gen.returncode})")
+            details.append(f"[{level}] generator stderr tail:\n{_tail(gen.stderr)}")
+            continue
+        start = time.perf_counter()
+        try:
+            run = subprocess.run(
+                run_cmd, shell=True, input=gen.stdout,
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+                timeout=limit,
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f"{level}: TIMEOUT after {limit:g}s")
+            continue
+        elapsed = time.perf_counter() - start
+        lines.append(f"{level}: {elapsed:.2f}s" + ("" if run.returncode == 0 else f" (exit {run.returncode})"))
+        if run.returncode != 0:
+            details.append(f"[{level}] stderr tail:\n{_tail(run.stderr)}")
+    result = "\n".join(lines)
+    if details:
+        result += "\n\n" + "\n\n".join(details)
+    return result
