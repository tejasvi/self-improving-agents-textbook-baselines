diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..887a438
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,151 @@
+import os
+import subprocess
+import sys
+import tempfile
+
+MAX_SHOW_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress testing of a solution against a brute-force reference.
+
+* The generator is run as `generator_path <seed>` (seed = 0..num_tests-1) and must print one test input to stdout.
+* The same input is fed via stdin to the solution and to the brute force, each with a timeout.
+* If `checker_path` is given, it is run as `checker_path <input_file> <solution_output_file> <brute_output_file>`; exit code 0 means the solution output is valid. Otherwise the outputs are compared token-by-token (whitespace-insensitive).
+* Scripts ending in .py are run with the current Python interpreter; other paths are executed directly (they must be executable).
+* Stops at the first mismatch, crash, or timeout and returns the failing input (truncated), both outputs and stderr. Otherwise returns 'all N tests passed'.
+* The output is raw; analyze it yourself to find the bug.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the simple, obviously-correct brute-force program (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator program that takes an integer seed as argv[1] and prints one test input to stdout."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional. Path to a checker for problems with multiple valid answers. Called as `checker <input_file> <solution_output_file> <brute_output_file>`; exit code 0 means valid."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 0..num_tests-1). Recommended: at least 500."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _command(path):
+    if path.endswith(".py"):
+        return [sys.executable, path]
+    return [path]
+
+
+def _truncate(text, limit=MAX_SHOW_CHARS):
+    if text is None:
+        return ""
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... (truncated, {len(text) - limit} more chars)"
+
+
+def _run(cmd, stdin_text, timeout_sec, args=()):
+    """Run a command; returns (status, stdout, stderr) where status is 'ok', 'crash', or 'timeout'."""
+    try:
+        proc = subprocess.run(
+            cmd + list(args),
+            input=stdin_text.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout_sec,
+            check=False,
+        )
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if e.stdout else ""
+        err = e.stderr.decode(errors="replace") if e.stderr else ""
+        return "timeout", out, err
+    except Exception as e:
+        return "crash", "", f"Failed to execute {cmd}: {e}"
+    out = proc.stdout.decode(errors="replace")
+    err = proc.stderr.decode(errors="replace")
+    if proc.returncode != 0:
+        return "crash", out, err
+    return "ok", out, err
+
+
+def tool_function(solution_path, brute_path, generator_path, checker_path=None, num_tests=500, timeout_sec=10):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 500
+    except (TypeError, ValueError):
+        num_tests = 500
+    try:
+        timeout_sec = float(timeout_sec) if timeout_sec is not None else 10.0
+    except (TypeError, ValueError):
+        timeout_sec = 10.0
+    if num_tests <= 0:
+        return "num_tests must be a positive integer."
+
+    sol_cmd = _command(solution_path)
+    brute_cmd = _command(brute_path)
+    gen_cmd = _command(generator_path)
+    checker_cmd = _command(checker_path) if checker_path else None
+
+    for i in range(num_tests):
+        status, test_input, gen_err = _run(gen_cmd, "", timeout_sec, args=[str(i)])
+        if status != "ok":
+            return (f"Generator {status} on seed {i}.\n"
+                    f"stderr:\n{_truncate(gen_err)}")
+        if not test_input.strip():
+            return f"Generator produced empty input on seed {i}."
+
+        sol_status, sol_out, sol_err = _run(sol_cmd, test_input, timeout_sec)
+        brute_status, brute_out, brute_err = _run(brute_cmd, test_input, timeout_sec)
+
+        def fail_report(reason, sol_stderr=sol_err, brute_stderr=brute_err):
+            return (f"{reason} (test seed {i}).\n"
+                    f"--- input ---\n{_truncate(test_input)}\n"
+                    f"--- solution output ({sol_status}) ---\n{_truncate(sol_out)}\n"
+                    f"--- brute output ({brute_status}) ---\n{_truncate(brute_out)}\n"
+                    f"--- solution stderr ---\n{_truncate(sol_stderr)}\n"
+                    f"--- brute stderr ---\n{_truncate(brute_stderr)}")
+
+        if sol_status != "ok":
+            return fail_report(f"Solution {sol_status}")
+        if brute_status != "ok":
+            return fail_report(f"Brute force {brute_status} (fix the brute force or the input)")
+
+        if checker_cmd:
+            with tempfile.TemporaryDirectory() as tmpdir:
+                in_file = os.path.join(tmpdir, "input.txt")
+                sol_file = os.path.join(tmpdir, "sol_out.txt")
+                brute_file = os.path.join(tmpdir, "brute_out.txt")
+                with open(in_file, "w") as f:
+                    f.write(test_input)
+                with open(sol_file, "w") as f:
+                    f.write(sol_out)
+                with open(brute_file, "w") as f:
+                    f.write(brute_out)
+                chk_status, chk_out, chk_err = _run(checker_cmd, "", timeout_sec, args=[in_file, sol_file, brute_file])
+            if chk_status != "ok":
+                return fail_report(f"Checker rejected solution output (checker {chk_status})",
+                                   sol_stderr=(chk_out + "\n" + chk_err))
+        else:
+            if sol_out.split() != brute_out.split():
+                return fail_report("Output mismatch")
+
+    return f"all {num_tests} tests passed"
