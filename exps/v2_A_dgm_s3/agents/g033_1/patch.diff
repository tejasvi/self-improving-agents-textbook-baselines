@@ -0,0 +1,57 @@
+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "stress_time",
+        "description": """Run a shell command under a hard timeout and report the raw result.\n
+* Use this for stress/performance tests (e.g. `python solution.py < big_input.txt`) so that a slow solution is reported explicitly as a timeout instead of hanging the bash session.\n
+* Returns the raw stdout and stderr, the exit status (124 means the timeout was hit), and the elapsed wall time in seconds.\n
+* The command is run with `sh -c` in the current working directory.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. `python solution.py < input.txt`."
+                },
+                "timeout_sec": {
+                    "type": "integer",
+                    "description": "Maximum number of seconds the command may run before it is killed."
+                }
+            },
+            "required": ["command", "timeout_sec"]
+        }
+    }
+
+def tool_function(command, timeout_sec):
+    try:
+        timeout_sec = int(timeout_sec)
+    except (TypeError, ValueError):
+        timeout_sec = 10
+    if timeout_sec <= 0:
+        timeout_sec = 10
+    start = time.monotonic()
+    try:
+        result = subprocess.run(
+            ["timeout", "-k", "1", str(timeout_sec), "sh", "-c", command],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout_sec + 10,
+        )
+        status = result.returncode
+        stdout = result.stdout.decode(errors='replace')
+        stderr = result.stderr.decode(errors='replace')
+    except subprocess.TimeoutExpired as e:
+        status = 'TIMEOUT (wrapper)'
+        stdout = (e.stdout or b'').decode(errors='replace')
+        stderr = (e.stderr or b'').decode(errors='replace')
+    elapsed = time.monotonic() - start
+    note = ''
+    if status == 124 or status == 137:
+        note = f"\nTIMED OUT after {timeout_sec}s (killed)."
+    return (
+        f"exit_status: {status}\n"
+        f"elapsed_seconds: {elapsed:.3f}\n"
+        f"stdout:\n{stdout}\n"
+        f"stderr:\n{stderr}"
+        f"{note}"
+    )
