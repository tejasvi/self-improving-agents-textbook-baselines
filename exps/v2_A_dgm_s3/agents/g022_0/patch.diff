@@ -0,0 +1,95 @@
+import importlib.util
+import os
+
+_TOOLS_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+def _load_sibling(name):
+    """Load a sibling tool module by file path (tools/ is not necessarily a package on sys.path)."""
+    spec = importlib.util.spec_from_file_location(name, os.path.join(_TOOLS_DIR, f"{name}.py"))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def tool_info():
+    return {
+        "name": "candidate_eval",
+        "description": """Deterministic evaluator for a candidate solution. Runs two checks in one call and returns raw results:\n
+1. Correctness: compares the candidate with a trusted slow oracle on many generated inputs (via the stress_test logic) for each size level.\n
+2. Speed: runs the candidate on the scale inputs (via the scale_test logic) with a time limit.\n
+The result ends ; otherwise it ends with `CANDIDATE FAILED`.\n
+Scratch files should live under /tmp (e.g. /tmp/stress/).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidate_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the candidate solution on stdin/stdout, e.g. `python3 /tmp/cand_1.py`."
+                },
+                "oracle_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the trusted slow oracle on stdin/stdout, e.g. `python3 /tmp/stress/slow.py`."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that generates an input on stdout; called as `<generator_cmd> <size_level> <seed>`, e.g. `python3 /tmp/stress/gen.py`."
+                },
+                "size_levels": {
+                    "type": "array",
+                    "items": {
+                        "type": "string",
+                        "description": "A size level name such as tiny, medium or adversarial."
+                    },
+                    "description": "Size levels cycled over the correctness seeds, e.g. [\"tiny\", \"medium\"]."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of correctness test cases (seeds 1..num_tests)."
+                },
+                "scale_inputs": {
+                    "type": "array",
+                    "items": {
+                        "type": "string",
+                        "description": "A scale input: `$ <command>` generating the input (e.g. `$ python3 /tmp/stress/gen_scale.py max`) or literal input text."
+                    },
+                    "description": "Max-size and skewed inputs used for timing."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Per-run wall-clock time limit in seconds for the scale inputs."
+                }
+            },
+            "required": ["candidate_cmd", "oracle_cmd", "generator_cmd", "size_levels", "num_tests", "scale_inputs", "time_limit"]
+        }
+    }
+
+
+def tool_function(candidate_cmd, oracle_cmd, generator_cmd, size_levels, num_tests, scale_inputs, time_limit):
+    stress_test = _load_sibling("stress_test")
+    scale_test = _load_sibling("scale_test")
+    parts = []
+
+    correctness = stress_test.tool_function(
+        solution_cmd=candidate_cmd,
+        generator_cmd=generator_cmd,
+        num_tests=num_tests,
+        brute_cmd=oracle_cmd,
+        size_levels=size_levels,
+    )
+    parts.append("== CORRECTNESS (stress_test) ==\n" + str(correctness))
+    correct = "ALL TESTS PASSED" in str(correctness)
+
+    scale = scale_test.tool_function(
+        solution_cmd=candidate_cmd,
+        inputs=list(scale_inputs),
+        time_limit=time_limit,
+    )
+    parts.append("== SPEED (scale_test) ==\n" + str(scale))
+    # Every scale input must have actually run (a generator error yields no wall_time line).
+    ran_ok = str(scale).count("wall_time=") == len(scale_inputs) and "timed_out=False" in str(scale) \
+        and str(scale).count("timed_out=False") == len(scale_inputs)
+
+    passed = correct and ran_ok
+    parts.append("CANDIDATE PASSED" if passed else "CANDIDATE FAILED")
+    return "\n\n".join(parts)
