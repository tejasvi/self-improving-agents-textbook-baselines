+def _message_text(msg):
+    """Concatenated text of a message's content (string or list of blocks)."""
+    content = msg.get("content")
+    if isinstance(content, str):
+        return content
+    parts = []
+    for block in content or []:
+        text = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+        if text:
+            parts.append(text)
+    return "\n".join(parts)
+
+
 def _append_nudge(msg_history, text):
     """
     Add a nudge without stacking consecutive user messages: merge it into the last
     message if that is a user message (tool_result or text), otherwise append a new user message.
+    A nudge is skipped when the last user message already ends with the same text.
     """
     if msg_history and msg_history[-1].get("role") == "user":
         last = msg_history[-1]
+        if _message_text(last).rstrip().endswith(text.strip()):
+            return msg_history
         content = last.get("content")
         if isinstance(content, str):
             last["content"] = content + "\n\n" + text
diff --git a/tests/test_thinking_control.py b/tests/test_thinking_control.py
new file mode 100644
index 0000000..b3de0dd
--- /dev/null
+++ b/tests/test_thinking_control.py
@@ -0,0 +1,94 @@
+import os
+import sys
+from types import SimpleNamespace as NS
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import llm  # noqa: E402
+from llm import _thinking_attempt_configs, _call_with_thinking_control  # noqa: E402
+from llm_withtools import _append_nudge  # noqa: E402
+
+
+def _resp(stop_reason, text=None, tool=False, thinking_tokens=None):
+    content = []
+    if text is not None:
+        content.append(NS(type="text", text=text))
+    if tool:
+        content.append(NS(type="tool_use", id="t1", name="editor", input={}))
+    details = NS(thinking_tokens=thinking_tokens) if thinking_tokens is not None else None
+    return NS(stop_reason=stop_reason, content=content,
+              usage=NS(output_tokens=100, output_tokens_details=details))
+
+
+def test_ladder_claude35_thinking_first_then_disabled():
+    cfgs = _thinking_attempt_configs("claude-sonnet-4-20250514")
+    assert cfgs[0]["thinking"] == {"type": "enabled", "budget_tokens": 2000}
+    assert cfgs[0]["max_tokens"] == 16000
+    assert cfgs[1]["thinking"] == {"type": "disabled"}
+    assert all(c["thinking"] is None or c["thinking"]["type"] in ("enabled", "disabled") for c in cfgs)
+    for c in cfgs:
+        if c["thinking"] and c["thinking"]["type"] == "enabled":
+            assert 1024 <= c["thinking"]["budget_tokens"] < c["max_tokens"]
+    assert len(cfgs) <= 3
+    assert len({repr(c) for c in cfgs}) == len(cfgs)
+
+
+def test_ladder_claude3_has_no_thinking_param_and_8192_cap():
+    for model in ("claude-3-5-sonnet-20240620", "claude-3-opus-20240229",
+                  "bedrock/anthropic.claude-3-haiku-20240307-v1:0"):
+        cfgs = _thinking_attempt_configs(model)
+        assert cfgs, model
+        assert all(c["thinking"] is None for c in cfgs), model
+        assert all(c["max_tokens"] <= 8192 for c in cfgs), model
+
+
+def test_allow_thinking_false_omits_enabled():
+    cfgs = _thinking_attempt_configs("claude-3-5-sonnet-20241022", allow_thinking=False)
+    assert all(c["thinking"] != {"type": "enabled", "budget_tokens": 2000} for c in cfgs)
+    assert all(c["thinking"] is None or c["thinking"]["type"] == "disabled" for c in cfgs)
+
+
+def test_fallback_to_tool_call_when_thinking_exhausts_budget():
+    calls = []
+
+    def create(max_tokens, **kw):
+        calls.append((max_tokens, kw.get("thinking")))
+        if kw.get("thinking", {}).get("type") == "enabled":
+            return _resp("max_tokens", thinking_tokens=max_tokens)
+        return _resp("tool_use", tool=True)
+
+    logs = []
+    out = _call_with_thinking_control(create, log=logs.append, model="claude-sonnet-4-20250514",
+                                      messages=[], temperature=0.7)
+    assert out.stop_reason == "tool_use"
+    assert len(calls) == 2
+    assert calls[0][1]["type"] == "enabled"
+    assert calls[1][1] == {"type": "disabled"}
+    assert any("thinking_tokens=16000" in m for m in logs)
+
+
+def test_claude3_never_sends_thinking_kwarg():
+    seen = []
+
+    def create(max_tokens, **kw):
+        seen.append(kw)
+        return _resp("max_tokens")
+
+    _call_with_thinking_control(create, log=lambda m: None, model="claude-3-5-sonnet-20240620", messages=[])
+    assert seen and all("thinking" not in kw for kw in seen)
+
+
+def test_returns_text_even_at_max_tokens():
+    out = _call_with_thinking_control(lambda max_tokens, **kw: _resp("max_tokens", text="hi"),
+                                      log=lambda m: None, model="claude-3-5-sonnet-20241022", messages=[])
+    assert out.content[0].text == "hi"
+
+
+def test_nudge_not_duplicated():
+    hist = [{"role": "user", "content": [{"type": "text", "text": "task"}]}]
+    nudge = "Continue: call the editor tool now."
+    _append_nudge(hist, nudge)
+    _append_nudge(hist, nudge)
+    assert len(hist) == 1
+    texts = [b["text"] for b in hist[0]["content"]]
+    assert texts.count(nudge) == 1
