+    def _infer_target_filename(self):
+        """
+        Infer the target file name from the problem statement.
+        Uses a backticked *.py name if present; defaults to solution.py.
+        """
+        m = re.search(r'`([\w\-./]+\.py)`', self.problem_statement)
+        if m:
+            return m.group(1)
+        return 'solution.py'
+
+    def _fallback_write_solution(self):
+        """
+        Last-resort: make a tool-free LLM call asking for the full solution file contents,
+        extract the code block and write it to the git_tempdir.
+        """
+        filename = self._infer_target_filename()
+        safe_log(f"[forward] Fallback: requesting full contents of {filename} (tool-free).")
+        prompt = (
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            f"Output ONLY the full contents of {filename} in a single ```python block. "
+            "The file must be a complete, runnable Python program or implementation that solves the problem above. "
+            "Do not include any other text."
+        )
+        try:
+            client, client_model = create_client(self.code_model)
+            response, _ = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message="You are an expert competitive programmer. Respond only with the requested code.",
+                print_debug=False,
+                msg_history=[],
+            )
+        except Exception as e:
+            safe_log(f"[forward] Fallback LLM call failed: {e}")
+            return False
+
+        match = re.search(r'```(?:python|py)?[ \t]*\n(.*?)```', response or '', flags=re.DOTALL)
+        if not match:
+            safe_log(f"[forward] Fallback: no ```python code block found in response.")
+            return False
+        code = match.group(1)
+        target = os.path.join(self.git_tempdir, filename)
+        os.makedirs(os.path.dirname(target) or '.', exist_ok=True)
+        with open(target, 'w') as f:
+            f.write(code)
+        safe_log(f"[forward] Fallback: wrote {len(code)} chars to {target}")
+        return True
+
