+                    "description": "Arguments for big_gen_cmd, e.g. ['max_random', 'all_equal']."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for the generators, brute force and solution (default 10)."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "The problem's real time limit in seconds, used for big-input timing verdicts."
+                }
+            },
+            "required": ["solution_cmd", "brute_cmd", "gen_cmd", "iterations"]
+        }
+    }
+
+
+def tool_function(solution_cmd, brute_cmd, gen_cmd, iterations, samples=None, extra_inputs=None,
+                  big_gen_cmd=None, big_args=None, timeout=10, time_limit=None):
+    from utils.suite import score_suite, format_score
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        return f"Error: iterations must be an integer, got {iterations!r}"
+    if isinstance(samples, str):
+        try:
+            samples = json.loads(samples)
+        except Exception:
+            return "Error: samples must be a list of {input, output} objects."
+    if isinstance(extra_inputs, str):
+        extra_inputs = [extra_inputs]
+    if isinstance(big_args, str):
+        big_args = [big_args]
+    try:
+        result = score_suite(
+            solution_cmd=solution_cmd, brute_cmd=brute_cmd, gen_cmd=gen_cmd,
+            big_gen_cmd=big_gen_cmd, big_args=big_args, samples=samples,
+            extra_inputs=extra_inputs, iterations=iterations,
+            timeout=timeout, time_limit=time_limit,
+        )
+    except Exception as e:
+        return f"Error running suite: {e}"
+    text = format_score(result)
+    ff = result['first_failure']
+    if ff:
+        text += (
+            f"\n--- first failure: {ff['reason']} ---\n"
+            f"input:\n{ff['input']}\nexpected:\n{ff['expected']}\nactual:\n{ff['actual']}\n"
+            f"stderr tail:\n{ff['stderr']}"
+        )
+    return text
