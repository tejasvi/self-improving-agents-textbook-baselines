+    def forward(self):
+        """
+        Test-gated multi-attempt solving:
+        1. build a shared suite once (outside the repo);
+        2. run up to NUM_ATTEMPTS attempts from base_commit, each scored by the same suite;
+        3. apply the best patch, run one reflection round if it still fails;
+        4. run an independent review, add its inputs to the suite and re-score the final patch.
