+"""
+Shared test-suite scoring used both by the agent's `run_suite` tool and by the
+orchestrator (coding_agent.py), so every candidate is scored by the same code.
+
+A suite is described by:
+  - solution_cmd: shell command running the candidate (reads stdin, writes stdout)
+  - brute_cmd:    shell command running the brute-force oracle
+  - gen_cmd:      random generator, invoked as `<gen_cmd> <seed>`
+  - big_gen_cmd:  optional max-size generator, invoked as `<big_gen_cmd> <arg>`
+  - big_args:     list of args for big_gen_cmd (default: ['max_1'])
+  - samples:      list of {"input": str, "output": str} from the problem statement
+  - extra_inputs: list of extra raw inputs (e.g. adversarial cases from a reviewer);
+                  their expected outputs come from brute_cmd
+  - iterations:   number of random seeds for the stress phase
+  - timeout:      per-run timeout (seconds) for solution/brute/generators
+  - time_limit:   the solution's time limit used for big-input timing verdicts
+"""
+import os
+import subprocess
+import tempfile
+import time
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in (text or '').strip().splitlines()]
+    return "\n".join(lines)
+
+
+def _run(cmd, stdin_text=None, timeout=10.0):
+    """Run a shell command. Returns (returncode, stdout, stderr, timed_out, elapsed)."""
+    start = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True,
+            text=True, timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, False, time.perf_counter() - start
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+        err = e.stderr.decode(errors='replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+        return None, out, err, True, time.perf_counter() - start
+
+
+def _tail(text, n=600):
+    text = (text or '').strip()
+    return text[-n:] if len(text) > n else text
+
+
+def score_suite(solution_cmd, brute_cmd, gen_cmd=None, big_gen_cmd=None, big_args=None,
+                samples=None, extra_inputs=None, iterations=200, timeout=10.0, time_limit=None,
+                deadline=None):
+    """
+    Run all suite phases and return a dict:
+      {
+        'samples_passed': int, 'samples_total': int,
+        'stress_failures': int, 'stress_total': int,
+        'first_failure': None or {'input', 'expected', 'actual', 'reason', 'stderr'},
+        'timeouts': int,           # number of big/perf cases that exceeded the time limit
+        'big_results': [str],
+        'passed': bool,            # all samples, stress, extra inputs and big cases OK
+        'score': float,            # monotone ranking key (higher is better)
+      }
+    The first failing case (any phase) is recorded in first_failure with its expected and
+    actual output, so that the agent can reason about it in the next attempt.
+    """
+    timeout = float(timeout or 10.0)
+    time_limit = float(time_limit) if time_limit else timeout
+    samples = samples or []
+    extra_inputs = extra_inputs or []
+    iterations = int(iterations or 0)
+    result = {
+        'samples_passed': 0, 'samples_total': len(samples),
+        'stress_failures': 0, 'stress_total': 0,
+        'extra_failures': 0, 'extra_total': len(extra_inputs),
+        'first_failure': None, 'timeouts': 0, 'big_results': [], 'passed': False, 'score': 0.0,
+        'incomplete': False,
+    }
+    def out_of_time():
+        return deadline is not None and time.time() > deadline
+
+    def record_failure(test_input, expected, actual, reason, stderr=''):
+        if result['first_failure'] is None:
+            result['first_failure'] = {
+                'input': test_input, 'expected': expected, 'actual': actual,
+                'reason': reason, 'stderr': _tail(stderr),
+            }
+
+    # Phase 1: samples (expected output given by the statement).
+    for s in samples:
+        rc, out, err, to, _ = _run(solution_cmd, s.get('input', ''), timeout=timeout)
+        if to:
+            record_failure(s.get('input', ''), s.get('output', ''), out, f'sample timed out ({timeout}s)', err)
+            result['timeouts'] += 1
+            continue
+        if rc != 0:
+            record_failure(s.get('input', ''), s.get('output', ''), out, f'sample exited with code {rc}', err)
+            continue
+        if _normalize(out) == _normalize(s.get('output', '')):
+            result['samples_passed'] += 1
+        else:
+            record_failure(s.get('input', ''), s.get('output', ''), out, 'sample output mismatch', err)
+
+    # Phase 2: stress against brute force (exact match).
+    def check_against_brute(test_input, label):
+        brute_rc, brute_out, brute_err, brute_to, _ = _run(brute_cmd, test_input, timeout=timeout)
+        if brute_to or brute_rc != 0:
+            return None, f'brute force failed on {label} (rc={brute_rc}, timeout={brute_to})'
+        sol_rc, sol_out, sol_err, sol_to, _ = _run(solution_cmd, test_input, timeout=timeout)
+        if sol_to:
+            return False, (brute_out, sol_out, f'solution timed out on {label} ({timeout}s)', sol_err)
+        if sol_rc != 0:
+            return False, (brute_out, sol_out, f'solution exited with code {sol_rc} on {label}', sol_err)
+        if _normalize(sol_out) != _normalize(brute_out):
+            return False, (brute_out, sol_out, f'output differs from brute force on {label}', sol_err)
+        return True, None
+
+    if gen_cmd and iterations > 0:
+        for seed in range(1, iterations + 1):
+            if out_of_time():
+                result['incomplete'] = True
+                break
+            gen_rc, gen_out, gen_err, gen_to, _ = _run(f"{gen_cmd} {seed}", timeout=timeout)
+            if gen_to or gen_rc != 0:
+                continue  # a broken generator is not a candidate failure
+            result['stress_total'] += 1
+            ok, detail = check_against_brute(gen_out, f'seed {seed}')
+            if ok is None:
+                continue
+            if ok:
+                continue
+            result['stress_failures'] += 1
+            if detail and isinstance(detail, tuple):
+                exp, act, reason, err = detail
+                record_failure(gen_out, exp, act, reason, err)
+                if reason.startswith('solution timed out'):
+                    result['timeouts'] += 1
+
+    # Phase 3: extra inputs (e.g. adversarial cases proposed by a reviewer).
+    for idx, extra in enumerate(extra_inputs):
+        ok, detail = check_against_brute(extra, f'extra case {idx + 1}')
+        if ok is None or ok:
+            continue
+        result['extra_failures'] += 1
+        exp, act, reason, err = detail
+        record_failure(extra, exp, act, reason, err)
+
+    # Phase 4: big inputs - correctness is not checked (no oracle at that size), only time.
+    if big_gen_cmd:
+        for arg in (big_args or ['max_1']):
+            if out_of_time():
+                result['incomplete'] = True
+                break
+            g_rc, g_out, g_err, g_to, _ = _run(f"{big_gen_cmd} {arg}", timeout=max(timeout, 60.0))
+            if g_to or g_rc != 0:
+                result['big_results'].append(f"[{arg}] GEN_ERROR")
+                continue
+            s_rc, s_out, s_err, s_to, elapsed = _run(solution_cmd, g_out, timeout=time_limit)
+            if s_to:
+                result['timeouts'] += 1
+                result['big_results'].append(f"[{arg}] TIMEOUT >{time_limit}s")
+            elif s_rc != 0:
+                result['big_results'].append(f"[{arg}] ERROR rc={s_rc}: {_tail(s_err, 200)}")
+            else:
+                result['big_results'].append(f"[{arg}] OK {elapsed:.3f}s")
+
+    total_fail = result['stress_failures'] + result['extra_failures']
+    samples_ok = result['samples_passed'] == result['samples_total']
+    result['passed'] = (
+        samples_ok and total_fail == 0 and not result['incomplete'] and result['timeouts'] == 0
+        and not any('ERROR' in r or 'TIMEOUT' in r for r in result['big_results'])
+    )
+    # Monotone ranking key: samples dominate, then fewer failures, then no timeouts.
+    result['score'] = (
+        result['samples_passed'] * 1000.0
+        - total_fail * 10.0
+        - result['timeouts'] * 100.0
+        + (1000000.0 if result['passed'] else 0.0)
+    )
+    return result
+
+
+def format_score(result):
+    """Human-readable one-block summary of a score_suite() result."""
+    lines = [
+        f"samples: {result['samples_passed']}/{result['samples_total']} passed",
+        f"stress: {result['stress_failures']} failures out of {result['stress_total']}",
+        f"extra inputs: {result['extra_failures']} failures out of {result['extra_total']}",
+        f"timeouts: {result['timeouts']}",
+    ]
+    lines += [f"big: {r}" for r in result['big_results']]
+    lines.append(f"passed: {result['passed']}")
+    return "\n".join(lines)
+
+
+def workspace_dir(prefix='suite_'):
+    return tempfile.mkdtemp(prefix=prefix)
