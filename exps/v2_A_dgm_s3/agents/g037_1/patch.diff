+                safe_log(f"Time budget exceeded; skipping attempt {k + 1}.")
+                break
+            self._restore_state('')
+            prompt = self._attempt_prompt(attempts, scratch)
+            safe_log(f"=== Attempt {k + 1}/{NUM_ATTEMPTS} (elapsed {time.time() - start:.0f}s) ===")
