diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..11580e8
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,162 @@
+import os
+import re
+import resource
+import subprocess
+
+MAX_CHARS = 1500
+MAX_SAMPLES = 50
+
+# Problem statement used when no problem_file is given. Set by the agent via set_problem_statement().
+_DEFAULT_PROBLEM_TEXT = ""
+
+
+def set_problem_statement(text):
+    """Store the task text so that run_samples can extract samples without a problem_file."""
+    global _DEFAULT_PROBLEM_TEXT
+    _DEFAULT_PROBLEM_TEXT = text or ""
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a Python solution on every 'Sample Input N' / 'Sample Output N' block of the problem statement.\n
+* Extracts the samples from problem_file (the README/statement) if given, otherwise from the task text.\n
+* Runs `python3 solution_path` on each sample input with the given timeout (seconds) and memory limit (MB).\n
+* Reports PASS / FAIL / TIMEOUT / MEMORY per sample, with truncated actual and expected outputs and stderr.\n
+* Use it on the small samples right after writing a solution, and on the large samples before finishing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run, e.g. 'solution.py'."
+                },
+                "problem_file": {
+                    "type": "string",
+                    "description": "Optional. Path to the problem statement file (e.g. README.md) containing the samples. If omitted, the task text is used."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional. Time limit per sample run in seconds (default 10)."
+                },
+                "memory_mb": {
+                    "type": "integer",
+                    "description": "Optional. Memory limit per sample run in megabytes (default 512)."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _clean_block(text):
+    """Strip surrounding whitespace and markdown code fences from a sample block."""
+    text = text.strip()
+    text = re.sub(r'^```[^\n]*\n', '', text)
+    text = re.sub(r'\n?```\s*$', '', text)
+    return text.strip()
+
+
+def extract_samples(text):
+    """
+    Return a list of (index, input_text, expected_output_text) for every Sample Input / Sample Output pair.
+    """
+    header = re.compile(r'Sample\s+(Input|Output)\s*(\d*)[ \t]*:?[ \t]*\n', re.IGNORECASE)
+    headers = list(header.finditer(text or ""))[: MAX_SAMPLES * 2]
+    inputs, outputs = {}, {}
+    for i, m in enumerate(headers):
+        end = headers[i + 1].start() if i + 1 < len(headers) else len(text)
+        body = text[m.end():end]
+        # Cut the block at the next section heading (a markdown line starting with '#')
+        body = re.split(r'\n#+\s', '\n' + body, maxsplit=1)[0]
+        idx = m.group(2) or str(len(inputs) + len(outputs) + 1)
+        kind = m.group(1).lower()
+        if kind == 'input':
+            inputs.setdefault(idx, _clean_block(body))
+        else:
+            outputs.setdefault(idx, _clean_block(body))
+    samples = []
+    for idx in list(inputs.keys())[:MAX_SAMPLES]:
+        if idx in outputs:
+            samples.append((idx, inputs[idx], outputs[idx]))
+    return samples
+
+
+def _truncate(text):
+    text = text or ""
+    if len(text) > MAX_CHARS:
+        return text[:MAX_CHARS] + f"\n... <truncated {len(text) - MAX_CHARS} chars>"
+    return text
+
+
+def _normalize(text):
+    return text.split()
+
+
+def tool_function(solution_path, problem_file=None, timeout=10, memory_mb=512):
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        timeout = 10.0
+    try:
+        memory_mb = int(memory_mb)
+    except (TypeError, ValueError):
+        memory_mb = 512
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    if problem_file:
+        if not os.path.isfile(problem_file):
+            return f"Error: problem file not found: {problem_file}"
+        with open(problem_file, 'r', errors='replace') as fh:
+            text = fh.read()
+    else:
+        text = _DEFAULT_PROBLEM_TEXT
+
+    samples = extract_samples(text)
+    if not samples:
+        return "Error: no 'Sample Input N' / 'Sample Output N' blocks found in the statement."
+
+    def limit_memory():
+        limit = memory_mb * 1024 * 1024
+        resource.setrlimit(resource.RLIMIT_AS, (limit, limit))
+
+    lines = []
+    passed = 0
+    for idx, inp, expected in samples:
+        try:
+            proc = subprocess.run(
+                ["python3", solution_path],
+                input=inp + "\n",
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+                preexec_fn=limit_memory,
+            )
+        except subprocess.TimeoutExpired as e:
+            lines.append(f"Sample {idx}: TIMEOUT (exceeded {timeout}s)")
+            lines.append(f"Input:\n{_truncate(inp)}")
+            continue
+        stdout = proc.stdout or ""
+        stderr = proc.stderr or ""
+        if proc.returncode != 0 and "MemoryError" in stderr:
+            status = "MEMORY"
+        elif proc.returncode != 0:
+            status = "FAIL"
+        elif _normalize(stdout) == _normalize(expected):
+            status = "PASS"
+        else:
+            status = "FAIL"
+        if status == "PASS":
+            passed += 1
+            lines.append(f"Sample {idx}: PASS")
+        else:
+            lines.append(f"Sample {idx}: {status} (exit code {proc.returncode})")
+            lines.append(f"Input:\n{_truncate(inp)}")
+            lines.append(f"Actual output:\n{_truncate(stdout)}")
+            lines.append(f"Expected output:\n{_truncate(expected)}")
+            if stderr.strip():
+                lines.append(f"Stderr:\n{_truncate(stderr)}")
+    header = f"Samples passed: {passed}/{len(samples)}"
+    return header + "\n" + "\n".join(lines)
