diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..a33ee20
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,139 @@
+import os
+import subprocess
+import tempfile
+
+MAX_CHARS = 1500
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run a randomized differential stress test between a solution program and a reference (brute-force) program.\n
+* For each seed in 1..iterations, the generator is run as `<generator_cmd> <seed>` and its stdout is the test input.\n
+* The solution and the reference are each run with that input on stdin (commands run in the current shell working directory, so use absolute or relative paths).\n
+* If `checker_cmd` is given it is run as `<checker_cmd> <input_file> <solution_output_file> <reference_output_file>` and must exit with code 0 when the solution output is acceptable. Otherwise the two outputs must match after whitespace normalization.\n
+* The test stops at the first failure and returns the failing input (truncated), both outputs (truncated), and any stderr/exit code/timeout information. Raw outputs are returned; they are not parsed.\n
+* Returns a pass summary if all iterations succeed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution program reading stdin and writing stdout, e.g. 'python3 solution.py'."
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the brute-force reference program reading stdin and writing stdout, e.g. 'python3 brute.py'."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command that prints one random test input to stdout; the seed is appended as the last argument, e.g. 'python3 gen.py'."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional. Shell command that validates the solution output: called as '<checker_cmd> <input_file> <solution_output_file> <reference_output_file>', exit code 0 means accepted."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random seeds to test (default 200)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run (default 10)."
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+
+def _truncate(text):
+    text = text or ""
+    if len(text) > MAX_CHARS:
+        return text[:MAX_CHARS] + f"\n... <truncated {len(text) - MAX_CHARS} chars>"
+    return text
+
+
+def _run(cmd, stdin_text=None, timeout=10, args=None):
+    full = cmd if not args else f"{cmd} {' '.join(args)}"
+    try:
+        proc = subprocess.run(
+            full, shell=True, input=stdin_text, capture_output=True, text=True,
+            timeout=timeout,
+        )
+        return proc, None
+    except subprocess.TimeoutExpired:
+        return None, f"Timeout after {timeout}s running: {full}"
+
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, checker_cmd=None, iterations=200, timeout=10):
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        iterations = 200
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        timeout = 10.0
+    if iterations < 1:
+        return "Error: iterations must be >= 1"
+
+    with tempfile.TemporaryDirectory() as tmp:
+        in_path = os.path.join(tmp, "input.txt")
+        sol_path = os.path.join(tmp, "sol_out.txt")
+        ref_path = os.path.join(tmp, "ref_out.txt")
+
+        for seed in range(1, iterations + 1):
+            gen, err = _run(generator_cmd, timeout=timeout, args=[str(seed)])
+            if err:
+                return f"Generator failed at seed {seed}: {err}"
+            if gen.returncode != 0:
+                return (f"Generator failed at seed {seed} (exit code {gen.returncode}).\n"
+                        f"stderr:\n{_truncate(gen.stderr)}")
+            test_input = gen.stdout
+
+            def fail(reason, sol_out=None, ref_out=None, sol_err=None):
+                parts = [f"FAILED at seed {seed} of {iterations}: {reason}",
+                         f"Input:\n{_truncate(test_input)}"]
+                if sol_out is not None:
+                    parts.append(f"Solution output:\n{_truncate(sol_out)}")
+                if ref_out is not None:
+                    parts.append(f"Reference output:\n{_truncate(ref_out)}")
+                if sol_err:
+                    parts.append(f"Solution stderr:\n{_truncate(sol_err)}")
+                return "\n\n".join(parts)
+
+            sol, err = _run(solution_cmd, stdin_text=test_input, timeout=timeout)
+            if err:
+                return fail(err)
+            if sol.returncode != 0:
+                return fail(f"Solution exited with code {sol.returncode}", sol.stdout, None, sol.stderr)
+
+            ref, err = _run(reference_cmd, stdin_text=test_input, timeout=timeout)
+            if err:
+                return f"Reference failed at seed {seed}: {err}\n\nInput:\n{_truncate(test_input)}"
+            if ref.returncode != 0:
+                return (f"Reference exited with code {ref.returncode} at seed {seed}.\n"
+                        f"Input:\n{_truncate(test_input)}\nstderr:\n{_truncate(ref.stderr)}")
+
+            if checker_cmd:
+                with open(in_path, "w") as fh:
+                    fh.write(test_input)
+                with open(sol_path, "w") as fh:
+                    fh.write(sol.stdout)
+                with open(ref_path, "w") as fh:
+                    fh.write(ref.stdout)
+                chk, err = _run(checker_cmd, timeout=timeout, args=[in_path, sol_path, ref_path])
+                if err:
+                    return fail(f"Checker timed out: {err}", sol.stdout, ref.stdout)
+                if chk.returncode != 0:
+                    reason = "Checker rejected solution output"
+                    detail = (chk.stdout + chk.stderr).strip()
+                    if detail:
+                        reason += f" (checker output: {_truncate(detail)})"
+                    return fail(reason, sol.stdout, ref.stdout)
+            else:
+                if sol.stdout.split() != ref.stdout.split():
+                    return fail("Outputs differ", sol.stdout, ref.stdout)
+
+        return f"PASSED: {iterations} random iterations, solution matched reference (checker: {'yes' if checker_cmd else 'no'})."
