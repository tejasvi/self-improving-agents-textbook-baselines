+def _message_text(msg):
+    """Extract plain text from a message-history entry (string or list of content blocks)."""
+    content = msg.get('content', '') if isinstance(msg, dict) else ''
+    if isinstance(content, str):
+        return content
+    parts = []
+    for block in content or []:
+        if isinstance(block, dict) and block.get('type') == 'text':
+            parts.append(block.get('text', ''))
+        elif isinstance(block, str):
+            parts.append(block)
+    return '\n'.join(parts)
+
+
+def _last_assistant_text(msg_history):
+    for msg in reversed(msg_history or []):
+        if isinstance(msg, dict) and msg.get('role') == 'assistant':
+            return _message_text(msg)
+    return ''
+
+
+def _signals_too_slow(text):
+    lowered = (text or '').lower()
+    return any(phrase in lowered for phrase in TOO_SLOW_PHRASES)
