diff --git a/tools/perf_test.py b/tools/perf_test.py
new file mode 100644
index 0000000..775bc81
--- /dev/null
+++ b/tools/perf_test.py
@@ -0,0 +1,108 @@
+import subprocess
+import time
+
+
+def tool_info():
+    return {
+        "name": "perf_test",
+        "description": """Performance tester: measures the wall time of a solution on generated large inputs and gives an OK/TIMEOUT verdict per case.
+
+* For each entry in gen_args, runs `<gen_cmd> <arg>` (e.g. arg 'max_random', 'max_alternating', 'all_missing', or a seed number) and captures its stdout as the test input.
+* Pipes that input to solution_cmd with a hard timeout (in seconds) and measures the wall time.
+* Returns, for every case, the wall time and a verdict: OK (finished in time with exit code 0), TIMEOUT (exceeded the timeout), or ERROR (non-zero exit code, with a short stderr tail).
+* Use it on max-size adversarial inputs after correctness tests pass. A TIMEOUT on max-size input means the algorithm must be redesigned, not that the timeout should be raised.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution under test, e.g. 'python3 /path/solution.py'. Reads input from stdin."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command that generates a large test input. It is called as '<gen_cmd> <arg>' for each arg in gen_args and prints the input to stdout, e.g. 'python3 /path/gen_big.py'."
+                },
+                "gen_args": {
+                    "type": "array",
+                    "items": {
+                        "type": "string"
+                    },
+                    "description": "List of arguments to pass to gen_cmd, one test case per argument, e.g. ['max_random', 'max_alternating', 'all_missing'] or seed numbers like ['1', '2']."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Hard wall-time limit in seconds for each solution run (default 10). Use the problem's real time limit when known."
+                }
+            },
+            "required": ["solution_cmd", "gen_cmd", "gen_args"]
+        }
+    }
+
+
+_ERR_TAIL_CHARS = 500
+
+
+def _tail(text):
+    text = (text or "").strip()
+    return text[-_ERR_TAIL_CHARS:] if len(text) > _ERR_TAIL_CHARS else text
+
+
+def tool_function(solution_cmd, gen_cmd, gen_args, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Error: timeout must be a number, got {timeout!r}"
+    if timeout <= 0:
+        return "Error: timeout must be positive."
+
+    if isinstance(gen_args, str):
+        gen_args = [gen_args]
+    if not gen_args:
+        return "Error: gen_args must contain at least one argument."
+    gen_args = [str(a) for a in gen_args]
+
+    lines = [f"Performance test: solution='{solution_cmd}', timeout={timeout}s"]
+    any_fail = False
+    for arg in gen_args:
+        # Generate the input.
+        try:
+            gen = subprocess.run(
+                f"{gen_cmd} {arg}", shell=True, capture_output=True, text=True,
+                timeout=max(timeout, 60.0),
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f"[{arg}] GEN_TIMEOUT: generator did not finish")
+            any_fail = True
+            continue
+        if gen.returncode != 0:
+            lines.append(f"[{arg}] GEN_ERROR: exit code {gen.returncode}; stderr: {_tail(gen.stderr)}")
+            any_fail = True
+            continue
+        input_text = gen.stdout
+        size_kb = len(input_text.encode(errors="replace")) / 1024.0
+
+        # Run the solution with a hard timeout and measure wall time.
+        start = time.perf_counter()
+        try:
+            proc = subprocess.run(
+                solution_cmd, shell=True, input=input_text, capture_output=True,
+                text=True, timeout=timeout,
+            )
+            elapsed = time.perf_counter() - start
+        except subprocess.TimeoutExpired:
+            elapsed = time.perf_counter() - start
+            lines.append(f"[{arg}] TIMEOUT: >{timeout}s (input {size_kb:.1f} KB)")
+            any_fail = True
+            continue
+
+        if proc.returncode != 0:
+            lines.append(
+                f"[{arg}] ERROR: exit code {proc.returncode} after {elapsed:.3f}s "
+                f"(input {size_kb:.1f} KB); stderr: {_tail(proc.stderr)}"
+            )
+            any_fail = True
+        else:
+            lines.append(f"[{arg}] OK: {elapsed:.3f}s (input {size_kb:.1f} KB)")
+
+    lines.append("RESULT: ALL OK" if not any_fail else "RESULT: FAILURES PRESENT (fix before finishing)")
+    return "\n".join(lines)
