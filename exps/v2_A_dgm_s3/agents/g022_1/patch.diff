diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..726c20f
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,144 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress tester that compares a solution against a reference (brute-force) program.
+
+* gen_cmd is run once per iteration as `<gen_cmd> <seed>` (seed = 1..iterations) and must print a test input to stdout.
+* The same input is piped to solution_cmd and to brute_cmd, each with a timeout.
+* If exact_match is true, stdout of both programs must be identical (after stripping trailing whitespace per line and trailing blank lines).
+* If exact_match is false and checker_cmd is given, it is run as `<checker_cmd> <input_file> <expected_file> <actual_file>`; exit code 0 means the answer is accepted.
+* Stops at the first failing input and returns the input, both outputs and stderr; otherwise returns a pass summary.
+* Use this instead of writing ad-hoc heredoc comparison scripts. Commands are run through the shell, so give paths relative to the working directory or absolute paths.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution under test, e.g. 'python3 /path/solution.py'. Reads input from stdin."
+                },
+                "brute_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the obviously-correct brute-force reference, e.g. 'python3 /path/brute.py'. Reads input from stdin."
+                },
+                "gen_cmd": {
+                    "type": "string",
+                    "description": "Shell command that generates a random test input. It is called as '<gen_cmd> <seed>' and prints the input to stdout, e.g. 'python3 /path/gen.py'."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random test cases to run (seeds 1..iterations)."
+                },
+                "exact_match": {
+                    "type": "boolean",
+                    "description": "If true (default), outputs must be textually identical. If false, use checker_cmd to validate the answer."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command used when exact_match is false: '<checker_cmd> <input_file> <expected_file> <actual_file>' must exit 0 if the actual output is acceptable."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for the generator, solution and brute force (default 10)."
+                }
+            },
+            "required": ["solution_cmd", "brute_cmd", "gen_cmd", "iterations"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+
+def _run(cmd, stdin_text=None, timeout=10.0):
+    """Run a shell command. Returns (returncode, stdout, stderr, timed_out)."""
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True,
+            text=True, timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return None, out, err, True
+
+
+def tool_function(solution_cmd, brute_cmd, gen_cmd, iterations, exact_match=True, checker_cmd=None, timeout=10):
+    import os
+    import tempfile
+
+    try:
+        iterations = int(iterations)
+    except (TypeError, ValueError):
+        return f"Error: iterations must be an integer, got {iterations!r}"
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Error: timeout must be a number, got {timeout!r}"
+    if isinstance(exact_match, str):
+        exact_match = exact_match.strip().lower() not in ("false", "0", "no", "")
+    if exact_match is None:
+        exact_match = True
+    if not exact_match and not checker_cmd:
+        return "Error: exact_match is false but no checker_cmd was given."
+    if iterations <= 0:
+        return "Error: iterations must be positive."
+
+    tmpdir = tempfile.mkdtemp(prefix="stress_")
+    in_path = os.path.join(tmpdir, "input.txt")
+    exp_path = os.path.join(tmpdir, "expected.txt")
+    act_path = os.path.join(tmpdir, "actual.txt")
+
+    for seed in range(1, iterations + 1):
+        rc, gen_out, gen_err, timed_out = _run(f"{gen_cmd} {seed}", timeout=timeout)
+        if timed_out:
+            return f"Generator timed out on seed {seed} (timeout {timeout}s).\nstderr:\n{gen_err}"
+        if rc != 0:
+            return f"Generator failed on seed {seed} with exit code {rc}.\nstderr:\n{gen_err}"
+        test_input = gen_out
+
+        brute_rc, brute_out, brute_err, brute_to = _run(brute_cmd, test_input, timeout=timeout)
+        sol_rc, sol_out, sol_err, sol_to = _run(solution_cmd, test_input, timeout=timeout)
+
+        def report(reason, detail=""):
+            return (
+                f"FAILED on seed {seed}: {reason}\n"
+                f"--- input ---\n{test_input}\n"
+                f"--- brute output ---\n{brute_out}\n"
+                f"--- brute stderr ---\n{brute_err}\n"
+                f"--- solution output ---\n{sol_out}\n"
+                f"--- solution stderr ---\n{sol_err}\n"
+                f"{detail}"
+            )
+
+        if brute_to:
+            return report(f"brute force timed out (timeout {timeout}s); generator may be producing too-large input")
+        if brute_rc != 0:
+            return report(f"brute force exited with code {brute_rc}")
+        if sol_to:
+            return report(f"solution timed out (timeout {timeout}s)")
+        if sol_rc != 0:
+            return report(f"solution exited with code {sol_rc}")
+
+        if exact_match:
+            if _normalize(sol_out) != _normalize(brute_out):
+                return report("output differs from brute force (exact match)")
+        else:
+            with open(in_path, "w") as f:
+                f.write(test_input)
+            with open(exp_path, "w") as f:
+                f.write(brute_out)
+            with open(act_path, "w") as f:
+                f.write(sol_out)
+            chk_rc, chk_out, chk_err, chk_to = _run(f"{checker_cmd} {in_path} {exp_path} {act_path}", timeout=timeout)
+            if chk_to or chk_rc != 0:
+                return report("checker rejected the solution output",
+                              f"--- checker output ---\n{chk_out}\n--- checker stderr ---\n{chk_err}\n")
+
+    mode = "exact match" if exact_match else "checker"
+    return f"All {iterations} random tests passed ({mode} against brute force)."
