+class CandidateTracker:
+    """
+    Harvests candidate solutions written by the agent (the target file and *.py files in the
+    scratch dirs), scores each one, and restores the best one into the target file.
+    Ranking tuple (higher is better): (all samples pass, differential test passes, non-stub, -runtime).
+    Candidates are copied into an internal store and deduplicated by content hash.
+    """
+    def __init__(self, system, store_dir=None):
+        self.system = system
+        self.store_dir = store_dir or tempfile.mkdtemp(prefix='candidates_')
+        os.makedirs(self.store_dir, exist_ok=True)
+        self.candidates = []   # dicts: path (original), stored (copy), hash, mtime, score, details
+        self._seen_hashes = set()
+
+    def _target_path(self):
+        return os.path.join(self.system.git_tempdir, self.system._target_file())
+
+    def _scratch_files(self):
+        files = []
+        for d in SCRATCH_DIRS:
+            if not os.path.isdir(d):
+                continue
+            for root, dirs, names in os.walk(d):
+                dirs[:] = [x for x in dirs if x != '__pycache__'][:50]
+                for n in names[:200]:
+                    if n.endswith('.py'):
+                        files.append(os.path.join(root, n))
+        return files
+
+    def snapshot_candidates(self):
+        """Copy the target file and scratch *.py files into the store; skip content already seen."""
+        paths = [self._target_path()] + self._scratch_files()
+        added = []
+        for path in paths:
+            if not os.path.isfile(path):
+                continue
+            try:
+                with open(path, 'rb') as fh:
+                    data = fh.read()
+            except OSError:
+                continue
+            digest = hashlib.sha256(data).hexdigest()
+            if digest in self._seen_hashes:
+                continue
+            self._seen_hashes.add(digest)
+            stored = os.path.join(self.store_dir, f"cand_{len(self.candidates)}.py")
+            with open(stored, 'wb') as fh:
+                fh.write(data)
+            cand = {'path': path, 'stored': stored, 'hash': digest,
+                    'mtime': os.path.getmtime(path), 'score': None, 'details': {}}
+            self.candidates.append(cand)
+            added.append(cand)
+        return added
+
+    def _run_diff_test(self, stored):
+        """Differential test against /tmp/work/brute.py and gen.py, reusing the stress_test tool logic."""
+        brute, gen = os.path.join(SCRATCH_DIRS[0], 'brute.py'), os.path.join(SCRATCH_DIRS[0], 'gen.py')
+        if not (os.path.isfile(brute) and os.path.isfile(gen)):
+            return None, 'no brute.py/gen.py'
+        from tools.stress_test import tool_function as stress
+        out = stress(f"{sys.executable} {stored}", f"{sys.executable} {brute}",
+                     f"{sys.executable} {gen}", DIFF_TEST_CASES, timeout=DIFF_TIMEOUT_SECONDS)
+        return out.startswith('ALL TESTS PASSED'), out[:1000]
+
+    def _run_timing(self, stored):
+        """Runtime on the max-size input, if /tmp/work/max_input.txt exists. None if absent or failed."""
+        max_input = os.path.join(SCRATCH_DIRS[0], 'max_input.txt')
+        if not os.path.isfile(max_input):
+            return None
+        with open(max_input, 'r') as fh:
+            data = fh.read()
+        start = time.time()
+        try:
+            proc = subprocess.run([sys.executable, stored], input=data, capture_output=True, text=True,
+                                  timeout=MAX_INPUT_TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired:
+            return None
+        if proc.returncode != 0:
+            return None
+        return time.time() - start
+
+    def score_candidate(self, cand):
+        """Score one candidate; returns the tuple (samples_ok, diff_ok, nonstub, -runtime)."""
+        with open(cand['stored'], 'r', errors='replace') as fh:
+            text = fh.read()
+        results = self.system._run_samples(cand['stored'])
+        samples_ok = bool(results) and all(r['ok'] for r in results)
+        diff_ok, diff_msg = self._run_diff_test(cand['stored']) if samples_ok else (False, 'skipped: samples fail')
+        runtime = self._run_timing(cand['stored']) if samples_ok else None
+        runtime = NOT_RUN_RUNTIME if runtime is None else runtime
+        nonstub = not _source_is_stub(text)
+        score = (int(samples_ok), int(bool(diff_ok)), int(nonstub), -runtime)
+        cand['score'] = score
+        cand['details'] = {
+            'failing': [f"sample {r['index']}: {r['reason']}" for r in results if not r['ok']],
+            'diff': diff_msg, 'runtime': runtime,
+        }
+        return score
+
+    def score_all(self):
+        for cand in self.candidates:
+            if cand['score'] is None:
+                self.score_candidate(cand)
+
+    def best(self):
+        scored = [c for c in self.candidates if c['score'] is not None]
+        return max(scored, key=lambda c: c['score']) if scored else None
+
+    def restore_best(self):
+        """Write the best candidate into the target file if it beats the current target."""
+        best = self.best()
+        if best is None:
+            return False
+        target = self._target_path()
+        current = next((c for c in self.candidates if c['path'] == target and c['score'] is not None), None)
+        if current is not None and best['score'] <= current['score']:
+            return False
+        if best['path'] == target:
+            return False
+        with open(best['stored'], 'rb') as src, open(target, 'wb') as dst:
+            dst.write(src.read())
+        safe_log(f"Restored best candidate {best['path']} (score {best['score']}) into {target}.")
+        return True
