+def _source_is_stub(text):
+    """True if the source has no real logic: unparseable/empty, or every function body is pass/NotImplementedError."""
+    if not text or not text.strip():
+        return True
+    try:
+        tree = ast.parse(text)
+    except SyntaxError:
+        return True
+    funcs = [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]
+    if not funcs:
+        return False
+    def stub(fn):
+        body = [s for s in fn.body if not (isinstance(s, ast.Expr) and isinstance(getattr(s, 'value', None), ast.Constant)
+                                           and isinstance(s.value.value, str))]
+        if not body:
+            return True
+        return len(body) == 1 and (isinstance(body[0], ast.Pass) or (
+            isinstance(body[0], ast.Raise) and body[0].exc is not None and
+            (getattr(body[0].exc, 'func', body[0].exc).id == 'NotImplementedError'
+             if isinstance(getattr(body[0].exc, 'func', body[0].exc), ast.Name) else False)))
+    return all(stub(f) for f in funcs)
