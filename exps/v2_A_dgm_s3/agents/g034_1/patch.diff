diff --git a/tools/scale_check.py b/tools/scale_check.py
new file mode 100644
index 0000000..944dd3d
--- /dev/null
+++ b/tools/scale_check.py
@@ -0,0 +1,181 @@
+import math
+import os
+import signal
+import subprocess
+import time
+
+
+def _run_killable(cmd, data, timeout):
+    """Run a shell command in its own process group; kill the whole group on timeout."""
+    proc = subprocess.Popen(cmd, shell=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                            stderr=subprocess.PIPE, start_new_session=True)
+    try:
+        out, err = proc.communicate(data, timeout=timeout)
+        return proc.returncode, out, err
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        proc.communicate()
+        raise
+
+
+MAX_OUTPUT_CHARS = 1000
+DEFAULT_LOWER = 256
+DEFAULT_UPPER_CAP = 16384
+
+
+def tool_info():
+    return {
+        "name": "scale_check",
+        "description": """Empirically check how a solution scales with input size n, and extrapolate its running time to the maximum constraint.
+* Provide `generator_cmd` as a size-parameterised generator: it is run as `<generator_cmd> <n>` and must print a worst-case-like input of size n to stdout.
+* The solution is run on increasing sizes (default: geometric from 256 up to min(max_n, 16384)), each with a hard time limit.
+* Reports the raw timings per size, the log-log growth exponent between the last two completed sizes, and the extrapolated time at max_n.
+* Verdicts: 'SCALES OK', 'EXTRAPOLATED TOO SLOW', or 'TIMEOUT' (also 'RUNTIME ERROR' / 'GENERATOR FAILED' with raw output).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution. It reads the input on stdin and writes the answer to stdout."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Shell command run as `<generator_cmd> <n>`; it prints an input of size n to stdout."
+                },
+                "max_n": {
+                    "type": "integer",
+                    "description": "The maximum input size n from the problem constraints; the time is extrapolated to this size."
+                },
+                "sizes": {
+                    "type": "array",
+                    "items": {
+                        "type": "integer",
+                        "description": "An input size n to test."
+                    },
+                    "description": "Optional. Explicit list of sizes to run, in increasing order. Defaults to a geometric sequence from 256 up to min(max_n, 16384)."
+                },
+                "time_limit_seconds": {
+                    "type": "number",
+                    "description": "Optional. Time limit in seconds for each single run. Defaults to 2."
+                }
+            },
+            "required": ["solution_cmd", "generator_cmd", "max_n"]
+        }
+    }
+
+
+LAST_VERDICT_PATH = '/tmp/stress/last_scale.txt'
+
+
+def _record_verdict(verdict):
+    """Persist the last scale verdict so the calling harness can read it."""
+    try:
+        os.makedirs(os.path.dirname(LAST_VERDICT_PATH), exist_ok=True)
+        with open(LAST_VERDICT_PATH, 'w') as fh:
+            fh.write(verdict)
+    except OSError:
+        pass
+
+
+def _truncate(text, limit=MAX_OUTPUT_CHARS):
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... (truncated, {len(text) - limit} more characters)"
+
+
+def _default_sizes(max_n):
+    upper = min(max_n, DEFAULT_UPPER_CAP)
+    sizes = []
+    n = min(DEFAULT_LOWER, upper)
+    while n < upper:
+        sizes.append(n)
+        n *= 4
+    sizes.append(upper)
+    return sorted(set(sizes))
+
+
+def tool_function(solution_cmd, generator_cmd, max_n, sizes=None, time_limit_seconds=2):
+    try:
+        max_n = int(max_n)
+    except (TypeError, ValueError):
+        return f"Error: max_n must be an integer, got {max_n!r}"
+    if max_n <= 0:
+        return "Error: max_n must be positive."
+    try:
+        limit = float(time_limit_seconds) if time_limit_seconds is not None else 2.0
+    except (TypeError, ValueError):
+        limit = 2.0
+
+    if sizes:
+        try:
+            sizes = sorted({int(s) for s in sizes if int(s) > 0})
+        except (TypeError, ValueError):
+            return "Error: sizes must be a list of positive integers."
+    else:
+        sizes = _default_sizes(max_n)
+    if not sizes:
+        return "Error: no sizes to test."
+
+    lines = []
+    completed = []  # (n, elapsed)
+    verdict = 'SCALES OK'
+    for n in sizes:
+        try:
+            gcode, gout, gerr = _run_killable(f"{generator_cmd} {n}", None, max(limit * 5, 60))
+        except subprocess.TimeoutExpired:
+            return f"Verdict: GENERATOR TIMEOUT at n={n}.\nCommand: {generator_cmd} {n}"
+        if gcode != 0:
+            return (f"Verdict: GENERATOR FAILED at n={n} (exit {gcode}).\n"
+                    f"stderr: {_truncate(gerr.decode(errors='replace'))}")
+        start = time.monotonic()
+        try:
+            code, out, err = _run_killable(solution_cmd, gout, limit)
+        except subprocess.TimeoutExpired:
+            verdict = 'TIMEOUT'
+            lines.append(f"n={n}: killed after {time.monotonic() - start:.2f}s (limit {limit:g}s)")
+            break
+        elapsed = time.monotonic() - start
+        lines.append(f"n={n}: {elapsed:.3f}s, exit code {code}")
+        if code != 0:
+            verdict = 'RUNTIME ERROR'
+            lines.append(f"stderr: {_truncate(err.decode(errors='replace'))}")
+            break
+        completed.append((n, max(elapsed, 1e-4)))
+
+    report = []
+    _record_verdict(verdict)
+    exponent = None
+    extrapolated = None
+    if verdict == 'SCALES OK' and len(completed) >= 2:
+        (n1, t1), (n2, t2) = completed[-2], completed[-1]
+        if n2 > n1 and t2 > 0:
+            exponent = math.log(t2 / t1) / math.log(n2 / n1)
+            exponent = max(exponent, 0.0)
+            extrapolated = t2 * (max_n / n2) ** exponent
+            if extrapolated > limit:
+                verdict = 'EXTRAPOLATED TOO SLOW'
+    elif verdict == 'SCALES OK' and len(completed) == 1:
+        n1, t1 = completed[0]
+        extrapolated = t1 * (max_n / n1)  # linear fallback when only one size completed
+        if extrapolated > limit:
+            verdict = 'EXTRAPOLATED TOO SLOW'
+
+    if verdict == 'TIMEOUT':
+        report.append(f"Verdict: TIMEOUT at n={sizes[len(completed)]}")
+    elif verdict == 'RUNTIME ERROR':
+        report.append(f"Verdict: RUNTIME ERROR")
+    else:
+        report.append(f"Verdict: {verdict}")
+    report.append(f"Time limit per run: {limit:g}s; max_n: {max_n}")
+    report.append("Timings:")
+    report.extend(lines)
+    if exponent is not None:
+        report.append(f"Estimated growth exponent (log-log, last two sizes): {exponent:.2f}")
+    if extrapolated is not None:
+        report.append(f"Extrapolated time at max_n={max_n}: ~{extrapolated:.2f}s")
+    text = "\n".join(report)
+    _record_verdict(verdict)
+    return text
