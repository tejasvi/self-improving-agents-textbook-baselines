+def _message_text(msg):
+    """Return the concatenated text of a message's content (str or list of blocks)."""
+    content = msg.get('content') if isinstance(msg, dict) else None
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return ''
+    parts = []
+    for block in content:
+        if isinstance(block, dict):
+            if block.get('type') == 'text' and isinstance(block.get('text'), str):
+                parts.append(block['text'])
+        elif getattr(block, 'type', None) == 'text' and isinstance(getattr(block, 'text', None), str):
+            parts.append(block.text)
+    return '\n'.join(parts)
+
+def _has_tool_use(msg):
+    content = msg.get('content') if isinstance(msg, dict) else None
+    if not isinstance(content, list):
+        return False
+    for block in content:
+        btype = block.get('type') if isinstance(block, dict) else getattr(block, 'type', None)
+        if btype == 'tool_use':
+            return True
+    return False
+
+def _clean_history(msg_history):
+    """
+    Return a sanitized copy of msg_history. Returns [] if it is not a list.
+    Drops assistant messages with no non-empty text and no tool_use blocks,
+    which would otherwise make the next API call invalid or repeat the empty turn.
+    """
+    if not isinstance(msg_history, list):
+        return []
+    cleaned = []
+    for m in msg_history:
+        if isinstance(m, dict) and m.get('role') == 'assistant':
+            if not _message_text(m).strip() and not _has_tool_use(m):
+                continue
+        cleaned.append(m)
+    return cleaned
+
+def _infer_target_file(problem_statement):
+    """Find a backticked source filename in the problem statement; default to solution.py."""
+    match = re.search(r'`([\w./-]+\.(?:py|js|rs|go|cpp|java))`', problem_statement or '')
+    return match.group(1) if match else 'solution.py'
