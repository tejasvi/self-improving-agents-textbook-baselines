+    def _skeleton_fallback(self, existing):
+        """
+        Given the existing file text, return a version where bare `pass` bodies are replaced by
+        `return 0` (or `return None`), with `from typing import List` ensured. Returns None if the
+        text has no class/function skeleton or cannot be parsed.
+        """
+        if not existing or not existing.strip():
+            return None
+        try:
+            tree = ast.parse(existing)
+        except SyntaxError:
+            return None
+        has_skeleton = any(isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
+                           for n in ast.walk(tree))
+        if not has_skeleton:
+            return None
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                new_body = []
+                for stmt in node.body:
+                    if isinstance(stmt, ast.Pass):
+                        returns_none = node.returns is None or (
+                            isinstance(node.returns, ast.Constant) and node.returns.value is None)
+                        value = ast.Constant(value=None) if returns_none else ast.Constant(value=0)
+                        new_body.append(ast.copy_location(ast.Return(value=value), stmt))
+                    else:
+                        new_body.append(stmt)
+                node.body = new_body
+        # Ensure `from typing import List` is present when List is used.
+        has_list_import = any(
+            isinstance(n, ast.ImportFrom) and n.module == 'typing' and any(a.name == 'List' for a in n.names)
+            for n in tree.body
+        )
+        if not has_list_import:
+            uses_list = any(isinstance(n, ast.Name) and n.id == 'List' for n in ast.walk(tree))
+            if uses_list:
+                tree.body.insert(0, ast.ImportFrom(module='typing', names=[ast.alias(name='List', asname=None)], level=0))
+        ast.fix_missing_locations(tree)
+        try:
+            code = ast.unparse(tree)
+        except Exception:
+            return None
+        return code + '\n'
+
 
