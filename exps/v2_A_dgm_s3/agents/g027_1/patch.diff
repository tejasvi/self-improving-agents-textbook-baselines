+def _ran_solution(msg_history, target):
+    """
+    True if msg_history contains a bash tool invocation that runs the target file with python.
+    Handles real tool_use blocks (dicts with 'name'/'input') and the logged text form
+    `<tool_use>{'tool_name': bash, 'tool_input': {...}}</tool_use>`.
+    """
+    if not isinstance(msg_history, list) or not target:
+        return False
+    base = os.path.basename(target)
+    targets = {target, base}
+
+    def command_runs_target(command):
+        if not isinstance(command, str):
+            return False
+        if 'python' not in command:
+            return False
+        return any(re.search(r'(?<![\w./-])' + re.escape(t) + r'(?![\w.-])', command) for t in targets)
+
+    for m in msg_history:
+        if not isinstance(m, dict):
+            continue
+        content = m.get('content')
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict):
+                    btype, bname, binput = block.get('type'), block.get('name'), block.get('input')
+                else:
+                    btype = getattr(block, 'type', None)
+                    bname = getattr(block, 'name', None)
+                    binput = getattr(block, 'input', None)
+                if btype == 'tool_use' and bname == 'bash' and isinstance(binput, dict):
+                    if command_runs_target(binput.get('command')):
+                        return True
+        text = _message_text(m)
+        for seg in re.findall(r'<tool_use>(.*?)</tool_use>', text, re.DOTALL):
+            if not re.search(r"tool_name['\"]?\s*:\s*['\"]?bash", seg):
+                continue
+            if command_runs_target(seg):
+                return True
+    return False
+
