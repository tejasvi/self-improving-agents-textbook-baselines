+import json
+import os
+import random
+import re
+import subprocess
+import tempfile
+
+
+def tool_info():
+    return {
+        "name": "analyze_oracle",
+        "description": """Discover and test invariants of a small exact oracle (a function of integer parameters), so a huge-constraint problem can be reduced to a fast formula or algorithm. Two modes:
+
+mode="check" (default): randomly samples points inside the given parameter ranges and tests the requested properties, reporting pass/fail counts and concrete counterexamples. Supported checks (semicolon-separated list in `checks`):
+  * "translation:<vec>"  : f(p + d) == f(p) where d is a vector like "2/0" (one entry per parameter, in the order of `params`, separated by '/'). Points are shifted only when the shifted point stays in range.
+  * "scale"              : f(c*p) == f(p) for all coordinates scaled by c = 2 (when inside range).
+  * "symmetry:<perm>"    : f(p permuted) == f(p), where perm is a '/'-separated permutation of parameter indices, e.g. "symmetry:1/0".
+  * "eventually_affine:<param>" : along the named parameter (others fixed) f becomes affine with a constant slope per residue class modulo a period; reports the transient length, period, and slope/intercept per residue class, and checks the fit.
+  * "periodic:<param>:<period>" : f(p with param+period) == f(p) for samples.
+
+mode="fit_affine": takes `base` (a point, comma-separated integers, one per parameter), `direction` (index of the parameter to step along), `steps` (how many steps to evaluate), and `classes` (modulus of residue classes, e.g. 2). It evaluates f along the direction, finds the transient length (where the sequence starts to follow the periodic-affine pattern), the period, and the slope and intercept per residue class, and returns them as a table.
+
+oracle_cmd: either a shell command that reads a JSON object {"name": value, ...} on stdin (parameter names from `params`) and prints one integer on stdout, or a path to a python file (ending in .py) that defines f(params) where params is a dict and returns an integer. Each oracle call has a per-call timeout and results are cached.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "mode": {
+                    "type": "string",
+                    "description": "Either 'check' (test properties on random samples) or 'fit_affine' (fit eventual affine pieces along one direction). Default 'check'."
+                },
+                "oracle_cmd": {
+                    "type": "string",
+                    "description": "Shell command reading a JSON object of parameters on stdin and printing an integer, OR a path to a .py file defining f(params) returning an integer."
+                },
+                "params": {
+                    "type": "string",
+                    "description": "Comma-separated parameter ranges, each written as name:min:max, e.g. 'x:0:20,y:0:20,k:1:6'. Names are used as JSON keys for the oracle."
+                },
+                "checks": {
+                    "type": "string",
+                    "description": "Semicolon-separated list of checks for mode='check', e.g. 'translation:2/0;scale;symmetry:1/0;eventually_affine:x;periodic:y:2'. Vector entries are separated by '/' (one per parameter, in params order)."
+                },
+                "samples": {
+                    "type": "integer",
+                    "description": "Number of random samples per check (default 200)."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Random seed for sampling (default 1)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per oracle-call timeout in seconds (default 5). Keep it small."
+                },
+                "base": {
+                    "type": "string",
+                    "description": "For mode='fit_affine': base point as comma-separated integers, one per parameter in `params` order, e.g. '0,3,2'."
+                },
+                "direction": {
+                    "type": "string",
+                    "description": "For mode='fit_affine': name of the parameter to step along."
+                },
+                "steps": {
+                    "type": "integer",
+                    "description": "For mode='fit_affine': number of steps along the direction to evaluate (default 60)."
+                },
+                "classes": {
+                    "type": "integer",
+                    "description": "For mode='fit_affine': residue modulus for per-class affine fitting (default 2)."
+                }
+            },
+            "required": ["oracle_cmd", "params"]
+        }
+    }
+
+
+# ----------------------------------------------------------------------
+# Oracle access: subprocess (JSON on stdin) or python file defining f(params)
+# ----------------------------------------------------------------------
+
+def _is_py_like(cmd):
+    """True when the oracle is given as a bare path to a .py file (not a shell command)."""
+    text = (cmd or '').strip()
+    return text.endswith('.py') and ' ' not in text
+
+
+def _is_py_path(cmd):
+    return _is_py_like(cmd) and os.path.isfile(cmd.strip())
+
+
+class _Oracle:
+    def __init__(self, oracle_cmd, names, timeout):
+        self.cmd = oracle_cmd.strip()
+        self.names = names
+        self.timeout = timeout
+        self.cache = {}
+        self.calls = 0
+        self.fn = None
+        if _is_py_path(self.cmd):
+            path = os.path.abspath(self.cmd.strip())
+            with open(path) as fh:
+                src = fh.read()
+            if re.search(r'^def f\(', src, re.MULTILINE):
+                # Python module defining f(params): call it in-process.
+                ns = {}
+                exec(compile(src, path, 'exec'), ns)
+                self.fn = ns['f']
+            else:
+                # Otherwise treat as a script reading JSON on stdin.
+                self.cmd = f"python3 {path}"
+
+    def __call__(self, point):
+        key = tuple(point)
+        if key in self.cache:
+            return self.cache[key]
+        self.calls += 1
+        params = dict(zip(self.names, point))
+        if self.fn is not None:
+            try:
+                val = int(self.fn(dict(params)))
+            except Exception as e:
+                raise RuntimeError(f"oracle raised at {params}: {e}")
+        else:
+            try:
+                proc = subprocess.run(
+                    self.cmd, shell=True, input=json.dumps(params), capture_output=True,
+                    text=True, timeout=self.timeout,
+                )
+            except subprocess.TimeoutExpired:
+                raise RuntimeError(f"oracle timed out at {params} (timeout {self.timeout}s)")
+            if proc.returncode != 0:
+                raise RuntimeError(f"oracle exited {proc.returncode} at {params}: {proc.stderr.strip()[-300:]}")
+            m = re.search(r'-?\d+', proc.stdout or '')
+            if not m:
+                raise RuntimeError(f"oracle printed no integer at {params}: {proc.stdout.strip()[:200]!r}")
+            val = int(m.group(0))
+        self.cache[key] = val
+        return val
+
+
+def _parse_params(text):
+    names, ranges = [], []
+    for item in (text or '').split(','):
+        item = item.strip()
+        if not item:
+            continue
+        parts = item.split(':')
+        if len(parts) != 3:
+            raise ValueError(f"bad param spec {item!r}; expected name:min:max")
+        names.append(parts[0].strip())
+        ranges.append((int(parts[1]), int(parts[2])))
+    if not names:
+        raise ValueError("no parameters given")
+    return names, ranges
+
+
+def _in_range(point, ranges):
+    return all(lo <= v <= hi for v, (lo, hi) in zip(point, ranges))
+
+
+def _parse_vec(text, dim):
+    vals = [int(x) for x in text.split('/') if x.strip() != '']
+    if len(vals) != dim:
+        raise ValueError(f"vector {text!r} must have {dim} entries separated by '/'")
+    return vals
+
+
+# ----------------------------------------------------------------------
+# Mode: check
+# ----------------------------------------------------------------------
+
+def _check_properties(oracle, names, ranges, checks, samples, rng):
+    dim = len(names)
+    lines = []
+    failures_total = 0
+    for chk in [c.strip() for c in checks.split(';') if c.strip()]:
+        ok = 0
+        bad = []
+        tried = 0
+        try:
+            if chk.startswith('translation:'):
+                d = _parse_vec(chk[len('translation:'):], dim)
+                for _ in range(samples):
+                    p = [rng.randint(lo, hi) for lo, hi in ranges]
+                    q = [a + b for a, b in zip(p, d)]
+                    if not _in_range(q, ranges):
+                        continue
+                    tried += 1
+                    fp, fq = oracle(p), oracle(q)
+                    if fp == fq:
+                        ok += 1
+                    elif len(bad) < 3:
+                        bad.append(f"p={p} f(p)={fp}, p+{d}={q} f={fq}")
+                label = f"translation by {d}"
+            elif chk == 'scale':
+                for _ in range(samples):
+                    p = [rng.randint(lo, hi) for lo, hi in ranges]
+                    q = [2 * a for a in p]
+                    if not _in_range(q, ranges):
+                        continue
+                    tried += 1
+                    fp, fq = oracle(p), oracle(q)
+                    if fp == fq:
+                        ok += 1
+                    elif len(bad) < 3:
+                        bad.append(f"p={p} f={fp}, 2p={q} f={fq}")
+                label = "scale by 2"
+            elif chk.startswith('symmetry:'):
+                perm = _parse_vec(chk[len('symmetry:'):], dim)
+                if sorted(perm) != list(range(dim)):
+                    raise ValueError(f"symmetry {perm} is not a permutation of 0..{dim - 1}")
+                for _ in range(samples):
+                    p = [rng.randint(lo, hi) for lo, hi in ranges]
+                    q = [p[perm[i]] for i in range(dim)]
+                    if not _in_range(q, ranges):
+                        continue
+                    tried += 1
+                    fp, fq = oracle(p), oracle(q)
+                    if fp == fq:
+                        ok += 1
+                    elif len(bad) < 3:
+                        bad.append(f"p={p} f={fp}, permuted={q} f={fq}")
+                label = f"symmetry {perm}"
+            elif chk.startswith('periodic:'):
+                _, pname, per = chk.split(':')
+                idx = names.index(pname.strip())
+                per = int(per)
+                lo, hi = ranges[idx]
+                for _ in range(samples):
+                    p = [rng.randint(l, h) for l, h in ranges]
+                    q = list(p)
+                    q[idx] = p[idx] + per
+                    if not _in_range(q, ranges):
+                        continue
+                    tried += 1
+                    fp, fq = oracle(p), oracle(q)
+                    if fp == fq:
+                        ok += 1
+                    elif len(bad) < 3:
+                        bad.append(f"p={p} f={fp}, {pname}+{per}: f={fq}")
+                label = f"periodic in {pname} with period {per}"
+            elif chk.startswith('eventually_affine:'):
+                pname = chk.split(':', 1)[1].strip()
+                idx = names.index(pname)
+                lo, hi = ranges[idx]
+                # Fit along this parameter at several random base points for the other params.
+                nbase = max(1, min(samples, 20))
+                report = []
+                for _ in range(nbase):
+                    base = [rng.randint(l, h) for l, h in ranges]
+                    seq = []
+                    for v in range(lo, hi + 1):
+                        pt = list(base)
+                        pt[idx] = v
+                        seq.append(oracle(pt))
+                    fit = _fit_sequence(seq, lo)
+                    tried += 1
+                    if fit['ok']:
+                        ok += 1
+                    elif len(bad) < 3:
+                        bad.append(f"base={base}: no affine fit within range (transient<= {fit['transient']}, period<=?)")
+                    if len(report) < 2:
+                        report.append(f"base={base}: {fit.get('text', '')}")
+                label = f"eventually affine in {pname}"
+                lines.append(f"[{label}] {ok}/{tried} base points fit. Examples:\n  " + "\n  ".join(report))
+                if ok < tried:
+                    failures_total += tried - ok
+                if bad:
+                    lines.append("  counterexamples: " + " | ".join(bad))
+                continue
+            else:
+                lines.append(f"[{chk}] unknown check (use translation:<v>, scale, symmetry:<perm>, eventually_affine:<p>, periodic:<p>:<k>)")
+                continue
+        except RuntimeError as e:
+            lines.append(f"[{chk}] oracle error: {e}")
+            failures_total += 1
+            continue
+        except ValueError as e:
+            lines.append(f"[{chk}] bad check spec: {e}")
+            continue
+        failures_total += tried - ok
+        status = "PASS" if tried > 0 and ok == tried else ("NO SAMPLES" if tried == 0 else "FAIL")
+        line = f"[{status}] {label}: {ok}/{tried} sampled points hold."
+        if bad:
+            line += "\n  counterexamples: " + " | ".join(bad)
+        lines.append(line)
+    return lines, failures_total
+
+
+def _fit_sequence(seq, start):
+    """
+    Given values seq[i] = f(start + i), find the smallest transient T and period P such that
+    for i >= T the sequence satisfies seq[i+P] - seq[i] == slope_class (constant per residue
+    class of i mod P), i.e. per residue class r, seq[i] = a_r * i + b_r for all i >= T with
+    i % P == r. Returns the fit or ok=False.
+    """
+    n = len(seq)
+    for period in range(1, max(2, n // 4) + 1):
+        for transient in range(0, n // 2 + 1):
+            tail = seq[transient:]
+            if len(tail) < 2 * period + 2:
+                break
+            fitted = {}
+            good = True
+            for r in range(period):
+                pts = [(transient + i, seq[transient + i]) for i in range(len(tail)) if (transient + i) % period == r]
+                if len(pts) < 2:
+                    good = False
+                    break
+                (x0, y0), (x1, y1) = pts[0], pts[1]
+                dx = x1 - x0
+                if (y1 - y0) % dx != 0:
+                    good = False
+                    break
+                slope = (y1 - y0) // dx
+                intercept = y0 - slope * x0
+                for x, y in pts:
+                    if slope * x + intercept != y:
+                        good = False
+                        break
+                if not good:
+                    break
+                fitted[r] = (slope, intercept)
+            if good:
+                rows = ", ".join(f"r={r}: f={a}*i+{b}" for r, (a, b) in sorted(fitted.items()))
+                return {'ok': True, 'transient': transient, 'period': period, 'fit': fitted,
+                        'text': f"transient={transient}, period={period}, per-class [{rows}] (i = offset from start)"}
+    return {'ok': False, 'transient': n // 2, 'text': 'no fit'}
+
+
+# ----------------------------------------------------------------------
+# Mode: fit_affine
+# ----------------------------------------------------------------------
+
+def _fit_along(oracle, names, ranges, base, direction, steps, classes):
+    idx = names.index(direction)
+    pts = []
+    for i in range(steps):
+        p = list(base)
+        p[idx] = base[idx] + i
+        pts.append(p)
+    seq = [oracle(p) for p in pts]
+    fit = _fit_sequence(seq, base[idx])
+    lines = [f"Values f along {direction} from {base[idx]} for {steps} steps (base={base}):",
+             "  " + ", ".join(str(v) for v in seq[:40]) + (" ..." if len(seq) > 40 else "")]
+    if not fit['ok']:
+        lines.append("No eventually-affine pattern found with the given steps. Increase steps or check the oracle.")
+        return lines
+    lines.append(fit['text'])
+    lines.append("Table (class, slope, intercept, valid from offset):")
+    for r, (a, b) in sorted(fit['fit'].items()):
+        lines.append(f"  class {r}: slope={a}, intercept={b}")
+    # Verify the fit on the whole tail beyond the transient.
+    t, P = fit['transient'], fit['period']
+    ok_all = True
+    for i in range(t, len(seq)):
+        a, b = fit['fit'][i % P]
+        if a * i + b != seq[i]:
+            ok_all = False
+            break
+    lines.append(f"verified on all {len(seq) - t} tail points: {ok_all}")
+    lines.append("Note: the fit uses the offset from the base value; slope/intercept are in terms of offset i.")
+    return lines
+
+
+# ----------------------------------------------------------------------
+# Entry point
+# ----------------------------------------------------------------------
+
+def tool_function(oracle_cmd, params, mode="check", checks="", samples=200, seed=1, timeout=5,
+                  base=None, direction=None, steps=60, classes=2):
+    try:
+        names, ranges = _parse_params(params)
+    except Exception as e:
+        return f"Error: bad params: {e}"
+    try:
+        timeout = float(timeout) if timeout is not None else 5.0
+        samples = int(samples) if samples is not None else 200
+        seed = int(seed) if seed is not None else 1
+        steps = int(steps) if steps is not None else 60
+    except (TypeError, ValueError) as e:
+        return f"Error: bad numeric argument: {e}"
+    if _is_py_like(oracle_cmd) and not os.path.isfile(oracle_cmd.strip()):
+        return f"Error: oracle file not found: {oracle_cmd.strip()}"
+    try:
+        oracle = _Oracle(oracle_cmd, names, timeout)
+    except Exception as e:
+        return f"Error: could not load oracle: {e}"
+    rng = random.Random(seed)
+
+    try:
+        if mode == "fit_affine":
+            if base is None or direction is None:
+                return "Error: fit_affine needs base and direction."
+            base_vals = [int(x) for x in str(base).split(',') if x.strip() != '']
+            if len(base_vals) != len(names):
+                return f"Error: base needs {len(names)} integers."
+            if direction not in names:
+                return f"Error: direction {direction!r} is not one of {names}."
+            lines = _fit_along(oracle, names, ranges, base_vals, direction, steps, int(classes or 2))
+            return "\n".join(lines) + f"\n(oracle calls: {oracle.calls})"
+        if mode not in ("check", None, ""):
+            return f"Error: unknown mode {mode!r}; use 'check' or 'fit_affine'."
+        if not checks:
+            return "Error: check mode needs `checks`."
+        lines, failures = _check_properties(oracle, names, ranges, checks, samples, rng)
+        header = f"Checked {len(lines)} properties; failing sample count: {failures}. Oracle calls: {oracle.calls} (cached)."
+        return header + "\n" + "\n".join(lines)
+    except RuntimeError as e:
+        return f"Error: {e}"
+    except ValueError as e:
+        return f"Error: {e}"
