+import os
+import subprocess
+import sys
+import time
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a candidate program against a reference (brute-force) program.
+
+* A generator script is run with the case index as its single argument (e.g. `python gen.py 17`) and must print one random test input to stdout.
+* The reference and candidate programs are each run on that input (stdin -> stdout) with a timeout.
+* Outputs are compared after stripping trailing whitespace per line.
+* Returns 'PASS' with the number of cases if all cases match, otherwise the first mismatching input with both outputs (or the error/timeout).
+* Use small inputs for the reference; use this tool to validate an efficient solution against a brute-force oracle.
+* Paths are relative to the working directory or absolute.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to the reference (brute-force) program, e.g. /tmp/brute.py."
+                },
+                "candidate_path": {
+                    "type": "string",
+                    "description": "Path to the candidate (efficient) program, e.g. solution.py."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator script that takes an integer case index as argv[1] and prints one test input to stdout."
+                },
+                "n_cases": {
+                    "type": "integer",
+                    "description": "Number of random cases to run (e.g. 200)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for each program invocation (e.g. 10)."
+                }
+            },
+            "required": ["reference_path", "candidate_path", "generator_path", "n_cases", "timeout"]
+        }
+    }
+
+
+def _run(path, stdin_text, timeout):
+    """Run a python script; return (status, stdout, stderr) with status in ok/timeout/error."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, path],
+            input=stdin_text, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, timeout=timeout, check=False,
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", "", ""
+    if proc.returncode != 0:
+        return "error", proc.stdout, proc.stderr
+    return "ok", proc.stdout, proc.stderr
+
+
+def _normalize(text):
+    return [line.rstrip() for line in (text or "").strip().splitlines()]
+
+
+def tool_function(reference_path, candidate_path, generator_path, n_cases, timeout):
+    try:
+        n_cases = int(n_cases)
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        return "Error: n_cases must be an integer and timeout a number."
+    for label, path in [("reference", reference_path), ("candidate", candidate_path), ("generator", generator_path)]:
+        if not os.path.isfile(path):
+            return f"Error: {label} file not found: {path}"
+    if n_cases <= 0:
+        return "Error: n_cases must be positive."
+
+    for case_idx in range(n_cases):
+        try:
+            gen = subprocess.run(
+                [sys.executable, generator_path, str(case_idx)],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                text=True, timeout=timeout, check=False,
+            )
+        except subprocess.TimeoutExpired:
+            return f"Error: generator timed out on case {case_idx}."
+        if gen.returncode != 0:
+            return f"Error: generator failed on case {case_idx}:\n{gen.stderr.strip()[-1500:]}"
+        test_input = gen.stdout
+
+        ref_status, ref_out, ref_err = _run(reference_path, test_input, timeout)
+        if ref_status != "ok":
+            return (f"Reference {ref_status} on case {case_idx}. Input:\n{test_input}"
+                    f"stderr:\n{ref_err.strip()[-1500:]}")
+
+        cand_status, cand_out, cand_err = _run(candidate_path, test_input, timeout)
+        if cand_status == "timeout":
+            return f"MISMATCH (candidate timeout after {timeout}s) on case {case_idx}. Input:\n{test_input}"
+        if cand_status == "error":
+            return (f"MISMATCH (candidate runtime error) on case {case_idx}. Input:\n{test_input}"
+                    f"stderr:\n{cand_err.strip()[-1500:]}")
+        if _normalize(ref_out) != _normalize(cand_out):
+            return (f"MISMATCH on case {case_idx}.\nInput:\n{test_input}"
+                    f"Reference output:\n{ref_out}\nCandidate output:\n{cand_out}")
+
+    return f"PASS: all {n_cases} cases matched."
