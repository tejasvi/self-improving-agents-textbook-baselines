+def _strip_fences(text):
+    """Remove markdown code fences and surrounding blank lines from a sample block."""
+    lines = [l for l in (text or '').strip('\n').split('\n') if not l.strip().startswith('```')]
+    return '\n'.join(lines).strip() + '\n'
+
+
+def parse_sample_tests(problem_statement):
+    """
+    Extract (input, expected_output) pairs from 'Sample Input N' / 'Sample Output N' blocks.
+    Returns a list of tuples; empty if none are found.
+    """
+    samples = []
+    for match in SAMPLE_PATTERN.finditer(problem_statement or ''):
+        sample_input = _strip_fences(match.group(2))
+        sample_output = _strip_fences(match.group(3))
+        if sample_input.strip() and sample_output.strip():
+            samples.append((sample_input, sample_output))
+    return samples
+
+
+def _normalize_output(text):
+    """Compare outputs ignoring trailing whitespace on each line and at the end."""
+    return [line.rstrip() for line in (text or '').strip().splitlines()]
+
+
+def _last_assistant_text(msg_history):
+    """
+    Return the text of the last assistant message in a message history.
+    Handles both string content and list-of-block content formats.
+    """
+    for msg in reversed(msg_history or []):
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for block in content:
+                if isinstance(block, str):
+                    parts.append(block)
+                elif isinstance(block, dict) and isinstance(block.get('text'), str):
+                    parts.append(block['text'])
+            return '\n'.join(parts)
+        return ''
+    return ''
+
+
+def find_give_up_phrases(text):
+    lowered = (text or '').lower()
+    return [p for p in GIVE_UP_PHRASES if p in lowered]
