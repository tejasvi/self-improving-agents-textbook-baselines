+    'fallback',
+    'too slow',
+    'time out',
+    'timed out',
+    'not efficient',
+    'does not meet',
+]
+
+SAMPLE_PATTERN = re.compile(
+    r'Sample Input\s*(\d*)\s*:?[ \t]*\n(.*?)\n[ \t]*Sample Output\s*\1\s*:?[ \t]*\n(.*?)(?=\n[ \t]*Sample Input|\n#{1,6} |\Z)',
+    re.DOTALL,
