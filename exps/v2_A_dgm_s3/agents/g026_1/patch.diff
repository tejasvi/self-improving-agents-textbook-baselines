+EXAMPLE_INPUT_RE = re.compile(r'^\s*Input\s*:\s*(.+?)\s*$', re.MULTILINE)
+EXAMPLE_OUTPUT_RE = re.compile(r'^\s*Output\s*:\s*(.+?)\s*$', re.MULTILINE)
+
+
+def _split_top_level(text, sep=','):
+    """Split on `sep` outside brackets/quotes."""
+    parts, depth, quote, cur = [], 0, None, ''
+    for ch in text:
+        if quote:
+            cur += ch
+            if ch == quote:
+                quote = None
+            continue
+        if ch in '"\'':
+            quote = ch
+        elif ch in '([{':
+            depth += 1
+        elif ch in ')]}':
+            depth -= 1
+        elif ch == sep and depth == 0:
+            parts.append(cur)
+            cur = ''
+            continue
+        cur += ch
+    if cur.strip():
+        parts.append(cur)
+    return parts
+
+
+def parse_leetcode_examples(problem_statement):
+    """
+    Parse LeetCode-style examples: 'Input: x = [1,2], k = 3' followed by 'Output: 5'.
+    Returns a list of (args_list, expected) where args_list is the positional argument
+    values in order of appearance and expected is the literal output value.
+    Values are parsed with ast.literal_eval; unparseable examples are skipped.
+    """
+    examples = []
+    text = problem_statement or ''
+    inputs = list(EXAMPLE_INPUT_RE.finditer(text))
+    outputs = list(EXAMPLE_OUTPUT_RE.finditer(text))
+    for inp in inputs:
+        following = [o for o in outputs if o.start() > inp.end()]
+        if not following:
+            continue
+        out = following[0]
+        # Only pair if no other Input line sits between them.
+        if any(i.start() > inp.end() and i.start() < out.start() for i in inputs):
+            continue
+        args = []
+        ok = True
+        for part in _split_top_level(inp.group(1)):
+            if '=' not in part:
+                ok = False
+                break
+            _, _, value = part.partition('=')
+            try:
+                args.append(ast.literal_eval(value.strip()))
+            except Exception:
+                ok = False
+                break
+        if not ok or not args:
+            continue
+        expected_text = out.group(1).strip()
+        try:
+            expected = ast.literal_eval(expected_text)
+        except Exception:
+            expected = expected_text
+        examples.append((args, expected))
+    return examples
+
+
+def parse_constraint_sizes(problem_statement):
+    """
+    Extract the largest bound N from constraints like 'length <= 2 * 10^4', '<= 10^5',
+    'n <= 100000'. Returns a list of ints (may be empty).
+    """
+    text = problem_statement or ''
+    sizes = []
+    for m in re.finditer(r'<=?\s*(\d+)\s*\*?\s*10\s*\^\s*(\d+)', text):
+        base = int(m.group(1)) * 10 ** int(m.group(2))
+        sizes.append(base)
+    for m in re.finditer(r'(?:<=|≤)\s*(\d{3,})\b', text):
+        sizes.append(int(m.group(1)))
+    for m in re.finditer(r'\b10\s*\^\s*(\d+)\b', text):
+        sizes.append(10 ** int(m.group(1)))
+    return sorted(set(sizes))
+
+
+LENGTH_BOUND_RE = re.compile(
+    r'\b(?:[\w.]*?(?:length|len|size)|n|m|N|M)(?:\[\w*\])?\s*(?:<=|≤)\s*'
+    r'(?:(\d+)\s*\*?\s*10\s*\^\s*(\d+)|10\s*\^\s*(\d+)|(\d+))'
+)
+
+
+def parse_length_bound(problem_statement):
+    """Largest bound on a length/size-like variable (e.g. 'length <= 2 * 10^4'), or None."""
+    best = None
+    for m in LENGTH_BOUND_RE.finditer(problem_statement or ''):
+        if m.group(2) is not None:
+            value = int(m.group(1)) * 10 ** int(m.group(2))
+        elif m.group(3) is not None:
+            value = 10 ** int(m.group(3))
+        else:
+            value = int(m.group(4))
+        if value > 0 and (best is None or value > best):
+            best = value
+    return best
+
+
+def build_timing_probe(problem_statement, max_size=None):
+    """
+    Build a list of max-size argument lists for a timing probe: random, constant and
+    alternating sequences for list/string arguments, guessed from the constraints.
+    Returns a list of (label, args) pairs; empty when no size constraint is found.
+    """
+    if max_size is None:
+        max_size = parse_length_bound(problem_statement)
+        if not max_size:
+            return []
+        max_size = min(max_size, 200000)
+    n = max_size
+    probes = []
+    rnd = random.Random(12345)
+    rand_list = [rnd.randint(1, 10 ** 9) for _ in range(n)]
+    probes.append(("random ints", [rand_list]))
+    probes.append(("constant ints", [[7] * n]))
+    probes.append(("alternating ints", [[1 if i % 2 else 2 for i in range(n)]]))
+    rand_str = ''.join(rnd.choice('abc') for _ in range(n))
+    probes.append(("random lowercase string", [rand_str]))
+    probes.append(("constant string", ['a' * n]))
+    probes.append(("alternating string", [('ab' * n)[:n]]))
+    return probes
+
