+    with os.fdopen(fd, "w") as fh:
+        json.dump(args, fh, default=str)
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            [sys.executable, runner, file_path, method_name, args_path],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, timeout=timeout, cwd=cwd, check=False,
+        )
+    except subprocess.TimeoutExpired:
+        return {"status": "TIMEOUT", "elapsed": time.time() - start, "output": None,
+                "detail": f"exceeded {timeout} seconds"}
+    finally:
+        try:
+            os.remove(args_path)
+        except OSError:
+            pass
+    elapsed = time.time() - start
+    marker = "__RESULT__"
+    payload = None
+    for line in proc.stdout.splitlines():
+        if line.startswith(marker):
+            try:
+                payload = json.loads(line[len(marker):])
+            except Exception:
+                payload = None
+    if payload is None:
+        tail = (proc.stderr or "").strip()[-1500:]
+        return {"status": "ERROR", "elapsed": elapsed, "output": None,
+                "detail": f"exit {proc.returncode}: {tail}"}
+    return {"status": "OK", "elapsed": payload.get("elapsed", elapsed),
+            "output": payload.get("result"), "detail": ""}
+
+
+def _format_case(idx, case, res, has_expected):
+    lines = [f"Case {idx}: {res['status']} (elapsed {res['elapsed']:.3f}s)"]
+    if res["status"] == "TIMEOUT":
+        lines.append(f"  {res['detail']}")
+    elif res["status"] == "ERROR":
+        lines.append(f"  runtime error: {res['detail']}")
+    else:
+        lines.append(f"  output: {json.dumps(res['output'], default=str)[:800]}")
+        if has_expected:
+            lines.append(f"  expected: {json.dumps(case['expected'], default=str)[:800]}")
+    return "\n".join(lines)
+
+
+def tool_function(file_path, method_name, cases, timeout=5, generator=None, **kwargs):
+    _summary, text = check_cases(file_path, method_name, cases, timeout=timeout, generator=generator)
+    return text
+
+
+def check_cases(file_path, method_name, cases, timeout=5, generator=None):
+    """Run the checks. Returns (summary_counts_dict, report_text)."""
+    empty = {"PASS": 0, "FAIL": 0, "TIMEOUT": 0, "ERROR": 1}
+    try:
+        timeout = float(timeout) if timeout is not None else 5.0
+    except (TypeError, ValueError):
+        return empty, "Error: timeout must be a number of seconds."
+    try:
+        case_list = json.loads(cases) if isinstance(cases, str) else cases
+    except Exception as e:
+        return empty, f"Error: `cases` must be a JSON list: {e}"
+    if not isinstance(case_list, list):
+        return empty, "Error: `cases` must be a JSON list of objects."
+    if not os.path.isfile(file_path):
+        return empty, f"Error: file {file_path} does not exist."
+
+    cwd = os.path.dirname(os.path.abspath(file_path))
+    reports = []
+    summary = {"PASS": 0, "FAIL": 0, "TIMEOUT": 0, "ERROR": 0}
+
+    for idx, case in enumerate(case_list, start=1):
+        if not isinstance(case, dict) or not isinstance(case.get("args", []), list):
+            reports.append(f"Case {idx}: ERROR (case must be an object with a list 'args')")
+            summary["ERROR"] += 1
+            continue
+        args = case.get("args", [])
+        res = _run_case(file_path, method_name, args, timeout, cwd)
+        has_expected = "expected" in case
+        if res["status"] == "OK":
+            if has_expected and not _values_equal(res["output"], case["expected"]):
+                res["status"] = "FAIL"
+            else:
+                res["status"] = "PASS"
+        summary[res["status"]] = summary.get(res["status"], 0) + 1
+        reports.append(_format_case(idx, case, res, has_expected))
+
+    if generator:
+        gen_src = f"{generator}\n"
+        gen_path = os.path.join(tempfile.gettempdir(), "run_solution_check_gen.py")
+        try:
+            with open(gen_path, "w") as fh:
+                fh.write(gen_src + "\nimport json as _j\nprint(_j.dumps(gen()))\n")
+            gen_proc = subprocess.run([sys.executable, gen_path], stdout=subprocess.PIPE,
+                                      stderr=subprocess.PIPE, text=True, timeout=timeout, check=False)
+            if gen_proc.returncode != 0:
+                reports.append(f"Generator: ERROR: {gen_proc.stderr.strip()[-800:]}")
+            else:
+                gen_args = json.loads(gen_proc.stdout.strip().splitlines()[-1])
+                res = _run_case(file_path, method_name, gen_args, timeout, cwd)
+                if res["status"] == "OK":
+                    res["status"] = "PASS"
+                summary[res["status"]] = summary.get(res["status"], 0) + 1
+                reports.append("Generated max-size case: " + _format_case(0, {}, res, False).replace("Case 0: ", ""))
+        except subprocess.TimeoutExpired:
+            reports.append(f"Generator: TIMEOUT (generator exceeded {timeout} seconds)")
+            summary["TIMEOUT"] += 1
+        except Exception as e:
+            reports.append(f"Generator: ERROR: {e}")
+            summary["ERROR"] += 1
+
+    header = (
+        f"Summary: {summary.get('PASS', 0)} PASS, {summary.get('FAIL', 0)} FAIL, "
+        f"{summary.get('TIMEOUT', 0)} TIMEOUT, {summary.get('ERROR', 0)} ERROR "
+        f"(timeout {timeout}s per case)"
+    )
+    return summary, header + "\n\n" + "\n\n".join(reports)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 4:
+        print("Usage: python run_solution_check.py <file_path> <method_name> '<cases json>' [timeout]")
+    else:
+        t = float(sys.argv[4]) if len(sys.argv) > 4 else 5
+        print(tool_function(sys.argv[1], sys.argv[2], sys.argv[3], timeout=t))
