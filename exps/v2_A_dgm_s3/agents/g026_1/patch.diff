+RUNNER_SCRIPT = r'''
+import importlib.util, json, sys, time, io, contextlib
+
+file_path, method_name, args_file = sys.argv[1], sys.argv[2], sys.argv[3]
+spec = importlib.util.spec_from_file_location("candidate_module", file_path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+with open(args_file) as fh:
+    args = json.load(fh)
+sol = module.Solution()
+method = getattr(sol, method_name)
+start = time.time()
+result = method(*args)
+elapsed = time.time() - start
+print("__RESULT__" + json.dumps({"result": result, "elapsed": elapsed}, default=str))
+'''
+
+_RUNNER_PATH = os.path.join(tempfile.gettempdir(), "run_solution_check_runner.py")
+
+
+def tool_info():
+    return {
+        "name": "run_solution_check",
+        "description": """Check a `Solution` class method against test cases, with a timeout per case.
+
+* Imports `Solution` from the given file, instantiates it, and calls `method_name` once per case with the case's `args` (a JSON list of positional arguments).
+* If a case has `expected`, the returned value is compared with it (lists/dicts/numbers compared by JSON equality; strings compared after stripping trailing whitespace).
+* Each case runs in its own python subprocess, killed after `timeout` seconds (reported as TIMEOUT).
+* Reports PASS / FAIL / TIMEOUT / ERROR per case with the actual output and elapsed time.
+* Optional `generator`: a python snippet defining `gen()` that returns a list of positional args (e.g. a max-size input). It is run as one extra case, useful for timing on max constraints.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {
+                    "type": "string",
+                    "description": "Path to the python file that defines the `Solution` class."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on the Solution instance."
+                },
+                "cases": {
+                    "type": "string",
+                    "description": "JSON list of cases. Each case is an object with 'args' (JSON list of positional arguments) and optional 'expected' (expected return value). Example: [{\"args\": [[1,2,3], 2], \"expected\": 2}, {\"args\": [\"abc\"]}]"
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each case. Defaults to 5."
+                },
+                "generator": {
+                    "type": "string",
+                    "description": "Optional python snippet defining gen() that returns a list of positional args for an extra max-size timing case. Example: \"import random\\ndef gen():\\n    return [[random.randint(1, 10**9) for _ in range(10**5)]]\""
+                }
+            },
+            "required": ["file_path", "method_name", "cases"]
+        }
+    }
+
+
+def _write_runner():
+    with open(_RUNNER_PATH, "w") as fh:
+        fh.write(RUNNER_SCRIPT)
+    return _RUNNER_PATH
+
+
+def _values_equal(got, want):
+    if isinstance(want, str) and isinstance(got, str):
+        return got.rstrip() == want.rstrip()
+    try:
+        return json.dumps(got, sort_keys=True) == json.dumps(want, sort_keys=True)
+    except Exception:
