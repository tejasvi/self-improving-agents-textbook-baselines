diff --git a/tools/run_samples.py b/tools/run_samples.py
new file mode 100644
index 0000000..54b57ff
--- /dev/null
+++ b/tools/run_samples.py
@@ -0,0 +1,142 @@
+import difflib
+import re
+import subprocess
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run the solution against the sample tests extracted from a problem statement file.\n
+* Extracts 'Sample Input N' / 'Sample Output N' pairs (also 'Example N' / 'Input:' / 'Output:' variants).\n
+* Runs solution_cmd on each sample input via stdin with a timeout.\n
+* Reports per sample: EXACT MATCH, WHITESPACE-ONLY DIFFERENCE, or MISMATCH, with a unified diff and the raw actual vs expected output.\n
+* Output is raw; no error interpretation is performed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "statement_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the problem statement (e.g. /tmp/problem_statement.txt)."
+                },
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution; reads the input on stdin and writes the answer to stdout."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Optional. Per-sample timeout in seconds (default 10)."
+                }
+            },
+            "required": ["statement_path", "solution_cmd"]
+        }
+    }
+
+# A header is a whole line like: 'Sample Input 1', 'Example #2 Input', 'Input:', 'Sample Output:', 'Output 3:'
+_HEADER_RE = re.compile(
+    r'^\s*(?:(?:sample|example)\s*)?(input|output)\s*#?\s*(\d*)\s*:?\s*$'
+    r'|^\s*(?:sample|example)\s*#?\s*(\d*)\s*(input|output)\s*:?\s*$',
+    re.IGNORECASE,
+)
+
+def _header(line, fallback_idx):
+    """Return ('in'|'out', index) if the line is a sample header, else None."""
+    m = _HEADER_RE.match(line)
+    if not m:
+        return None
+    if m.group(1):
+        kind, num = m.group(1), m.group(2)
+    else:
+        kind, num = m.group(4), m.group(3)
+    return kind.lower(), (int(num) if num else fallback_idx)
+
+def extract_samples(text):
+    """Return list of (index, input_text, expected_output) from statement text."""
+    blocks = []  # [kind, idx, lines]
+    current = None
+    for line in text.splitlines():
+        hdr = _header(line, fallback_idx=len(blocks) + 1)
+        if hdr is not None:
+            current = [hdr[0], hdr[1], []]
+            blocks.append(current)
+        elif current is not None:
+            current[2].append(line)
+
+    samples = []
+    pending = None
+    for kind, idx, body in blocks:
+        # A block ends at the first blank line (prose usually follows the sample).
+        content = []
+        for line in body:
+            if not line.strip():
+                if content:
+                    break
+                continue
+            content.append(line)
+        if not content:
+            continue
+        text_block = "\n".join(content) + "\n"
+        if kind == 'input':
+            pending = (idx, text_block)
+        elif pending is not None:
+            samples.append((pending[0], pending[1], text_block))
+            pending = None
+    return samples
+
+def _compare(actual, expected):
+    if actual.rstrip() == expected.rstrip():
+        return "EXACT MATCH"
+    if actual.split() == expected.split():
+        return "WHITESPACE-ONLY DIFFERENCE"
+    return "MISMATCH"
+
+def tool_function(statement_path: str, solution_cmd: str, timeout: int = 10) -> str:
+    try:
+        with open(statement_path, 'r', errors='replace') as fh:
+            text = fh.read()
+    except Exception as e:
+        return f"Error: could not read statement file {statement_path}: {e}"
+    try:
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError):
+        return f"Error: timeout must be an integer, got {timeout!r}"
+
+    samples = extract_samples(text)
+    if not samples:
+        return f"No sample input/output pairs found in {statement_path}."
+
+    report = []
+    verdicts = []
+    for idx, sample_in, expected in samples:
+        try:
+            proc = subprocess.run(
+                solution_cmd, shell=True, input=sample_in, capture_output=True, text=True, timeout=timeout,
+            )
+            actual = proc.stdout
+            extra = "" if proc.returncode == 0 else f"[exit code {proc.returncode}] stderr:\n{proc.stderr}\n"
+        except subprocess.TimeoutExpired:
+            actual = ""
+            extra = f"TIMEOUT after {timeout}s\n"
+        verdict = "MISMATCH" if extra.startswith("TIMEOUT") else _compare(actual, expected)
+        verdicts.append(verdict)
+        report.append(f"=== Sample {idx}: {verdict} ===")
+        if verdict != "EXACT MATCH":
+            diff = difflib.unified_diff(
+                expected.splitlines(keepends=True), actual.splitlines(keepends=True),
+                fromfile=f"expected (sample {idx})", tofile=f"actual (sample {idx})",
+            )
+            report.append("".join(diff) or "(no line diff; differences are in trailing whitespace)\n")
+        if extra:
+            report.append(extra)
+        report.append(f"--- input ---\n{sample_in}--- actual output ---\n{actual}--- expected output ---\n{expected}")
+
+    summary = ", ".join(f"{i}:{v}" for (i, _, _), v in zip(samples, verdicts))
+    header = f"Summary ({len(samples)} samples): {summary}\n"
+    if all(v == "EXACT MATCH" for v in verdicts):
+        header += "All samples are EXACT MATCH.\n"
+    return header + "\n".join(report)
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("Usage: python run_samples.py <statement_path> <solution_cmd>")
+    else:
+        print(tool_function(sys.argv[1], sys.argv[2]))
