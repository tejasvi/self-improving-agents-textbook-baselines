diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..5322a13
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,221 @@
+import os
+import re
+import subprocess
+
+MAX_REPORT_CHARS = 2000
+DEFAULT_PROBLEM_FILES = ["README.md", "/work/repo/README.md"]
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Check a solution program against the sample tests written in the problem statement.
+
+* Parses 'Sample Input N' / 'Sample Output N' blocks (falls back to 'Input:' / 'Output:' blocks) from the problem text.
+* Runs the solution command on each sample input and compares its stdout with the expected sample output.
+* Per-sample verdicts: EXACT_MATCH, WHITESPACE_MATCH (only trailing whitespace differs), MISMATCH (shows expected vs actual), ERROR (non-zero exit, timeout; shows stderr tail).
+* A MISMATCH is NOT acceptable just because the statement says 'print any valid answer': the grader may compare against the canonical sample output. Change the construction until every sample matches exactly.
+* The final summary line is 'ALL SAMPLES MATCH' when every sample matches, otherwise it reports the number of mismatching/erroring samples.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution under test, e.g. 'python3 /path/solution.py'. It reads the sample input from stdin and writes to stdout."
+                },
+                "problem_text": {
+                    "type": "string",
+                    "description": "Optional. The problem statement text containing the samples. If omitted, problem_file or README.md is read."
+                },
+                "problem_file": {
+                    "type": "string",
+                    "description": "Optional. Path to a file containing the problem statement with the samples. Used when problem_text is not given."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional. Per-sample timeout in seconds (default 10)."
+                }
+            },
+            "required": ["solution_cmd"]
+        }
+    }
+
+
+SAMPLE_INPUT_RE = re.compile(r'^\s*Sample Input\s*(\d+)\s*$', re.IGNORECASE)
+SAMPLE_OUTPUT_RE = re.compile(r'^\s*Sample Output\s*(\d+)\s*$', re.IGNORECASE)
+SECTION_RE = re.compile(r'^\s*(?:##|(?:Constraints|Explanation|Note)\b)', re.IGNORECASE)
+FALLBACK_INPUT_RE = re.compile(r'^\s*Input:?\s*$', re.IGNORECASE)
+FALLBACK_OUTPUT_RE = re.compile(r'^\s*Output:?\s*$', re.IGNORECASE)
+FALLBACK_STOP_RE = re.compile(r'^\s*(?:##|(?:Input:?|Explanation|Example|Note|Constraints)\b)', re.IGNORECASE)
+
+
+def _strip_fence(lines):
+    """Drop markdown code-fence lines and surrounding blank lines from a block."""
+    kept = [l for l in lines if not l.strip().startswith('```')]
+    while kept and not kept[0].strip():
+        kept.pop(0)
+    while kept and not kept[-1].strip():
+        kept.pop()
+    return '\n'.join(kept)
+
+
+def _numbered_samples(lines):
+    """Parse 'Sample Input N' / 'Sample Output N' blocks in one linear pass."""
+    samples = []
+    i, n = 0, len(lines)
+    while i < n:
+        m = SAMPLE_INPUT_RE.match(lines[i])
+        if not m:
+            i += 1
+            continue
+        idx = m.group(1)
+        i += 1
+        in_lines = []
+        while i < n and not SAMPLE_OUTPUT_RE.match(lines[i]) and not SAMPLE_INPUT_RE.match(lines[i]):
+            in_lines.append(lines[i])
+            i += 1
+        if i >= n or not SAMPLE_OUTPUT_RE.match(lines[i]) or SAMPLE_OUTPUT_RE.match(lines[i]).group(1) != idx:
+            continue  # header without a matching output block
+        i += 1
+        out_lines = []
+        while i < n and not SAMPLE_INPUT_RE.match(lines[i]) and not SECTION_RE.match(lines[i]):
+            out_lines.append(lines[i])
+            i += 1
+        samples.append((_strip_fence(in_lines), _strip_fence(out_lines)))
+    return samples
+
+
+def _fallback_samples(lines):
+    """Parse 'Input:' / 'Output:' blocks in one linear pass."""
+    samples = []
+    i, n = 0, len(lines)
+    while i < n:
+        if not FALLBACK_INPUT_RE.match(lines[i]):
+            i += 1
+            continue
+        i += 1
+        in_lines = []
+        while i < n and not FALLBACK_OUTPUT_RE.match(lines[i]) and not FALLBACK_INPUT_RE.match(lines[i]):
+            in_lines.append(lines[i])
+            i += 1
+        if i >= n or not FALLBACK_OUTPUT_RE.match(lines[i]):
+            continue
+        i += 1
+        out_lines = []
+        while i < n and not FALLBACK_STOP_RE.match(lines[i]) and not FALLBACK_OUTPUT_RE.match(lines[i]):
+            out_lines.append(lines[i])
+            i += 1
+        samples.append((_strip_fence(in_lines), _strip_fence(out_lines)))
+    return samples
+
+
+def parse_samples(text):
+    """Return a list of (input_text, expected_output_text) tuples parsed from the statement.
+
+    Single linear pass per format; no backtracking regexes, so unmatched headers cannot blow up.
+    """
+    lines = (text or '').splitlines()
+    samples = _numbered_samples(lines)
+    if not samples:
+        samples = _fallback_samples(lines)
+    return samples
+
+
+def _load_problem_text(problem_text, problem_file):
+    if problem_text:
+        return problem_text, None
+    candidates = [problem_file] if problem_file else DEFAULT_PROBLEM_FILES
+    for path in candidates:
+        if path and os.path.isfile(path):
+            try:
+                with open(path, 'r', errors='replace') as fh:
+                    return fh.read(), None
+            except Exception as e:
+                return None, f"Failed to read {path}: {e}"
+    return None, f"No problem text given and no problem file found (tried: {', '.join(c for c in candidates if c)})."
+
+
+def _truncate(text):
+    text = text or ''
+    if len(text) > MAX_REPORT_CHARS:
+        return text[:MAX_REPORT_CHARS] + "\n<truncated>"
+    return text
+
+
+def _rstrip_lines(text):
+    return [line.rstrip() for line in (text or '').strip('\n').splitlines()]
+
+
+def _run_one(solution_cmd, input_text, timeout):
+    try:
+        proc = subprocess.run(
+            solution_cmd, shell=True, input=input_text + ('' if input_text.endswith('\n') else '\n'),
+            capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, '', f"timed out after {timeout}s"
+    return proc.returncode, proc.stdout, proc.stderr
+
+
+def tool_function(solution_cmd, problem_text=None, problem_file=None, timeout=10):
+    if not solution_cmd or not isinstance(solution_cmd, str):
+        return "Error: solution_cmd must be a non-empty string."
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Error: timeout must be a number, got {timeout!r}"
+
+    text, err = _load_problem_text(problem_text, problem_file)
+    if err:
+        return f"Error: {err}"
+
+    samples = parse_samples(text)
+    if not samples:
+        return "Error: no samples found in the problem text (expected 'Sample Input N' / 'Sample Output N' or 'Input:' / 'Output:' blocks)."
+
+    lines = [f"Found {len(samples)} sample(s)."]
+    counts = {'EXACT_MATCH': 0, 'WHITESPACE_MATCH': 0, 'MISMATCH': 0, 'ERROR': 0}
+    for idx, (inp, expected) in enumerate(samples, start=1):
+        rc, actual, stderr = _run_one(solution_cmd, inp, timeout)
+        if rc is None:
+            verdict = 'ERROR'
+            detail = f"Solution {stderr}.\nInput:\n{_truncate(inp)}"
+        elif rc != 0:
+            verdict = 'ERROR'
+            detail = f"Solution exited with code {rc}.\nstderr tail:\n{_truncate(stderr[-1000:])}"
+        elif actual == expected:
+            verdict = 'EXACT_MATCH'
+            detail = ''
+        elif _rstrip_lines(actual) == _rstrip_lines(expected):
+            verdict = 'WHITESPACE_MATCH'
+            detail = ''
+        else:
+            verdict = 'MISMATCH'
+            detail = (
+                f"Input:\n{_truncate(inp)}\n"
+                f"Expected output:\n{_truncate(expected)}\n"
+                f"Actual output:\n{_truncate(actual)}"
+            )
+            if stderr.strip():
+                detail += f"\nstderr tail:\n{_truncate(stderr[-500:])}"
+        counts[verdict] += 1
+        lines.append(f"Sample {idx}: {verdict}")
+        if detail:
+            lines.append(detail)
+
+    bad = counts['MISMATCH'] + counts['ERROR']
+    if bad == 0:
+        lines.append("ALL SAMPLES MATCH" + (" (some only differ in trailing whitespace)" if counts['WHITESPACE_MATCH'] else ""))
+    else:
+        parts = []
+        if counts['MISMATCH']:
+            parts.append(f"{counts['MISMATCH']} SAMPLES MISMATCH")
+        if counts['ERROR']:
+            parts.append(f"{counts['ERROR']} SAMPLES ERROR")
+        lines.append(", ".join(parts) + f" (of {len(samples)})")
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    demo = "Sample Input 1\n2\nSample Output 1\n4\n"
+    print(tool_function("echo 4", problem_text=demo))
