+MAX_OUTPUT_CAP = 8192  # model output cap used when growing max_tokens after an empty max_tokens stop
+
+
+def _stop_reason_of(resp):
+    """stop_reason of a raw response, or of the last Claude call in this thread for (text, history) tuples."""
+    sr = getattr(resp, 'stop_reason', None)
+    if sr is None and isinstance(resp, tuple):
+        sr = getattr(_stop_state, 'stop_reason', None)
+    return sr
+
+
+def _grow_request(kwargs, attempt):
+    """
+    Default adjustment for an empty max_tokens response: double max_tokens (capped at MAX_OUTPUT_CAP)
+    when the call carries it, and drop extended-thinking settings so the whole budget goes to output.
+    Returns the new kwargs (the original dict is not mutated).
+    """
+    new_kwargs = dict(kwargs)
+    if 'max_tokens' in new_kwargs:
+        new_kwargs['max_tokens'] = min(int(new_kwargs['max_tokens']) * 2, MAX_OUTPUT_CAP)
+    new_kwargs.pop('thinking_budget', None)
+    return new_kwargs
+
+
+def call_with_retry(fn, *args, max_attempts=4, logging=print, empty_model='', adjust=None, **kwargs):
     """
     Call fn(*args, **kwargs) with bounded retries (for loop, exponential backoff, no while loop).
     Exceptions are logged with repr(e). A result is invalid when it is empty (see _is_empty_response);
     then stop_reason and the content block count are logged. Tuple results (content, history) are
     judged by their first element. Returns the last valid result, or the last empty result if every
     attempt was empty, or None if every attempt raised. `empty_model` is used only for the emptiness check.
+
+    If an empty result has stop_reason == 'max_tokens', the identical request is NOT resent: the next
+    attempt uses kwargs = adjust(kwargs, attempt) (default: _grow_request, which doubles max_tokens up
+    to MAX_OUTPUT_CAP and drops extended thinking). The parameters used for each attempt are logged.
     """
+    adjust = adjust or _grow_request
     last_resp = None
     for attempt in range(max_attempts):
+        logging(f"call_with_retry attempt {attempt + 1}/{max_attempts}: "
+                f"max_tokens={kwargs.get('max_tokens')}, thinking_budget={kwargs.get('thinking_budget')}")
         try:
             resp = fn(*args, **kwargs)
         except Exception as e:
             logging(f"LLM call failed (attempt {attempt + 1}/{max_attempts}): {e!r}")
+            resp = None
+            raised = True
         else:
+            raised = False
             judged = resp[0] if isinstance(resp, tuple) and resp else resp
             if not _is_empty_response(judged, model=empty_model or ''):
                 return resp
+            stop_reason = _stop_reason_of(resp)
             logging(
                 f"Empty LLM response (attempt {attempt + 1}/{max_attempts}): "
-                f"stop_reason={getattr(judged, 'stop_reason', None)}, "
+                f"stop_reason={stop_reason}, "
                 f"content_blocks={len(getattr(judged, 'content', None) or [])}"
             )
             last_resp = resp
         if attempt < max_attempts - 1:
+            if not raised and _stop_reason_of(last_resp) == 'max_tokens':
+                kwargs = adjust(kwargs, attempt)
+                logging(f"Empty max_tokens stop: retrying with changed params {kwargs.get('max_tokens')=}, "
+                        f"thinking_budget={kwargs.get('thinking_budget')}")
             time.sleep(2 ** attempt)
     return last_resp
 
