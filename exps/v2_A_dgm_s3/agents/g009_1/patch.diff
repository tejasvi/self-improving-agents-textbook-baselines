+def _describe_response(response, model=''):
+    """
+    Short human-readable summary of a response (stop reason and content block types/lengths),
+    used to diagnose empty turns.
+    """
+    try:
+        if isinstance(response, str):
+            return f"Response (str): length={len(response)}"
+        if 'claude' in model:
+            blocks = getattr(response, 'content', None) or []
+            parts = []
+            for block in blocks:
+                btype = getattr(block, 'type', None)
+                text = getattr(block, 'text', None)
+                if text is None and isinstance(block, dict):
+                    btype = block.get('type')
+                    text = block.get('text')
+                parts.append(f"{btype}(len={len(text) if text else 0})")
+            return f"Response: stop_reason={getattr(response, 'stop_reason', None)}, blocks=[{', '.join(parts)}]"
+        output = getattr(response, 'output', None) or []
+        types = [str(getattr(o, 'type', type(o).__name__)) for o in output]
+        text = getattr(response, 'output_text', '') or ''
+        return f"Response: status={getattr(response, 'status', None)}, output_types={types}, text_len={len(text)}"
+    except Exception as e:
+        return f"Response: could not be described ({e})"
+
