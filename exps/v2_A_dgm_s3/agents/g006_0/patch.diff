+def _first_text(response):
+    """Return content[0].text for Claude responses, raising a clear error if empty."""
+    content_blocks = getattr(response, "content", None) or []
+    if not content_blocks:
+        raise ValueError(f"LLM returned empty content. Raw response: {response!r}")
+    text = getattr(content_blocks[0], "text", None)
+    if text is None:
+        raise ValueError(f"LLM content[0] has no text. Raw response: {response!r}")
+    return text
+
+def _first_choice_message(response):
+    """Return choices[0].message, raising a clear error if choices are empty."""
+    choices = getattr(response, "choices", None) or []
+    if not choices:
+        raise ValueError(f"LLM returned no choices. Raw response: {response!r}")
+    return choices[0].message
+
