+    def _extract_samples(self):
+        """
+        Parse (input, expected_output) pairs from self.problem_statement.
+        Supports 'Sample Input N / Sample Output N' blocks and 'Input: ... Expected output: ...' blocks.
+        Returns a list of dicts with keys 'input' and 'output'.
+        """
+        text = self.problem_statement or ''
+        samples = []
+        pattern = re.compile(
+            r'Sample Input\s*\d*\s*\n(.*?)\n\s*Sample Output\s*\d*\s*\n(.*?)(?=\n\s*(?:Sample Input|Explanation|The answer|##|$))',
+            flags=re.DOTALL | re.IGNORECASE,
+        )
+        for m in pattern.finditer(text + '\n'):
+            inp, out = m.group(1).strip('\n'), m.group(2).strip()
+            if inp.strip() and out.strip():
+                samples.append({'input': inp.strip('\n') + '\n', 'output': out})
+        if not samples:
+            pattern2 = re.compile(
+                r'Input:\s*\n(.*?)\n\s*Expected output:\s*\n(.*?)(?=\n\s*(?:Input:|Explanation|##|$))',
+                flags=re.DOTALL | re.IGNORECASE,
+            )
+            for m in pattern2.finditer(text + '\n'):
+                inp, out = m.group(1).strip('\n'), m.group(2).strip()
+                if inp.strip() and out.strip():
+                    samples.append({'input': inp.strip('\n') + '\n', 'output': out})
+        return samples
+
+    def _run_samples(self):
+        """
+        Run the target solution file on each extracted sample and return a list of failure reports
+        (empty list when all samples pass or when no samples were found).
+        Problems whose solution is a `Solution` class method (no stdin use) are skipped.
+        """
+        samples = self._extract_samples()
+        if not samples:
+            return []
+        filename = self._infer_target_filename()
+        target = os.path.join(self.git_tempdir, filename)
+        if not os.path.isfile(target):
+            return [f"Target file {filename} does not exist. Create it with a complete implementation."]
+        try:
+            with open(target, 'r') as f:
+                code = f.read()
+        except Exception as e:
+            return [f"Could not read {filename}: {e}"]
+        if re.search(r'^\s*class\s+Solution\b', code, flags=re.MULTILINE) and not re.search(r'sys\.stdin|input\(', code):
+            return []
+
+        def norm(s):
+            return ' '.join((s or '').split())
+
+        failures = []
+        for idx, sample in enumerate(samples, 1):
+            try:
+                proc = subprocess.run(
+                    ['python3', filename],
+                    cwd=self.git_tempdir,
+                    input=sample['input'],
+                    timeout=10,
+                    capture_output=True,
+                    text=True,
+                )
+            except subprocess.TimeoutExpired:
+                failures.append(
+                    f"Sample {idx}: TIMEOUT (>10s)\nInput:\n{sample['input'][:500]}\n"
+                    f"Expected:\n{sample['output'][:500]}\nGot: (no output before timeout)"
+                )
+                continue
+            except Exception as e:
+                failures.append(f"Sample {idx}: could not run {filename}: {e}")
+                continue
+            if norm(proc.stdout) != norm(sample['output']):
+                stderr_tail = '\n'.join((proc.stderr or '').splitlines()[-15:])
+                failures.append(
+                    f"Sample {idx}: WRONG ANSWER\nInput:\n{sample['input'][:500]}\n"
+                    f"Expected:\n{sample['output'][:500]}\n"
+                    f"Got:\n{(proc.stdout or '')[:500]}\n"
+                    f"stderr tail:\n{stderr_tail}"
+                )
+        return failures
+
