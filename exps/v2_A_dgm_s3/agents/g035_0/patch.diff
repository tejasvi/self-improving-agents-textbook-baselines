diff --git a/tools/run_sample.py b/tools/run_sample.py
new file mode 100644
index 0000000..52f76b7
--- /dev/null
+++ b/tools/run_sample.py
@@ -0,0 +1,81 @@
+import subprocess
+
+MAX_STREAM_CHARS = 10000
+
+
+def tool_info():
+    return {
+        "name": "run_sample",
+        "description": """Run a command through the shell with an exact stdin text, the way a grader would.\n
+* Use it to run the solution on a sample input from the problem statement (static stdin, no custom simulator).\n
+* Returns a plain-text report: exit code, whether the run timed out, full stdout and full stderr (clipped if very long).\n
+* Nothing is parsed: inspect the exit code and stderr (tracebacks) yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "cmd": {
+                    "type": "string",
+                    "description": "Command to run, e.g. `python3 /work/repo/solution.py`. It receives stdin_text on standard input."
+                },
+                "stdin_text": {
+                    "type": "string",
+                    "description": "Exact stdin content to feed to the command (include trailing newline if the grader would)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Optional. Timeout in seconds before the command is killed. Default 10."
+                }
+            },
+            "required": ["cmd", "stdin_text"]
+        }
+    }
+
+
+def _clip(text):
+    if len(text) > MAX_STREAM_CHARS:
+        return text[:MAX_STREAM_CHARS] + "\n<response clipped>"
+    return text
+
+
+def tool_function(cmd=None, stdin_text=None, timeout=10, **kwargs):
+    if cmd is None:
+        return "Error: no cmd provided."
+    if stdin_text is None:
+        stdin_text = ""
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+    try:
+        proc = subprocess.run(
+            cmd,
+            shell=True,
+            input=stdin_text.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+        )
+        exit_code = proc.returncode
+        timed_out = False
+        stdout = proc.stdout.decode(errors='replace')
+        stderr = proc.stderr.decode(errors='replace')
+    except subprocess.TimeoutExpired as e:
+        exit_code = None
+        timed_out = True
+        stdout = (e.stdout or b'').decode(errors='replace')
+        stderr = (e.stderr or b'').decode(errors='replace')
+
+    return (
+        f"Exit code: {exit_code}\n"
+        f"Timed out: {timed_out}\n"
+        f"STDOUT:\n{_clip(stdout)}\n"
+        f"STDERR:\n{_clip(stderr)}"
+    )
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 2:
+        print("Usage: python run_sample.py '<cmd>' [stdin_text]")
+    else:
+        print(tool_function(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else ""))
