diff --git a/tools/run_candidates.py b/tools/run_candidates.py
new file mode 100644
index 0000000..572868b
--- /dev/null
+++ b/tools/run_candidates.py
@@ -0,0 +1,178 @@
+import glob
+import os
+import shlex
+import subprocess
+import tempfile
+import time
+
+def tool_info():
+    return {
+        "name": "run_candidates",
+        "description": """Run several candidate Python solution files against a test set and produce a score table.\n
+* Each candidate is run as `python3 <candidate>` with each test's input on stdin.\n
+* Tests come from `tests_dir` (every *.in file; the expected answer is the matching *.out file if present). If tests_dir is empty or missing, the tool returns an error message.\n
+* If `checker_cmd` is given it is run as `<checker_cmd> <input_file> <candidate_output_file> <expected_output_file>` (exit code 0 = accept). Without a checker, outputs are compared after stripping whitespace; if no *.out exists the run is only judged on exit code and timing.\n
+* Each run is limited by `time_limit` seconds; over-time runs are recorded as timeouts.\n
+* Returns a plain-text table (passed / failed / timeout / max runtime per candidate, ranked best first), followed by the first few failing cases per candidate with raw input and output. Errors are not parsed; raw text is returned.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "candidates": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of paths to candidate Python solution files."
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Directory containing *.in test inputs and optional matching *.out expected outputs."
+                },
+                "checker_cmd": {
+                    "type": "string",
+                    "description": "Optional. Checker command invoked as `<checker_cmd> <input_file> <candidate_output_file> <expected_output_file>`; exit code 0 accepts. Use it for problems with multiple valid answers."
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Per-test time limit in seconds for each candidate run. Default 5."
+                }
+            },
+            "required": ["candidates", "tests_dir"]
+        }
+    }
+
+MAX_SHOWN_FAILURES = 3
+MAX_TEXT_CHARS = 1500
+
+def _clip(text):
+    if len(text) <= MAX_TEXT_CHARS:
+        return text
+    return text[:MAX_TEXT_CHARS] + f"\n...[clipped {len(text) - MAX_TEXT_CHARS} chars]"
+
+def _run_candidate(candidate, input_text, time_limit):
+    """Returns (status, stdout, stderr, elapsed) where status is ok/error/timeout."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", candidate], input=input_text, capture_output=True, text=True,
+            timeout=time_limit,
+        )
+    except subprocess.TimeoutExpired:
+        return "timeout", "", f"TIMEOUT after {time_limit}s", time.time() - start
+    elapsed = time.time() - start
+    if proc.returncode != 0:
+        return "error", proc.stdout, f"[exit code {proc.returncode}] {proc.stderr}", elapsed
+    return "ok", proc.stdout, proc.stderr, elapsed
+
+def _check(checker_cmd, input_text, cand_out, expected_out, tmp):
+    """Returns (accepted, message)."""
+    paths = []
+    for name, text in (("input.txt", input_text), ("cand_out.txt", cand_out), ("expected_out.txt", expected_out)):
+        p = os.path.join(tmp, name)
+        with open(p, "w") as fh:
+            fh.write(text)
+        paths.append(p)
+    cmd = f"{checker_cmd} {shlex.quote(paths[0])} {shlex.quote(paths[1])} {shlex.quote(paths[2])}"
+    try:
+        proc = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60)
+    except subprocess.TimeoutExpired:
+        return False, "checker timed out"
+    msg = (proc.stdout + proc.stderr).strip()
+    return proc.returncode == 0, f"checker exit {proc.returncode}: {msg}"
+
+def _score_candidate(candidate, tests, checker_cmd, time_limit, tmp):
+    passed = failed = timeouts = 0
+    max_time = 0.0
+    failures = []
+    for in_path, out_path in tests:
+        with open(in_path, "r") as fh:
+            input_text = fh.read()
+        expected = None
+        if out_path is not None:
+            with open(out_path, "r") as fh:
+                expected = fh.read()
+        status, stdout, stderr, elapsed = _run_candidate(candidate, input_text, time_limit)
+        max_time = max(max_time, elapsed)
+        if status == "timeout":
+            timeouts += 1
+            failures.append((os.path.basename(in_path), input_text, stdout, stderr))
+            continue
+        ok = status == "ok"
+        reason = stderr if status == "error" else ""
+        if ok and checker_cmd:
+            ok, msg = _check(checker_cmd, input_text, stdout, expected or "", tmp)
+            if not ok:
+                reason = msg
+        elif ok and expected is not None:
+            ok = stdout.strip() == expected.strip()
+            if not ok:
+                reason = "output differs from expected"
+        if ok:
+            passed += 1
+        else:
+            failed += 1
+            failures.append((os.path.basename(in_path), input_text, stdout, reason))
+    return {
+        "candidate": candidate,
+        "passed": passed,
+        "failed": failed,
+        "timeouts": timeouts,
+        "max_time": max_time,
+        "failures": failures,
+        "total": len(tests),
+    }
+
+def tool_function(candidates, tests_dir: str, checker_cmd: str = None, time_limit: float = 5.0) -> str:
+    if isinstance(candidates, str):
+        candidates = [candidates]
+    if not candidates:
+        return "Error: no candidates given."
+    if not tests_dir or not os.path.isdir(tests_dir):
+        return f"Error: tests_dir {tests_dir!r} is not a directory."
+    try:
+        time_limit = float(time_limit) if time_limit is not None else 5.0
+    except (TypeError, ValueError):
+        time_limit = 5.0
+
+    in_files = sorted(glob.glob(os.path.join(tests_dir, "*.in")))
+    if not in_files:
+        return f"Error: no *.in files found in {tests_dir}."
+    tests = []
+    for in_path in in_files:
+        out_path = in_path[:-3] + ".out"
+        tests.append((in_path, out_path if os.path.isfile(out_path) else None))
+
+    results = []
+    with tempfile.TemporaryDirectory() as tmp:
+        for cand in candidates:
+            if not os.path.isfile(cand):
+                results.append({"candidate": cand, "passed": 0, "failed": len(tests), "timeouts": 0,
+                                "max_time": 0.0, "failures": [], "total": len(tests),
+                                "missing": True})
+                continue
+            results.append(_score_candidate(cand, tests, checker_cmd, time_limit, tmp))
+
+    # Rank: most passed first, then fastest max runtime.
+    ranked = sorted(results, key=lambda r: (-r["passed"], r["max_time"]))
+    lines = [
+        f"Score table ({len(tests)} tests, time_limit={time_limit}s, checker={'yes' if checker_cmd else 'no'}):",
+        f"{'rank':<5}{'candidate':<40}{'passed':>8}{'failed':>8}{'timeout':>9}{'max_time(s)':>13}",
+    ]
+    for rank, r in enumerate(ranked, 1):
+        name = r["candidate"] + (" [MISSING]" if r.get("missing") else "")
+        lines.append(
+            f"{rank:<5}{name[:39]:<40}{str(r['passed']) + '/' + str(r['total']):>8}"
+            f"{r['failed']:>8}{r['timeouts']:>9}{r['max_time']:>13.3f}"
+        )
+    lines.append("")
+    for r in ranked:
+        if not r["failures"]:
+            continue
+        lines.append(f"=== Failures for {r['candidate']} (showing up to {MAX_SHOWN_FAILURES}) ===")
+        for name, inp, out, reason in r["failures"][:MAX_SHOWN_FAILURES]:
+            lines.append(f"--- test {name} ---")
+            lines.append(f"input:\n{_clip(inp)}")
+            lines.append(f"output:\n{_clip(out)}")
+            lines.append(f"stderr/reason:\n{_clip(reason or '')}")
+    return "\n".join(lines)
+
+if __name__ == "__main__":
+    print(tool_function(["/bin/cat"], "/tmp", None, 1))
