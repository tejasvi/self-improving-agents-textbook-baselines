+    def _changed_files(self):
+        """
+        Return the list of file paths changed versus the base commit (including untracked files),
+        parsed from the `diff --git a/X b/X` header lines of the diff.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.+?) b/(.+)$', line)
+            if m:
+                path = m.group(2)
+                if path not in files:
+                    files.append(path)
+        return files
+
+    def _is_test_path(self, path):
+        """
+        Heuristically decide whether a path refers to a test file.
+        """
+        parts = [p for p in re.split(r'[\\/]+', path) if p]
+        if not parts:
+            return False
+        dirs, basename = parts[:-1], parts[-1]
+        for d in dirs:
+            if re.fullmatch(r'(test|tests|spec|specs|__tests__)', d, flags=re.IGNORECASE):
+                return True
+        name_patterns = [
+            r'conftest\.py',
+            r'test_.*',
+            r'.*_test\..*',
+            r'.*\.test\..*',
+            r'.*\.spec\..*',
+            r'.*_spec\..*',
+            r'(test|tests|spec)\..*',
+        ]
+        return any(re.fullmatch(p, basename, flags=re.IGNORECASE) for p in name_patterns)
+
+    def _last_assistant_is_empty(self, msg_history):
+        """
+        Best-effort check whether the final assistant message has no text and no tool call.
+        Returns False when the format is not recognized.
+        """
+        if not msg_history:
+            return False
+        last = msg_history[-1]
+        if not isinstance(last, dict) or last.get('role') != 'assistant':
+            return False
+        content = last.get('content')
+        if content is None or content == '':
+            return True
+        if isinstance(content, str):
+            return content.strip() == ''
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict):
+                    if block.get('type') in ('tool_use', 'function_call', 'tool_call'):
+                        return False
+                    if block.get('type') == 'text' and str(block.get('text') or '').strip():
+                        return False
+                elif hasattr(block, 'text') and str(getattr(block, 'text') or '').strip():
+                    return False
+                elif hasattr(block, 'type') and getattr(block, 'type') in ('tool_use', 'function_call'):
+                    return False
+            return True
+        return False
