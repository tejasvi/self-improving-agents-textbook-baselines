+TOKEN_ESCALATION = [4096, 8192, 16384, 32000]
+# Claude 3.x models cap output at 8192 tokens; larger requests are rejected by the API.
+CLAUDE_3_5_OUTPUT_CAP = 8192
+THINKING_BUDGET_FLOOR = 1024
+
+
+def _max_tokens_cap(model: str) -> int:
+    """Upper bound on max_tokens for a model (bounded by the model's output limit)."""
+    if "claude-3-" in model or "claude-3." in model:
+        return CLAUDE_3_5_OUTPUT_CAP
+    return TOKEN_ESCALATION[-1]
+
+
+def _has_text_or_tool_block(response) -> bool:
+    """True if the response has a non-empty text block or a tool_use block."""
+    for block in (getattr(response, "content", None) or []):
+        if getattr(block, "type", None) == "tool_use":
+            return True
+        if (getattr(block, "text", None) or "").strip():
+            return True
+    return False
+
+
+def _extract_text(response) -> str:
+    """First non-empty text block of a Claude response, or '' when there is none."""
+    blocks = getattr(response, "content", None) or []
+    return next((b.text for b in blocks if getattr(b, "text", None)), "")
+
+
+def _log_response(response, max_tokens, log=print):
+    usage = getattr(response, "usage", None)
+    output_tokens = getattr(usage, "output_tokens", None)
+    log(
+        f"LLM response: stop_reason={getattr(response, 'stop_reason', None)}, "
+        f"max_tokens={max_tokens}, output_tokens={output_tokens}, usage={usage}"
+    )
+
+
+def _call_with_token_escalation(create_fn, max_tokens_list=(4096, 8192, 16384, 32000), log=print, **kwargs):
+    """
+    Call create_fn(max_tokens=..., **kwargs) (kwargs include model=...). If the response was cut
+    off at max_tokens with no text/tool_use content, retry the same request with the next larger
+    max_tokens (bounded by the model cap). When extended thinking is enabled, the thinking budget
+    is reduced on each retry so that it stays below max_tokens. Never loops unboundedly.
+    """
+    cap = _max_tokens_cap(str(kwargs.get("model", "")))
+    budgets = [t for t in max_tokens_list if t <= cap] or [min(max_tokens_list[0], cap)]
+    response = None
+    for idx, max_tokens in enumerate(budgets):
+        call_kwargs = dict(kwargs)
+        thinking = call_kwargs.get("thinking")
+        if isinstance(thinking, dict) and thinking.get("type") == "enabled":
+            # Keep thinking strictly below max_tokens; halve it on each escalation.
+            budget = max(THINKING_BUDGET_FLOOR, min(thinking.get("budget_tokens", max_tokens // 2), max_tokens // 2))
+            call_kwargs["thinking"] = {"type": "enabled", "budget_tokens": budget}
+        response = create_fn(max_tokens=max_tokens, **call_kwargs)
+        _log_response(response, max_tokens, log=log)
+        if getattr(response, "stop_reason", None) != "max_tokens" or _has_text_or_tool_block(response):
+            return response
+        if idx + 1 < len(budgets):
+            log(f"Empty response at max_tokens={max_tokens}; retrying with max_tokens={budgets[idx + 1]}.")
+        else:
+            log(f"Empty response at max_tokens={max_tokens}; token budget exhausted.")
+    return response
+
+
