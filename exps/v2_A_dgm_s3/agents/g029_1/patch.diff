diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..73d906f
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,172 @@
+import os
+import resource
+import signal
+import subprocess
+import tempfile
+import time
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Time a command on a large input and report CPU time and wall time.\n
+* Input comes from `input_file` (if given) or from the stdout of `generator_cmd` (run with no arguments).\n
+* `time_limit_sec` is the CPU-time limit. The process is killed only after about 3x that many seconds of wall time, so host load does not cause false failures.\n
+* Output reports CPU time, wall time, the load average, and a truncated tail of stdout/stderr.\n
+* On TIMEOUT the output says so; if the machine is also heavily loaded it recommends retrying.\n
+* Use it to check that a solution meets the time limit on max-size and adversarial inputs.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "cmd": {
+                    "type": "string",
+                    "description": "Shell command of the solution to benchmark; reads the input on stdin."
+                },
+                "input_file": {
+                    "type": "string",
+                    "description": "Optional path to a file whose contents are fed to the command on stdin."
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Optional shell command that prints the test input on stdout (used when input_file is not given)."
+                },
+                "time_limit_sec": {
+                    "type": "number",
+                    "description": "CPU-time limit in seconds for the command (default 10)."
+                },
+                "repeats": {
+                    "type": "integer",
+                    "description": "Number of timed runs (default 1). The worst run is reported."
+                }
+            },
+            "required": ["cmd"]
+        }
+    }
+
+OUTPUT_TAIL_CHARS = 2000
+RESULT_CHARS = 4000
+
+def _tail(text, limit=OUTPUT_TAIL_CHARS):
+    if not text:
+        return ""
+    if len(text) <= limit:
+        return text
+    return "...(truncated)...\n" + text[-limit:]
+
+def _load_avg():
+    try:
+        return os.getloadavg()[0]
+    except (AttributeError, OSError):
+        return None
+
+def _make_input(input_file, generator_cmd):
+    """Return (stdin_bytes, error). Reads input_file or runs the generator."""
+    if input_file:
+        if not os.path.isfile(input_file):
+            return None, f"Error: input_file not found: {input_file}"
+        with open(input_file, 'rb') as fh:
+            return fh.read(), None
+    if generator_cmd:
+        try:
+            gen = subprocess.run(generator_cmd, shell=True, capture_output=True, timeout=600)
+        except subprocess.TimeoutExpired:
+            return None, "Error: generator_cmd timed out after 600s"
+        if gen.returncode != 0:
+            return None, f"Error: generator_cmd failed (exit {gen.returncode}): {gen.stderr.decode(errors='replace')[-1000:]}"
+        return gen.stdout, None
+    return b"", None
+
+def _run_once(cmd, stdin_bytes, time_limit_sec):
+    """Run cmd once. CPU time comes from the RUSAGE_CHILDREN delta around the run."""
+    wall_limit = 3.0 * float(time_limit_sec) + 1.0
+    with tempfile.TemporaryFile() as fin, tempfile.TemporaryFile() as fout, tempfile.TemporaryFile() as ferr:
+        fin.write(stdin_bytes)
+        fin.seek(0)
+        before = resource.getrusage(resource.RUSAGE_CHILDREN)
+        start = time.monotonic()
+        proc = subprocess.Popen(cmd, shell=True, stdin=fin, stdout=fout, stderr=ferr,
+                                start_new_session=True)
+        timed_out = False
+        rc = None
+        try:
+            # Wall-clock kill at ~3x the CPU limit so host load does not cause false failures.
+            rc = proc.wait(timeout=wall_limit)
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            _kill_tree(proc)
+            proc.wait()
+        wall = time.monotonic() - start
+        after = resource.getrusage(resource.RUSAGE_CHILDREN)
+        cpu = (after.ru_utime - before.ru_utime) + (after.ru_stime - before.ru_stime)
+        fout.seek(0)
+        ferr.seek(0)
+        out = fout.read().decode(errors='replace')
+        err = ferr.read().decode(errors='replace')
+        return {"cpu": cpu, "wall": wall, "timed_out": timed_out, "rc": rc,
+                "stdout": out, "stderr": err, "cpu_limit": time_limit_sec, "wall_limit": wall_limit}
+
+def _kill_tree(proc):
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError, OSError):
+        try:
+            proc.kill()
+        except ProcessLookupError:
+            pass
+
+def tool_function(cmd, input_file=None, generator_cmd=None, time_limit_sec=10, repeats=1, **kwargs):
+    try:
+        time_limit_sec = float(time_limit_sec)
+        repeats = int(repeats)
+    except (TypeError, ValueError):
+        return "Error: time_limit_sec must be a number and repeats an integer."
+    if time_limit_sec <= 0:
+        return "Error: time_limit_sec must be positive."
+    if repeats <= 0:
+        return "Error: repeats must be positive."
+    if not cmd:
+        return "Error: no cmd provided."
+
+    stdin_bytes, err = _make_input(input_file, generator_cmd)
+    if err:
+        return err
+
+    load_before = _load_avg()
+    runs = []
+    for _ in range(repeats):
+        runs.append(_run_once(cmd, stdin_bytes, time_limit_sec))
+    load_after = _load_avg()
+    load = max(x for x in [load_before, load_after] if x is not None) if (load_before or load_after) else None
+    load_txt = f"load avg (1 min)={load:.2f}" if load is not None else "load avg unavailable"
+
+    timeouts = [r for r in runs if r["timed_out"]]
+    if timeouts:
+        r = timeouts[0]
+        msg = (f"TIMEOUT: exceeded {time_limit_sec:g} s CPU/wall (killed after {r['wall']:.1f} s wall). "
+               f"{load_txt}.")
+        if load is not None and load >= (os.cpu_count() or 1):
+            msg += (" Machine load is high and a timeout was observed: this may be host load; "
+                    "retry the benchmark once before changing the algorithm.")
+        out_tail = _tail(r["stdout"], 500)
+        err_tail = _tail(r["stderr"], 500)
+        if out_tail:
+            msg += f"\n--- partial stdout (tail) ---\n{out_tail}"
+        if err_tail:
+            msg += f"\n--- partial stderr (tail) ---\n{err_tail}"
+        return msg[:RESULT_CHARS]
+
+    worst = max(runs, key=lambda r: r["cpu"])
+    lines = [
+        f"OK: CPU {worst['cpu']:.3f} s (limit {time_limit_sec:g} s), wall {worst['wall']:.3f} s, "
+        f"runs={repeats}, {load_txt}.",
+    ]
+    if worst["rc"] != 0:
+        lines.append(f"Exit code {worst['rc']}.")
+    if worst["cpu"] > time_limit_sec:
+        lines.append(f"WARNING: CPU time exceeds the limit of {time_limit_sec:g} s.")
+    lines.append(f"--- stdout (truncated) ---\n{_tail(worst['stdout'])}")
+    if worst["stderr"].strip():
+        lines.append(f"--- stderr (truncated) ---\n{_tail(worst['stderr'])}")
+    return "\n".join(lines)[:RESULT_CHARS]
+
+if __name__ == "__main__":
+    print(tool_function("cat", input_file=None, generator_cmd="echo 1 2 3", time_limit_sec=5))
