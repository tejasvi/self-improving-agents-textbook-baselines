+import difflib
+import os
+import subprocess
+import sys
+import time
+
+MAX_SHOW_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution the way a grader does: each case's input is fed via stdin (not as arguments), and stdout is captured.
+
+* Use it on every sample example from the problem statement (and any static-input test you create) to check the solution with the same stdin/stdout path the hidden tests use.
+* For each case it returns the raw stdout, stderr, exit code and runtime, plus a PASS/FAIL/NO-EXPECTED status. When `expected_output` is given, the comparison is whitespace-insensitive token comparison and a unified diff is shown on mismatch.
+* A traceback in stderr or a non-zero exit code is a failure that must be fixed, even if stdout looks right.
+* Python solutions (.py) are run with the current Python interpreter; other paths are executed directly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program (reads stdin, writes stdout)."
+                },
+                "cases": {
+                    "type": "array",
+                    "description": "List of test cases to run. Each item is an object with 'input' (string fed to stdin) and optional 'expected_output' (string to compare stdout against).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's stdin."
+                            },
+                            "expected_output": {
+                                "type": "string",
+                                "description": "Optional. Expected stdout for this input."
+                            }
+                        },
+                        "required": ["input"]
+                    }
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each case. Default 10."
+                }
+            },
+            "required": ["solution_path", "cases"]
+        }
+    }
+
+
+def _command(path):
+    if path.endswith(".py"):
+        return [sys.executable, path]
+    return [path]
+
+
+def _truncate(text, limit=MAX_SHOW_CHARS):
+    if text is None:
+        return ""
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... (truncated, {len(text) - limit} more chars)"
+
+
+def _run_one(solution_path, stdin_text, timeout_sec):
+    """Returns (returncode or None on timeout, stdout, stderr, elapsed_seconds)."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            _command(solution_path),
+            input=stdin_text.encode(),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout_sec,
+            check=False,
+        )
+        elapsed = time.time() - start
+        return proc.returncode, proc.stdout.decode(errors="replace"), proc.stderr.decode(errors="replace"), elapsed
+    except subprocess.TimeoutExpired as e:
+        elapsed = time.time() - start
+        out = e.stdout.decode(errors="replace") if e.stdout else ""
+        err = e.stderr.decode(errors="replace") if e.stderr else ""
+        return None, out, err, elapsed
+
+
+def _same_tokens(a, b):
+    return a.split() == b.split()
+
+
+def tool_function(solution_path, cases, timeout_sec=10):
+    if not isinstance(cases, list) or not cases:
+        return "Error: 'cases' must be a non-empty list of {input, expected_output} objects."
+    try:
+        timeout_sec = float(timeout_sec) if timeout_sec is not None else 10.0
+    except (TypeError, ValueError):
+        timeout_sec = 10.0
+
+    if not os.path.exists(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    sections = []
+    passed = 0
+    failed = 0
+    for idx, case in enumerate(cases):
+        if not isinstance(case, dict) or "input" not in case:
+            sections.append(f"=== Case {idx + 1}: FAIL (malformed case; needs an 'input' key) ===")
+            failed += 1
+            continue
+        stdin_text = str(case.get("input", ""))
+        expected = case.get("expected_output")
+        rc, out, err, elapsed = _run_one(solution_path, stdin_text, timeout_sec)
+
+        lines = [f"=== Case {idx + 1} ==="]
+        lines.append(f"exit code: {rc if rc is not None else 'TIMEOUT'}")
+        lines.append(f"runtime: {elapsed:.3f}s")
+        lines.append(f"stdout:\n{_truncate(out)}")
+        lines.append(f"stderr:\n{_truncate(err)}")
+
+        if rc is None:
+            status = "FAIL (timeout)"
+        elif rc != 0 or "Traceback" in err:
+            status = "FAIL (runtime error: non-zero exit code or traceback)"
+        elif expected is None:
+            status = "NO-EXPECTED (not compared)"
+        elif _same_tokens(out, str(expected)):
+            status = "PASS"
+        else:
+            status = "FAIL (output mismatch)"
+            diff = difflib.unified_diff(
+                str(expected).splitlines(),
+                out.splitlines(),
+                fromfile="expected",
+                tofile="actual",
+                lineterm="",
+            )
+            lines.append("diff (expected -> actual):\n" + _truncate("\n".join(diff)))
+
+        if status.startswith("FAIL"):
+            failed += 1
+        elif status == "PASS":
+            passed += 1
+        lines.insert(1, f"status: {status}")
+        sections.append("\n".join(lines))
+
+    summary = f"Summary: {passed} passed, {failed} failed, {len(cases)} total."
+    return "\n\n".join(sections) + "\n\n" + summary
