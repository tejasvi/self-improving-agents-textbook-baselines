+"""
+Tool for evaluating a competitive programming solution.
+Runs samples, stress tests, and a max-size benchmark.
+Returns raw output plus a final machine-readable SCORE line.
+"""
+
+import os
+import time
+import glob
+import tempfile
+import subprocess
+from pathlib import Path
+
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "evaluate_solution",
+        "description": """Evaluate a solution against samples, stress tests, and max-size benchmark.
+Runs samples, stress tests against brute force, and a max-size benchmark.
+Returns raw output plus a final machine-readable line: SCORE samples=X/Y stress=A/B timeouts=T max_time=M.Z
+Inputs: solution_path, tests_dir (containing samples/, brute.py, generator.py with generator_input(n,seed)).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to evaluate (Python script)"
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Path to the tests directory (containing samples/, brute.py, generator.py)"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test in seconds (default 5)"
+                }
+            },
+            "required": ["solution_path", "tests_dir"]
+        }
+    }
+
+
+def _normalize_output(output):
+    """Normalize whitespace for comparison."""
+    return '\n'.join(line.rstrip() for line in output.strip().split('\n')).strip()
+
+
+def _run_solution_on_input(solution_path, test_input, timeout_sec):
+    """
+    Run a solution on a single test input via subprocess.
+    Returns (elapsed_time_sec, output, is_timeout, error_msg)
+    """
+    try:
+        abs_path = os.path.abspath(solution_path)
+        if not os.path.isfile(abs_path):
+            return 0, "", False, f"Solution file not found: {abs_path}"
+        
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {abs_path}",
+            timeout_seconds=timeout_sec,
+            cwd=os.path.dirname(abs_path),
+            input_data=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        if returncode == -1 and "TIMEOUT" in stderr:
+            return elapsed, stdout, True, stderr
+        elif returncode != 0:
+            error_msg = stderr if stderr else f"Exit code {returncode}"
+            return elapsed, stdout, False, error_msg
+        else:
+            return elapsed, stdout, False, ""
+    
+    except Exception as e:
+        return 0, "", False, f"Error running solution: {str(e)}"
+
+
+def _generate_input(generator_path, test_index, max_n=None):
+    """
+    Generate a single test input using generator_input(n, seed).
+    """
+    if not os.path.isfile(generator_path):
+        return None, f"Generator file not found: {generator_path}"
+    
+    try:
+        with open(generator_path, 'r') as f:
+            generator_code = f.read()
+    except Exception as e:
+        return None, f"Failed to read generator file: {str(e)}"
+    
+    # Determine n
+    if max_n is not None:
+        n = max_n
+    else:
+        n = test_index + 1
+    
+    # Execute the generator code
+    gen_namespace = {}
+    try:
+        exec(generator_code, gen_namespace)
+    except Exception as e:
+        return None, f"Failed to execute generator code: {str(e)}"
+    
+    if 'generator_input' not in gen_namespace:
+        return None, "Generator code must define generator_input(n, seed) function"
+    
+    generator_func = gen_namespace['generator_input']
+    
+    try:
+        test_input = generator_func(n, test_index)
+        return test_input, None
+    except Exception as e:
+        return None, f"Generator error: {str(e)}"
+
+
+def tool_function(solution_path, tests_dir, timeout=5):
+    """
+    Evaluate the solution by running samples, stress tests, and max-size benchmark.
+    Returns raw output plus a final SCORE line.
+    """
+    
+    results = []
+    
+    # Validate inputs
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found at {solution_path}"
+    
+    if not os.path.isdir(tests_dir):
+        return f"Error: tests directory not found at {tests_dir}"
+    
+    samples_dir = os.path.join(tests_dir, "samples")
+    brute_path = os.path.join(tests_dir, "brute.py")
+    generator_path = os.path.join(tests_dir, "generator.py")
+    
+    samples_passed = 0
+    samples_total = 0
+    stress_passed = 0
+    stress_total = 0
+    timeout_count = 0
+    max_time = 0.0
+    
+    # === SAMPLES TEST ===
+    results.append("\n=== RUNNING SAMPLES ===\n")
+    
+    if os.path.isdir(samples_dir):
+        in_files = sorted(glob.glob(os.path.join(samples_dir, "sample_*.in")))
+        
+        if in_files:
+            samples_total = len(in_files)
+            for in_file in in_files:
+                base_name = os.path.basename(in_file)
+                out_file = os.path.join(samples_dir, base_name.replace('.in', '.out'))
+                
+                if not os.path.isfile(out_file):
+                    results.append(f"{base_name}: SKIP (no matching .out file)\n")
+                    continue
+                
+                with open(in_file, 'r') as f:
+                    test_input = f.read()
+                
+                with open(out_file, 'r') as f:
+                    expected_output = f.read()
+                
+                elapsed, stdout, is_timeout, error = _run_solution_on_input(solution_path, test_input, timeout)
+                max_time = max(max_time, elapsed)
+                
+                expected_normalized = _normalize_output(expected_output)
+                actual_normalized = _normalize_output(stdout)
+                
+                if is_timeout:
+                    results.append(f"{base_name}: TIMEOUT\n")
+                    timeout_count += 1
+                elif expected_normalized == actual_normalized:
+                    results.append(f"{base_name}: PASS ({elapsed:.2f}s)\n")
+                    samples_passed += 1
+                else:
+                    results.append(f"{base_name}: FAIL ({elapsed:.2f}s)\n")
+        else:
+            results.append(f"No sample files found in {samples_dir}\n")
+            samples_total = 0
+    else:
+        results.append(f"Samples directory not found at {samples_dir}\n")
+        samples_total = 0
+    
+    # === STRESS TEST ===
+    results.append("\n=== RUNNING STRESS TESTS ===\n")
+    
+    if os.path.isfile(brute_path) and os.path.isfile(generator_path):
+        num_tests = 10  # Run 10 stress tests
+        stress_total = num_tests
+        
+        for test_idx in range(num_tests):
+            # Generate test input
+            test_input, gen_error = _generate_input(generator_path, test_idx, max_n=None)
+            if gen_error:
+                results.append(f"Test {test_idx + 1}: GENERATOR ERROR\n")
+                continue
+            
+            # Run solution
+            sol_elapsed, sol_output, sol_timeout, sol_error = _run_solution_on_input(solution_path, test_input, timeout)
+            max_time = max(max_time, sol_elapsed)
+            
+            # Run brute force
+            brute_elapsed, brute_output, brute_timeout, brute_error = _run_solution_on_input(brute_path, test_input, timeout)
+            
+            # Compare
+            if sol_timeout:
+                results.append(f"Test {test_idx + 1}: SOLUTION TIMEOUT\n")
+                timeout_count += 1
+            elif brute_timeout:
+                results.append(f"Test {test_idx + 1}: BRUTE TIMEOUT (solution={sol_elapsed:.2f}s)\n")
+            elif sol_output.strip() == brute_output.strip():
+                results.append(f"Test {test_idx + 1}: PASS\n")
+                stress_passed += 1
+            else:
+                results.append(f"Test {test_idx + 1}: MISMATCH\n")
+    else:
+        results.append(f"Brute or generator not found; skipping stress tests\n")
+        stress_total = 0
+    
+    # === MAX-SIZE BENCHMARK ===
+    results.append("\n=== MAX-SIZE BENCHMARK ===\n")
+    
+    if os.path.isfile(generator_path):
+        # Try to extract max_n from a max_n.txt file in tests_dir
+        max_n_file = os.path.join(tests_dir, "max_n.txt")
+        max_n = None
+        if os.path.isfile(max_n_file):
+            try:
+                with open(max_n_file, 'r') as f:
+                    max_n = int(f.read().strip())
+            except:
+                pass
+        
+        if max_n is not None:
+            # Generate max-size input
+            test_input, gen_error = _generate_input(generator_path, 0, max_n=max_n)
+            if gen_error:
+                results.append(f"Max-size benchmark: generator error\n")
+            else:
+                elapsed, output, is_timeout, error = _run_solution_on_input(solution_path, test_input, timeout)
+                max_time = max(max_time, elapsed)
+                
+                if is_timeout:
+                    results.append(f"Max-size (n={max_n}): TIMEOUT (>= {timeout}s)\n")
+                    timeout_count += 1
+                else:
+                    results.append(f"Max-size (n={max_n}): {elapsed:.2f}s\n")
+        else:
+            results.append(f"Max-size benchmark: max_n not specified\n")
+    else:
+        results.append(f"Generator not found; skipping max-size benchmark\n")
+    
+    # === FINAL SCORE LINE ===
+    # Format: SCORE samples=X/Y stress=A/B timeouts=T max_time=M.Z
+    samples_str = f"{samples_passed}/{samples_total}" if samples_total > 0 else "0/0"
+    stress_str = f"{stress_passed}/{stress_total}" if stress_total > 0 else "0/0"
+    
+    score_line = f"SCORE samples={samples_str} stress={stress_str} timeouts={timeout_count} max_time={max_time:.1f}"
+    
+    results.append(f"\n{score_line}\n")
+    
+    return "".join(results)
+
+
+if __name__ == "__main__":
+    import sys
+    
+    if len(sys.argv) < 3:
+        print("Usage: python evaluate_solution.py <solution_path> <tests_dir> [timeout]")
+    else:
+        solution_path = sys.argv[1]
+        tests_dir = sys.argv[2]
+        timeout = int(sys.argv[3]) if len(sys.argv) > 3 else 5
+        
+        result = tool_function(solution_path, tests_dir, timeout)
+        print(result)
