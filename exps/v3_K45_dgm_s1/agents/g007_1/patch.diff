+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Run differential testing between a solution and reference implementation.
+For each test case generated by generator_cmd, runs both solution_cmd and reference_cmd with a timeout,
+compares whitespace-normalized outputs, and reports results. On first mismatch or timeout, returns
+the raw input, both outputs, and stderr. If all pass, returns a summary with max runtime observed.
+Does not parse errors - returns raw output for the agent to analyze.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Command to run the solution (e.g., 'python solution.py')"
+                },
+                "reference_cmd": {
+                    "type": "string",
+                    "description": "Command to run the reference/brute force implementation (e.g., 'python brute_force.py')"
+                },
+                "generator_cmd": {
+                    "type": "string",
+                    "description": "Command to generate test input, takes a seed argument (e.g., 'python gen.py {seed}' or 'python gen.py')"
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of test cases to run (default: 200)"
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout per test case in seconds (default: 5)"
+                }
+            },
+            "required": ["solution_cmd", "reference_cmd", "generator_cmd"]
+        }
+    }
+
+def tool_function(solution_cmd, reference_cmd, generator_cmd, num_tests=200, timeout_seconds=5):
+    """
+    Run stress test comparing solution against reference implementation.
+    
+    Args:
+        solution_cmd: Command to run solution
+        reference_cmd: Command to run reference implementation
+        generator_cmd: Command to generate test input with {seed} placeholder or expects seed as arg
+        num_tests: Number of tests to run
+        timeout_seconds: Timeout per test in seconds
+    
+    Returns:
+        String with results: either summary of all passes, or details of first failure
+    """
+    results = {
+        'total_tests': 0,
+        'passed': 0,
+        'failed': False,
+        'max_runtime': 0.0,
+        'failure_details': None
+    }
+    
+    # Run bounded loop (for loop, not while True)
+    for seed in range(num_tests):
+        results['total_tests'] += 1
+        
+        # Generate test input
+        try:
+            # Check if {seed} placeholder exists
+            if '{seed}' in generator_cmd:
+                gen_cmd = generator_cmd.format(seed=seed)
+            else:
+                # Append seed as argument
+                gen_cmd = f"{generator_cmd} {seed}"
+        except (IndexError, KeyError) as e:
+            results['failure_details'] = {
+                'seed': seed,
+                'type': 'generator_cmd_format_error',
+                'message': f'Failed to format generator command: {str(e)}'
+            }
+            results['failed'] = True
+            break
+        
+        try:
+            gen_result = subprocess.run(
+                gen_cmd,
+                shell=True,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            
+            if gen_result.returncode != 0:
+                results['failure_details'] = {
+                    'seed': seed,
+                    'type': 'generator_error',
+                    'gen_stderr': gen_result.stderr,
+                    'gen_stdout': gen_result.stdout
+                }
+                results['failed'] = True
+                break
+            
+            test_input = gen_result.stdout
+            
+        except subprocess.TimeoutExpired:
+            results['failure_details'] = {
+                'seed': seed,
+                'type': 'generator_timeout',
+                'message': f'Generator timed out after {timeout_seconds}s'
+            }
+            results['failed'] = True
+            break
+        except Exception as e:
+            results['failure_details'] = {
+                'seed': seed,
+                'type': 'generator_exception',
+                'message': str(e)
+            }
+            results['failed'] = True
+            break
+        
+        # Run solution
+        solution_output = None
+        solution_stderr = None
+        solution_timeout = False
+        solution_time = 0.0
+        
+        try:
+            start_time = time.time()
+            sol_result = subprocess.run(
+                solution_cmd,
+                input=test_input,
+                shell=True,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            solution_time = time.time() - start_time
+            results['max_runtime'] = max(results['max_runtime'], solution_time)
+            
+            if sol_result.returncode == 0:
+                solution_output = sol_result.stdout
+            else:
+                solution_stderr = sol_result.stderr
+                
+        except subprocess.TimeoutExpired:
+            solution_time = time.time() - start_time
+            results['max_runtime'] = max(results['max_runtime'], solution_time)
+            solution_timeout = True
+            solution_stderr = f"TIMEOUT after {timeout_seconds}s"
+        except Exception as e:
+            solution_stderr = str(e)
+        
+        # Run reference
+        reference_output = None
+        reference_stderr = None
+        reference_timeout = False
+        reference_time = 0.0
+        
+        try:
+            start_time = time.time()
+            ref_result = subprocess.run(
+                reference_cmd,
+                input=test_input,
+                shell=True,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            reference_time = time.time() - start_time
+            results['max_runtime'] = max(results['max_runtime'], reference_time)
+            
+            if ref_result.returncode == 0:
+                reference_output = ref_result.stdout
+            else:
+                reference_stderr = ref_result.stderr
+                
+        except subprocess.TimeoutExpired:
+            reference_time = time.time() - start_time
+            results['max_runtime'] = max(results['max_runtime'], reference_time)
+            reference_timeout = True
+            reference_stderr = f"TIMEOUT after {timeout_seconds}s"
+        except Exception as e:
+            reference_stderr = str(e)
+        
+        # Compare outputs (whitespace-normalized)
+        sol_output_normalized = solution_output.strip() if solution_output else ""
+        ref_output_normalized = reference_output.strip() if reference_output else ""
+        
+        # Check for mismatch or error
+        if solution_timeout or reference_timeout or solution_stderr or reference_stderr:
+            # Error in either implementation
+            results['failure_details'] = {
+                'seed': seed,
+                'type': 'execution_error_or_timeout',
+                'test_input': test_input[:1000],  # First 1000 chars
+                'solution_timeout': solution_timeout,
+                'solution_stderr': solution_stderr,
+                'solution_output': solution_output[:500] if solution_output else None,
+                'solution_time': solution_time,
+                'reference_timeout': reference_timeout,
+                'reference_stderr': reference_stderr,
+                'reference_output': reference_output[:500] if reference_output else None,
+                'reference_time': reference_time
+            }
+            results['failed'] = True
+            break
+        elif sol_output_normalized != ref_output_normalized:
+            # Output mismatch
+            results['failure_details'] = {
+                'seed': seed,
+                'type': 'output_mismatch',
+                'test_input': test_input[:1000],  # First 1000 chars
+                'solution_output': solution_output[:500],
+                'reference_output': reference_output[:500],
+                'solution_time': solution_time,
+                'reference_time': reference_time
+            }
+            results['failed'] = True
+            break
+        else:
+            results['passed'] += 1
+    
+    # Format output
+    if results['failed']:
+        failure = results['failure_details']
+        output_lines = [
+            "=== DIFFERENTIAL TEST FAILED ===",
+            f"Seed: {failure.get('seed', '?')}",
+            f"Failure Type: {failure.get('type', 'unknown')}",
+            ""
+        ]
+        
+        if 'test_input' in failure:
+            output_lines.append(f"Test Input (first 1000 chars):\n{failure['test_input']}")
+            output_lines.append("")
+        
+        if 'solution_output' in failure:
+            output_lines.append(f"Solution Output:\n{failure['solution_output']}")
+        if 'solution_stderr' in failure:
+            output_lines.append(f"Solution Stderr:\n{failure['solution_stderr']}")
+        if 'solution_timeout' in failure:
+            output_lines.append(f"Solution Timeout: {failure['solution_timeout']}")
+        if 'solution_time' in failure:
+            output_lines.append(f"Solution Time: {failure['solution_time']:.4f}s")
+        
+        output_lines.append("")
+        
+        if 'reference_output' in failure:
+            output_lines.append(f"Reference Output:\n{failure['reference_output']}")
+        if 'reference_stderr' in failure:
+            output_lines.append(f"Reference Stderr:\n{failure['reference_stderr']}")
+        if 'reference_timeout' in failure:
+            output_lines.append(f"Reference Timeout: {failure['reference_timeout']}")
+        if 'reference_time' in failure:
+            output_lines.append(f"Reference Time: {failure['reference_time']:.4f}s")
+        
+        output_lines.append("")
+        
+        if 'message' in failure:
+            output_lines.append(f"Message: {failure['message']}")
+        if 'gen_stderr' in failure:
+            output_lines.append(f"Generator Stderr: {failure['gen_stderr']}")
+        
+        return "\n".join(output_lines)
+    else:
+        return f"""=== DIFFERENTIAL TEST PASSED ===
+All {results['passed']} test cases passed!
+Maximum runtime observed: {results['max_runtime']:.4f}s
+Solution and reference implementation produce matching outputs (whitespace-normalized)."""
