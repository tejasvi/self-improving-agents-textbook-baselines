@@ -0,0 +1,293 @@
+import subprocess
+import json
+import time
+from pathlib import Path
+
+def tool_info():
+    return {
+        "name": "run_tests",
+        "description": """Run Python code or test cases with timeout support.
+Executes commands or Python solutions against test cases in a subprocess with configurable timeout.
+Returns pass/fail status, elapsed time, and raw stdout/stderr for each case without parsing errors.
+Supports both:
+1. Running a command directly with timeout
+2. Running Python solution with specific test cases
+        """,
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "Bash command to execute (alternative to solution_path). Example: 'python solution.py < test.txt'"
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the command or each test case. Default: 30"
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file (e.g., '/path/to/solution.py'). Optional."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the Solution class (e.g., 'Solution'). Required if solution_path is provided."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call (e.g., 'solve' or 'countSubsequences'). Required if solution_path is provided."
+                },
+                "test_cases": {
+                    "type": "string",
+                    "description": "JSON string containing list of test cases. Each test case is {'input': [...], 'expected': ...}. Example: '[{\"input\": [1, 2, 3], \"expected\": 6}]'"
+                }
+            },
+            "required": ["timeout_seconds"]
+        }
+    }
+
+def tool_function(command=None, timeout_seconds=30, solution_path=None, class_name=None, method_name=None, test_cases=None):
+    """
+    Run tests with timeout support.
+    
+    Args:
+        command: Bash command to run (used if solution_path is not provided)
+        timeout_seconds: Timeout for each command/test case
+        solution_path: Path to Python solution file
+        class_name: Name of Solution class
+        method_name: Name of method to call
+        test_cases: JSON string of test cases
+    
+    Returns:
+        String containing results: pass/fail, elapsed time, and raw output
+    """
+    results = []
+    
+    try:
+        if command:
+            # Run a bash command with timeout
+            results.append(_run_command(command, timeout_seconds))
+        elif solution_path and class_name and method_name and test_cases:
+            # Run Python solution with test cases
+            results.extend(_run_solution_tests(solution_path, class_name, method_name, test_cases, timeout_seconds))
+        else:
+            return "Error: Either provide 'command' or all of ('solution_path', 'class_name', 'method_name', 'test_cases')"
+    except Exception as e:
+        return f"Error: {str(e)}"
+    
+    # Format results
+    output = _format_results(results)
+    return output
+
+def _run_command(command, timeout_seconds):
+    """Run a single bash command with timeout."""
+    try:
+        start_time = time.time()
+        result = subprocess.run(
+            command,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds
+        )
+        elapsed = time.time() - start_time
+        
+        return {
+            'case': 'command',
+            'status': 'PASS' if result.returncode == 0 else 'FAIL',
+            'elapsed_time': elapsed,
+            'stdout': result.stdout,
+            'stderr': result.stderr,
+            'returncode': result.returncode
+        }
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start_time
+        return {
+            'case': 'command',
+            'status': 'TIMEOUT',
+            'elapsed_time': elapsed,
+            'timeout_seconds': timeout_seconds,
+            'stdout': '',
+            'stderr': f'Timeout after {timeout_seconds} seconds'
+        }
+    except Exception as e:
+        return {
+            'case': 'command',
+            'status': 'ERROR',
+            'elapsed_time': 0,
+            'stdout': '',
+            'stderr': str(e)
+        }
+
+def _run_solution_tests(solution_path, class_name, method_name, test_cases_json, timeout_seconds):
+    """Run Python solution against test cases."""
+    results = []
+    
+    try:
+        # Parse test cases
+        if isinstance(test_cases_json, str):
+            test_cases = json.loads(test_cases_json)
+        else:
+            test_cases = test_cases_json
+    except Exception as e:
+        return [{
+            'case': 'parse_error',
+            'status': 'ERROR',
+            'elapsed_time': 0,
+            'stdout': '',
+            'stderr': f'Failed to parse test cases: {str(e)}'
+        }]
+    
+    # Import solution
+    try:
+        spec = __import__('importlib.util').util.spec_from_file_location("solution", solution_path)
+        solution_module = __import__('importlib.util').util.module_from_spec(spec)
+        spec.loader.exec_module(solution_module)
+        solution_class = getattr(solution_module, class_name)
+        solution_instance = solution_class()
+        method = getattr(solution_instance, method_name)
+    except Exception as e:
+        return [{
+            'case': 'import_error',
+            'status': 'ERROR',
+            'elapsed_time': 0,
+            'stdout': '',
+            'stderr': f'Failed to import solution: {str(e)}'
+        }]
+    
+    # Run each test case
+    for i, test_case in enumerate(test_cases):
+        try:
+            input_args = test_case.get('input', [])
+            expected = test_case.get('expected')
+            
+            # Handle single arg vs multiple args
+            if not isinstance(input_args, list):
+                input_args = [input_args]
+            
+            start_time = time.time()
+            
+            try:
+                # Call the method with timeout using subprocess
+                code = f"""
+import sys
+import importlib.util
+spec = importlib.util.spec_from_file_location("solution", {solution_path!r})
+solution_module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(solution_module)
+solution_class = getattr(solution_module, {class_name!r})
+solution_instance = solution_class()
+method = getattr(solution_instance, {method_name!r})
+result = method(*{input_args!r})
+print(result)
+"""
+                
+                result = subprocess.run(
+                    ['python', '-c', code],
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_seconds
+                )
+                
+                elapsed = time.time() - start_time
+                
+                if result.returncode == 0:
+                    output = result.stdout.strip()
+                    try:
+                        actual = eval(output)
+                    except:
+                        actual = output
+                    
+                    match = str(actual) == str(expected)
+                    results.append({
+                        'case': f'test_{i}',
+                        'input': input_args,
+                        'expected': expected,
+                        'actual': actual,
+                        'status': 'PASS' if match else 'FAIL',
+                        'elapsed_time': elapsed,
+                        'stdout': result.stdout,
+                        'stderr': result.stderr
+                    })
+                else:
+                    elapsed = time.time() - start_time
+                    results.append({
+                        'case': f'test_{i}',
+                        'input': input_args,
+                        'expected': expected,
+                        'status': 'ERROR',
+                        'elapsed_time': elapsed,
+                        'stdout': result.stdout,
+                        'stderr': result.stderr
+                    })
+            except subprocess.TimeoutExpired:
+                elapsed = time.time() - start_time
+                results.append({
+                    'case': f'test_{i}',
+                    'input': input_args,
+                    'expected': expected,
+                    'status': 'TIMEOUT',
+                    'elapsed_time': elapsed,
+                    'timeout_seconds': timeout_seconds,
+                    'stdout': '',
+                    'stderr': f'Timeout after {timeout_seconds} seconds'
+                })
+        except Exception as e:
+            elapsed = time.time() - start_time
+            results.append({
+                'case': f'test_{i}',
+                'input': test_case.get('input'),
+                'expected': test_case.get('expected'),
+                'status': 'ERROR',
+                'elapsed_time': elapsed,
+                'stdout': '',
+                'stderr': str(e)
+            })
+    
+    return results
+
+def _format_results(results):
+    """Format results for display."""
+    lines = []
+    
+    for result in results:
+        lines.append(f"\nTest Case: {result.get('case', 'unknown')}")
+        
+        if 'input' in result:
+            lines.append(f"Input: {result['input']}")
+        if 'expected' in result:
+            lines.append(f"Expected: {result['expected']}")
+        if 'actual' in result:
+            lines.append(f"Actual: {result['actual']}")
+        
+        lines.append(f"Status: {result['status']}")
+        lines.append(f"Elapsed Time: {result['elapsed_time']:.4f}s")
+        
+        if result.get('timeout_seconds'):
+            lines.append(f"Timeout: {result['timeout_seconds']}s")
+        
+        if result.get('stdout'):
+            lines.append(f"Stdout:\n{result['stdout']}")
+        if result.get('stderr'):
+            lines.append(f"Stderr:\n{result['stderr']}")
+    
+    return '\n'.join(lines)
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    
+    if len(sys.argv) > 1:
+        if sys.argv[1] == '--command':
+            result = tool_function(command=sys.argv[2], timeout_seconds=10)
+            print(result)
+        elif sys.argv[1] == '--solution':
+            result = tool_function(
+                solution_path=sys.argv[2],
+                class_name=sys.argv[3],
+                method_name=sys.argv[4],
+                test_cases=sys.argv[5],
+                timeout_seconds=10
+            )
+            print(result)
+    else:
+        print(tool_info())
