index 0000000..1fb09a2
--- /dev/null
+++ b/tools/method_bench.py
@@ -0,0 +1,269 @@
+import subprocess
+import json
+import sys
+import os
+import tempfile
+import time
+
+def tool_info():
+    return {
+        "name": "method_bench",
+        "description": """Benchmark and test a Solution class method. Supports timing a single call with timeout, 
+and comparing against a brute-force reference over multiple generated test cases. 
+Returns timing, first mismatch details, or exception/TIMEOUT.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file containing the Solution class"
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Name of the class to instantiate (default: 'Solution')"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to call on the class instance"
+                },
+                "args_json": {
+                    "type": "string",
+                    "description": "JSON string representing the list of positional arguments to pass to the method"
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for the method call (e.g., 5.0)"
+                },
+                "gen_script": {
+                    "type": "string",
+                    "description": "Optional: absolute path to a Python generator script that produces JSON args lists. Script takes size/seed as argument."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional: absolute path to brute-force reference file with the same class. Use with gen_script for compare mode."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Optional: number of test cases to run in compare mode (default: 10)"
+                }
+            },
+            "required": ["solution_path", "method_name", "args_json", "timeout_seconds"]
+        }
+    }
+
+def _run_method_in_subprocess(solution_path, class_name, method_name, args_json, timeout_seconds):
+    """
+    Run a method call in a subprocess with timeout using subprocess.run.
+    Returns: (result, elapsed_time, exception_msg) where result is the return value as a string,
+             elapsed_time is wall-clock time, and exception_msg is None on success or error string on failure.
+    """
+    # Create a runner script that will be executed in a subprocess
+    runner_code = f'''
+import json
+import sys
+import time
+import importlib.util
+
+solution_path = {repr(solution_path)}
+class_name = {repr(class_name)}
+method_name = {repr(method_name)}
+args_json_str = {repr(args_json)}
+timeout_seconds = {timeout_seconds}
+
+# Load the solution module
+spec = importlib.util.spec_from_file_location("solution_module", solution_path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+# Get the class
+cls = getattr(module, class_name)
+
+# Instantiate it
+instance = cls()
+
+# Parse args
+args = json.loads(args_json_str)
+
+# Call the method
+start_time = time.time()
+try:
+    result = getattr(instance, method_name)(*args)
+    elapsed = time.time() - start_time
+    print(f"RESULT|{elapsed}|{json.dumps(result)}")
+except Exception as e:
+    elapsed = time.time() - start_time
+    print(f"EXCEPTION|{elapsed}|{type(e).__name__}: {str(e)}")
+    sys.exit(1)
+'''
+    
+    try:
+        result = subprocess.run(
+            [sys.executable, "-c", runner_code],
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds
+        )
+        
+        output = result.stdout.strip()
+        
+        # Parse the output
+        if output.startswith("RESULT|"):
+            parts = output.split("|", 2)
+            if len(parts) == 3:
+                elapsed_time = float(parts[1])
+                result_str = parts[2]
+                return result_str, elapsed_time, None
+            else:
+                return None, None, f"Failed to parse result: {output}"
+        elif output.startswith("EXCEPTION|"):
+            parts = output.split("|", 2)
+            if len(parts) == 3:
+                elapsed_time = float(parts[1])
+                error_msg = parts[2]
+                return None, elapsed_time, error_msg
+            else:
+                return None, None, f"Method raised exception: {output}"
+        else:
+            return None, None, f"Unexpected output format: {output}"
+    
+    except subprocess.TimeoutExpired:
+        return None, timeout_seconds, f"TIMEOUT ({timeout_seconds}s)"
+    except Exception as e:
+        return None, None, f"Subprocess error: {str(e)}"
+
+def tool_function(solution_path, method_name, args_json, timeout_seconds, 
+                 class_name="Solution", gen_script=None, brute_path=None, num_tests=10):
+    """
+    Benchmark a Solution class method.
+    
+    Modes:
+    1. Single timing mode: if only args_json is provided, run once and return timing.
+    2. Compare mode: if gen_script and brute_path are provided, compare against brute-force.
+    
+    Args:
+        solution_path: Path to solution file with Solution class
+        method_name: Method to call
+        args_json: JSON string of positional arguments (for single mode)
+        timeout_seconds: Timeout per test
+        class_name: Class name (default "Solution")
+        gen_script: Optional generator script path for compare mode
+        brute_path: Optional brute-force reference path for compare mode
+        num_tests: Number of tests in compare mode (default 10)
+    
+    Returns:
+        String containing results, timings, or error information
+    """
+    
+    # Check if solution file exists
+    if not os.path.exists(solution_path):
+        return f"Error: Solution file not found: {solution_path}"
+    
+    # SINGLE TIMING MODE
+    if gen_script is None or brute_path is None:
+        # Just run once with the provided args_json
+        result, elapsed_time, exception = _run_method_in_subprocess(
+            solution_path, class_name, method_name, args_json, timeout_seconds
+        )
+        
+        if exception:
+            return f"Method call failed: {exception}\nTimeout: {timeout_seconds}s"
+        
+        output = f"Single method call completed\n"
+        output += f"Elapsed time: {elapsed_time:.4f}s (timeout: {timeout_seconds}s)\n"
+        output += f"Result: {result}\n"
+        return output
+    
+    # COMPARE MODE (against brute-force with generator)
+    if not os.path.exists(gen_script):
+        return f"Error: Generator script not found: {gen_script}"
+    if not os.path.exists(brute_path):
+        return f"Error: Brute-force reference not found: {brute_path}"
+    
+    results = []
+    first_mismatch = None
+    passed_count = 0
+    total_solution_time = 0.0
+    total_brute_time = 0.0
+    
+    for seed in range(num_tests):
+        # Generate test case args
+        try:
+            gen_result = subprocess.run(
+                [sys.executable, gen_script, str(seed)],
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            if gen_result.returncode != 0:
+                results.append(f"Test {seed}: Generator failed: {gen_result.stderr[:100]}")
+                continue
+            
+            args_json_test = gen_result.stdout.strip()
+        except subprocess.TimeoutExpired:
+            results.append(f"Test {seed}: Generator timeout")
+            continue
+        except Exception as e:
+            results.append(f"Test {seed}: Generator error: {str(e)}")
+            continue
+        
+        # Run solution method
+        sol_result, sol_time, sol_exception = _run_method_in_subprocess(
+            solution_path, class_name, method_name, args_json_test, timeout_seconds
+        )
+        
+        # Run brute-force method
+        brute_result, brute_time, brute_exception = _run_method_in_subprocess(
+            brute_path, class_name, method_name, args_json_test, timeout_seconds
+        )
+        
+        # Compare results
+        if sol_exception or brute_exception:
+            if not first_mismatch:
+                first_mismatch = {
+                    "test": seed,
+                    "args": args_json_test[:100],
+                    "solution_error": sol_exception,
+                    "brute_error": brute_exception
+                }
+            results.append(f"Test {seed}: FAIL (sol_error={sol_exception}, brute_error={brute_exception})")
+        elif sol_result != brute_result:
+            if not first_mismatch:
+                first_mismatch = {
+                    "test": seed,
+                    "args": args_json_test[:100],
+                    "solution_result": sol_result[:100] if sol_result else None,
+                    "brute_result": brute_result[:100] if brute_result else None
+                }
+            results.append(f"Test {seed}: MISMATCH")
+        else:
+            passed_count += 1
+            if sol_time is not None:
+                total_solution_time += sol_time
+            if brute_time is not None:
+                total_brute_time += brute_time
+            results.append(f"Test {seed}: PASS (sol={sol_time:.4f}s, brute={brute_time:.4f}s)")
+    
+    # Format output
+    output = f"Compare Mode Results ({passed_count}/{num_tests} passed)\n"
+    if passed_count > 0:
+        output += f"Average solution time: {total_solution_time/passed_count:.4f}s\n"
+        output += f"Average brute-force time: {total_brute_time/passed_count:.4f}s\n"
+    
+    if first_mismatch:
+        output += f"\nFirst Mismatch at Test {first_mismatch['test']}:\n"
+        output += f"Args (first 100 chars): {first_mismatch['args']}\n"
+        if first_mismatch.get('solution_error'):
+            output += f"Solution error: {first_mismatch['solution_error']}\n"
+        elif first_mismatch.get('solution_result'):
+            output += f"Solution result (first 100 chars): {first_mismatch['solution_result']}\n"
+        if first_mismatch.get('brute_error'):
+            output += f"Brute-force error: {first_mismatch['brute_error']}\n"
+        elif first_mismatch.get('brute_result'):
+            output += f"Brute-force result (first 100 chars): {first_mismatch['brute_result']}\n"
+    else:
+        output += "\nAll tests passed!"
+    
+    output += "\n\nTest Details (last 20):\n"
+    output += "\n".join(results[-20:])
+    
+    return output
