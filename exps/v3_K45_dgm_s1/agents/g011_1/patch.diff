diff --git a/tools/gen_max_inputs.py b/tools/gen_max_inputs.py
new file mode 100644
index 0000000..386c3a2
--- /dev/null
+++ b/tools/gen_max_inputs.py
@@ -0,0 +1,91 @@
+import os
+import random
+
+def tool_info():
+    return {
+        "name": "gen_max_inputs",
+        "description": """Generate max-size test files for integer-array inputs.
+Creates files with various adversarial patterns (random, all-equal, sorted ascending/descending, etc.)
+given N and value range. Useful for benchmarking and adversarial testing without manual file creation.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "output_file": {
+                    "type": "string",
+                    "description": "Path to output file where input will be written"
+                },
+                "n": {
+                    "type": "integer",
+                    "description": "Size of the array (e.g., 1000000 for 1e6)"
+                },
+                "value_min": {
+                    "type": "integer",
+                    "description": "Minimum value for array elements"
+                },
+                "value_max": {
+                    "type": "integer",
+                    "description": "Maximum value for array elements"
+                },
+                "pattern": {
+                    "type": "string",
+                    "description": "Pattern for array generation: 'random', 'sorted_asc', 'sorted_desc', 'all_equal', 'alternating', or 'nearly_sorted'"
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Random seed for reproducibility (default: 42)"
+                }
+            },
+            "required": ["output_file", "n", "value_min", "value_max", "pattern"]
+        }
+    }
+
+def tool_function(output_file, n, value_min, value_max, pattern, seed=42):
+    """
+    Generate a max-size integer array test file.
+    
+    Args:
+        output_file: Path to write the generated input file
+        n: Size of the array
+        value_min: Minimum value for elements
+        value_max: Maximum value for elements
+        pattern: One of: 'random', 'sorted_asc', 'sorted_desc', 'all_equal', 'alternating', 'nearly_sorted'
+        seed: Random seed for reproducibility
+    
+    Returns:
+        String confirming file creation or error message
+    """
+    try:
+        random.seed(seed)
+        
+        # Generate array based on pattern
+        if pattern == 'random':
+            arr = [random.randint(value_min, value_max) for _ in range(n)]
+        elif pattern == 'sorted_asc':
+            arr = sorted([random.randint(value_min, value_max) for _ in range(n)])
+        elif pattern == 'sorted_desc':
+            arr = sorted([random.randint(value_min, value_max) for _ in range(n)], reverse=True)
+        elif pattern == 'all_equal':
+            arr = [value_min] * n
+        elif pattern == 'alternating':
+            arr = [value_min if i % 2 == 0 else value_max for i in range(n)]
+        elif pattern == 'nearly_sorted':
+            arr = sorted([random.randint(value_min, value_max) for _ in range(n)])
+            # Shuffle 1% of elements
+            for _ in range(max(1, n // 100)):
+                i, j = random.randint(0, n-1), random.randint(0, n-1)
+                arr[i], arr[j] = arr[j], arr[i]
+        else:
+            return f"Error: Unknown pattern '{pattern}'. Use one of: random, sorted_asc, sorted_desc, all_equal, alternating, nearly_sorted"
+        
+        # Create output directory if it doesn't exist
+        os.makedirs(os.path.dirname(os.path.abspath(output_file)), exist_ok=True)
+        
+        # Write to file
+        with open(output_file, 'w') as f:
+            f.write(f"{n}\n")
+            f.write(" ".join(map(str, arr)) + "\n")
+        
+        return f"Generated {pattern} input file: {output_file} (N={n}, range=[{value_min}, {value_max}])"
+        
+    except Exception as e:
+        return f"Error generating input file: {str(e)}"
