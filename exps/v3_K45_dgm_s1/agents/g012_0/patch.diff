diff --git a/tools/benchmark_method.py b/tools/benchmark_method.py
new file mode 100644
index 0000000..a427d55
--- /dev/null
+++ b/tools/benchmark_method.py
@@ -0,0 +1,252 @@
+import subprocess
+import sys
+import time
+import os
+import json
+import importlib.util
+import traceback
+
+def tool_info():
+    return {
+        "name": "benchmark_method",
+        "description": """Benchmark a Solution class method on max-size adversarial inputs.
+Builds adversarial inputs natively for array-style first arguments using various patterns 
+(ascending, descending, equal, random, alternating, zigzag).
+Runs the method in a subprocess with a timeout and reports wall time, truncated result, 
+and 'TIMEOUT => FAIL' on timeout. By default runs all patterns when 'pattern' is omitted.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python file containing the Solution class"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to benchmark (e.g., 'countNonDecreasing')"
+                },
+                "n": {
+                    "type": "integer",
+                    "description": "Size of the first (array) argument to generate"
+                },
+                "value_max": {
+                    "type": "integer",
+                    "description": "Maximum value for array elements (e.g., 1000)"
+                },
+                "extra_args": {
+                    "type": "string",
+                    "description": "Optional: JSON list of extra arguments (e.g., '[5]' for k=5). Empty string if none."
+                },
+                "pattern": {
+                    "type": "string",
+                    "description": "Optional: Pattern for array generation (ascending, descending, equal, random, alternating, zigzag). Empty string or omit to run all patterns."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each pattern run (e.g., 5.0)"
+                }
+            },
+            "required": ["solution_path", "method_name", "n", "value_max", "timeout_seconds"]
+        }
+    }
+
+def _generate_array(n, value_max, pattern="random"):
+    """
+    Generate an adversarial array based on the pattern.
+    
+    Args:
+        n: Size of array
+        value_max: Maximum value for elements
+        pattern: One of 'ascending', 'descending', 'equal', 'random', 'alternating', 'zigzag'
+    
+    Returns:
+        List of integers
+    """
+    import random
+    
+    if pattern == "ascending":
+        return list(range(min(n, value_max)))
+    elif pattern == "descending":
+        return list(range(min(n, value_max) - 1, -1, -1))
+    elif pattern == "equal":
+        return [value_max // 2] * n
+    elif pattern == "random":
+        random.seed(42)  # Deterministic for reproducibility
+        return [random.randint(0, value_max) for _ in range(n)]
+    elif pattern == "alternating":
+        # Alternates between min and max
+        return [0 if i % 2 == 0 else value_max for i in range(n)]
+    elif pattern == "zigzag":
+        # Goes up then down repeatedly
+        result = []
+        direction = 1
+        val = 0
+        for _ in range(n):
+            result.append(val)
+            val += direction
+            if val >= value_max or val <= 0:
+                direction *= -1
+        return result
+    else:
+        raise ValueError(f"Unknown pattern: {pattern}")
+
+def _call_method_with_timeout(solution_path, method_name, args, timeout=5.0):
+    """
+    Call a Solution method with a timeout using subprocess.
+    
+    Args:
+        solution_path: Path to solution file
+        method_name: Name of method to call
+        args: List of arguments
+        timeout: Timeout in seconds
+    
+    Returns:
+        Tuple of (success: bool, result: str, time_taken: float)
+    """
+    runner_code = f"""
+import sys
+import json
+import importlib.util
+
+# Import the module
+spec = importlib.util.spec_from_file_location("solution_module", {repr(solution_path)})
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+# Get the Solution class
+Solution = getattr(module, 'Solution')
+instance = Solution()
+method = getattr(instance, {repr(method_name)})
+
+# Parse args
+args = json.loads({repr(json.dumps(args))})
+
+# Call the method
+result = method(*args)
+
+# Print result as JSON
+print(json.dumps(result))
+"""
+    
+    start_time = time.time()
+    try:
+        result = subprocess.run(
+            [sys.executable, "-c", runner_code],
+            capture_output=True,
+            text=True,
+            timeout=timeout
+        )
+        elapsed_time = time.time() - start_time
+        
+        if result.returncode != 0:
+            return False, f"ERROR: {result.stderr[:200]}", elapsed_time
+        
+        try:
+            output = json.loads(result.stdout.strip())
+            output_str = str(output)[:200]
+        except json.JSONDecodeError:
+            output_str = result.stdout.strip()[:200]
+        
+        return True, output_str, elapsed_time
+    
+    except subprocess.TimeoutExpired:
+        elapsed_time = time.time() - start_time
+        return False, "TIMEOUT => FAIL", elapsed_time
+    except Exception as e:
+        elapsed_time = time.time() - start_time
+        return False, f"ERROR: {str(e)[:200]}", elapsed_time
+
+def tool_function(solution_path, method_name, n, value_max, timeout_seconds, extra_args="", pattern=""):
+    """
+    Benchmark a Solution class method on max-size adversarial inputs.
+    
+    Args:
+        solution_path: Path to Python file containing Solution class
+        method_name: Name of method to benchmark
+        n: Size of first (array) argument
+        value_max: Maximum value for array elements
+        timeout_seconds: Timeout per pattern in seconds
+        extra_args: Optional JSON list of extra arguments (e.g., '[5]')
+        pattern: Optional pattern (ascending, descending, equal, random, alternating, zigzag)
+               If empty, runs all patterns
+    
+    Returns:
+        String containing benchmark results
+    """
+    try:
+        # Get absolute path
+        solution_path = os.path.abspath(solution_path)
+        
+        if not os.path.exists(solution_path):
+            return f"Error: Solution file not found: {solution_path}"
+        
+        # Parse extra args
+        extra_args_list = []
+        if extra_args and extra_args.strip():
+            try:
+                extra_args_list = json.loads(extra_args)
+                if not isinstance(extra_args_list, list):
+                    return f"Error: extra_args must be a JSON list, got: {extra_args}"
+            except json.JSONDecodeError as e:
+                return f"Error parsing extra_args JSON: {str(e)}"
+        
+        # Determine patterns to run
+        patterns_to_run = []
+        if pattern and pattern.strip():
+            patterns_to_run = [pattern.strip()]
+        else:
+            patterns_to_run = ["ascending", "descending", "equal", "random", "alternating", "zigzag"]
+        
+        # Run benchmarks
+        results = []
+        all_passed = True
+        
+        for pat in patterns_to_run:
+            try:
+                # Generate adversarial input
+                array = _generate_array(n, value_max, pat)
+                args = [array] + extra_args_list
+                
+                # Run method with timeout
+                success, output, elapsed_time = _call_method_with_timeout(
+                    solution_path, method_name, args, timeout_seconds
+                )
+                
+                if success:
+                    results.append(
+                        f"Pattern '{pat}' (n={n}): PASS ({elapsed_time:.3f}s) => {output}"
+                    )
+                    if elapsed_time > timeout_seconds * 0.9:
+                        results.append(f"  WARNING: Close to timeout threshold!")
+                else:
+                    all_passed = False
+                    results.append(
+                        f"Pattern '{pat}' (n={n}): FAIL ({elapsed_time:.3f}s) => {output}"
+                    )
+            
+            except Exception as e:
+                all_passed = False
+                results.append(
+                    f"Pattern '{pat}' (n={n}): ERROR => {str(e)[:200]}"
+                )
+        
+        # Format output
+        output = f"Benchmark Method Results\n"
+        output += f"Solution: {solution_path}\n"
+        output += f"Method: {method_name}\n"
+        output += f"Array size (n): {n}\n"
+        output += f"Value max: {value_max}\n"
+        output += f"Timeout per pattern: {timeout_seconds}s\n"
+        output += "=" * 70 + "\n"
+        
+        if all_passed:
+            output += "Status: ALL PATTERNS PASSED ✓\n\n"
+        else:
+            output += "Status: SOME PATTERNS FAILED ✗\n\n"
+        
+        output += "\n".join(results)
+        
+        return output
+    
+    except Exception as e:
+        return f"Error running benchmark: {str(e)}\n{traceback.format_exc()}"
