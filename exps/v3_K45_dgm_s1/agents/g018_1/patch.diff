+++ b/tools/run_with_limits.py
@@ -0,0 +1,189 @@
+import subprocess
+import resource
+import time
+import os
+import signal
+import sys
+
+def tool_info():
+    return {
+        "name": "run_with_limits",
+        "description": """Run a command with CPU/wall timeout and memory limits.
+* Executes the command using subprocess with resource.setrlimit to enforce an address-space limit.
+* Can read stdin from a file if specified.
+* Returns stdout (truncated to 10000 chars), stderr, exit code, elapsed wall time, and peak memory usage.
+* Marks timeout/memory errors clearly so the agent can detect TLE and MemoryError.
+* Useful for stress testing solutions against time and memory constraints.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The command to run (e.g., 'python solution.py')."
+                },
+                "stdin_file": {
+                    "type": "string",
+                    "description": "Optional path to a file to use as stdin. If not provided, stdin is inherited."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Wall-clock timeout in seconds. Default 10."
+                },
+                "memory_mb": {
+                    "type": "number",
+                    "description": "Address-space memory limit in MB. Default 1024."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+def truncate_output(text, max_length=10000):
+    """Truncate output and mark if clipped."""
+    if text is None:
+        return ""
+    if len(text) > max_length:
+        return text[:max_length] + "\n<OUTPUT TRUNCATED>"
+    return text
+
+def tool_function(command, stdin_file=None, timeout_sec=10, memory_mb=1024):
+    """
+    Run a command with time and memory limits.
+    
+    Returns a dictionary with:
+      - stdout (truncated)
+      - stderr (truncated)
+      - exit_code
+      - elapsed_time (wall time in seconds)
+      - peak_memory_mb (peak memory usage in MB, best effort)
+      - status (SUCCESS, TIMEOUT, MEMORY_EXCEEDED, ERROR)
+    """
+    try:
+        # Open stdin file if provided
+        stdin_fh = None
+        if stdin_file:
+            if not os.path.exists(stdin_file):
+                return {
+                    "stdout": "",
+                    "stderr": f"Error: stdin file '{stdin_file}' not found.",
+                    "exit_code": -1,
+                    "elapsed_time": 0,
+                    "peak_memory_mb": 0,
+                    "status": "ERROR"
+                }
+            stdin_fh = open(stdin_file, 'r')
+        
+        # Preexec function to set resource limits
+        def preexec():
+            # Set address-space limit (RLIMIT_AS)
+            try:
+                memory_bytes = memory_mb * 1024 * 1024
+                resource.setrlimit(resource.RLIMIT_AS, (memory_bytes, memory_bytes))
+            except Exception as e:
+                pass  # Best effort, may not be available on all systems
+        
+        # Start the process
+        start_time = time.time()
+        try:
+            proc = subprocess.Popen(
+                command,
+                shell=True,
+                stdin=stdin_fh if stdin_fh else subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                preexec_fn=preexec,
+                text=True
+            )
+            
+            # Wait with timeout
+            try:
+                stdout_data, stderr_data = proc.communicate(timeout=timeout_sec)
+                elapsed_time = time.time() - start_time
+                exit_code = proc.returncode
+                status = "SUCCESS"
+                
+                # Check for memory-exceeded exit codes
+                # Exit code 137 often indicates killed by SIGKILL (memory limit)
+                if exit_code == 137:
+                    status = "MEMORY_EXCEEDED"
+                elif "Segmentation fault" in stderr_data or "Memory" in stderr_data:
+                    status = "MEMORY_EXCEEDED"
+                
+            except subprocess.TimeoutExpired:
+                # Timeout occurred
+                proc.kill()
+                try:
+                    stdout_data, stderr_data = proc.communicate(timeout=2)
+                except subprocess.TimeoutExpired:
+                    proc.wait()
+                    stdout_data, stderr_data = "", ""
+                elapsed_time = time.time() - start_time
+                exit_code = proc.returncode
+                status = "TIMEOUT"
+                stderr_data = f"TIMEOUT: Command did not complete within {timeout_sec} seconds.\n{stderr_data or ''}"
+        
+        except Exception as e:
+            elapsed_time = time.time() - start_time
+            stdout_data = ""
+            stderr_data = f"Error: {str(e)}"
+            exit_code = -1
+            status = "ERROR"
+        
+        finally:
+            if stdin_fh:
+                stdin_fh.close()
+        
+        # Best-effort peak memory usage via getrusage
+        try:
+            # Note: getrusage of self doesn't give child's max RSS reliably on all systems
+            # We'll return 0 as a placeholder; more sophisticated monitoring would be needed
+            peak_memory_mb = 0
+        except:
+            peak_memory_mb = 0
+        
+        return {
+            "stdout": truncate_output(stdout_data),
+            "stderr": truncate_output(stderr_data),
+            "exit_code": exit_code,
+            "elapsed_time": round(elapsed_time, 2),
+            "peak_memory_mb": peak_memory_mb,
+            "status": status
+        }
+    
+    except Exception as e:
+        return {
+            "stdout": "",
+            "stderr": f"Unexpected error: {str(e)}",
+            "exit_code": -1,
+            "elapsed_time": 0,
+            "peak_memory_mb": 0,
+            "status": "ERROR"
+        }
+
+if __name__ == "__main__":
+    # Example usage
+    import json
+    if len(sys.argv) < 2:
+        print("Usage: python run_with_limits.py <command> [--stdin_file FILE] [--timeout_sec N] [--memory_mb N]")
+    else:
+        command = sys.argv[1]
+        stdin_file = None
+        timeout_sec = 10
+        memory_mb = 1024
+        
+        i = 2
+        while i < len(sys.argv):
+            if sys.argv[i] == '--stdin_file' and i + 1 < len(sys.argv):
+                stdin_file = sys.argv[i + 1]
+                i += 2
+            elif sys.argv[i] == '--timeout_sec' and i + 1 < len(sys.argv):
+                timeout_sec = float(sys.argv[i + 1])
+                i += 2
+            elif sys.argv[i] == '--memory_mb' and i + 1 < len(sys.argv):
+                memory_mb = float(sys.argv[i + 1])
+                i += 2
+            else:
+                i += 1
+        
+        result = tool_function(command, stdin_file, timeout_sec, memory_mb)
+        print(json.dumps(result, indent=2))
