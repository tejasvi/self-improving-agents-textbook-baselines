@@ -0,0 +1,152 @@
+import subprocess
+import tempfile
+import os
+
+def tool_info():
+    return {
+        "name": "stress_compare",
+        "description": """Compare a brute-force reference solution against a candidate solution using a test generator.
+* Runs K random trials using the generator script.
+* For each trial, feeds the generated input to both the brute-force and candidate solutions.
+* Returns immediately upon finding a mismatching output, including the input and both outputs.
+* Returns raw outputs for the agent to interpret.
+* Useful for validating correctness before stress testing.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "brute_force_prog": {
+                    "type": "string",
+                    "description": "Command to run the brute-force solution (e.g., 'python brute.py')."
+                },
+                "candidate_prog": {
+                    "type": "string",
+                    "description": "Command to run the candidate solution (e.g., 'python solution.py')."
+                },
+                "generator_prog": {
+                    "type": "string",
+                    "description": "Command to run the test generator (e.g., 'python gen.py')."
+                },
+                "num_trials": {
+                    "type": "number",
+                    "description": "Number of random trials to run. Default 10."
+                },
+                "timeout_sec": {
+                    "type": "number",
+                    "description": "Timeout per execution in seconds. Default 5."
+                }
+            },
+            "required": ["brute_force_prog", "candidate_prog", "generator_prog"]
+        }
+    }
+
+def tool_function(brute_force_prog, candidate_prog, generator_prog, num_trials=10, timeout_sec=5):
+    """
+    Compare brute-force and candidate solutions on randomly generated test cases.
+    
+    Returns a dictionary with:
+      - verdict: 'MATCH' (all trials match) or 'MISMATCH'
+      - num_trials_run: number of trials executed
+      - first_diff_input: the first input where outputs differed (or None)
+      - brute_output: output from brute-force on first diff (or None)
+      - candidate_output: output from candidate on first diff (or None)
+      - error_msg: any error encountered (or None)
+    """
+    try:
+        for trial_num in range(int(num_trials)):
+            try:
+                # Generate a test case
+                gen_result = subprocess.run(
+                    generator_prog,
+                    shell=True,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                if gen_result.returncode != 0:
+                    return {
+                        "verdict": "ERROR",
+                        "num_trials_run": trial_num,
+                        "first_diff_input": None,
+                        "brute_output": None,
+                        "candidate_output": None,
+                        "error_msg": f"Generator failed with code {gen_result.returncode}: {gen_result.stderr}"
+                    }
+                
+                test_input = gen_result.stdout
+                
+                # Run brute-force solution
+                brute_result = subprocess.run(
+                    brute_force_prog,
+                    shell=True,
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                brute_output = brute_result.stdout
+                
+                # Run candidate solution
+                cand_result = subprocess.run(
+                    candidate_prog,
+                    shell=True,
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_sec
+                )
+                cand_output = cand_result.stdout
+                
+                # Compare outputs
+                if brute_output.strip() != cand_output.strip():
+                    # Truncate large inputs/outputs
+                    input_display = test_input[:1000] + "\n<INPUT TRUNCATED>" if len(test_input) > 1000 else test_input
+                    brute_display = brute_output[:1000] + "\n<OUTPUT TRUNCATED>" if len(brute_output) > 1000 else brute_output
+                    cand_display = cand_output[:1000] + "\n<OUTPUT TRUNCATED>" if len(cand_output) > 1000 else cand_output
+                    
+                    return {
+                        "verdict": "MISMATCH",
+                        "num_trials_run": trial_num + 1,
+                        "first_diff_input": input_display,
+                        "brute_output": brute_display,
+                        "candidate_output": cand_display,
+                        "error_msg": None
+                    }
+            
+            except subprocess.TimeoutExpired:
+                return {
+                    "verdict": "TIMEOUT",
+                    "num_trials_run": trial_num + 1,
+                    "first_diff_input": None,
+                    "brute_output": None,
+                    "candidate_output": None,
+                    "error_msg": f"Timeout on trial {trial_num + 1} after {timeout_sec} seconds"
+                }
+            except Exception as e:
+                return {
+                    "verdict": "ERROR",
+                    "num_trials_run": trial_num + 1,
+                    "first_diff_input": None,
+                    "brute_output": None,
+                    "candidate_output": None,
+                    "error_msg": f"Error on trial {trial_num + 1}: {str(e)}"
+                }
+        
+        # All trials matched
+        return {
+            "verdict": "MATCH",
+            "num_trials_run": int(num_trials),
+            "first_diff_input": None,
+            "brute_output": None,
+            "candidate_output": None,
+            "error_msg": None
+        }
+    
+    except Exception as e:
+        return {
+            "verdict": "ERROR",
+            "num_trials_run": 0,
+            "first_diff_input": None,
+            "brute_output": None,
+            "candidate_output": None,
+            "error_msg": f"Unexpected error: {str(e)}"
+        }
