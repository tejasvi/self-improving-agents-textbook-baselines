+"""
+Tool for exhaustive verification of competitive programming solutions on small inputs.
+Compares solution against brute-force reference on ALL tiny inputs (e.g., all permutations).
+Designed to catch algorithmic errors on small cases before scaling up.
+"""
+
+import os
+import sys
+import time
+import tempfile
+import subprocess
+from pathlib import Path
+
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "exhaustive_check",
+        "description": """Exhaustively test a solution against brute-force on all tiny inputs.
+The generator file may define enumerate_inputs(max_n) that yields all tiny inputs as strings 
+(e.g., all permutations of size <= max_n), in addition to the existing generator_input(n, seed).
+Runs both solution and brute-force on each input, stops at first mismatch, and returns raw text:
+- Number of inputs checked
+- Number of mismatches
+- Smallest mismatching input with both outputs
+Does not parse or interpret error messages; returns raw output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file (Python script or module with Solution class)"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference file (Python script or module with Solution class)"
+                },
+                "generator_code_or_path": {
+                    "type": "string",
+                    "description": "Path to or code snippet of a generator file that defines enumerate_inputs(max_n) yielding all tiny inputs as strings. If a file path, will be read. If code, will be executed directly."
+                },
+                "max_n": {
+                    "type": "integer",
+                    "description": "Maximum size N for enumeration (e.g., all permutations up to size max_n)"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test execution in seconds (default 5)"
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_code_or_path", "max_n"]
+        }
+    }
+
+
+def _run_solution_on_input(solution_path, test_input, timeout_sec):
+    """
+    Run a solution on a single test input via subprocess.
+    Returns (elapsed_time_sec, output, is_timeout, error_msg)
+    """
+    try:
+        # Ensure solution_path is absolute
+        abs_path = os.path.abspath(solution_path)
+        if not os.path.isfile(abs_path):
+            return 0, "", False, f"Solution file not found: {abs_path}"
+        
+        # Run as a Python script via stdin/stdout
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {abs_path}",
+            timeout_seconds=timeout_sec,
+            cwd=os.path.dirname(abs_path),
+            input_data=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        if returncode == -1 and "TIMEOUT" in stderr:
+            return elapsed, stdout, True, stderr
+        elif returncode != 0:
+            # Include stderr if there's an error
+            error_msg = stderr if stderr else f"Exit code {returncode}"
+            return elapsed, stdout, False, error_msg
+        else:
+            return elapsed, stdout, False, ""
+    
+    except Exception as e:
+        return 0, "", False, f"Error running solution: {str(e)}"
+
+
+def _enumerate_inputs(generator_code_or_path, max_n):
+    """
+    Load generator code/file and call enumerate_inputs(max_n) to yield all tiny inputs.
+    Yields (test_input, error_msg) pairs. If error_msg is not None, yields the error once.
+    """
+    # Load generator code
+    generator_code = None
+    if os.path.isfile(generator_code_or_path):
+        try:
+            with open(generator_code_or_path, 'r') as f:
+                generator_code = f.read()
+        except Exception as e:
+            yield None, f"Failed to read generator file: {str(e)}"
+            return
+    else:
+        # Assume it's code directly
+        generator_code = generator_code_or_path
+    
+    # Execute the generator code to get the function
+    gen_namespace = {}
+    try:
+        exec(generator_code, gen_namespace)
+    except Exception as e:
+        yield None, f"Failed to execute generator code: {str(e)}"
+        return
+    
+    if 'enumerate_inputs' not in gen_namespace:
+        yield None, "Generator code must define enumerate_inputs(max_n) function"
+        return
+    
+    enumerate_func = gen_namespace['enumerate_inputs']
+    
+    # Call enumerate_inputs and yield each result
+    try:
+        for test_input in enumerate_func(max_n):
+            yield test_input, None
+    except Exception as e:
+        yield None, f"Enumeration error: {str(e)}"
+
+
+def tool_function(
+    solution_path,
+    brute_path,
+    generator_code_or_path,
+    max_n,
+    timeout=5
+):
+    """
+    Exhaustively test the solution on all enumerated tiny inputs.
+    Returns raw results: input count, mismatch count, and first mismatch details.
+    """
+    
+    results = []
+    results.append(f"=== EXHAUSTIVE CHECK: max_n={max_n}, timeout={timeout}s ===\n\n")
+    
+    first_mismatch = None
+    input_count = 0
+    mismatch_count = 0
+    
+    # Enumerate all inputs
+    for test_input, gen_error in _enumerate_inputs(generator_code_or_path, max_n):
+        if gen_error:
+            results.append(f"ENUMERATION ERROR: {gen_error}\n")
+            return "".join(results)
+        
+        if test_input is None:
+            # End of enumeration
+            break
+        
+        input_count += 1
+        
+        # Run solution
+        sol_elapsed, sol_output, sol_timeout, sol_error = _run_solution_on_input(solution_path, test_input, timeout)
+        
+        # Run brute force
+        brute_elapsed, brute_output, brute_timeout, brute_error = _run_solution_on_input(brute_path, test_input, timeout)
+        
+        # Compare results
+        is_mismatch = False
+        
+        if sol_timeout:
+            is_mismatch = True
+            sol_result = 'TIMEOUT'
+        elif sol_error:
+            is_mismatch = True
+            sol_result = f'ERROR: {sol_error}'
+        else:
+            sol_result = sol_output
+        
+        if brute_timeout:
+            is_mismatch = True
+            brute_result = 'TIMEOUT'
+        elif brute_error:
+            is_mismatch = True
+            brute_result = f'ERROR: {brute_error}'
+        else:
+            brute_result = brute_output
+        
+        # Check for output mismatch (only if both succeeded)
+        if not sol_timeout and not sol_error and not brute_timeout and not brute_error:
+            if sol_output.strip() != brute_output.strip():
+                is_mismatch = True
+        
+        if is_mismatch:
+            mismatch_count += 1
+            if first_mismatch is None:
+                first_mismatch = {
+                    'input': test_input,
+                    'solution': sol_result,
+                    'brute': brute_result,
+                    'input_num': input_count
+                }
+    
+    # Summary
+    results.append(f"=== SUMMARY ===\n")
+    results.append(f"Inputs checked: {input_count}\n")
+    results.append(f"Mismatches: {mismatch_count}\n")
+    
+    if first_mismatch:
+        results.append(f"\n=== FIRST MISMATCH (Input #{first_mismatch['input_num']}) ===\n")
+        results.append(f"Input:\n{first_mismatch['input']}\n")
+        results.append(f"Solution output:\n{first_mismatch['solution']}\n")
+        results.append(f"Brute-force output:\n{first_mismatch['brute']}\n")
+    else:
+        if input_count > 0:
+            results.append(f"\nAll {input_count} inputs matched!\n")
+        else:
+            results.append(f"\nNo inputs were enumerated.\n")
+    
+    return "".join(results)
+
+
+if __name__ == "__main__":
+    # Example usage for testing
+    pass
