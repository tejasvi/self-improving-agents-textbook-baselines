+import subprocess
+import sys
+import re
+import os
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run sample inputs and outputs from a problem statement against a solution.
+Parses 'Sample Input N' / 'Sample Output N' blocks from the problem statement, runs a standalone program on each via stdin,
+and returns a plain-text report of PASS/FAIL, expected vs actual output, and stderr.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to test"
+                },
+                "problem_statement": {
+                    "type": "string",
+                    "description": "The problem statement text containing Sample Input/Output blocks"
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout per sample in seconds (default: 5.0)"
+                },
+                "samples": {
+                    "type": "string",
+                    "description": "Optional: Raw sample text to parse instead of extracting from problem_statement"
+                }
+            },
+            "required": ["solution_path", "problem_statement"]
+        }
+    }
+
+def tool_function(solution_path, problem_statement, timeout_seconds=5.0, samples=""):
+    """
+    Parse sample inputs/outputs and run them against a solution.
+    
+    Args:
+        solution_path: Path to the Python solution file
+        problem_statement: The problem statement text
+        timeout_seconds: Timeout per sample (default 5.0)
+        samples: Optional raw sample text to parse instead of problem_statement
+    
+    Returns:
+        Plain-text report of test results
+    """
+    try:
+        # Check if solution file exists
+        if not os.path.exists(solution_path):
+            return f"Error: Solution file not found: {solution_path}"
+        
+        # Determine what text to parse
+        text_to_parse = samples if samples else problem_statement
+        
+        # Extract sample input/output pairs
+        # Pattern: "Sample Input N\n(.*?)\n\s*Sample Output N\n(.*?)(?=\n\s*(Sample Input|Explanation|$))"
+        pattern = r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*(Sample Input|Explanation|$))'
+        matches = list(re.finditer(pattern, text_to_parse, re.DOTALL))
+        
+        if not matches:
+            return "No sample input/output pairs found in the problem statement."
+        
+        results = []
+        passed_count = 0
+        failed_count = 0
+        
+        for match in matches:
+            sample_num = match.group(1)
+            sample_input = match.group(2)
+            sample_output = match.group(3)
+            
+            # Normalize the expected output (strip trailing whitespace from each line)
+            expected_lines = [line.rstrip() for line in sample_output.split('\n')]
+            expected_normalized = '\n'.join(expected_lines).strip()
+            
+            # Run the solution on this input
+            try:
+                result = subprocess.run(
+                    [sys.executable, solution_path],
+                    input=sample_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout_seconds
+                )
+                
+                # Normalize actual output
+                actual_lines = [line.rstrip() for line in result.stdout.split('\n')]
+                actual_normalized = '\n'.join(actual_lines).strip()
+                
+                # Compare
+                if actual_normalized == expected_normalized:
+                    results.append(f"Sample {sample_num}: PASS")
+                    passed_count += 1
+                else:
+                    results.append(
+                        f"Sample {sample_num}: FAIL\n"
+                        f"  Expected:\n{repr(expected_normalized)}\n"
+                        f"  Actual:\n{repr(actual_normalized)}"
+                    )
+                    failed_count += 1
+                
+                # Include stderr if there's an error
+                if result.returncode != 0:
+                    results.append(f"  Return code: {result.returncode}")
+                    if result.stderr:
+                        results.append(f"  Stderr: {result.stderr[:200]}")
+                elif result.stderr:
+                    results.append(f"  Stderr: {result.stderr[:200]}")
+            
+            except subprocess.TimeoutExpired:
+                results.append(f"Sample {sample_num}: TIMEOUT (exceeded {timeout_seconds}s)")
+                failed_count += 1
+            except Exception as e:
+                results.append(f"Sample {sample_num}: ERROR - {str(e)}")
+                failed_count += 1
+        
+        # Format output
+        output = f"Sample Test Results ({passed_count}/{len(matches)} passed)\n"
+        output += "=" * 60 + "\n"
+        output += "\n".join(results)
+        
+        return output
+    
+    except Exception as e:
+        return f"Error running samples: {str(e)}"
