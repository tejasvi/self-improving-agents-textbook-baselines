+import pytest
+import tempfile
+import os
+from tools.run_samples import tool_info, tool_function
+
+
+class TestRunSamplesTool:
+    """Test the run_samples tool"""
+    
+    def test_tool_info(self):
+        """Test that tool_info returns correct structure"""
+        info = tool_info()
+        assert info['name'] == 'run_samples'
+        assert 'description' in info
+        assert 'input_schema' in info
+        
+        schema = info['input_schema']
+        assert schema['type'] == 'object'
+        assert 'properties' in schema
+        assert 'required' in schema
+        
+        # Check required fields
+        assert 'solution_path' in schema['required']
+        assert 'problem_statement' in schema['required']
+        
+        # Check properties
+        props = schema['properties']
+        assert 'solution_path' in props
+        assert 'problem_statement' in props
+        assert 'timeout_seconds' in props
+        
+        # Verify each property has type and description
+        for prop_name, prop_def in props.items():
+            assert 'type' in prop_def, f"{prop_name} missing 'type'"
+            assert 'description' in prop_def, f"{prop_name} missing 'description'"
+    
+    def test_simple_passing_case(self):
+        """Test a simple case where solution passes all samples"""
+        problem = """
+Sample Input 1
+5
+2
+Sample Output 1
+7
+
+Sample Input 2
+10
+3
+Sample Output 2
+13
+"""
+        
+        # Create a simple solution that adds two numbers
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+            f.write("""
+import sys
+lines = sys.stdin.read().strip().split('\\n')
+a = int(lines[0])
+b = int(lines[1])
+print(a + b)
+""")
+            solution_path = f.name
+        
+        try:
+            result = tool_function(solution_path, problem)
+            assert "Sample Test Results" in result
+            assert "2/2 passed" in result
+            assert "PASS" in result
+        finally:
+            os.unlink(solution_path)
+    
+    def test_failing_case(self):
+        """Test a case where solution fails samples"""
+        problem = """
+Sample Input 1
+5
+2
+Sample Output 1
+7
+
+Sample Input 2
+10
+3
+Sample Output 2
+13
+"""
+        
+        # Create a solution that gives wrong answers
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+            f.write("""
+import sys
+lines = sys.stdin.read().strip().split('\\n')
+a = int(lines[0])
+b = int(lines[1])
+print(a * b)  # Multiply instead of add
+""")
+            solution_path = f.name
+        
+        try:
+            result = tool_function(solution_path, problem)
+            assert "Sample Test Results" in result
+            assert "0/2 passed" in result
+            assert "FAIL" in result
+        finally:
+            os.unlink(solution_path)
+    
+    def test_no_samples(self):
+        """Test handling of problem statement with no samples"""
+        problem = "This problem has no samples"
+        
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+            f.write("print('hello')")
+            solution_path = f.name
+        
+        try:
+            result = tool_function(solution_path, problem)
+            assert "No sample input/output pairs found" in result
+        finally:
+            os.unlink(solution_path)
+    
+    def test_missing_solution_file(self):
+        """Test handling of missing solution file"""
+        problem = "Sample problem"
+        solution_path = "/nonexistent/path/solution.py"
+        
+        result = tool_function(solution_path, problem)
+        assert "Error" in result
+        assert "not found" in result
+    
+    def test_whitespace_normalization(self):
+        """Test that whitespace is properly normalized"""
+        problem = """
+Sample Input 1
+10
+Sample Output 1
+100
+
+"""
+        
+        # Solution that adds extra whitespace
+        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+            f.write("""
+import sys
+n = int(sys.stdin.read().strip())
+print(n * n)
+print()  # Extra blank line
+""")
+            solution_path = f.name
+        
+        try:
+            result = tool_function(solution_path, problem)
+            assert "PASS" in result
+        finally:
+            os.unlink(solution_path)
+    
+    def test_multiple_samples(self):
+        """Test parsing of multiple samples"""
+        problem = """
+Sample Input 1
+1
+Sample Output 1
+1
+
+Sample Input 2
+2
+Sample Output 2
+4
+
+Sample Input 3
+3
+Sample Output 3
