+"""
+Utility functions for running subprocess commands with timeout.
+"""
+import subprocess
+import sys
+
+
+def run_with_timeout(command, timeout_seconds=10, cwd=None):
+    """
+    Run a shell command with a timeout and return raw stdout/stderr.
+    
+    Args:
+        command: Command string to run in shell
+        timeout_seconds: Timeout in seconds (default 10)
+        cwd: Working directory for the command (optional)
+    
+    Returns:
+        A tuple of (returncode, stdout, stderr) where:
+        - returncode: Exit code of the process
+        - stdout: Raw stdout output as string
+        - stderr: Raw stderr output as string
+    """
+    try:
+        result = subprocess.run(
+            command,
+            shell=True,
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds
+        )
+        return result.returncode, result.stdout, result.stderr
+    except subprocess.TimeoutExpired:
+        # Return a timeout indicator
+        return -1, "", f"TIMEOUT after {timeout_seconds} seconds"
+    except Exception as e:
+        return -1, "", str(e)
