+import subprocess
+import sys
+import time
+import os
+import json
+import traceback
+
+def tool_info():
+    return {
+        "name": "method_benchmark",
+        "description": """Benchmark a Solution class method on custom inputs with timing.
+Imports a solution module, evaluates a Python expression to generate arguments, instantiates Solution,
+times the method call with time.perf_counter, and reports wall-clock time, result preview, or TIMEOUT/traceback.
+This tool is designed for class-based tasks where the solution implements a method of a Solution class.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python file containing the Solution class"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the method to benchmark (e.g., 'timeRequiredToBuy')"
+                },
+                "args_expr": {
+                    "type": "string",
+                    "description": "Python expression that evaluates to a list of positional arguments. Variables 'random' and 'math' are available. Example: '[[random.randint(1,10**5) for _ in range(10**5)]]'"
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Timeout in seconds (e.g., 5.0)"
+                },
+                "setup_code": {
+                    "type": "string",
+                    "description": "Optional Python code to run before evaluating args_expr (e.g., to set up helper functions or variables)"
+                }
+            },
+            "required": ["solution_path", "method_name", "args_expr", "timeout_seconds"]
+        }
+    }
+
+def tool_function(solution_path, method_name, args_expr, timeout_seconds, setup_code=None):
+    """
+    Benchmark a Solution class method on custom inputs.
+    
+    Args:
+        solution_path: Path to solution file containing Solution class
+        method_name: Name of method to benchmark
+        args_expr: Python expression that evaluates to list of arguments
+        timeout_seconds: Timeout in seconds
+        setup_code: Optional setup code to run before evaluation
+    
+    Returns:
+        String containing benchmark results or error messages
+    """
+    try:
+        solution_path = os.path.abspath(solution_path)
+        
+        if not os.path.exists(solution_path):
+            return f"Error: Solution file not found: {solution_path}"
+        
+        # Create a runner script that:
+        # 1. Imports the module
+        # 2. Runs setup_code if provided
+        # 3. Evaluates args_expr to get arguments
+        # 4. Instantiates Solution and calls the method
+        # 5. Times the call and returns result
+        
+        runner_code = f"""
+import sys
+import json
+import importlib.util
+import time
+import random
+import math
+
+# Import the solution module
+spec = importlib.util.spec_from_file_location("solution_module", {repr(solution_path)})
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+# Get the Solution class
+Solution = getattr(module, 'Solution')
+
+# Run setup code if provided
+setup_code = {repr(setup_code)}
+if setup_code:
+    exec(setup_code)
+
+# Evaluate args_expr to get arguments
+args_expr = {repr(args_expr)}
+args = eval(args_expr)
+
+# Ensure args is a list
+if not isinstance(args, list):
+    raise ValueError(f"args_expr must evaluate to a list, got {{type(args).__name__}}")
+
+# Instantiate Solution and time the method call
+instance = Solution()
+method = getattr(instance, {repr(method_name)})
+
+start_time = time.perf_counter()
+try:
+    result = method(*args)
+    elapsed_time = time.perf_counter() - start_time
+except Exception as e:
+    elapsed_time = time.perf_counter() - start_time
+    raise
+    
+# Format result preview (truncate if too long)
+result_str = str(result)
+if len(result_str) > 200:
+    result_preview = result_str[:200] + "... (truncated)"
+else:
+    result_preview = result_str
+
+# Output as JSON
+output = {{
+    "time": elapsed_time,
+    "result_preview": result_preview,
+    "status": "OK"
+}}
+print(json.dumps(output))
+"""
+        
+        try:
+            # Run the runner script with timeout
+            result = subprocess.run(
+                [sys.executable, '-c', runner_code],
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            
+            if result.returncode != 0:
+                # Command failed, return error with stderr
+                return f"ERROR: Method execution failed\nStderr: {result.stderr}"
+            
+            # Parse the JSON output
+            try:
+                output_json = json.loads(result.stdout.strip())
+                elapsed_time = output_json.get('time', 0)
+                result_preview = output_json.get('result_preview', '(no result)')
+                
+                return f"OK time={elapsed_time:.3f}s\nResult preview: {result_preview}"
+            
+            except json.JSONDecodeError:
+                # Output is not valid JSON, return raw output
+                return f"Error parsing output: {result.stdout}\nStderr: {result.stderr}"
+        
+        except subprocess.TimeoutExpired:
+            return f"TIMEOUT: Method exceeded {timeout_seconds}s"
+        
+    except Exception as e:
+        return f"Error running benchmark: {str(e)}\n{traceback.format_exc()}"
