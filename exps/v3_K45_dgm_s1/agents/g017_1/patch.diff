+"""
+Validation tests to ensure all implementation requirements are met.
+"""
+import os
+import pytest
+
+
+class TestImplementationValidation:
+    """Validate that all requested changes have been implemented correctly."""
+    
+    def test_method_benchmark_tool_exists(self):
+        """Verify method_benchmark.py tool file exists."""
+        tool_path = '/dgm/tools/method_benchmark.py'
+        assert os.path.exists(tool_path), f"method_benchmark.py not found at {tool_path}"
+    
+    def test_method_benchmark_has_required_functions(self):
+        """Verify method_benchmark has tool_info and tool_function."""
+        from tools.method_benchmark import tool_info, tool_function
+        
+        # Verify tool_info is callable
+        assert callable(tool_info)
+        info = tool_info()
+        assert isinstance(info, dict)
+        
+        # Verify tool_function is callable
+        assert callable(tool_function)
+    
+    def test_method_benchmark_schema_correctness(self):
+        """Verify schema has correct nesting: type/description at property level, required at schema level."""
+        from tools.method_benchmark import tool_info
+        
+        info = tool_info()
+        schema = info['input_schema']
+        
+        # Check top-level structure
+        assert schema['type'] == 'object'
+        assert 'properties' in schema
+        assert 'required' in schema
+        
+        # Check each property has type and description (not nested)
+        for prop_name, prop_def in schema['properties'].items():
+            assert 'type' in prop_def, f"Property {prop_name} missing 'type'"
+            assert 'description' in prop_def, f"Property {prop_name} missing 'description'"
+            # Type and description should be strings, not nested objects
+            assert isinstance(prop_def['type'], str)
+            assert isinstance(prop_def['description'], str)
+    
+    def test_method_benchmark_required_fields(self):
+        """Verify correct fields are required."""
+        from tools.method_benchmark import tool_info
+        
+        info = tool_info()
+        schema = info['input_schema']
+        required = schema['required']
+        
+        # These should be required
+        assert 'solution_path' in required
+        assert 'method_name' in required
+        assert 'args_expr' in required
+        assert 'timeout_seconds' in required
+        
+        # setup_code should NOT be required
+        assert 'setup_code' not in required
+    
+    def test_phase_a_has_operation_budget_requirement(self):
+        """Verify Phase A prompt includes operation budget requirement."""
+        with open('/dgm/coding_agent.py', 'r') as f:
+            content = f.read()
+        
+        assert 'operation budget' in content.lower()
+        assert '1e7' in content or '1e8' in content
+        assert 'CRITICAL' in content
+    
+    def test_phase_b_references_method_benchmark(self):
+        """Verify Phase B mentions method_benchmark for class-based tasks."""
+        with open('/dgm/coding_agent.py', 'r') as f:
+            content = f.read()
+        
+        # Check Phase B exists and references method_benchmark
+        assert 'PHASE B' in content
+        assert 'method_benchmark' in content
+        assert 'class-based tasks' in content
