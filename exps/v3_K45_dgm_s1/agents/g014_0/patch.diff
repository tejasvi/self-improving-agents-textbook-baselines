+   - Update /tmp/stress_test.py and /tmp/perf_test.py as needed
+   - Re-run both test files
+
+4. **If all tests pass**:
+   - Confirm that stress_test.py runs without errors/timeouts
+   - Confirm that perf_test.py completes in under 10 seconds with all tests passing
+   - The solution is ready
+
+Report clearly:
+- Whether all tests passed
+- Elapsed time for performance tests
+- Any changes made in this iteration
+- Whether you're done or need another iteration
+
+Current state of edits:
+{str(current_edits[0]['content'][0]['text']) if current_edits and current_edits[0]['content'] else 'No edits yet'}
+"""
+            
+            # Run the review phase
+            review_edits = chat_with_agent(review_instruction, model=self.code_model, msg_history=[], logging=safe_log)
+            
+            # After iteration 5 or if we determine tests are passing, stop iterating
+            if iteration >= 5:
+                safe_log(f"\n=== Reached maximum iterations ({iteration}). Completing verification. ===")
+                break
 
