+import subprocess
+import time
+
+def tool_info():
+    return {
+        "name": "run_with_timeout",
+        "description": """Run a shell command with a timeout and capture output, elapsed time, and timeout status.
+* Returns stdout, stderr, elapsed time in seconds, and whether the command timed out.
+* The timeout is a hard limit enforced by the OS.
+* Useful for testing performance and catching infinite loops or slow operations.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The bash command to run. Can be a full bash script with pipes, redirects, etc."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Maximum time in seconds to allow the command to run. If exceeded, the command is terminated and timed_out flag is True."
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Working directory to run the command in. Defaults to current directory if not specified."
+                }
+            },
+            "required": ["command", "timeout_seconds"]
+        }
+    }
+
+def tool_function(command, timeout_seconds, cwd=None):
+    """
+    Execute a command with a timeout and return results including elapsed time and timeout status.
+    
+    Returns a string with the results in the format:
+    STDOUT: <stdout>
+    STDERR: <stderr>
+    ELAPSED: <elapsed_seconds>
+    TIMED_OUT: <true/false>
+    """
+    start_time = time.time()
+    
+    try:
+        result = subprocess.run(
+            command,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+            cwd=cwd
+        )
+        elapsed = time.time() - start_time
+        
+        output = f"STDOUT:\n{result.stdout}\n" if result.stdout else "STDOUT:\n"
+        output += f"STDERR:\n{result.stderr}\n" if result.stderr else "STDERR:\n"
+        output += f"ELAPSED: {elapsed:.2f} seconds\n"
+        output += "TIMED_OUT: false"
+        
+        return output.rstrip()
+    
+    except subprocess.TimeoutExpired:
+        elapsed = time.time() - start_time
+        output = "STDOUT:\n(command exceeded timeout)\n"
+        output += f"STDERR:\n(command was terminated after {timeout_seconds}s)\n"
+        output += f"ELAPSED: {elapsed:.2f} seconds\n"
+        output += "TIMED_OUT: true"
+        return output.rstrip()
+    
+    except Exception as e:
+        elapsed = time.time() - start_time
+        return f"STDOUT:\nSTDERR:\nError executing command: {str(e)}\nELAPSED: {elapsed:.2f} seconds\nTIMED_OUT: false"
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 3:
+        print("Usage: python run_with_timeout.py '<command>' <timeout_seconds> [cwd]")
+    else:
+        cmd = sys.argv[1]
+        timeout = float(sys.argv[2])
+        work_dir = sys.argv[3] if len(sys.argv) > 3 else None
+        result = tool_function(cmd, timeout, work_dir)
+        print(result)
