+"""
+Tool for running a solution against sample test cases from the problem statement.
+Compares solution output with expected output after whitespace normalization.
+"""
+
+import os
+import time
+import glob
+from pathlib import Path
+
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution against sample test cases.
+Finds all *.in files in the samples directory, runs the solution with each as stdin,
+and compares stdout against matching *.out files after whitespace normalization.
+Returns raw report per sample (PASS/FAIL, elapsed time, input, expected, actual, stderr)
+plus a final summary line. No error parsing, only raw text.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to test (Python script)"
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Path to the directory containing sample_*.in and sample_*.out files"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test in seconds (default 5)"
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+
+def _normalize_output(output):
+    """Normalize whitespace for comparison."""
+    return '\n'.join(line.rstrip() for line in output.strip().split('\n')).strip()
+
+
+def tool_function(solution_path, samples_dir, timeout=5):
+    """
+    Run the solution against all sample files in samples_dir.
+    Returns a raw report with pass/fail status and details for each sample.
+    """
+    
+    results = []
+    
+    # Validate inputs
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found at {solution_path}"
+    
+    if not os.path.isdir(samples_dir):
+        return f"Error: samples directory not found at {samples_dir}"
+    
+    # Find all .in files
+    in_files = sorted(glob.glob(os.path.join(samples_dir, "sample_*.in")))
+    
+    if not in_files:
+        return f"Error: no sample_*.in files found in {samples_dir}"
+    
+    passed = 0
+    failed = 0
+    
+    for in_file in in_files:
+        # Determine expected output file
+        base_name = os.path.basename(in_file)
+        out_file = os.path.join(samples_dir, base_name.replace('.in', '.out'))
+        
+        if not os.path.isfile(out_file):
+            results.append(f"\n{base_name}: SKIP (no matching .out file)")
+            continue
+        
+        # Read input and expected output
+        with open(in_file, 'r') as f:
+            test_input = f.read()
+        
+        with open(out_file, 'r') as f:
+            expected_output = f.read()
+        
+        # Run solution
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {os.path.abspath(solution_path)}",
+            timeout_seconds=timeout,
+            cwd=os.path.dirname(os.path.abspath(solution_path)),
+            input_data=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        # Normalize and compare
+        expected_normalized = _normalize_output(expected_output)
+        actual_normalized = _normalize_output(stdout)
+        
+        # Build report for this sample
+        report_lines = []
+        report_lines.append(f"\n{base_name}:")
+        
+        if "TIMEOUT" in stderr:
+            report_lines.append(f"  Status: TIMEOUT (>= {timeout}s)")
+            report_lines.append(f"  Elapsed: {elapsed:.2f}s")
+            failed += 1
+        elif expected_normalized == actual_normalized:
+            report_lines.append(f"  Status: PASS")
+            report_lines.append(f"  Elapsed: {elapsed:.2f}s")
+            passed += 1
+        else:
+            report_lines.append(f"  Status: FAIL")
+            report_lines.append(f"  Elapsed: {elapsed:.2f}s")
+            failed += 1
+        
+        # Always include input, expected, and actual for debugging
+        report_lines.append(f"  Input:")
+        for line in test_input.split('\n')[:10]:  # Show first 10 lines
+            report_lines.append(f"    {line}")
+        if test_input.count('\n') > 10:
+            report_lines.append(f"    ... ({test_input.count(chr(10))} lines total)")
+        
+        report_lines.append(f"  Expected:")
+        for line in expected_normalized.split('\n')[:10]:
+            report_lines.append(f"    {line}")
+        if expected_normalized.count('\n') > 10:
+            report_lines.append(f"    ... ({expected_normalized.count(chr(10))} lines total)")
+        
+        report_lines.append(f"  Actual:")
+        for line in actual_normalized.split('\n')[:10]:
+            report_lines.append(f"    {line}")
+        if actual_normalized.count('\n') > 10:
+            report_lines.append(f"    ... ({actual_normalized.count(chr(10))} lines total)")
+        
+        if stderr and "TIMEOUT" not in stderr:
+            report_lines.append(f"  Stderr:")
+            for line in stderr.split('\n')[:5]:
+                report_lines.append(f"    {line}")
+        
+        results.append('\n'.join(report_lines))
+    
+    # Final summary
+    total = passed + failed
+    summary_lines = []
+    summary_lines.append("\n" + "=" * 60)
+    summary_lines.append(f"SAMPLE TEST RESULTS: {passed} passed, {failed} failed out of {total}")
+    summary_lines.append("=" * 60)
+    
+    if failed == 0:
+        summary_lines.append("ALL SAMPLES PASSED")
+    else:
+        summary_lines.append(f"{failed} SAMPLES FAILED")
+    
+    results.append('\n'.join(summary_lines))
+    
+    return ''.join(results)
+
+
+if __name__ == "__main__":
+    # Example usage
+    import sys
+    
+    if len(sys.argv) < 3:
+        print("Usage: python run_samples.py <solution_path> <samples_dir> [timeout]")
+    else:
+        solution_path = sys.argv[1]
+        samples_dir = sys.argv[2]
+        timeout = int(sys.argv[3]) if len(sys.argv) > 3 else 5
+        
+        result = tool_function(solution_path, samples_dir, timeout)
+        print(result)
