+"""
+Tool for benchmarking competitive programming solutions at multiple sizes.
+Runs a solution with various input sizes and reports timing and exit codes.
+"""
+
+import os
+import time
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "benchmark_solution",
+        "description": """Benchmark a competitive programming solution across multiple input sizes.
+For each size, generates an input, runs the solution with a timeout, and returns the raw elapsed time, exit code, stdout snippet and stderr.
+Does not parse or interpret errors; returns raw output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to benchmark (Python script)"
+                },
+                "input_generator_code_or_path": {
+                    "type": "string",
+                    "description": "Either a Python code snippet or path to a file that defines generator_input(n, seed) function returning a test input as a string"
+                },
+                "sizes": {
+                    "type": "array",
+                    "items": {
+                        "type": "integer"
+                    },
+                    "description": "List of input sizes (N values) to benchmark"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test execution in seconds (default 5)"
+                },
+                "runs_per_size": {
+                    "type": "integer",
+                    "description": "Number of runs per size (default 1)"
+                }
+            },
+            "required": ["solution_path", "input_generator_code_or_path", "sizes"]
+        }
+    }
+
+
+def _load_generator(generator_code_or_path):
+    """
+    Load and return the generator_input function from code or file.
+    Returns (generator_func, error_msg)
+    """
+    generator_code = None
+    if os.path.isfile(generator_code_or_path):
+        try:
+            with open(generator_code_or_path, 'r') as f:
+                generator_code = f.read()
+        except Exception as e:
+            return None, f"Failed to read generator file: {str(e)}"
+    else:
+        # Assume it's code directly
+        generator_code = generator_code_or_path
+    
+    # Execute the generator code to get a function
+    gen_namespace = {}
+    try:
+        exec(generator_code, gen_namespace)
+    except Exception as e:
+        return None, f"Failed to execute generator code: {str(e)}"
+    
+    if 'generator_input' not in gen_namespace:
+        return None, "Generator code must define generator_input(n, seed) function"
+    
+    return gen_namespace['generator_input'], None
+
+
+def _generate_input(generator_func, n, seed):
+    """
+    Generate a single test input.
+    Returns (test_input, error_msg)
+    """
+    try:
+        test_input = generator_func(n, seed)
+        return test_input, None
+    except Exception as e:
+        return None, f"Generator error: {str(e)}"
+
+
+def _run_solution_on_input(solution_path, test_input, timeout_sec):
+    """
+    Run a solution on a single test input.
+    Returns (elapsed_time_sec, return_code, stdout_snippet, stderr)
+    """
+    try:
+        # Ensure solution_path is absolute
+        abs_path = os.path.abspath(solution_path)
+        if not os.path.isfile(abs_path):
+            return 0, -1, "", f"Solution file not found: {abs_path}"
+        
+        # Run as a Python script
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {abs_path}",
+            timeout_seconds=timeout_sec,
+            cwd=os.path.dirname(abs_path),
+            input_data=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        # Prepare stdout snippet (first 100 chars)
+        stdout_snippet = stdout[:100] if stdout else ""
+        
+        return elapsed, returncode, stdout_snippet, stderr
+    
+    except Exception as e:
+        return 0, -1, "", f"Error running solution: {str(e)}"
+
+
+def tool_function(
+    solution_path,
+    input_generator_code_or_path,
+    sizes,
+    timeout=5,
+    runs_per_size=1
+):
+    """
+    Benchmark the solution across multiple sizes.
+    Returns raw results with timing and error information.
+    """
+    
+    results = []
+    
+    # Load generator
+    generator_func, gen_error = _load_generator(input_generator_code_or_path)
+    if gen_error:
+        return f"Generator error: {gen_error}"
+    
+    results.append(f"Benchmarking {os.path.basename(solution_path)}\n")
+    results.append(f"Timeout: {timeout}s per run, Runs per size: {runs_per_size}\n\n")
+    results.append("=" * 80 + "\n")
+    
+    # Benchmark each size
+    for size in sizes:
+        results.append(f"\nSize N={size}:\n")
+        times = []
+        
+        for run in range(runs_per_size):
+            # Generate input
+            test_input, gen_error = _generate_input(generator_func, size, run)
+            if gen_error:
+                results.append(f"  Run {run + 1}: GENERATOR ERROR: {gen_error}\n")
+                continue
+            
+            # Run solution
+            elapsed, returncode, stdout_snippet, stderr = _run_solution_on_input(solution_path, test_input, timeout)
+            
+            if returncode == -1 and "TIMEOUT" in stderr:
+                results.append(f"  Run {run + 1}: TIMEOUT (>= {timeout}s)\n")
+            elif returncode != 0:
+                results.append(f"  Run {run + 1}: EXIT CODE {returncode}, elapsed={elapsed:.3f}s\n")
+                if stderr:
+                    results.append(f"    Stderr: {stderr[:200]}\n")
+            else:
+                results.append(f"  Run {run + 1}: OK, elapsed={elapsed:.3f}s")
+                if stdout_snippet:
+                    results.append(f" (output: {repr(stdout_snippet[:50])})")
+                results.append("\n")
+                times.append(elapsed)
+        
+        # Summary for this size
+        if times:
+            avg_time = sum(times) / len(times)
+            min_time = min(times)
+            max_time = max(times)
+            results.append(f"  Summary: min={min_time:.3f}s, avg={avg_time:.3f}s, max={max_time:.3f}s\n")
+    
+    results.append("\n" + "=" * 80 + "\n")
+    results.append("Benchmark complete.\n")
+    
+    return "".join(results)
+
+
+if __name__ == "__main__":
+    # Example usage for testing
+    pass
