+++ b/tools/verify_solution.py
@@ -0,0 +1,381 @@
+import subprocess
+import os
+import sys
+import json
+import tempfile
+import time
+from pathlib import Path
+
+def tool_info():
+    return {
+        "name": "verify_solution",
+        "description": """Run a comprehensive verification of a solution against samples, brute-force reference, and performance benchmarks.
+Supports both stdin-based programs and Solution class methods. Returns a plain-text report with sample pass rates,
+brute-force test results, and timing information, plus a final SCORE line.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Absolute path to the solution file (Python script with stdin/stdout or Solution class)"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Absolute path to the brute-force reference file (Python script with stdin/stdout)"
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Absolute path to the random input generator script (takes seed as arg 0, outputs test case)"
+                },
+                "samples_json_path": {
+                    "type": "string",
+                    "description": "Absolute path to JSON file containing sample test cases, with format: {'samples': [{'input': ..., 'expected': ...}, ...]}"
+                },
+                "max_input_path": {
+                    "type": "string",
+                    "description": "Optional: path to max-size input file for performance testing"
+                },
+                "num_small_tests": {
+                    "type": "integer",
+                    "description": "Number of small random tests to run against brute-force (e.g., 50)"
+                },
+                "time_limit": {
+                    "type": "number",
+                    "description": "Time limit in seconds per test (e.g., 2.0)"
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path", "samples_json_path", "num_small_tests", "time_limit"]
+        }
+    }
+
+
+def _detect_method_class(solution_path):
+    """
+    Detect if solution_path is a Solution class with methods.
+    Returns (is_method_based, method_name) where method_name is the method to call if is_method_based is True.
+    """
+    if not solution_path.endswith('.py'):
+        return False, None
+    
+    try:
+        with open(solution_path, 'r') as f:
+            content = f.read()
+        
+        # Check for class Solution
+        if 'class Solution' in content:
+            # Try to find method names (common ones)
+            for method_name in ['solve', 'run', 'process', 'result']:
+                if f'def {method_name}(' in content:
+                    return True, method_name
+            
+            # If no common method found, extract the first public method
+            import re
+            methods = re.findall(r'def (\w+)\(self', content)
+            if methods and methods[0] != '__init__':
+                return True, methods[0]
+        
+        return False, None
+    except Exception:
+        return False, None
+
+
+def _run_solution_stdin(solution_path, test_input, timeout):
+    """Run solution as stdin/stdout program."""
+    try:
+        start = time.time()
+        result = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout
+        )
+        elapsed = time.time() - start
+        return result.stdout, result.stderr, result.returncode, elapsed, None
+    except subprocess.TimeoutExpired:
+        return None, None, -1, timeout, "TIMEOUT"
+    except Exception as e:
+        return None, None, -1, 0, str(e)
+
+
+def _run_solution_method(solution_path, method_name, args, timeout):
+    """Run solution as Solution class method."""
+    try:
+        # Create a wrapper script that imports and calls the method
+        wrapper = f"""
+import sys
+import json
+
+# Import the Solution class
+sys.path.insert(0, '{os.path.dirname(solution_path)}')
+from {Path(solution_path).stem} import Solution
+
+# Parse input
+args = json.loads(sys.stdin.read())
+sol = Solution()
+method = getattr(sol, '{method_name}')
+result = method(*args)
+print(result)
+"""
+        start = time.time()
+        result = subprocess.run(
+            [sys.executable, '-c', wrapper],
+            input=json.dumps(args),
+            capture_output=True,
+            text=True,
+            timeout=timeout
+        )
+        elapsed = time.time() - start
+        return result.stdout, result.stderr, result.returncode, elapsed, None
+    except subprocess.TimeoutExpired:
+        return None, None, -1, timeout, "TIMEOUT"
+    except Exception as e:
+        return None, None, -1, 0, str(e)
+
+
+def tool_function(solution_path, brute_path, gen_path, samples_json_path, 
+                   num_small_tests, time_limit, max_input_path=None):
+    """
+    Comprehensive solution verification.
+    
+    Returns a plain-text report with:
+    - Sample test results
+    - Brute-force comparison results
+    - Performance timing
+    - Final SCORE line
+    """
+    try:
+        report = []
+        
+        # Detect if solution is method-based
+        is_method_based, method_name = _detect_method_class(solution_path)
+        
+        # ==================== SAMPLE TESTS ====================
+        report.append("=" * 60)
+        report.append("SAMPLE TESTS")
+        report.append("=" * 60)
+        
+        samples_passed = 0
+        samples_total = 0
+        first_sample_fail = None
+        
+        try:
+            with open(samples_json_path, 'r') as f:
+                samples_data = json.load(f)
+            samples = samples_data.get('samples', [])
+        except Exception as e:
+            report.append(f"Error loading samples: {e}")
+            samples = []
+        
+        for i, sample in enumerate(samples):
+            samples_total += 1
+            test_input = sample.get('input', '')
+            expected = sample.get('expected', '').strip()
+            
+            if is_method_based and method_name:
+                # For method-based, parse input as JSON args
+                try:
+                    args = json.loads(test_input)
+                    actual, stderr, rc, elapsed, error = _run_solution_method(
+                        solution_path, method_name, args, time_limit
+                    )
+                except Exception as parse_err:
+                    actual, stderr, rc, elapsed, error = None, str(parse_err), -1, 0, "Parse error"
+            else:
+                actual, stderr, rc, elapsed, error = _run_solution_stdin(
+                    solution_path, test_input, time_limit
+                )
+            
+            if error:
+                status = f"FAIL ({error})"
+                if not first_sample_fail:
+                    first_sample_fail = (i, test_input, expected, actual or "(no output)", error)
+            elif rc != 0:
+                status = f"FAIL (exit code {rc})"
+                if not first_sample_fail:
+                    first_sample_fail = (i, test_input, expected, actual or stderr or "(no output)", f"exit code {rc}")
+            elif actual.strip() == expected:
+                samples_passed += 1
+                status = "PASS"
+            else:
+                status = "FAIL (output mismatch)"
+                if not first_sample_fail:
+                    first_sample_fail = (i, test_input, expected, actual, "mismatch")
+            
+            report.append(f"Sample {i}: {status}")
+        
+        report.append(f"\nResult: {samples_passed}/{samples_total} samples passed")
+        
+        # ==================== BRUTE-FORCE TESTS ====================
+        report.append("\n" + "=" * 60)
+        report.append("BRUTE-FORCE COMPARISON TESTS")
+        report.append("=" * 60)
+        
+        brute_passed = 0
+        brute_total = 0
+        first_brute_fail = None
+        
+        for seed in range(num_small_tests):
+            brute_total += 1
+            
+            # Generate test input
+            try:
+                gen_result = subprocess.run(
+                    [sys.executable, gen_path, str(seed)],
+                    capture_output=True,
+                    text=True,
+                    timeout=time_limit
+                )
+                if gen_result.returncode != 0:
+                    report.append(f"Test {seed}: Generator failed")
+                    continue
+                test_input = gen_result.stdout
+            except subprocess.TimeoutExpired:
+                report.append(f"Test {seed}: Generator timeout")
+                continue
+            except Exception as e:
+                report.append(f"Test {seed}: Generator error: {e}")
+                continue
+            
+            # Run brute-force
+            try:
+                brute_result = subprocess.run(
+                    [sys.executable, brute_path],
+                    input=test_input,
+                    capture_output=True,
+                    text=True,
+                    timeout=time_limit
+                )
+                brute_output = brute_result.stdout.strip()
+                brute_error = brute_result.returncode != 0
+            except subprocess.TimeoutExpired:
+                brute_error = True
+                brute_output = "(timeout)"
+            except Exception as e:
+                brute_error = True
+                brute_output = f"(error: {e})"
+            
+            # Run solution
+            if is_method_based and method_name:
+                try:
+                    args = json.loads(test_input)
+                    sol_output, stderr, rc, elapsed, error = _run_solution_method(
+                        solution_path, method_name, args, time_limit
+                    )
+                    sol_output = sol_output.strip() if sol_output else ""
+                except Exception as parse_err:
+                    sol_output = ""
+                    error = f"Parse error: {parse_err}"
+                    rc = -1
+            else:
+                sol_output, stderr, rc, elapsed, error = _run_solution_stdin(
+                    solution_path, test_input, time_limit
+                )
+                sol_output = sol_output.strip() if sol_output else ""
+            
+            sol_error = error is not None or rc != 0
+            
+            # Compare
+            if brute_error or sol_error:
+                status = f"FAIL"
+                if not first_brute_fail:
+                    first_brute_fail = (seed, test_input[:200], brute_output[:100], sol_output[:100], error or "error")
+            elif sol_output == brute_output:
+                brute_passed += 1
+                status = "PASS"
+            else:
+                status = "FAIL (mismatch)"
+                if not first_brute_fail:
+                    first_brute_fail = (seed, test_input[:200], brute_output[:100], sol_output[:100], "mismatch")
+            
+            report.append(f"Test {seed}: {status}")
+        
+        report.append(f"\nResult: {brute_passed}/{brute_total} brute-force tests passed")
+        
+        # ==================== PERFORMANCE TEST ====================
+        report.append("\n" + "=" * 60)
+        report.append("PERFORMANCE TEST")
+        report.append("=" * 60)
+        
+        perf_status = "OK"
+        perf_time = 0
+        
+        if max_input_path and os.path.exists(max_input_path):
+            with open(max_input_path, 'r') as f:
+                max_input = f.read()
+            
+            if is_method_based and method_name:
+                try:
+                    args = json.loads(max_input)
+                    _, _, _, perf_time, error = _run_solution_method(
+                        solution_path, method_name, args, time_limit * 2
+                    )
+                except Exception as e:
+                    error = str(e)
+                    perf_time = time_limit * 2
+            else:
+                _, _, _, perf_time, error = _run_solution_stdin(
+                    solution_path, max_input, time_limit * 2
+                )
+            
+            if error == "TIMEOUT":
+                perf_status = "TLE"
+            elif perf_time > time_limit:
+                perf_status = "SLOW"
+            
+            report.append(f"Max-size input time: {perf_time:.3f}s (limit: {time_limit*2}s)")
+        else:
+            report.append("No max-size input provided (skipped)")
+        
+        # ==================== FAILURE DETAILS ====================
+        if first_sample_fail:
+            report.append("\n" + "=" * 60)
+            report.append("FIRST SAMPLE FAILURE")
+            report.append("=" * 60)
+            idx, inp, exp, act, reason = first_sample_fail
+            report.append(f"Sample {idx}:")
+            report.append(f"Input: {inp[:200]}")
+            report.append(f"Expected: {exp[:200]}")
+            report.append(f"Actual: {act[:200]}")
+            report.append(f"Reason: {reason}")
+        
+        if first_brute_fail:
+            report.append("\n" + "=" * 60)
+            report.append("FIRST BRUTE-FORCE FAILURE")
+            report.append("=" * 60)
+            seed, inp, brute_out, sol_out, reason = first_brute_fail
+            report.append(f"Test {seed}:")
+            report.append(f"Input: {inp}")
+            report.append(f"Brute-force output: {brute_out}")
+            report.append(f"Solution output: {sol_out}")
+            report.append(f"Reason: {reason}")
+        
+        # ==================== SCORE LINE ====================
+        report.append("\n" + "=" * 60)
+        samples_score = f"{samples_passed}/{samples_total}"
+        brute_score = f"{brute_passed}/{brute_total}"
+        report.append(f"SCORE: samples={samples_score} brute={brute_score} perf={perf_status}")
+        
+        return "\n".join(report)
+        
+    except Exception as e:
+        return f"Error running verify_solution: {str(e)}"
+
+
+if __name__ == "__main__":
+    # Test usage
+    import sys
+    if len(sys.argv) != 8:
+        print("Usage: verify_solution.py solution_path brute_path gen_path samples_json_path num_small_tests time_limit max_input_path")
+        sys.exit(1)
+    
+    result = tool_function(
+        solution_path=sys.argv[1],
+        brute_path=sys.argv[2],
+        gen_path=sys.argv[3],
+        samples_json_path=sys.argv[4],
+        num_small_tests=int(sys.argv[5]),
+        time_limit=float(sys.argv[6]),
+        max_input_path=sys.argv[7] if sys.argv[7] != "null" else None
+    )
+    print(result)
