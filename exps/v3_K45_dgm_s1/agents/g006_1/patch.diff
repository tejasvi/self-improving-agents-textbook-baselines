diff --git a/tools/stress_test.py.bak b/tools/stress_test.py.bak
new file mode 100644
index 0000000..36994be
--- /dev/null
+++ b/tools/stress_test.py.bak
@@ -0,0 +1,289 @@
+"""
+Tool for stress-testing and benchmarking competitive programming solutions.
+Compares solution against brute-force reference on random inputs.
+Also provides benchmarking capability for max-size inputs.
+"""
+
+import os
+import sys
+import time
+import tempfile
+import subprocess
+from pathlib import Path
+
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress-test a competitive programming solution against a brute-force reference.
+Takes a solution file, brute-force reference file, and a random input generator (as code or path).
+Runs both on generated inputs and reports:
+1. Raw first mismatching input with both outputs (if outputs differ)
+2. Pass/fail status for each test
+3. Timing information for each run
+4. TIMEOUT indicator if execution exceeds timeout
+Does not parse or interpret error messages; returns raw output.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file (Python script or module with Solution class)"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference file (Python script or module with Solution class)"
+                },
+                "generator_code_or_path": {
+                    "type": "string",
+                    "description": "Either a Python code snippet that generates inputs, or a path to a file containing such code. The code should define a generator_input(n, seed) function that returns a single test case as a string."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random test cases to generate and compare (default 10)"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test execution in seconds (default 5)"
+                },
+                "max_size_n": {
+                    "type": "integer",
+                    "description": "For benchmark mode: the maximum problem size N to generate and time (optional; if provided, runs a single max-size test and reports timing)"
+                },
+                "benchmark_only": {
+                    "type": "boolean",
+                    "description": "If true, only run benchmark mode (max-size timing) and skip stress tests (default false)"
+                },
+                "memory_limit_mb": {
+                    "type": "integer",
+                    "description": "Memory limit in MB for subprocess execution (default 512)"
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_code_or_path"]
+        }
+    }
+
+
+def _run_solution_on_input(solution_path, test_input, timeout_sec, memory_limit_mb=512, is_max_size=False):
+    """
+    Run a solution on a single test input via subprocess.
+    Returns (elapsed_time_sec, output, is_timeout, error_msg)
+    """
+    try:
+        # Ensure solution_path is absolute
+        abs_path = os.path.abspath(solution_path)
+        if not os.path.isfile(abs_path):
+            return 0, "", False, f"Solution file not found: {abs_path}"
+        
+        # Run as a Python script via stdin/stdout
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {abs_path}",
+            timeout_seconds=timeout_sec,
+            cwd=os.path.dirname(abs_path),
+            memory_limit_mb=memory_limit_mb,
+            stdin_input=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        if returncode == -1 and "TIMEOUT" in stderr:
+            return elapsed, stdout, True, stderr
+        elif returncode != 0:
+            # Include stderr if there's an error
+            error_msg = stderr if stderr else f"Exit code {returncode}"
+            return elapsed, stdout, False, error_msg
+        else:
+            return elapsed, stdout, False, ""
+    
+    except Exception as e:
+        return 0, "", False, f"Error running solution: {str(e)}"
+
+
+def _generate_input(generator_code_or_path, test_index, max_n=None):
+    """
+    Generate a single test input using the provided generator code or file.
+    
+    The generator code should define generator_input(n, seed) that returns a string.
+    For small tests, n is incrementally increased; for max-size tests, n = max_n.
+    """
+    # Load generator code
+    generator_code = None
+    if os.path.isfile(generator_code_or_path):
+        try:
+            with open(generator_code_or_path, 'r') as f:
+                generator_code = f.read()
+        except Exception as e:
+            return None, f"Failed to read generator file: {str(e)}"
+    else:
+        # Assume it's code directly
+        generator_code = generator_code_or_path
+    
+    # Determine n: small tests use incrementing n, max-size tests use max_n
+    if max_n is not None:
+        n = max_n
+    else:
+        # For small tests, use test_index as n (start from 1)
+        n = test_index + 1
+    
+    # Execute the generator code to get a function
+    gen_namespace = {}
+    try:
+        exec(generator_code, gen_namespace)
+    except Exception as e:
+        return None, f"Failed to execute generator code: {str(e)}"
+    
+    if 'generator_input' not in gen_namespace:
+        return None, "Generator code must define generator_input(n, seed) function"
+    
+    generator_func = gen_namespace['generator_input']
+    
+    try:
+        test_input = generator_func(n, test_index)
+        return test_input, None
+    except Exception as e:
+        return None, f"Generator error: {str(e)}"
+
+
+def tool_function(
+    solution_path,
+    brute_path,
+    generator_code_or_path,
+    num_tests=10,
+    timeout=5,
+    max_size_n=None,
+    benchmark_only=False,
+    memory_limit_mb=512
+):
+    """
+    Stress-test and/or benchmark the solution.
+    Returns raw results without parsing error messages.
+    """
+    
+    results = []
+    
+    # === BENCHMARK MODE (if requested) ===
+    if benchmark_only or max_size_n is not None:
+        results.append("\n=== BENCHMARK MODE (MAX-SIZE TIMING) ===\n")
+        
+        if max_size_n is None:
+            return "Error: benchmark_only=true requires max_size_n to be set"
+        
+        # Generate max-size input
+        test_input, gen_error = _generate_input(generator_code_or_path, 0, max_n=max_size_n)
+        if gen_error:
+            return f"Generator error: {gen_error}"
+        
+        results.append(f"Benchmark: n={max_size_n}, timeout={timeout}s\n")
+        
+        # Run solution on max-size input
+        elapsed, output, is_timeout, error = _run_solution_on_input(
+            solution_path, test_input, timeout, memory_limit_mb=memory_limit_mb, is_max_size=True
+        )
+        
+        if is_timeout:
+            results.append(f"Solution: TIMEOUT (>= {timeout}s)\n")
+        else:
+            results.append(f"Solution: elapsed={elapsed:.2f}s\n")
+            if error:
+                results.append(f"Stderr: {error}\n")
+        
+        if benchmark_only:
+            return "".join(results)
+        else:
+            # Continue to stress tests
+            results.append("\n=== STRESS TEST MODE ===\n")
+    
+    # === STRESS TEST MODE ===
+    results.append(f"Running {num_tests} stress tests, timeout={timeout}s\n")
+    
+    first_mismatch = None
+    pass_count = 0
+    fail_count = 0
+    timeout_count = 0
+    
+    for test_idx in range(num_tests):
+        # Generate test input
+        test_input, gen_error = _generate_input(generator_code_or_path, test_idx, max_n=None)
+        if gen_error:
+            results.append(f"Test {test_idx + 1}: GENERATOR ERROR: {gen_error}\n")
+            fail_count += 1
+            continue
+        
+        # Run solution
+        sol_elapsed, sol_output, sol_timeout, sol_error = _run_solution_on_input(
+            solution_path, test_input, timeout, memory_limit_mb=memory_limit_mb
+        )
+        
+        # Run brute force
+        brute_elapsed, brute_output, brute_timeout, brute_error = _run_solution_on_input(
+            brute_path, test_input, timeout, memory_limit_mb=memory_limit_mb
+        )
+        
+        # Compare results
+        if sol_timeout:
+            results.append(f"Test {test_idx + 1}: SOLUTION TIMEOUT\n")
+            timeout_count += 1
+            if first_mismatch is None:
+                first_mismatch = {
+                    'test_index': test_idx + 1,
+                    'input': test_input,
+                    'solution': 'TIMEOUT',
+                    'brute': brute_output if not brute_timeout else 'TIMEOUT'
+                }
+        elif brute_timeout:
+            results.append(f"Test {test_idx + 1}: BRUTE TIMEOUT (solution={sol_elapsed:.2f}s)\n")
+            fail_count += 1
+            if first_mismatch is None:
+                first_mismatch = {
+                    'test_index': test_idx + 1,
+                    'input': test_input,
+                    'solution': sol_output,
+                    'brute': 'TIMEOUT'
+                }
+        elif sol_error or brute_error:
+            # Report errors (MemoryError, Traceback, etc.)
+            results.append(f"Test {test_idx + 1}: ERROR\n")
+            fail_count += 1
+            if first_mismatch is None:
+                first_mismatch = {
+                    'test_index': test_idx + 1,
+                    'input': test_input,
+                    'solution': f"Error: {sol_error}" if sol_error else sol_output,
+                    'brute': f"Error: {brute_error}" if brute_error else brute_output
+                }
+        elif sol_output.strip() != brute_output.strip():
+            results.append(f"Test {test_idx + 1}: MISMATCH (solution={sol_elapsed:.2f}s, brute={brute_elapsed:.2f}s)\n")
+            fail_count += 1
+            if first_mismatch is None:
+                first_mismatch = {
+                    'test_index': test_idx + 1,
+                    'input': test_input,
+                    'solution': sol_output,
+                    'brute': brute_output
+                }
+        else:
+            results.append(f"Test {test_idx + 1}: PASS (solution={sol_elapsed:.2f}s, brute={brute_elapsed:.2f}s)\n")
+            pass_count += 1
+    
+    # Summary
+    results.append(f"\n=== SUMMARY ===\n")
+    results.append(f"Passed: {pass_count}/{num_tests}\n")
+    results.append(f"Failed: {fail_count}/{num_tests}\n")
+    results.append(f"Timeouts: {timeout_count}/{num_tests}\n")
+    
+    if first_mismatch:
+        results.append(f"\n=== FIRST MISMATCH (Test {first_mismatch['test_index']}) ===\n")
+        results.append(f"Input:\n{first_mismatch['input']}\n")
+        results.append(f"Solution output:\n{first_mismatch['solution']}\n")
+        results.append(f"Brute-force output:\n{first_mismatch['brute']}\n")
+    else:
+        results.append("\nAll tests passed!\n")
+    
+    return "".join(results)
+
+
+if __name__ == "__main__":
+    # Example usage for testing
+    pass
