+"""
+Test runner tool for running solution tests in various modes:
+- 'examples': Run solution against provided example test cases
+- 'stress': Compare solution against reference/brute-force implementation
+- 'perf': Run solution with large input and measure performance
+"""
+import json
+import tempfile
+import os
+import subprocess
+
+def tool_info():
+    """Return tool metadata and schema."""
+    return {
+        "name": "test_runner",
+        "description": """Run tests for competitive programming solutions.
+Modes:
+- 'examples': Run solution against example inputs/outputs
+- 'stress': Compare solution against reference solution on random inputs
+- 'perf': Run solution with large input and check performance
+Returns raw stdout/stderr and results without parsing errors.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file (e.g., /repo/solution.py)"
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["examples", "stress", "perf"],
+                    "description": "Test mode: 'examples' (run example cases), 'stress' (compare against reference), 'perf' (performance test)"
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Name of the solution method (e.g., 'solve'). Required if solution is a class method."
+                },
+                "examples_json": {
+                    "type": "string",
+                    "description": "JSON string containing list of {input, expected} test cases. Required for 'examples' mode."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Path to reference/brute-force solution file. Required for 'stress' mode."
+                },
+                "generator_code": {
+                    "type": "string",
+                    "description": "Python code that generates random test inputs. Required for 'stress' mode."
+                },
+                "num_trials": {
+                    "type": "integer",
+                    "description": "Number of random test cases to generate (default: 10). Used in 'stress' mode."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Timeout in seconds (default: 10). Used for running solutions."
+                }
+            },
+            "required": ["solution_path", "mode"]
+        }
+    }
+
+def tool_function(
+    solution_path,
+    mode,
+    method_name=None,
+    examples_json=None,
+    reference_path=None,
+    generator_code=None,
+    num_trials=10,
+    timeout_seconds=10
+):
+    """
+    Run tests for competitive programming solutions.
+    
+    Args:
+        solution_path: Path to solution file
+        mode: One of 'examples', 'stress', 'perf'
+        method_name: Method name for class-based solutions
+        examples_json: JSON string of test cases for examples mode
+        reference_path: Path to reference solution for stress mode
+        generator_code: Code to generate random inputs for stress mode
+        num_trials: Number of random trials for stress mode
+        timeout_seconds: Timeout for running solutions
+    
+    Returns:
+        Raw stdout/stderr and test results
+    """
+    try:
+        if mode == "examples":
+            return _run_examples(solution_path, method_name, examples_json, timeout_seconds)
+        elif mode == "stress":
+            return _run_stress_test(
+                solution_path, 
+                reference_path, 
+                generator_code, 
+                method_name,
+                num_trials,
+                timeout_seconds
+            )
+        elif mode == "perf":
+            return _run_perf_test(solution_path, method_name, timeout_seconds)
+        else:
+            return f"Error: Unknown mode '{mode}'"
+    except Exception as e:
+        return f"Error running test_runner: {str(e)}"
+
+def _run_examples(solution_path, method_name, examples_json, timeout_seconds):
+    """Run solution against example test cases."""
+    try:
+        if not examples_json:
+            return "Error: examples_json is required for 'examples' mode"
+        
+        # Parse examples
+        try:
+            examples = json.loads(examples_json)
+        except json.JSONDecodeError as e:
+            return f"Error parsing examples_json: {str(e)}"
+        
+        # Generate driver script
+        driver_script = _generate_examples_driver(solution_path, method_name, examples)
+        
+        # Write script to temp file and run
+        result = _run_driver_script(driver_script, timeout_seconds)
+        return result
+    except Exception as e:
+        return f"Error in _run_examples: {str(e)}"
+
+def _run_stress_test(solution_path, reference_path, generator_code, method_name, num_trials, timeout_seconds):
+    """Compare solution against reference on random inputs."""
+    try:
+        if not reference_path or not generator_code:
+            return "Error: reference_path and generator_code are required for 'stress' mode"
+        
+        driver_script = _generate_stress_driver(
+            solution_path, 
+            reference_path, 
+            generator_code, 
+            method_name,
+            num_trials
+        )
+        
+        result = _run_driver_script(driver_script, timeout_seconds)
+        return result
+    except Exception as e:
+        return f"Error in _run_stress_test: {str(e)}"
+
+def _run_perf_test(solution_path, method_name, timeout_seconds):
+    """Run solution with large input and measure performance."""
+    driver_script = _generate_perf_driver(solution_path, method_name)
+    
+    result = _run_driver_script(driver_script, timeout_seconds)
+    return result
+
+def _run_driver_script(driver_script, timeout_seconds):
+    """Write driver script to temp file and run it, returning raw output."""
+    with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
+        f.write(driver_script)
+        temp_script = f.name
+    
+    try:
+        try:
+            result = subprocess.run(
+                ["python", temp_script],
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds
+            )
+            returncode = result.returncode
+            stdout = result.stdout
+            stderr = result.stderr
+        except subprocess.TimeoutExpired:
+            returncode = -1
+            stdout = ""
+            stderr = f"TIMEOUT after {timeout_seconds} seconds"
+        except Exception as e:
+            return f"Error running script: {str(e)}"
+        
+        result = stdout
+        if stderr:
+            result += "\nSTDERR:\n" + stderr
+        if returncode == -1:
+            result += "\nTIMEOUT: Script did not complete within time limit"
+        elif returncode != 0:
+            result += f"\nReturn code: {returncode}"
+        
+        return result
+    finally:
+        try:
+            os.unlink(temp_script)
+        except:
+            pass
+
+def _generate_examples_driver(solution_path, method_name, examples):
+    """Generate Python driver script to run examples."""
+    # Remove .py extension if present for import
+    module_name = os.path.basename(solution_path)
+    if module_name.endswith('.py'):
+        module_name = module_name[:-3]
+    
+    sol_dir = os.path.dirname(solution_path)
+    
+    # Build the script with proper error handling
+    script = f"""
+import sys
+sys.path.insert(0, '{sol_dir}')
+
+try:
+    from {module_name} import Solution
+except ImportError as e:
+    print(f"Error importing Solution: {{e}}")
+    sys.exit(1)
+
+examples = {json.dumps(examples)}
+
+passed = 0
+failed = 0
+
+for i, test_case in enumerate(examples):
+    input_data = test_case.get('input')
+    expected = test_case.get('expected')
+    
+    try:
+        sol = Solution()
+        
+        # Try to call the method
+        result = None
+        method_name = {repr(method_name)}
+        if method_name:
+            # Try the specified method name first
+            if hasattr(sol, method_name):
+                result = getattr(sol, method_name)(input_data)
+            else:
+                print(f"Test {{i+1}}: ERROR - Method '{{method_name}}' not found")
+                failed += 1
+                continue
+        else:
+            # Try common method names
+            for attr_name in ['solve', 'solution', '__call__']:
+                if hasattr(sol, attr_name) and callable(getattr(sol, attr_name)):
+                    result = getattr(sol, attr_name)(input_data)
+                    break
+            
+            if result is None:
+                print(f"Test {{i+1}}: ERROR - No callable method found")
+                failed += 1
+                continue
+        
+        if result == expected:
+            passed += 1
+            print(f"Test {{i+1}}: PASS")
+        else:
+            failed += 1
+            print(f"Test {{i+1}}: FAIL")
+            print(f"  Input: {{input_data}}")
+            print(f"  Expected: {{expected}}")
+            print(f"  Got: {{result}}")
+    except Exception as e:
+        failed += 1
+        print(f"Test {{i+1}}: ERROR - {{str(e)}}")
+        print(f"  Input: {{input_data}}")
+        import traceback
+        traceback.print_exc()
+
+print(f"\\nSummary: {{passed}} passed, {{failed}} failed out of {{len(examples)}} tests")
+sys.exit(0 if failed == 0 else 1)
+"""
+    return script
+
+def _generate_stress_driver(solution_path, reference_path, generator_code, method_name, num_trials):
+    """Generate Python driver script for stress testing."""
+    sol_module = os.path.basename(solution_path)
+    if sol_module.endswith('.py'):
+        sol_module = sol_module[:-3]
+    
+    ref_module = os.path.basename(reference_path)
+    if ref_module.endswith('.py'):
+        ref_module = ref_module[:-3]
+    
+    sol_dir = os.path.dirname(solution_path)
+    ref_dir = os.path.dirname(reference_path)
+    
+    script = f"""
+import sys
+sys.path.insert(0, '{sol_dir}')
+sys.path.insert(0, '{ref_dir}')
+
+try:
+    from {sol_module} import Solution
+    from {ref_module} import Solution as ReferenceSolution
+except ImportError as e:
+    print(f"Error importing: {{e}}")
+    sys.exit(1)
+
+# Define the generator function
+{generator_code}
+
+passed = 0
+failed = 0
+
+for trial in range({num_trials}):
+    try:
+        # Generate input
+        test_input = generate_input()
+        
+        # Run solution
+        sol = Solution()
+        sol_result = None
+        method_name = {repr(method_name)}
+        if method_name:
+            if hasattr(sol, method_name):
+                sol_result = getattr(sol, method_name)(test_input)
+            else:
+                print(f"Trial {{trial+1}}: ERROR - Method '{{method_name}}' not found in Solution")
+                failed += 1
+                break
+        else:
+            for attr_name in ['solve', 'solution', '__call__']:
+                if hasattr(sol, attr_name) and callable(getattr(sol, attr_name)):
+                    sol_result = getattr(sol, attr_name)(test_input)
+                    break
+        
+        # Run reference
+        ref = ReferenceSolution()
+        ref_result = None
+        if method_name:
+            if hasattr(ref, method_name):
+                ref_result = getattr(ref, method_name)(test_input)
+            else:
+                print(f"Trial {{trial+1}}: ERROR - Method '{{method_name}}' not found in ReferenceSolution")
+                failed += 1
+                break
+        else:
+            for attr_name in ['solve', 'solution', '__call__']:
+                if hasattr(ref, attr_name) and callable(getattr(ref, attr_name)):
+                    ref_result = getattr(ref, attr_name)(test_input)
+                    break
+        
+        if sol_result == ref_result:
+            passed += 1
+            print(f"Trial {{trial+1}}: PASS")
+        else:
+            failed += 1
+            print(f"Trial {{trial+1}}: FAIL - Output mismatch")
+            print(f"  Input: {{test_input}}")
+            print(f"  Expected (reference): {{ref_result}}")
+            print(f"  Got (solution): {{sol_result}}")
+            break
+    except Exception as e:
+        failed += 1
+        print(f"Trial {{trial+1}}: ERROR - {{str(e)}}")
+        try:
+            print(f"  Input: {{test_input}}")
+        except:
+            pass
+        import traceback
+        traceback.print_exc()
+        break
+
+print(f"\\nStress test summary: {{passed}} passed, {{failed}} failed")
+sys.exit(0 if failed == 0 else 1)
+"""
+    return script
+
+def _generate_perf_driver(solution_path, method_name):
+    """Generate Python driver script for performance testing."""
+    module_name = os.path.basename(solution_path)
+    if module_name.endswith('.py'):
+        module_name = module_name[:-3]
+    
+    sol_dir = os.path.dirname(solution_path)
+    
+    script = f"""
+import sys
+import time
+sys.path.insert(0, '{sol_dir}')
+
+try:
+    from {module_name} import Solution
+except ImportError as e:
+    print(f"Error importing Solution: {{e}}")
+    sys.exit(1)
+
+print("Performance test placeholder")
+print("Note: A performance test requires a large input.")
+print("The solution should handle max-size inputs within the time limit.")
+print("Implement a test with n=10^5 or similar maximum constraint.")
+
+# To run a perf test, the agent should provide large_input_code parameter
+# with code that generates a worst-case input of maximum size
+
+sys.exit(0)
+"""
+    return script
