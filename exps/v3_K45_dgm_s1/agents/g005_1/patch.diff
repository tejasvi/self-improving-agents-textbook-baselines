+"""
+Tool for running a complete test suite on a competitive programming solution.
+Runs example tests, then random stress tests against a brute-force reference,
+then a max-size timing run.
+"""
+
+import os
+import sys
+import time
+import glob
+from pathlib import Path
+
+from utils.subprocess_utils import run_with_timeout
+
+
+def tool_info():
+    return {
+        "name": "run_test_suite",
+        "description": """Run a complete test suite on a competitive programming solution.
+Executes:
+1. All example tests from tests_dir (*.in/*.out pairs with whitespace-normalized comparison)
+2. Random tests compared against brute-force reference (if provided and generator provided)
+3. Max-size timing run (if generator and max_size_n provided)
+Returns raw text: per-test pass/fail, first few failing inputs with expected and actual output, stderr tails, and timings.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution file to test (Python script)"
+                },
+                "tests_dir": {
+                    "type": "string",
+                    "description": "Directory containing test files as *.in and *.out pairs"
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Optional path to brute-force reference for random stress testing"
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Optional path to generator.py file that defines generator_input(n, seed) function"
+                },
+                "num_random": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (default 10)"
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout per test execution in seconds (default 5)"
+                },
+                "max_size_n": {
+                    "type": "integer",
+                    "description": "Maximum problem size N for a final timing run (optional)"
+                }
+            },
+            "required": ["solution_path", "tests_dir"]
+        }
+    }
+
+
+def _run_solution_on_input(solution_path, test_input, timeout_sec):
+    """
+    Run a solution on a single test input via subprocess.
+    Returns (elapsed_time_sec, output, is_timeout, error_msg)
+    """
+    try:
+        abs_path = os.path.abspath(solution_path)
+        if not os.path.isfile(abs_path):
+            return 0, "", False, f"Solution file not found: {abs_path}"
+        
+        start_time = time.time()
+        returncode, stdout, stderr = run_with_timeout(
+            f"python {abs_path}",
+            timeout_seconds=timeout_sec,
+            cwd=os.path.dirname(abs_path),
+            input_data=test_input
+        )
+        elapsed = time.time() - start_time
+        
+        if returncode == -1 and "TIMEOUT" in stderr:
+            return elapsed, stdout, True, stderr
+        elif returncode != 0:
+            error_msg = stderr if stderr else f"Exit code {returncode}"
+            return elapsed, stdout, False, error_msg
+        else:
+            return elapsed, stdout, False, ""
+    
+    except Exception as e:
+        return 0, "", False, f"Error running solution: {str(e)}"
+
+
+def _normalize_output(output):
+    """Normalize output for comparison: strip whitespace."""
+    return output.strip()
+
+
+def _generate_input(generator_path, test_index, max_n=None):
+    """
+    Generate a single test input using the provided generator file.
+    Returns (test_input, error_msg)
+    """
+    if not os.path.isfile(generator_path):
+        return None, f"Generator file not found: {generator_path}"
+    
+    try:
+        with open(generator_path, 'r') as f:
+            generator_code = f.read()
+    except Exception as e:
+        return None, f"Failed to read generator file: {str(e)}"
+    
+    # Determine n
+    if max_n is not None:
+        n = max_n
+    else:
+        n = test_index + 1
+    
+    # Execute the generator code
+    gen_namespace = {}
+    try:
+        exec(generator_code, gen_namespace)
+    except Exception as e:
+        return None, f"Failed to execute generator code: {str(e)}"
+    
+    if 'generator_input' not in gen_namespace:
+        return None, "Generator code must define generator_input(n, seed) function"
+    
+    generator_func = gen_namespace['generator_input']
+    
+    try:
+        test_input = generator_func(n, test_index)
+        return test_input, None
+    except Exception as e:
+        return None, f"Generator error: {str(e)}"
+
+
+def tool_function(
+    solution_path,
+    tests_dir,
+    brute_path=None,
+    generator_path=None,
+    num_random=10,
+    timeout=5,
+    max_size_n=None
+):
+    """
+    Run a complete test suite on the solution.
+    Returns raw results without parsing error messages.
+    """
+    
+    results = []
+    total_examples_passed = 0
+    total_examples = 0
+    first_failing_example = None
+    
+    # === PART 1: Run example tests ===
+    results.append("=" * 60)
+    results.append("EXAMPLE TESTS")
+    results.append("=" * 60)
+    
+    # Find all .in files in tests_dir
+    tests_dir = os.path.abspath(tests_dir)
+    if not os.path.isdir(tests_dir):
+        return f"Tests directory not found: {tests_dir}"
+    
+    in_files = sorted(glob.glob(os.path.join(tests_dir, "*.in")))
+    
+    if not in_files:
+        results.append("No test files found in tests_dir\n")
+    else:
+        for in_file in in_files:
+            total_examples += 1
+            out_file = in_file.replace(".in", ".out")
+            
+            if not os.path.isfile(out_file):
+                results.append(f"Test {total_examples}: MISSING OUTPUT FILE for {os.path.basename(in_file)}\n")
+                continue
+            
+            # Read test input and expected output
+            try:
+                with open(in_file, 'r') as f:
+                    test_input = f.read()
+                with open(out_file, 'r') as f:
+                    expected_output = f.read()
+            except Exception as e:
+                results.append(f"Test {total_examples}: ERROR reading files: {str(e)}\n")
+                continue
+            
+            # Run solution
+            elapsed, actual_output, is_timeout, error = _run_solution_on_input(solution_path, test_input, timeout)
+            
+            # Compare
+            if is_timeout:
+                results.append(f"Test {total_examples} ({os.path.basename(in_file)}): TIMEOUT\n")
+                if first_failing_example is None:
+                    first_failing_example = {
+                        'file': os.path.basename(in_file),
+                        'input': test_input[:500],
+                        'expected': expected_output[:500],
+                        'actual': 'TIMEOUT'
+                    }
+            elif _normalize_output(actual_output) != _normalize_output(expected_output):
+                results.append(f"Test {total_examples} ({os.path.basename(in_file)}): MISMATCH (elapsed={elapsed:.2f}s)\n")
+                if first_failing_example is None:
+                    first_failing_example = {
+                        'file': os.path.basename(in_file),
+                        'input': test_input[:500],
+                        'expected': expected_output[:500],
+                        'actual': actual_output[:500]
+                    }
+            else:
+                results.append(f"Test {total_examples} ({os.path.basename(in_file)}): PASS (elapsed={elapsed:.2f}s)\n")
+                total_examples_passed += 1
+    
+    results.append(f"\nExample tests: {total_examples_passed}/{total_examples} passed\n")
+    
+    if first_failing_example:
+        results.append(f"\nFirst failing example ({first_failing_example['file']}):\n")
+        results.append(f"Input (first 500 chars):\n{first_failing_example['input']}\n")
+        results.append(f"Expected output (first 500 chars):\n{first_failing_example['expected']}\n")
+        results.append(f"Actual output (first 500 chars):\n{first_failing_example['actual']}\n")
+    
+    # === PART 2: Run random stress tests (if brute and generator provided) ===
+    if brute_path and generator_path:
+        results.append("\n" + "=" * 60)
+        results.append("RANDOM STRESS TESTS")
+        results.append("=" * 60)
+        
+        results.append(f"\nRunning {num_random} random tests against brute-force\n")
+        
+        random_passed = 0
+        random_failed = 0
+        first_random_mismatch = None
+        
+        for test_idx in range(num_random):
+            # Generate test
+            test_input, gen_error = _generate_input(generator_path, test_idx)
+            if gen_error:
+                results.append(f"Random test {test_idx + 1}: GENERATOR ERROR: {gen_error}\n")
+                random_failed += 1
+                continue
+            
+            # Run solution
+            sol_elapsed, sol_output, sol_timeout, sol_error = _run_solution_on_input(solution_path, test_input, timeout)
+            
+            # Run brute
+            brute_elapsed, brute_output, brute_timeout, brute_error = _run_solution_on_input(brute_path, test_input, timeout)
+            
+            # Compare
+            if sol_timeout:
+                results.append(f"Random test {test_idx + 1}: SOLUTION TIMEOUT\n")
+                random_failed += 1
+                if first_random_mismatch is None:
+                    first_random_mismatch = {
+                        'index': test_idx + 1,
+                        'input': test_input[:500],
+                        'expected': brute_output[:500] if not brute_timeout else 'TIMEOUT',
+                        'actual': 'TIMEOUT'
+                    }
+            elif brute_timeout:
+                results.append(f"Random test {test_idx + 1}: BRUTE TIMEOUT\n")
+                random_failed += 1
+            elif _normalize_output(sol_output) != _normalize_output(brute_output):
+                results.append(f"Random test {test_idx + 1}: MISMATCH (sol={sol_elapsed:.2f}s, brute={brute_elapsed:.2f}s)\n")
+                random_failed += 1
+                if first_random_mismatch is None:
+                    first_random_mismatch = {
+                        'index': test_idx + 1,
+                        'input': test_input[:500],
+                        'expected': brute_output[:500],
+                        'actual': sol_output[:500]
+                    }
+            else:
+                results.append(f"Random test {test_idx + 1}: PASS (sol={sol_elapsed:.2f}s, brute={brute_elapsed:.2f}s)\n")
+                random_passed += 1
+        
+        results.append(f"\nRandom tests: {random_passed}/{num_random} passed\n")
+        
+        if first_random_mismatch:
+            results.append(f"\nFirst random mismatch (test {first_random_mismatch['index']}):\n")
+            results.append(f"Input (first 500 chars):\n{first_random_mismatch['input']}\n")
+            results.append(f"Expected output (first 500 chars):\n{first_random_mismatch['expected']}\n")
+            results.append(f"Actual output (first 500 chars):\n{first_random_mismatch['actual']}\n")
+    
+    # === PART 3: Max-size timing run ===
+    if max_size_n is not None and generator_path:
+        results.append("\n" + "=" * 60)
+        results.append("MAX-SIZE TIMING RUN")
+        results.append("=" * 60)
+        
+        # Generate max-size input
+        test_input, gen_error = _generate_input(generator_path, 0, max_n=max_size_n)
+        if gen_error:
+            results.append(f"Max-size test: GENERATOR ERROR: {gen_error}\n")
+        else:
+            results.append(f"\nBenchmark: n={max_size_n}, timeout={timeout}s\n")
+            
+            # Run solution
+            elapsed, output, is_timeout, error = _run_solution_on_input(solution_path, test_input, timeout)
+            
+            if is_timeout:
+                results.append(f"Max-size test: TIMEOUT (>= {timeout}s)\n")
+            else:
+                results.append(f"Max-size test: PASS (elapsed={elapsed:.2f}s)\n")
+                if error:
+                    results.append(f"Stderr: {error}\n")
+    
+    results.append("\n" + "=" * 60)
+    results.append("END OF TEST SUITE")
+    results.append("=" * 60)
+    
+    return "\n".join(results)
