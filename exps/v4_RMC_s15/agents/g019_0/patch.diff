+def truncate_output(text: str, max_length: int = MAX_OUTPUT_LENGTH) -> str:
+    """Cut text to max_length characters and append a marker if it was longer."""
+    if len(text) > max_length:
+        return text[:max_length] + "\n<response clipped>"
+    return text
+
+
+def _kill_process_group(process: subprocess.Popen) -> None:
+    """Kill the command and every child it spawned, then reap the leader."""
+    try:
+        os.killpg(process.pid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError):
+        pass
+    try:
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        pass
+
+
+def run_command(command: str, timeout: float = None) -> str:
+    """Run a command in a non-interactive bash process and return a result string."""
+    if timeout is None:
+        timeout = COMMAND_TIMEOUT
+
+    # Output goes to temporary files rather than pipes. A pipe stays open while any
+    # background child holds it, which would block until the timeout; a file does not.
+    with tempfile.TemporaryFile() as out_file, tempfile.TemporaryFile() as err_file:
+        try:
+            process = subprocess.Popen(
+                ["/bin/bash", "-c", command],
+                stdin=subprocess.DEVNULL,
+                stdout=out_file,
+                stderr=err_file,
+                env=os.environ.copy(),
+                start_new_session=True,  # own process group, so the whole tree can be killed
+            )
         except Exception as e:
