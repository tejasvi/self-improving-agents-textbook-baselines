+import tools.bash as bash_tool
+from tools.bash import tool_function, tool_info
+
+
+class TestBashToolInfo:
+    def test_schema_structure(self):
+        info = tool_info()
+        assert info["name"] == "bash"
+        schema = info["input_schema"]
+        assert schema["type"] == "object"
+        assert schema["required"] == ["command"]
+        assert schema["properties"]["command"]["type"] == "string"
+        assert "description" in schema["properties"]["command"]
+
+
+class TestBashToolNonInteractive:
+    def test_stdin_is_closed(self):
+        """A command that reads stdin must get EOF instead of hanging."""
+        start = time.time()
+        result = tool_function("read x; echo \"rc=$?\"")
+        assert time.time() - start < 10
+        assert "rc=1" in result
+
+    def test_cat_without_args_returns_immediately(self):
+        start = time.time()
+        result = tool_function("cat")
+        assert time.time() - start < 10
+        assert result == ""
+
+    def test_timeout_kills_command(self, monkeypatch):
+        monkeypatch.setattr(bash_tool, "COMMAND_TIMEOUT", 1)
+        start = time.time()
+        result = tool_function("sleep 30")
+        assert "timed out" in result
+        assert time.time() - start < 15
+
+    def test_timeout_kills_child_processes(self, monkeypatch):
+        monkeypatch.setattr(bash_tool, "COMMAND_TIMEOUT", 1)
+        start = time.time()
+        result = tool_function("sleep 30 & sleep 30; echo never")
+        assert "timed out" in result
+        assert "never" not in result
+        assert time.time() - start < 15
+
+    def test_background_process_does_not_block(self):
+        """A background child must not keep the call waiting for the timeout."""
+        start = time.time()
+        result = tool_function("(sleep 2 &) ; echo started")
+        assert "started" in result
+        assert time.time() - start < 10
+
+    def test_output_is_truncated(self):
+        result = tool_function("head -c 50000 /dev/zero | tr '\\0' a")
+        assert "<response clipped>" in result
+        assert len(result) < bash_tool.MAX_OUTPUT_LENGTH + 100
+
+    def test_stderr_is_truncated(self):
+        result = tool_function("head -c 50000 /dev/zero | tr '\\0' b >&2")
+        assert "<response clipped>" in result
+        assert len(result) < bash_tool.MAX_OUTPUT_LENGTH + 100
+
+    def test_nonzero_exit_without_stderr_is_reported(self):
+        result = tool_function("exit 3")
+        assert "return code 3" in result
 
