+def test_forward_no_attempt_passes_runs_all_and_keeps_last_patch(tmp_path):
+    sysm = make_system(tmp_path)
+    patches = iter(["patch1", "patch2", "patch3"])
+    with mock.patch.object(sysm, "run_attempt", return_value=([], False)) as ra, \
+         mock.patch.object(coding_agent, "reset_to_commit"), \
+         mock.patch.object(coding_agent, "diff_versus_commit", side_effect=lambda *a, **k: next(patches)), \
+         mock.patch.object(coding_agent, "apply_patch") as apply:
+        sysm.forward(max_attempts=3)
+    assert ra.call_count == 3
+    apply.assert_called_once()
+    assert apply.call_args[0][1] == "patch3"
