+def run_test_commands(language, git_dname, timeout=600):
+    """
+    Run the test commands for `language` inside `git_dname` and return their combined output.
+    Stops at the first failing command. Returns a (passed, output) tuple.
+    """
+    commands = TEST_COMMANDS.get(language, [])
+    if not commands:
+        return False, f"No test commands configured for language '{language}'."
+    outputs = []
+    for cmd in commands:
+        try:
+            result = subprocess.run(
+                cmd, cwd=git_dname, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                timeout=timeout, check=False,
+            )
+            out = result.stdout.decode('utf-8', errors='replace')
+            outputs.append(f"$ {' '.join(cmd)}\n{out}")
+            if result.returncode != 0:
+                return False, "\n".join(outputs)
+        except Exception as e:
+            outputs.append(f"$ {' '.join(cmd)}\nError running command: {e}")
+            return False, "\n".join(outputs)
+    return True, "\n".join(outputs)
+
+def format_previous_attempts(previous_attempts, max_chars=20000):
+    """
+    Build a prompt section describing earlier failed attempts.
+    Each attempt is a dict with keys 'patch' (diff of the attempt) and 'test_output' (test results).
+    Returns an empty string if there are no previous attempts.
+    """
+    if not previous_attempts:
+        return ""
+    sections = []
+    for i, attempt in enumerate(previous_attempts, start=1):
+        patch = attempt.get('patch', '') or '(empty diff)'
+        test_output = attempt.get('test_output', '') or '(no test output)'
+        if len(test_output) > max_chars:
+            test_output = test_output[-max_chars:]
+        sections.append(
+            f"## Previous attempt {i}\n"
+            f"### Patch\n```diff\n{patch}\n```\n"
+            f"### Test output\n```\n{test_output}\n```"
+        )
+    return (
+        "# Previous failed attempts\n"
+        "An earlier attempt at this problem did not pass the tests. Its patch and test output are shown below. "
+        "Do not repeat the same mistakes: analyze why these failed, then solve the problem correctly.\n\n"
+        + "\n\n".join(sections)
+    )
+
