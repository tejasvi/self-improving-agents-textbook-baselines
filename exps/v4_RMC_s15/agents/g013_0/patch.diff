diff --git a/tests/test_coding_agent_flow.py b/tests/test_coding_agent_flow.py
new file mode 100644
index 0000000..f0fec61
--- /dev/null
+++ b/tests/test_coding_agent_flow.py
@@ -0,0 +1,90 @@
+import os
+import subprocess
+
+import pytest
+
+import coding_agent
+from coding_agent import AgenticSystem
+
+
+def _git(repo, *args):
+    subprocess.run(["git", "-C", repo, *args], check=True, capture_output=True)
+
+
+@pytest.fixture
+def repo(tmp_path):
+    d = tmp_path / "repo"
+    d.mkdir()
+    _git(str(d), "init", "-q")
+    _git(str(d), "config", "user.email", "t@t")
+    _git(str(d), "config", "user.name", "t")
+    (d / "sol.py").write_text("x = 0\n")
+    _git(str(d), "add", ".")
+    _git(str(d), "commit", "-qm", "base")
+    commit = subprocess.run(["git", "-C", str(d), "rev-parse", "HEAD"],
+                            capture_output=True, text=True, check=True).stdout.strip()
+    return str(d), commit
+
+
+def make_system(repo_dir, commit, tmp_path):
+    return AgenticSystem(
+        problem_statement="Print 1.",
+        git_tempdir=repo_dir,
+        base_commit=commit,
+        chat_history_file=str(tmp_path / "log" / "chat.md"),
+    )
+
+
+def test_run_attempt_two_calls_and_verdict_yes(monkeypatch, repo, tmp_path):
+    repo_dir, commit = repo
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls.append(msg)
+        history = list(msg_history or []) + [{"role": "user", "content": msg}]
+        history.append({"role": "assistant", "content": "done EXAMPLES_PASSED: yes" if len(calls) == 2 else "plan"})
+        return history
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    sys_ = make_system(repo_dir, commit, tmp_path)
+    _, passed = sys_.run_attempt()
+
+    assert len(calls) == 2
+    assert "Do NOT modify" in calls[0]
+    assert "EXAMPLES_PASSED: yes" in calls[1]
+    assert passed is True
+
+
+@pytest.mark.parametrize("verdict", ["EXAMPLES_PASSED: no", None])
+def test_run_attempt_verdict_not_yes(monkeypatch, repo, tmp_path, verdict):
+    repo_dir, commit = repo
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        text = verdict if (verdict and "EXAMPLES_PASSED" in msg) else "plan"
+        history = list(msg_history or []) + [{"role": "user", "content": msg}]
+        history.append({"role": "assistant", "content": [{"type": "text", "text": text or "no verdict"}]})
+        return history
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    _, passed = make_system(repo_dir, commit, tmp_path).run_attempt()
+    assert passed is False
+
+
+def test_forward_keeps_passing_attempt_and_applies_patch(monkeypatch, repo, tmp_path):
+    repo_dir, commit = repo
+    attempt = {"n": 0}
+
+    def fake_run_attempt(self, msg_history=None):
+        attempt["n"] += 1
+        # Attempt 1 writes a wrong answer and fails; attempt 2 writes the right one and passes.
+        value = "1" if attempt["n"] == 2 else "2"
+        with open(os.path.join(self.git_tempdir, "sol.py"), "w") as f:
+            f.write(f"x = {value}\n")
+        return [], attempt["n"] == 2
+
+    monkeypatch.setattr(AgenticSystem, "run_attempt", fake_run_attempt)
+    sys_ = make_system(repo_dir, commit, tmp_path)
+    sys_.forward(max_attempts=3)
+
+    assert attempt["n"] == 2  # stops after the first passing attempt
+    assert open(os.path.join(repo_dir, "sol.py")).read() == "x = 1\n"
