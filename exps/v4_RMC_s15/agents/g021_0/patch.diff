+def parse_examples_passed(msg_history):
+    """
+    Return True iff the last non-empty line of the most recent assistant reply is exactly
+    'EXAMPLES_PASSED: yes'. Requiring the final line avoids matching the phrase when it is
+    only quoted or negated earlier in the reply.
+    """
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            text = content
+        else:
+            text = '\n'.join(
+                block.get('text') or '' for block in (content or []) if isinstance(block, dict)
+            )
+        lines = [line.strip() for line in text.splitlines() if line.strip()]
+        if lines:
+            return lines[-1] == 'EXAMPLES_PASSED: yes'
+    return False
+
