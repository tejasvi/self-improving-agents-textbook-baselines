diff --git a/tests/test_coding_agent_retry.py b/tests/test_coding_agent_retry.py
new file mode 100644
index 0000000..3d10ef2
--- /dev/null
+++ b/tests/test_coding_agent_retry.py
@@ -0,0 +1,124 @@
+import os
+import sys
+from unittest import mock
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import coding_agent
+from coding_agent import AgenticSystem
+
+
+def make_system(tmp_path):
+    return AgenticSystem(
+        problem_statement="dummy",
+        git_tempdir=str(tmp_path),
+        base_commit="abc",
+        chat_history_file=str(tmp_path / "chat.md"),
+    )
+
+
+def verdict_history(passed):
+    text = "EXAMPLES_PASSED: yes" if passed else "EXAMPLES_PASSED: no"
+    return [{"role": "assistant", "content": [{"type": "text", "text": text}]}]
+
+
+def test_phase_retry_succeeds(tmp_path):
+    sysm = make_system(tmp_path)
+    calls = []
+
+    def fake_chat(msg, model, msg_history, logging):
+        calls.append(list(msg_history))
+        if len(calls) == 1:
+            raise RuntimeError("boom")
+        return msg_history + [{"role": "assistant", "content": "ok"}]
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=fake_chat):
+        out = sysm._run_phase("instr", [{"role": "user", "content": "hi"}])
+    assert len(calls) == 2
+    assert calls[0] == calls[1] == [{"role": "user", "content": "hi"}]
+    assert out[-1]["content"] == "ok"
+
+
+def test_phase_retry_exhausted_raises(tmp_path):
+    sysm = make_system(tmp_path)
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=RuntimeError("boom")) as m:
+        try:
+            sysm._run_phase("instr", [])
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("expected RuntimeError")
+    assert m.call_count == 2
+
+
+def test_run_attempt_uses_phase_helper_four_times(tmp_path):
+    sysm = make_system(tmp_path)
+    with mock.patch.object(sysm, "_run_phase", side_effect=lambda instr, h: h + verdict_history(True)) as m:
+        _, passed = sysm.run_attempt()
+    assert m.call_count == 4
+    assert passed is True
+
+
+def test_forward_attempt_exception_is_caught_and_next_attempt_runs(tmp_path):
+    sysm = make_system(tmp_path)
+    attempts = {"n": 0}
+
+    def fake_run_attempt(msg_history=None):
+        attempts["n"] += 1
+        if attempts["n"] == 1:
+            raise RuntimeError("attempt crash")
+        return [], True
+
+    with mock.patch.object(sysm, "run_attempt", side_effect=fake_run_attempt), \
+         mock.patch.object(coding_agent, "reset_to_commit") as reset, \
+         mock.patch.object(coding_agent, "diff_versus_commit", return_value="") as diff, \
+         mock.patch.object(coding_agent, "apply_patch") as apply:
+        sysm.forward(max_attempts=3)
+    assert attempts["n"] == 2
+    # reset at the start of each attempt, plus the final restore
+    assert reset.call_count == 3
+    apply.assert_not_called()  # empty patch is not re-applied
+
+
+def test_forward_stops_on_first_passing_attempt(tmp_path):
+    sysm = make_system(tmp_path)
+    with mock.patch.object(sysm, "run_attempt", return_value=([], True)) as ra, \
+         mock.patch.object(coding_agent, "reset_to_commit"), \
+         mock.patch.object(coding_agent, "diff_versus_commit", return_value="PATCH"), \
+         mock.patch.object(coding_agent, "apply_patch") as apply:
+        sysm.forward(max_attempts=3)
+    assert ra.call_count == 1
+    apply.assert_called_once()
+
+
+def test_forward_keeps_repo_edits_when_attempt_raises(tmp_path):
+    sysm = make_system(tmp_path)
+    with mock.patch.object(sysm, "run_attempt", side_effect=RuntimeError("x")) as ra, \
+         mock.patch.object(coding_agent, "reset_to_commit") as reset, \
+         mock.patch.object(coding_agent, "diff_versus_commit", return_value="") as diff, \
+         mock.patch.object(coding_agent, "apply_patch"):
+        sysm.forward(max_attempts=2)
+    assert ra.call_count == 2  # one call per attempt, no restart inside an attempt
+    assert diff.call_count == 2  # the partial diff is still captured after each failure
+
+
+def test_run_attempt_phase_failure_keeps_earlier_history(tmp_path):
+    sysm = make_system(tmp_path)
+    seen = []
+
+    def fake_chat(msg, model, msg_history, logging):
+        seen.append(len(msg_history))
+        # fail the 3rd phase on both tries; earlier phases must be kept
+        if len(seen) in (3, 4):
+            raise RuntimeError("api down")
+        return msg_history + [{"role": "assistant", "content": "ok"}]
+
+    with mock.patch.object(coding_agent, "chat_with_agent", side_effect=fake_chat):
+        try:
+            sysm.run_attempt()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("expected RuntimeError")
+    # phase 3 was tried twice from the same 2-message history (each phase adds one message) (phases 1 and 2 kept)
+    assert seen == [0, 1, 2, 2]
