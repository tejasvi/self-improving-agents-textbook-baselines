+    def _chat_phase(self, instruction, msg_history):
+        """
+        Run one conversation turn. If the call raises, retry it once from the last good
+        state (the message history before the failing call). A second failure propagates.
+        """
+        last_good = list(msg_history or [])
+        last_exc = None
+        for attempt in range(2):
+            try:
+                return chat_with_agent(instruction, model=self.code_model, msg_history=last_good, logging=safe_log)
+            except Exception as e:
+                last_exc = e
+                if attempt == 0:
+                    safe_log(f"Phase failed with exception, retrying once from last good state: {e!r}")
+        raise last_exc
