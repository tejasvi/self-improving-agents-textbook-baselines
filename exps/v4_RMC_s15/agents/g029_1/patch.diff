index 0000000..f8cc135
--- /dev/null
+++ b/utils/context_utils.py
@@ -0,0 +1,78 @@
+"""
+Helpers that keep the LLM context small: truncate long tool results and
+shorten old tool results inside a message history.
+
+Nothing is dropped. Every block and every tool_use_id is kept, so the
+history stays valid for the API. Compaction works on copies, so the stored
+history is never changed.
+"""
+import copy
+
+CLIP_MARKER = "\n... <response clipped: {n} characters removed> ...\n"
+
+
+def truncate_text(text, max_chars):
+    """
+    Return text unchanged if it fits in max_chars. Otherwise keep the start and
+    end of the text with a marker in between. The result never exceeds max_chars.
+    """
+    if text is None:
+        return ""
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None:
+        return text
+    max_chars = max(0, max_chars)
+    if len(text) <= max_chars:
+        return text
+    # The marker holds the removed-character count, which is at most len(text),
+    # so a placeholder with len(text) has the longest possible marker. The real
+    # marker is no longer than the placeholder, so the result still fits.
+    budget = max_chars - len(CLIP_MARKER.format(n=len(text)))
+    if budget <= 0:
+        return text[:max_chars]
+    head = (budget * 2) // 3
+    tail = budget - head
+    removed = len(text) - head - tail
+    return text[:head] + CLIP_MARKER.format(n=removed) + (text[len(text) - tail:] if tail else "")
+
+
+def _truncate_tool_result_block(block, max_chars):
+    content = block.get("content")
+    if isinstance(content, str):
+        block["content"] = truncate_text(content, max_chars)
+    elif isinstance(content, list):
+        for part in content:
+            if isinstance(part, dict) and part.get("type") == "text" and isinstance(part.get("text"), str):
+                part["text"] = truncate_text(part["text"], max_chars)
+
+
+def compact_messages(messages, keep_recent=6, old_result_max_chars=1500, old_text_max_chars=4000):
+    """
+    Return a copy of messages where, for messages older than the last keep_recent:
+      - tool_result blocks are truncated to old_result_max_chars characters;
+      - text blocks (or plain string content) are truncated to old_text_max_chars.
+    The first message is never shortened text-wise, because it carries the full
+    task statement. Non-dict blocks (for example SDK objects) and recent messages
+    are left as they are.
+    """
+    compacted = copy.deepcopy(list(messages))
+    cutoff = max(0, len(compacted) - keep_recent)
+    for idx, msg in enumerate(compacted[:cutoff]):
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            if idx != 0:
+                msg["content"] = truncate_text(content, old_text_max_chars)
+            continue
+        if not isinstance(content, list):
+            continue
+        for block in content:
+            if not isinstance(block, dict):
+                continue
+            if block.get("type") == "tool_result":
+                _truncate_tool_result_block(block, old_result_max_chars)
+            elif block.get("type") == "text" and idx != 0 and isinstance(block.get("text"), str):
+                block["text"] = truncate_text(block["text"], old_text_max_chars)
+    return compacted
