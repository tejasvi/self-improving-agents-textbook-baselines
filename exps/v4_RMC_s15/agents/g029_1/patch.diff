+import copy
+import os
+import sys
+from unittest import mock
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import llm_withtools
+from utils.context_utils import truncate_text, compact_messages
+
+
+class TestTruncateText:
+    def test_short_text_unchanged(self):
+        assert truncate_text("hello", 100) == "hello"
+
+    def test_exact_limit_unchanged(self):
+        assert truncate_text("a" * 50, 50) == "a" * 50
+
+    def test_long_text_bounded_and_marked(self):
+        text = "H" * 5000 + "T" * 5000
+        result = truncate_text(text, 1000)
+        assert len(result) <= 1000
+        assert "response clipped" in result
+
+    def test_keeps_head_and_tail(self):
+        text = "HEAD" + "x" * 20000 + "TAIL"
+        result = truncate_text(text, 500)
+        assert result.startswith("HEAD")
+        assert result.endswith("TAIL")
+
+    def test_tiny_limits_never_exceed(self):
+        for m in range(0, 80):
+            assert len(truncate_text("z" * 1000, m)) <= m
+
+    def test_non_string_converted(self):
+        assert truncate_text(12345, 100) == "12345"
+
+    def test_none_is_empty(self):
+        assert truncate_text(None, 10) == ""
+
+    def test_negative_limit_gives_empty_and_bounded(self):
+        assert truncate_text("abc", -5) == ""
+        assert len(truncate_text("z" * 100, -1)) <= 0
+
+
+class TestCompactMessages:
+    def _history(self, n_old, size):
+        msgs = []
+        for i in range(n_old):
+            msgs.append({"role": "assistant", "content": [{"type": "tool_use", "id": f"t{i}", "name": "bash", "input": {}}]})
+            msgs.append({"role": "user", "content": [{"type": "tool_result", "tool_use_id": f"t{i}", "content": "r" * size}]})
+        return msgs
+
+    def test_old_results_shortened_recent_kept(self):
+        msgs = self._history(10, 10000)
+        out = compact_messages(msgs, keep_recent=6, old_result_max_chars=1500)
+        assert len(out[1]["content"][0]["content"]) <= 1500
+        assert out[-1]["content"][0]["content"] == "r" * 10000
+
+    def test_ids_and_block_count_preserved(self):
+        msgs = self._history(5, 5000)
+        out = compact_messages(msgs, keep_recent=2)
+        assert len(out) == len(msgs)
+        for a, b in zip(msgs, out):
+            assert len(a["content"]) == len(b["content"])
+            assert a["role"] == b["role"]
+        assert out[1]["content"][0]["tool_use_id"] == "t0"
+
+    def test_input_not_mutated(self):
+        msgs = self._history(5, 5000)
+        snapshot = copy.deepcopy(msgs)
+        compact_messages(msgs, keep_recent=2)
+        assert msgs == snapshot
+
+    def test_idempotent(self):
+        msgs = self._history(5, 5000)
+        once = compact_messages(msgs, keep_recent=2)
+        twice = compact_messages(once, keep_recent=2)
+        assert once == twice
+
+    def test_non_dict_and_string_content_tolerated(self):
+        class Block:  # stands in for SDK objects
+            type = "text"
+        msgs = [
+            {"role": "assistant", "content": [Block()]},
+            {"role": "user", "content": "plain string"},
+            {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "x", "content": [{"type": "text", "text": "q" * 5000}]}]},
+        ]
+        out = compact_messages(msgs, keep_recent=0, old_result_max_chars=100)
+        assert out[1]["content"] == "plain string"
+        assert len(out[2]["content"][0]["content"][0]["text"]) <= 100
+
+    def test_old_text_turns_shortened_first_message_kept(self):
+        long = "P" * 20000
+        msgs = [{"role": "user", "content": [{"type": "text", "text": long}]}]
+        msgs += [{"role": "assistant", "content": [{"type": "text", "text": "A" * 20000}]}]
+        msgs += [{"role": "user", "content": [{"type": "text", "text": "recent"}]}] * 6
+        out = compact_messages(msgs, keep_recent=6, old_text_max_chars=4000)
+        assert out[0]["content"][0]["text"] == long
+        assert len(out[1]["content"][0]["text"]) <= 4000
+        assert out[-1]["content"][0]["text"] == "recent"
+
+    def test_empty_history(self):
+        assert compact_messages([]) == []
+
+
+class TestProcessToolCall:
+    def test_tool_result_capped(self):
+        tools = {"big": {"function": lambda: "x" * 50000}}
+        out = llm_withtools.process_tool_call(tools, "big", {})
+        assert len(out) <= llm_withtools.TOOL_RESULT_MAX_CHARS
+        assert "response clipped" in out
+
+    def test_small_result_unchanged(self):
+        tools = {"small": {"function": lambda: "ok"}}
+        assert llm_withtools.process_tool_call(tools, "small", {}) == "ok"
+
+
+class TestClaudePathCompaction:
+    def test_api_receives_compacted_history_but_stored_history_is_full(self):
+        big = "B" * 20000
+        old_turns = []
+        for i in range(8):
+            old_turns.append({"role": "assistant", "content": [{"type": "text", "text": f"step {i}"}]})
+            old_turns.append({"role": "user", "content": [{"type": "tool_result", "tool_use_id": f"id{i}", "content": big}]})
+        seen = []
+
+        def fake_get_response(client, model, messages, tool_choice, tools, logging=None):
+            seen.append(copy.deepcopy(messages))
+            resp = mock.Mock()
+            resp.stop_reason = "end_turn"
+            resp.content = [mock.Mock(type="text", text="done")]
+            return resp
+
+        with mock.patch.object(llm_withtools, "create_client", return_value=(mock.Mock(), "claude-x")), \
+             mock.patch.object(llm_withtools, "load_all_tools", return_value=[]), \
+             mock.patch.object(llm_withtools, "get_response_withtools", side_effect=fake_get_response), \
+             mock.patch.object(llm_withtools, "check_for_tool_use", return_value=None):
+            llm_withtools.chat_with_agent_claude("hi", model="claude-x", msg_history=old_turns, logging=lambda *_: None)
+
+        sent = seen[0]
+        # Earlier tool results are shortened in what is sent to the API
+        assert len(sent[1]["content"][0]["content"]) <= 1500
+        # The caller's history is not modified
+        assert old_turns[1]["content"][0]["content"] == big
