+++ b/tools/run_solution_tests.py
@@ -0,0 +1,115 @@
+import json
+import os
+import subprocess
+import sys
+
+def tool_info():
+    return {
+        "name": "run_solution_tests",
+        "description": """Run a Python solution program on given test inputs and compare its standard output with the expected outputs.\n
+* The solution must be a complete Python program that reads from standard input and writes to standard output.\n
+* Each test case has an 'input' (fed to the program's stdin) and an 'output' (the expected stdout).\n
+* Comparison ignores leading/trailing whitespace of the whole output and trailing whitespace on each line.\n
+* Returns a report listing PASS/FAIL for each test case, with the actual output, stderr and the reason for failures (wrong answer, runtime error, or timeout).\n
+* Use this tool after implementing a solution to verify it against the sample tests from the problem statement and any extra tests you create.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (e.g. /path/to/repo/solution.py)."
+                },
+                "test_cases": {
+                    "type": "array",
+                    "description": "List of test cases to run. Each item is an object with 'input' (stdin text) and 'output' (expected stdout text).",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The text fed to the program's standard input."
+                            },
+                            "output": {
+                                "type": "string",
+                                "description": "The expected text printed to the program's standard output."
+                            }
+                        },
+                        "required": ["input", "output"]
+                    }
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each test case. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_cases"]
+        }
+    }
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+def _run_case(solution_path, cwd, test_input, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=test_input,
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return None, "", f"Timeout after {timeout} seconds", "TIMEOUT"
+    if proc.returncode != 0:
+        return proc.returncode, proc.stdout, proc.stderr, "RUNTIME_ERROR"
+    return proc.returncode, proc.stdout, proc.stderr, None
+
+def tool_function(solution_path: str, test_cases: list, timeout: float = 10) -> str:
+    """
+    Runs the solution program on each test case and compares its stdout to the expected output.
+    """
+    try:
+        if not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if not isinstance(test_cases, list) or len(test_cases) == 0:
+            return "Error: test_cases must be a non-empty list of objects with 'input' and 'output'."
+        if timeout is None:
+            timeout = 10
+        timeout = float(timeout)
+
+        cwd = os.path.dirname(os.path.abspath(solution_path))
+        solution_abs = os.path.abspath(solution_path)
+        passed = 0
+        reports = []
+        for idx, case in enumerate(test_cases, start=1):
+            if not isinstance(case, dict) or "input" not in case or "output" not in case:
+                reports.append(f"Test {idx}: FAIL (malformed test case, needs 'input' and 'output')")
+                continue
+            test_input = str(case["input"])
+            expected = str(case["output"])
+            _, stdout, stderr, status = _run_case(solution_abs, cwd, test_input, timeout)
+
+            if status == "TIMEOUT":
+                reports.append(f"Test {idx}: FAIL (timeout after {timeout} seconds)\n"
+                               f"Input:\n{test_input}")
+                continue
+            if status == "RUNTIME_ERROR":
+                reports.append(f"Test {idx}: FAIL (runtime error)\n"
+                               f"Input:\n{test_input}\nstderr:\n{stderr}")
+                continue
+            if _normalize(stdout) == _normalize(expected):
+                passed += 1
+                reports.append(f"Test {idx}: PASS")
+            else:
+                reports.append(f"Test {idx}: FAIL (wrong answer)\n"
+                               f"Input:\n{test_input}\n"
+                               f"Expected:\n{expected}\n"
+                               f"Actual:\n{stdout}\n"
+                               f"stderr:\n{stderr}")
+
+        summary = f"Summary: {passed}/{len(test_cases)} test cases passed."
+        return "\n\n".join(reports) + "\n\n" + summary
+    except Exception as e:
+        return f"Error running solution tests: {e}"
