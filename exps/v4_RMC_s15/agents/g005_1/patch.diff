+def truncate_old_tool_results(messages, keep_recent=KEEP_RECENT_MESSAGES, max_chars=MAX_OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of the message list where older turns are shortened: tool results (Claude
+    'tool_result' blocks and OpenAI 'function_call_output' items) and text blocks in messages older
+    than the last `keep_recent` messages are truncated to `max_chars`. Original messages are not modified.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    new_messages = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            new_messages.append(msg)
+            continue
+        if msg.get('type') == 'function_call_output':
+            msg = dict(msg)
+            msg['output'] = truncate_text(msg.get('output', ''), max_chars)
+            new_messages.append(msg)
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            msg = dict(msg)
+            msg['content'] = truncate_text(content, max_chars)
+        elif isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    block = dict(block)
+                    block['content'] = truncate_text(block.get('content', ''), max_chars)
+                elif isinstance(block, dict) and block.get('type') in ('text', 'input_text') and isinstance(block.get('text'), str):
+                    block = dict(block)
+                    block['text'] = truncate_text(block['text'], max_chars)
+                new_content.append(block)
+            msg = dict(msg)
+            msg['content'] = new_content
+        new_messages.append(msg)
+    return new_messages
+
