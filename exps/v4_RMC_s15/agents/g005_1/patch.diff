+from utils.common_utils import truncate_text
+
+# Max characters kept for a single tool output (head and tail are kept, middle is dropped)
+MAX_TOOL_OUTPUT_CHARS = 8000
+# Number of most recent messages whose tool results are kept in full when building API requests
+KEEP_RECENT_MESSAGES = 6
+# Max characters kept for tool results in older messages when building API requests
+MAX_OLD_TOOL_RESULT_CHARS = 1000
 
 CLAUDE_MODEL = 'claude-3-5-sonnet-20241022'
