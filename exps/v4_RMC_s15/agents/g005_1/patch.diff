+def truncate_text(text, max_chars=8000):
+    """
+    Truncate a long string, keeping its beginning and end and dropping the middle.
+    Returns the text unchanged if it is not longer than max_chars.
+    """
+    if not isinstance(text, str):
+        text = str(text)
+    if max_chars is None or len(text) <= max_chars:
+        return text
+    marker = f"\n... [truncated {len(text) - max_chars} characters] ...\n"
+    head = (max_chars - len(marker)) // 2
+    tail = max_chars - len(marker) - head
+    if head <= 0:
+        return text[:max_chars]
+    return text[:head] + marker + text[len(text) - tail:]
