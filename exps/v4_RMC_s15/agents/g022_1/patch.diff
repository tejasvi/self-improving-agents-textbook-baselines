+def test_run_attempt_analysis_edit_is_warned_and_flow_continues(monkeypatch, repo, tmp_path):
+    repo_dir, commit = repo
+    calls = []
+    logged = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls.append(msg)
+        if len(calls) == 1:
+            # Analysis call misbehaves and edits a file.
+            with open(os.path.join(repo_dir, "sol.py"), "w") as f:
+                f.write("x = 5\n")
+        history = list(msg_history or []) + [{"role": "user", "content": msg}]
+        history.append({"role": "assistant", "content": "EXAMPLES_PASSED: yes" if len(calls) == 2 else "plan"})
+        return history
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    monkeypatch.setattr(coding_agent, "safe_log", lambda m, level=None: logged.append(m))
+    _, passed = make_system(repo_dir, commit, tmp_path).run_attempt()
+
+    assert len(calls) == 2
+    assert passed is True
+    assert any("analysis phase modified files" in m for m in logged)
+
+
+def test_run_attempt_last_verdict_wins(monkeypatch, repo, tmp_path):
+    repo_dir, commit = repo
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        history = list(msg_history or []) + [{"role": "user", "content": msg}]
+        text = "EXAMPLES_PASSED: yes" if "EXAMPLES_PASSED" not in msg else "EXAMPLES_PASSED: yes\nEXAMPLES_PASSED: no"
+        history.append({"role": "assistant", "content": text})
+        return history
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    _, passed = make_system(repo_dir, commit, tmp_path).run_attempt()
+    assert passed is False
+
+
+def test_setup_logger_bare_filename(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    logger = coding_agent.setup_logger("chat.md")
+    logger.info("hello")
+    for h in logger.handlers:
+        h.flush()
+    assert (tmp_path / "chat.md").read_text().strip() == "hello"
