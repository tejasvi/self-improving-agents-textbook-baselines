@@ -110,3 +110,26 @@ def test_implement_prompt_requests_brute_force_cross_check(monkeypatch, repo, tm
     assert "EXAMPLES_PASSED: yes" in impl
     # The verdict line must remain the final instruction.
     assert impl.rstrip().endswith("otherwise.")
+
+
+def test_implement_prompt_includes_common_mistakes_checklist(monkeypatch, repo, tmp_path):
+    repo_dir, commit = repo
+    calls = []
+
+    def fake_chat(msg, model=None, msg_history=None, logging=print):
+        calls.append(msg)
+        history = list(msg_history or []) + [{"role": "user", "content": msg}]
+        history.append({"role": "assistant", "content": "EXAMPLES_PASSED: yes"})
+        return history
+
+    monkeypatch.setattr(coding_agent, "chat_with_agent", fake_chat)
+    make_system(repo_dir, commit, tmp_path).run_attempt()
+
+    impl = calls[1]
+    assert "common mistakes" in impl
+    assert "off-by-one" in impl
+    assert "smallest and largest inputs" in impl
+    assert "integer division" in impl
+    # The verdict line must remain the final instruction after the checklist.
+    assert impl.index("integer division") < impl.index("EXAMPLES_PASSED: yes")
+    assert impl.rstrip().endswith("otherwise.")
