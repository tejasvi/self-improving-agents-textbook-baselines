diff --git a/utils/common_utils.py b/utils/common_utils.py
index 576b448..3862a7e 100644
--- a/utils/common_utils.py
+++ b/utils/common_utils.py
@@ -26,9 +26,17 @@ def truncate_text(text, max_chars=8000):
         text = str(text)
     if max_chars is None or len(text) <= max_chars:
         return text
-    marker = f"\n... [truncated {len(text) - max_chars} characters] ...\n"
-    head = (max_chars - len(marker)) // 2
-    tail = max_chars - len(marker) - head
-    if head <= 0:
-        return text[:max_chars]
+    # The marker itself consumes part of the budget, so the reported dropped count
+    # depends on the marker length. Iterate until the count is self-consistent.
+    dropped = len(text) - max_chars
+    for _ in range(10):
+        marker = f"\n... [truncated {dropped} characters] ...\n"
+        head = (max_chars - len(marker)) // 2
+        tail = max_chars - len(marker) - head
+        if head <= 0:
+            return text[:max_chars]
+        new_dropped = len(text) - head - tail
+        if new_dropped == dropped:
+            break
+        dropped = new_dropped
     return text[:head] + marker + text[len(text) - tail:]
