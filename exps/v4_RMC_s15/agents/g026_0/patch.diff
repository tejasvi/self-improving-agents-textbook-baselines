+# Context-size controls
+MAX_TOOL_RESULT_CHARS = 8000   # max chars kept from a single tool result (head + tail)
+MAX_OLD_TOOL_RESULT_CHARS = 500  # max chars kept from tool results of older turns
+KEEP_RECENT_TOOL_RESULTS = 2   # number of most recent tool results kept at full (capped) size
+
+def truncate_text(text, max_chars=MAX_TOOL_RESULT_CHARS):
+    """Keep the head and tail of a long text, dropping the middle."""
+    text = text if isinstance(text, str) else str(text)
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - 2 * half
+    return text[:half] + f"\n... [{omitted} characters truncated] ...\n" + text[-half:]
+
+def _is_claude_tool_result_msg(msg):
+    content = msg.get('content') if isinstance(msg, dict) else None
+    return (
+        isinstance(content, list)
+        and any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content)
+    )
+
+def _is_openai_tool_output(msg):
+    return isinstance(msg, dict) and msg.get('type') == 'function_call_output'
+
+def compact_messages(messages):
+    """
+    Return a copy of messages where tool results from older turns are shortened.
+    The most recent KEEP_RECENT_TOOL_RESULTS tool results are kept (already capped at
+    creation time); older ones are cut to MAX_OLD_TOOL_RESULT_CHARS. Messages are not mutated.
+    """
+    positions = [
+        i for i, m in enumerate(messages)
+        if _is_claude_tool_result_msg(m) or _is_openai_tool_output(m)
+    ]
+    old_positions = set(positions[:-KEEP_RECENT_TOOL_RESULTS] if KEEP_RECENT_TOOL_RESULTS > 0 else positions)
+
+    compacted = []
+    for i, m in enumerate(messages):
+        if i not in old_positions:
+            compacted.append(m)
+            continue
+        if _is_openai_tool_output(m):
+            new_m = dict(m)
+            new_m['output'] = truncate_text(m.get('output', ''), MAX_OLD_TOOL_RESULT_CHARS)
+            compacted.append(new_m)
+        else:
+            new_blocks = []
+            for b in m['content']:
+                if isinstance(b, dict) and b.get('type') == 'tool_result':
+                    b = dict(b)
+                    b['content'] = truncate_text(b.get('content', ''), MAX_OLD_TOOL_RESULT_CHARS)
+                new_blocks.append(b)
+            compacted.append({**m, 'content': new_blocks})
+    return compacted
+
