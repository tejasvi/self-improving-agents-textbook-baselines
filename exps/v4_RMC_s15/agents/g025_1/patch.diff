+# Context management: older tool results are truncated before being resent to the model.
+KEEP_RECENT_MESSAGES = 4       # the most recent messages are always sent in full
+OLD_TOOL_RESULT_CHARS = 2000   # max characters kept for each older tool result
+
+def truncate_text(text, limit):
+    """Keep the head and tail of a long string, marking the omitted middle."""
+    if not isinstance(text, str) or len(text) <= limit:
+        return text
+    half = limit // 2
+    omitted = len(text) - 2 * half
+    return text[:half] + f"\n... [truncated {omitted} characters] ...\n" + text[-half:]
+
+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, limit=OLD_TOOL_RESULT_CHARS):
+    """
+    Return a copy of `messages` for sending to the model in which large tool results
+    from older messages are truncated. Recent messages and the original instruction
+    (which contains no tool results) are unchanged. The input list is not modified.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for idx, msg in enumerate(messages):
+        if idx >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        # Claude format: tool_result blocks inside the content list
+        content = msg.get('content')
+        if isinstance(content, list):
+            new_content = []
+            for block in content:
+                if isinstance(block, dict) and block.get('type') == 'tool_result':
+                    block = {**block, 'content': truncate_text(block.get('content'), limit)}
+                new_content.append(block)
+            msg = {**msg, 'content': new_content}
+        # OpenAI format: function_call_output items
+        elif msg.get('type') == 'function_call_output':
+            msg = {**msg, 'output': truncate_text(msg.get('output'), limit)}
+        compacted.append(msg)
+    return compacted
+
