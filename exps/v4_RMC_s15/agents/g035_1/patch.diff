+# Context-size controls
+MAX_TOOL_RESULT_CHARS = 10000   # cap for a single fresh tool result
+OLD_TURN_MAX_CHARS = 1500       # cap for tool results / long text in older turns
+KEEP_RECENT_MESSAGES = 6        # number of most recent messages kept untruncated
+
+def truncate_text(text, max_chars):
+    """
+    Shorten text to at most about max_chars characters by keeping the head and tail
+    (errors and final results usually appear at the end). Returns text unchanged if short enough.
+    """
+    if not isinstance(text, str) or len(text) <= max_chars:
+        return text
+    marker = f"\n<response clipped: {len(text) - max_chars} characters omitted>\n"
+    head_len = max_chars // 2
+    tail_len = max_chars - head_len
+    tail = text[len(text) - tail_len:] if tail_len > 0 else ''
+    return text[:head_len] + marker + tail
+
 def process_tool_call(tools_dict, tool_name, tool_input):
     try:
         if tool_name in tools_dict:
-            return tools_dict[tool_name]['function'](**tool_input)
+            result = tools_dict[tool_name]['function'](**tool_input)
         else:
             return f"Error: Tool '{tool_name}' not found"
     except Exception as e:
         return f"Error executing tool '{tool_name}': {str(e)}"
+    return truncate_text(result if isinstance(result, str) else str(result), MAX_TOOL_RESULT_CHARS)
+
+def compact_messages(messages, keep_recent=KEEP_RECENT_MESSAGES, old_max_chars=OLD_TURN_MAX_CHARS):
+    """
+    Return a copy of messages for sending to the API in which long tool results and long
+    text blocks in older turns (all but the last `keep_recent` messages) are truncated.
+    The original message list is not modified. Tool-use/tool-result pairing is preserved.
+    """
+    cutoff = max(0, len(messages) - keep_recent)
+    compacted = []
+    for i, msg in enumerate(messages):
+        if i >= cutoff or not isinstance(msg, dict):
+            compacted.append(msg)
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            compacted.append({**msg, 'content': truncate_text(content, old_max_chars)})
+        elif isinstance(content, list):
+            new_blocks = []
+            for block in content:
+                if isinstance(block, dict):
+                    block = dict(block)
+                    if block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                        block['content'] = truncate_text(block['content'], old_max_chars)
+                    elif block.get('type') in ('text', 'input_text') and isinstance(block.get('text'), str):
+                        block['text'] = truncate_text(block['text'], old_max_chars)
+                new_blocks.append(block)
+            compacted.append({**msg, 'content': new_blocks})
+        else:
+            compacted.append(msg)
+    # OpenAI-style function outputs are top-level items, not nested in content
+    for i, item in enumerate(compacted[:cutoff]):
+        if isinstance(item, dict) and item.get('type') == 'function_call_output' and isinstance(item.get('output'), str):
+            compacted[i] = {**item, 'output': truncate_text(item['output'], old_max_chars)}
+    return compacted
 
