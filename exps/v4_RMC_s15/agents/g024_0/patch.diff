+def truncate_output(text, max_chars=MAX_OUTPUT_CHARS):
+    if len(text) <= max_chars:
+        return text
+    half = max_chars // 2
+    omitted = len(text) - max_chars
+    return (
+        text[:half]
+        + f"\n... [{omitted} characters truncated] ...\n"
+        + text[-half:]
+    )
