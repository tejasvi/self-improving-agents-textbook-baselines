+def truncate_text(text, max_chars):
+    """
+    Shorten a string to at most `max_chars` characters, keeping its beginning and end.
+    The middle is replaced by a marker that reports how many characters were dropped.
+    Non-string input, or input that already fits, is returned unchanged.
+    """
+    if not isinstance(text, str) or len(text) <= max_chars:
+        return text
+    # Upper-bound marker length (the dropped count is never longer than len(text)).
+    max_marker = f"\n... [{len(text)} characters truncated] ...\n"
+    budget = max_chars - len(max_marker)
+    if budget <= 0:
+        # Limit too small to hold a marker: keep only the beginning.
+        return text[:max_chars]
+    head_len = (budget * 3) // 5  # about 60% of the budget from the start
+    tail_len = budget - head_len
+    dropped = len(text) - head_len - tail_len
+    head = text[:head_len]
+    tail = text[len(text) - tail_len:] if tail_len > 0 else ''
+    return f"{head}\n... [{dropped} characters truncated] ...\n{tail}"
