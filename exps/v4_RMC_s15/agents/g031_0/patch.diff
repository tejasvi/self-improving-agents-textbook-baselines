+# Number of most recent tool results sent to the model in full.
+KEEP_RECENT_TOOL_RESULTS = 2
+# Maximum characters kept from each older tool result.
+OLD_TOOL_RESULT_MAX_CHARS = 2000
+
+def _is_tool_result_message(msg):
+    if not isinstance(msg, dict) or msg.get('role') != 'user':
+        return False
+    content = msg.get('content')
+    return isinstance(content, list) and any(
+        isinstance(b, dict) and b.get('type') == 'tool_result' for b in content
+    )
+
+def shrink_old_tool_results(messages, keep_recent=KEEP_RECENT_TOOL_RESULTS, max_chars=OLD_TOOL_RESULT_MAX_CHARS):
+    """
+    Return a copy of `messages` where tool results older than the most recent `keep_recent`
+    user tool-result messages have their string content truncated. The input list and its
+    dicts are not modified, and tool_use / tool_result pairing is unchanged.
+    """
+    result_indices = [i for i, m in enumerate(messages) if _is_tool_result_message(m)]
+    old_indices = set(result_indices[:-keep_recent] if keep_recent > 0 else result_indices)
+    shrunk = []
+    for i, msg in enumerate(messages):
+        if i not in old_indices:
+            shrunk.append(msg)
+            continue
+        new_blocks = []
+        for block in msg['content']:
+            if isinstance(block, dict) and block.get('type') == 'tool_result' and isinstance(block.get('content'), str):
+                block = dict(block)
+                block['content'] = truncate_text(block['content'], max_chars)
+            new_blocks.append(block)
+        shrunk.append({**msg, 'content': new_blocks})
+    return shrunk
+
