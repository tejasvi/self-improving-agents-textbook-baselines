diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..8fee1e2
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,85 @@
+import os
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Run a shell command in a separate subprocess with a hard time limit and report the wall-clock time, exit code and (truncated) stdout/stderr.\n
+* Use this to time a solution on max-size inputs, e.g. `python sol.py < big_input.txt`.\n
+* If the command exceeds the time limit it is killed and the result clearly says TIMEOUT.\n
+* Prefer this over the bash tool for timing runs, because the bash tool hangs for 120s and then breaks its session on long commands.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run and time, e.g. 'python solution.py < input.txt'."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Hard time limit in seconds before the command is killed. Use about 10 for benchmarks."
+                }
+            },
+            "required": ["command", "timeout_seconds"]
+        }
+    }
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n... <{len(text) - MAX_OUTPUT_CHARS} chars truncated> ...\n" + text[-half:]
+
+def tool_function(command, timeout_seconds):
+    try:
+        timeout_seconds = float(timeout_seconds)
+    except (TypeError, ValueError):
+        return "Error: timeout_seconds must be a number."
+    if timeout_seconds <= 0:
+        return "Error: timeout_seconds must be positive."
+
+    start = time.monotonic()
+    try:
+        # start_new_session so that the whole process group can be killed on timeout
+        proc = subprocess.Popen(
+            command,
+            shell=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            stdin=subprocess.DEVNULL,
+            text=True,
+            start_new_session=True,
+        )
+    except Exception as e:
+        return f"Error: failed to start command: {e}"
+
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout_seconds)
+        elapsed = time.monotonic() - start
+        status = f"exit code: {proc.returncode}"
+        header = f"Status: FINISHED\nWall time: {elapsed:.3f}s\n{status}"
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except Exception:
+            stdout, stderr = '', ''
+        elapsed = time.monotonic() - start
+        header = (
+            f"Status: TIMEOUT - command exceeded {timeout_seconds:g}s and was killed. "
+            f"The solution is TOO SLOW for this input size; optimize the algorithm.\n"
+            f"Wall time: {elapsed:.3f}s\nexit code: killed"
+        )
+
+    return (
+        f"{header}\n"
+        f"--- stdout ---\n{_truncate(stdout or '')}\n"
+        f"--- stderr ---\n{_truncate(stderr or '')}"
+    )
