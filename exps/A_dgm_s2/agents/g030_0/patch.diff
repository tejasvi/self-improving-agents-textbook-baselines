 import sys
 
 
+def min_difference(nums):
+    # With at most three changes, we can remove any 3 elements.
+    # The answer is the minimum over the 4 ways to keep a contiguous
+    # window of n-3 elements in sorted order.
+    n = len(nums)
+    if n <= 4:
+        return 0
+    a = sorted(nums)
+    return min(a[n - 4 + i] - a[i] for i in range(4))
+
