diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..934af1a
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,191 @@
+import json
+import math
+import re
+import subprocess
+
+MAX_OUTPUT_CHARS = 2000
+CONTEXT_CHARS = 30
+PER_SAMPLE_TIMEOUT = 10.0
+MAX_SAMPLES = 50
+
+_NUM_RE = re.compile(r'^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$')
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution command on sample inputs and compare its output to the expected output.\n
+* For each sample it reports: exact match (yes/no), token-wise numeric comparison (max absolute and relative error over numeric tokens), the first differing character index with surrounding context, and the actual versus expected output.\n
+* Use it after implementing the solution, on ALL samples extracted from the problem statement.\n
+* For floating-point output, any difference in printed digits versus the expected sample is a red flag: investigate numerics (e.g. math.fsum, direct power computation, fractions.Fraction or decimal reference) rather than accepting a tolerance match.\n
+* `samples` must be a JSON string holding a list of objects with keys "input" and "expected", e.g. [{"input": "3\\n1 2 3\\n", "expected": "6\\n"}].""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "How to run the solution, e.g. 'python3 /work/repo/solution.py'. The sample input is fed on stdin."
+                },
+                "samples": {
+                    "type": "string",
+                    "description": "JSON text containing a list of objects {\"input\": str, \"expected\": str}."
+                }
+            },
+            "required": ["command", "samples"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n... <{len(text) - MAX_OUTPUT_CHARS} chars truncated> ...\n" + text[-half:]
+
+
+def _run(command, stdin_text):
+    """Run command with stdin_text. Returns (status, stdout, stderr) where status is 'ok', 'timeout' or 'error'."""
+    try:
+        proc = subprocess.Popen(
+            command,
+            shell=True,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+    except Exception as e:
+        return "error", "", f"failed to start command: {e}"
+    try:
+        out, err = proc.communicate(input=stdin_text, timeout=PER_SAMPLE_TIMEOUT)
+    except subprocess.TimeoutExpired:
+        try:
+            import os, signal
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            proc.kill()
+        proc.communicate()
+        return "timeout", "", f"killed after {PER_SAMPLE_TIMEOUT} seconds"
+    if proc.returncode != 0:
+        return "error", out or "", f"exit code {proc.returncode}: {err or ''}"
+    return "ok", out or "", err or ""
+
+
+def _numeric_compare(actual, expected):
+    """Token-wise comparison. Returns a dict describing numeric agreement."""
+    a_tok = actual.split()
+    e_tok = expected.split()
+    if len(a_tok) != len(e_tok):
+        return {"token_count_match": False, "actual_tokens": len(a_tok), "expected_tokens": len(e_tok)}
+    max_abs = 0.0
+    max_rel = 0.0
+    non_numeric_mismatches = 0
+    numeric_pairs = 0
+    for a, e in zip(a_tok, e_tok):
+        if a == e:
+            continue
+        if _NUM_RE.match(a) and _NUM_RE.match(e):
+            numeric_pairs += 1
+            fa, fe = float(a), float(e)
+            if math.isnan(fa) or math.isnan(fe) or math.isinf(fa) or math.isinf(fe):
+                max_abs = math.inf
+                max_rel = math.inf
+                continue
+            diff = abs(fa - fe)
+            max_abs = max(max_abs, diff)
+            denom = abs(fe)
+            if denom > 0:
+                max_rel = max(max_rel, diff / denom)
+            elif diff > 0:
+                max_rel = math.inf
+        else:
+            non_numeric_mismatches += 1
+    return {
+        "token_count_match": True,
+        "differing_numeric_tokens": numeric_pairs,
+        "max_abs_error": max_abs,
+        "max_rel_error": max_rel,
+        "non_numeric_mismatches": non_numeric_mismatches,
+        "tolerance_match_1e-9": non_numeric_mismatches == 0 and max_abs <= 1e-9,
+    }
+
+
+def _first_diff(actual, expected):
+    n = min(len(actual), len(expected))
+    idx = None
+    for i in range(n):
+        if actual[i] != expected[i]:
+            idx = i
+            break
+    if idx is None:
+        if len(actual) == len(expected):
+            return None
+        idx = n
+    lo = max(0, idx - CONTEXT_CHARS)
+    return {
+        "index": idx,
+        "actual_context": actual[lo: idx + CONTEXT_CHARS],
+        "expected_context": expected[lo: idx + CONTEXT_CHARS],
+    }
+
+
+def tool_function(command, samples):
+    try:
+        sample_list = json.loads(samples)
+    except (TypeError, ValueError) as e:
+        return f"Error: samples must be a JSON list of objects with 'input' and 'expected': {e}"
+    if not isinstance(sample_list, list) or not sample_list:
+        return "Error: samples must be a non-empty JSON list."
+    if len(sample_list) > MAX_SAMPLES:
+        return f"Error: at most {MAX_SAMPLES} samples are allowed."
+
+    reports = []
+    exact_count = 0
+    tolerance_count = 0
+    for idx, sample in enumerate(sample_list):
+        if not isinstance(sample, dict) or "input" not in sample or "expected" not in sample:
+            reports.append(f"Sample {idx}: Error: each sample needs 'input' and 'expected' keys.")
+            continue
+        sin = str(sample["input"])
+        expected = str(sample["expected"])
+        status, actual, err = _run(command, sin)
+        lines = [f"=== Sample {idx} ==="]
+        if status != "ok":
+            lines.append(f"Status: {status.upper()} ({err.strip()[:MAX_OUTPUT_CHARS]})")
+            lines.append("Exact match: no")
+            reports.append("\n".join(lines))
+            continue
+        exact = actual.strip() == expected.strip()
+        if exact:
+            exact_count += 1
+        cmp = _numeric_compare(actual.strip(), expected.strip())
+        if cmp.get("tolerance_match_1e-9"):
+            tolerance_count += 1
+        lines.append(f"Exact match: {'yes' if exact else 'no'}")
+        if not exact:
+            if cmp["token_count_match"]:
+                lines.append(
+                    f"Numeric comparison: differing numeric tokens={cmp['differing_numeric_tokens']}, "
+                    f"max_abs_error={cmp['max_abs_error']!r}, max_rel_error={cmp['max_rel_error']!r}, "
+                    f"non_numeric_mismatches={cmp['non_numeric_mismatches']}, "
+                    f"match within 1e-9={'yes' if cmp['tolerance_match_1e-9'] else 'no'}"
+                )
+            else:
+                lines.append(f"Numeric comparison: token count differs (actual={cmp['actual_tokens']}, expected={cmp['expected_tokens']})")
+            d = _first_diff(actual.strip(), expected.strip())
+            if d:
+                lines.append(f"First difference at character index {d['index']}:")
+                lines.append(f"  actual  : {d['actual_context']!r}")
+                lines.append(f"  expected: {d['expected_context']!r}")
+        lines.append(f"Actual output: {_truncate(actual.strip())!r}")
+        lines.append(f"Expected output: {_truncate(expected.strip())!r}")
+        if err.strip():
+            lines.append(f"Stderr: {_truncate(err.strip())}")
+        reports.append("\n".join(lines))
+
+    summary = (
+        f"Summary: {len(sample_list)} samples, exact matches={exact_count}, "
+        f"tolerance (1e-9) matches={tolerance_count}."
+    )
+    return "\n\n".join(reports) + "\n\n" + summary
