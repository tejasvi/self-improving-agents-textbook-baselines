@@ -0,0 +1,91 @@
+import difflib
+import glob
+import os
+import shlex
+import subprocess
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Run a solution program on every sample test case in a directory and compare its output exactly.\n
+* Each sample is a pair of files NAME.in (stdin) and NAME.out (expected stdout).\n
+* The program is run as `python3 <solution_path>` unless `command` is given. If `command` contains `{solution}`, it is replaced by the solution path; otherwise the solution path is appended to it.\n
+* Comparison is exact after stripping trailing whitespace on each line and at the end of the output.\n
+* Returns a PASS/FAIL line per sample, and a unified diff (expected vs actual) for each failing sample.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution program to run."
+                },
+                "samples_dir": {
+                    "type": "string",
+                    "description": "Directory containing NAME.in and NAME.out sample files."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Optional shell command used to run the solution (e.g. 'python3' or 'pypy3'). Defaults to 'python3'."
+                }
+            },
+            "required": ["solution_path", "samples_dir"]
+        }
+    }
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+def tool_function(solution_path, samples_dir, command=None):
+    if not os.path.isdir(samples_dir):
+        return f"Error: samples_dir '{samples_dir}' does not exist."
+    inputs = sorted(glob.glob(os.path.join(samples_dir, '*.in')))
+    if not inputs:
+        return f"Error: no *.in sample files found in '{samples_dir}'."
+
+    if command:
+        if '{solution}' in command:
+            base_cmd = command.replace('{solution}', shlex.quote(solution_path))
+        else:
+            base_cmd = f"{command} {shlex.quote(solution_path)}"
+    else:
+        base_cmd = f"python3 {shlex.quote(solution_path)}"
+
+    reports = []
+    passed = 0
+    for in_path in inputs:
+        name = os.path.splitext(os.path.basename(in_path))[0]
+        out_path = os.path.join(samples_dir, name + '.out')
+        if not os.path.exists(out_path):
+            reports.append(f"[{name}] FAIL: missing expected output file {name}.out")
+            continue
+        with open(in_path, 'r', encoding='utf-8') as f:
+            stdin_text = f.read()
+        with open(out_path, 'r', encoding='utf-8') as f:
+            expected_text = f.read()
+        try:
+            proc = subprocess.run(
+                base_cmd, shell=True, input=stdin_text, capture_output=True,
+                text=True, timeout=10,
+            )
+            actual_text = proc.stdout
+            run_note = '' if proc.returncode == 0 else f" (exit code {proc.returncode}, stderr: {proc.stderr.strip()[-500:]})"
+        except subprocess.TimeoutExpired:
+            reports.append(f"[{name}] FAIL: timed out after 10 seconds")
+            continue
+
+        exp_lines = _normalize(expected_text)
+        act_lines = _normalize(actual_text)
+        if exp_lines == act_lines and proc.returncode == 0:
+            passed += 1
+            reports.append(f"[{name}] PASS")
+        else:
+            diff = '\n'.join(difflib.unified_diff(
+                exp_lines, act_lines, fromfile=f'{name}.out (expected)',
+                tofile=f'{name} (actual)', lineterm=''))
+            reports.append(f"[{name}] FAIL{run_note}\n{diff if diff else '(no line differences; check exit code / stderr)'}")
+
+    summary = f"{passed}/{len(inputs)} samples passed exactly."
+    return summary + "\n" + "\n".join(reports)
