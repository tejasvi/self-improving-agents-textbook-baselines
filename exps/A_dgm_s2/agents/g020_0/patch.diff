diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..d2321f0
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,144 @@
+import subprocess
+import time
+
+DEFAULT_NUM_CASES = 200
+DEFAULT_TIMEOUT = 10.0
+MAX_CASES_LIMIT = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Compare a candidate solution against a brute-force reference on many random inputs.\n
+* Runs `python3 gen_path SEED` (plus `max` as an extra argument when max_size is true) for SEED = 0..num_cases-1 to create one input per seed.\n
+* Runs both `python3 brute_path` and `python3 solution_path` on that input (stdin) with a timeout each.\n
+* Outputs are compared after stripping trailing whitespace on each line and surrounding blank lines.\n
+* Stops at the first mismatch and reports the pass count, the failing input, the brute output, the solution output and the raw stderr of both programs (no parsing of errors).\n
+* Use max_size=true with a generator that supports a `max` argument to test maximum-size inputs for timing.\n
+* The generator must print one test input to stdout; it is expected to be deterministic for a given seed.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the candidate Python solution file."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python file (assumed correct)."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the random input generator Python file. Called as `python3 gen_path SEED`."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of seeded random cases to run (default 200)."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each program run (default 10)."
+                },
+                "max_size": {
+                    "type": "boolean",
+                    "description": "If true, the generator is called with an extra `max` argument to produce maximum-size inputs (default false)."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path"]
+        }
+    }
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in (text or "").replace("\r\n", "\n").split("\n")]
+    return "\n".join(lines).strip()
+
+
+def _run(args, case_input, timeout):
+    """Run a python program; return (stdout, stderr, returncode, timed_out, elapsed)."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3"] + args,
+            input=case_input,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, False, time.time() - start
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, None, True, time.time() - start
+
+
+def _generate(gen_path, seed, max_size, timeout):
+    args = [gen_path, str(seed)]
+    if max_size:
+        args.append("max")
+    out, err, code, timed_out, _ = _run(args, "", timeout)
+    if timed_out:
+        return None, f"Generator TIMED OUT after {timeout}s on seed {seed}.\n--- stderr ---\n{err}"
+    if code != 0:
+        return None, f"Generator exited with code {code} on seed {seed}.\n--- stderr ---\n{err}"
+    return out, None
+
+
+def tool_function(solution_path, brute_path, gen_path, num_cases=None, timeout=None, max_size=False):
+    try:
+        num_cases = DEFAULT_NUM_CASES if num_cases is None else int(num_cases)
+    except (TypeError, ValueError):
+        return "Error: 'num_cases' must be an integer."
+    num_cases = max(0, min(num_cases, MAX_CASES_LIMIT))
+    timeout = DEFAULT_TIMEOUT if timeout is None else float(timeout)
+    max_size = bool(max_size)
+
+    passed = 0
+    for seed in range(num_cases):
+        case_input, gen_err = _generate(gen_path, seed, max_size, timeout)
+        if gen_err is not None:
+            return f"Summary: {passed}/{num_cases} cases passed before generator failure.\n\n{gen_err}"
+
+        b_out, b_err, b_code, b_timed_out, _ = _run([brute_path], case_input, timeout)
+        s_out, s_err, s_code, s_timed_out, s_elapsed = _run([solution_path], case_input, timeout)
+
+        if b_timed_out or b_code != 0:
+            return (
+                f"Summary: {passed}/{num_cases} cases passed. Stopped at seed {seed}: "
+                f"the brute-force reference failed (timed out: {b_timed_out}, exit code: {b_code}); "
+                f"the brute force itself may be wrong or too slow.\n\n"
+                f"=== Seed {seed} ===\n--- input ---\n{case_input}\n"
+                f"--- brute stdout ---\n{b_out}\n--- brute stderr ---\n{b_err}"
+            )
+
+        if s_timed_out:
+            status = f"solution TIMED OUT after {timeout}s"
+        elif s_code != 0:
+            status = f"solution exited with code {s_code}"
+        elif _normalize(s_out) != _normalize(b_out):
+            status = "output MISMATCH"
+        else:
+            passed += 1
+            continue
+
+        return (
+            f"Summary: {passed}/{num_cases} cases passed. First failing seed: {seed} ({status}).\n\n"
+            f"=== Seed {seed}: FAIL ===\n"
+            f"--- input ---\n{case_input}\n"
+            f"--- expected (brute stdout) ---\n{b_out}\n"
+            f"--- actual (solution stdout) ---\n{s_out}\n"
+            f"--- solution stderr ---\n{s_err}\n"
+            f"Solution elapsed: {s_elapsed:.3f}s"
+        )
+
+    return f"Summary: {passed}/{num_cases} cases passed. No mismatches found."
+
+
+if __name__ == "__main__":
+    import sys
+    if len(sys.argv) < 4:
+        print("usage: stress_test.py solution.py brute.py gen.py [num_cases] [timeout] [max]")
+        sys.exit(1)
+    n = int(sys.argv[4]) if len(sys.argv) > 4 else None
+    t = float(sys.argv[5]) if len(sys.argv) > 5 else None
+    print(tool_function(sys.argv[1], sys.argv[2], sys.argv[3], n, t, len(sys.argv) > 6))
