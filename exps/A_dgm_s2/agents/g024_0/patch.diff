+def _changed_files(diff_str):
+    """
+    Return the list of file paths changed in a git diff, parsed from the
+    `diff --git a/X b/Y` lines (uses the b/ path, i.e. the post-change path).
+    """
+    files = []
+    for line in (diff_str or '').splitlines():
+        m = re.match(r'^diff --git a/(\S+) b/(\S+)', line)
+        if m:
+            files.append(m.group(2))
+    return files
+
+def _is_test_or_scratch_file(path):
+    norm = '/' + path.replace('\\', '/').lstrip('/')
+    base = os.path.basename(norm)
+    if base.startswith('test_') or base.endswith('_test.py'):
+        return True
+    if base in ('brute.py', 'gen.py'):
+        return True
+    if '/tests/' in norm or '/test/' in norm:
+        return True
+    return False
+
+def _has_meaningful_patch(diff_str):
+    """
+    True only if the diff changes at least one file that is not a test or scratch file.
+    """
+    return any(not _is_test_or_scratch_file(f) for f in _changed_files(diff_str))
