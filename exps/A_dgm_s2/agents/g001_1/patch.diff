+    def _clean_history(self, msg_history):
+        """
+        Remove trailing assistant messages whose text is empty/whitespace-only,
+        and drop any message whose content list is empty.
+        """
+        def _text_of(msg):
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                parts = []
+                for block in content:
+                    if isinstance(block, dict):
+                        if block.get('type') == 'text':
+                            parts.append(block.get('text') or '')
+                    elif getattr(block, 'type', None) == 'text':
+                        parts.append(getattr(block, 'text', '') or '')
+                return ''.join(parts)
+            return ''
+
+        cleaned = []
+        for msg in msg_history or []:
+            content = msg.get('content')
+            if isinstance(content, list) and len(content) == 0:
+                continue
+            if content is None or (isinstance(content, str) and content.strip() == ''):
+                continue
+            cleaned.append(msg)
+
+        # Strip trailing assistant messages with no text and no tool calls (bounded loop)
+        for _ in range(len(cleaned)):
+            if not cleaned:
+                break
+            last = cleaned[-1]
+            if last.get('role') != 'assistant' or _text_of(last).strip():
+                break
+            content = last.get('content')
+            has_tool_use = isinstance(content, list) and any(
+                (isinstance(b, dict) and b.get('type') == 'tool_use') or getattr(b, 'type', None) == 'tool_use'
+                for b in content
+            )
+            if has_tool_use:
+                break
+            cleaned.pop()
+        return cleaned
+
+    _SOURCE_EXTS = ('.py', '.js', '.go', '.rs', '.java', '.cpp', '.h')
+    _STUB_MARKERS = ('pass', 'TODO', 'NotImplemented', 'unimplemented')
+
+    def _find_candidate_source_files(self):
+        """
+        List tracked, non-test, non-README, non-hidden source files in git_tempdir,
+        with stub-like files (containing pass/TODO/NotImplemented/unimplemented) first.
+        """
+        try:
+            result = subprocess.run(
+                ['git', 'ls-files'],
+                cwd=self.git_tempdir,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+        except Exception as e:
+            safe_log(f"Failed to list git files: {e}")
+            return []
+        if result.returncode != 0:
+            return []
+
+        candidates = []
+        for path in result.stdout.splitlines():
+            path = path.strip()
+            if not path:
+                continue
+            parts = path.replace('\\', '/').split('/')
+            basename = parts[-1]
+            if any(p.startswith('.') for p in parts):
+                continue
+            if basename.upper().startswith('README'):
+                continue
+            if self._is_test_file(path):
+                continue
+            if not path.endswith(self._SOURCE_EXTS):
+                continue
+            candidates.append(path)
+
+        def _priority(path):
+            full = os.path.join(self.git_tempdir, path)
+            try:
+                with open(full, 'r', encoding='utf-8', errors='ignore') as f:
+                    text = f.read()
+            except OSError:
+                return 1
+            return 0 if any(m in text for m in self._STUB_MARKERS) else 1
+
+        return sorted(candidates, key=lambda p: (_priority(p), p))
+
+    def _render_files(self, files, max_chars=6000):
+        """
+        Read the given files (relative to git_tempdir) and format them for a prompt,
+        truncating the total output to roughly max_chars.
+        """
+        parts = []
+        used = 0
+        for path in files:
+            full = os.path.join(self.git_tempdir, path)
+            try:
+                with open(full, 'r', encoding='utf-8', errors='ignore') as f:
+                    text = f.read()
+            except OSError as e:
+                text = f"<could not read: {e}>"
+            header = f"--- {path} ---\n"
+            budget = max_chars - used - len(header)
+            if budget <= 0:
+                parts.append(f"--- {path} --- <omitted: max size reached>")
+                break
+            if len(text) > budget:
+                text = text[:budget] + "\n... <truncated>"
+            block = header + text + "\n"
+            parts.append(block)
+            used += len(block)
+        return "\n".join(parts) if parts else "<no candidate source files found>"
+
