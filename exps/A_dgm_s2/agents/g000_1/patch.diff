+    # Matches "diff --git a/<path> b/<path>" headers in a git diff
+    _DIFF_HEADER_RE = re.compile(r'^diff --git a/(.+?) b/', re.MULTILINE)
+
+    def _changed_files(self, diff):
+        """
+        Extract the list of changed file paths from a git diff string.
+        """
+        return self._DIFF_HEADER_RE.findall(diff or '')
+
+    def _is_test_file(self, path):
+        """
+        Generic heuristic for whether a path refers to a test file.
+        """
+        normalized = path.replace('\\', '/')
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        if (basename.startswith('test_') and basename.endswith('.py')) \
+                or basename.endswith('_test.py') \
+                or basename.endswith('_test.go') \
+                or basename.endswith('.test.js') \
+                or basename.endswith('.spec.js'):
+            return True
+        # Any directory component named tests/test/spec
+        return any(p in ('tests', 'test', 'spec') for p in parts[:-1])
+
+    def _has_source_edits(self):
+        """
+        Returns True if at least one changed file is not a test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        return any(not self._is_test_file(f) for f in self._changed_files(diff))
+
+    def _current_changed_files_str(self):
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = self._changed_files(diff)
+        return ', '.join(files) if files else 'none'
+
