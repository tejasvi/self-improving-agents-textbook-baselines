diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..cabb246
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,178 @@
+import math
+import shlex
+import subprocess
+
+MAX_INPUT_CHARS = 1500
+MAX_OUTPUT_CHARS = 1500
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Differential stress test: compare a solution against a trusted reference on many generated inputs.\n
+* generator_command must print ONE test input to stdout when run as: `<generator_command> <seed> <mode>` (seed is an integer, mode is one mode name from `modes`).
+* For each seed and each mode, the generator output is fed on stdin to both solution_command and reference_command.
+* comparison 'exact' requires identical whitespace-separated tokens; 'tolerance' allows numeric tokens to differ by up to eps (absolute or relative).
+* Stops at the first mismatch, runtime error or timeout and reports the failing input, both outputs, the seed/mode and the diff magnitude. Otherwise reports a pass summary.
+* Use a reference that is independent of the solution (brute force or exact arithmetic with fractions/decimal for floating-point answers).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_command": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution under test, reading stdin and writing stdout, e.g. 'python3 /path/solution.py'."
+                },
+                "reference_command": {
+                    "type": "string",
+                    "description": "Shell command that runs the trusted reference solution, reading stdin and writing stdout."
+                },
+                "generator_command": {
+                    "type": "string",
+                    "description": "Shell command that takes a seed and a mode as arguments and prints one test input to stdout, e.g. 'python3 /path/gen.py'."
+                },
+                "num_cases": {
+                    "type": "integer",
+                    "description": "Number of seeds to test (seeds 1..num_cases). Each seed is run once per mode. Use at least 300."
+                },
+                "modes": {
+                    "type": "string",
+                    "description": "Comma-separated mode names passed to the generator as its second argument, e.g. 'small,max,equal,ties'. Default: a single empty mode."
+                },
+                "comparison": {
+                    "type": "string",
+                    "description": "'exact' for exact token equality, or 'tolerance' for numeric tokens compared with abs/rel eps (non-numeric tokens must still match exactly)."
+                },
+                "eps": {
+                    "type": "number",
+                    "description": "Tolerance for 'tolerance' comparison (a numeric token pair matches if abs diff <= eps or rel diff <= eps). Default 1e-9."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Per-command timeout in seconds for the generator, solution and reference. Default 10."
+                }
+            },
+            "required": ["solution_command", "reference_command", "generator_command", "num_cases", "comparison"]
+        }
+    }
+
+
+def _truncate(text, limit):
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + f"\n... <{len(text) - limit} chars truncated> ...\n" + text[-half:]
+
+
+def _run(command, stdin_text, timeout, args=()):
+    """Run a shell command. Returns (returncode, stdout, stderr, timed_out)."""
+    cmd = command if not args else command + " " + " ".join(shlex.quote(str(a)) for a in args)
+    try:
+        proc = subprocess.run(
+            cmd, shell=True, input=stdin_text, capture_output=True,
+            text=True, timeout=timeout
+        )
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired:
+        return None, '', '', True
+
+
+def _to_float(tok):
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def compare_outputs(expected, actual, comparison, eps):
+    """Return (ok, max_abs, max_rel, reason). reason is '' when ok."""
+    exp_toks = expected.split()
+    act_toks = actual.split()
+    if len(exp_toks) != len(act_toks):
+        return False, 0.0, 0.0, f"token count differs (reference {len(exp_toks)}, solution {len(act_toks)})"
+    max_abs = 0.0
+    max_rel = 0.0
+    for e, a in zip(exp_toks, act_toks):
+        if e == a:
+            continue
+        ef, af = _to_float(e), _to_float(a)
+        if ef is None or af is None or comparison != 'tolerance':
+            return False, max_abs, max_rel, f"token differs: reference '{e}' vs solution '{a}'"
+        if math.isnan(ef) or math.isnan(af) or math.isinf(ef) or math.isinf(af):
+            if ef != af:
+                return False, max_abs, max_rel, f"token differs: reference '{e}' vs solution '{a}'"
+            continue
+        diff = abs(ef - af)
+        rel = diff / abs(ef) if ef != 0 else diff
+        max_abs = max(max_abs, diff)
+        max_rel = max(max_rel, rel)
+        if diff > eps and rel > eps:
+            return False, max_abs, max_rel, f"numeric diff too large: reference '{e}' vs solution '{a}'"
+    return True, max_abs, max_rel, ''
+
+
+def tool_function(solution_command, reference_command, generator_command, num_cases, comparison,
+                  modes=None, eps=None, timeout_seconds=None):
+    try:
+        num_cases = int(num_cases)
+    except (TypeError, ValueError):
+        return "Error: num_cases must be an integer."
+    if num_cases <= 0:
+        return "Error: num_cases must be positive."
+    comparison = (comparison or 'exact').strip().lower()
+    if comparison not in ('exact', 'tolerance'):
+        return "Error: comparison must be 'exact' or 'tolerance'."
+    try:
+        eps = 1e-9 if eps is None else float(eps)
+    except (TypeError, ValueError):
+        return "Error: eps must be a number."
+    try:
+        timeout = 10 if timeout_seconds is None else int(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout = 10
+    if timeout <= 0:
+        timeout = 10
+    mode_list = [m.strip() for m in (modes or '').split(',') if m.strip()] or ['']
+
+    total = 0
+    max_abs_all = 0.0
+    max_rel_all = 0.0
+    for seed in range(1, num_cases + 1):
+        for mode in mode_list:
+            label = f"seed={seed} mode='{mode}'" if mode else f"seed={seed}"
+            args = [seed] + ([mode] if mode else [])
+            rc, gen_out, gen_err, gen_timeout = _run(generator_command, '', timeout, args=args)
+            if gen_timeout:
+                return f"FAIL ({label}): generator TIMEOUT after {timeout}s."
+            if rc != 0:
+                return f"FAIL ({label}): generator exited with code {rc}.\nstderr:\n{_truncate(gen_err.strip(), MAX_OUTPUT_CHARS)}"
+            test_input = gen_out if gen_out.endswith('\n') else gen_out + '\n'
+
+            rc_r, ref_out, ref_err, ref_to = _run(reference_command, test_input, timeout)
+            if ref_to:
+                return f"FAIL ({label}): reference TIMEOUT after {timeout}s. Input:\n{_truncate(test_input, MAX_INPUT_CHARS)}"
+            if rc_r != 0:
+                return (f"FAIL ({label}): reference crashed with exit code {rc_r}. Fix the reference first.\n"
+                        f"Input:\n{_truncate(test_input, MAX_INPUT_CHARS)}\nstderr:\n{_truncate(ref_err.strip(), MAX_OUTPUT_CHARS)}")
+
+            rc_s, sol_out, sol_err, sol_to = _run(solution_command, test_input, timeout)
+            if sol_to:
+                return (f"FAIL ({label}): solution TIMEOUT after {timeout}s.\n"
+                        f"Input:\n{_truncate(test_input, MAX_INPUT_CHARS)}\nReference output:\n{_truncate(ref_out.strip(), MAX_OUTPUT_CHARS)}")
+            if rc_s != 0:
+                return (f"FAIL ({label}): solution runtime error, exit code {rc_s}.\n"
+                        f"Input:\n{_truncate(test_input, MAX_INPUT_CHARS)}\nstderr:\n{_truncate(sol_err.strip(), MAX_OUTPUT_CHARS)}")
+
+            ok, max_abs, max_rel, reason = compare_outputs(ref_out, sol_out, comparison, eps)
+            max_abs_all = max(max_abs_all, max_abs)
+            max_rel_all = max(max_rel_all, max_rel)
+            if not ok:
+                return (f"FAIL ({label}): {reason}.\n"
+                        f"Input:\n{_truncate(test_input, MAX_INPUT_CHARS)}\n"
+                        f"Reference output:\n{_truncate(ref_out.strip(), MAX_OUTPUT_CHARS)}\n"
+                        f"Solution output:\n{_truncate(sol_out.strip(), MAX_OUTPUT_CHARS)}\n"
+                        f"Max abs diff {max_abs:.3g}, max rel diff {max_rel:.3g} (eps={eps:g}).")
+            total += 1
+
+    expected_total = num_cases * len(mode_list)
+    return (f"{total}/{expected_total} passed ({comparison} comparison, eps={eps:g}), "
+            f"max diff abs {max_abs_all:.3g}, rel {max_rel_all:.3g}")
