@@ -0,0 +1,112 @@
+import difflib
+import json
+import os
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "sample_runner",
+        "description": """Run a Python solution against sample test cases and report exact-match results.\n
+* `samples_file` must be a JSON file containing a list of objects, each with an `input` string (stdin) and an `expected` string (expected stdout).\n
+* For each sample it runs `python3 solution_path` with the input on stdin and compares stdout to `expected`, ignoring trailing whitespace on each line.\n
+* Returns, per sample, PASS or FAIL, the actual output, the expected output, a unified diff, and raw stderr (if any).\n
+* Use it after implementing the solution to confirm the output matches every sample exactly.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run with python3."
+                },
+                "samples_file": {
+                    "type": "string",
+                    "description": "Path to a JSON file containing a list of objects with 'input' and 'expected' string fields."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Timeout in seconds for each sample run. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "samples_file"]
+        }
+    }
+
+def _normalize(text):
+    return "\n".join(line.rstrip() for line in text.rstrip().split("\n")) if text.strip() else ""
+
+def _run_one(solution_path, input_text, timeout):
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=input_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return "", "", f"Failed to run solution: {e}"
+
+def tool_function(solution_path, samples_file, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    if not os.path.isfile(samples_file):
+        return f"Error: samples file not found: {samples_file}"
+    try:
+        with open(samples_file, "r") as f:
+            samples = json.load(f)
+    except Exception as e:
+        return f"Error: could not read samples file as JSON: {e}"
+    if not isinstance(samples, list):
+        return "Error: samples file must contain a JSON list of {input, expected} objects."
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    reports = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        if not isinstance(sample, dict) or "input" not in sample or "expected" not in sample:
+            reports.append(f"=== Sample {idx}: FAIL (malformed sample; needs 'input' and 'expected') ===")
+            continue
+        input_text = str(sample["input"])
+        expected = str(sample["expected"])
+        actual, stderr, note = _run_one(solution_path, input_text, timeout)
+
+        ok = note is None and _normalize(actual) == _normalize(expected)
+        if ok:
+            passed += 1
+        status = "PASS" if ok else "FAIL"
+        block = [f"=== Sample {idx}: {status} ==="]
+        if note:
+            block.append(f"Note: {note}")
+        block.append("--- actual output ---")
+        block.append(actual.rstrip("\n") if actual.strip() else "(empty)")
+        block.append("--- expected output ---")
+        block.append(expected.rstrip("\n") if expected.strip() else "(empty)")
+        if not ok:
+            diff = difflib.unified_diff(
+                [l.rstrip() for l in expected.rstrip("\n").split("\n")],
+                [l.rstrip() for l in actual.rstrip("\n").split("\n")],
+                fromfile="expected",
+                tofile="actual",
+                lineterm="",
+            )
+            block.append("--- diff ---")
+            block.append("\n".join(diff) or "(no line differences; check whitespace)")
+        if stderr.strip():
+            block.append("--- stderr ---")
+            block.append(stderr.rstrip("\n"))
+        reports.append("\n".join(block))
+
+    summary = f"Summary: {passed}/{len(samples)} samples PASS" + (
+        " (all samples match exactly)" if passed == len(samples) else ""
+    )
+    return "\n\n".join(reports + [summary]) if samples else "No samples found in samples file."
