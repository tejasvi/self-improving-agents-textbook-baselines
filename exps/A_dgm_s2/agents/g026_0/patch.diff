+    @staticmethod
+    def _is_empty_block(block):
+        if isinstance(block, dict):
+            return block.get('type') == 'text' and not str(block.get('text', '') or '').strip()
+        return False
+
+    def _sanitize_history(self, history):
+        """
+        Remove messages whose content consists only of empty text blocks (or an
+        empty string), so that a previous empty assistant turn is not carried over.
+        """
+        if not history:
+            return []
+        cleaned = []
+        for msg in history:
+            if not isinstance(msg, dict):
+                cleaned.append(msg)
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                if content.strip():
+                    cleaned.append(msg)
+                continue
+            if isinstance(content, list):
+                if len(content) == 0 or all(self._is_empty_block(b) for b in content):
+                    continue
+            cleaned.append(msg)
+        return cleaned
+
+    def _snapshot_deliverable(self):
+        """Return {name: contents} for existing deliverable files."""
+        snap = {}
+        for name in self.DELIVERABLE_NAMES:
+            path = os.path.join(self.git_tempdir, name)
+            if os.path.isfile(path):
+                with open(path, 'r', encoding='utf-8', errors='replace') as f:
+                    snap[name] = f.read()
+        return snap
+
+    def _restore_deliverable(self, snap):
+        """Restore deliverables from snapshot if they are now missing or empty."""
+        restored = []
+        for name, contents in snap.items():
+            if not contents.strip():
+                continue
+            path = os.path.join(self.git_tempdir, name)
+            if not os.path.exists(path) or os.path.getsize(path) == 0:
+                with open(path, 'w', encoding='utf-8') as f:
+                    f.write(contents)
+                restored.append(name)
+        return restored
+
