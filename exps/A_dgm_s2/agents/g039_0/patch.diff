+#!/usr/bin/env python3
+"""Test harness core for the test-driven coding agent pipeline.
+
+Usage:
+  python3 solution.py <solution_path> <tests_dir> [timeout_seconds]
+
+Modes:
+  * stdin/stdout program (default)
+  * Solution class (file defines class Solution); the method is the first public
+    method of Solution, or the "method" key in tests_dir/samples.json.
+
+tests_dir may contain:
+  samples.json  -> {"method": optional, "samples": [{"input": str, "output": str}, ...]}
+  ref2.py       -> reference (or brute.py as fallback), reads stdin, writes stdout
+  gen.py        -> python3 gen.py <seed> <scale>, prints one input; scale "max" gives max-size input
+
+Prints a raw, concise report. Errors are not classified; raw stderr is shown.
+"""
+import json
+import os
+import subprocess
 import sys
+import time
+
+STRESS_SEEDS = 30
+SCALES = [1, 2, 3]
+
+
+def run_program(cmd, stdin_text, timeout):
+    start = time.time()
+    try:
+        proc = subprocess.run(cmd, input=stdin_text, capture_output=True,
+                              text=True, timeout=timeout)
+        return proc.stdout, proc.stderr, proc.returncode, time.time() - start, False
+    except subprocess.TimeoutExpired as exc:
+        out = exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or "")
+        err = exc.stderr.decode() if isinstance(exc.stderr, bytes) else (exc.stderr or "")
+        return out, err, None, time.time() - start, True
+
+
+def same_output(a, b):
+    return a.split() == b.split()
+
+
+def trunc(text, limit=300):
+    text = text if text is not None else ""
+    return text if len(text) <= limit else text[:limit] + "...<truncated>"
+
+
+def make_runner(solution_path, method):
+    """Return callable(stdin_text, timeout) -> (stdout, stderr, rc, elapsed, timed_out)."""
+    if method is None:
+        return lambda inp, t: run_program([sys.executable, solution_path], inp, t)
+
+    harness = (
+        "import sys, json, importlib.util\n"
+        "sys.setrecursionlimit(1000000)\n"
+        "spec = importlib.util.spec_from_file_location('sol', %r)\n"
+        "mod = importlib.util.module_from_spec(spec)\n"
+        "spec.loader.exec_module(mod)\n"
+        "args = json.loads(sys.stdin.read())\n"
+        "res = getattr(mod.Solution(), %r)(*args)\n"
+        "print(json.dumps(res))\n"
+    ) % (os.path.abspath(solution_path), method)
+
+    # For Solution-class tasks, stdin is a JSON list of positional args.
+    return lambda inp, t: run_program([sys.executable, "-c", harness], inp, t)
+
+
+def detect_method(solution_path):
+    with open(solution_path, encoding="utf-8") as f:
+        src = f.read()
+    if "class Solution" not in src:
+        return None
+    in_cls = False
+    for line in src.splitlines():
+        if line.startswith("class Solution"):
+            in_cls = True
+            continue
+        if in_cls and line and not line[0].isspace() and not line.startswith("#"):
+            break
+        s = line.strip()
+        if in_cls and s.startswith("def ") and not s.startswith("def _"):
+            return s[4:].split("(")[0]
+    return None
+
+
+def compare(actual, expected, method):
+    if method is None:
+        return same_output(actual, expected)
+    try:
+        return json.loads(actual.strip()) == json.loads(expected.strip())
+    except Exception:
+        return same_output(actual, expected)
+
+
+def run_samples(runner, samples, timeout, method):
+    passed = 0
+    fails = []
+    for idx, s in enumerate(samples):
+        out, err, rc, _, to = runner(s["input"], timeout)
+        if not to and rc == 0 and compare(out, s["output"], method):
+            passed += 1
+        else:
+            fails.append(
+                f"sample {idx}: input={trunc(s['input'])!r} expected={trunc(s['output'])!r} "
+                f"actual={trunc(out)!r} rc={rc} timeout={to} stderr={trunc(err)!r}"
+            )
+    return passed, len(samples), fails
+
+
+def run_stress(runner, tests_dir, timeout, method):
+    gen = os.path.join(tests_dir, "gen.py")
+    ref = os.path.join(tests_dir, "ref2.py")
+    if not os.path.exists(ref):
+        ref = os.path.join(tests_dir, "brute.py")
+    if not os.path.exists(gen) or not os.path.exists(ref):
+        return None
+    total = 0
+    ok = 0
+    first_fail = None
+    for scale in SCALES:
+        for seed in range(STRESS_SEEDS):
+            total += 1
+            g_out, g_err, g_rc, _, _ = run_program(
+                [sys.executable, gen, str(seed), str(scale)], "", timeout)
+            if g_rc != 0:
+                first_fail = first_fail or (
+                    f"generator failed scale={scale} seed={seed} stderr={trunc(g_err)!r}")
+                continue
+            r_out, r_err, r_rc, _, r_to = run_program([sys.executable, ref], g_out, timeout)
+            if r_rc != 0 or r_to:
+                first_fail = first_fail or (
+                    f"reference failed scale={scale} seed={seed} stderr={trunc(r_err)!r}")
+                continue
+            out, err, rc, _, to = runner(g_out, timeout)
+            if not to and rc == 0 and compare(out, r_out, method):
+                ok += 1
+            elif first_fail is None:
+                first_fail = (f"scale={scale} seed={seed} input={trunc(g_out)!r} "
+                              f"expected={trunc(r_out)!r} actual={trunc(out)!r} "
+                              f"rc={rc} timeout={to} stderr={trunc(err)!r}")
+    return ok, total, first_fail
+
+
+def max_input_timing(runner, tests_dir, timeout):
+    gen = os.path.join(tests_dir, "gen.py")
+    if not os.path.exists(gen):
+        return None
+    out, err, rc, _, _ = run_program([sys.executable, gen, "0", "max"], "", timeout)
+    if rc != 0:
+        return f"generator failed at max scale stderr={trunc(err)!r}"
+    _, err2, rc2, el, to = runner(out, timeout)
+    status = "timeout" if to else "ok"
+    return f"{status} elapsed={el:.3f}s rc={rc2} stderr={trunc(err2)!r}"
+
+
+def report(solution_path, tests_dir, timeout=10.0):
+    method = None
+    samples = []
+    sj = os.path.join(tests_dir, "samples.json")
+    if os.path.exists(sj):
+        with open(sj, encoding="utf-8") as f:
+            data = json.load(f)
+        samples = data.get("samples", [])
+        method = data.get("method")
+    if method is None:
+        method = detect_method(solution_path)
+    runner = make_runner(solution_path, method)
+
+    lines = [f"mode: {'Solution.' + method if method else 'stdin/stdout'}"]
+    p, n, fails = run_samples(runner, samples, timeout, method)
+    lines.append(f"samples: {p}/{n} passed")
+    lines.extend(fails[:3])
+
+    st = run_stress(runner, tests_dir, timeout, method)
+    if st is None:
+        lines.append("stress: skipped (gen.py or reference missing)")
+    else:
+        ok, total, first = st
+        lines.append(f"stress: {ok}/{total} passed")
+        if first:
+            lines.append(f"first stress failure: {first}")
+
+    mt = max_input_timing(runner, tests_dir, timeout)
+    lines.append("max-input: skipped (gen.py missing)" if mt is None else f"max-input: {mt}")
+    return "\n".join(lines)
 
 
