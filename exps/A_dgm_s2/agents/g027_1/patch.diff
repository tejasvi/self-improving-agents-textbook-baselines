diff --git a/tools/sample_check.py b/tools/sample_check.py
new file mode 100644
index 0000000..9bc61da
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,142 @@
+import os
+import re
+import subprocess
+
+_MARKER_RE = re.compile(r'Sample\s+(Input|Output)\s*(\d+)\s*:?', re.IGNORECASE)
+_FENCE_RE = re.compile(r'^\s*```[^\n]*$', re.MULTILINE)
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution command on the sample inputs of a problem statement and compare with the expected sample outputs.\n
+* Parses every 'Sample Input k' / 'Sample Output k' pair from the statement file (code fences or plain text are both accepted).
+* Runs the command once per sample input, feeding it on stdin, with a timeout.
+* Reports, for each sample, one of: EXACT MATCH, TOLERANCE MATCH ONLY (with max abs/rel difference), or MISMATCH (includes timeouts and runtime errors).
+* Always prints the expected and actual output verbatim.
+* A TOLERANCE MATCH ONLY result means the text differs (e.g. in float digits) and the hidden grader will likely reject it; make the output exactly match the expected text.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "statement_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the problem statement text (the sample blocks are parsed from it). If the path does not exist, the value is treated as the statement text itself."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution reading stdin and writing stdout, e.g. 'python3 /work/repo/solution.py'."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Per-sample timeout in seconds."
+                }
+            },
+            "required": ["statement_path", "command", "timeout_seconds"]
+        }
+    }
+
+
+def _clean_block(text):
+    text = _FENCE_RE.sub('', text)
+    return text.strip('\n').strip()
+
+
+def parse_samples(statement):
+    """Return list of (index, input_text, output_text) for paired samples, sorted by index."""
+    inputs, outputs = {}, {}
+    matches = list(_MARKER_RE.finditer(statement))
+    for i, m in enumerate(matches):
+        end = matches[i + 1].start() if i + 1 < len(matches) else len(statement)
+        block = _clean_block(statement[m.end():end])
+        idx = int(m.group(2))
+        if m.group(1).lower() == 'input':
+            inputs.setdefault(idx, block)
+        else:
+            outputs.setdefault(idx, block)
+    return [(k, inputs[k], outputs[k]) for k in sorted(inputs) if k in outputs]
+
+
+def _to_float(tok):
+    try:
+        return float(tok)
+    except ValueError:
+        return None
+
+
+def compare_outputs(expected, actual):
+    """Return (status, detail) where status is EXACT MATCH, TOLERANCE MATCH ONLY or MISMATCH."""
+    exp_toks = expected.split()
+    act_toks = actual.split()
+    if exp_toks == act_toks:
+        return 'EXACT MATCH', ''
+    if len(exp_toks) != len(act_toks):
+        return 'MISMATCH', f'token count differs (expected {len(exp_toks)}, actual {len(act_toks)})'
+    max_abs = 0.0
+    max_rel = 0.0
+    for e, a in zip(exp_toks, act_toks):
+        if e == a:
+            continue
+        ef, af = _to_float(e), _to_float(a)
+        if ef is None or af is None:
+            return 'MISMATCH', 'non-numeric token differs'
+        diff = abs(ef - af)
+        max_abs = max(max_abs, diff)
+        denom = abs(ef)
+        max_rel = max(max_rel, diff / denom if denom > 0 else diff)
+    if max_abs <= 1e-6 or max_rel <= 1e-6:
+        return 'TOLERANCE MATCH ONLY', f'(max abs diff {max_abs:.3g}, max rel diff {max_rel:.3g})'
+    return 'MISMATCH', f'(max abs diff {max_abs:.3g}, max rel diff {max_rel:.3g})'
+
+
+def _load_statement(statement_path):
+    if os.path.isfile(statement_path):
+        with open(statement_path, 'r', encoding='utf-8', errors='replace') as f:
+            return f.read()
+    return statement_path
+
+
+def tool_function(statement_path, command, timeout_seconds):
+    try:
+        timeout = int(timeout_seconds)
+    except (TypeError, ValueError):
+        timeout = 10
+    try:
+        statement = _load_statement(statement_path)
+    except Exception as e:
+        return f"Error reading statement: {e}"
+    samples = parse_samples(statement)
+    if not samples:
+        return "No 'Sample Input k' / 'Sample Output k' pairs found in the statement."
+
+    lines = []
+    statuses = []
+    for k, inp, expected in samples:
+        try:
+            proc = subprocess.run(
+                command, shell=True, input=inp + "\n", capture_output=True,
+                text=True, timeout=timeout
+            )
+            actual = proc.stdout
+            run_note = ''
+            if proc.returncode != 0:
+                run_note = f"\nRuntime error: exit code {proc.returncode}\nstderr:\n{proc.stderr.strip()}"
+        except subprocess.TimeoutExpired:
+            actual = ''
+            run_note = f"\nTIMEOUT after {timeout}s"
+        except Exception as e:
+            actual = ''
+            run_note = f"\nFailed to run command: {e}"
+        status, detail = compare_outputs(expected, actual)
+        if run_note:
+            status = 'MISMATCH'
+        statuses.append(status)
+        lines.append(f"=== Sample {k}: {status} {detail}".rstrip())
+        lines.append("--- input ---\n" + inp)
+        lines.append("--- expected output ---\n" + expected)
+        lines.append("--- actual output ---\n" + actual.rstrip('\n') + run_note)
+        lines.append("")
+
+    summary = (f"Summary: {statuses.count('EXACT MATCH')} exact, "
+               f"{statuses.count('TOLERANCE MATCH ONLY')} tolerance-only, "
+               f"{statuses.count('MISMATCH')} mismatch, out of {len(statuses)} samples.")
+    return "\n".join(lines) + summary
