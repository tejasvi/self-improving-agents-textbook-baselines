+    _CODE_BLOCK_RE = re.compile(r'```(?:python|py)?\n(.*?)```', re.DOTALL)
+
+    def _extract_code_block(self, text):
+        """
+        Return the longest fenced code block in text, or None if there is none.
+        """
+        matches = self._CODE_BLOCK_RE.findall(text or '')
+        if not matches:
+            return None
+        return max(matches, key=len)
+
+    def _pick_target_file(self):
+        """
+        Return the first candidate source file (stub files are prioritized), or None.
+        """
+        candidates = self._find_candidate_source_files()
+        return candidates[0] if candidates else None
+
+    def _text_only_solve(self, prompt):
+        """
+        Ask the model for the solution as plain text (no tools) in a fresh context.
+        Returns the reply text ('' on failure).
+        """
+        reply = chat_text_only(prompt, model=self.code_model, logging=safe_log)
+        msg_history = [
+            {"role": "user", "content": [{"type": "text", "text": prompt}]},
+            {"role": "assistant", "content": [{"type": "text", "text": reply}]},
+        ]
+        return self._last_assistant_text(msg_history)
+
+    def _is_empty_assistant_turn(self, msg_history):
+        """
+        True if the last message is an assistant turn with empty text and no tool_use.
+        """
+        if not msg_history:
+            return False
+        last = msg_history[-1]
+        if last.get('role') != 'assistant':
+            return False
+        content = last.get('content')
+        if any(isinstance(b, dict) and b.get('type') == 'tool_use' for b in content) \
+                if isinstance(content, list) else False:
+            return False
+        return not self._last_assistant_text([last]).strip()
+
