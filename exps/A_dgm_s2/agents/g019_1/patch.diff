+def chat_text_only(prompt, model=CLAUDE_MODEL, logging=print):
+    """
+    Plain completion call with NO tools list. Returns the response text ('' on failure).
+    """
+    try:
+        client, client_model = create_client(model)
+        if 'claude' in client_model:
+            response = client.messages.create(
+                model=client_model,
+                messages=[{"role": "user", "content": [{"type": "text", "text": prompt}]}],
+                max_tokens=8192,
+            )
+            text = ''.join(getattr(b, 'text', '') or '' for b in response.content)
+        else:
+            text, _ = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message='You are a coding assistant. Answer with plain text only.',
+                print_debug=False,
+                msg_history=[],
+            )
+        logging(f"Text-only output: {text}")
+        return text or ''
+    except Exception as e:
+        logging(f"Error in chat_text_only: {str(e)}")
