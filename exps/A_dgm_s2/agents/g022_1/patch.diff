@@ -50,10 +50,65 @@ def tool_info():
 
 
 def _normalize(text):
-    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    lines = [line.rstrip() for line in (text or "").replace("\r\n", "\n").split("\n")]
     return "\n".join(lines).strip()
 
 
+def _compare(actual, expected):
+    """Classify actual vs expected output.
+
+    'EXACT'        - normalized texts are equal.
+    'NUMERIC_ONLY' - same token count, every token pair parses as float and is
+                     within 1e-6 * max(1, |expected|), but the text differs.
+    'FAIL'         - anything else.
+    """
+    a = _normalize(actual)
+    e = _normalize(expected)
+    if a == e:
+        return "EXACT"
+    at = a.split()
+    et = e.split()
+    if len(at) != len(et) or not at:
+        return "FAIL"
+    for x, y in zip(at, et):
+        try:
+            fx = float(x)
+            fy = float(y)
+        except ValueError:
+            return "FAIL"
+        if not abs(fx - fy) <= 1e-6 * max(1.0, abs(fy)):
+            return "FAIL"
+    return "NUMERIC_ONLY"
+
+
+def _numeric_hint(actual, expected):
+    """Build a hint describing how a NUMERIC_ONLY mismatch differs in text."""
+    a = _normalize(actual)
+    e = _normalize(expected)
+    k = 0
+    while k < min(len(a), len(e)) and a[k] == e[k]:
+        k += 1
+    act_tok = a.split()
+    exp_tok = e.split()
+
+    def decimals(tok):
+        return len(tok.split(".", 1)[1]) if "." in tok else 0
+
+    tok_idx = 0
+    while (tok_idx < min(len(act_tok), len(exp_tok))
+           and act_tok[tok_idx] == exp_tok[tok_idx]):
+        tok_idx += 1
+    act_dec = decimals(act_tok[tok_idx]) if tok_idx < len(act_tok) else 0
+    exp_dec = decimals(exp_tok[tok_idx]) if tok_idx < len(exp_tok) else 0
+    return (
+        f"Numerically equal but the text differs (first differing character at index {k}, "
+        f"actual has {act_dec} decimals vs expected {exp_dec}). "
+        "WARNING: a strict hidden checker may reject this output, so do not treat NUMERIC_ONLY as a pass. "
+        "Match the expected format exactly (consider decimal.Decimal/fractions.Fraction with high precision "
+        "and the same number of digits)."
+    )
+
+
 def _run_case(solution_path, case_input, timeout):
     start = time.time()
     try:
