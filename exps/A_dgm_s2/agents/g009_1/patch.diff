diff --git a/tools/sample_runner.py b/tools/sample_runner.py
new file mode 100644
index 0000000..a347253
--- /dev/null
+++ b/tools/sample_runner.py
@@ -0,0 +1,176 @@
+import json
+import os
+import re
+import subprocess
+from concurrent.futures import ThreadPoolExecutor
+
+MAX_FIELD_CHARS = 2000
+MAX_WORKERS = 4
+
+# Matches "Sample Input N" / "Sample Output N" blocks in a problem statement.
+_SAMPLE_RE = re.compile(
+    r'Sample Input\s*(\d+)\s*\n(.*?)\n\s*Sample Output\s*\1\s*\n(.*?)(?=\n\s*Sample Input|\n## |\n\s*Note\b|\Z)',
+    re.DOTALL,
+)
+
+MISMATCH_NOTE = (
+    "MISMATCH: if the problem allows multiple answers, still try to reproduce the sample output exactly. "
+    "The grader may compare output exactly, so fix every mismatch by inferring the canonical construction "
+    "from the expected outputs."
+)
+
+
+def tool_info():
+    return {
+        "name": "sample_runner",
+        "description": """Run a Python solution against the sample tests of a problem and report exact-match results per sample.\n
+* Provide either `problem_statement_path` (a file containing 'Sample Input N' / 'Sample Output N' blocks) or `samples_json_path` (a JSON list of {"input": ..., "output": ...} objects).\n
+* Each sample is fed to `python3 solution_path` on stdin with a timeout. PASS/FAIL uses exact comparison after stripping trailing whitespace per line.\n
+* For failures, the expected and actual outputs are shown. Fix every mismatch, even if the statement says multiple answers are accepted.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run with python3."
+                },
+                "problem_statement_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the problem statement with 'Sample Input N' / 'Sample Output N' blocks."
+                },
+                "samples_json_path": {
+                    "type": "string",
+                    "description": "Path to a JSON file containing a list of objects with 'input' and 'output' string fields."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Per-sample time limit in seconds. Defaults to 10."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _normalize(text):
+    """Strip trailing whitespace per line and drop leading/trailing blank lines."""
+    lines = [line.rstrip() for line in (text or '').replace('\r\n', '\n').split('\n')]
+    while lines and lines[0] == '':
+        lines.pop(0)
+    while lines and lines[-1] == '':
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _truncate(text):
+    if len(text) > MAX_FIELD_CHARS:
+        return text[:MAX_FIELD_CHARS] + "\n... <truncated>"
+    return text
+
+
+def _parse_statement(path):
+    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
+        text = f.read()
+    samples = []
+    for match in _SAMPLE_RE.finditer(text):
+        samples.append((match.group(2).strip('\n') + '\n', match.group(3)))
+    return samples
+
+
+def _load_json(path):
+    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
+        data = json.load(f)
+    if isinstance(data, dict) and isinstance(data.get('samples'), list):
+        data = data['samples']
+    if not isinstance(data, list):
+        raise ValueError("samples JSON must be a list of {input, output} objects")
+    samples = []
+    for item in data:
+        if not isinstance(item, dict):
+            raise ValueError("each sample must be an object with 'input' and 'output'")
+        samples.append((str(item.get('input', '')), str(item.get('output', ''))))
+    return samples
+
+
+def tool_function(solution_path, problem_statement_path=None, samples_json_path=None, timeout_seconds=10):
+    try:
+        if not solution_path or not os.path.isfile(solution_path):
+            return f"Error: solution file not found: {solution_path}"
+        if timeout_seconds is None:
+            timeout_seconds = 10
+        timeout_seconds = int(timeout_seconds)
+
+        if samples_json_path:
+            samples = _load_json(samples_json_path)
+            source = samples_json_path
+        elif problem_statement_path:
+            if not os.path.isfile(problem_statement_path):
+                return f"Error: problem statement file not found: {problem_statement_path}"
+            samples = _parse_statement(problem_statement_path)
+            source = problem_statement_path
+        else:
+            return "Error: provide either problem_statement_path or samples_json_path."
+    except Exception as e:
+        return f"Error reading samples: {e}"
+
+    if not samples:
+        return "No samples found. Check that the statement uses 'Sample Input N' / 'Sample Output N' blocks."
+
+    solution_dir = os.path.dirname(os.path.abspath(solution_path))
+    abs_solution = os.path.abspath(solution_path)
+
+    def _run_one(inp):
+        try:
+            proc = subprocess.run(
+                ['python3', abs_solution],
+                input=inp,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds,
+                cwd=solution_dir,
+            )
+            return ('ok', proc)
+        except subprocess.TimeoutExpired:
+            return ('timeout', None)
+        except Exception as e:
+            return ('error', str(e))
+
+    # Run samples in a small bounded pool; results keep the original sample order.
+    workers = max(1, min(MAX_WORKERS, len(samples)))
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        outcomes = list(pool.map(_run_one, [inp for inp, _ in samples]))
+
+    lines = [f"Ran {len(samples)} sample(s) from {source} against {solution_path}."]
+    all_pass = True
+    for idx, ((inp, expected), (kind, data)) in enumerate(zip(samples, outcomes), start=1):
+        if kind == 'timeout':
+            all_pass = False
+            lines.append(f"Sample {idx}: FAIL (TIMEOUT after {timeout_seconds}s)")
+            lines.append(f"Input:\n{_truncate(inp)}")
+            continue
+        if kind == 'error':
+            all_pass = False
+            lines.append(f"Sample {idx}: FAIL (could not run: {data})")
+            continue
+
+        proc = data
+        actual = proc.stdout
+        if proc.returncode != 0:
+            all_pass = False
+            lines.append(f"Sample {idx}: FAIL (exit code {proc.returncode})")
+            lines.append(f"Input:\n{_truncate(inp)}")
+            lines.append(f"Stderr:\n{_truncate(proc.stderr or '')}")
+            continue
+
+        if _normalize(actual) == _normalize(expected):
+            lines.append(f"Sample {idx}: PASS")
+        else:
+            all_pass = False
+            lines.append(f"Sample {idx}: FAIL (output differs from expected)")
+            lines.append(f"Input:\n{_truncate(inp)}")
+            lines.append(f"Expected:\n{_truncate(_normalize(expected))}")
+            lines.append(f"Actual:\n{_truncate(_normalize(actual))}")
+
+    lines.append("ALL SAMPLES PASSED (exact match)." if all_pass else "SOME SAMPLES FAILED.")
+    lines.append(MISMATCH_NOTE)
+    return "\n".join(lines)
