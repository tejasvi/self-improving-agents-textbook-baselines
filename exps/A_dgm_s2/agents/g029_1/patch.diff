+def _last_assistant_is_empty(msg_history):
+    """
+    True if the history has no usable final assistant turn: either the history is empty,
+    or the last message is an assistant turn that _sanitize_history would drop
+    (whitespace-only text and no tool_use block). Logs the raw last message when True.
+    """
+    empty = _history_ends_empty(msg_history)
+    if not empty and isinstance(msg_history, list) and msg_history:
+        last = msg_history[-1]
+        if isinstance(last, dict) and last.get('role') == 'assistant':
+            kept = _sanitize_history(msg_history)
+            empty = not kept or kept[-1] is not last
+    if empty:
+        if isinstance(msg_history, list) and msg_history:
+            safe_log(f"[empty-reply] last assistant turn is empty; raw last message: {msg_history[-1]!r}",
+                     logging.WARNING)
+        else:
+            safe_log("[empty-reply] message history is empty", logging.WARNING)
+    return empty
+
+def _normalize_statement(problem_statement):
+    """
+    Compact a problem statement: split into paragraphs on blank lines, drop exact duplicate
+    paragraphs and repeated headers (keeping first occurrence and order), and collapse runs of
+    spaces/tabs inside lines (leading indentation is kept so code samples stay readable).
+    """
+    text = (problem_statement or '').replace('\r\n', '\n').replace('\r', '\n')
+    paragraphs = re.split(r'\n[ \t]*\n+', text)
+    seen = set()
+    out = []
+    for para in paragraphs:
+        lines = []
+        for line in para.split('\n'):
+            stripped = line.rstrip()
+            indent = stripped[:len(stripped) - len(stripped.lstrip())]
+            body = re.sub(r'[ \t]+', ' ', stripped.lstrip())
+            if body:
+                lines.append(indent + body)
+        if not lines:
+            continue
+        block = '\n'.join(lines)
+        key = ' '.join(block.split())
+        if key in seen:
+            continue
+        # A header is a single markdown heading line or a short line ending with ':' or a
+        # line that is entirely upper-case; repeated headers are dropped, their bodies kept.
+        first = lines[0].strip()
+        is_header = len(lines) == 1 and (
+            first.startswith('#') or (first.endswith(':') and len(first) <= 60) or
+            (first.isupper() and len(first) <= 60)
+        )
+        if is_header:
+            hkey = 'H:' + first.lower()
+            if hkey in seen:
+                continue
+            seen.add(hkey)
+        seen.add(key)
+        out.append(block)
+    return '\n\n'.join(out) + '\n'
+
