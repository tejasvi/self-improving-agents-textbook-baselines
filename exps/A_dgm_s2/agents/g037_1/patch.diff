+    def _direct_codegen_fallback(self):
+        """
+        Tool-free fallback: ask the LLM directly for the complete program, extract
+        the last fenced python block, check it compiles and write it to
+        git_tempdir/solution.py. Returns True if a file was written.
+        """
+        target = os.path.join(self.git_tempdir, 'solution.py')
+        base_prompt = (
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            "Think briefly about the algorithm, then output the complete Python 3 program in a single "
+            "```python code block. Read stdin, write stdout, standard library only."
+        )
+        simple_prompt = (
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            "Output only the code block, nothing else. Complete Python 3 program, reads stdin, "
+            "writes stdout, standard library only."
+        )
+        code_pattern = re.compile(r"```(?:python)?\n(.*?)```", re.DOTALL)
+
+        for attempt in range(3):
+            prompt = base_prompt if attempt == 0 else simple_prompt
+            if attempt >= 2:
+                prompt = simple_prompt + "\nOutput only the code block, nothing else."
+            try:
+                reply = chat_no_tools(prompt, model=self.code_model, logging=safe_log)
+            except Exception as e:
+                safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: LLM call raised: {e}")
+                continue
+            reply = reply or ""
+            safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: raw reply length={len(reply)}")
+            matches = code_pattern.findall(reply)
+            if not matches:
+                safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: no fenced code block found")
+                continue
+            code = matches[-1].strip("\n")
+            if not code.strip():
+                safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: code block is empty")
+                continue
+            try:
+                compile(code, 'solution.py', 'exec')
+            except (SyntaxError, ValueError) as e:
+                safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: code does not compile: {e}")
+                continue
+            try:
+                with open(target, 'w', encoding='utf-8') as f:
+                    f.write(code + "\n")
+            except OSError as e:
+                safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: failed to write {target}: {e}")
+                continue
+            safe_log(f"[_direct_codegen_fallback] attempt {attempt + 1}: wrote {target} ({len(code)} chars)")
+            return True
+
+        return False
+
