+def chat_no_tools(msg, model=CLAUDE_MODEL, system_message='You are a helpful assistant.', logging=print):
+    """
+    Plain single-turn completion without any tools. Returns the reply text
+    (empty string on failure).
+    """
+    try:
+        client, client_model = create_client(model)
+        if 'claude' in client_model:
+            response = client.messages.create(
+                model=client_model,
+                max_tokens=8192,
+                system=system_message,
+                messages=[{"role": "user", "content": msg}],
+            )
+            parts = []
+            for block in response.content:
+                if getattr(block, 'type', None) == 'text':
+                    parts.append(block.text)
+            return "".join(parts)
+        elif client_model.startswith('o3-'):
+            response = client.responses.create(
+                model=client_model,
+                input=[{"role": "user", "content": msg}],
+            )
+            return response.output_text or ""
+        else:
+            text, _ = get_response_from_llm(
+                msg=msg,
+                client=client,
+                model=client_model,
+                system_message=system_message,
+                print_debug=False,
+                msg_history=[],
+            )
+            return text or ""
+    except Exception as e:
+        logging(f"Error in chat_no_tools: {str(e)}")
+        return ""
