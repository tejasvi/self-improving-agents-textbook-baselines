+    def _run_verification(self, path=None):
+        """
+        Run the verification script with a timeout.
+        Returns (passed, combined_output). The raw output is passed through unparsed.
+        """
+        script = path or self.VERIFY_SCRIPT
+        try:
+            result = subprocess.run(
+                ['python', script],
+                capture_output=True,
+                text=True,
+                timeout=self.VERIFY_TIMEOUT,
+            )
+            output = (result.stdout or '') + (result.stderr or '')
+            passed = result.returncode == 0 and 'ALL TESTS PASSED' in (result.stdout or '')
+        except subprocess.TimeoutExpired as e:
+            out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b'').decode(errors='replace')
+            err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b'').decode(errors='replace')
+            output = f"Verification timed out after {self.VERIFY_TIMEOUT}s.\n" + out + err
+            passed = False
+        except Exception as e:
+            output = f"Failed to run verification: {e}"
+            passed = False
+        return passed, output[:self.VERIFY_OUTPUT_LIMIT]
+
+    def _last_assistant_is_empty(self, msg_history):
+        """
+        Returns True if the last assistant message has no text and no tool-use blocks.
+        Handles both string content and list-of-block content.
+        """
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return not content.strip()
+            if isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict):
+                        if block.get('type') == 'tool_use' or block.get('type') == 'function_call':
+                            return False
+                        if block.get('type') == 'text' and (block.get('text') or '').strip():
+                            return False
+                    else:
+                        btype = getattr(block, 'type', None)
+                        if btype == 'tool_use' or (btype == 'text' and (getattr(block, 'text', '') or '').strip()):
+                            return False
+                return True
+            return not content
+        return False
+
