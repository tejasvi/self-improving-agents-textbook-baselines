diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..b307cc0
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,165 @@
+import collections
+import os
+import shlex
+import subprocess
+import tempfile
+import time
+
+MAX_SHOW = 2000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Stress test a solution program against a random input generator, an optional output checker, and an optional reference solution.\n
+* generator_path: a Python script that takes one integer argument (the seed) and prints one test input to stdout.\n
+* checker_path: optional Python script called as `python3 checker.py INPUT_FILE OUTPUT_FILE`; exit code 0 means the output is valid, nonzero means invalid (its stdout/stderr is reported as the message). Use this for problems where any valid answer is accepted.\n
+* reference_path: optional program (run as `python3 reference.py`) whose stdout must exactly match the solution's stdout (after stripping trailing whitespace). Use this for problems with a unique answer.\n
+* Runs seeds 1..num_tests, stops at the first failure, and returns the failing input (truncated), the solution output, and the checker/reference message.\n
+* On success returns a summary: number of tests, number of distinct first output lines with their counts (to verify that all output branches are exercised), and the maximum runtime of the solution.\n
+* Use a small num_tests with a generator producing small inputs for brute-force comparison, and a generator producing maximum-size inputs (e.g. via a size parameter inside the generator) to check runtime and validity.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python program (run as `python3 solution_path`, reads stdin)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator script; it is run as `python3 generator_path SEED` and must print one test input to stdout."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional path to a checker script, run as `python3 checker_path INPUT_FILE OUTPUT_FILE`; nonzero exit code means invalid output."
+                },
+                "reference_path": {
+                    "type": "string",
+                    "description": "Optional path to a reference solution; its stdout must match the solution's stdout exactly (after stripping trailing whitespace)."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 1..num_tests). Defaults to 100."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for each program run. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "generator_path"]
+        }
+    }
+
+
+def _truncate(text, limit=MAX_SHOW):
+    if len(text) <= limit:
+        return text
+    return text[:limit] + f"\n... (truncated, {len(text) - limit} more chars)"
+
+
+def _run(cmd_args, stdin_text, timeout):
+    start = time.time()
+    proc = subprocess.run(
+        cmd_args, input=stdin_text, capture_output=True, text=True, timeout=timeout,
+    )
+    return proc, time.time() - start
+
+
+def _norm(text):
+    lines = [line.rstrip() for line in text.replace('\r\n', '\n').split('\n')]
+    while lines and lines[-1] == '':
+        lines.pop()
+    return lines
+
+
+def tool_function(solution_path, generator_path, checker_path=None, reference_path=None,
+                  num_tests=100, timeout=10):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 100
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return "Error: num_tests must be an integer and timeout a number."
+    if num_tests <= 0:
+        return "Error: num_tests must be positive."
+    for label, path in (("solution_path", solution_path), ("generator_path", generator_path),
+                        ("checker_path", checker_path), ("reference_path", reference_path)):
+        if path is not None and not os.path.isfile(path):
+            return f"Error: {label} '{path}' does not exist."
+
+    first_line_counts = collections.Counter()
+    max_runtime = 0.0
+    with tempfile.TemporaryDirectory() as tmpdir:
+        in_path = os.path.join(tmpdir, 'input.txt')
+        out_path = os.path.join(tmpdir, 'output.txt')
+        for seed in range(1, num_tests + 1):
+            try:
+                gen = subprocess.run(
+                    ['python3', generator_path, str(seed)],
+                    capture_output=True, text=True, timeout=timeout,
+                )
+            except subprocess.TimeoutExpired:
+                return f"Generator timed out on seed {seed}."
+            if gen.returncode != 0:
+                return f"Generator failed on seed {seed} (exit {gen.returncode}): {gen.stderr.strip()[-1000:]}"
+            test_input = gen.stdout
+            with open(in_path, 'w', encoding='utf-8') as f:
+                f.write(test_input)
+
+            try:
+                sol, elapsed = _run(['python3', solution_path], test_input, timeout)
+            except subprocess.TimeoutExpired:
+                return (f"FAILED at seed {seed}: solution timed out after {timeout} seconds.\n"
+                        f"Input:\n{_truncate(test_input)}")
+            max_runtime = max(max_runtime, elapsed)
+            if sol.returncode != 0:
+                return (f"FAILED at seed {seed}: solution exited with code {sol.returncode}.\n"
+                        f"stderr:\n{_truncate(sol.stderr[-1500:])}\nInput:\n{_truncate(test_input)}")
+
+            sol_out = sol.stdout
+            with open(out_path, 'w', encoding='utf-8') as f:
+                f.write(sol_out)
+
+            if checker_path:
+                try:
+                    chk = subprocess.run(
+                        ['python3', checker_path, in_path, out_path],
+                        capture_output=True, text=True, timeout=timeout,
+                    )
+                except subprocess.TimeoutExpired:
+                    return f"Checker timed out at seed {seed}.\nInput:\n{_truncate(test_input)}"
+                if chk.returncode != 0:
+                    msg = (chk.stdout + chk.stderr).strip()
+                    return (f"FAILED at seed {seed}: checker rejected the output (exit {chk.returncode}).\n"
+                            f"Checker message:\n{_truncate(msg, 1000)}\n"
+                            f"Input:\n{_truncate(test_input)}\n"
+                            f"Solution output:\n{_truncate(sol_out)}")
+
+            if reference_path:
+                try:
+                    ref, _ = _run(['python3', reference_path], test_input, timeout)
+                except subprocess.TimeoutExpired:
+                    return f"Reference timed out at seed {seed}.\nInput:\n{_truncate(test_input)}"
+                if ref.returncode != 0:
+                    return (f"Reference failed at seed {seed} (exit {ref.returncode}): "
+                            f"{ref.stderr.strip()[-1000:]}")
+                if _norm(ref.stdout) != _norm(sol_out):
+                    return (f"FAILED at seed {seed}: output differs from reference.\n"
+                            f"Input:\n{_truncate(test_input)}\n"
+                            f"Solution output:\n{_truncate(sol_out)}\n"
+                            f"Reference output:\n{_truncate(ref.stdout)}")
+
+            lines = _norm(sol_out)
+            first = lines[0] if lines else '(empty output)'
+            first_line_counts[first] += 1
+
+    distinct = len(first_line_counts)
+    dist_str = ', '.join(f"{k!r}: {v}" for k, v in first_line_counts.most_common(20))
+    checks = []
+    if checker_path:
+        checks.append("checker")
+    if reference_path:
+        checks.append("reference")
+    check_str = ' + '.join(checks) if checks else 'no checker/reference (only crash/timeout checks)'
+    return (f"PASSED {num_tests} tests ({check_str}).\n"
+            f"{distinct} distinct first-line outputs: {{{dist_str}}}\n"
+            f"Max solution runtime: {max_runtime:.3f} seconds.")
