diff --git a/tools/run_standalone.py b/tools/run_standalone.py
new file mode 100644
index 0000000..31c3106
--- /dev/null
+++ b/tools/run_standalone.py
@@ -0,0 +1,147 @@
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def tool_info():
+    return {
+        "name": "run_standalone",
+        "description": """Run a Python solution file in isolation, the way a judge would.
+
+* The solution is copied to a fresh temporary directory as `_sol.py`.
+* It is executed with `python3 -I` (isolated mode) in a fresh temporary working directory, once per entry in `test_inputs`, with that entry written to stdin.
+* For each test it reports the exit code, stdout, raw stderr, and elapsed time. If `expected_outputs` is given, stdout is compared (whitespace-trimmed) against the matching expected output and a PASS/FAIL line is shown.
+* The report also includes the output of `sys.version`.
+* Errors are reported raw; they are not parsed or classified. Treat any stderr output or non-zero exit code as a bug to fix.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run."
+                },
+                "test_inputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "List of stdin contents, one run per entry."
+                },
+                "expected_outputs": {
+                    "type": "array",
+                    "items": {"type": "string"},
+                    "description": "Optional list of expected stdout contents, aligned index-by-index with test_inputs."
+                },
+                "timeout_seconds": {
+                    "type": "integer",
+                    "description": "Per-test timeout in seconds. Defaults to 10."
+                }
+            },
+            "required": ["solution_path", "test_inputs"]
+        }
+    }
+
+
+def _run_one(sol_dir, stdin_text, timeout):
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            ["python3", "-I", os.path.join(sol_dir, "_sol.py")],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            cwd=sol_dir,
+            timeout=timeout,
+        )
+        return {
+            "returncode": proc.returncode,
+            "stdout": proc.stdout,
+            "stderr": proc.stderr,
+            "elapsed": time.time() - start,
+            "timed_out": False,
+        }
+    except subprocess.TimeoutExpired as e:
+        def _as_text(x):
+            if x is None:
+                return ""
+            if isinstance(x, bytes):
+                return x.decode("utf-8", errors="replace")
+            return x
+        return {
+            "returncode": None,
+            "stdout": _as_text(e.stdout),
+            "stderr": _as_text(e.stderr),
+            "elapsed": time.time() - start,
+            "timed_out": True,
+        }
+    except Exception as e:
+        return {
+            "returncode": None,
+            "stdout": "",
+            "stderr": f"{type(e).__name__}: {e}",
+            "elapsed": time.time() - start,
+            "timed_out": False,
+        }
+
+
+def tool_function(solution_path, test_inputs, expected_outputs=None, timeout_seconds=10):
+    try:
+        timeout = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if test_inputs is None:
+        test_inputs = []
+    if isinstance(test_inputs, str):
+        test_inputs = [test_inputs]
+
+    try:
+        ver = subprocess.run(
+            ["python3", "-I", "-c", "import sys; print(sys.version)"],
+            capture_output=True, text=True, timeout=30,
+        )
+        version_text = (ver.stdout + ver.stderr).strip()
+    except Exception as e:
+        version_text = f"<could not determine: {type(e).__name__}: {e}>"
+
+    lines = [f"Python version (sys.version): {version_text}", ""]
+    failures = 0
+    sol_tmp = tempfile.mkdtemp(prefix="run_standalone_sol_")
+    try:
+        shutil.copyfile(solution_path, os.path.join(sol_tmp, "_sol.py"))
+        for i, stdin_text in enumerate(test_inputs):
+            run_dir = tempfile.mkdtemp(prefix="run_standalone_cwd_")
+            try:
+                shutil.copyfile(os.path.join(sol_tmp, "_sol.py"), os.path.join(run_dir, "_sol.py"))
+                res = _run_one(run_dir, stdin_text, timeout)
+            finally:
+                shutil.rmtree(run_dir, ignore_errors=True)
+
+            lines.append(f"=== Test {i + 1} ===")
+            lines.append(f"stdin: {stdin_text!r}")
+            if res["timed_out"]:
+                lines.append(f"TIMEOUT after {timeout}s")
+            lines.append(f"exit code: {res['returncode']}")
+            lines.append(f"elapsed: {res['elapsed']:.3f}s")
+            lines.append(f"stdout:\n{res['stdout']}")
+            lines.append(f"stderr:\n{res['stderr']}")
+            status_ok = (res["returncode"] == 0) and not res["timed_out"]
+            if expected_outputs is not None and i < len(expected_outputs):
+                expected = expected_outputs[i]
+                match = res["stdout"].strip() == str(expected).strip()
+                lines.append(f"expected: {expected!r}")
+                lines.append("comparison: PASS" if match else "comparison: FAIL")
+                status_ok = status_ok and match
+            elif expected_outputs is not None:
+                lines.append("comparison: no expected output given for this test")
+            if not status_ok:
+                failures += 1
+            lines.append("")
+    finally:
+        shutil.rmtree(sol_tmp, ignore_errors=True)
+
+    lines.append(f"Summary: {len(test_inputs) - failures}/{len(test_inputs)} tests ok")
+    return "\n".join(lines)
