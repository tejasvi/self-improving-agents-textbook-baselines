+    def _fallback_write_solution(self, filename='solution.py'):
+        """
+        Last resort: ask the model (without tools) for the full solution code and write it
+        to <git_tempdir>/<filename>. Returns True if a file was written.
+        """
+        prompt = (
+            "Write a complete Python 3 solution for the following competitive programming problem. "
+            "Use only the standard library. Read from standard input and write to standard output "
+            "(or implement the required method if the problem asks for a class).\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            "Reply with ONLY the complete contents of the solution file inside a single ```python fenced code block. "
+            "No other text."
+        )
+        try:
+            client, client_model = create_client(self.code_model)
+            result = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message="You are an expert competitive programmer.",
+                print_debug=False,
+                msg_history=[],
+            )
+        except Exception as e:
+            safe_log(f"[fallback] Model call failed: {e}", logging.ERROR)
+            return False
+
+        response = result[0] if isinstance(result, tuple) and result else result
+        if not isinstance(response, str):
+            safe_log(f"[fallback] Unexpected response type: {type(response).__name__}", logging.ERROR)
+            return False
+
+        match = re.search(r'```(?:python)?\n(.*?)```', response, re.DOTALL)
+        if not match:
+            safe_log("[fallback] No ```python code block found in model response", logging.WARNING)
+            return False
+
+        code = match.group(1)
+        target = os.path.join(self.git_tempdir, filename)
+        try:
+            with open(target, 'w') as f:
+                f.write(code)
+        except OSError as e:
+            safe_log(f"[fallback] Failed to write {target}: {e}", logging.ERROR)
+            return False
+        safe_log(f"[fallback] Wrote {len(code)} chars to {target}", logging.WARNING)
+        return True
+
