+def get_plain_completion(msg, model=CLAUDE_MODEL, logging=print):
+    """
+    Single-turn, tool-free LLM request. Returns the response text ('' on failure).
+    """
+    try:
+        client, client_model = create_client(model)
+        if 'claude' in client_model:
+            response = client.messages.create(
+                model=client_model,
+                messages=[{"role": "user", "content": [{"type": "text", "text": msg}]}],
+                max_tokens=8192,
+            )
+            texts = [getattr(b, 'text', '') or '' for b in response.content]
+            return "\n".join(t for t in texts if t)
+        # Other models: reuse the generic (non-tool) chat path
+        response, _ = get_response_from_llm(
+            msg=msg,
+            client=client,
+            model=client_model,
+            system_message="You are a helpful coding assistant.",
+            print_debug=False,
+            msg_history=[],
+        )
+        return response or ''
+    except Exception as e:
+        logging(f"[get_plain_completion] error: {e}")
+        return ''
