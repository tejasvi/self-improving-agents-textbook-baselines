+    def _sanitize_history(self, history):
+        """
+        Drop messages whose content is empty or made only of whitespace text blocks,
+        and drop a trailing assistant message that has no content. Returns a new list.
+        """
+        if not isinstance(history, list):
+            return []
+
+        def has_content(msg):
+            content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+            if content is None:
+                return False
+            if isinstance(content, str):
+                return content.strip() != ''
+            if isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict):
+                        btype = block.get('type')
+                        text = block.get('text')
+                    else:
+                        btype = getattr(block, 'type', None)
+                        text = getattr(block, 'text', None)
+                    if btype == 'text':
+                        if text is not None and str(text).strip() != '':
+                            return True
+                    else:
+                        # tool_use / tool_result / function_call etc. count as content
+                        return True
+                return False
+            return True
+
+        cleaned = [m for m in history if has_content(m)]
+        while cleaned:
+            last = cleaned[-1]
+            role = last.get('role') if isinstance(last, dict) else getattr(last, 'role', None)
+            if role == 'assistant' and not has_content(last):
+                cleaned.pop()
+            else:
+                break
+        return cleaned
+
