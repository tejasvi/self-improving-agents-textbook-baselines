+    def _changed_files(self):
+        """
+        Return the list of paths changed in git_tempdir relative to its state
+        (tracked modifications plus untracked files), via `git status --porcelain`.
+        """
+        cmd = ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"]
+        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        paths = []
+        for line in result.stdout.decode('utf-8', errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            if ' -> ' in path:  # rename: keep the new path
+                path = path.split(' -> ', 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                paths.append(path)
+        return paths
+
+    @staticmethod
+    def _is_test_path(p):
+        """
+        True if the path looks like a test file: contains 'test' or 'spec' in a
+        directory or file name (e.g. tests/, test_x.py, x_test.py, spec/).
+        """
+        lowered = str(p).lower().replace('\\', '/')
+        if 'tests/' in lowered or 'spec' in lowered or 'test' in lowered:
+            return True
+        return False
+
+    def _is_standalone_program_task(self):
+        """
+        Standalone-program setting: Python language, not self-improvement, and the
+        base commit has no tracked non-test Python source files (i.e. the agent is
+        expected to create the deliverable from scratch).
+        """
+        if self.language != 'python' or self.self_improve:
+            return False
+        cmd = ["git", "-C", self.git_tempdir, "ls-tree", "-r", "--name-only", self.base_commit]
+        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        if result.returncode != 0:
+            return False
+        for name in result.stdout.decode('utf-8', errors='replace').splitlines():
+            if name.endswith('.py') and not self._is_test_path(name):
+                return False
+        return True
+
+    def _patch_is_acceptable(self):
+        """
+        Returns (ok, reason). The patch is not acceptable if there are no changed
+        files, if all changed files are test files, or (for standalone-program
+        tasks) if the deliverable is missing or empty.
+        """
+        changed = self._changed_files()
+        # Ignore the agent's own chat log if it happens to live inside the repo
+        log_abs = os.path.abspath(self.chat_history_file) if self.chat_history_file else None
+        changed = [p for p in changed if not (log_abs and os.path.abspath(os.path.join(self.git_tempdir, p)) == log_abs)]
+        if not changed:
+            return False, "No file edits were detected in the repository."
+        non_test = [p for p in changed if not self._is_test_path(p)]
+        if not non_test:
+            return False, "Only test files were modified (" + ", ".join(changed) + "). Edit the primary source code."
+        if self._is_standalone_program_task():
+            for name in self.DELIVERABLE_NAMES:
+                path = os.path.join(self.git_tempdir, name)
+                if not os.path.exists(path) or os.path.getsize(path) == 0:
+                    return False, f"The deliverable `{name}` is missing or empty. You must now use the editor tool to create `{name}` with a complete solution."
+        return True, "ok"
+
