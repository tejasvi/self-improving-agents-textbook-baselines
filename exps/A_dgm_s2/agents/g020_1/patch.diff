+#!/usr/bin/env python3
+"""stress_test tool: differential testing with multi-scale generation and optional checker.
+
+Usage as a program: reads a JSON object of arguments from stdin, prints the result string.
+Usage as a module: tool_info() and tool_function(...) as required by the tools/ convention.
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+
+DEFAULT_SCALES = [1, 2, 3, 5, 8]
+MAX_INPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": (
+            "Differential stress testing. For each seed in range(num_tests) and each scale "
+            "(cycled from the scales list), runs `python3 generator_path seed scale` to build an input, "
+            "runs the solution and the brute-force program on it, and compares normalized stdout "
+            "(or runs an optional checker on the input and both outputs). Stops at the first failure and "
+            "returns the seed, scale, input, both outputs and raw stderr. Otherwise returns a pass count, "
+            "the max solution time and the number of distinct inputs and outputs."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file under test."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the trusted brute-force Python program."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a generator; invoked as `python3 generator_path seed scale` and prints one input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of seeds to run (seeds 0..num_tests-1). Default 200."
+                },
+                "scales": {
+                    "type": "array",
+                    "items": {"type": "integer"},
+                    "description": "Scale parameters cycled across tests. Default [1, 2, 3, 5, 8]."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Optional checker invoked as `python3 checker_path input_file sol_out_file brute_out_file`. Exit code 0 means OK; stdout is used as the message."
+                },
+                "timeout": {
+                    "type": "number",
+                    "description": "Per-run timeout in seconds for each program. Default 10."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _run(args, stdin_text=None, timeout=10):
+    """Run a command; return (returncode, stdout, stderr, elapsed, timed_out)."""
+    start = time.time()
+    try:
+        proc = subprocess.run(
+            args,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, time.time() - start, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return None, out, err + f"\n[timed out after {timeout}s]", time.time() - start, True
+    except Exception as e:  # raw error text is returned to the agent
+        return None, "", f"[exception while running {args}: {e!r}]", time.time() - start, False
+
+
+def _normalize(text):
+    lines = [line.rstrip() for line in text.strip().splitlines()]
+    return "\n".join(lines)
+
+
+def _truncate(text):
+    if len(text) <= MAX_INPUT_CHARS:
+        return text
+    return text[:MAX_INPUT_CHARS] + f"\n...[truncated, total {len(text)} chars]"
+
+
+def tool_function(solution_path, brute_path, generator_path, num_tests=200, scales=None,
+                  checker_path=None, timeout=10):
+    try:
+        num_tests = int(num_tests) if num_tests is not None else 200
+    except (TypeError, ValueError):
+        return f"Invalid num_tests: {num_tests!r}"
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        return f"Invalid timeout: {timeout!r}"
+    if not scales:
+        scales = list(DEFAULT_SCALES)
+    scales = [int(s) for s in scales]
+    if num_tests <= 0:
+        return "num_tests must be positive."
+
+    py = sys.executable or "python3"
+    passes = 0
+    max_sol_time = 0.0
+    distinct_inputs = set()
+    distinct_outputs = set()
+
+    tmpdir = tempfile.mkdtemp(prefix="stress_")
+    in_path = os.path.join(tmpdir, "input.txt")
+    sol_out_path = os.path.join(tmpdir, "sol_out.txt")
+    brute_out_path = os.path.join(tmpdir, "brute_out.txt")
+
+    for seed in range(num_tests):  # bounded loop
+        scale = scales[seed % len(scales)]
+
+        rc, gen_out, gen_err, _, gen_to = _run([py, generator_path, str(seed), str(scale)], timeout=timeout)
+        if rc != 0 or gen_to:
+            return (f"FAILED at seed={seed} scale={scale}: generator error "
+                    f"(returncode={rc}, timed_out={gen_to}).\n"
+                    f"stdout:\n{gen_out}\nstderr:\n{gen_err}")
+        test_input = gen_out
+        distinct_inputs.add(test_input)
+        with open(in_path, "w") as f:
+            f.write(test_input)
+
+        s_rc, s_out, s_err, s_time, s_to = _run([py, solution_path], stdin_text=test_input, timeout=timeout)
+        b_rc, b_out, b_err, _, b_to = _run([py, brute_path], stdin_text=test_input, timeout=timeout)
+        max_sol_time = max(max_sol_time, s_time)
+
+        def fail(reason):
+            return (f"FAILED at seed={seed} scale={scale}: {reason}\n"
+                    f"input:\n{_truncate(test_input)}\n"
+                    f"solution output (returncode={s_rc}):\n{s_out}\n"
+                    f"brute output (returncode={b_rc}):\n{b_out}\n"
+                    f"solution stderr (raw):\n{s_err}\n"
+                    f"brute stderr (raw):\n{b_err}")
+
+        if s_to or s_rc != 0:
+            return fail("solution crashed or timed out")
+        if b_to or b_rc != 0:
+            return fail("brute crashed or timed out")
+
+        distinct_outputs.add(_normalize(s_out))
+
+        if checker_path:
+            with open(sol_out_path, "w") as f:
+                f.write(s_out)
+            with open(brute_out_path, "w") as f:
+                f.write(b_out)
+            c_rc, c_out, c_err, _, c_to = _run(
+                [py, checker_path, in_path, sol_out_path, brute_out_path], timeout=timeout)
+            if c_to or c_rc != 0:
+                return fail(f"checker rejected (returncode={c_rc}): {c_out}\nchecker stderr (raw):\n{c_err}")
+        elif _normalize(s_out) != _normalize(b_out):
+            return fail("outputs differ")
+
+        passes += 1
+
+    return (f"ALL PASSED: {passes}/{num_tests} tests. "
+            f"Max solution time: {max_sol_time:.3f}s. "
+            f"Distinct inputs: {len(distinct_inputs)}. "
+            f"Distinct outputs: {len(distinct_outputs)}.")
+
+
+def main():
+    raw = sys.stdin.read()
+    try:
+        args = json.loads(raw) if raw.strip() else {}
+    except json.JSONDecodeError as e:
+        print(f"Invalid JSON arguments: {e}")
+        return
+    try:
+        print(tool_function(**args))
+    except TypeError as e:
+        print(f"Invalid arguments: {e}")
+
+
+if __name__ == "__main__":
+    main()
