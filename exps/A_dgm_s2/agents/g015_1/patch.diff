+    # Markers that suggest a file is a stub / unfinished implementation
+    _STUB_RE = re.compile(r'^\s*pass\s*$|NotImplementedError|TODO', re.MULTILINE)
+    # Non-code files that should never be chosen as edit targets
+    _NON_CODE_NAMES = {'readme', 'license', 'licence', 'changelog', 'contributing', 'copying', 'notice', 'authors'}
+    _NON_CODE_EXTS = {'.md', '.rst', '.txt', '.lock', '.toml', '.cfg', '.ini', '.yaml', '.yml', '.json', '.csv', '.svg', '.png', '.jpg', '.gif', '.pdf'}
+    _LOCKFILE_NAMES = {'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml', 'poetry.lock', 'cargo.lock', 'go.sum', 'gemfile.lock', 'composer.lock'}
+
+    def _find_candidate_files(self, max_candidates=3, max_chars=4000):
+        """
+        Discover likely edit targets in the repo (non-test, non-doc source files),
+        ranked by: basename mentioned in the problem statement, stub markers, small size.
+        Returns a list of (relative_path, truncated_content).
+        """
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            tracked = result.stdout.decode(errors='replace').splitlines()
+        except Exception:
+            return []
+
+        problem = self.problem_statement or ''
+        scored = []
+        for rel in tracked:
+            if not rel or self._is_test_file(rel):
+                continue
+            basename = os.path.basename(rel)
+            lower = basename.lower()
+            stem, ext = os.path.splitext(lower)
+            if lower in self._LOCKFILE_NAMES or stem in self._NON_CODE_NAMES or ext in self._NON_CODE_EXTS:
+                continue
+            full = os.path.join(self.git_tempdir, rel)
+            if not os.path.isfile(full):
+                continue
+            try:
+                with open(full, 'r', encoding='utf-8') as f:
+                    content = f.read()
+            except (OSError, UnicodeDecodeError):
+                continue
+            size = len(content)
+            mentioned = bool(basename) and basename in problem
+            has_stub = bool(self._STUB_RE.search(content))
+            # Higher is better; size is a tie-breaker favouring small files
+            score = (int(mentioned) * 4) + (int(has_stub) * 2) - (size / 100000.0)
+            scored.append((score, rel, content))
+
+        scored.sort(key=lambda x: x[0], reverse=True)
+        top = scored[:max_candidates]
+        return [(rel, content[:max_chars] + ('\n<truncated>' if len(content) > max_chars else '')) for _, rel, content in top]
+
+    def _format_candidates(self, candidates):
+        if not candidates:
+            return "(no candidate source files were identified automatically; locate the right file yourself)"
+        blocks = []
+        for rel, content in candidates:
+            blocks.append(f"### {rel}\n```\n{content}\n```")
+        return "\n\n".join(blocks)
+
+    def _last_assistant_text(self, msg_history):
+        """Extract the text of the last assistant message from a message history (best effort)."""
+        for msg in reversed(msg_history or []):
+            if msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                return content
+            parts = []
+            for block in content or []:
+                if isinstance(block, dict):
+                    text = block.get('text')
+                else:
+                    text = getattr(block, 'text', None)
+                if text:
+                    parts.append(text)
+            return "\n".join(parts)
+        return ''
+
