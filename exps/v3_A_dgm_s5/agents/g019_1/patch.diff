+    @staticmethod
+    def _extract_code_block(text):
+        """
+        Return the longest ```python (or plain ```) fenced code block in text,
+        or None if there is none. Only code is extracted; no error parsing.
+        """
+        if not isinstance(text, str) or not text:
+            return None
+        blocks = []
+        pattern_lines = text.split('\n')
+        in_block = False
+        current = []
+        for line in pattern_lines:
+            stripped = line.strip()
+            if not in_block:
+                if stripped.startswith('```'):
+                    in_block = True
+                    current = []
+            else:
+                if stripped.startswith('```'):
+                    in_block = False
+                    blocks.append('\n'.join(current))
+                else:
+                    current.append(line)
+        blocks = [b for b in blocks if b.strip()]
+        if not blocks:
+            return None
+        return max(blocks, key=len)
+
+    def _final_assistant_text(self, history):
+        """Return the concatenated text of the last assistant message ('' if none)."""
+        if not isinstance(history, list):
+            return ''
+        for msg in reversed(history):
+            if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                content = msg.get('content')
+                if isinstance(content, str):
+                    return content
+                if isinstance(content, list):
+                    parts = []
+                    for block in content:
+                        if self._block_type(block) == 'text':
+                            text = self._block_text(block)
+                            if isinstance(text, str):
+                                parts.append(text)
+                    return '\n'.join(parts)
+                return ''
+        return ''
+
