+_SEARCH_SKIP_DIRS = {'.git', 'node_modules', '__pycache__', '.venv', 'venv', 'build', 'target'}
+_MAX_SEARCH_FILES = 20000
+_MAX_CANDIDATES_SHOWN = 10
+
+def _git_toplevel(start: Path):
+    """Return the git repo root containing `start` (or None)."""
+    try:
+        result = subprocess.run(
+            ['git', '-C', str(start), 'rev-parse', '--show-toplevel'],
+            capture_output=True, text=True, timeout=10,
+        )
+        top = result.stdout.strip()
+        if result.returncode == 0 and top:
+            return Path(top)
+    except Exception:
+        pass
+    return None
+
+def _find_basename_candidates(basename: str):
+    """
+    Search for files named `basename` under the git root (or cwd, if not in a git repo).
+    Bounded walk: skips VCS/build dirs and stops after _MAX_SEARCH_FILES files.
+    """
+    cwd = Path.cwd()
+    roots = []
+    top = _git_toplevel(cwd)
+    if top is not None:
+        roots.append(top)
+    if cwd not in roots:
+        roots.append(cwd)
+
+    found = []
+    seen = set()
+    for root in roots:
+        scanned = 0
+        for dirpath, dirnames, filenames in os.walk(root):
+            dirnames[:] = [d for d in dirnames if d not in _SEARCH_SKIP_DIRS and not d.startswith('.')]
+            for name in filenames:
+                scanned += 1
+                if name == basename:
+                    candidate = Path(dirpath) / name
+                    key = str(candidate.resolve())
+                    if key not in seen:
+                        seen.add(key)
+                        found.append(candidate)
+                if scanned >= _MAX_SEARCH_FILES:
+                    break
+            if scanned >= _MAX_SEARCH_FILES:
+                break
+        if found:
+            break  # prefer matches in the first (most specific) root
+    return found
+
+def _resolve_missing_path(path_obj: Path, path: str):
+    """
+    Called when `path_obj` does not exist. If exactly one file with the same basename
+    exists under the git root / cwd, return it. Otherwise raise ValueError listing candidates.
+    """
+    basename = path_obj.name
+    candidates = _find_basename_candidates(basename) if basename else []
+    if len(candidates) == 1:
+        return candidates[0]
+    if candidates:
+        shown = "\n".join(f"  - {c}" for c in candidates[:_MAX_CANDIDATES_SHOWN])
+        more = f"\n  ... and {len(candidates) - _MAX_CANDIDATES_SHOWN} more" if len(candidates) > _MAX_CANDIDATES_SHOWN else ""
+        raise ValueError(
+            f"The file {path} does not exist. Multiple files named '{basename}' were found; "
+            f"retry with the correct absolute path:\n{shown}{more}"
+        )
+    raise ValueError(f"The file {path} does not exist.")
+
