+    def _has_source_edit(self):
+        """
+        Return True if the repo has at least one modified or new file that is
+        not a test or scratch file, relative to base_commit.
+        """
+        import fnmatch
+        cmds = [
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+        ]
+        files = []
+        for cmd in cmds:
+            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            files.extend(result.stdout.decode(errors='replace').splitlines())
+
+        scratch_patterns = ['brute*', 'stress*', 'check*', 'tmp*']
+        for path in files:
+            path = path.strip()
+            if not path:
+                continue
+            lowered = path.lower()
+            name = os.path.basename(lowered)
+            if 'test' in lowered or lowered.startswith('tests/'):
+                continue
+            if any(fnmatch.fnmatch(name, pat) for pat in scratch_patterns):
+                continue
+            return True
+        return False
+
