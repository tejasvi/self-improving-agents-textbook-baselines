+    def _sanitize_history(self, history):
+        """
+        Return a copy of the message list without assistant messages that have
+        no non-empty text and no tool_use blocks. Content may be a str or a
+        list of blocks (dicts or objects).
+        """
+        if not isinstance(history, list):
+            return []
+        clean = []
+        for msg in history:
+            if not isinstance(msg, dict):
+                clean.append(msg)
+                continue
+            if msg.get('role') != 'assistant':
+                clean.append(msg)
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                if content.strip():
+                    clean.append(msg)
+                continue
+            if not isinstance(content, list):
+                continue
+            has_text = False
+            has_tool = False
+            for block in content:
+                btype = self._block_type(block)
+                if btype == 'tool_use':
+                    has_tool = True
+                elif btype == 'text':
+                    text = self._block_text(block)
+                    if isinstance(text, str) and text.strip():
+                        has_text = True
+            if has_text or has_tool:
+                clean.append(msg)
+        return clean
+
+    def _last_assistant_empty(self, history):
+        """Return True if the last assistant message has no non-empty text and no tool_use."""
+        if not isinstance(history, list):
+            return True
+        for msg in reversed(history):
+            if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                content = msg.get('content')
+                if isinstance(content, str):
+                    return not content.strip()
+                if isinstance(content, list):
+                    for block in content:
+                        if self._block_type(block) == 'tool_use':
+                            return False
+                        text = self._block_text(block)
+                        if isinstance(text, str) and text.strip():
+                            return False
+                return True
+        return True
+
+    def _target_file_edited(self):
+        """
+        Return True if solution.py exists in git_tempdir, differs from base_commit
+        (modified or untracked), and has more than ~20 non-whitespace characters.
+        Falls back to _has_source_edit() if solution.py is not applicable.
+        """
+        target = os.path.join(self.git_tempdir, 'solution.py')
+        if not os.path.exists(target):
+            return self._has_source_edit()
+        changed = subprocess.run(
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).stdout.decode(errors='replace').splitlines()
+        untracked = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        ).stdout.decode(errors='replace').splitlines()
+        if 'solution.py' not in [f.strip() for f in changed + untracked]:
+            return False
+        try:
+            with open(target, 'r', errors='replace') as f:
+                content = f.read()
+        except OSError:
+            return False
+        return len(''.join(content.split())) > 20
+
