+"""Utility helpers for the coding agent.
+
+These helpers are dependency-free and never raise on unusual input; they return
+empty results instead, so callers can fall through to the next recovery rung.
+"""
+
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import traceback
+from typing import List, Optional, Tuple
+
+_FENCE_RE = re.compile(r"```[ \t]*(?:python3?|py)?[ \t]*\n(.*?)```", re.DOTALL | re.IGNORECASE)
+_RAW_CODE_MARKERS = ("def ", "input(", "sys.stdin", "print(", "class Solution")
+
+
+def extract_code_from_text(text: Optional[str]) -> str:
+    """Extract Python code from an LLM reply.
+
+    Preference order: ```python fences, plain ``` fences, then raw code if the
+    text contains recognizable Python markers. Returns "" when nothing usable is found.
+    """
+    if not text or not isinstance(text, str):
+        return ""
+
+    matches = _FENCE_RE.findall(text)
+    if matches:
+        # Prefer the longest fenced block; it is most likely the full solution.
+        best = max(matches, key=len).strip()
+        if best:
+            return best + "\n"
+
+    stripped = text.strip()
+    if stripped and any(marker in stripped for marker in _RAW_CODE_MARKERS):
+        return stripped + "\n"
+    return ""
+
+
+def validate_python_code(code: str, filename: str = "solution.py") -> Tuple[bool, str]:
+    """Check that code compiles. Returns (ok, error_message)."""
+    if not code or not code.strip():
+        return False, "empty code"
+    try:
+        compile(code, filename, "exec")
+        return True, ""
+    except SyntaxError as e:
+        return False, f"SyntaxError: {e}"
+    except Exception:
+        return False, traceback.format_exc()
+
+
+def parse_sample_tests(problem_statement: Optional[str]) -> List[Tuple[str, str]]:
+    """Parse 'Sample Input N' / 'Sample Output N' blocks from a problem statement.
+
+    Returns a list of (input, expected_output) pairs. Returns [] if none are found.
+    """
+    if not problem_statement:
+        return []
+
+    pattern = re.compile(
+        r"Sample Input\s*(\d*)\s*:?\s*\n(.*?)\n\s*Sample Output\s*\1\s*:?\s*\n(.*?)(?=\n\s*Sample Input|\Z)",
+        re.DOTALL | re.IGNORECASE,
+    )
+    samples = []
+    for _, inp, out in pattern.findall(problem_statement):
+        inp = inp.strip()
+        out = out.strip()
+        if inp:
+            samples.append((inp + "\n", out))
+    return samples
+
+
+def run_samples(
+    code: str,
+    samples: List[Tuple[str, str]],
+    timeout: float = 10.0,
+) -> List[dict]:
+    """Run code (a standalone program reading stdin) against samples.
+
+    Returns a list of result dicts with keys: index, passed, expected, actual, error.
+    Never raises.
+    """
+    results: List[dict] = []
+    if not code or not samples:
+        return results
+
+    tmp_path = None
+    try:
+        fd, tmp_path = tempfile.mkstemp(suffix=".py")
+        with os.fdopen(fd, "w") as f:
+            f.write(code)
+    except Exception:
+        return [{"index": -1, "passed": False, "expected": "", "actual": "",
+                 "error": traceback.format_exc()}]
+
+    try:
+        for i, (inp, expected) in enumerate(samples):
+            try:
+                proc = subprocess.run(
+                    [sys.executable, tmp_path],
+                    input=inp,
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                actual = proc.stdout.strip()
+                err = proc.stderr.strip()
+                passed = proc.returncode == 0 and actual.split() == expected.split()
+                results.append({"index": i, "passed": passed, "expected": expected,
+                                "actual": actual, "error": err})
+            except subprocess.TimeoutExpired:
+                results.append({"index": i, "passed": False, "expected": expected,
+                                "actual": "", "error": "timeout"})
+            except Exception:
+                results.append({"index": i, "passed": False, "expected": expected,
+                                "actual": "", "error": traceback.format_exc()})
+    finally:
+        try:
+            os.remove(tmp_path)
+        except Exception:
+            pass
+    return results
