diff --git a/tools/time_solution.py b/tools/time_solution.py
new file mode 100644
index 0000000..98b4877
--- /dev/null
+++ b/tools/time_solution.py
@@ -0,0 +1,169 @@
+import json
+import os
+import subprocess
+import sys
+import time
+
+
+_GEN_HARNESS = r'''
+import importlib.util, json, sys
+spec = importlib.util.spec_from_file_location("input_generator", sys.argv[1])
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+result = mod.generate()
+sys.stdout.write("\n__GENERATED__" + json.dumps(result) + "\n")
+'''
+
+_METHOD_HARNESS = r'''
+import importlib.util, json, sys, traceback
+from typing import *
+from collections import *
+import math, heapq, bisect, itertools, functools, re, string
+
+_payload = json.loads(sys.stdin.read())
+_path = _payload["solution_path"]
+_cls_name = _payload["class_name"]
+_method_name = _payload["method_name"]
+_args = _payload["args"]
+
+try:
+    with open(_path, "r", encoding="utf-8") as f:
+        _src = f.read()
+    _ns = {"__name__": "solution_module", "__file__": _path}
+    exec(compile(_src, _path, "exec"), _ns)
+    _cls = _ns[_cls_name]
+    if _method_name is None:
+        _names = [n for n in vars(_cls) if not n.startswith("_") and callable(getattr(_cls, n))]
+        _method_name = _names[0]
+    _obj = _cls()
+    if isinstance(_args, dict):
+        _res = getattr(_obj, _method_name)(**_args)
+    else:
+        _res = getattr(_obj, _method_name)(*_args)
+    sys.stdout.write("\n__RESULT__" + json.dumps(repr(_res)[:200]) + "\n")
+except Exception:
+    sys.stderr.write(traceback.format_exc())
+    sys.exit(1)
+'''
+
+
+def tool_info():
+    return {
+        "name": "time_solution",
+        "description": """Measure the wall-clock running time of a solution on a large generated input.\n
+* Takes a generator file (input_generator_path) that defines `generate()`. In mode 'stdin', generate() returns the stdin string for the solution script. In mode 'method', generate() returns a list of positional args (or a dict of keyword args) for the method of the class.\n
+* The generator runs in its own subprocess; only the solution run is timed.\n
+* Runs the solution in a subprocess with the given timeout (seconds).\n
+* Returns 'OK elapsed=X.XXs' on success, 'TIMEOUT after Xs' if the limit is exceeded, or the error output / traceback if the run fails.\n
+* Use it with a max-size worst-case generator to check performance against the constraints.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file."
+                },
+                "mode": {
+                    "type": "string",
+                    "enum": ["stdin", "method"],
+                    "description": "'stdin' to run the file as a script fed via stdin; 'method' to call a method of a class in the file."
+                },
+                "class_name": {
+                    "type": "string",
+                    "description": "Class name for mode 'method' (default 'Solution')."
+                },
+                "method_name": {
+                    "type": "string",
+                    "description": "Method name for mode 'method'. If omitted, the first public method of the class is used."
+                },
+                "input_generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python file defining generate() that returns the stdin string (stdin mode) or the list/dict of method args (method mode)."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the solution run. Defaults to 5."
+                }
+            },
+            "required": ["solution_path", "mode", "input_generator_path"]
+        }
+    }
+
+
+def _run_generator(input_generator_path, cwd):
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-c", _GEN_HARNESS, input_generator_path],
+            capture_output=True, text=True, timeout=60, cwd=cwd,
+        )
+    except subprocess.TimeoutExpired:
+        return None, "Error: input generator timed out after 60s."
+    if proc.returncode != 0:
+        return None, "Error: input generator failed:\n" + proc.stderr[-4000:]
+    marker = "\n__GENERATED__"
+    idx = proc.stdout.rfind(marker)
+    if idx < 0:
+        return None, "Error: input generator produced no output marker."
+    try:
+        return json.loads(proc.stdout[idx + len(marker):].strip()), None
+    except Exception as e:
+        return None, f"Error: could not parse generator output: {e}"
+
+
+def tool_function(solution_path, mode='stdin', class_name=None, method_name=None,
+                  input_generator_path=None, timeout=5):
+    if timeout is None:
+        timeout = 5
+    try:
+        timeout = int(timeout)
+    except Exception:
+        timeout = 5
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+    if not input_generator_path or not os.path.isfile(input_generator_path):
+        return f"Error: input generator file not found: {input_generator_path}"
+    if mode not in ('stdin', 'method'):
+        return "Error: mode must be 'stdin' or 'method'."
+
+    cwd = os.path.dirname(os.path.abspath(solution_path))
+    generated, err = _run_generator(input_generator_path, cwd)
+    if err:
+        return err
+
+    if mode == 'stdin':
+        if not isinstance(generated, str):
+            return "Error: in stdin mode generate() must return a string."
+        cmd = [sys.executable, os.path.abspath(solution_path)]
+        stdin_data = generated
+    else:
+        if isinstance(generated, dict):
+            args = generated
+        elif isinstance(generated, list):
+            args = generated
+        else:
+            return "Error: in method mode generate() must return a list of args or a dict of kwargs."
+        payload = {
+            "solution_path": os.path.abspath(solution_path),
+            "class_name": class_name or 'Solution',
+            "method_name": method_name,
+            "args": args,
+        }
+        cmd = [sys.executable, "-c", _METHOD_HARNESS]
+        stdin_data = json.dumps(payload)
+
+    start = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            cmd, input=stdin_data, capture_output=True, text=True,
+            timeout=timeout, cwd=cwd,
+        )
+    except subprocess.TimeoutExpired:
+        return f"TIMEOUT after {timeout}s"
+    elapsed = time.perf_counter() - start
+
+    if proc.returncode != 0 or 'Traceback' in proc.stderr:
+        return (
+            f"FAILED returncode={proc.returncode} elapsed={elapsed:.2f}s\n"
+            f"stderr:\n{proc.stderr[-4000:]}"
+        )
+    return f"OK elapsed={elapsed:.2f}s"
