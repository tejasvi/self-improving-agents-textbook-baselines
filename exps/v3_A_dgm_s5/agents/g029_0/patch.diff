diff --git a/tools/stress_test.py b/tools/stress_test.py
new file mode 100644
index 0000000..bdff7bf
--- /dev/null
+++ b/tools/stress_test.py
@@ -0,0 +1,178 @@
+import os
+import subprocess
+import tempfile
+
+MAX_OUTPUT_CHARS = 2000
+MAX_ITERATIONS = 10000
+
+
+def tool_info():
+    return {
+        "name": "stress_test",
+        "description": """Randomized stress test comparing a solution against a brute-force reference.
+
+* Each Python file is run as a stdin/stdout program (python3 <file>).
+* generator_path is run as `python3 generator_path <seed>` and must print one test input to stdout.
+* For each seed in 1..iterations, the solution and the brute force are run on that input.
+* mode 'exact': outputs are compared after whitespace normalization (tokens must match in order).
+* mode 'checker': checker_path is run as `python3 checker_path <file>` where <file> contains the
+  test input, a line '=====OUTPUT=====', and the solution output; the test input is also given on stdin.
+  Exit code 0 means the solution passed.
+* Stops at the first mismatch and returns the seed, input, expected output, actual output and stderr.
+* Returns a pass summary if all iterations match.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file (reads stdin, writes stdout)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the brute-force reference Python file (reads stdin, writes stdout)."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Path to a Python generator; run as `python3 generator_path <seed>`, prints one test input to stdout."
+                },
+                "iterations": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 1..iterations). Default 200."
+                },
+                "mode": {
+                    "type": "string",
+                    "description": "Comparison mode: 'exact' (default) or 'checker'."
+                },
+                "checker_path": {
+                    "type": "string",
+                    "description": "Path to a checker Python file, required when mode is 'checker'. Exit code 0 means pass."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each program run. Default 10."
+                }
+            },
+            "required": ["solution_path", "brute_path", "generator_path"]
+        }
+    }
+
+
+def _truncate(text):
+    if text is None:
+        return ""
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + f"\n... [truncated, {len(text) - MAX_OUTPUT_CHARS} more chars]"
+    return text
+
+
+def _run(path, input_text, timeout):
+    """Run a python3 script with input_text on stdin. Returns (returncode, stdout, stderr) or raises."""
+    result = subprocess.run(
+        ['python3', path],
+        input=input_text,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+    return result.returncode, result.stdout, result.stderr
+
+
+def _normalize(text):
+    return text.split()
+
+
+def tool_function(solution_path, brute_path, generator_path, iterations=200, mode='exact',
+                  checker_path=None, timeout=10):
+    try:
+        iterations = int(iterations) if iterations is not None else 200
+    except (TypeError, ValueError):
+        iterations = 200
+    iterations = max(1, min(iterations, MAX_ITERATIONS))
+    try:
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    timeout = max(1, timeout)
+    mode = (mode or 'exact').strip().lower()
+    if mode not in ('exact', 'checker'):
+        return f"Error: invalid mode {mode!r}; use 'exact' or 'checker'."
+    if mode == 'checker' and not checker_path:
+        return "Error: mode 'checker' requires checker_path."
+
+    for path_name, path in (('solution_path', solution_path), ('brute_path', brute_path),
+                            ('generator_path', generator_path)):
+        if not path or not os.path.isfile(path):
+            return f"Error: {path_name} does not exist: {path}"
+    if mode == 'checker' and not os.path.isfile(checker_path):
+        return f"Error: checker_path does not exist: {checker_path}"
+
+    # Bounded loop over seeds (no while True).
+    for seed in range(1, iterations + 1):
+        try:
+            gen = subprocess.run(
+                ['python3', generator_path, str(seed)],
+                capture_output=True, text=True, timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            return f"Error: generator timed out for seed {seed}."
+        if gen.returncode != 0:
+            return (f"Error: generator failed for seed {seed} (exit {gen.returncode}).\n"
+                    f"stderr:\n{_truncate(gen.stderr)}")
+        test_input = gen.stdout
+
+        try:
+            brute_rc, expected, brute_err = _run(brute_path, test_input, timeout)
+        except subprocess.TimeoutExpired:
+            return (f"Error: brute force timed out on seed {seed}. Input:\n{_truncate(test_input)}")
+        if brute_rc != 0:
+            return (f"Error: brute force crashed on seed {seed} (exit {brute_rc}). Input:\n"
+                    f"{_truncate(test_input)}\nstderr:\n{_truncate(brute_err)}")
+
+        try:
+            sol_rc, actual, sol_err = _run(solution_path, test_input, timeout)
+        except subprocess.TimeoutExpired:
+            return (f"MISMATCH at seed {seed}: solution timed out (>{timeout}s).\n"
+                    f"Input:\n{_truncate(test_input)}\nExpected:\n{_truncate(expected)}")
+
+        if sol_rc != 0:
+            return (f"MISMATCH at seed {seed}: solution exited with code {sol_rc}.\n"
+                    f"Input:\n{_truncate(test_input)}\nExpected:\n{_truncate(expected)}\n"
+                    f"Actual:\n{_truncate(actual)}\nstderr:\n{_truncate(sol_err)}")
+
+        if mode == 'exact':
+            ok = _normalize(expected) == _normalize(actual)
+        else:
+            ok = False
+            fd, tmp_path = tempfile.mkstemp(suffix='.txt', prefix='stress_check_')
+            try:
+                with os.fdopen(fd, 'w') as f:
+                    f.write(test_input)
+                    f.write("\n=====OUTPUT=====\n")
+                    f.write(actual)
+                chk = subprocess.run(
+                    ['python3', checker_path, tmp_path],
+                    input=test_input, capture_output=True, text=True, timeout=timeout,
+                )
+                ok = chk.returncode == 0
+                checker_msg = chk.stdout + chk.stderr
+            except subprocess.TimeoutExpired:
+                ok = False
+                checker_msg = "checker timed out"
+            finally:
+                try:
+                    os.remove(tmp_path)
+                except OSError:
+                    pass
+            if not ok:
+                return (f"MISMATCH at seed {seed}: checker rejected the solution output.\n"
+                        f"Input:\n{_truncate(test_input)}\nExpected (brute):\n{_truncate(expected)}\n"
+                        f"Actual:\n{_truncate(actual)}\nChecker output:\n{_truncate(checker_msg)}\n"
+                        f"stderr:\n{_truncate(sol_err)}")
+            continue
+
+        if not ok:
+            return (f"MISMATCH at seed {seed}.\n"
+                    f"Input:\n{_truncate(test_input)}\nExpected:\n{_truncate(expected)}\n"
+                    f"Actual:\n{_truncate(actual)}\nstderr:\n{_truncate(sol_err)}")
+
+    return f"All {iterations} tests passed (mode={mode})."
diff --git a/tools/time_run.py b/tools/time_run.py
new file mode 100644
index 0000000..2d3361b
--- /dev/null
+++ b/tools/time_run.py
@@ -0,0 +1,108 @@
+import os
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 1000
+
+
+def tool_info():
+    return {
+        "name": "time_run",
+        "description": """Run a Python stdin/stdout solution on an input file and report wall time and exit status.
+
+* Use it with a max-size input to check that the solution meets the time limit.
+* Optionally pass generator_path (run as `python3 generator_path <seed>`) to create the input instead of input_path.
+* Output shows wall time in seconds, exit code, and the first part of stderr if any.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file (reads stdin, writes stdout)."
+                },
+                "input_path": {
+                    "type": "string",
+                    "description": "Path to a file containing the input to feed to the solution on stdin."
+                },
+                "generator_path": {
+                    "type": "string",
+                    "description": "Optional path to a generator; run as `python3 generator_path <seed>` to produce the input. Used when input_path is not given."
+                },
+                "seed": {
+                    "type": "integer",
+                    "description": "Seed passed to the generator. Default 1."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for the solution run. Default 10."
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _truncate(text):
+    if not text:
+        return ""
+    if len(text) > MAX_OUTPUT_CHARS:
+        return text[:MAX_OUTPUT_CHARS] + "\n... [truncated]"
+    return text
+
+
+def tool_function(solution_path, input_path=None, generator_path=None, seed=1, timeout=10):
+    try:
+        seed = int(seed) if seed is not None else 1
+    except (TypeError, ValueError):
+        seed = 1
+    try:
+        timeout = int(timeout) if timeout is not None else 10
+    except (TypeError, ValueError):
+        timeout = 10
+    timeout = max(1, timeout)
+
+    if not solution_path or not os.path.isfile(solution_path):
+        return f"Error: solution_path does not exist: {solution_path}"
+
+    if input_path:
+        if not os.path.isfile(input_path):
+            return f"Error: input_path does not exist: {input_path}"
+        with open(input_path, 'r', encoding='utf-8', errors='replace') as f:
+            test_input = f.read()
+        input_desc = f"input file {input_path}"
+    elif generator_path:
+        if not os.path.isfile(generator_path):
+            return f"Error: generator_path does not exist: {generator_path}"
+        try:
+            gen = subprocess.run(
+                ['python3', generator_path, str(seed)],
+                capture_output=True, text=True, timeout=timeout,
+            )
+        except subprocess.TimeoutExpired:
+            return f"Error: generator timed out (seed {seed})."
+        if gen.returncode != 0:
+            return f"Error: generator failed (exit {gen.returncode}).\nstderr:\n{_truncate(gen.stderr)}"
+        test_input = gen.stdout
+        input_desc = f"generator {generator_path} seed {seed}"
+    else:
+        return "Error: provide either input_path or generator_path."
+
+    start = time.perf_counter()
+    try:
+        result = subprocess.run(
+            ['python3', solution_path],
+            input=test_input, capture_output=True, text=True, timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        elapsed = time.perf_counter() - start
+        return (f"TIMEOUT: solution exceeded {timeout}s on {input_desc} "
+                f"(elapsed {elapsed:.2f}s). Input size: {len(test_input)} chars.")
+    elapsed = time.perf_counter() - start
+
+    return (
+        f"Input: {input_desc} ({len(test_input)} chars)\n"
+        f"Wall time: {elapsed:.3f}s\n"
+        f"Exit code: {result.returncode}\n"
+        f"Output size: {len(result.stdout)} chars\n"
+        f"stderr:\n{_truncate(result.stderr)}"
+    )
