+def _is_empty_content(content):
+    """
+    Return True if a message content has no usable text and no tool calls.
+    """
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return not content.strip()
+    if isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict):
+                if block.get('type') == 'text':
+                    if str(block.get('text', '')).strip():
+                        return False
+                else:
+                    # tool_use, tool_result, images, etc. count as real content
+                    return False
+            elif block is not None:
+                return False
+        return True
+    return False
+
+def _sanitize_history(msg_history):
+    """
+    Drop trailing assistant messages that have empty/whitespace-only content
+    (no tool calls). If nothing usable remains, or the history does not end with
+    a user message, return a fresh empty history.
+    """
+    if not isinstance(msg_history, list):
+        return []
+    history = list(msg_history)
+    while history and history[-1].get('role') == 'assistant' and _is_empty_content(history[-1].get('content')):
+        history.pop()
+    if not history:
+        return []
+    if history[-1].get('role') != 'user':
+        return []
+    return history
