+    def _find_primary_source_file(self):
+        """
+        Return the repo-relative path of the primary (non-test, non-doc) source file, or None.
+        Prefers solution.py, then main.py, then the smallest candidate (likely a stub).
+        """
+        try:
+            result = subprocess.run(
+                ["git", "-C", self.git_tempdir, "ls-files"],
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+            )
+            files = result.stdout.decode().splitlines()
+        except Exception as e:
+            safe_log(f"_find_primary_source_file failed: {e}", level=logging.WARNING)
+            return None
+
+        candidates = []
+        for path in files:
+            normalized = path.replace('\\', '/')
+            basename = normalized.split('/')[-1]
+            lower = basename.lower()
+            if _is_test_path(normalized):
+                continue
+            if lower.startswith('readme') or lower.endswith(DOC_SUFFIXES):
+                continue
+            if 'docs' in normalized.split('/')[:-1] or 'doc' in normalized.split('/')[:-1]:
+                continue
+            full = os.path.join(self.git_tempdir, path)
+            if not os.path.isfile(full):
+                continue
+            candidates.append((normalized, basename, os.path.getsize(full)))
+
+        if not candidates:
+            return None
+        for preferred in ('solution.py', 'main.py'):
+            for normalized, basename, _ in candidates:
+                if basename == preferred:
+                    return normalized
+        candidates.sort(key=lambda c: (c[2], c[0]))
+        return candidates[0][0]
+
