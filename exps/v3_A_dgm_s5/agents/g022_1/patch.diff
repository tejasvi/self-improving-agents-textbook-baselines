+    SAMPLE_PAIR_RE = re.compile(
+        r'Sample Input\s*(\d*)\s*:?[ \t]*\n(.*?)\n\s*Sample Output\s*\d*\s*:?[ \t]*\n(.*?)'
+        r'(?=\n[ \t]*\n|\n\s*(?:Sample Input|Explanation|Note|Constraints|Example|Input|Output)\b|\Z)',
+        re.DOTALL | re.IGNORECASE,
+    )
+
+    @staticmethod
+    def _strip_fences(text):
+        lines = [ln for ln in text.splitlines() if not ln.strip().startswith('```')]
+        return '\n'.join(lines).strip('\n')
+
+    def _parse_samples(self):
+        """
+        Extract every 'Sample Input N' / 'Sample Output N' pair from the problem statement.
+        Returns a list of (input_text, expected_text) tuples (input ends with a newline).
+        """
+        statement = self.problem_statement or ''
+        samples = []
+        for m in self.SAMPLE_PAIR_RE.finditer(statement):
+            inp = self._strip_fences(m.group(2))
+            out = self._strip_fences(m.group(3))
+            if not out.strip():
+                continue
+            samples.append((inp + '\n' if inp.strip() else '', out))
+        return samples
+
+    @staticmethod
+    def _normalize_output(text):
+        lines = [ln.rstrip() for ln in (text or '').splitlines()]
+        while lines and not lines[-1]:
+            lines.pop()
+        return lines
+
+    SAMPLE_GATE_TIMEOUT = 10
+
+    def _run_sample_gate(self):
+        """
+        Run the target solution on every parsed sample and compare stdout exactly
+        (per-line rstrip, trailing blank lines ignored).
+        Returns (ok, report). Class-based tasks and tasks without samples are skipped (ok=True).
+        """
+        target_path, target_content = self._find_target_file()
+        if target_path is None:
+            return True, "No target file found; sample gate skipped."
+        if target_content and 'class Solution' in target_content:
+            return True, "Class-based task; sample gate skipped."
+        samples = self._parse_samples()
+        if not samples:
+            return True, "No samples parsed; sample gate skipped."
+
+        mismatches = []
+        for idx, (sample_in, expected) in enumerate(samples, 1):
+            try:
+                proc = subprocess.run(
+                    [sys.executable, target_path],
+                    input=sample_in,
+                    capture_output=True,
+                    text=True,
+                    timeout=self.SAMPLE_GATE_TIMEOUT,
+                    cwd=self.git_tempdir,
+                )
+                actual_text = proc.stdout
+                stderr = proc.stderr
+                problem = None if proc.returncode == 0 else f"exit code {proc.returncode}"
+            except subprocess.TimeoutExpired as e:
+                actual_text = e.stdout.decode('utf-8', 'replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+                stderr = e.stderr.decode('utf-8', 'replace') if isinstance(e.stderr, bytes) else (e.stderr or '')
+                problem = f"timed out after {self.SAMPLE_GATE_TIMEOUT}s"
+
+            if problem is None and self._normalize_output(actual_text) == self._normalize_output(expected):
+                continue
+            mismatches.append(
+                f"--- Sample {idx} ---\n"
+                f"Input:\n{sample_in}"
+                f"Expected output:\n{expected.rstrip()}\n"
+                f"Actual output:\n{actual_text.rstrip()}\n"
+                + (f"Problem: {problem}\n" if problem else "")
+                + (f"stderr:\n{stderr.rstrip()}\n" if stderr.strip() else "")
+            )
+
+        if not mismatches:
+            return True, f"All {len(samples)} sample(s) match exactly."
+        report = (
+            f"{len(mismatches)} of {len(samples)} sample(s) do not match exactly.\n\n"
+            + "\n".join(mismatches)
+        )
+        return False, report
+
