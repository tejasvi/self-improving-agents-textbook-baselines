+    def _changed_files(self, diff):
+        """
+        Parse `diff --git a/X b/Y` header lines and return the list of changed paths (Y, falling back to X).
+        """
+        files = []
+        for line in str(diff).splitlines():
+            if not line.startswith('diff --git '):
+                continue
+            rest = line[len('diff --git '):]
+            path = None
+            if ' b/' in rest:
+                path = rest.rsplit(' b/', 1)[1]
+            elif rest.startswith('a/') and ' ' in rest:
+                path = rest.split(' ', 1)[0][2:]
+            if path:
+                files.append(path.strip())
+        return files
+
+    def _is_test_file(self, path):
+        """
+        Return True if `path` looks like a test file.
+        """
+        normalized = path.replace('\\', '/')
+        base = os.path.basename(normalized)
+        if base.startswith('test_') or base.endswith('_test.py'):
+            return True
+        if '.spec.' in base or '.test.' in base:
+            return True
+        padded = '/' + normalized
+        return '/tests/' in padded or '/test/' in padded
+
+    def _has_source_edit(self):
+        """
+        Return True if the working tree differs from base_commit in at least one non-test file.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        changed = self._changed_files(diff)
+        return any(not self._is_test_file(path) for path in changed)
+
+    def _has_assistant_content(self, msg_history):
+        """
+        Return True if the message history contains a non-empty assistant reply.
+        """
+        if not msg_history:
+            return False
+        for msg in msg_history:
+            if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                if content.strip():
+                    return True
+            elif isinstance(content, list):
+                for block in content:
+                    if isinstance(block, dict):
+                        if block.get('type') == 'tool_use':
+                            return True
+                        if str(block.get('text', '') or '').strip():
+                            return True
+        return False
+
