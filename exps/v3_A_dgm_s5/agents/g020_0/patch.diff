+def _changed_files(diff_str):
+    """
+    Parse `diff --git a/X b/Y` header lines and return the list of file paths changed in the diff.
+    """
+    files = []
+    if not diff_str:
+        return files
+    for line in diff_str.splitlines():
+        if not line.startswith('diff --git '):
+            continue
+        rest = line[len('diff --git '):]
+        path = None
+        if rest.startswith('a/') and ' b/' in rest:
+            # Use the b/ side (new path); split on the last ' b/' occurrence
+            path = rest[rest.rfind(' b/') + 3:]
+        else:
+            parts = rest.split()
+            if len(parts) >= 2:
+                path = parts[-1]
+                if path.startswith('b/'):
+                    path = path[2:]
+        if path and path not in files:
+            files.append(path)
+    return files
+
+def _is_test_path(path):
+    """
+    Return True if the path looks like a test / stress / brute / sample / spec file.
+    """
+    normalized = path.replace('\\', '/').lower()
+    basename = normalized.split('/')[-1]
+    keywords = ('test', 'spec', 'stress', 'brute', 'sample')
+    if any(k in basename for k in keywords):
+        return True
+    if any(k in normalized for k in keywords):
+        return True
+    dirs = normalized.split('/')[:-1]
+    if any(d in ('tests', 'test') for d in dirs):
+        return True
+    return False
+
+def _patch_is_acceptable(diff_str):
+    """
+    A patch is acceptable only if it is non-empty and modifies at least one non-test file.
+    """
+    if not diff_str or not diff_str.strip():
+        return False
+    files = _changed_files(diff_str)
+    return any(not _is_test_path(f) for f in files)
+
