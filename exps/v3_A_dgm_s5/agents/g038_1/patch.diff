+def _is_empty_response(msg_history):
+    """
+    Return True if the last assistant message has no non-blank text and no tool_use blocks.
+    """
+    if not isinstance(msg_history, list):
+        return True
+    for message in reversed(msg_history):
+        if isinstance(message, dict) and message.get('role') == 'assistant':
+            return is_empty_content(message.get('content'))
+    return True
+
+
+def _dedupe_paragraphs(text):
+    """
+    Split on blank lines and drop paragraphs that exactly repeat an earlier one.
+    """
+    seen = set()
+    kept = []
+    for para in re.split(r"\n\s*\n", text or ''):
+        key = para.strip()
+        if not key:
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        kept.append(para.strip('\n'))
+    return "\n\n".join(kept)
+
