+"""Utility helpers for recovering from empty LLM responses and producing a
+non-empty edit to the primary source file.
+
+These helpers are deliberately free of hard-coded paths or task details.
+No ``while True`` loops are used; every retry loop is bounded.
+"""
+
+import ast
+import logging
+import re
+import traceback
+
+logger = logging.getLogger(__name__)
+
+STUB_CODE = (
+    "# Fallback stub: the agent could not produce a solution automatically.\n"
+    "# Replace this with a real implementation.\n"
+    "import sys\n"
+    "\n"
+    "\n"
+    "def main():\n"
+    "    data = sys.stdin.read()\n"
+    "    sys.stdout.write('')\n"
+    "\n"
+    "\n"
+    "if __name__ == '__main__':\n"
+    "    main()\n"
+)
+
+
+def is_empty_content(content):
+    """Return True if an assistant message content has no text and no tool use.
+
+    ``content`` may be a string, a list of content blocks (dicts or objects),
+    or None.
+    """
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ""
+    if isinstance(content, (list, tuple)):
+        for block in content:
+            if isinstance(block, dict):
+                btype = block.get("type")
+                if btype == "tool_use":
+                    return False
+                if btype == "text" and str(block.get("text", "")).strip():
+                    return False
+            else:
+                btype = getattr(block, "type", None)
+                if btype == "tool_use":
+                    return False
+                if btype == "text" and str(getattr(block, "text", "") or "").strip():
+                    return False
+        return True
+    return str(content).strip() == ""
+
+
+def final_assistant_is_empty(history):
+    """Return True if the last assistant turn in ``history`` is empty
+    (or there is no assistant turn at all)."""
+    if not history:
+        return True
+    for msg in reversed(history):
+        if isinstance(msg, dict) and msg.get("role") == "assistant":
+            return is_empty_content(msg.get("content"))
+    return True
+
+
+def extract_python_code(text):
+    """Extract code from a ```python fenced block, or fall back to the full
+    text if it parses as Python. Returns None if neither works."""
+    if not text or not text.strip():
+        return None
+    match = re.search(r"```(?:python|py)?[ \t]*\n(.*?)```", text, re.DOTALL)
+    candidate = match.group(1) if match else text
+    candidate = candidate.strip("\n")
+    if not candidate.strip():
+        return None
+    try:
+        ast.parse(candidate)
+    except SyntaxError:
+        return None
+    return candidate
+
+
+def text_from_response(response):
+    """Safely concatenate text blocks from an Anthropic- or OpenAI-style
+    response object. Returns '' when there is no content (never raises
+    IndexError)."""
+    content = getattr(response, "content", None)
+    if content:
+        parts = []
+        for block in content:
+            text = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+            if text:
+                parts.append(str(text))
+        if parts:
+            return "".join(parts)
+    choices = getattr(response, "choices", None)
+    if choices:
+        try:
+            msg_content = choices[0].message.content
+        except (IndexError, AttributeError):
+            msg_content = None
+        if msg_content:
+            return str(msg_content)
+    return ""
+
+
+def direct_llm_code(prompt, client, model, system_prompt=None, temperature=0.0, max_tokens=8192):
+    """Call the LLM client directly and return the concatenated text ('' if the
+    response has no content). ``client`` may be an Anthropic or OpenAI client."""
+    try:
+        if hasattr(client, "messages") and hasattr(client.messages, "create"):
+            kwargs = dict(
+                model=model,
+                max_tokens=max_tokens,
+                messages=[{"role": "user", "content": prompt}],
+                temperature=temperature,
+            )
+            if system_prompt:
+                kwargs["system"] = system_prompt
+            response = client.messages.create(**kwargs)
+        else:
+            msgs = [{"role": "user", "content": prompt}]
+            if system_prompt:
+                msgs = [{"role": "system", "content": system_prompt}] + msgs
+            response = client.chat.completions.create(
+                model=model, messages=msgs, temperature=temperature, max_tokens=max_tokens
+            )
+    except Exception:
+        logger.error("direct_llm_code call failed:\n%s", traceback.format_exc())
+        return ""
+    return text_from_response(response)
+
+
+def write_stub(primary_file):
+    """Write a minimal valid program so the patch is never empty. Returns 'stub'."""
+    try:
+        with open(primary_file, "w") as f:
+            f.write(STUB_CODE)
+    except Exception:
+        logger.error("stub write failed:\n%s", traceback.format_exc())
+    logger.info("final edit stage: stub (%s)", primary_file)
+    return "stub"
+
+
+def fallback_write_primary_file(prompt, primary_file, client, model, max_attempts=3):
+    """Obtain code directly from the LLM and write it to ``primary_file``.
+
+    Returns the stage name that produced the edit: 'fallback' or 'stub'.
+    Never raises.
+    """
+    system_prompts = [
+        None,
+        "You are an expert competitive programmer. Reply with only a ```python code block.",
+        "You are a careful Python engineer. Output the complete program inside a ```python block.",
+    ]
+    for i in range(max_attempts):
+        system_prompt = system_prompts[i % len(system_prompts)]
+        temperature = 0.0 if i == 0 else min(1.0, 0.3 * i)
+        try:
+            text = direct_llm_code(prompt, client, model, system_prompt=system_prompt, temperature=temperature)
+            code = extract_python_code(text)
+            if code is None:
+                logger.warning("fallback attempt %d: no valid python code (empty=%s)", i + 1, not text.strip())
+                continue
+            with open(primary_file, "w") as f:
+                f.write(code + "\n")
+            logger.info("final edit stage: fallback attempt %d (%s)", i + 1, primary_file)
+            return "fallback"
+        except Exception:
+            logger.error("fallback attempt %d failed:\n%s", i + 1, traceback.format_exc())
+    return write_stub(primary_file)
