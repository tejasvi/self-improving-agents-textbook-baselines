+    def _problem_for_retry(self, statement):
+        """Truncate long statements to the first chunk plus Sample 1/2 blocks."""
+        statement = statement or ''
+        if len(statement) <= self.MAX_STATEMENT_CHARS:
+            return statement
+        head = statement[:self.MAX_STATEMENT_CHARS]
+        samples = []
+        for m in re.finditer(r'Sample (?:Input|Output)\s*\d*\s*:?[ \t]*\n.*?(?=\n\s*Sample (?:Input|Output)|\Z)',
+                             statement, re.DOTALL | re.IGNORECASE):
+            if len(samples) >= 4:
+                break
+            samples.append(m.group(0).strip())
+        note = ("\n... [statement truncated; the full statement is in "
+                f"{self._statement_file_path()} (read it with the bash tool if needed)]")
+        tail = ("\n\n" + "\n\n".join(samples[:4])) if samples else ""
+        return head + note + tail
+
+    def _statement_file_path(self):
+        if not getattr(self, '_statement_dir', None):
+            self._statement_dir = tempfile.mkdtemp(prefix='coding_agent_')
+        return os.path.join(self._statement_dir, 'problem.md')
+
+    def _write_statement_file(self):
