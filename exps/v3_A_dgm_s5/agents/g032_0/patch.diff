+    def _direct_codegen_fallback(self, model, target_path, target_content):
+        """
+        No-tools single completion asking for the full program in one ```python block.
+        Writes the last python block to target_path (or solution.py in the repo). Returns True if written.
+        """
+        from llm import create_client, get_response_from_llm
+        prompt = (
+            "Return ONLY the complete Python 3 program in one ```python block.\n\n"
+            f"<problem_description>\n{self.problem_statement}\n</problem_description>\n\n"
+            f"Target file: {target_path or os.path.join(self.git_tempdir, 'solution.py')}\n"
+            f"Starter content:\n```python\n{target_content or ''}\n```\n"
+        )
+        try:
+            client, client_model = create_client(model)
+            text, _ = get_response_from_llm(
+                prompt, client=client, model=client_model,
+                system_message="You are an expert competitive programmer.",
+                msg_history=[], temperature=0.0,
+            )
+        except Exception:
+            import traceback
+            safe_log("Direct codegen fallback raised:\n" + traceback.format_exc(), level=logging.ERROR)
+            return False
+        if not isinstance(text, str):
+            return False
+        blocks = re.findall(r'```(?:python)?\n(.*?)```', text, re.S)
+        if not blocks or not blocks[-1].strip():
+            safe_log(f"Direct codegen fallback ({model}): no usable python block.", level=logging.WARNING)
+            return False
+        out_path = target_path or os.path.join(self.git_tempdir, 'solution.py')
+        with open(out_path, 'w', encoding='utf-8') as f:
+            f.write(blocks[-1])
+        safe_log(f"Direct codegen fallback ({model}): wrote {out_path}")
+        return True
