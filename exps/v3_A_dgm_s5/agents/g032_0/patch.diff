+def _describe_turn(response_or_msg):
+    """Return a short description of stop_reason and content block types/lengths for logging."""
+    stop_reason = getattr(response_or_msg, 'stop_reason', None)
+    content = getattr(response_or_msg, 'content', None)
+    if content is None and isinstance(response_or_msg, dict):
+        stop_reason = response_or_msg.get('stop_reason', stop_reason)
+        content = response_or_msg.get('content')
+    parts = []
+    if isinstance(content, str):
+        parts.append(f"str({len(content)})")
+    elif isinstance(content, list):
+        for block in content:
+            if isinstance(block, dict):
+                btype = block.get('type')
+                text = block.get('text')
+            else:
+                btype = getattr(block, 'type', None)
+                text = getattr(block, 'text', None)
+            length = len(text) if isinstance(text, str) else 0
+            parts.append(f"{btype}({length})")
+    return f"stop_reason={stop_reason} blocks=[{', '.join(parts)}]"
+
