+TEST_FILE_SUFFIXES = ('_test.py', '.spec.js', '_test.go', 'Test.java')
+
+def _is_test_path(path):
+    """
+    Heuristic check whether a repo-relative path refers to a test file.
+    """
+    normalized = path.replace('\\', '/')
+    basename = normalized.split('/')[-1]
+    if basename.startswith('test_') or basename.endswith(TEST_FILE_SUFFIXES):
+        return True
+    parts = normalized.split('/')[:-1]
+    return 'tests' in parts or 'test' in parts
