+FAILURE_MARKERS = ('Traceback', 'AssertionError', 'FAILED', 'wrong answer', 'Error:')
+TIMEOUT_MARKERS = ('timed out', 'TimeoutExpired', 'Timeout')
+
+def _message_flat_text(message):
+    """
+    Return all textual content of a message, including tool_result blocks and
+    'Tool Result:' text, as a single string.
+    """
+    if not isinstance(message, dict):
+        return ""
+    content = message.get('content')
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for block in content:
+            if isinstance(block, dict):
+                if block.get('type') == 'tool_result':
+                    parts.append(str(block.get('content', '')))
+                elif block.get('type') == 'text':
+                    parts.append(str(block.get('text', '')))
+                else:
+                    parts.append(str(block))
+            elif block is not None:
+                parts.append(str(block))
+        return "\n".join(parts)
+    return "" if content is None else str(content)
+
+def _last_verification_failed(msg_history, tail_size=6, excerpt_chars=3000):
+    """
+    Inspect the tail of the message history. Returns (failed, excerpt):
+      - failed is True when the most recent tool result contains failure evidence
+        (Traceback, AssertionError, FAILED, wrong answer, Error:) and is not merely
+        a timeout of an unrelated command, or when the final assistant message is empty.
+      - excerpt is the raw text (tail) to show the agent.
+    No error parsing is performed; the raw output is passed through.
+    """
+    if not isinstance(msg_history, list) or not msg_history:
+        return False, ""
+    tail = [m for m in msg_history[-tail_size:] if isinstance(m, dict)]
+
+    # Most recent tool result (user message carrying tool output).
+    last_result = None
+    for message in reversed(tail):
+        if message.get('role') != 'user':
+            continue
+        text = _message_flat_text(message)
+        if 'Tool Result' in text or any(
+            isinstance(b, dict) and b.get('type') == 'tool_result'
+            for b in (message.get('content') or []) if isinstance(message.get('content'), list)
+        ):
+            last_result = text
+            break
+
+    if last_result is not None:
+        has_marker = any(marker in last_result for marker in FAILURE_MARKERS)
+        is_timeout = any(marker in last_result for marker in TIMEOUT_MARKERS)
+        only_timeout = is_timeout and not any(
+            m in last_result for m in ('Traceback', 'AssertionError', 'FAILED', 'wrong answer')
+        )
+        if has_marker and not only_timeout:
+            return True, last_result[-excerpt_chars:]
+
+    # Final assistant message empty/degenerate.
+    for message in reversed(msg_history):
+        if isinstance(message, dict) and message.get('role') == 'assistant':
+            if _is_empty_content(message.get('content')):
+                excerpt = last_result[-excerpt_chars:] if last_result else "(final assistant message was empty)"
+                return True, excerpt
+            break
+    return False, ""
+
