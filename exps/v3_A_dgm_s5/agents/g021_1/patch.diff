index 0000000..14b24c5
--- /dev/null
+++ b/tools/run_stress.py
@@ -0,0 +1,166 @@
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "run_stress",
+        "description": """Differential stress testing of a solution against an independent brute-force reference.\n
+* The generator is run as `python3 gen_path <seed>` (seed is an integer, different for every iteration) and must print one test input to stdout.\n
+* Both the solution and the brute-force program are run as `python3 <program>` with that input on stdin.\n
+* Outputs are compared after whitespace normalization (spaces/tabs and trailing blank lines are ignored, line structure is kept).\n
+* Returns the first counterexample (input, expected output from brute force, actual output from solution) or 'ALL PASSED'.\n
+* If max_gen_path is given, the generator is run once more (no seed argument) to produce a max-size input, and the solution's runtime on it is reported.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the solution Python file to test (executed with python3)."
+                },
+                "brute_path": {
+                    "type": "string",
+                    "description": "Path to the naive brute-force reference Python file (executed with python3)."
+                },
+                "gen_path": {
+                    "type": "string",
+                    "description": "Path to the random small-input generator. It is run as `python3 gen_path <seed>` and prints one input to stdout."
+                },
+                "num_tests": {
+                    "type": "integer",
+                    "description": "Number of random tests to run (seeds 1..num_tests). Defaults to 200."
+                },
+                "timeout": {
+                    "type": "integer",
+                    "description": "Timeout in seconds for each single program run. Defaults to 10."
+                },
+                "max_gen_path": {
+                    "type": "string",
+                    "description": "Optional path to a generator that prints one max-size input to stdout when run without arguments. If given, the solution's runtime on it is reported."
+                }
+            },
+            "required": ["solution_path", "brute_path", "gen_path"]
+        }
+    }
+
+
+def _normalize(text):
+    """Keep line structure, ignore spacing differences and blank lines."""
+    return [line.split() for line in (text or "").splitlines() if line.strip()]
+
+
+def _run(cmd, stdin_text, timeout):
+    """Run a command; returns (returncode, stdout, stderr, timed_out)."""
+    try:
+        proc = subprocess.run(
+            cmd,
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.returncode, proc.stdout, proc.stderr, False
+    except subprocess.TimeoutExpired as e:
+        stderr = e.stderr
+        if isinstance(stderr, bytes):
+            stderr = stderr.decode(errors="replace")
+        return None, "", stderr or "", True
+
+
+def run_stress_check(solution_path, brute_path, gen_path, num_tests=200, timeout=10, max_gen_path=None):
+    """
+    Structured version of the stress test (used directly by the coding agent pipeline).
+
+    Returns a dict with keys:
+      passed: bool            - True if no counterexample was found (and generator worked)
+      error: str or None      - generator failure message, if any
+      counterexample: dict or None - {'seed', 'input', 'expected', 'actual', 'stderr'} for the first mismatch
+      tests_run: int         - number of tests actually compared
+      max_time: float or None - solution runtime on the max-size input (seconds)
+      max_ok: bool or None   - True if the solution finished on max-size input within the timeout
+    """
+    if timeout is None:
+        timeout = 10
+    if num_tests is None:
+        num_tests = 200
+
+    result = {
+        "passed": True,
+        "error": None,
+        "counterexample": None,
+        "tests_run": 0,
+        "max_time": None,
+        "max_ok": None,
+    }
+
+    tests_run = 0
+    for seed in range(1, num_tests + 1):
+        rc, gen_out, gen_err, gen_timeout = _run(["python3", gen_path, str(seed)], "", timeout)
+        if gen_timeout or rc != 0:
+            result["passed"] = False
+            result["error"] = f"Generator failed on seed {seed} (exit code {rc}, timed out={gen_timeout}). stderr:\n{gen_err}"
+            return result
+        test_input = gen_out
+
+        b_rc, b_out, b_err, b_timeout = _run(["python3", brute_path], test_input, timeout)
+        if b_timeout or b_rc != 0:
+            # The reference itself failed on this input; it cannot judge the solution here, skip.
+            continue
+
+        s_rc, s_out, s_err, s_timeout = _run(["python3", solution_path], test_input, timeout)
+        tests_run += 1
+        if s_timeout or s_rc != 0 or _normalize(s_out) != _normalize(b_out):
+            result["passed"] = False
+            result["counterexample"] = {
+                "seed": seed,
+                "input": test_input,
+                "expected": b_out,
+                "actual": "(timed out)" if s_timeout else s_out,
+                "stderr": s_err,
+            }
+            result["tests_run"] = tests_run
+            return result
+
+    result["tests_run"] = tests_run
+
+    if max_gen_path:
+        rc, max_input, gen_err, gen_timeout = _run(["python3", max_gen_path], "", timeout)
+        if gen_timeout or rc != 0:
+            result["max_ok"] = False
+            result["error"] = f"Max-size generator failed (exit code {rc}, timed out={gen_timeout}). stderr:\n{gen_err}"
+        else:
+            import time
+            start = time.time()
+            s_rc, s_out, s_err, s_timeout = _run(["python3", solution_path], max_input, timeout)
+            elapsed = time.time() - start
+            result["max_time"] = round(elapsed, 3)
+            result["max_ok"] = (not s_timeout) and s_rc == 0
+    return result
+
+
+def tool_function(solution_path, brute_path, gen_path, num_tests=200, timeout=10, max_gen_path=None):
+    res = run_stress_check(
+        solution_path,
+        brute_path,
+        gen_path,
+        num_tests=num_tests,
+        timeout=timeout,
+        max_gen_path=max_gen_path,
+    )
+    lines = []
+    if res["error"]:
+        lines.append(f"ERROR: {res['error']}")
+    if res["counterexample"]:
+        ce = res["counterexample"]
+        lines.append(
+            f"COUNTEREXAMPLE (seed {ce['seed']}):\n"
+            f"--- input ---\n{ce['input']}\n"
+            f"--- expected (brute) ---\n{ce['expected']}\n"
+            f"--- actual (solution) ---\n{ce['actual']}\n"
+            f"--- stderr (solution) ---\n{ce['stderr']}"
+        )
+    elif not res["error"]:
+        lines.append(f"ALL PASSED ({res['tests_run']} tests compared)")
+    if res["max_time"] is not None:
+        status = "OK" if res["max_ok"] else "FAILED/TIMED OUT"
+        lines.append(f"Max-size input runtime: {res['max_time']}s ({status})")
+    return "\n".join(lines)
