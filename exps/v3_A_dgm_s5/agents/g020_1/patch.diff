+def chat_plain(prompt, model=CLAUDE_MODEL, logging=print, max_retry=2):
+    """
+    Tool-free single-turn completion. Returns the reply text ('' on failure).
+    """
+    for _ in range(max_retry + 1):
+        try:
+            client, _ = create_client(model)
+            if 'claude' in model:
+                response = client.messages.create(
+                    model=model,
+                    messages=[{"role": "user", "content": prompt}],
+                    max_tokens=4096,
+                )
+                return ''.join(
+                    getattr(b, 'text', '') or '' for b in response.content
+                    if getattr(b, 'type', None) == 'text'
+                )
+            raise ValueError(f"Unsupported model for plain completion: {model}")
+        except Exception as e:
+            logging(f"Error in chat_plain: {str(e)}")
+    return ''
