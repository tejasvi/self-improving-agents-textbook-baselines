+    def _safe_llm_text(self, model, system_message, prompt, prefill=None, temperature=0.7, max_tokens=8192):
+        """
+        Defensive single-shot LLM call that never raises and never indexes content unguarded.
+        Returns (text, info) where info holds stop_reason, usage, and any error string.
+        """
+        info = {"model": model, "stop_reason": None, "usage": None, "error": None, "raw_content_len": None}
+        text = ""
+        try:
+            client, client_model = create_client(model)
+            messages = [{"role": "user", "content": prompt}]
+            if prefill:
+                messages.append({"role": "assistant", "content": prefill})
+            if "claude" in client_model:
+                kwargs = {"model": client_model, "max_tokens": max_tokens, "temperature": temperature,
+                          "system": system_message, "messages": messages}
+                response = client.messages.create(**kwargs)
+                content = getattr(response, "content", None) or []
+                info["raw_content_len"] = len(content)
+                info["stop_reason"] = getattr(response, "stop_reason", None)
+                usage = getattr(response, "usage", None)
+                info["usage"] = str(usage) if usage is not None else None
+                parts = []
+                for block in content:
+                    block_text = getattr(block, "text", None)
+                    if block_text is None and isinstance(block, dict):
+                        block_text = block.get("text")
+                    if block_text:
+                        parts.append(str(block_text))
+                text = "".join(parts)
+            else:
+                chat_messages = [{"role": "system", "content": system_message}] + messages
+                response = client.chat.completions.create(
+                    model=client_model,
+                    messages=chat_messages,
+                    temperature=temperature,
+                    max_tokens=max_tokens,
+                )
+                choices = getattr(response, "choices", None) or []
+                info["raw_content_len"] = len(choices)
+                if choices:
+                    info["stop_reason"] = getattr(choices[0], "finish_reason", None)
+                    message = getattr(choices[0], "message", None)
+                    text = (getattr(message, "content", None) or "") if message is not None else ""
+                usage = getattr(response, "usage", None)
+                info["usage"] = str(usage) if usage is not None else None
+            if prefill:
+                text = prefill + text
+        except Exception:
+            info["error"] = traceback.format_exc()
+            text = ""
+
+        if not text or not str(text).strip():
+            safe_log(f"_safe_llm_text: empty response from {model}; info={info}", level=logging.WARNING)
+            return "", info
+        return text, info
