@@ -190,6 +190,67 @@ def _message_text(message):
     return ""
 
 
+_SAMPLE_LABEL_RE = re.compile(
+    r'^[ \t#*_>`]*'
+    r'(?:(?:sample|example)[ \t]*\d*[ \t]*[:.]?[ \t]*)?'
+    r'(input|output)[ \t]*\d*[ \t]*[:.]?[ \t*_`]*$',
+    re.IGNORECASE | re.MULTILINE,
+)
+
+# Headers that end a sample block but are not sample labels themselves.
+_SAMPLE_BOUNDARY_RE = re.compile(
+    r'^[ \t#*_>`]*(?:sample|example|explanation|note|constraints?)\b.*$',
+    re.IGNORECASE | re.MULTILINE,
+)
+
+def _clean_sample_block(lines):
+    """Strip surrounding blank lines and markdown code fences from a sample block."""
+    lines = [ln.rstrip() for ln in lines]
+    lines = [ln for ln in lines if not ln.strip().startswith('```')]
+    while lines and not lines[0].strip():
+        lines.pop(0)
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return "\n".join(lines)
+
+def _extract_samples(problem_statement):
+    """
+    Parse (stdin, expected_stdout) pairs from a problem statement.
+    Recognises labelled blocks such as 'Sample Input 1' / 'Sample Output 1',
+    'Example 1 Input' / 'Example 1 Output', and bare 'Input:' / 'Output:' lines.
+    Each Input block is paired with the next Output block. Returns a list (possibly empty).
+    """
+    if not problem_statement:
+        return []
+    text = str(problem_statement)
+    labels = list(_SAMPLE_LABEL_RE.finditer(text))
+    segments = []
+    for idx, match in enumerate(labels):
+        end = labels[idx + 1].start() if idx + 1 < len(labels) else len(text)
+        boundary = _SAMPLE_BOUNDARY_RE.search(text, match.end(), end)
+        if boundary is not None:
+            end = boundary.start()
+        body = text[match.end():end].split('\n')
+        # Drop the remainder of the label line (usually empty) and keep the block body.
+        body = body[1:]
+        kind = match.group(1).lower()
+        segments.append((kind, _clean_sample_block(body)))
+
+    samples = []
+    pending_input = None
+    for kind, content in segments:
+        if kind == 'input':
+            pending_input = content
+        elif kind == 'output' and pending_input is not None:
+            if pending_input.strip() or content.strip():
+                samples.append((pending_input + "\n", content))
+            pending_input = None
+    return samples
+
+def _normalize_tokens(text):
+    return (text or "").split()
+
+
 class AgenticSystem:
     def __init__(
             self,
