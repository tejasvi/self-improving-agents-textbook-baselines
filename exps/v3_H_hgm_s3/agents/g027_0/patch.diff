diff --git a/tools/perf_check_method.py b/tools/perf_check_method.py
new file mode 100644
index 0000000..d6f20fd
--- /dev/null
+++ b/tools/perf_check_method.py
@@ -0,0 +1,148 @@
+import importlib.util
+import json
+import os
+import subprocess
+import sys
+import time
+
+
+# Child-process driver: loads the module by path, instantiates the class, calls the method with the
+# arguments from the JSON file, and prints the elapsed time of the call on the last stdout line.
+_DRIVER = r'''
+import importlib.util, json, sys, time
+solution_path, class_name, method_name, args_path = sys.argv[1:5]
+with open(args_path) as f:
+    payload = json.load(f)
+spec = importlib.util.spec_from_file_location('candidate_solution_module', solution_path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+cls = getattr(module, class_name)
+obj = cls()
+if method_name:
+    name = method_name
+else:
+    import inspect
+    names = [n for n, m in inspect.getmembers(cls, predicate=inspect.isfunction) if not n.startswith('_')]
+    if len(names) != 1:
+        raise ValueError('cannot infer method name, candidates: %r' % (names,))
+    name = names[0]
+method = getattr(obj, name)
+if isinstance(payload, dict):
+    args, kwargs = [], payload
+else:
+    args, kwargs = list(payload), {}
+start = time.perf_counter()
+result = method(*args, **kwargs)
+elapsed = time.perf_counter() - start
+print('PERF_ELAPSED %.6f' % elapsed)
+'''
+
+
+def tool_info():
+    return {
+        'name': 'perf_check_method',
+        'description': (
+            'Performance / scale check for method-style solutions (a `Solution` class method). Each args file is '
+            'a JSON file holding either a dict of keyword arguments or a list of positional arguments for the '
+            'method. For each args file the module is loaded, Solution().<method>(...) is called in a subprocess '
+            'with a per-input time limit, and the elapsed time is reported. Reports "OK <seconds>s", '
+            '"TIMEOUT (>Ns)", or "RUNTIME ERROR" (with the stderr tail) for each args file, then a final summary '
+            'line: "ALL PERF OK" or "<N> PERF FAIL(S)". Use it on maximum-size arguments to confirm the method '
+            'finishes within the time limit.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python file that defines the Solution class.',
+                },
+                'method_name': {
+                    'type': 'string',
+                    'description': 'Name of the method to call. If omitted, the single public method of the class is used.',
+                },
+                'args_paths': {
+                    'type': 'array',
+                    'items': {
+                        'type': 'string',
+                        'description': 'Absolute path to a JSON file holding a dict of keyword arguments or a list of positional arguments.',
+                    },
+                    'description': 'Absolute paths of JSON files, each holding the arguments for one maximum-size call.',
+                },
+                'time_limit': {
+                    'type': 'number',
+                    'description': 'Time limit in seconds per call. Defaults to 3.',
+                },
+                'class_name': {
+                    'type': 'string',
+                    'description': 'Name of the class to instantiate. Defaults to "Solution".',
+                },
+            },
+            'required': ['solution_path', 'args_paths'],
+        },
+    }
+
+
+def _tail(text, n=600):
+    text = (text or '').strip()
+    return text[-n:]
+
+
+def tool_function(solution_path, args_paths, method_name=None, class_name='Solution', time_limit=3):
+    class_name = class_name or 'Solution'
+    time_limit = float(time_limit) if time_limit is not None else 3.0
+    if isinstance(args_paths, str):
+        args_paths = [args_paths]
+    args_paths = list(args_paths or [])
+    if not args_paths:
+        return 'No args_paths given.'
+    if not os.path.isfile(solution_path):
+        return f'Solution file not found: {solution_path}'
+
+    lines = []
+    failures = 0
+    for path in args_paths:
+        label = f'args {path}'
+        try:
+            with open(path) as f:
+                json.load(f)  # validate the JSON before spawning the subprocess
+        except (OSError, ValueError) as e:
+            lines.append(f'{label}: ERROR cannot read args file as JSON ({e})')
+            failures += 1
+            continue
+
+        cmd = [sys.executable, '-c', _DRIVER, solution_path, class_name, method_name or '', path]
+        start = time.perf_counter()
+        try:
+            proc = subprocess.run(cmd, capture_output=True, timeout=time_limit, text=True)
+        except subprocess.TimeoutExpired:
+            lines.append(f'{label}: TIMEOUT (>{time_limit:g}s)')
+            failures += 1
+            continue
+        wall = time.perf_counter() - start
+
+        if proc.returncode != 0:
+            lines.append(f'{label}: RUNTIME ERROR (exit code {proc.returncode}) after {wall:.2f}s')
+            lines.append(f'stderr: {_tail(proc.stderr)}')
+            failures += 1
+            continue
+
+        elapsed = None
+        for out_line in (proc.stdout or '').splitlines():
+            if out_line.startswith('PERF_ELAPSED '):
+                try:
+                    elapsed = float(out_line.split()[1])
+                except (IndexError, ValueError):
+                    elapsed = None
+        if elapsed is None:
+            lines.append(f'{label}: RUNTIME ERROR (no timing output) after {wall:.2f}s')
+            lines.append(f'stdout: {_tail(proc.stdout)}')
+            failures += 1
+            continue
+        lines.append(f'{label}: OK {elapsed:.2f}s')
+
+    if failures:
+        lines.append(f'{failures} PERF FAIL(S)')
+    else:
+        lines.append('ALL PERF OK')
+    return '\n'.join(lines)
