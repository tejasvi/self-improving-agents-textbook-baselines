@@ -0,0 +1,52 @@
+import os
+
+NOTES_PATH = '/tmp/agent_notes.md'
+MAX_READ_CHARS = 20000
+
+
+def tool_info():
+    return {
+        'name': 'notes',
+        'description': (
+            'Persistent scratch notes for this task. Use command "append" with "text" to record findings '
+            '(brute-force tables, hypotheses, formulas, first failing parameters, next steps) after each major '
+            'finding. Use command "read" to get the current contents. Both commands return the full notes.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'command': {
+                    'type': 'string',
+                    'description': 'Either "append" (add text to the notes) or "read" (return the notes).',
+                },
+                'text': {
+                    'type': 'string',
+                    'description': 'Text to append to the notes. Only used with command "append".',
+                },
+            },
+            'required': ['command'],
+        },
+    }
+
+
+def tool_function(command, text=None):
+    if command not in ('append', 'read'):
+        return f"Error: unknown command {command!r}; use 'append' or 'read'."
+    if command == 'append':
+        if not text:
+            return "Error: 'text' is required for command 'append'."
+        try:
+            with open(NOTES_PATH, 'a') as f:
+                f.write(text.rstrip('\n') + '\n')
+        except OSError as e:
+            return f"Error: cannot write notes: {e}"
+    try:
+        with open(NOTES_PATH) as f:
+            content = f.read()
+    except FileNotFoundError:
+        return "(notes are empty)"
+    except OSError as e:
+        return f"Error: cannot read notes: {e}"
+    if len(content) > MAX_READ_CHARS:
+        content = '...(truncated)...\n' + content[-MAX_READ_CHARS:]
+    return content if content.strip() else "(notes are empty)"
