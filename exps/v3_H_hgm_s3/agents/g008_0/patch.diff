+    try:
+        client, client_model = create_client(model)
+        text, _ = get_response_from_llm(
+            msg=prompt,
+            client=client,
+            model=client_model,
+            system_message=system_message,
+            print_debug=False,
+            msg_history=[],
+        )
+        return text or ''
+    except Exception:
+        return ''
