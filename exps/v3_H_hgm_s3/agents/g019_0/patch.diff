+    def _chat_health(self, history):
+        """
+        Inspect the last assistant message in history. Returns True if it contains a
+        tool_use block or non-empty text, otherwise False. Logs a short status line.
+        """
+        last = None
+        if history:
+            for msg in reversed(history):
+                if isinstance(msg, dict) and msg.get('role') == 'assistant':
+                    last = msg
+                    break
+        if last is None:
+            safe_log("[chat_health] no assistant message found in history", level=logging.WARNING)
+            return False
+        content = last.get('content')
+        healthy = False
+        if isinstance(content, str):
+            healthy = content.strip() != ''
+        elif isinstance(content, list):
+            healthy = any(self._block_is_tool_use(b) or self._block_has_text(b) for b in content)
+        status = "healthy" if healthy else "empty"
+        safe_log(f"[chat_health] last assistant message status: {status}",
+                 level=logging.INFO if healthy else logging.WARNING)
+        return healthy
+
