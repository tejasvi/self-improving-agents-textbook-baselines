+    def _fallback_verify_and_repair(self, task, max_rounds=5):
+        """
+        Non-agentic verify-and-repair for a target produced by _direct_completion_fallback.
+        Each round runs the direct sample check (and the example or perf check when applicable).
+        If a check fails, the model is asked for a complete corrected file with the failure report.
+        A rewrite is kept only if it passes _validate_target; otherwise the previous content is restored.
+        At most max_rounds rounds. Returns True if the final state passes all direct checks.
+        """
+        path = self._target_path()
+        filename = self._output_filename()
+        if not path or not filename or not os.path.isfile(path):
+            return False
+
+        def run_checks():
+            """Returns (checked, failed, report). checked is False when nothing could be verified."""
+            direct = self._direct_sample_check()
+            if direct is None:
+                direct = self._direct_example_check()
+            if direct is None:
+                return False, False, 'no sample or example checks available'
+            failed, report = direct
+            if failed:
+                return True, True, report
+            perf = self._direct_perf_check()
+            if perf is not None and perf[0]:
+                return True, True, perf[1]
+            return True, False, report
+
+        alternate = OPENAI_MODEL if self.code_model == CLAUDE_MODEL else CLAUDE_MODEL
+        models = [self.code_model]
+        if alternate != self.code_model:
+            models.append(alternate)
+        system_message = "You write complete, correct Python source files. Reply with the full file only."
+
+        for rnd in range(1, max_rounds + 1):
+            checked, failed, report = run_checks()
+            if not checked:
+                safe_log("[fallback-verify] nothing to verify; stopping")
+                return False
+            if not failed:
+                safe_log(f"[fallback-verify] round {rnd}: all direct checks pass")
+                return True
+            safe_log(f"[fallback-verify] round {rnd}: failed: {report[:200]!r}")
+
+            model = models[(rnd - 1) % len(models)]
+            try:
+                with open(path) as f:
+                    current = f.read()
+            except OSError as e:
+                safe_log(f"[fallback-verify] cannot read target: {e}", level=logging.ERROR)
+                return False
+            try:
+                client, client_model = create_client(model)
+                prompt = (
+                    f"Problem statement:\n{self.problem_statement}\n\n"
+                    f"Target file: {filename}\n\n"
+                    f"Current content of the file:\n```python\n{current}\n```\n\n"
+                    f"The direct checks reported this failure:\n<verification>\n{report[-1500:]}\n</verification>\n\n"
+                    "A MISMATCH is a failure even if your output is a different valid answer, because the grader "
+                    "may compare output exactly. A TIMEOUT or PERF FAIL means the algorithm is too slow for the "
+                    "maximum constraints (3 seconds per input in Python). Fix the cause and write the complete "
+                    "corrected file so that it solves the problem and keeps the required interface "
+                    "(class Solution with its method signatures, or a stdin/stdout program). "
+                    "Put the complete file in a single ```python code block and nothing else."
+                )
+                content, _diag = self._plain_llm_text(client, client_model, system_message, prompt)
+            except Exception as e:
+                safe_log(f"[fallback-verify] round {rnd} ({model}) LLM call failed: {type(e).__name__}: {e}",
+                         level=logging.ERROR)
+                continue
+            code = self._extract_code(content)
+            if code is None:
+                safe_log(f"[fallback-verify] round {rnd} ({model}): no code block in reply", level=logging.WARNING)
+                continue
+
+            with open(path, 'w') as f:
+                f.write(code)
+            if self._is_method_task(filename):
+                self._ensure_typing_import(path)
+            ok, reason = self._validate_target()
+            if not ok:
+                safe_log(f"[fallback-verify] round {rnd}: rewrite rejected ({reason}); restoring previous content",
+                         level=logging.WARNING)
+                with open(path, 'w') as f:
+                    f.write(current)
+                continue
+            safe_log(f"[fallback-verify] round {rnd}: rewrite accepted ({model})")
+
+        checked, failed, report = run_checks()
+        final_ok = checked and not failed
+        safe_log(f"[fallback-verify] final state: {'PASSED' if final_ok else 'FAILED'} {report[:200]!r}")
+        return final_ok
+
