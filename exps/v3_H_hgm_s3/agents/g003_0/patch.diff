+    def _block_has_text(self, block):
+        if isinstance(block, dict):
+            btype, text = block.get('type'), block.get('text')
+        else:
+            btype, text = getattr(block, 'type', None), getattr(block, 'text', None)
+        return btype == 'text' and isinstance(text, str) and text.strip() != ''
+
+    def _block_is_tool_use(self, block):
+        if isinstance(block, dict):
+            return block.get('type') == 'tool_use'
+        return getattr(block, 'type', None) == 'tool_use'
+
+    def _is_degenerate_assistant(self, msg):
+        """
+        True for assistant turns that carry neither non-empty text nor tool_use blocks.
+        """
+        if not isinstance(msg, dict) or msg.get('role') != 'assistant':
+            return False
+        content = msg.get('content')
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return content.strip() == ''
+        if not isinstance(content, list):
+            return False
+        for block in content:
+            if self._block_is_tool_use(block) or self._block_has_text(block):
+                return False
+        return True
+
+    def _sanitize_history(self, history):
+        """
+        Drop degenerate assistant turns (empty/whitespace-only text, no tool_use) and
+        merge adjacent messages with the same role so the history remains valid.
+        """
+        if not history:
+            return []
+        cleaned = []
+        dropped = 0
+        for msg in history:
+            if self._is_degenerate_assistant(msg):
+                dropped += 1
+                continue
+            if cleaned and cleaned[-1].get('role') == msg.get('role'):
+                prev = cleaned[-1]
+                prev_content = prev.get('content')
+                new_content = msg.get('content')
+                if isinstance(prev_content, str):
+                    prev_content = [{"type": "text", "text": prev_content}]
+                if isinstance(new_content, str):
+                    new_content = [{"type": "text", "text": new_content}]
+                merged = dict(prev)
+                merged['content'] = list(prev_content or []) + list(new_content or [])
+                cleaned[-1] = merged
+            else:
+                cleaned.append(msg)
+        if dropped:
+            safe_log(f"[sanitize] dropped {dropped} degenerate assistant message(s)")
+        return cleaned
+
+    def _safe_chat(self, msg, history):
+        """
+        Call chat_with_agent, never raising. On failure, log and return the sanitized input history.
+        """
+        try:
+            new_history = chat_with_agent(msg, model=self.code_model, msg_history=history, logging=safe_log)
+            if new_history is None:
+                raise ValueError("chat_with_agent returned None")
+            return new_history
+        except Exception as e:
+            safe_log(f"[safe_chat] exception from chat_with_agent: {type(e).__name__}: {e}", level=logging.ERROR)
+            return self._sanitize_history(history)
+
+    def _output_filename(self):
+        match = re.search(r'`([\w./-]+\.py)`', self.problem_statement)
+        return match.group(1) if match else None
+
+    def _write_stub(self, filename):
