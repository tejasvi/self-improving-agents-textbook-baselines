+    def _get_changed_files(self):
+        """
+        Return the list of repo-relative paths modified, added, deleted or untracked
+        relative to base_commit (including untracked files).
+        """
+        files = []
+        try:
+            diff_cmd = ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit]
+            result = subprocess.run(diff_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            files.extend(result.stdout.decode(errors='replace').splitlines())
+
+            status_cmd = ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"]
+            result = subprocess.run(status_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            for line in result.stdout.decode(errors='replace').splitlines():
+                if len(line) < 4:
+                    continue
+                path = line[3:]
+                if ' -> ' in path:  # rename: keep the new path
+                    path = path.split(' -> ', 1)[1]
+                files.append(path)
+        except Exception as e:
+            safe_log(f"Error while listing changed files: {e}", level=logging.WARNING)
+
+        cleaned = []
+        for f in files:
+            f = f.strip()
+            if len(f) >= 2 and f[0] == '"' and f[-1] == '"':
+                f = f[1:-1]
+            if f and f not in cleaned:
+                cleaned.append(f)
+        return cleaned
+
+    def _has_source_edits(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not _is_test_file(f) for f in self._get_changed_files())
