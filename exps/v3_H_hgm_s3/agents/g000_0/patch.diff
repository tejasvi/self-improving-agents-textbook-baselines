+TEST_DIR_NAMES = {'test', 'tests', 'spec', 'specs', '__tests__'}
+
+def _is_test_file(path):
+    """
+    Heuristically decide whether a repo-relative path is a test file.
+    """
+    parts = [p for p in path.replace('\\', '/').split('/') if p]
+    if not parts:
+        return False
+    if any(p.lower() in TEST_DIR_NAMES for p in parts[:-1]):
+        return True
+    name = parts[-1].lower()
+    return (
+        name.startswith('test_')
+        or name.startswith('tests_')
+        or name.startswith('conftest')
+        or name.endswith('_test.py')
+        or name.endswith('_test.go')
+        or name.endswith('_test.rs')
+        or name.endswith('_test.cpp')
+        or name.endswith('_test.js')
+        or name.endswith('_test.ts')
+        or any(name.endswith(f'.{kind}.{ext}') for kind in ('test', 'spec')
+               for ext in ('js', 'jsx', 'ts', 'tsx', 'mjs', 'cjs', 'py', 'rb'))
+    )
