-    def _validate_target(self):
-        """
-        Check the target file. Returns (ok, reason).
-        - The file must compile.
-        - Method-style (file defines class Solution): the starter's method names must still exist
-          in Solution, with non-trivial bodies.
-        - Program-style: must print/write output and must not contain the stub marker.
-        """
-        filename = self._output_filename()
-        path = self._target_path()
-        if not filename or not path or not os.path.isfile(path):
-            return True, 'no target file to validate'
-        try:
-            with open(path) as f:
-                text = f.read()
-        except OSError as e:
-            return False, f'cannot read {filename}: {e}'
-        try:
-            compile(text, filename, 'exec')
-        except SyntaxError as e:
-            return False, f'{filename} does not compile: {e}'
-        try:
-            tree = ast.parse(text)
-        except SyntaxError as e:
-            return False, f'{filename} does not parse: {e}'
-
-        if self._is_method_task(filename):
-            classes = [n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'Solution']
-            if not classes:
-                return False, f'{filename} no longer defines class Solution'
-            methods = {n.name: n for n in classes[0].body if isinstance(n, ast.FunctionDef)}
-            for name in self._starter_methods(filename):
-                if name not in methods:
-                    return False, f'Solution.{name} is missing from {filename}'
-                if self._is_trivial_body(methods[name]):
-                    return False, f'Solution.{name} in {filename} has an empty body'
-            if not self._starter_methods(filename) and all(self._is_trivial_body(m) for m in methods.values()):
-                return False, f'Solution in {filename} has no implemented method'
-            return True, 'method-style target looks valid'
-
-        if 'TODO: replace with a real solution' in text:
-            return False, f'{filename} still contains the stub marker'
-        if 'print(' not in text and 'sys.stdout' not in text:
-            return False, f'{filename} never writes output (no print/sys.stdout)'
-        return True, 'program-style target looks valid'
