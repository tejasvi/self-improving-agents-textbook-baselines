-    def _history_events(self, msg_history):
-        """
-        Flatten the message history into ('call', name, text) and ('result', name, text) events,
-        supporting structured tool_use/tool_result blocks and text blocks with '<tool_use>' or
-        'Tool Used:' / 'Tool Result:' markers.
-        """
-        events = []
-        last_call = None
-        for msg in msg_history or []:
-            if not isinstance(msg, dict):
-                continue
-            content = msg.get('content')
-            if isinstance(content, str):
-                content = [{"type": "text", "text": content}]
-            if not isinstance(content, list):
-                continue
-            for block in content:
-                if isinstance(block, dict):
-                    btype = block.get('type')
-                    if btype == 'tool_use':
-                        last_call = block.get('name')
-                        events.append(('call', last_call, str(block.get('input', ''))))
-                        continue
-                    if btype == 'tool_result':
-                        events.append(('result', last_call, str(block.get('content', ''))))
-                        continue
-                    text = block.get('text') if btype == 'text' else None
-                else:
-                    if getattr(block, 'type', None) == 'tool_use':
-                        last_call = getattr(block, 'name', None)
-                        events.append(('call', last_call, str(getattr(block, 'input', ''))))
-                    continue
-                if not isinstance(text, str):
-                    continue
-                if '<tool_use>' in text:
-                    m = re.search(r"tool_name['\"]?\s*:\s*['\"]?(\w+)", text)
-                    last_call = m.group(1) if m else None
-                    events.append(('call', last_call, text))
-                    continue
-                used = re.search(r'Tool Used:\s*(\w+)', text)
-                if used:
-                    last_call = used.group(1)
-                    before, _, after = text.partition('Tool Result:')
-                    events.append(('call', last_call, before))
-                    if 'Tool Result:' in text:
-                        events.append(('result', last_call, after))
-                    continue
-                if 'Tool Result:' in text:
-                    events.append(('result', last_call, text.split('Tool Result:', 1)[1]))
-        return events
