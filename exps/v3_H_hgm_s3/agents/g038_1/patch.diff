-    @classmethod
-    def _sample_report_failed(cls, report):
-        """
-        Strict check: True only if a line is a 'Sample N: MISMATCH' line or the 'N SAMPLE(S) DIFFER'
-        summary. The multi-answer 'DIFFERENT (...)' label and the MULTI-ANSWER summary are not failures
-        here; they are handled by a validator prompt instead of sample-matching repair.
-        """
-        for line in report.splitlines():
-            stripped = line.strip()
-            if re.match(r'^Sample \d+: MISMATCH\b', stripped):
-                return True
-            if re.match(r'^\d+ SAMPLE\(S\) DIFFER$', stripped):
-                return True
-        return False
-
-    @classmethod
-    def _sample_report_multi(cls, report):
-        """True if a run_samples report flags a multi-answer problem (samples not exact by design)."""
-        return cls._MULTI_ANSWER_SUMMARY in report
-
-    def _last_verification_failed(self, msg_history):
-        """
-        Inspect the history after the last file-writing editor call. Returns (failed, excerpt):
-        - failed is True if the last run_samples result after that edit reports a mismatch
-          (DIFFER / MISMATCH), or if no run_samples result follows the edit (unverified).
-        - failed is False only when the last run_samples result reports ALL SAMPLES EXACT MATCH.
-        Generic keyword matching on raw bash output is deliberately not used.
-        """
-        events = self._history_events(msg_history)
-        last_edit = None
-        for i, (kind, name, text) in enumerate(events):
-            if kind == 'call' and name == 'editor' and re.search(
-                    r"command['\"]?\s*:\s*['\"](create|edit)['\"]", text):
-                last_edit = i
-        if last_edit is None:
-            return False, ''
-
-        later_results = [text for kind, name, text in events[last_edit + 1:]
-                         if kind == 'result' and name == 'run_samples']
-        if not later_results:
-            return True, 'no run_samples verification run after last edit'
-
-        last_report = later_results[-1].strip()
-        if self._sample_report_failed(last_report) or self._sample_report_multi(last_report):
-            return True, last_report[-1500:]
-        return False, ''
-
-    def _direct_sample_check(self):
-        """
-        Run the sample tests directly against the output file on disk.
-        Returns (failed, report), or None if the output file or problem text is unavailable.
-        """
-        filename = self._output_filename()
-        if not filename or not self.problem_statement:
-            return None
-        path = os.path.join(self.git_tempdir, filename)
-        if not os.path.isfile(path):
-            return None
-        try:
-            from tools.run_samples import tool_function as run_samples
-            report = run_samples(path, self.problem_statement)
-        except Exception as e:
-            safe_log(f"[forward] direct sample check failed: {type(e).__name__}: {e}", level=logging.WARNING)
-            return None
-        return (self._sample_report_failed(report) or self._sample_report_multi(report)), report
-
-    def _direct_example_check(self):
-        """
-        For problems without 'Sample Input N' blocks: check the Solution method against the
-        'Input:' / 'Output:' examples with tools/run_examples. Returns (failed, report) or None.
-        """
-        path = self._target_path()
-        if not path or not self.problem_statement or not os.path.isfile(path):
-            return None
-        if not self._is_method_task(self._output_filename()):
-            return None
-        try:
-            from tools.run_examples import tool_function as run_examples
-            report = run_examples(path, self.problem_statement)
-        except Exception as e:
-            safe_log(f"[forward] direct example check failed: {type(e).__name__}: {e}", level=logging.WARNING)
-            return None
-        if 'No "Input:"' in report:
-            return None
-        failed = 'DIFFER' in report or 'MISMATCH' in report or 'ERROR' in report
