-    def _perf_input_files(self):
-        """Sorted list of input files in _PERF_DIR (bounded: at most 50 entries)."""
-        if not os.path.isdir(_PERF_DIR):
-            return []
-        names = sorted(os.listdir(_PERF_DIR))[:50]
-        return [os.path.join(_PERF_DIR, n) for n in names if os.path.isfile(os.path.join(_PERF_DIR, n))]
