-    def _output_filename(self):
-        """
-        The target file named in the problem statement (`file.py`). Falls back to the first
-        .py file in the repo that defines class Solution.
-        """
-        match = re.search(r'`([\w./-]+\.py)`', self.problem_statement or '')
-        if match:
-            return match.group(1)
-        for root, dirs, files in os.walk(self.git_tempdir):
-            dirs[:] = [d for d in dirs if not d.startswith('.')]
-            for name in sorted(files):
-                if not name.endswith('.py'):
-                    continue
-                full = os.path.join(root, name)
-                try:
-                    with open(full, errors='replace') as f:
-                        text = f.read()
-                    tree = ast.parse(text)
