-    def _current_verification(self, msg_history):
-        """
-        Authoritative state: the direct sample run on the file if possible, otherwise the
-        run_samples result in the history. Returns (failed, excerpt).
-        """
-        direct = self._direct_sample_check()
-        if direct is not None:
-            failed, report = direct
-            if failed:
-                return failed, report[-1500:]
-            perf = self._direct_perf_check()
-            if perf is not None and perf[0]:
-                return True, perf[1][-1500:]
-            return failed, report[-1500:]
-        ok, reason = self._validate_target()
-        if not ok:
-            return True, reason
-        example = self._direct_example_check()
-        if example is not None:
-            failed, report = example
-            return failed, report[-1500:]
-        return self._last_verification_failed(msg_history)
