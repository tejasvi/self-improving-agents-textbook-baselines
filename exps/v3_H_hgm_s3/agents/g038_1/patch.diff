-    def _direct_perf_check(self):
-        """
-        Run the performance check directly on the target program against the inputs in _PERF_DIR.
-        Only for program-style targets. Returns (failed, report), or None if there are no inputs.
-        """
-        path = self._target_path()
-        if not path or not os.path.isfile(path):
-            return None
-        if self._is_method_task(self._output_filename()):
-            return None
-        inputs = self._perf_input_files()
-        if not inputs:
-            return None
-        try:
-            from tools.perf_check import tool_function as perf_check
-            report = perf_check(path, inputs, time_limit=3)
-        except Exception as e:
-            safe_log(f"[forward] direct perf check failed: {type(e).__name__}: {e}", level=logging.WARNING)
-            return None
-        failed = 'PERF FAIL' in report or 'TIMEOUT' in report or 'RUNTIME ERROR' in report
-        return failed, report
