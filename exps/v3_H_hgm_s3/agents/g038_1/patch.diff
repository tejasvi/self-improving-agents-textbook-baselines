-            if new_history and self._is_degenerate_assistant(new_history[-1]):
-                safe_log("[safe_chat] empty assistant turn returned by chat_with_agent; retrying once with a shortened prompt",
-                         level=logging.WARNING)
-                short_prompt = self._shortened_prompt(msg)
-                retry_history = chat_with_agent(short_prompt, model=self.code_model,
-                                                msg_history=self._sanitize_history(history),
-                                                logging=safe_log)
-                if retry_history and not self._is_degenerate_assistant(retry_history[-1]):
-                    return retry_history
-                safe_log("[safe_chat] shortened retry still degenerate", level=logging.WARNING)
-                return retry_history or new_history
-            elif len(new_history) <= len(history):
