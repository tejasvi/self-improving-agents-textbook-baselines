index 0000000..498cdc2
--- /dev/null
+++ b/tools/bench_method.py
@@ -0,0 +1,150 @@
+import os
+import subprocess
+import sys
+import time
+
+
+# Runs in a child process. argv: module_path, class_name, method_name ('' = infer).
+# stdin: a Python expression evaluating to a kwargs dict for the method.
+# Prints 'ELAPSED <seconds>' after the method call on success.
+_RUNNER = r'''
+import importlib.util
+import inspect
+import sys
+import time
+
+module_path, class_name, method_name = sys.argv[1], sys.argv[2], sys.argv[3]
+expr = sys.stdin.read()
+
+spec = importlib.util.spec_from_file_location('candidate_solution_module', module_path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+cls = getattr(module, class_name)
+
+if not method_name:
+    methods = [n for n, m in inspect.getmembers(cls, predicate=inspect.isfunction) if not n.startswith('_')]
+    if len(methods) != 1:
+        raise ValueError('cannot infer method name, candidates: %r' % (methods,))
+    method_name = methods[0]
+
+kwargs = eval(expr, {'__builtins__': __builtins__})
+if not isinstance(kwargs, dict):
+    raise TypeError('argument expression must evaluate to a dict of keyword arguments')
+
+obj = cls()
+fn = getattr(obj, method_name)
+start = time.perf_counter()
+result = fn(**kwargs)
+elapsed = time.perf_counter() - start
+print('ELAPSED %.4f' % elapsed)
+print('RESULT_TYPE %s' % type(result).__name__)
+'''
+
+
+def tool_info():
+    return {
+        'name': 'bench_method',
+        'description': (
+            'Performance check for method-style solutions (a `Solution` class method). Imports the Python file, '
+            'instantiates the class and calls the method on max-size arguments, each case in its own subprocess '
+            'with a per-case time limit. Each arg_builders entry is a Python expression that evaluates to a dict of '
+            'keyword arguments, e.g. "{\'s\': \'ab\' * 10000}" or "{\'n\': 20000, \'edges\': [[i, i + 1] for i in range(19999)]}". '
+            'Reports "case i: OK <seconds>", "TIMEOUT", or "ERROR <traceback tail>" per case, then a final summary '
+            'line: "ALL PERF OK" or "<N> PERF FAIL(S)". Use it on maximum-size, worst-case arguments derived from the '
+            'problem constraints.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'module_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python file that defines the class (e.g. the solution file).',
+                },
+                'class_name': {
+                    'type': 'string',
+                    'description': 'Name of the class to instantiate. Defaults to "Solution".',
+                },
+                'method_name': {
+                    'type': 'string',
+                    'description': 'Name of the method to benchmark. If omitted, the single public method of the class is used.',
+                },
+                'arg_builders': {
+                    'type': 'array',
+                    'items': {
+                        'type': 'string',
+                        'description': (
+                            'A Python expression evaluating to a dict of keyword arguments for the method, '
+                            'e.g. "{\'s\': \'ab\' * 10000}". Build max-size inputs derived from the constraints.'
+                        ),
+                    },
+                    'description': 'List of argument expressions, one benchmark case per entry.',
+                },
+                'time_limit': {
+                    'type': 'number',
+                    'description': 'Time limit in seconds per case. Defaults to 3.',
+                },
+            },
+            'required': ['module_path', 'arg_builders'],
+        },
+    }
+
+
+def _tail(text, n=600):
+    return (text or '').strip()[-n:]
+
+
+def tool_function(module_path, arg_builders, class_name='Solution', method_name=None, time_limit=3):
+    class_name = class_name or 'Solution'
+    method_name = method_name or ''
+    time_limit = float(time_limit) if time_limit is not None else 3.0
+    if isinstance(arg_builders, str):
+        arg_builders = [arg_builders]
+    arg_builders = list(arg_builders or [])[:50]
+    if not arg_builders:
+        return 'No arg_builders given.'
+    if not module_path or not os.path.isfile(module_path):
+        return f'Module file not found: {module_path}'
+
+    lines = []
+    failures = 0
+    for i, expr in enumerate(arg_builders):
+        label = f'case {i}'
+        start = time.perf_counter()
+        try:
+            proc = subprocess.run(
+                [sys.executable, '-c', _RUNNER, module_path, class_name, method_name],
+                input=str(expr).encode(),
+                capture_output=True,
+                timeout=time_limit,
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f'{label}: TIMEOUT (>{time_limit:g}s)')
+            failures += 1
+            continue
+        wall = time.perf_counter() - start
+
+        stdout = proc.stdout.decode(errors='replace')
+        stderr = proc.stderr.decode(errors='replace')
+        elapsed = None
+        for out_line in stdout.splitlines():
+            if out_line.startswith('ELAPSED '):
+                try:
+                    elapsed = float(out_line.split()[1])
+                except (IndexError, ValueError):
+                    elapsed = None
+        if proc.returncode != 0 or elapsed is None:
+            lines.append(f'{label}: ERROR (exit code {proc.returncode})')
+            lines.append(f'traceback: {_tail(stderr)}')
+            failures += 1
+            continue
+        if elapsed > time_limit:
+            lines.append(f'{label}: TIMEOUT (method took {elapsed:.2f}s > {time_limit:g}s)')
+            failures += 1
+            continue
+        lines.append(f'{label}: OK {elapsed:.2f}s (wall {wall:.2f}s)')
+
+    if failures:
+        lines.append(f'{failures} PERF FAIL(S)')
+    else:
+        lines.append('ALL PERF OK')
+    return '\n'.join(lines)
