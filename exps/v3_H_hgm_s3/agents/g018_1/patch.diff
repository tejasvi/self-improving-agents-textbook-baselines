+    def _call_with_backends(self, prompt, history):
+        """
+        Try (model, mode) configurations in order and return the first usable message history.
+        mode 'tools': agentic chat_with_agent call with tool use.
+        mode 'plain': tool-less completion; the prompt and reply are appended as text turns.
+        A configuration is skipped on exception, on a degenerate (empty) reply, or on no new messages.
+        Returns (new_history, model, mode), or (sanitized input history, None, None) if all fail.
+        """
+        base = self._sanitize_history(history)
+        backends = [(CLAUDE_MODEL, 'tools'), (OPENAI_MODEL, 'tools'), (CLAUDE_MODEL, 'plain')]
+        seen = set()
+        for model, mode in backends:
+            if (model, mode) in seen:
+                continue
+            seen.add((model, mode))
+            try:
+                if mode == 'tools':
+                    new_history = chat_with_agent(prompt, model=model, msg_history=base, logging=safe_log)
+                elif mode == 'plain':
+                    client, client_model = create_client(model)
+                    reply = self._plain_llm_text(
+                        client, client_model,
+                        "You are a coding assistant solving a competitive programming task.",
+                        prompt,
+                    )
+                    if not reply or not reply.strip():
+                        raise ValueError("empty plain reply")
+                    new_history = base + [
+                        {"role": "user", "content": [{"type": "text", "text": prompt}]},
+                        {"role": "assistant", "content": [{"type": "text", "text": reply}]},
+                    ]
+                else:
+                    continue
+                if new_history is None:
+                    raise ValueError("returned None")
+                if new_history and self._is_degenerate_assistant(new_history[-1]):
+                    raise ValueError("degenerate assistant turn")
+                if len(new_history) <= len(base):
+                    raise ValueError("no messages added")
+                safe_log(f"[backends] using model={model} mode={mode}")
+                return new_history, model, mode
+            except Exception as e:
+                safe_log(f"[backends] {model}/{mode} failed: {type(e).__name__}: {e}", level=logging.WARNING)
+        return base, None, None
+
