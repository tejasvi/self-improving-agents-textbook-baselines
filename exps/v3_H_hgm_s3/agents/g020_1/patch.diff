diff --git a/tools/variant_search.py b/tools/variant_search.py
new file mode 100644
index 0000000..e97b71e
--- /dev/null
+++ b/tools/variant_search.py
@@ -0,0 +1,124 @@
+import subprocess
+
+try:
+    from tools.run_samples import SAMPLE_RE
+except ImportError:  # executed outside the package
+    import os
+    import sys
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    from run_samples import SAMPLE_RE
+
+SAMPLE_TIMEOUT = 10
+
+
+def tool_info():
+    return {
+        'name': 'variant_search',
+        'description': (
+            'For multi-answer problems whose samples differ from your output. Give several candidate solution '
+            'files (construction variants, e.g. different orderings, tie-breaking, free-variable choices, bit '
+            'orders, reversed indices). Each candidate is run on every "Sample Input N" block of problem_text '
+            'and compared with the expected sample output using whitespace-token normalisation. Reports, per '
+            'candidate, how many samples match exactly, the samples that differ, and a final line naming the '
+            'BEST candidate (or "ALL SAMPLES EXACT MATCH by <path>"). For the best candidate the first differing '
+            'sample shows expected and actual output.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_paths': {
+                    'type': 'array',
+                    'items': {
+                        'type': 'string',
+                        'description': 'Path to one candidate Python solution file (reads stdin, writes stdout).',
+                    },
+                    'description': 'List of candidate solution file paths to compare against the sample outputs.',
+                },
+                'problem_text': {
+                    'type': 'string',
+                    'description': 'The full problem statement containing "Sample Input N" / "Sample Output N" blocks.',
+                },
+                'python': {
+                    'type': 'string',
+                    'description': 'Python interpreter to use. Defaults to python3.',
+                },
+            },
+            'required': ['solution_paths', 'problem_text'],
+        },
+    }
+
+
+def _norm(text):
+    return (text or '').split()
+
+
+def _run(python, path, inp_text):
+    """Returns (stdout, None) on success or (None, error_description)."""
+    try:
+        proc = subprocess.run(
+            [python, path],
+            input=inp_text,
+            capture_output=True,
+            text=True,
+            timeout=SAMPLE_TIMEOUT,
+        )
+    except subprocess.TimeoutExpired:
+        return None, f'timeout after {SAMPLE_TIMEOUT}s'
+    if proc.returncode != 0:
+        return None, f'runtime error, exit code {proc.returncode}: {proc.stderr.strip()[-300:]}'
+    return proc.stdout, None
+
+
+def tool_function(solution_paths, problem_text, python='python3'):
+    python = python or 'python3'  # optional arg may arrive as None
+    if isinstance(solution_paths, str):
+        solution_paths = [solution_paths]
+    solution_paths = [p for p in (solution_paths or []) if p]
+    if not solution_paths:
+        return 'No candidate solution_paths given.'
+
+    pairs = SAMPLE_RE.findall(problem_text or '')
+    if not pairs:
+        return 'No "Sample Input N" / "Sample Output N" pairs found in problem_text.'
+    n = len(pairs)
+
+    lines = []
+    results = []  # (matched, path, first_diff_info)
+    for path in solution_paths:
+        differ = []
+        first_diff = None
+        matched = 0
+        for idx, inp, expected in pairs:
+            inp_text = inp.strip('\n') + '\n'
+            got, err = _run(python, path, inp_text)
+            if err is not None:
+                differ.append(f'{idx} ({err})')
+                if first_diff is None:
+                    first_diff = (idx, expected, f'<{err}>')
+                continue
+            if _norm(got) == _norm(expected):
+                matched += 1
+            else:
+                differ.append(str(idx))
+                if first_diff is None:
+                    first_diff = (idx, expected, got)
+        if differ:
+            detail = ', '.join(differ)
+            lines.append(f'{path}: matched {matched}/{n} exact (samples that differ: {detail})')
+        else:
+            lines.append(f'{path}: matched {n}/{n} exact')
+        results.append((matched, path, first_diff))
+
+    exact = [r for r in results if r[0] == n]
+    if exact:
+        lines.append(f'ALL SAMPLES EXACT MATCH by {exact[0][1]}')
+    else:
+        # max() keeps the first candidate on ties, so the earliest listed variant wins.
+        best_matched, best_path, best_diff = max(results, key=lambda r: r[0])
+        lines.append(f'BEST: {best_path} {best_matched}/{n}')
+        if best_diff is not None:
+            idx, expected, got = best_diff
+            lines.append(f'first differing sample for BEST: Sample {idx}')
+            lines.append(f'expected: {expected.strip()}')
+            lines.append(f'got: {(got or "").strip()}')
+    return '\n'.join(lines)
