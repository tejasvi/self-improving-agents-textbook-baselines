+++ b/tools/run_samples.py
@@ -0,0 +1,210 @@
+import os
+import re
+import signal
+import subprocess
+
+SAMPLE_TIMEOUT = 10  # seconds per sample run
+
+# Heading patterns, all case-insensitive. Each captures (kind, index) where kind is 'input' or 'output'.
+# Accepts e.g. "Sample Input 1", "Sample Output 2:", "### Input", "Example 1 Input", "**Sample Input 1**",
+# "Input 1", "Example Output", "Sample Input 1: 3 4" (content on the same line after the colon).
+_HEADING_PATTERNS = [
+    # Sample Input 1 / Example Input 1 / Input 1 / Sample Input / Input
+    re.compile(
+        r'^\s*[#*_`>\s]*(?:sample|example|test)?\s*(input|output)\s*(\d+)?\s*[:.)\-]?\s*[*_`]*\s*(?::\s*(.*))?$',
+        re.IGNORECASE),
+    # Example 1 Input / Sample 1 Output / Example 1: Input
+    re.compile(
+        r'^\s*[#*_`>\s]*(?:sample|example|test)\s*(\d+)?\s*[:.\-]?\s*(input|output)\s*[:.]?\s*[*_`]*\s*$',
+        re.IGNORECASE),
+]
+
+
+_GENERIC_HEADING = re.compile(
+    r'^[#*_`>\s]*(?:sample|example|test)\s*\d*\s*[:.]?\s*[*_`]*\s*$', re.IGNORECASE)
+
+
+def tool_info():
+    return {
+        "name": "run_samples",
+        "description": """Parse the sample test cases ('Sample Input k' / 'Sample Output k', or 'Input'/'Output'/'Example' variants) from a problem statement and run a command on each sample input.
+
+* For every sample it reports PASS or FAIL. Comparison is exact after stripping trailing whitespace on each line.
+* For each sample it returns the expected output, the actual stdout, and stderr. Raw results are returned without any interpretation.
+* Use it after writing the solution, with the full problem statement text as problem_text and e.g. 'python3 solution.py' as command.
+* A FAIL means the output differs from the expected sample output. Treat it as a real problem to investigate (the grader likely compares output exactly).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_text": {
+                    "type": "string",
+                    "description": "The full problem statement text containing the sample inputs and outputs."
+                },
+                "command": {
+                    "type": "string",
+                    "description": "The shell command that runs the solution, reading stdin and writing stdout, e.g. 'python3 solution.py'."
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Optional working directory in which to run the command. Defaults to the current directory."
+                }
+            },
+            "required": ["problem_text", "command"]
+        }
+    }
+
+
+def _match_heading(line):
+    """Return (kind, index_or_None, inline_text) if the line is a sample heading, else None."""
+    stripped = line.strip()
+    if not stripped:
+        return None
+    for pattern_idx, pattern in enumerate(_HEADING_PATTERNS):
+        m = pattern.match(stripped)
+        if not m:
+            continue
+        if pattern_idx == 0:
+            kind, num, inline = m.group(1), m.group(2), m.group(3)
+            # Bare 'Input'/'Output' lines are only headings if they are short, to avoid matching prose.
+            if num is None and not re.search(r'(sample|example|test)', stripped, re.IGNORECASE):
+                if len(stripped) > 40:
+                    return None
+        else:
+            num, kind, inline = m.group(1), m.group(2), None
+        kind = kind.lower()
+        index = int(num) if num else None
+        return kind, index, (inline.strip() if inline else None)
+    return None
+
+
+def _parse_samples(problem_text):
+    """
+    Parse sample pairs from problem text.
+    Returns a list of (index, input_text, output_text) sorted by index. Missing parts are None.
+    """
+    lines = problem_text.splitlines()
+    blocks = {'input': {}, 'output': {}}  # kind -> index -> list of lines
+    counters = {'input': 0, 'output': 0}
+    current = None  # (kind, index)
+
+    for line in lines:
+        if re.match(r'^\s*</?\w*problem', line):
+            current = None
+            continue
+        if _GENERIC_HEADING.match(line.strip()):
+            # e.g. 'Example 3' or 'Sample 2:' with no input/output word ends the current block.
+            current = None
+            continue
+        heading = _match_heading(line)
+        if heading is not None:
+            kind, index, inline = heading
+            if index is None:
+                counters[kind] += 1
+                index = counters[kind]
+            else:
+                counters[kind] = max(counters[kind], index)
+            blocks[kind].setdefault(index, [])
+            if inline:
+                blocks[kind][index].append(inline)
+            current = (kind, index)
+            continue
+        if current is not None:
+            # A markdown fence or a blank line before content is fine; keep everything else.
+            if line.strip().startswith('```'):
+                continue
+            blocks[current[0]][current[1]].append(line)
+
+    samples = []
+    indices = sorted(set(blocks['input']) | set(blocks['output']))
+    for idx in indices:
+        inp = blocks['input'].get(idx)
+        out = blocks['output'].get(idx)
+        inp_text = _clean_block(inp) if inp is not None else None
+        out_text = _clean_block(out) if out is not None else None
+        if inp_text is None and out_text is None:
+            continue
+        samples.append((idx, inp_text, out_text))
+    return samples
+
+
+def _clean_block(lines):
+    """Strip leading/trailing blank lines and trailing whitespace on each line."""
+    lines = [l.rstrip() for l in lines]
+    while lines and not lines[0].strip():
+        lines.pop(0)
+    while lines and not lines[-1].strip():
+        lines.pop()
+    return '\n'.join(lines) + '\n' if lines else ''
+
+
+def _normalize(text):
+    """Trailing whitespace per line removed, and trailing blank lines removed."""
+    lines = [l.rstrip() for l in text.splitlines()]
+    while lines and not lines[-1]:
+        lines.pop()
+    return '\n'.join(lines)
+
+
+def _run_one(command, stdin_text, cwd):
+    proc = subprocess.Popen(
+        command,
+        shell=True,
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        cwd=cwd,
+        text=True,
+        start_new_session=True,  # so the whole process group can be killed on timeout
+    )
+    try:
+        out, err = proc.communicate(input=stdin_text, timeout=SAMPLE_TIMEOUT)
+        return out, err, None
+    except subprocess.TimeoutExpired:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            proc.kill()
+        out, err = proc.communicate()
+        return out or '', err or '', f"TIMEOUT after {SAMPLE_TIMEOUT}s"
+
+
+def tool_function(problem_text, command, cwd=None):
+    samples = _parse_samples(problem_text)
+    if not samples:
+        return ("No sample input/output pairs were found in the problem text. "
+                "Check the statement manually and create your own small tests.")
+
+    if cwd is not None and not os.path.isdir(cwd):
+        return f"Error: cwd '{cwd}' does not exist or is not a directory."
+
+    lines = []
+    passed = 0
+    total = 0
+    for idx, inp, out in samples:
+        if inp is None or out is None:
+            missing = 'input' if inp is None else 'output'
+            lines.append(f"Sample {idx}: SKIPPED (missing sample {missing} block in problem text)")
+            lines.append("")
+            continue
+        total += 1
+        actual_raw, stderr, problem = _run_one(command, inp, cwd)
+        expected = _normalize(out)
+        actual = _normalize(actual_raw)
+        ok = problem is None and expected == actual
+        if ok:
+            passed += 1
+        status = 'PASS' if ok else 'FAIL'
+        lines.append(f"Sample {idx}: {status}" + (f" ({problem})" if problem else ""))
+        lines.append("--- input ---")
+        lines.append(inp.rstrip('\n'))
+        lines.append("--- expected output ---")
+        lines.append(expected)
+        lines.append("--- actual output ---")
+        lines.append(actual)
+        lines.append("--- stderr ---")
+        lines.append(stderr.rstrip())
+        lines.append("")
+
+    lines.insert(0, f"Passed {passed}/{total} samples.")
+    lines.insert(1, "")
+    return '\n'.join(lines)
