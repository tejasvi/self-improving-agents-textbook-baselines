+    @staticmethod
+    def _check_imports(text):
+        """
+        Top-level module names imported by text that are not available: not in the standard library
+        (sys.stdlib_module_names on Python 3.10+) and not findable by importlib. Returns a sorted list.
+        """
+        try:
+            tree = ast.parse(text)
+        except SyntaxError:
+            return []
+        names = set()
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for alias in node.names:
+                    names.add(alias.name.split('.')[0])
+            elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+                names.add(node.module.split('.')[0])
+        stdlib = getattr(sys, 'stdlib_module_names', None)
+        missing = []
+        for name in sorted(names):
+            if name == '__future__' or name in sys.builtin_module_names:
+                continue
+            if stdlib is not None:
+                if name in stdlib:
+                    continue
+            else:
+                try:
+                    if importlib.util.find_spec(name) is not None:
+                        continue
+                except (ImportError, ValueError):
+                    pass
+            missing.append(name)
+        return missing
+
