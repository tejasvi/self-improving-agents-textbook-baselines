+# A line that starts with '? ' is an interactive query printed to stdout.
+_QUERY_RE = re.compile(r'(?m)^\? ')
+
+
+def is_interactive_failure(stdout_text, returncode):
+    """
+    True if the program printed a '?' query to stdout and then exited with an error. This is the usual
+    signature of an interactive solution run on a static file: after its first query it reads an empty
+    stdin (EOF) and crashes. Such a run cannot be judged by piping a file.
+    """
+    return returncode != 0 and bool(_QUERY_RE.search(stdout_text or ''))
+
+
+INTERACTIVE_MSG = 'INTERACTIVE PROGRAM: cannot be driven by file input'
+
