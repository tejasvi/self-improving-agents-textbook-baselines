diff --git a/tools/interactive_judge.py b/tools/interactive_judge.py
new file mode 100644
index 0000000..a83d0d0
--- /dev/null
+++ b/tools/interactive_judge.py
@@ -0,0 +1,179 @@
+import importlib.util
+import os
+import queue
+import subprocess
+import threading
+
+
+def tool_info():
+    return {
+        'name': 'interactive_judge',
+        'description': (
+            'Run an interactive-problem solution against an independent judge module. The judge file must define '
+            'gen(seed) -> first_line (the initial input line(s) as a string, may be empty), '
+            'respond(query_line) -> reply (the reply string to send back to the solution, or None if the query is '
+            'invalid), and final(answer_line) -> "ok" or an error string. For seed = 1..iterations the solution is '
+            'spawned as a subprocess with pipes, the judge feeds the input and replies to each query line the '
+            'solution prints, and each read has a timeout so hangs are reported. The number of queries is counted. '
+            'Returns the first failing seed with the transcript, or "ALL OK". Pass absolute paths.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to the solution Python file (reads stdin, writes stdout).',
+                },
+                'judge_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to the judge Python file defining gen, respond and final.',
+                },
+                'iterations': {
+                    'type': 'integer',
+                    'description': 'Number of seeds to test (seeds 1..iterations). Defaults to 100.',
+                },
+                'timeout': {
+                    'type': 'number',
+                    'description': 'Timeout in seconds for each read from the solution. Defaults to 5.',
+                },
+            },
+            'required': ['solution_path', 'judge_path'],
+        },
+    }
+
+
+def _load_judge(judge_path):
+    spec = importlib.util.spec_from_file_location('interactive_judge_module', judge_path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    for name in ('gen', 'respond', 'final'):
+        if not callable(getattr(module, name, None)):
+            raise AttributeError(f'judge module must define callable {name}')
+    return module
+
+
+def _reader(stream, out_q):
+    # Pushes each line from the solution's stdout onto a queue; ends with None at EOF.
+    for line in iter(stream.readline, ''):
+        out_q.put(line)
+    out_q.put(None)
+
+
+def _read_line(out_q, timeout):
+    try:
+        return out_q.get(timeout=timeout)
+    except queue.Empty:
+        return 'TIMEOUT'
+
+
+def _run_one(solution_path, judge, seed, timeout, max_queries):
+    """Play one interaction. Returns (ok, message, transcript)."""
+    transcript = []
+    try:
+        first = judge.gen(seed)
+    except Exception as e:
+        return False, f'judge gen failed: {type(e).__name__}: {e}', transcript
+    first = '' if first is None else str(first)
+    if first and not first.endswith('\n'):
+        first += '\n'
+
+    proc = subprocess.Popen(
+        ['python3', solution_path],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        text=True, bufsize=1,
+    )
+    out_q = queue.Queue()
+    reader = threading.Thread(target=_reader, args=(proc.stdout, out_q), daemon=True)
+    reader.start()
+    stderr_chunks = []
+    err_thread = threading.Thread(target=lambda: stderr_chunks.append(proc.stderr.read()), daemon=True)
+    err_thread.start()
+
+    def finish(ok, msg):
+        if proc.poll() is None:
+            proc.kill()
+        proc.wait()
+        return ok, msg, transcript
+
+    def stderr_tail():
+        err_thread.join(timeout=1)
+        return (stderr_chunks[0] if stderr_chunks else '').strip()[-500:]
+
+    try:
+        if first:
+            proc.stdin.write(first)
+            proc.stdin.flush()
+        queries = 0
+        # Bounded: at most max_queries + 1 rounds of query/answer exchange.
+        for _ in range(max_queries + 2):
+            line = _read_line(out_q, timeout)
+            if line == 'TIMEOUT':
+                return finish(False, f'solution produced no output within {timeout}s (hang or waiting)')
+            if line is None:
+                # Solution closed stdout: it should have sent its final answer, handled below.
+                break
+            line = line.rstrip('\n')
+            transcript.append(('solution', line))
+            if line.strip() == '':
+                continue
+            head = line.split()[0]
+            if head == '?' or head.startswith('?'):
+                queries += 1
+                if queries > max_queries:
+                    return finish(False, f'query limit exceeded: more than {max_queries} queries')
+                reply = judge.respond(line)
+                if reply is None:
+                    return finish(False, f'judge rejected malformed query: {line!r}')
+                reply = str(reply)
+                transcript.append(('judge', reply))
+                proc.stdin.write(reply if reply.endswith('\n') else reply + '\n')
+                proc.stdin.flush()
+                continue
+            # Not a query: treat as the final answer.
+            verdict = judge.final(line)
+            if verdict == 'ok' or verdict is True:
+                return finish(True, 'ok')
+            return finish(False, f'wrong answer {line!r}: {verdict}')
+        # Stdout ended without a final answer.
+        proc.wait(timeout=timeout)
+        return finish(False, f'solution exited without a final answer (exit code {proc.returncode}) '
+                             f'stderr: {stderr_tail()}')
+    except BrokenPipeError:
+        return finish(False, f'solution closed its input early (exit code {proc.poll()}) stderr: {stderr_tail()}')
+    except subprocess.TimeoutExpired:
+        return finish(False, f'solution did not exit within {timeout}s after final answer')
+
+
+def _format_transcript(transcript):
+    return '\n'.join(f'{who}: {text}' for who, text in transcript) or '(empty)'
+
+
+def tool_function(solution_path, judge_path, iterations=100, timeout=5):
+    try:
+        iterations = int(iterations) if iterations is not None else 100
+    except (TypeError, ValueError):
+        iterations = 100
+    try:
+        timeout = float(timeout) if timeout is not None else 5.0
+    except (TypeError, ValueError):
+        timeout = 5.0
+    for label, path in (('solution_path', solution_path), ('judge_path', judge_path)):
+        if not path or not os.path.isabs(path) or not os.path.isfile(path):
+            return f'ERROR: {label} must be an existing absolute file path (got {path!r}).'
+    try:
+        judge = _load_judge(judge_path)
+    except Exception as e:
+        return f'ERROR: could not load judge {judge_path}: {type(e).__name__}: {e}'
+
+    max_queries = getattr(judge, 'MAX_QUERIES', 10000)
+    try:
+        max_queries = int(max_queries)
+    except (TypeError, ValueError):
+        max_queries = 10000
+
+    for seed in range(1, iterations + 1):
+        ok, msg, transcript = _run_one(solution_path, judge, seed, timeout, max_queries)
+        if not ok:
+            return (f'FAILED at seed {seed}: {msg}\n'
+                    f'transcript:\n{_format_transcript(transcript)}')
+    return 'ALL OK'
