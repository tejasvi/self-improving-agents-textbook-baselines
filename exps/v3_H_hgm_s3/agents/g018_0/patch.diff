diff --git a/tools/perf_check.py b/tools/perf_check.py
new file mode 100644
index 0000000..c12d839
--- /dev/null
+++ b/tools/perf_check.py
@@ -0,0 +1,118 @@
+import os
+import subprocess
+import time
+
+try:
+    import resource
+except ImportError:  # not available on Windows
+    resource = None
+
+
+def tool_info():
+    return {
+        'name': 'perf_check',
+        'description': (
+            'Performance / scale check. Runs a Python solution file (reads stdin, writes stdout) on each given '
+            'input file with a per-input time limit, and reports the wall time per input. Reports "OK <seconds>", '
+            '"TIMEOUT" (limit exceeded), or "RUNTIME ERROR" (with the stderr tail) for each input, then a final '
+            'summary line: "ALL PERF OK" or "<N> PERF FAIL(S)". Use it on maximum-size inputs (worst cases at the '
+            'largest constraints) to confirm the solution finishes within the time limit.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python solution file (reads stdin, writes stdout).',
+                },
+                'input_paths': {
+                    'type': 'array',
+                    'items': {
+                        'type': 'string',
+                        'description': 'Absolute path to one input file.',
+                    },
+                    'description': 'Absolute paths of the input files to run the solution on (e.g. max-size inputs).',
+                },
+                'time_limit': {
+                    'type': 'number',
+                    'description': 'Time limit in seconds per input. Defaults to 3.',
+                },
+                'python': {
+                    'type': 'string',
+                    'description': 'Optional Python interpreter to use. Defaults to python3.',
+                },
+            },
+            'required': ['solution_path', 'input_paths'],
+        },
+    }
+
+
+def _max_rss_mb():
+    """Peak RSS of all waited-for children so far, in MB, or None if unavailable."""
+    if resource is None:
+        return None
+    try:
+        rss = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+    except Exception:
+        return None
+    # ru_maxrss is in KB on Linux and bytes on macOS.
+    return rss / 1024.0 if os.uname().sysname == 'Linux' else rss / (1024.0 * 1024.0)
+
+
+def _tail(text, n=600):
+    text = (text or '').strip()
+    return text[-n:]
+
+
+def tool_function(solution_path, input_paths, time_limit=3, python='python3'):
+    python = python or 'python3'  # optional arg may arrive as None
+    time_limit = float(time_limit) if time_limit is not None else 3.0
+    if isinstance(input_paths, str):
+        input_paths = [input_paths]
+    input_paths = list(input_paths or [])
+    if not input_paths:
+        return 'No input_paths given.'
+    if not os.path.isfile(solution_path):
+        return f'Solution file not found: {solution_path}'
+
+    lines = []
+    failures = 0
+    for path in input_paths:
+        label = f'input {path}'
+        try:
+            with open(path, 'rb') as f:
+                data = f.read()
+        except OSError as e:
+            lines.append(f'{label}: ERROR cannot read input file ({e})')
+            failures += 1
+            continue
+
+        start = time.perf_counter()
+        try:
+            proc = subprocess.run(
+                [python, solution_path],
+                input=data,
+                capture_output=True,
+                timeout=time_limit,
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f'{label}: TIMEOUT (>{time_limit:g}s)')
+            failures += 1
+            continue
+        elapsed = time.perf_counter() - start
+
+        mem = _max_rss_mb()
+        mem_str = f', peak child RSS {mem:.0f}MB' if mem is not None else ''
+        if proc.returncode != 0:
+            stderr = proc.stderr.decode(errors='replace')
+            lines.append(f'{label}: RUNTIME ERROR (exit code {proc.returncode}) after {elapsed:.2f}s{mem_str}')
+            lines.append(f'stderr: {_tail(stderr)}')
+            failures += 1
+            continue
+        lines.append(f'{label}: OK {elapsed:.2f}s{mem_str}')
+
+    if failures:
+        lines.append(f'{failures} PERF FAIL(S)')
+    else:
+        lines.append('ALL PERF OK')
+    return '\n'.join(lines)
