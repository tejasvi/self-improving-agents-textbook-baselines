+    def _has_source_edits(self):
+        """
+        Return True if the diff versus base_commit touches at least one non-test file.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_files = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git a/'):
+                # Format: 'diff --git a/X b/X'
+                rest = line[len('diff --git a/'):]
+                parts = rest.rsplit(' b/', 1)
+                changed_files.append(parts[0] if len(parts) == 2 else rest)
+        for path in changed_files:
+            if not self._is_test_file(path):
+                return True
+        return False
+
+    @staticmethod
+    def _is_test_file(path):
+        lowered = path.lower()
+        basename = lowered.rsplit('/', 1)[-1]
+        if '/tests/' in '/' + lowered or '/test/' in '/' + lowered:
+            return True
+        if basename.startswith('test_'):
+            return True
+        test_suffixes = (
+            '_test.py', '_test.go', '.spec.js', '.spec.ts', '.test.js', '.test.ts',
+            'test.java', '_test.cpp', '_test.cc', '_test.rs', 'tests.java',
+        )
+        return basename.endswith(test_suffixes)
+
