+import ast
+import json
+import os
+import subprocess
+import sys
+import time
+
+# Runs inside a fresh subprocess for every case, so a hang or crash is killed by the timeout
+# and cannot take down the caller. Reads one JSON request from stdin, writes one JSON reply.
+_RUNNER = r'''
+import importlib.util, inspect, json, sys, traceback
+
+req = json.loads(sys.stdin.read())
+
+def _to_jsonable(v):
+    if isinstance(v, tuple):
+        return [_to_jsonable(x) for x in v]
+    if isinstance(v, list):
+        return [_to_jsonable(x) for x in v]
+    if isinstance(v, dict):
+        return {str(k): _to_jsonable(x) for k, x in v.items()}
+    if isinstance(v, (set, frozenset)):
+        return sorted((_to_jsonable(x) for x in v), key=repr)
+    if v is None or isinstance(v, (bool, int, float, str)):
+        return v
+    return repr(v)
+
+try:
+    spec = importlib.util.spec_from_file_location('candidate_solution_module', req['module_path'])
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    cls = getattr(module, req['class_name'])
+    method = req['method_name']
+    if not method:
+        names = [n for n, m in inspect.getmembers(cls, predicate=inspect.isfunction) if not n.startswith('_')]
+        if len(names) != 1:
+            raise ValueError('cannot infer method name, candidates: %r' % (names,))
+        method = names[0]
+    obj = cls()
+    result = getattr(obj, method)(*req['args'], **req['kwargs'])
+    print(json.dumps({'ok': True, 'got': _to_jsonable(result)}))
+except Exception:
+    print(json.dumps({'ok': False, 'error': traceback.format_exc()[-800:]}))
+'''
+
+
+def tool_info():
+    return {
+        'name': 'method_check',
+        'description': (
+            'Check a method-style solution (a `Solution` class method) on explicit test cases, including '
+            'max-size performance inputs. Each case runs in its own subprocess with a hard time limit, so a '
+            'slow or hanging solution is reported as TIMEOUT instead of blocking. Reports PASS, WRONG '
+            '(input, expected, got), TIMEOUT or ERROR for each case with its elapsed time, then a summary line '
+            '"ALL CASES OK" or "N FAILED". Cases given without an expected value are only timed and checked '
+            'for errors. Values are JSON: use lists for Python lists/tuples, and strings for strings.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'module_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python file that defines the Solution class.',
+                },
+                'cases_json': {
+                    'type': 'string',
+                    'description': (
+                        'JSON list of cases. Each case is an object {"args": [...], "kwargs": {...}, '
+                        '"expected": value}; "args", "kwargs" and "expected" are optional, and omitting '
+                        '"expected" means the case is only run and timed. A bare non-object item is passed as '
+                        'the single positional argument.'
+                    ),
+                },
+                'method_name': {
+                    'type': 'string',
+                    'description': 'Name of the method to call. If omitted, the single public method of the class is used.',
+                },
+                'class_name': {
+                    'type': 'string',
+                    'description': 'Name of the class to instantiate. Defaults to "Solution".',
+                },
+                'time_limit': {
+                    'type': 'number',
+                    'description': 'Time limit in seconds per case. Defaults to 3.',
+                },
+            },
+            'required': ['module_path', 'cases_json'],
+        },
+    }
+
+
+def _normalize_case(item, idx):
+    """Return (args, kwargs, has_expected, expected, label) for one case item."""
+    if isinstance(item, dict):
+        args = item.get('args', [])
+        kwargs = item.get('kwargs', {})
+        if not isinstance(args, list):
+            args = [args]
+        if not isinstance(kwargs, dict):
+            raise ValueError(f'case {idx}: "kwargs" must be an object')
+        has_expected = 'expected' in item
+        return args, kwargs, has_expected, item.get('expected'), item
+    return [item], {}, False, None, item
+
+
+def _same(got, expected):
+    """Compare JSON-normalized values. Tuples already arrive as lists from the runner."""
+    if isinstance(expected, float) and isinstance(got, (int, float)) and not isinstance(got, bool):
+        return abs(got - expected) <= 1e-6 * max(1.0, abs(expected))
+    return got == expected
+
+
+def _tail(text, n=600):
+    return (text or '').strip()[-n:]
+
+
+def _run_case(module_path, class_name, method_name, args, kwargs, time_limit, python):
+    request = json.dumps({
+        'module_path': os.path.abspath(module_path),
+        'class_name': class_name,
+        'method_name': method_name,
+        'args': args,
+        'kwargs': kwargs,
+    })
+    start = time.perf_counter()
+    try:
+        proc = subprocess.run(
+            [python, '-c', _RUNNER],
+            input=request.encode(),
+            capture_output=True,
+            timeout=time_limit,
+        )
+    except subprocess.TimeoutExpired:
+        return 'TIMEOUT', None, time.perf_counter() - start, f'no result within {time_limit:g}s'
+    elapsed = time.perf_counter() - start
+
+    out = proc.stdout.decode(errors='replace').strip().splitlines()
+    reply = None
+    if out:
+        try:
+            reply = json.loads(out[-1])
+        except json.JSONDecodeError:
+            reply = None
+    if reply is None:
+        return 'ERROR', None, elapsed, f'exit code {proc.returncode}; stderr: {_tail(proc.stderr.decode(errors="replace"))}'
+    if not reply.get('ok'):
+        return 'ERROR', None, elapsed, reply.get('error', 'unknown error')
+    return 'OK', reply.get('got'), elapsed, ''
+
+
+def tool_function(module_path, cases_json, method_name=None, class_name='Solution', time_limit=3, python='python3'):
+    class_name = class_name or 'Solution'
+    time_limit = float(time_limit) if time_limit is not None else 3.0
+    python = python or 'python3'
+    if not os.path.isfile(module_path):
+        return f'Module file not found: {module_path}'
+    try:
+        cases = json.loads(cases_json) if isinstance(cases_json, str) else cases_json
+    except json.JSONDecodeError as e:
+        return f'ERROR: cases_json is not valid JSON: {e}'
+    if not isinstance(cases, list) or not cases:
+        return 'No cases given: cases_json must be a non-empty JSON list.'
+
+    lines = []
+    failures = 0
+    for idx, item in enumerate(cases, 1):
+        try:
+            args, kwargs, has_expected, expected, shown = _normalize_case(item, idx)
+        except ValueError as e:
+            lines.append(f'Case {idx}: ERROR bad case ({e})')
+            failures += 1
+            continue
+        shown_text = json.dumps(shown, default=repr)
+        if len(shown_text) > 300:
+            shown_text = shown_text[:300] + '...'
+
+        status, got, elapsed, detail = _run_case(
+            module_path, class_name, method_name, args, kwargs, time_limit, python)
+        timing = f'{elapsed:.2f}s'
+        if status == 'TIMEOUT':
+            lines.append(f'Case {idx}: TIMEOUT after {timing} (limit {time_limit:g}s) input: {shown_text}')
+            failures += 1
+        elif status == 'ERROR':
+            lines.append(f'Case {idx}: ERROR after {timing} input: {shown_text}')
+            lines.append(f'traceback: {detail}')
+            failures += 1
+        elif not has_expected:
+            lines.append(f'Case {idx}: OK {timing} (no expected value) got: {json.dumps(got)[:300]}')
+        elif _same(got, expected):
+            lines.append(f'Case {idx}: PASS {timing}')
+        else:
+            lines.append(f'Case {idx}: WRONG {timing}')
+            lines.append(f'input: {shown_text}')
+            lines.append(f'expected: {json.dumps(expected)[:300]}')
+            lines.append(f'got: {json.dumps(got)[:300]}')
+            failures += 1
+
+    if failures:
+        lines.append(f'{failures} FAILED')
+    else:
+        lines.append('ALL CASES OK')
+    return '\n'.join(lines)
