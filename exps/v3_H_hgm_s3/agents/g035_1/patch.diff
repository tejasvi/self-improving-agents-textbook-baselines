+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from tools.run_samples import tool_function, MULTI_HINT
+
+PROBLEM = """Print any of them.
+
+Sample Input 1
+3
+Sample Output 1
+1 2 3
+
+"""
+
+def _write(code):
+    fd, path = tempfile.mkstemp(suffix='.py')
+    with os.fdopen(fd, 'w') as f:
+        f.write(code)
+    return path
+
+def test_runtime_error_no_multi_hint():
+    path = _write("import numpy as np\nprint(1)\n")
+    report = tool_function(path, PROBLEM)
+    assert 'runtime error' in report
+    assert MULTI_HINT not in report
+    assert 'ModuleNotFoundError' in report or 'numpy' in report
+
+def test_timeout_no_multi_hint(monkeypatch):
+    import subprocess
+    import tools.run_samples as rs
+    def boom(*a, **k):
+        raise subprocess.TimeoutExpired(cmd='x', timeout=10)
+    monkeypatch.setattr(rs.subprocess, 'run', boom)
+    report = tool_function('ignored.py', PROBLEM)
+    assert 'timeout' in report
+    assert MULTI_HINT not in report
+
+def test_clean_differing_output_gets_multi_hint():
+    path = _write("print(3, 2, 1)\n")
+    report = tool_function(path, PROBLEM)
+    assert 'MISMATCH' in report
+    assert MULTI_HINT in report
+
+def test_exact_match_no_hint():
+    path = _write("print(1, 2, 3)\n")
+    report = tool_function(path, PROBLEM)
+    assert 'ALL SAMPLES EXACT MATCH' in report
+    assert MULTI_HINT not in report
