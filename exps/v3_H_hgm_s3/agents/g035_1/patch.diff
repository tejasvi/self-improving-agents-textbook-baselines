+import os
+import sys
+import logging
+import tempfile
+import subprocess
+import ast
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+import coding_agent as ca
+from coding_agent import AgenticSystem
+
+PROBLEM = """Write `solution.py`. Read n and print the sum.
+
+Sample Input 1
+3
+Sample Output 1
+6
+
+"""
+
+def make_repo(problem=PROBLEM):
+    d = tempfile.mkdtemp()
+    subprocess.run(['git', '-C', d, 'init', '-q'], check=True)
+    fname = os.path.join(d, 'solution.py')
+    with open(fname, 'w') as f:
+        f.write('# TODO: replace with a real solution\n')
+    subprocess.run(['git', '-C', d, 'add', '-A'], check=True)
+    subprocess.run(['git', '-C', d, '-c', 'user.email=a@b', '-c', 'user.name=t', 'commit', '-qm', 'base'], check=True)
+    base = subprocess.run(['git', '-C', d, 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
+    system = AgenticSystem.__new__(AgenticSystem)
+    system.problem_statement = problem
+    system.git_tempdir = d
+    system.base_commit = base
+    system.code_model = 'test'
+    return system, d
+
+# (b) import validator -------------------------------------------------------
+
+def test_missing_import_detected():
+    tree = ast.parse('import definitely_not_a_module_xyz\n')
+    assert AgenticSystem._missing_imports(tree) == ['definitely_not_a_module_xyz']
+
+def test_stdlib_import_ok():
+    tree = ast.parse('import os\nfrom collections import deque\nimport xml.etree.ElementTree as ET\n')
+    assert AgenticSystem._missing_imports(tree) == []
+
+def test_validate_target_rejects_numpy_style(monkeypatch):
+    system, d = make_repo()
+    with open(os.path.join(d, 'solution.py'), 'w') as f:
+        f.write('import definitely_not_a_module_xyz as np\nprint(int(input()) * 2)\n')
+    ok, reason = system._validate_target()
+    assert not ok
+    assert 'definitely_not_a_module_xyz' in reason
+    assert 'standard library' in reason
+
+# (a)/(d) run_samples hint logic ----------------------------------------------
+
+def test_has_crash_detection():
+    assert AgenticSystem._has_crash('Sample 1: MISMATCH (runtime error, exit code 1)')
+    assert AgenticSystem._has_crash('Sample 2: MISMATCH (timeout after 10s)')
+    assert not AgenticSystem._has_crash('Sample 1: MISMATCH\nexpected: 1\ngot: 2')
+
+# (c) fallback feedback loop --------------------------------------------------
+
+def test_fallback_retries_after_numpy_crash(monkeypatch):
+    system, d = make_repo()
+    replies = [
+        "```python\nimport numpy_missing_xyz as np\nprint(int(input()) * 2)\n```",
+        "```py\nn = int(input())\nprint(n * 2)\n```",
+    ]
+    prompts = []
+
+    def fake_text(client, model, sysmsg, prompt):
+        prompts.append(prompt)
+        return replies[len(prompts) - 1]
+
+    monkeypatch.setattr(system, '_plain_llm_text', fake_text)
+    monkeypatch.setattr(ca, 'create_client', lambda m: (None, 'fake'))
+    monkeypatch.setattr(system, '_output_filename', lambda: 'solution.py')
+    monkeypatch.setattr(system, '_is_method_task', lambda f: False)
+    monkeypatch.setattr(ca, 'safe_log', lambda *a, **k: None)
+    # the test problem's sample is "3 -> 6", which the second candidate matches
+    result = system._direct_completion_fallback('task', max_attempts=4)
+    assert result is True
+    assert len(prompts) == 2
+    assert 'module numpy_missing_xyz is not installed' in prompts[1]
+    with open(os.path.join(d, 'solution.py')) as f:
+        final = f.read()
+    assert 'numpy_missing_xyz' not in final
+    out = subprocess.run(['python3', os.path.join(d, 'solution.py')], input='3\n',
+                         capture_output=True, text=True)
+    assert out.returncode == 0 and out.stdout.strip() == '6'
+
+def test_fallback_gives_up_after_bounded_attempts(monkeypatch):
+    system, d = make_repo()
+    calls = []
+    def always_bad(client, model, sysmsg, prompt):
+        calls.append(1)
+        return "```python\nprint(1/0)\n```"
+    monkeypatch.setattr(system, '_plain_llm_text', always_bad)
+    monkeypatch.setattr(ca, 'create_client', lambda m: (None, 'fake'))
+    monkeypatch.setattr(system, '_output_filename', lambda: 'solution.py')
+    monkeypatch.setattr(system, '_is_method_task', lambda f: False)
+    monkeypatch.setattr(ca, 'safe_log', lambda *a, **k: None)
+    assert system._direct_completion_fallback('task', max_attempts=4) is False
+    assert len(calls) == 4
+
+# (e) empty-reply repair -------------------------------------------------------
+
+def test_plain_llm_repair_rewrites_file(monkeypatch):
+    system, d = make_repo()
+    with open(os.path.join(d, 'solution.py'), 'w') as f:
+        f.write('import numpy_missing_xyz\nprint(0)\n')
+    monkeypatch.setattr(system, '_plain_llm_text',
+                        lambda c, m, s, p: "```python\nprint(int(input()) * 2)\n```")
+    monkeypatch.setattr(ca, 'create_client', lambda m: (None, 'fake'))
+    monkeypatch.setattr(system, '_output_filename', lambda: 'solution.py')
+    monkeypatch.setattr(system, '_is_method_task', lambda f: False)
+    monkeypatch.setattr(ca, 'safe_log', lambda *a, **k: None)
+    assert system._plain_llm_repair('task', 'ModuleNotFoundError') is True
+    with open(os.path.join(d, 'solution.py')) as f:
+        assert 'numpy_missing_xyz' not in f.read()
+
+def test_extract_code_fences():
+    assert AgenticSystem._extract_code('```python\nx=1\n```') == 'x=1\n'
+    assert AgenticSystem._extract_code('```py\nx=1\n```') == 'x=1\n'
+    assert AgenticSystem._extract_code('```\nx=1\n```') == 'x=1\n'
+    assert AgenticSystem._extract_code('no fence') is None
