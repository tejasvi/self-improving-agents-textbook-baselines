+    def _is_trivial_file_text(self, text):
+        """
+        True if the file has no meaningful code: empty, whitespace/comments only, or only
+        pass statements and docstrings (imports alone do not count as a solution).
+        """
+        if text is None:
+            return True
+        try:
+            tree = ast.parse(text)
+        except SyntaxError:
+            return text.strip() == ''
+        for node in tree.body:
+            if isinstance(node, (ast.Pass, ast.Import, ast.ImportFrom)):
+                continue
+            if isinstance(node, ast.Expr) and isinstance(getattr(node, 'value', None), ast.Constant) \
+                    and isinstance(node.value.value, str):
+                continue
+            return False
+        return True
+
+    def _write_placeholder(self):
+        """
+        If the target file exists but is trivial, replace it with a placeholder so the agent
+        starts from a meaningful state:
+        - the starter (base commit) version if it is non-trivial;
+        - otherwise a stub that compiles but carries the stub marker, so _validate_target()
+          rejects it until the agent writes a real solution.
+        Returns True if the file was written.
+        """
+        filename = self._output_filename()
+        path = self._target_path()
+        if not filename or not path or not os.path.isfile(path):
+            return False
+        try:
+            with open(path) as f:
+                current = f.read()
+        except OSError:
+            return False
+        if not self._is_trivial_file_text(current):
+            return False
+
+        starter = self._starter_text(filename)
+        if starter and not self._is_trivial_file_text(starter):
+            content = starter
+            reason = 'restored starter version'
+        elif self._is_method_task(filename):
+            content = ('from typing import *\n\n'
+                       'class Solution:\n'
+                       '    # TODO: replace with a real solution\n'
+                       '    pass\n')
+            reason = 'method-style stub'
+        else:
+            content = ('import sys\n\n'
+                       '# TODO: replace with a real solution\n'
+                       'def main():\n'
+                       '    data = sys.stdin.read()\n\n'
+                       'main()\n')
+            reason = 'program-style stub'
+        with open(path, 'w') as f:
+            f.write(content)
+        safe_log(f"[placeholder] {filename} was trivial; wrote {reason}")
+        return True
+
