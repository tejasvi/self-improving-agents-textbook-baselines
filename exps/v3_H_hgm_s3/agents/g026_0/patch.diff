@@ -0,0 +1,136 @@
+import importlib.util
+import inspect
+import json
+import subprocess
+import sys
+
+
+def tool_info():
+    return {
+        'name': 'method_stress',
+        'description': (
+            'Randomized comparison of a method-style solution (a `Solution` class method) against a brute-force '
+            'reference function. For seed = 1..iterations, runs generator_path with the seed as its argument; it '
+            'must print a JSON list of positional arguments for the method (for example [[1, -2, 3], 2]), or a '
+            'JSON object of keyword arguments. The tool then calls Solution().<method> and brute(...) with those '
+            'arguments and compares the results. brute_path must define `brute(*args)` taking the same arguments '
+            '(or `brute(**kwargs)` when the generator prints an object). Returns the first failing seed with the '
+            'args and both outputs, or "ALL OK".'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'module_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to the Python file that defines the Solution class.',
+                },
+                'brute_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to a Python file defining brute(*args) or brute(**kwargs), the simple obviously-correct reference.',
+                },
+                'generator_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to a Python generator. It is called as `python3 generator.py SEED` and prints one JSON list of args (or a JSON object of kwargs) to stdout.',
+                },
+                'iterations': {
+                    'type': 'integer',
+                    'description': 'Number of seeds to test (seeds 1..iterations). Defaults to 200.',
+                },
+                'timeout': {
+                    'type': 'number',
+                    'description': 'Timeout in seconds for each generator run and each method/brute call. Defaults to 5.',
+                },
+                'class_name': {
+                    'type': 'string',
+                    'description': 'Name of the class to instantiate. Defaults to "Solution".',
+                },
+                'method_name': {
+                    'type': 'string',
+                    'description': 'Name of the method to call. If omitted, the single public method of the class is used.',
+                },
+            },
+            'required': ['module_path', 'brute_path', 'generator_path'],
+        },
+    }
+
+
+def _load_module(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _pick_method(cls, method_name):
+    if method_name:
+        return method_name
+    methods = [
+        name for name, _ in inspect.getmembers(cls, predicate=inspect.isfunction)
+        if not name.startswith('_')
+    ]
+    if len(methods) == 1:
+        return methods[0]
+    raise ValueError(f'cannot infer method name, candidates: {methods}')
+
+
+def _call_with(fn, payload):
+    """Call fn with a JSON payload: a list is positional args, a dict is keyword args."""
+    if isinstance(payload, dict):
+        return fn(**payload)
+    return fn(*payload)
+
+
+def _run_generator(generator_path, seed, timeout):
+    proc = subprocess.run(
+        [sys.executable, generator_path, str(seed)],
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, check=False,
+    )
+    if proc.returncode != 0:
+        raise RuntimeError(f'generator exited {proc.returncode}: {proc.stderr.decode(errors="replace")[-300:]}')
+    return json.loads(proc.stdout.decode(errors='replace').strip())
+
+
+def tool_function(module_path, brute_path, generator_path, iterations=200, timeout=5,
+                  class_name=None, method_name=None):
+    iterations = int(iterations or 200)
+    timeout = float(timeout or 5)
+    class_name = class_name or 'Solution'
+
+    try:
+        cls = getattr(_load_module(module_path, 'candidate_solution_module'), class_name)
+        method_name = _pick_method(cls, method_name)
+        method = getattr(cls(), method_name)
+    except Exception as e:
+        return f'ERROR: could not load {class_name} from {module_path}: {type(e).__name__}: {e}'
+
+    try:
+        brute = getattr(_load_module(brute_path, 'brute_reference_module'), 'brute')
+    except Exception as e:
+        return f'ERROR: could not load brute(...) from {brute_path}: {type(e).__name__}: {e}'
+
+    for seed in range(1, iterations + 1):
+        try:
+            payload = _run_generator(generator_path, seed, timeout)
+        except subprocess.TimeoutExpired:
+            return f'seed {seed}: ERROR generator timed out after {timeout}s'
+        except Exception as e:
+            return f'seed {seed}: ERROR generator failed: {type(e).__name__}: {e}'
+
+        try:
+            got = _call_with(method, payload)
+        except Exception as e:
+            return (f'seed {seed}: MISMATCH (runtime error in {class_name}.{method_name})\n'
+                    f'args: {json.dumps(payload)}\n'
+                    f'error: {type(e).__name__}: {e}')
+        try:
+            expected = _call_with(brute, payload)
+        except Exception as e:
+            return f'seed {seed}: ERROR brute raised {type(e).__name__}: {e} on args {json.dumps(payload)}'
+
+        if got != expected:
