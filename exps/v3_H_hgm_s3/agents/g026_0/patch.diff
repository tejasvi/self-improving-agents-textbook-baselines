+    """
+    examples = []
+    state = None  # None | 'input' | 'output'
+    cur_in, cur_out = [], []
+
+    def flush():
+        if state == 'output':
+            inp = ' '.join(cur_in).strip()
+            out = ' '.join(cur_out).strip()
