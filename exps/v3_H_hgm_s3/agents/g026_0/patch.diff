+            state = 'input'
+            cur_in, cur_out = [m_in.group(1)], []
+            continue
+        if m_out and state in ('input', 'output'):
+            state = 'output'
+            cur_out = [m_out.group(1)]
+            continue
+        if _BLOCK_START_RE.match(line):
