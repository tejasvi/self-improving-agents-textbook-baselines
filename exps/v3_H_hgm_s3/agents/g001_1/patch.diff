+    def _check_solution_health(self):
+        """
+        Check that the changed non-test Python files can be imported in a fresh subprocess and
+        that the third-party modules they import are available. Returns the raw error output as a
+        string, or an empty string if everything is fine.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_files = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git a/'):
+                rest = line[len('diff --git a/'):]
+                parts = rest.rsplit(' b/', 1)
+                path = parts[0] if len(parts) == 2 else rest
+                if path.endswith('.py') and not self._is_test_file(path) and path not in changed_files:
+                    changed_files.append(path)
+
+        import ast
+        import importlib.util
+        import sys
+
+        import_code = (
+            'import importlib.util,sys; path=sys.argv[1]; '
+            'spec=importlib.util.spec_from_file_location("m", path); '
+            'm=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)'
+        )
+        problems = []
+        for rel_path in changed_files:
+            full_path = os.path.join(self.git_tempdir, rel_path)
+            if not os.path.isfile(full_path):
+                continue
+
+            # (b) import the file in a fresh subprocess
+            try:
+                result = subprocess.run(
+                    [sys.executable, '-c', import_code, full_path],
+                    capture_output=True, timeout=60, cwd=self.git_tempdir, stdin=subprocess.DEVNULL,
+                )
+                if result.returncode != 0:
+                    stderr_text = result.stderr.decode(errors='replace')
+                    problems.append(f"[{rel_path}] failed to import (exit code {result.returncode}):\n{stderr_text}")
+            except subprocess.TimeoutExpired as e:
+                stderr_text = (e.stderr or b'').decode(errors='replace') if isinstance(e.stderr, bytes) else str(e.stderr or '')
+                problems.append(f"[{rel_path}] import timed out after 60 seconds:\n{stderr_text}")
+
+            # (c) check that imported top-level modules are stdlib or importable
+            try:
+                with open(full_path, 'r', encoding='utf-8', errors='replace') as f:
+                    tree = ast.parse(f.read(), filename=rel_path)
+            except SyntaxError as e:
+                problems.append(f"[{rel_path}] syntax error: {e}")
+                continue
+
+            imported = []
+            for node in ast.walk(tree):
+                if isinstance(node, ast.Import):
+                    for alias in node.names:
+                        imported.append(alias.name.split('.')[0])
+                elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+                    imported.append(node.module.split('.')[0])
+
+            missing = []
+            for name in sorted(set(imported)):
+                if name in sys.stdlib_module_names:
+                    continue
+                # Modules provided by the repo itself are fine.
+                if os.path.exists(os.path.join(self.git_tempdir, name + '.py')) or \
+                        os.path.isdir(os.path.join(self.git_tempdir, name)):
+                    continue
+                try:
+                    available = importlib.util.find_spec(name) is not None
+                except (ImportError, ValueError):
+                    available = False
+                if not available:
+                    missing.append(name)
+            if missing:
+                problems.append(
+                    f"[{rel_path}] imports modules that are not in the standard library and are not installed: "
+                    f"{missing}"
+                )
+
+        return "\n\n".join(problems)
+
