diff --git a/tools/interactive_runner.py b/tools/interactive_runner.py
new file mode 100644
index 0000000..fd7702b
--- /dev/null
+++ b/tools/interactive_runner.py
@@ -0,0 +1,178 @@
+import os
+import subprocess
+import tempfile
+import threading
+import time
+
+
+def tool_info():
+    return {
+        'name': 'interactive_runner',
+        'description': (
+            'Run a candidate Python solution against an interactive judge script. The solution\'s stdout is '
+            'piped to the judge\'s stdin and the judge\'s stdout is piped to the solution\'s stdin, line by line, '
+            'with flushing. The judge is a Python program that decides the verdict: exit code 0 means ACCEPTED, '
+            'any other exit code means REJECTED and its stderr is the reason (write the protocol error or the '
+            'wrong-answer message to stderr). Returns the verdict, both exit codes, both stderr outputs and a '
+            'transcript of the exchange (S> = solution output, J> = judge output). Both processes are killed when '
+            'the timeout expires. The transcript is capped at max_lines lines.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Path to the candidate Python solution file (reads stdin, writes stdout).',
+                },
+                'judge_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python judge script. It reads the solution output from stdin, '
+                                   'writes its queries/responses to stdout, and exits 0 only if the answer is accepted.',
+                },
+                'timeout': {
+                    'type': 'number',
+                    'description': 'Overall time limit in seconds for the whole exchange. Defaults to 10.',
+                },
+                'max_lines': {
+                    'type': 'integer',
+                    'description': 'Maximum number of transcript lines to keep. Defaults to 2000.',
+                },
+            },
+            'required': ['solution_path', 'judge_path'],
+        },
+    }
+
+
+def _pump(src, dst, tag, transcript, state, lock, max_lines):
+    """Copy lines from src to dst (flushing each time), recording them in the transcript."""
+    try:
+        for line in iter(src.readline, b''):
+            with lock:
+                if len(transcript) < max_lines:
+                    transcript.append(f'{tag} {line.decode(errors="replace").rstrip()}')
+                else:
+                    state['truncated'] = True
+            try:
+                dst.write(line)
+                dst.flush()
+            except (BrokenPipeError, OSError, ValueError):
+                break
+    except (OSError, ValueError):
+        pass
+    finally:
+        try:
+            dst.close()  # signals EOF to the reading process
+        except (OSError, ValueError):
+            pass
+        try:
+            src.close()
+        except (OSError, ValueError):
+            pass
+
+
+def _read_tail(fileobj, n=1500):
+    try:
+        fileobj.seek(0)
+        return fileobj.read().decode(errors='replace').strip()[-n:]
+    except (OSError, ValueError):
+        return ''
+
+
+def tool_function(solution_path, judge_path, timeout=10, max_lines=2000):
+    timeout = float(timeout) if timeout is not None else 10.0
+    max_lines = int(max_lines) if max_lines is not None else 2000
+    if not solution_path or not os.path.isfile(solution_path):
+        return f'Solution file not found: {solution_path}'
+    if not judge_path or not os.path.isfile(judge_path):
+        return f'Judge file not found: {judge_path}'
+
+    transcript = []
+    state = {'truncated': False}
+    lock = threading.Lock()
+    sol_err = tempfile.TemporaryFile()
+    judge_err = tempfile.TemporaryFile()
+    timed_out = False
+
+    try:
+        sol = subprocess.Popen(
+            ['python3', solution_path],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=sol_err,
+        )
+        judge = subprocess.Popen(
+            ['python3', judge_path],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=judge_err,
+        )
+    except OSError as e:
+        return f'Failed to launch processes: {type(e).__name__}: {e}'
+
+    # solution stdout -> judge stdin ; judge stdout -> solution stdin
+    t1 = threading.Thread(target=_pump, args=(sol.stdout, judge.stdin, 'S>', transcript, state, lock, max_lines),
+                          daemon=True)
+    t2 = threading.Thread(target=_pump, args=(judge.stdout, sol.stdin, 'J>', transcript, state, lock, max_lines),
+                          daemon=True)
+    t1.start()
+    t2.start()
+
+    deadline = time.monotonic() + timeout
+    codes = {}
+    for name, proc in (('judge', judge), ('solution', sol)):
+        remaining = max(0.0, deadline - time.monotonic())
+        try:
+            codes[name] = proc.wait(timeout=remaining)
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            break
+
+    if timed_out:
+        for proc in (sol, judge):
+            try:
+                proc.kill()
+            except OSError:
+                pass
+        for proc in (sol, judge):
+            try:
+                proc.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                pass
+        codes.setdefault('judge', judge.returncode)
+        codes.setdefault('solution', sol.returncode)
+
+    t1.join(timeout=2)
+    t2.join(timeout=2)
+    for stream in (sol.stdin, judge.stdin):
+        try:
+            stream.close()
+        except (OSError, ValueError):
+            pass
+
+    judge_rc = judge.returncode
+    sol_rc = sol.returncode
+    judge_stderr = _read_tail(judge_err)
+    sol_stderr = _read_tail(sol_err)
+    sol_err.close()
+    judge_err.close()
+
+    if timed_out:
+        verdict = 'TIMEOUT'
+    elif judge_rc == 0:
+        verdict = 'ACCEPTED'
+    else:
+        verdict = 'REJECTED'
+
+    lines = [
+        f'VERDICT: {verdict}',
+        f'judge exit code: {judge_rc}',
+        f'solution exit code: {sol_rc}',
+        f'judge stderr (reason): {judge_stderr or "(empty)"}',
+        f'solution stderr: {sol_stderr or "(empty)"}',
+    ]
+    if timed_out:
+        lines.append(f'time limit of {timeout:g}s exceeded; both processes were killed')
+    with lock:
+        body = list(transcript)
+        truncated = state['truncated']
+    lines.append(f'transcript ({len(body)} lines{", truncated" if truncated else ""}):')
+    lines.extend(body)
+    if truncated:
+        lines.append(f'... transcript truncated at {max_lines} lines')
+    return '\n'.join(lines)
