+def _defines_solution_class(text):
+    """
+    True only if text parses as Python and has a top-level `class Solution` statement.
+    Plain substring matches are not enough: prompts or docstrings may contain the words.
+    """
+    try:
+        tree = ast.parse(text)
+    except SyntaxError:
+        return False
+    return any(isinstance(n, ast.ClassDef) and n.name == 'Solution' for n in tree.body)
+
+def _has_stub_comment(text):
+    """
+    True if a real comment token carries the stub marker. Text inside string literals (such as
+    stub templates in this codebase) does not count.
+    """
+    marker = 'TODO: replace with a real solution'
+    try:
+        tokens = tokenize.generate_tokens(io.StringIO(text).readline)
+        return any(tok.type == tokenize.COMMENT and marker in tok.string for tok in tokens)
+    except (tokenize.TokenError, SyntaxError):
+        return False
