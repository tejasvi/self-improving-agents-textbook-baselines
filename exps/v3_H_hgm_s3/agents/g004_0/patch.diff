+    def _verify_and_repair(self, msg_history, task, max_rounds=5):
+        """
+        Bounded verify-and-repair loop. While the last verification failed or is missing,
+        resume the agent with the failure excerpt. Never loops unboundedly.
+        """
+        final_failed, final_excerpt = True, 'not checked'
+        for rnd in range(1, max_rounds + 1):
+            failed, excerpt = self._last_verification_failed(msg_history)
+            if not failed:
+                final_failed, final_excerpt = False, ''
+                break
+            safe_log(f"[forward] verify round {rnd}: verification failed/missing: {excerpt[:200]!r}")
+            repair_prompt = (
+                "The solution is known to be wrong or unverified.\n"
+                f"Latest verification output:\n<verification>\n{excerpt[:1500]}\n</verification>\n\n"
+                "Diagnose the root cause by reasoning about the algorithm (use the counterexample if one "
+                "is shown). Rewrite the solution file with the editor tool (use `edit`, after viewing it). "
+                "Then re-run the sample inputs and the brute-force stress test. Do not stop until there "
+                "are zero mismatches and all samples pass. Always make the tool call rather than "
+                "announcing a next step.\n\n"
+                f"Original task:\n{task}"
+            )
+            msg_history = self._safe_chat(repair_prompt, self._sanitize_history(msg_history))
+            final_failed, final_excerpt = True, excerpt
+        else:
+            final_failed, final_excerpt = self._last_verification_failed(msg_history)
+        state = 'FAILED' if final_failed else 'PASSED'
+        safe_log(f"[forward] final verification state: {state} {final_excerpt[:200]!r}")
+        return not final_failed
+
