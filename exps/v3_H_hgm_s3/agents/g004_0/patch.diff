+    _FAILURE_MARKERS = ('MISMATCH', 'Traceback', 'AssertionError', 'FAILED', 'wrong answer',
+                        'Wrong Answer', 'wrong', 'Error:')
+    _BENIGN_PATTERNS = (
+        r'\b0\s+(failed|failures?|errors?|mismatch(es)?)\b',
+        r'\bno\s+mismatch(es)?\b',
+        r'\bmismatches?:\s*0\b',
+        r'\ball\s+(tests\s+)?passed\b',
+        r'\b\d+\s+passed\b(?!.*\bfailed\b)',
+    )
+
+    def _history_events(self, msg_history):
+        """
+        Flatten the message history into ('call', name, text) and ('result', name, text) events,
+        supporting structured tool_use/tool_result blocks and text blocks with '<tool_use>' or
+        'Tool Used:' / 'Tool Result:' markers.
+        """
+        events = []
+        last_call = None
+        for msg in msg_history or []:
+            if not isinstance(msg, dict):
+                continue
+            content = msg.get('content')
+            if isinstance(content, str):
+                content = [{"type": "text", "text": content}]
+            if not isinstance(content, list):
+                continue
+            for block in content:
+                if isinstance(block, dict):
+                    btype = block.get('type')
+                    if btype == 'tool_use':
+                        last_call = block.get('name')
+                        events.append(('call', last_call, str(block.get('input', ''))))
+                        continue
+                    if btype == 'tool_result':
+                        events.append(('result', last_call, str(block.get('content', ''))))
+                        continue
+                    text = block.get('text') if btype == 'text' else None
+                else:
+                    if getattr(block, 'type', None) == 'tool_use':
+                        last_call = getattr(block, 'name', None)
+                        events.append(('call', last_call, str(getattr(block, 'input', ''))))
+                    continue
+                if not isinstance(text, str):
+                    continue
+                if '<tool_use>' in text:
+                    m = re.search(r"tool_name['\"]?\s*:\s*['\"]?(\w+)", text)
+                    last_call = m.group(1) if m else None
+                    events.append(('call', last_call, text))
+                    continue
+                used = re.search(r'Tool Used:\s*(\w+)', text)
+                if used:
+                    last_call = used.group(1)
+                    before, _, after = text.partition('Tool Result:')
+                    events.append(('call', last_call, before))
+                    if 'Tool Result:' in text:
+                        events.append(('result', last_call, after))
+                    continue
+                if 'Tool Result:' in text:
+                    events.append(('result', last_call, text.split('Tool Result:', 1)[1]))
+        return events
+
+    def _last_verification_failed(self, msg_history):
+        """
+        Inspect the history after the last file-writing editor call. Returns (failed, excerpt):
+        - failed is True if a bash result after that edit contains a failure marker, or if no
+          bash result follows the edit (unverified), or if the final assistant turn is text-only
+          and the last verification failed.
+        - excerpt is a short piece of the failing output (or a note about missing verification).
+        """
+        events = self._history_events(msg_history)
+        last_edit = None
+        for i, (kind, name, text) in enumerate(events):
+            if kind == 'call' and name == 'editor' and re.search(
+                    r"command['\"]?\s*:\s*['\"](create|edit)['\"]", text):
+                last_edit = i
+        if last_edit is None:
+            return False, ''
+
+        later_results = [text for kind, name, text in events[last_edit + 1:]
+                         if kind == 'result' and name == 'bash']
+        if not later_results:
+            return True, 'no verification run after last edit'
+
+        failed_excerpt = None
+        for text in later_results:
+            cleaned = text
+            for pat in self._BENIGN_PATTERNS:
+                cleaned = re.sub(pat, ' ', cleaned, flags=re.IGNORECASE)
+            if any(marker in cleaned for marker in self._FAILURE_MARKERS):
+                failed_excerpt = text
+        if failed_excerpt is not None:
+            return True, failed_excerpt.strip()[-1500:]
+
+        # Last verification passed; a text-only final assistant turn after it is still fine.
+        return False, ''
+
