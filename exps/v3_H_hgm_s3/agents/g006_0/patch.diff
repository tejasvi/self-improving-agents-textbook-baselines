-    _FAILURE_MARKERS = ('MISMATCH', 'Traceback', 'AssertionError', 'FAILED', 'wrong answer',
-                        'Wrong Answer', 'wrong', 'Error:')
-    _BENIGN_PATTERNS = (
-        r'\b0\s+(failed|failures?|errors?|mismatch(es)?)\b',
-        r'\bno\s+mismatch(es)?\b',
-        r'\bmismatches?:\s*0\b',
-        r'\ball\s+(tests\s+)?passed\b',
-        r'\b\d+\s+passed\b(?!.*\bfailed\b)',
-    )
