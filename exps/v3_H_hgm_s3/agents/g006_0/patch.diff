-    def _last_verification_failed(self, msg_history):
-        """
-        Inspect the history after the last file-writing editor call. Returns (failed, excerpt):
-        - failed is True if a bash result after that edit contains a failure marker, or if no
-          bash result follows the edit (unverified), or if the final assistant turn is text-only
-          and the last verification failed.
-        - excerpt is a short piece of the failing output (or a note about missing verification).
-        """
-        events = self._history_events(msg_history)
-        last_edit = None
-        for i, (kind, name, text) in enumerate(events):
-            if kind == 'call' and name == 'editor' and re.search(
-                    r"command['\"]?\s*:\s*['\"](create|edit)['\"]", text):
-                last_edit = i
-        if last_edit is None:
-            return False, ''
-
-        later_results = [text for kind, name, text in events[last_edit + 1:]
-                         if kind == 'result' and name == 'bash']
-        if not later_results:
-            return True, 'no verification run after last edit'
-
-        failed_excerpt = None
-        for text in later_results:
-            cleaned = text
-            for pat in self._BENIGN_PATTERNS:
-                cleaned = re.sub(pat, ' ', cleaned, flags=re.IGNORECASE)
-            if any(marker in cleaned for marker in self._FAILURE_MARKERS):
-                failed_excerpt = text
-        if failed_excerpt is not None:
-            return True, failed_excerpt.strip()[-1500:]
-
-        # Last verification passed; a text-only final assistant turn after it is still fine.
-        return False, ''
