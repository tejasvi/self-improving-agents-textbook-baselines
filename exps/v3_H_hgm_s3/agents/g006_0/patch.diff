-                corrective = (f"{short}\n\nRestated task:\n{task}\n"
-                              "Your first action must be an editor tool call that writes the full solution file.")
-            safe_log(f"[forward] retry {attempt} due to status '{status}'")
-            msg_history = self._safe_chat(corrective, msg_history)
-            status = self._patch_status()
