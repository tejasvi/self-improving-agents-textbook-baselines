diff --git a/tools/stress_perf.py b/tools/stress_perf.py
new file mode 100644
index 0000000..c8c0ea3
--- /dev/null
+++ b/tools/stress_perf.py
@@ -0,0 +1,124 @@
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import textwrap
+import time
+
+
+def tool_info():
+    return {
+        'name': 'stress_perf',
+        'description': (
+            'Performance gate. Builds a maximum-size input with generator_code and runs the solution on it '
+            'in a subprocess with a hard time limit. Returns "PERF OK <seconds>" if it finishes in time, '
+            '"PERF TIMEOUT after <N>s" if it exceeds time_limit (a timeout is a failure), or the raw stderr/'
+            'traceback on error. Run it after every change to the solution.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Path to the Python solution file.',
+                },
+                'generator_code': {
+                    'type': 'string',
+                    'description': (
+                        'Python code that defines gen() returning the arguments for the call (a tuple/list) '
+                        'or the stdin text (a string), built at the MAXIMUM constraints of the problem.'
+                    ),
+                },
+                'call_spec': {
+                    'type': 'string',
+                    'description': (
+                        "How to call the solution: e.g. 'Solution().maxDistance(*args)' for a Solution class "
+                        "method, or 'stdin' for a complete stdin/stdout program."
+                    ),
+                },
+                'time_limit': {
+                    'type': 'number',
+                    'description': 'Time limit in seconds. Defaults to 10.',
+                },
+            },
+            'required': ['solution_path', 'generator_code', 'call_spec'],
+        },
+    }
+
+
+# Runner scripts are generated from these templates. Injected values use repr() so that
+# paths and code strings are embedded safely.
+_STDIN_RUNNER = '''
+import io, sys, runpy
+{generator_code}
+_data = gen()
+_data = _data if isinstance(_data, str) else str(_data)
+sys.stdin = io.StringIO(_data)
+runpy.run_path({solution_path!r}, run_name='__main__')
+sys.stdout.flush()
+'''
+
+_METHOD_RUNNER = '''
+import sys, runpy
+{generator_code}
+_args = gen()
+_args = tuple(_args) if isinstance(_args, (list, tuple)) else (_args,)
+_ns = runpy.run_path({solution_path!r}, run_name='solution_under_test')
+Solution = _ns.get('Solution')
+_res = eval({call_spec!r}, {{'Solution': Solution, 'args': _args}})
+sys.stdout.flush()
+'''
+
+
+def _build_runner(solution_path, generator_code, call_spec):
+    gen_src = textwrap.dedent(generator_code or '')
+    template = _STDIN_RUNNER if call_spec.strip() == 'stdin' else _METHOD_RUNNER
+    return template.format(
+        generator_code=gen_src,
+        solution_path=os.path.abspath(solution_path),
+        call_spec=call_spec,
+    )
+
+
+def tool_function(solution_path, generator_code, call_spec, time_limit=10):
+    try:
+        time_limit = float(time_limit) if time_limit is not None else 10.0
+    except (TypeError, ValueError):
+        time_limit = 10.0
+    fd, runner_path = tempfile.mkstemp(suffix='_perf_runner.py')
+    try:
+        with os.fdopen(fd, 'w') as f:
+            f.write(_build_runner(solution_path, generator_code, call_spec))
+        proc = subprocess.Popen(
+            [sys.executable, runner_path],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+            text=True,
+        )
+        start = time.time()
+        try:
+            _, stderr = proc.communicate(timeout=time_limit)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
+            except (ProcessLookupError, PermissionError):
+                pass
+            try:
+                proc.communicate(timeout=5)
+            except Exception:
+                pass
+            return f'PERF TIMEOUT after {time_limit:g}s'
+        elapsed = time.time() - start
+        if proc.returncode != 0:
+            return (stderr or '').strip() or f'Process exited with code {proc.returncode}'
+        return f'PERF OK {elapsed:.3f}'
+    except Exception as e:
+        return f'Error: {type(e).__name__}: {e}'
+    finally:
+        try:
+            os.remove(runner_path)
+        except OSError:
+            pass
