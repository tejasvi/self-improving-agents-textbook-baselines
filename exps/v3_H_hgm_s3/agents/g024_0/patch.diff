+def _trailing_assistant_is_empty(msg_history):
+    """
+    True if the last message is an assistant turn with no text and no tool_use blocks.
+    """
+    if not msg_history:
+        return False
+    msg = msg_history[-1]
+    role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+    if role != 'assistant':
+        return False
+    content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+    if isinstance(content, str):
+        blocks = [{'type': 'text', 'text': content}]
+    elif isinstance(content, list):
+        blocks = content
+    else:
+        blocks = []
+    has_tool_use = any(_block_type(b) == 'tool_use' for b in blocks)
+    has_text = any((_block_text(b) or '').strip() for b in blocks)
+    return not has_tool_use and not has_text
+
