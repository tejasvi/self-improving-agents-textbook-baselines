diff --git a/tools/perf_test.py b/tools/perf_test.py
new file mode 100644
index 0000000..94d4449
--- /dev/null
+++ b/tools/perf_test.py
@@ -0,0 +1,172 @@
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+
+_METHOD_RUNNER = r'''
+import importlib.util
+import json
+import sys
+
+sol_path, method_name, class_name = sys.argv[1], sys.argv[2], sys.argv[3]
+kwargs = json.loads(sys.stdin.read() or "{}")
+spec = importlib.util.spec_from_file_location("candidate_solution", sol_path)
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+cls = getattr(module, class_name)
+method = getattr(cls(), method_name)
+result = method(**kwargs)
+print(json.dumps(result, default=str))
+'''
+
+
+def tool_info():
+    return {
+        'name': 'perf_test',
+        'description': (
+            'Wall-clock performance check of a solution on max-size inputs. The generator is run as '
+            '`python3 generator_path SEED` for seed = 1..seeds and must print one test input to stdout '
+            '(mode "program": the program input read from stdin; mode "method": a JSON object of keyword '
+            'arguments for the Solution method). The solution is run in a subprocess under a hard wall-clock '
+            'timeout; the whole process group is killed on expiry, so this never hangs. Returns "PERF OK '
+            'max_time=X.XXs" if every seed finishes in time without error, or "PERF TIMEOUT at seed N after T s" '
+            '(with the first part of stderr if any), or an error report. Pass absolute paths. Use a generator '
+            'that produces the maximum constraints from the statement, and an adversarial case if relevant.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to the solution Python file.',
+                },
+                'generator_path': {
+                    'type': 'string',
+                    'description': 'Absolute path to a generator script. Called as `python3 generator.py SEED`; prints one max-size test.',
+                },
+                'seeds': {
+                    'type': 'integer',
+                    'description': 'Number of seeds to test (seeds 1..seeds). Defaults to 3.',
+                },
+                'timeout': {
+                    'type': 'number',
+                    'description': 'Wall-clock timeout in seconds for each solution run. Defaults to 5.',
+                },
+                'mode': {
+                    'type': 'string',
+                    'enum': ['program', 'method'],
+                    'description': '"program" for a stdin/stdout program; "method" for a method of class Solution. Defaults to "program".',
+                },
+                'method_name': {
+                    'type': 'string',
+                    'description': 'Required in method mode: name of the Solution method to call with the generated JSON kwargs.',
+                },
+                'class_name': {
+                    'type': 'string',
+                    'description': 'Class name used in method mode. Defaults to "Solution".',
+                },
+            },
+            'required': ['solution_path', 'generator_path'],
+        },
+    }
+
+
+def _kill_group(proc):
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError, OSError):
+        try:
+            proc.kill()
+        except OSError:
+            pass
+
+
+def _run_group(args, input_text, timeout):
+    """
+    Run args in its own process group with a hard wall-clock timeout.
+    Returns (status, stdout, stderr, elapsed) where status is 'ok', 'timeout', or 'exit<code>'.
+    """
+    proc = subprocess.Popen(
+        args,
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+    start = time.monotonic()
+    try:
+        out, err = proc.communicate(input=input_text, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        _kill_group(proc)
+        try:
+            out, err = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            out, err = '', ''
+        return 'timeout', out or '', err or '', time.monotonic() - start
+    elapsed = time.monotonic() - start
+    if proc.returncode != 0:
+        return f'exit{proc.returncode}', out or '', err or '', elapsed
+    return 'ok', out or '', err or '', elapsed
+
+
+def _tail(text, limit=800):
+    text = (text or '').strip()
+    return text[-limit:] if len(text) > limit else text
+
+
+def tool_function(solution_path, generator_path, seeds=3, timeout=5, mode='program',
+                  method_name=None, class_name='Solution'):
+    try:
+        seeds = int(seeds) if seeds is not None else 3
+    except (TypeError, ValueError):
+        seeds = 3
+    try:
+        timeout = float(timeout) if timeout is not None else 5.0
+    except (TypeError, ValueError):
+        timeout = 5.0
+    mode = mode or 'program'
+    class_name = class_name or 'Solution'
+    seeds = max(1, seeds)
+
+    for label, path in (('solution_path', solution_path), ('generator_path', generator_path)):
+        if not path or not os.path.isabs(path) or not os.path.isfile(path):
+            return f'ERROR: {label} must be an existing absolute file path (got {path!r}).'
+    if mode not in ('program', 'method'):
+        return f'ERROR: mode must be "program" or "method" (got {mode!r}).'
+    if mode == 'method' and not method_name:
+        return 'ERROR: method mode requires method_name.'
+
+    if mode == 'program':
+        solver_args = [sys.executable, solution_path]
+    else:
+        solver_args = [sys.executable, '-c', _METHOD_RUNNER, solution_path, method_name, class_name]
+
+    max_time = 0.0
+    for seed in range(1, seeds + 1):
+        gen_status, test_input, gen_err, _ = _run_group([sys.executable, generator_path, str(seed)], '', timeout)
+        if gen_status != 'ok':
+            return f'PERF GENERATOR FAILED at seed {seed}: {gen_status}\n{_tail(gen_err)}'
+        if mode == 'method':
+            try:
+                json.loads(test_input or '{}')
+            except json.JSONDecodeError as e:
+                return f'PERF GENERATOR FAILED at seed {seed}: method mode needs JSON kwargs on stdout ({e})'
+            test_input = test_input or '{}'
+        elif test_input and not test_input.endswith('\n'):
+            test_input += '\n'
+
+        status, out, err, elapsed = _run_group(solver_args, test_input, timeout)
+        if status == 'timeout':
+            msg = f'PERF TIMEOUT at seed {seed} after {timeout:g} s'
+            if err.strip():
+                msg += f'\nstderr: {_tail(err, 400)}'
+            return msg
+        if status != 'ok':
+            return f'PERF ERROR at seed {seed}: {status}\nstderr: {_tail(err)}'
+        max_time = max(max_time, elapsed)
+
+    return f'PERF OK max_time={max_time:.2f}s over {seeds} seed(s) (timeout {timeout:g} s)'
