diff --git a/tools/variant_search.py b/tools/variant_search.py
new file mode 100644
index 0000000..76a6a3f
--- /dev/null
+++ b/tools/variant_search.py
@@ -0,0 +1,159 @@
+import itertools
+import json
+import os
+import subprocess
+import sys
+
+_MAX_COMBINATIONS = 500
+_TIMEOUT_SECONDS = 10
+_TOP_K = 5
+
+
+def tool_info():
+    return {
+        'name': 'variant_search',
+        'description': (
+            'Search over design variants of a solution. The solution template is a Python program that reads its '
+            'design parameters from environment variables named VARIANT_<NAME> (for example VARIANT_ORDER=asc). '
+            'The tool runs the template once for every combination of the parameter grid (at most 500 combinations, '
+            '10s timeout per run) on every "Sample Input N" / "Sample Output N" block of problem_text, and compares '
+            'each output with the expected output token by token, exactly like run_samples. It reports the variants '
+            'that match all samples, or otherwise the best-scoring variants with their per-sample match counts, and '
+            'a line "BEST VARIANT: {...} matches k/n samples". Use it when a construction is correct but its output '
+            'differs from the sample outputs: vary the processing order, pivot choice, bit assignment, elimination '
+            'style, and so on, then freeze the BEST VARIANT that matches all samples into the solution file.'
+        ),
+        'input_schema': {
+            'type': 'object',
+            'properties': {
+                'solution_template_path': {
+                    'type': 'string',
+                    'description': (
+                        'Path to a Python program (reads stdin, writes stdout) that reads its design parameters '
+                        'from environment variables VARIANT_<NAME>.'
+                    ),
+                },
+                'problem_text': {
+                    'type': 'string',
+                    'description': 'The full problem statement containing "Sample Input N" / "Sample Output N" blocks.',
+                },
+                'param_grid': {
+                    'type': 'string',
+                    'description': (
+                        'A JSON object mapping parameter names to lists of values, for example '
+                        '{"order": ["asc", "desc"], "reduced": [true, false]}. The name NAME is passed to the '
+                        'template as the environment variable VARIANT_NAME.'
+                    ),
+                },
+                'python': {
+                    'type': 'string',
+                    'description': 'Python interpreter to use. Defaults to python3.',
+                },
+            },
+            'required': ['solution_template_path', 'problem_text', 'param_grid'],
+        },
+    }
+
+
+def _load_samples(problem_text):
+    # Same parsing as tools/run_samples.py
+    here = os.path.dirname(os.path.abspath(__file__))
+    parent = os.path.dirname(here)
+    if parent not in sys.path:
+        sys.path.insert(0, parent)
+    from tools.run_samples import SAMPLE_RE
+    return SAMPLE_RE.findall(problem_text or '')
+
+
+def _env_value(value):
+    if isinstance(value, bool):
+        return 'true' if value else 'false'
+    return str(value)
+
+
+def _combinations(grid):
+    names = list(grid.keys())
+    value_lists = [grid[n] if isinstance(grid[n], list) else [grid[n]] for n in names]
+    combos = []
+    for values in itertools.product(*value_lists):
+        combos.append(dict(zip(names, values)))
+        if len(combos) >= _MAX_COMBINATIONS:
+            break
+    return combos
+
+
+def _run_variant(python, template, combo, inp_text):
+    env = dict(os.environ)
+    for name, value in combo.items():
+        env[f'VARIANT_{name}'] = _env_value(value)
+    try:
+        proc = subprocess.run(
+            [python, template],
+            input=inp_text,
+            capture_output=True,
+            text=True,
+            timeout=_TIMEOUT_SECONDS,
+            env=env,
+        )
+    except subprocess.TimeoutExpired:
+        return None
+    if proc.returncode != 0:
+        return None
+    return proc.stdout
+
+
+def tool_function(solution_template_path, problem_text, param_grid, python='python3'):
+    python = python or 'python3'
+    if not solution_template_path or not os.path.isfile(solution_template_path):
+        return f'Template not found: {solution_template_path}'
+    try:
+        grid = json.loads(param_grid) if isinstance(param_grid, str) else param_grid
+    except json.JSONDecodeError as e:
+        return f'param_grid is not valid JSON: {e}'
+    if not isinstance(grid, dict) or not grid:
+        return 'param_grid must be a non-empty JSON object mapping names to lists of values.'
+
+    pairs = _load_samples(problem_text)
+    if not pairs:
+        return 'No "Sample Input N" / "Sample Output N" pairs found in problem_text.'
+
+    combos = _combinations(grid)
+    total_combos = 1
+    for values in grid.values():
+        total_combos *= len(values) if isinstance(values, list) else 1
+    capped = total_combos > len(combos)
+
+    results = []  # (matches, combo, per_sample_status)
+    for combo in combos:
+        status = []
+        for _idx, inp, expected in pairs:
+            inp_text = inp.strip('\n') + '\n'
+            got = _run_variant(python, solution_template_path, combo, inp_text)
+            ok = got is not None and got.split() == expected.split()
+            status.append(ok)
+        results.append((sum(status), combo, status))
+
+    n = len(pairs)
+    matching = [r for r in results if r[0] == n]
+    lines = [f'Tried {len(combos)} of {total_combos} combinations on {n} sample(s)'
+             + (' (capped at 500)' if capped else '') + '.']
+
+    if matching:
+        lines.append(f'{len(matching)} variant(s) match all {n} samples:')
+        for matches, combo, _ in matching[:_TOP_K]:
+            lines.append(f'  MATCH {json.dumps(combo)}')
+        best = matching[0]
+        lines.append(f'BEST VARIANT: {json.dumps(best[1])} matches {best[0]}/{n} samples')
+        lines.append('Freeze this variant into the solution file: hard-code the chosen values in the solution '
+                     '(remove the environment-variable reads), then re-run run_samples and stress_test.')
+    else:
+        ranked = sorted(results, key=lambda r: -r[0])
+        lines.append(f'No variant matches all {n} samples. Top variants by per-sample match count:')
+        for matches, combo, status in ranked[:_TOP_K]:
+            per = ''.join('1' if s else '0' for s in status)
+            lines.append(f'  {json.dumps(combo)}: {matches}/{n} samples (per-sample {per})')
+        best = ranked[0]
+        lines.append(f'BEST VARIANT: {json.dumps(best[1])} matches {best[0]}/{n} samples')
+        lines.append('No variant reproduces all samples: change the construction itself (not only these parameters) '
+                     'and search again.')
+    return '\n'.join(lines)
