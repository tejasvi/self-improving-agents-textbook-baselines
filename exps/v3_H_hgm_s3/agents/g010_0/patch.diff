+        """
+        Run the verification scripts written by the agent in /tmp/verify (kept outside
+        git_tempdir so they never appear in the patch). Returns (passed, combined_output).
+        Missing scripts count as failure.
+        """
+        scripts = [VERIFY_SAMPLES_SCRIPT, VERIFY_STRESS_SCRIPT]
+        missing = [p for p in scripts if not os.path.isfile(p)]
+        if missing:
+            return False, 'verification scripts missing; create them'
+        outputs = []
+        for script in scripts:
+            try:
+                result = subprocess.run(
+                    ['python', script],
