+    def _patch_is_insufficient(self):
+        """
+        Returns True if the current diff against base_commit has no changed files,
+        or if every changed file is test-like (test/spec path component, test_ prefix, _test suffix),
+        or if the only changes are new files not mentioned in the problem statement.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed = []  # list of (path, is_new)
+        current_path = None
+        current_new = False
+        for line in diff.splitlines():
+            if line.startswith("diff --git "):
+                if current_path is not None:
+                    changed.append((current_path, current_new))
+                parts = line.split()
+                current_path = parts[3][2:] if len(parts) >= 4 and parts[3].startswith("b/") else (parts[-1] if parts else None)
+                current_new = False
+            elif line.startswith("new file mode") and current_path is not None:
+                current_new = True
+        if current_path is not None:
+            changed.append((current_path, current_new))
+
+        if not changed:
+            return True
+
+        def is_test_like(path):
+            comps = path.split("/")
+            if any(c in ("test", "tests", "spec", "specs") for c in comps[:-1]):
+                return True
+            stem = os.path.splitext(comps[-1])[0]
