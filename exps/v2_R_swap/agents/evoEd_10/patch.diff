+class AgenticSystem:
+    def __init__(self, model, log, git_tempdir, base_commit):
+        self.model = model
+        self.log = log
+        self.git_tempdir = git_tempdir
+        self.base_commit = base_commit
 
-if __name__ == "__main__":
-    main()
+    def _chat(self, msg, msg_history):
+        return chat_with_agent(msg, model=self.model, msg_history=msg_history, logging=self.log)
+
+    def forward(self, input_task):
+        test_cmd = TEST_COMMANDS.get("python", "python3 -m pytest -q")
+        results = []  # list of (score_tuple, diff, index)
+        summaries = []
+
+        for attempt in range(MAX_ATTEMPTS):
+            if attempt > 0:
+                reset_to_commit(self.git_tempdir, self.base_commit)
+
+            impl_msg = IMPLEMENT_PROMPT.format(task=input_task)
+            if attempt > 0:
+                impl_msg = ATTEMPT_SUMMARY_PROMPT.format(
+                    summary="\n".join(summaries)
+                ) + impl_msg
+
+            msg_history = self._chat(impl_msg, [])
+            if not last_text(msg_history).strip():
+                summaries.append(f"Attempt {attempt + 1}: empty reply, no solution produced.")
+                continue
+
+            msg_history = self._chat(VALIDATE_PROMPT.format(test_cmd=test_cmd), msg_history)
+            score = parse_result(last_text(msg_history))
+
+            for fix_round in range(MAX_FIX_ROUNDS):
+                if all(score):
+                    break
+                report = last_text(msg_history)
+                msg_history = self._chat(FIX_PROMPT.format(report=report), msg_history)
+                score = parse_result(last_text(msg_history))
+
+            diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+            if not diff or not diff.strip() or "solution.py" not in diff:
+                summaries.append(f"Attempt {attempt + 1}: empty diff or missing solution.py.")
+                continue
+
+            results.append((score, diff, attempt))
+            summaries.append(
+                f"Attempt {attempt + 1}: samples={'PASS' if score[0] else 'FAIL'}, "
+                f"stress={'PASS' if score[1] else 'FAIL'}, "
+                f"timing={'PASS' if score[2] else 'FAIL'}."
+            )
+
+            if all(score):
+                break
+
+        reset_to_commit(self.git_tempdir, self.base_commit)
+        if not results:
+            return ""
+
+        # Rank by samples, then stress, then timing, then most recent attempt.
+        best = max(results, key=lambda r: (r[0][0], r[0][1], r[0][2], r[2]))
+        best_patch = best[1]
+        apply_patch(self.git_tempdir, best_patch)
+        return best_patch
