+def parse_result(text):
+    """Return (samples, stress, timing) as ints 0/1. Missing line -> all FAIL."""
+    if not text:
+        return (0, 0, 0)
+    line = None
+    for ln in text.splitlines():
+        if "RESULT:" in ln:
+            line = ln
+    if line is None:
+        return (0, 0, 0)
+    return (
+        1 if "samples=PASS" in line else 0,
+        1 if "stress=PASS" in line else 0,
+        1 if "timing=PASS" in line else 0,
     )
 
