+    def _changed_files(self):
+        """
+        Return a list of (path, is_new) tuples for files changed versus base_commit,
+        parsed from the 'diff --git a/X b/Y' header lines of the diff.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        current = None
+        for line in diff.splitlines():
+            if line.startswith('diff --git '):
+                m = re.match(r'diff --git a/(\S+) b/(\S+)', line)
+                if m:
+                    current = [m.group(2), False]
+                    files.append(current)
+                else:
+                    current = None
+            elif current is not None and line.startswith('new file mode'):
+                current[1] = True
+        return [(path, is_new) for path, is_new in files]
+
+    def _patch_is_insufficient(self):
+        """
+        Return True if the current patch has no changed files, only test-like changed files,
+        or only newly created files (no existing tracked file was modified).
+        """
+        changed = self._changed_files()
+        if not changed:
+            return True
+
+        def is_test_like(path):
+            parts = path.replace('\\', '/').split('/')
+            if any(p.lower() in ('test', 'tests', 'spec') for p in parts[:-1]):
+                return True
+            name = parts[-1]
+            stem = name.rsplit('.', 1)[0]
+            return name.startswith('test_') or stem.endswith('_test')
+
+        if all(is_test_like(path) for path, _ in changed):
+            return True
+
+        # Only new untracked/added files and no modified tracked file: treat as insufficient
+        # (the stub the problem refers to is an existing tracked file).
+        if all(is_new for _, is_new in changed):
+            return True
+
+        return False
+
