+    def _has_meaningful_patch(self):
+        """
+        Return True if at least one non-test file has changed versus base_commit.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        changed_paths = []
+        for line in diff.splitlines():
+            if line.startswith("diff --git a/") and " b/" in line:
+                path = line[len("diff --git a/"):].split(" b/", 1)[0]
+                changed_paths.append(path)
+        for path in changed_paths:
+            low = path.lower()
+            is_test = (
+                '/test' in low or 'tests/' in low or 'test_' in low
+                or '_test.' in low or '.spec.' in low or '.test.' in low
+            )
+            if not is_test:
+                return True
+        return False
