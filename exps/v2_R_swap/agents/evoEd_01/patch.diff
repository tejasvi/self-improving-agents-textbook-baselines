+_DIFF_HEADER_RE = re.compile(r'^diff --git a/(\S+) b/(\S+)\s*$')
+
+
+def _changed_files(diff_str):
+    """Return the list of file paths from `diff --git a/X b/X` header lines."""
+    files = []
+    if not diff_str:
+        return files
+    for line in diff_str.splitlines():
+        m = _DIFF_HEADER_RE.match(line.strip())
+        if m:
+            path = m.group(2)
+            if path not in files:
+                files.append(path)
+    return files
+
+
+def _is_test_file(path):
+    """True if the path looks like a test file (generic name/directory patterns)."""
+    p = (path or "").lower().replace("\\", "/")
+    basename = p.split("/")[-1]
+    if "test" in basename:
+        return True
+    parts = p.split("/")[:-1]
+    for d in parts:
+        if d in ("tests", "test", "spec"):
+            return True
+    return False
