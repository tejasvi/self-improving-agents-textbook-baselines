+
+Workflow you must follow:
+1. Explore the repository: look at the main solution file (for example a stub such as `def minDifference(...): pass` or a script that reads stdin) and any existing tests or helpers.
+2. Work out an algorithm that fits the stated constraints (time and memory). Reason about complexity before coding.
+3. Implement the solution in the primary source file by editing the file. Replace stubs such as `pass` with the real implementation. Keep the required function/class signature and the required stdin/stdout behavior.
+4. Write quick tests: run the problem examples, and compare against a brute-force solution on small random inputs.
+5. Run the tests and fix any failures. Check edge cases and performance.
+
+The task is NOT complete until a non-test source file has been modified. Ending your turn without editing a file is a failure. Use the editor tool or bash to write the code."""
+
+    def forward(self):
+        instruction = self._build_instruction()
+        msg_history = []
+
+        # First attempt.
+        msg_history = self._call_agent(instruction, msg_history)
+
+        # Bounded retry loop: no while True.
+        for attempt in range(self.MAX_RETRIES):
+            if self._has_source_edit():
+                break
+            diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+            current = get_current_edits(self.git_tempdir) if callable(get_current_edits) else ""
+            if not diff or not diff.strip():
+                state = "The diff is empty: no files have been modified."
+            else:
+                state = ("Only test files have been modified; no source file has been changed.")
+            retry_msg = (
+                f"No source file has been modified; the stub is still unimplemented. {state}\n"
+                f"Current diff:\n{diff or ''}\n"
+                f"Current edits:\n{current or ''}\n"
+                "Open the solution file and implement the solution now using the editor tool. "
+                "Replace the stub body with a working implementation that meets the constraints, "
+                "then run the examples to verify it. Do not end your turn until the source file is edited."
+            )
+            self._log(f"Retry {attempt + 1}/{self.MAX_RETRIES}: no valid source edit detected.")
+            msg_history = self._call_agent(retry_msg, msg_history)
+
+        # Optional final review once a valid source edit exists.
+        if self._has_source_edit():
+            review_msg = (
+                "A source edit is in place. Run the problem examples once more, "
+                "check edge cases (smallest/largest inputs, empty or minimal cases) and "
+                "performance against the constraints. Fix any issue you find by editing "
+                "the source file, then finish."
+            )
+            msg_history = self._call_agent(review_msg, msg_history)
+
+        if self.chat_history_file:
+            try:
+                with open(self.chat_history_file, "w") as f:
+                    json.dump(msg_history, f, indent=2, default=str)
+            except Exception:
+                pass
+
+        return msg_history
