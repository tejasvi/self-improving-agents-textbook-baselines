+    def _patch_status(self):
+        """
+        Inspect the current patch versus the base commit.
+        Returns (is_empty, has_source_edit, changed_files), where changed_files is a
+        list of (path, is_test) tuples.
+        """
+        diff = diff_versus_commit(self.git_tempdir, self.base_commit)
+        changed_files = []
+        for line in diff.splitlines():
+            m = re.match(r'^diff --git a/(.*) b/(.*)$', line)
+            if not m:
+                continue
+            path = m.group(2)
+            changed_files.append((path, _is_test_path(path)))
+        is_empty = len(changed_files) == 0 and not diff.strip()
+        has_source_edit = any(not is_test for _, is_test in changed_files)
+        return is_empty, has_source_edit, changed_files
