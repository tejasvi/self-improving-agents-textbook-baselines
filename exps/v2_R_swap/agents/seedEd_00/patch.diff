+def _is_test_path(path):
+    """
+    Return True if a repo-relative path looks like a test file:
+    a path component named 'test'/'tests'/'spec', a filename starting with 'test_',
+    or a filename of the form '*_test.*'.
+    """
+    parts = path.replace('\\', '/').split('/')
+    for comp in parts[:-1]:
+        if comp.lower() in ('test', 'tests', 'spec'):
+            return True
+    name = parts[-1].lower()
+    stem = name.split('.')[0]
+    if name.startswith('test_') or stem.endswith('_test'):
+        return True
+    return False
