diff --git a/tools/sample_tester.py b/tools/sample_tester.py
new file mode 100644
index 0000000..df2533f
--- /dev/null
+++ b/tools/sample_tester.py
@@ -0,0 +1,140 @@
+import difflib
+import subprocess
+
+SAMPLE_TIMEOUT_SECONDS = 10
+
+
+def tool_info():
+    return {
+        "name": "sample_tester",
+        "description": """Run a Python solution program on sample test cases and report the results.\n
+* Each sample's `input` is fed to `python3 solution_path` via stdin, with a timeout.\n
+* For every sample it reports PASS or FAIL, the actual output, the expected output, and a whitespace-normalized diff.\n
+* Raw outputs are returned as-is so you can analyze them yourself.\n
+* Extract the samples from the problem statement (see `problem_file`) and pass them in `samples`.\n
+* A PASS means the output matches the expected output line by line, ignoring trailing whitespace and leading/trailing blank lines. Note that a FAIL on a problem accepting multiple answers still means the output differs from the sample and should be investigated.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed as `python3 solution_path`)."
+                },
+                "problem_file": {
+                    "type": "string",
+                    "description": "Optional path to a file containing the problem statement, for reference when extracting samples."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases to run against the solution.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact standard input given to the solution."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected standard output for this input."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _normalize(text):
+    """Strip trailing whitespace on each line and leading/trailing blank lines."""
+    lines = [line.rstrip() for line in text.replace("\r\n", "\n").split("\n")]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def _run_sample(solution_path, sample_input):
+    try:
+        proc = subprocess.run(
+            ["python3", solution_path],
+            input=sample_input,
+            capture_output=True,
+            text=True,
+            timeout=SAMPLE_TIMEOUT_SECONDS,
+        )
+        stdout = proc.stdout
+        stderr = proc.stderr
+        returncode = proc.returncode
+        timed_out = False
+    except subprocess.TimeoutExpired as e:
+        stdout = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
+        stderr = e.stderr.decode(errors="replace") if isinstance(e.stderr, bytes) else (e.stderr or "")
+        returncode = None
+        timed_out = True
+    return stdout, stderr, returncode, timed_out
+
+
+def tool_function(solution_path: str, problem_file: str = None, samples: list = None) -> str:
+    try:
+        if not samples:
+            hint = f" (problem statement is at {problem_file})" if problem_file else ""
+            return ("Error: no samples provided. Extract the sample inputs and expected outputs "
+                    f"from the problem statement{hint} and pass them in `samples`.")
+
+        header = []
+        if problem_file:
+            header.append(f"Problem statement file: {problem_file}")
+        header.append(f"Solution: python3 {solution_path}")
+        header.append(f"Samples: {len(samples)}")
+
+        blocks = []
+        passed = 0
+        for idx, sample in enumerate(samples, start=1):
+            if not isinstance(sample, dict) or "input" not in sample or "expected" not in sample:
+                blocks.append(f"=== Sample {idx}: FAIL (malformed sample: each sample needs string fields 'input' and 'expected') ===")
+                continue
+            sample_input = str(sample["input"])
+            expected = str(sample["expected"])
+
+            stdout, stderr, returncode, timed_out = _run_sample(solution_path, sample_input)
+
+            if timed_out:
+                status = f"FAIL (timeout after {SAMPLE_TIMEOUT_SECONDS}s)"
+            else:
+                match = _normalize(stdout) == _normalize(expected)
+                status = "PASS" if match else "FAIL"
+                if match:
+                    passed += 1
+
+            diff_lines = difflib.unified_diff(
+                _normalize(expected), _normalize(stdout),
+                fromfile="expected", tofile="actual", lineterm="",
+            )
+            diff_text = "\n".join(diff_lines) or "(no differences after whitespace normalization)"
+
+            block = [
+                f"=== Sample {idx}: {status} ===",
+                "--- input ---",
+                sample_input.rstrip("\n"),
+                "--- actual output ---",
+                stdout.rstrip("\n"),
+                "--- expected output ---",
+                expected.rstrip("\n"),
+                "--- diff (whitespace-normalized) ---",
+                diff_text,
+            ]
+            if stderr.strip():
+                block += ["--- stderr ---", stderr.rstrip("\n")]
+            if returncode not in (0, None):
+                block.append(f"--- exit code: {returncode} ---")
+            blocks.append("\n".join(block))
+
+        summary = f"Summary: {passed}/{len(samples)} samples passed."
+        return "\n".join(header) + "\n\n" + "\n\n".join(blocks) + "\n\n" + summary
+    except Exception as e:
+        return f"Error: {str(e)}"
