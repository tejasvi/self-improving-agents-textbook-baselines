+    def _changed_files(self):
+        """
+        Return the list of modified, added, or untracked file paths in git_tempdir
+        (relative to the repo root), as reported by `git status --porcelain`.
+        """
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "-uall"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+        files = []
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            # Renames appear as "old -> new"
+            if " -> " in path:
+                path = path.split(" -> ", 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                files.append(path)
+        return files
+
+    @staticmethod
+    def _is_test_path(path):
+        """
+        Generic check for whether a path refers to a test file.
+        """
+        normalized = path.replace('\\', '/').lower()
+        parts = [p for p in normalized.split('/') if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        dirs = parts[:-1]
+        if any(d in ('tests', 'test', 'spec', 'specs', '__tests__') for d in dirs):
+            return True
+        stem = basename.split('.', 1)[0]
+        if stem in ('test', 'tests', 'spec') or stem.startswith(('test_', 'spec_')) or stem.endswith(('_test', '_spec', '.test', '.spec')):
+            return True
+        if basename.endswith(('.test.js', '.spec.js', '.test.ts', '.spec.ts', 'test.java', 'test.go', '_test.go', '_test.rs')):
+            return True
+        return False
+
+    def _has_source_patch(self):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_path(f) for f in self._changed_files())
+
