+def _changed_files(diff_str):
+    """
+    Parse the `diff --git a/X b/X` header lines of a diff and return the list of paths.
+    """
+    files = []
+    for line in str(diff_str).splitlines():
+        if line.startswith('diff --git '):
+            parts = line.split(' ')
+            if len(parts) >= 4 and parts[2].startswith('a/'):
+                path = parts[2][2:]
+                if path not in files:
+                    files.append(path)
+    return files
+
+def _is_test_file(path):
+    """
+    Check whether a path looks like a test file (lowercase pattern match).
+    """
+    p = str(path).lower().replace('\\', '/')
+    basename = p.split('/')[-1]
+    if 'test' in basename:
+        return True
+    dirs = p.split('/')[:-1]
+    return any(d in ('tests', 'test', 'spec') for d in dirs)
