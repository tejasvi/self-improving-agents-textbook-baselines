+def _is_test_path(path):
+    """Return True if a repo-relative path looks like a test file."""
+    parts = path.replace('\\', '/').split('/')
+    test_words = ('test', 'tests', 'spec')
+    # Any directory component named test/tests/spec
+    for part in parts[:-1]:
+        if part.lower() in test_words:
+            return True
+    # Filename: stem (before first dot) is test/tests/spec, or starts with test_, or ends with _test
+    name = parts[-1].lower()
+    stem = name.split('.')[0]
+    return (
+        stem in test_words or
+        name.startswith('test_') or
+        re.fullmatch(r'.*_test\..*', name) is not None
+    )
