+    def _call_agent(self, msg, msg_history):
+        """Call the agent; return the resulting history list, or None if unusable."""
+        try:
+            result = chat_with_agent(msg, model=self.code_model, msg_history=list(msg_history), logging=safe_log)
+        except Exception as e:
+            safe_log(f"chat_with_agent failed: {e}")
+            return None
+        if not isinstance(result, list):
+            return None
+        return result
