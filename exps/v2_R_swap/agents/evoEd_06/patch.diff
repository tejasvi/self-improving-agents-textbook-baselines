+    def _changed_files(self):
+        """Return modified or untracked file paths relative to the repo root."""
+        result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "status", "--porcelain", "--untracked-files=all"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
+        )
+        files = []
+        for line in result.stdout.decode(errors='replace').splitlines():
+            if len(line) < 4:
+                continue
+            path = line[3:]
+            if " -> " in path:  # rename: keep the new path
+                path = path.split(" -> ", 1)[1]
+            path = path.strip().strip('"')
+            if path:
+                files.append(path)
+        return files
+
+    @staticmethod
+    def _is_test_path(path):
+        """Generic test-file check based on path components and file name."""
+        parts = [p.lower() for p in path.replace("\\", "/").split("/") if p]
+        if not parts:
+            return False
+        basename = parts[-1]
+        if any(d in ("tests", "test", "spec") for d in parts[:-1]):
+            return True
+        if fnmatch.fnmatch(basename, "test_*.py") or fnmatch.fnmatch(basename, "*_test.py"):
+            return True
+        stem = basename.rsplit(".", 1)[0] if "." in basename else basename
+        return stem in ("test", "tests", "spec")
+
+    def _has_source_patch(self):
+        """True if at least one changed file is not a test file."""
+        return any(not self._is_test_path(f) for f in self._changed_files())
