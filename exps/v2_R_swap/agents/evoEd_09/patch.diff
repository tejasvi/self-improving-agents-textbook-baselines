+import shutil
+import subprocess
+import sys
+
+from utils.llm_withtools import chat_with_agent
+
+SOL = "solution.py"
+TESTS_DIR = "/tmp/tests"
+STRESS = "/tmp/stress.py"
+K = 3
+RUN_TIMEOUT = 10
+STRESS_TIMEOUT = 600
+
+
+def run_samples(sol_path):
+    """Run solution on every sample_*.in/.out pair. Returns (passed, total, raw_report)."""
+    passed = 0
+    total = 0
+    report = []
+    for inp in sorted(glob.glob(os.path.join(TESTS_DIR, "sample_*.in"))):
+        out = inp[:-3] + ".out"
+        if not os.path.exists(out):
+            continue
+        total += 1
+        expected = open(out).read()
+        try:
+            with open(inp) as fi:
+                r = subprocess.run([sys.executable, sol_path], stdin=fi,
+                                   capture_output=True, text=True, timeout=RUN_TIMEOUT)
+            ok = r.stdout.split() == expected.split()
+            report.append(f"[{os.path.basename(inp)}] {'PASS' if ok else 'FAIL'}\n"
+                          f"expected: {expected.strip()}\n"
+                          f"actual:   {r.stdout.strip()}\n"
+                          f"stderr:   {r.stderr.strip()[-500:]}")
+        except subprocess.TimeoutExpired:
+            ok = False
+            report.append(f"[{os.path.basename(inp)}] TIMEOUT")
+        if ok:
+            passed += 1
+    return passed, total, "\n".join(report)
+
+
+def run_stress(sol_path):
+    """Run /tmp/stress.py if present. Returns (ok, raw_output)."""
+    if not os.path.exists(STRESS):
+        return False, "stress script /tmp/stress.py does not exist"
+    try:
+        r = subprocess.run([sys.executable, STRESS], capture_output=True, text=True,
+                           timeout=STRESS_TIMEOUT, env={**os.environ, "SOL_PATH": sol_path})
+        return r.returncode == 0, (r.stdout + "\n" + r.stderr)[-3000:]
+    except subprocess.TimeoutExpired:
+        return False, "stress script timed out"
+
+
+def score_of(sol_path):
+    passed, total, sample_report = run_samples(sol_path)
+    stress_ok, stress_report = run_stress(sol_path)
+    all_samples = total > 0 and passed == total
+    # Higher is better: samples first, then stress success.
+    score = (passed, int(all_samples and stress_ok))
+    return score, sample_report, stress_report
+
 
