+    # ------------------------------------------------------------ agent helpers
+    def _run_agent(self, prompt, history):
+        self._log(f"chat_with_agent call (prompt chars={len(prompt)})")
+        try:
+            new_history = chat_with_agent(prompt, model=self.model, msg_history=history,
+                                          logging=self._log)
+        except Exception as e:  # keep the pipeline alive; the guard will re-prompt
+            self._log(f"chat_with_agent raised: {e!r}")
+            return "", history
+        if new_history is None:
+            new_history = history
+        return self._last_assistant_text(new_history), new_history
+
+    @staticmethod
+    def _content_to_text(content):
+        if content is None:
+            return ""
+        if isinstance(content, str):
+            return content
+        if isinstance(content, list):
+            parts = []
+            for part in content:
+                if isinstance(part, dict):
+                    parts.append(str(part.get("text", "")))
+                else:
+                    parts.append(str(part))
+            return "\n".join(parts)
+        return str(content)
+
+    def _last_assistant_text(self, history):
+        for msg in reversed(history or []):
+            if isinstance(msg, dict):
+                if msg.get("role") == "assistant":
+                    return self._content_to_text(msg.get("content"))
+            else:
+                role = getattr(msg, "role", None)
+                if role == "assistant":
+                    return self._content_to_text(getattr(msg, "content", ""))
+        return ""
+
+    # ------------------------------------------------------------- file checks
+    def _solution_path(self):
+        return os.path.join(self.git_tempdir, "solution.py")
+
+    def _solution_ok(self):
+        path = self._solution_path()
+        if not os.path.isfile(path):
+            return False
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                return f.read().strip() != ""
+        except OSError:
+            return False
+
+    def _clear_report(self):
+        try:
+            if os.path.exists(REPORT_PATH):
+                os.remove(REPORT_PATH)
+        except OSError:
+            pass
+
+    def _read_report(self):
+        try:
+            with open(REPORT_PATH, "r", encoding="utf-8", errors="replace") as f:
+                return f.read()
+        except OSError:
+            return ""
+
+    # ---------------------------------------------------------------- scoring
+    def _evaluate(self, reply):
+        """Harness-side scoring. Raw output is passed through; no error parsing."""
+        solution_ok = self._solution_ok()
+        text = (reply or "") + "\n" + self._read_report()
+        matches = STRESS_RE.findall(text)
+        if matches:
+            pass_rate_str, timing = matches[-1]
+            pass_rate = float(pass_rate_str)
+            timing_ok = timing == "ok"
+        else:
+            pass_rate = 0.0
+            timing_ok = False
+        score = (1 if solution_ok else 0, pass_rate, 1 if timing_ok else 0)
+        perfect = solution_ok and pass_rate >= 1.0 and timing_ok
+        return score, perfect
+
+    def _snapshot_patch(self):
+        try:
+            patch = diff_versus_commit(self.git_tempdir, self.base_commit)
+        except Exception as e:
+            self._log(f"diff_versus_commit failed: {e!r}")
+            return ""
+        return patch or ""
