+    def _get_changed_files(self):
+        """
+        Return the list of files changed versus base_commit, including untracked files.
+        """
+        files = []
+        diff_cmd = ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit]
+        result = subprocess.run(diff_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        files.extend(line.strip() for line in result.stdout.decode().splitlines() if line.strip())
+
+        untracked_cmd = ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"]
+        result = subprocess.run(untracked_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+        files.extend(line.strip() for line in result.stdout.decode().splitlines() if line.strip())
+
+        # Deduplicate while preserving order
+        return list(dict.fromkeys(files))
+
+    @staticmethod
+    def _is_test_file(path):
+        normalized = path.replace('\\', '/')
+        parts = normalized.split('/')
+        name = parts[-1]
+        dirs = parts[:-1]
+        if any(d in ('test', 'tests', '__tests__', 'spec', 'specs') for d in dirs):
+            return True
+        test_name_patterns = [
+            r'^test_.*\.py$', r'^.*_test\.py$', r'^.*\.spec\.[jt]sx?$', r'^.*\.test\.[jt]sx?$',
+            r'^.*_test\.go$', r'^.*_test\.(cc|cpp|cxx)$', r'^.*Test\.java$', r'^.*Tests?\.(cs|kt|scala)$',
+            r'^test_.*\.(rs|cc|cpp)$', r'^.*_spec\.rb$', r'^.*_test\.rb$',
+        ]
+        return any(re.match(pat, name) for pat in test_name_patterns)
+
+    def _has_source_edit(self, files):
+        """
+        Return True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in files)
+
