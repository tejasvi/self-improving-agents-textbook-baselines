+    def _get_changed_files(self):
+        """
+        Return the list of files changed versus base_commit: tracked changes
+        (git diff --name-only) plus untracked files (git ls-files --others).
+        """
+        files = []
+        diff_result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "diff", "--name-only", self.base_commit],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        files += diff_result.stdout.decode(errors='replace').splitlines()
+        untracked_result = subprocess.run(
+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
+        )
+        files += untracked_result.stdout.decode(errors='replace').splitlines()
+        return [f.strip() for f in files if f.strip()]
+
+    @staticmethod
+    def _is_test_file(path):
+        """
+        Generic heuristic: True if the path looks like a test file or lives in a test directory.
+        """
+        normalized = path.replace('\\', '/')
+        parts = normalized.split('/')
+        name = parts[-1].lower()
+        dirs = [d.lower() for d in parts[:-1]]
+        if any(d in ('test', 'tests', '__tests__', 'spec', 'specs') for d in dirs):
+            return True
+        if name.startswith('test_') or name.startswith('test.') or name == 'conftest.py':
+            return True
+        if name.endswith('_test.py') or name.endswith('_test.go') or name.endswith('_test.rs'):
+            return True
+        if any(name.endswith(suffix) for suffix in ('.test.js', '.test.ts', '.spec.js', '.spec.ts', '.test.jsx', '.spec.jsx')):
+            return True
+        if name.endswith('test.java') or name.endswith('tests.java'):
+            return True
+        return False
+
+    def _has_source_edit(self, files):
+        """
+        True if at least one changed file is not a test file.
+        """
+        return any(not self._is_test_file(f) for f in files)
+
