+    def _changed_files(self):
+        """
+        Return the list of file paths changed versus base_commit, parsed from
+        'diff --git a/X b/X' header lines.
+        """
+        diff = str(diff_versus_commit(self.git_tempdir, self.base_commit))
+        files = []
+        for line in diff.splitlines():
+            if line.startswith('diff --git a/'):
+                parts = line[len('diff --git a/'):].split(' b/')
+                path = parts[-1] if len(parts) > 1 else parts[0]
+                files.append(path.strip())
+        return files
+
+    @staticmethod
+    def _is_test_path(path):
+        p = path.lower()
+        if not p.startswith('/'):
+            p = '/' + p
+        return (
+            '/test' in p
+            or 'tests/' in p
+            or 'test_' in p
+            or '_test.' in p
+            or '.spec.' in p
+            or '.test.' in p
+        )
+
+    def _has_meaningful_patch(self):
+        """
+        True if at least one non-test file has been changed versus base_commit.
+        """
+        try:
+            changed = self._changed_files()
+        except Exception as e:
+            safe_log(f"Failed to inspect diff: {e}", level=logging.WARNING)
+            return False
+        return any(not self._is_test_path(path) for path in changed)
+
