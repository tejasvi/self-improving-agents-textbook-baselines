diff --git a/tools/sample_tester.py b/tools/sample_tester.py
new file mode 100644
index 0000000..7e0f4fe
--- /dev/null
+++ b/tools/sample_tester.py
@@ -0,0 +1,138 @@
+import difflib
+import os
+import subprocess
+import sys
+
+DEFAULT_TIMEOUT = 10  # seconds per sample
+
+
+def tool_info():
+    return {
+        "name": "sample_tester",
+        "description": """Run a Python solution program on sample test cases and report the raw results.\n
+* For each sample, runs `python3 solution_path` with the sample's input on stdin (with a timeout).\n
+* Reports PASS/FAIL per sample, the actual output, the expected output, and a whitespace-normalized diff.\n
+* Samples can be given directly via `samples`, and/or the problem statement file can be given via `problem_file` for reference.\n
+* Outputs are returned raw; analyze them yourself.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run, e.g. /path/to/solution.py."
+                },
+                "problem_file": {
+                    "type": "string",
+                    "description": "Optional path to a file containing the problem statement (for reference)."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "Optional list of sample test cases to run.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "The exact standard input given to the solution."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "The expected standard output for this input."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                }
+            },
+            "required": ["solution_path"]
+        }
+    }
+
+
+def _normalize(text):
+    """Whitespace-normalize text: strip each line's trailing spaces and drop trailing blank lines."""
+    lines = [line.split() for line in text.splitlines()]
+    lines = [" ".join(tokens) for tokens in lines]
+    while lines and lines[-1] == "":
+        lines.pop()
+    return lines
+
+
+def _run_one(solution_path, stdin_text, timeout):
+    try:
+        proc = subprocess.run(
+            [sys.executable, solution_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, proc.returncode, False
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
+        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
+        return out, err, None, True
+    except Exception as e:
+        return "", str(e), None, False
+
+
+def tool_function(solution_path, problem_file=None, samples=None):
+    try:
+        if not os.path.exists(solution_path):
+            return f"Error: solution file {solution_path} does not exist."
+        if not samples:
+            msg = "No samples provided."
+            if problem_file:
+                msg += f" Problem statement is at {problem_file}; extract the samples and call again."
+            return msg
+
+        results = []
+        passed = 0
+        for idx, sample in enumerate(samples, start=1):
+            stdin_text = sample.get("input", "")
+            expected = sample.get("expected", "")
+            out, err, returncode, timed_out = _run_one(solution_path, stdin_text, DEFAULT_TIMEOUT)
+
+            if timed_out:
+                status = "FAIL (timeout)"
+            elif returncode != 0:
+                status = f"FAIL (exit code {returncode})"
+            elif _normalize(out) == _normalize(expected):
+                status = "PASS"
+                passed += 1
+            else:
+                status = "FAIL"
+
+            diff = "\n".join(difflib.unified_diff(
+                _normalize(expected),
+                _normalize(out),
+                fromfile="expected",
+                tofile="actual",
+                lineterm="",
+            ))
+
+            block = [
+                f"=== Sample {idx}: {status} ===",
+                "--- input ---",
+                stdin_text,
+                "--- actual output ---",
+                out,
+            ]
+            if err.strip():
+                block += ["--- stderr ---", err]
+            block += [
+                "--- expected output ---",
+                expected,
+                "--- diff (whitespace-normalized) ---",
+                diff if diff else "(no difference)",
+            ]
+            results.append("\n".join(block))
+
+        summary = f"Summary: {passed}/{len(samples)} samples passed."
+        return summary + "\n\n" + "\n\n".join(results)
+    except Exception as e:
+        return f"Error: {str(e)}"
+
+
+if __name__ == "__main__":
+    print(tool_function("/tmp/solution.py", samples=[{"input": "1\n", "expected": "1\n"}]))
