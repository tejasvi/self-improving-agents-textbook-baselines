+    def _run_tests(self, test_cmd, timeout):
+        """
+        Run the test command under git_tempdir with a timeout.
+        Returns (passed: bool, output: str) where output is the raw combined
+        stdout/stderr truncated to its last ~MAX_OUTPUT_CHARS characters.
+        No error parsing is performed; the raw text is handed to the agent.
+        """
+        try:
+            proc = subprocess.run(
+                test_cmd,
+                cwd=self.git_tempdir,
+                capture_output=True,
+                text=True,
+                timeout=timeout,
+            )
+            passed = proc.returncode == 0
+            output = (proc.stdout or "") + (proc.stderr or "")
+        except subprocess.TimeoutExpired as e:
+            passed = False
+            out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
+            err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
+            output = f"TIMEOUT after {timeout}s\n" + out + err
+        except Exception as e:  # e.g. pytest not installed
+            passed = False
+            output = f"Failed to run test command {test_cmd}: {e}"
+        if len(output) > MAX_OUTPUT_CHARS:
+            output = "...(truncated)...\n" + output[-MAX_OUTPUT_CHARS:]
+        return passed, output
+
+    def _run_test_suite(self):
+        """Run the generated test file. Returns (passed, n_passed, output)."""
+        if not os.path.exists(TEST_FILE):
+            return False, 0, f"Test file {TEST_FILE} does not exist."
+        passed, output = self._run_tests(["python3", "-m", "pytest", "-q", "--tb=short", TEST_FILE], TEST_TIMEOUT)
+        m = re.findall(r"(\d+) passed", output)
+        n_passed = int(m[-1]) if m else 0
+        return passed, n_passed, output
+
