+import os
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "run_timed",
+        "description": """Run a shell command with a wall-clock time limit and report the result.\n
+* Use this to benchmark a solution (e.g. `python solution.py < big.in`) and to detect timeouts.\n
+* The command runs in its own process group; on timeout the whole group is killed.\n
+* Returns a status line 'STATUS: OK|TIMEOUT|ERROR, ELAPSED: x.xs' followed by the (truncated) STDOUT and STDERR.\n
+* Use plain `bash` for ordinary commands; use this tool when you need timing or a hard time limit.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. 'python solution.py < big.in'."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Wall-clock time limit in seconds (default 15)."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n...[truncated {len(text) - MAX_OUTPUT_CHARS} chars]...\n" + text[-half:]
+
+
+def tool_function(command, timeout_seconds=15):
+    try:
+        timeout = float(timeout_seconds) if timeout_seconds is not None else 15.0
+    except (TypeError, ValueError):
+        timeout = 15.0
+    timeout = max(0.1, min(timeout, 600.0))
+
+    start = time.monotonic()
+    try:
+        proc = subprocess.Popen(
+            ['bash', '-c', command],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+    except Exception as e:
+        return f"STATUS: ERROR, ELAPSED: 0.0s\nSTDOUT:\n\nSTDERR:\nFailed to start command: {e}"
+
+    status = 'OK'
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        status = 'TIMEOUT'
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            # Pipes still held by a stubborn grandchild; give up on collecting output.
+            stdout, stderr = '', ''
+    elapsed = time.monotonic() - start
+
+    if status == 'OK' and proc.returncode != 0:
+        status = 'ERROR'
+    if status == 'TIMEOUT':
+        stderr = (stderr or '') + f"\n[killed after {timeout:g}s timeout]"
+
+    return (
+        f"STATUS: {status}, ELAPSED: {elapsed:.1f}s, EXIT_CODE: {proc.returncode}\n"
+        f"STDOUT:\n{_truncate(stdout or '')}\n"
+        f"STDERR:\n{_truncate(stderr or '')}"
+    )
