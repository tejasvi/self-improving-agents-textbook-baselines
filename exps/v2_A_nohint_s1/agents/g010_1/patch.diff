+SNAPSHOT_MAX_CHARS = 4000
+SNAPSHOT_SKIP_DIRS = {'.git', '__pycache__', 'node_modules', 'build'}
+
+
+def _read_repo_snapshot(git_tempdir, max_chars=SNAPSHOT_MAX_CHARS):
+    """
+    Lists files in git_tempdir and returns a text snapshot containing the file
+    listing plus the contents of solution.py and other small files (truncated).
+    """
+    lines = []
+    file_paths = []
+    for root, dirs, files in os.walk(git_tempdir):
+        dirs[:] = sorted(d for d in dirs if d not in SNAPSHOT_SKIP_DIRS)
+        for name in sorted(files):
+            file_paths.append(os.path.relpath(os.path.join(root, name), git_tempdir))
+    lines.append("Files in repository:")
+    lines.extend(f"  {p}" for p in file_paths[:200])
+    if len(file_paths) > 200:
+        lines.append(f"  ... ({len(file_paths) - 200} more files)")
+
+    # solution.py first, then other small files
+    ordered = sorted(file_paths, key=lambda p: (os.path.basename(p) != 'solution.py', p))
+    for rel in ordered:
+        full = os.path.join(git_tempdir, rel)
+        try:
+            if os.path.getsize(full) > max_chars:
+                continue
+            with open(full, 'r', encoding='utf-8', errors='replace') as f:
+                content = f.read()
+        except OSError:
+            continue
+        if len(content) > max_chars:
+            content = content[:max_chars] + "\n... (truncated)"
+        lines.append(f"\n--- {rel} ---\n{content}")
+    return "\n".join(lines)
+
