+    def _fallback_write_solution(self, sol_path):
+        """
+        Last resort: ask the LLM directly (no tools) for a single python code block and write it to sol_path.
+        Returns True if a file was written.
+        """
+        prompt = (
+            f"Solve the following competitive programming problem in Python.\n\n"
