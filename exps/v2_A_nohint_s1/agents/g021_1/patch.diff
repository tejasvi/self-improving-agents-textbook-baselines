+        try:
+            safe_log("[fallback] Requesting solution directly from the LLM without tools")
+            client, client_model = create_client(self.code_model)
+            response, _ = get_response_from_llm(
+                msg=prompt,
+                client=client,
+                model=client_model,
+                system_message="You are an expert competitive programmer. Reply only with a python code block.",
+                print_debug=False,
+                msg_history=[],
+            )
+            safe_log(f"[fallback] Raw response: {response}")
+            match = re.search(r"```python\s*\n(.*?)```", response, re.DOTALL)
+            if not match:
+                safe_log("[fallback] No ```python block found in response")
+                return False
+            code = match.group(1)
+            os.makedirs(os.path.dirname(sol_path) or '.', exist_ok=True)
+            with open(sol_path, 'w') as f:
+                f.write(code)
+            safe_log(f"[fallback] Wrote {sol_path} ({len(code)} chars)")
+            return True
+        except Exception as e:
+            safe_log(f"[fallback] Failed: {e}")
+            return False
