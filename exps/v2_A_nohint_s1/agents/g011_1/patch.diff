+    def _has_changes(self):
+        """Return True if the repository differs from the base commit (non-empty diff)."""
+        try:
+            return str(diff_versus_commit(self.git_tempdir, self.base_commit)).strip() != ''
+        except Exception as e:
+            safe_log(f"[forward] Exception while computing diff: {e}", level=logging.ERROR)
+            return False
+
+    def _clean_history(self, msg_history):
+        """Remove messages whose content is only empty text blocks (or an empty string)."""
+        cleaned = []
+        for msg in msg_history or []:
+            content = msg.get('content') if isinstance(msg, dict) else None
+            if isinstance(content, str):
+                if content.strip() == '':
+                    continue
+            elif isinstance(content, list):
+                blocks = [b for b in content if not (
+                    isinstance(b, dict) and b.get('type') == 'text' and str(b.get('text', '')).strip() == ''
+                )]
+                if len(blocks) == 0:
+                    continue
+                msg = {**msg, 'content': blocks}
+            cleaned.append(msg)
+        return cleaned
+
+    def _deliverable_name(self):
+        """Detect the deliverable filename from the problem statement (default solution.py)."""
+        match = re.search(r'`([\w./-]+\.py)`', self.problem_statement or '')
+        if match:
+            return match.group(1)
+        return 'solution.py'
+
+    def _fallback_write_solution(self):
+        """Ask the LLM for the full program in one python block and write it to the deliverable."""
+        client, client_model = create_client(self.code_model)
+        prompt = (
+            "Output only the complete Python 3 program in a single ```python code block. "
+            "No explanation.\n\n<problem_description>\n"
+            f"{self.problem_statement}\n</problem_description>"
+        )
+        _, new_history = get_response_from_llm(
+            prompt, client=client, model=client_model,
+            system_message="You are an expert competitive programmer.",
+            msg_history=[], temperature=0.0,
+        )
+        content = ''
+        for msg in reversed(new_history):
+            if msg.get('role') == 'assistant':
+                c = msg.get('content')
+                if isinstance(c, list):
+                    c = ''.join(b.get('text', '') for b in c if isinstance(b, dict))
+                content = c or ''
+                break
+        block = re.search(r'```(?:python|py)?\s*\n(.*?)```', content, re.DOTALL)
+        if not block:
+            safe_log("[forward] Fallback: no python code block found in model output.", level=logging.WARNING)
+            return
+        code = block.group(1)
+        out_path = os.path.join(self.git_tempdir, self._deliverable_name())
+        os.makedirs(os.path.dirname(out_path) or '.', exist_ok=True)
+        with open(out_path, 'w') as f:
+            f.write(code)
+        safe_log(f"[forward] Fallback wrote {out_path}.")
+
