+def _block_field(block, field):
+    """Read a field from a message content block that may be a dict or an SDK object."""
+    if isinstance(block, dict):
+        return block.get(field)
+    return getattr(block, field, None)
+
+
+def _last_assistant_text(msg_history):
+    """Return the concatenated text of the last assistant message ('' if none)."""
+    for msg in reversed(msg_history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role != 'assistant':
+            continue
+        content = msg.get('content') if isinstance(msg, dict) else getattr(msg, 'content', None)
+        if content is None:
+            return ''
+        if isinstance(content, str):
+            return content
+        parts = []
+        for block in content:
+            if _block_field(block, 'type') == 'text':
+                text = _block_field(block, 'text')
+                if text:
+                    parts.append(text)
+        return ''.join(parts)
+    return ''
+
+
+def _extract_code_block(text):
+    """Return the contents of the last ```python ... ``` block in text, or None."""
+    if not text:
+        return None
+    blocks = re.findall(r"```python[ \t]*\n(.*?)```", text, re.DOTALL)
+    if not blocks:
+        return None
+    return blocks[-1]
+
+
+def _is_empty_response(msg_history):
+    """True when the last assistant message has no non-empty text and no tool_use blocks."""
+    last = None
+    for msg in reversed(msg_history or []):
+        role = msg.get('role') if isinstance(msg, dict) else getattr(msg, 'role', None)
+        if role == 'assistant':
+            last = msg
+            break
+    if last is None:
+        return True
+    content = last.get('content') if isinstance(last, dict) else getattr(last, 'content', None)
+    if content is None:
+        return True
+    if isinstance(content, str):
+        return content.strip() == ''
+    for block in content:
+        if _block_field(block, 'type') == 'tool_use':
+            return False
+        text = _block_field(block, 'text')
+        if text and str(text).strip():
+            return False
+    return True
+
