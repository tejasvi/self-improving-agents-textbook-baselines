+import json
+import os
+import subprocess
+import sys
+
+
+STARTER_FILE = "solution.py"
+
+
+def _log(msg):
+    print(f"[coding_agent] {msg}", flush=True)
+
+
+def _list_dir(git_tempdir):
+    try:
+        out = subprocess.run(
+            ["ls", "-la"], cwd=git_tempdir, capture_output=True, text=True, timeout=30
+        )
+        return out.stdout
+    except Exception as e:
+        return f"(ls failed: {e})"
+
+
+def _find_starter_file(git_tempdir):
+    """Return (filename, content) of solution.py or the first .py containing 'class Solution'."""
+    path = os.path.join(git_tempdir, STARTER_FILE)
+    if os.path.exists(path):
+        with open(path, "r", encoding="utf-8", errors="replace") as f:
+            return STARTER_FILE, f.read()
+    try:
+        names = sorted(os.listdir(git_tempdir))
+    except Exception:
+        return None, ""
+    for name in names:
+        if not name.endswith(".py"):
+            continue
+        p = os.path.join(git_tempdir, name)
+        try:
+            with open(p, "r", encoding="utf-8", errors="replace") as f:
+                content = f.read()
+        except Exception:
+            continue
+        if "class Solution" in content:
+            return name, content
+    return None, ""
+
+
+def _starter_context(git_tempdir):
+    listing = _list_dir(git_tempdir)
+    name, content = _find_starter_file(git_tempdir)
+    if name is None:
+        starter = "(no starter file found)"
+    else:
+        starter = f"--- {name} ---\n{content}"
+    return f"Repository listing (ls -la):\n{listing}\nStarter code:\n{starter}\n"
+
+
+def _has_class_solution(git_tempdir):
+    _, content = _find_starter_file(git_tempdir)
+    return "class Solution" in content
+
+
+def _deliverable_exists(git_tempdir):
+    return os.path.exists(os.path.join(git_tempdir, STARTER_FILE))
+
+
+def _last_assistant_empty(msg_history):
+    """True if the last assistant message has no text and no tool_use blocks."""
+    for msg in reversed(msg_history):
+        if msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if content is None:
+            return True
+        if isinstance(content, str):
+            return content.strip() == ""
+        has_text = False
+        for block in content:
+            if isinstance(block, dict):
+                if block.get("type") == "tool_use":
+                    return False
+                if block.get("type") == "text" and block.get("text", "").strip():
+                    has_text = True
+            elif isinstance(block, str) and block.strip():
+                has_text = True
+        return not has_text
+    return True
+
+
+def _last_assistant_text(msg_history):
+    for msg in reversed(msg_history):
+        if msg.get("role") != "assistant":
+            continue
+        content = msg.get("content")
+        if isinstance(content, str):
+            return content
+        parts = []
+        for block in content or []:
+            if isinstance(block, dict) and block.get("type") == "text":
+                parts.append(block.get("text", ""))
+            elif isinstance(block, str):
+                parts.append(block)
+        return "\n".join(parts)
+    return ""
+
+
+def _tool_called(msg_history):
+    for msg in msg_history:
+        content = msg.get("content")
+        if isinstance(content, list):
+            for block in content:
+                if isinstance(block, dict) and block.get("type") == "tool_use":
+                    return True
+    return False
+
+
