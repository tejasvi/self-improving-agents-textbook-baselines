+def _extract_code_tolerant(text):
+    """Extract code from any fenced block (any/no language tag), or the raw text if it looks like code."""
+    text = text or ''
+    matches = re.findall(r"```[A-Za-z0-9_+-]*[ \t]*\n(.*?)```", text, re.DOTALL)
+    matches = [m for m in matches if m.strip()]
+    if matches:
+        return max(matches, key=len).rstrip() + "\n"
+    stripped = text.strip()
+    if stripped and ('import' in stripped or 'def ' in stripped or 'input(' in stripped):
+        return stripped + "\n"
+    return ''
