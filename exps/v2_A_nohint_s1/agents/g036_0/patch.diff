index 0000000..8694af2
--- /dev/null
+++ b/tools/sample_check.py
@@ -0,0 +1,111 @@
+import subprocess
+
+TIMEOUT_SECONDS = 10
+MAX_CHARS = 2000
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution command on each sample input and compare its stdout with the expected output.\n
+* Give `solution_cmd` as a shell command (e.g. 'cd /path/to/repo && python solution.py') that reads stdin and writes stdout.\n
+* Give `samples` as an array of objects, each with `input` (exact stdin text) and `expected` (exact expected stdout text), copied from the problem statement.\n
+* Each sample gets a verdict: PASS (exact match, ignoring trailing whitespace), EXACT-MISMATCH (output differs from the expected text; expected and actual are shown side by side), or ERROR (non-zero exit, timeout; stderr shown).\n
+* A bold WARNING line is printed when the output differs but has the same tokens; the hidden grader may still compare exactly, so reproduce the sample output exactly whenever possible.\n
+* Each sample has a 10 second timeout.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "solution_cmd": {
+                    "type": "string",
+                    "description": "Shell command that runs the solution on stdin, e.g. 'python solution.py'."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases taken from the problem statement.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact sample input text given to stdin."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Exact expected stdout text for this sample input."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                }
+            },
+            "required": ["solution_cmd", "samples"]
+        }
+    }
+
+
+def _trunc(text):
+    text = text or ''
+    if len(text) <= MAX_CHARS:
+        return text
+    return text[:MAX_CHARS] + f"\n...[truncated {len(text) - MAX_CHARS} chars]"
+
+
+def _norm_lines(text):
+    return [line.rstrip() for line in (text or '').rstrip().splitlines()]
+
+
+def tool_function(solution_cmd, samples):
+    if not isinstance(samples, list) or not samples:
+        return "ERROR: no samples provided."
+    lines = []
+    counts = {'PASS': 0, 'EXACT-MISMATCH': 0, 'ERROR': 0}
+    for i, s in enumerate(samples, start=1):
+        if not isinstance(s, dict) or 'input' not in s or 'expected' not in s:
+            lines.append(f"Sample {i}: ERROR (malformed sample object; needs 'input' and 'expected')")
+            counts['ERROR'] += 1
+            continue
+        inp = str(s['input'])
+        expected = str(s['expected'])
+        if inp and not inp.endswith('\n'):
+            inp += '\n'
+        try:
+            proc = subprocess.run(
+                ['bash', '-c', str(solution_cmd)],
+                input=inp, capture_output=True, text=True, timeout=TIMEOUT_SECONDS,
+            )
+        except subprocess.TimeoutExpired:
+            lines.append(f"Sample {i}: ERROR (timeout after {TIMEOUT_SECONDS}s)")
+            counts['ERROR'] += 1
+            continue
+        except Exception as e:
+            lines.append(f"Sample {i}: ERROR (failed to run: {e})")
+            counts['ERROR'] += 1
+            continue
+
+        if proc.returncode != 0:
+            lines.append(f"Sample {i}: ERROR (exit code {proc.returncode})\nSTDERR:\n{_trunc(proc.stderr)}")
+            counts['ERROR'] += 1
+            continue
+
+        actual = proc.stdout or ''
+        if _norm_lines(actual) == _norm_lines(expected):
+            lines.append(f"Sample {i}: PASS")
+            counts['PASS'] += 1
+            continue
+
+        counts['EXACT-MISMATCH'] += 1
+        block = [
+            f"Sample {i}: EXACT-MISMATCH",
+            "EXPECTED:", _trunc(expected.rstrip()),
+            "ACTUAL:", _trunc(actual.rstrip()),
+        ]
+        if actual.split() == expected.split():
+            block.append("**WARNING: same tokens but different formatting/whitespace; hidden grader may compare exactly. Match the sample text exactly.**")
+        else:
+            block.append("**WARNING: output differs from the sample. Even if the problem accepts any valid answer, the grader may compare exactly. Infer the canonical construction from the samples and reproduce the expected output exactly, or explain why it is impossible.**")
+        lines.append("\n".join(block))
+
+    summary = (f"SUMMARY: {counts['PASS']} PASS, {counts['EXACT-MISMATCH']} EXACT-MISMATCH, "
+               f"{counts['ERROR']} ERROR out of {len(samples)} samples")
+    return "\n\n".join(lines) + "\n\n" + summary
