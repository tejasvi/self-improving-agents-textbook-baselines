+_SAMPLE_RE = re.compile(r"SUMMARY: \d+ PASS, (\d+) EXACT-MISMATCH")
+
+def _last_sample_check_mismatch(msg_history):
+    """True if the most recent sample_check result reported EXACT-MISMATCH samples (False if none found)."""
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'user':
+            continue
+        for b in _message_blocks(msg):
+            if b.get('type') == 'tool_result':
+                content = b.get('content', '')
+            elif b.get('type') == 'text':
+                content = b.get('text', '')
+            else:
+                continue
+            if isinstance(content, list):
+                content = "\n".join(str(c.get('text', '')) if isinstance(c, dict) else str(c) for c in content)
+            m = _SAMPLE_RE.search(str(content))
+            if m:
+                return int(m.group(1)) > 0
+    return False
+
