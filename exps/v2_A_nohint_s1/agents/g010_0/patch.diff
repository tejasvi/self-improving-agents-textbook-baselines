+def find_target_file(git_tempdir):
+    """Return the path of the file the agent should write: solution.py if present,
+    otherwise the first .py file (sorted, skipping hidden dirs). None if no .py file."""
+    sol = os.path.join(git_tempdir, 'solution.py')
+    if os.path.exists(sol):
+        return sol
+    for root, dirs, files in os.walk(git_tempdir):
+        dirs[:] = sorted(d for d in dirs if not d.startswith('.'))
+        for fname in sorted(files):
+            if fname.endswith('.py'):
+                return os.path.join(root, fname)
+    return None
+
+def read_file_or_none(path):
+    if path is None or not os.path.exists(path):
+        return None
+    with open(path, 'r', errors='replace') as f:
+        return f.read()
+
+def extract_samples(problem_statement):
+    """Extract (input, expected_output) pairs from 'Sample Input N' / 'Sample Output N' blocks."""
+    pattern = re.compile(
+        r"Sample Input\s*(\d*)[^\n]*\n(.*?)Sample Output\s*\1[^\n]*\n(.*?)(?=Sample Input|\Z)",
+        re.S | re.I,
+    )
+    samples = []
+    for _, inp, out in pattern.findall(problem_statement or ''):
+        inp = '\n'.join(l for l in inp.strip().splitlines() if not l.strip().startswith('```')).strip()
+        out = '\n'.join(l for l in out.strip().splitlines() if not l.strip().startswith('```')).strip()
+        if inp and out:
+            samples.append((inp, out))
+    return samples
+
+def run_samples(target, samples, timeout=10):
+    """Run `python3 target` on each sample. Returns None if all pass, otherwise a raw report string."""
+    if not samples:
+        return None
+    report = []
+    for idx, (inp, expected) in enumerate(samples, 1):
+        try:
+            proc = subprocess.run(
+                ['python3', target], input=inp + '\n', capture_output=True,
+                text=True, timeout=timeout, cwd=os.path.dirname(target) or '.',
+            )
+        except subprocess.TimeoutExpired:
+            report.append(f"Sample {idx}: TIMEOUT after {timeout}s\nInput:\n{inp}")
+            continue
+        actual = proc.stdout
+        if proc.returncode != 0:
+            report.append(f"Sample {idx}: CRASH (exit {proc.returncode})\nInput:\n{inp}\n"
+                          f"stdout:\n{actual}\nstderr:\n{proc.stderr}")
+            continue
+        actual_lines = [l.rstrip() for l in actual.strip().splitlines()]
+        expected_lines = [l.rstrip() for l in expected.strip().splitlines()]
+        if actual_lines != expected_lines:
+            diff = '\n'.join(difflib.unified_diff(
+                expected_lines, actual_lines, fromfile='expected', tofile='actual', lineterm=''))
+            report.append(f"Sample {idx}: MISMATCH\nInput:\n{inp}\nRaw stdout:\n{actual}\n"
+                          f"stderr:\n{proc.stderr}\nDiff:\n{diff}")
+    return '\n\n'.join(report) if report else None
+
+def last_assistant_text(msg_history):
+    """Text of the most recent assistant turn ('' if it ended empty or has no text)."""
+    for msg in reversed(msg_history or []):
+        if msg.get('role') != 'assistant':
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            return content.strip()
+        parts = []
+        for block in content or []:
+            text = block.get('text') if isinstance(block, dict) else getattr(block, 'text', None)
+            if text:
+                parts.append(text)
+        return '\n'.join(parts).strip()
+    return ''
