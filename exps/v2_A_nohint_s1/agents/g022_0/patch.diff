+import os
+import re
+import subprocess
+
+def tool_info():
+    return {
+        "name": "sample_runner",
+        "description": """Run a Python solution against the sample tests of a competitive-programming problem and report PASS/FAIL for each sample.\n
+* `problem_text` may be the raw problem statement or a path to a file containing it.\n
+* Samples are parsed from blocks such as 'Sample Input 1' / 'Sample Output 1', or 'Input:' / 'Output:' / 'Expected output:'.\n
+* The solution is run as `python3 solution_path` with each sample input on stdin, and stdout is compared token by token with the expected output.\n
+* For each FAIL, the expected output, actual output and stderr are shown.\n
+* If FAIL but the statement allows multiple answers, still try to make the output match exactly, since graders may use exact comparison.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "problem_text": {
+                    "type": "string",
+                    "description": "The problem statement text, or a path to a file containing the problem statement."
+                },
+                "solution_path": {
+                    "type": "string",
+                    "description": "Path to the Python solution file to run (executed as `python3 solution_path`)."
+                },
+                "timeout": {
+                    "type": "string",
+                    "description": "Optional timeout in seconds for each sample run (default 10)."
+                }
+            },
+            "required": ["problem_text", "solution_path"]
+        }
+    }
+
+# 'Sample Input 2', 'Input 2:', 'Input:' (optionally with inline content after the colon)
+_INPUT_RE = re.compile(r'^(?:sample\s+)?input(?:\s*(\d+))?\s*(:)?\s*(.*)$', re.IGNORECASE)
+# 'Sample Output 2', 'Expected output:', 'Output:' (optionally with inline content)
+_OUTPUT_RE = re.compile(r'^(?:sample\s+)?(?:expected\s+)?output(?:\s*(\d+))?\s*(:)?\s*(.*)$', re.IGNORECASE)
+# Lines that end a sample block
+_END_RE = re.compile(r'^(?:#|note\b|notes\b|explanation\b|```)', re.IGNORECASE)
+
+
+def _load_text(problem_text):
+    """Return the statement text; read it from disk if a file path is given."""
+    if isinstance(problem_text, str) and len(problem_text) < 4096:
+        try:
+            if os.path.isfile(problem_text):
+                with open(problem_text, 'r', encoding='utf-8', errors='replace') as f:
+                    return f.read()
+        except (OSError, ValueError):
+            pass
+    return str(problem_text)
+
+
+def _header(stripped):
+    """
+    Classify a stripped line as a sample header.
+    Returns (kind, index, inline_text) or None.
+    Indexed headers ('Sample Input 2') are always accepted. Unindexed headers
+    ('Input', 'Output') are only accepted when written with a colon, to avoid
+    matching section titles in prose.
+    """
+    m = _INPUT_RE.match(stripped)
+    if m and (m.group(1) or m.group(2) or stripped.lower().startswith('sample')):
+        return ('in', m.group(1), m.group(3))
+    m = _OUTPUT_RE.match(stripped)
+    if m and (m.group(1) or m.group(2) or stripped.lower().startswith(('sample', 'expected'))):
+        return ('out', m.group(1), m.group(3))
+    return None
+
+
+def _parse_samples(text):
+    """
+    Returns a list of (label, input_str, expected_output_str) in statement order.
+    """
+    blocks = []  # each: {'kind', 'index', 'body'}
+    current = None
+    for raw in text.splitlines():
+        stripped = raw.strip()
+        hdr = _header(stripped) if stripped else None
+        if hdr:
+            kind, index, inline = hdr
+            current = {'kind': kind, 'index': index, 'body': []}
+            blocks.append(current)
+            if inline:
+                current['body'].append(inline)
+            continue
+        if current is None:
+            continue
+        if _END_RE.match(stripped):
+            current = None
+            continue
+        if not stripped:
+            # A blank line ends the block once content has been collected
+            if current['body']:
+                current = None
+            continue
+        current['body'].append(stripped)
+
+    inputs = [(b['index'], '\n'.join(b['body']) + '\n') for b in blocks if b['kind'] == 'in' and b['body']]
+    outputs = [(b['index'], '\n'.join(b['body'])) for b in blocks if b['kind'] == 'out' and b['body']]
+
+    samples = []
+    out_by_index = {idx: val for idx, val in outputs if idx}
+    for pos, (idx, inp) in enumerate(inputs):
+        if idx and idx in out_by_index:
+            expected = out_by_index[idx]
+        elif not idx and pos < len(outputs):
+            expected = outputs[pos][1]
+        else:
+            continue
+        samples.append((idx or str(pos + 1), inp, expected))
+    return samples
+
+
+def _run_one(solution_path, inp, timeout):
+    """Returns (stdout, stderr, problem_message_or_None)."""
+    try:
+        proc = subprocess.run(
+            ['python3', solution_path],
+            input=inp, capture_output=True, text=True, timeout=timeout,
+        )
+        return proc.stdout, proc.stderr, None
+    except subprocess.TimeoutExpired as e:
+        out = e.stdout.decode(errors='replace') if isinstance(e.stdout, bytes) else (e.stdout or '')
+        return out, '', f"Timed out after {timeout} seconds"
+    except Exception as e:
+        return '', '', f"Failed to run solution: {e}"
+
+
+def tool_function(problem_text, solution_path, timeout=10):
+    try:
+        timeout = float(timeout) if timeout is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+
+    if not os.path.isfile(solution_path):
+        return f"Error: solution file not found: {solution_path}"
+
+    samples = _parse_samples(_load_text(problem_text))
+    if not samples:
+        return ("Error: no sample tests found in the problem statement. Expected blocks like "
+                "'Sample Input 1' / 'Sample Output 1' or 'Input:' / 'Output:'.")
+
+    report = []
+    passed = 0
+    for label, inp, expected in samples:
+        out, err, problem = _run_one(solution_path, inp, timeout)
+        if problem is None and out.split() == expected.split():
+            passed += 1
+            report.append(f"Sample {label}: PASS")
+            continue
+        report.append(f"Sample {label}: FAIL")
+        report.append(f"--- input ---\n{inp}")
+        report.append(f"--- expected output ---\n{expected}")
+        report.append(f"--- actual output ---\n{out}")
+        if problem:
+            report.append(f"--- error ---\n{problem}")
+        if err:
+            report.append(f"--- stderr ---\n{err}")
+
+    summary = f"Passed {passed}/{len(samples)} samples."
+    if passed != len(samples):
+        report.append("If FAIL but the statement allows multiple answers, still try to make the output match exactly, since graders may use exact comparison.")
+    return "\n".join([summary] + report)
