@@ -0,0 +1,104 @@
+import difflib
+import subprocess
+
+
+def tool_info():
+    return {
+        "name": "sample_check",
+        "description": """Run a solution command against a list of sample test cases and compare its stdout with the expected output.
+* Each sample has an 'input' (fed to stdin) and an 'expected' output.
+* Comparison is whitespace-normalized (trailing whitespace per line and surrounding blank lines are ignored).
+* Returns a PASS/FAIL line per sample; failing samples include a unified diff of expected vs actual output.
+* This tool ignores trailing whitespace; for byte-exact matching, also diff the output against the expected file in a scratch dir.""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The command used to run the solution, e.g. 'python3 solution.py'."
+                },
+                "samples": {
+                    "type": "array",
+                    "description": "List of sample test cases.",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "input": {
+                                "type": "string",
+                                "description": "Exact text fed to the program's stdin."
+                            },
+                            "expected": {
+                                "type": "string",
+                                "description": "Expected stdout for this input."
+                            }
+                        },
+                        "required": ["input", "expected"]
+                    }
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Working directory in which to run the command (e.g. the repository directory)."
+                }
+            },
+            "required": ["command", "samples", "cwd"]
+        }
+    }
+
+
+def _normalize(text):
+    # Strip trailing whitespace on each line and surrounding blank lines only.
+    lines = [line.rstrip() for line in text.splitlines()]
+    while lines and lines[0] == "":
+        lines.pop(0)
+    while lines and lines[-1] == "":
+        lines.pop()
+    return "\n".join(lines)
+
+
+def tool_function(command: str, samples: list, cwd: str) -> str:
+    timeout = 10
+    results = []
+    passed = 0
+    for idx, sample in enumerate(samples, start=1):
+        sample_input = sample.get("input", "")
+        expected = sample.get("expected", "")
+        try:
+            proc = subprocess.run(
+                command,
+                shell=True,
+                input=sample_input,
+                capture_output=True,
+                text=True,
+                cwd=cwd,
+                timeout=timeout,
+            )
+            actual = proc.stdout
+            stderr = proc.stderr
+            status_note = "" if proc.returncode == 0 else f" (exit code {proc.returncode})"
+        except subprocess.TimeoutExpired:
+            results.append(f"Sample {idx}: FAIL (timeout after {timeout}s)")
+            continue
+        except Exception as e:
+            results.append(f"Sample {idx}: FAIL (could not run command: {e})")
+            continue
+
+        if _normalize(actual) == _normalize(expected) and proc.returncode == 0:
+            passed += 1
+            results.append(f"Sample {idx}: PASS")
+        else:
+            diff = "\n".join(difflib.unified_diff(
+                _normalize(expected).splitlines(),
+                _normalize(actual).splitlines(),
+                fromfile=f"sample_{idx}.expected",
+                fromfiledate="",
+                tofile=f"sample_{idx}.actual",
+                tofiledate="",
+                lineterm="",
+            ))
+            msg = f"Sample {idx}: FAIL{status_note}\n{diff if diff else '(outputs equal after normalization; nonzero exit)'}"
+            if stderr.strip():
+                msg += f"\nstderr:\n{stderr.strip()[-2000:]}"
+            results.append(msg)
+
+    summary = f"{passed}/{len(samples)} samples passed."
+    return "\n".join(results + [summary])
