+import random, ast, re
+import solution as s
+
+def ref_is_empty(msg_history):
+    # brute force: scan all messages from the end for the last assistant turn
+    last = None
+    for m in msg_history:
+        if m.get("role") == "assistant":
+            last = m
+    if last is None:
+        return True
+    c = last.get("content")
+    if isinstance(c, str):
+        return c.strip() == ""
+    blocks = c if isinstance(c, list) else []
+    has_tool = any(isinstance(b, dict) and b.get("type") == "tool_use" for b in blocks)
+    has_text = any(isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip() for b in blocks)
+    return not has_tool and not has_text
+
+def ref_is_stub(src):
+    # brute force: list every FunctionDef via ast.walk; stub iff none has a non-trivial stmt
+    tree = ast.parse(src)
+    fns = [n for n in ast.walk(tree) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]
+    if not fns:
+        return False
+    def trivial(st):
+        if isinstance(st, ast.Pass): return True
+        if isinstance(st, ast.Expr) and isinstance(st.value, ast.Constant):
+            v = st.value.value
+            return v is Ellipsis or isinstance(v, str)
+        return False
+    return all(all(trivial(st) for st in f.body) for f in fns)
+
+def rand_blocks(rng):
+    k = rng.randint(0, 3)
+    out = []
+    for _ in range(k):
+        t = rng.choice(["text", "tool_use", "other"])
+        if t == "text":
+            out.append({"type": "text", "text": rng.choice(["", "  ", "hi", " x "])})
+        elif t == "tool_use":
+            out.append({"type": "tool_use", "name": "bash"})
+        else:
+            out.append({"type": "thinking", "text": "t"})
+    return out
+
+def rand_history(rng):
+    h = []
+    for _ in range(rng.randint(0, 4)):
+        role = rng.choice(["user", "assistant"])
+        if rng.random() < 0.3:
+            content = rng.choice(["", "  ", "abc"])
+        else:
+            content = rand_blocks(rng)
+        h.append({"role": role, "content": content})
+    return h
+
+def rand_src(rng):
+    parts = []
+    for i in range(rng.randint(0, 4)):
+        kind = rng.random()
+        name = f"f{i}"
+        if kind < 0.3:
+            parts.append(f"def {name}():\n    pass")
+        elif kind < 0.5:
+            parts.append(f"def {name}():\n    ...")
+        elif kind < 0.6:
+            parts.append(f'def {name}():\n    """doc"""')
+        elif kind < 0.7:
+            parts.append(f"class C{i}:\n    def m(self):\n        return {i}")
+        else:
+            parts.append(f"def {name}(x):\n    return x + {i}")
+    if rng.random() < 0.2:
+        parts.append("X = 1")
+    return "\n".join(parts) + "\n"
+
+def main(n=1000, seed=0):
+    rng = random.Random(seed)
+    fails = 0
+    for i in range(n):
+        h = rand_history(rng)
+        if s.is_empty_response(h) != ref_is_empty(h):
+            fails += 1; print("EMPTY MISMATCH", i, h)
+        src = rand_src(rng)
+        if s.is_stub_source(src) != ref_is_stub(src):
+            fails += 1; print("STUB MISMATCH", i, repr(src))
+        # extract_code: fenced block contents must come back verbatim
+        body = "".join(f"x{j} = {j}\n" for j in range(rng.randint(1, 5)))
+        resp = rng.choice(["", "  ", "prose only", "here\n```python\n" + body + "```\nbye"])
+        got = s.extract_code(resp)
+        if resp.startswith("here"):
+            if got != body:
+                fails += 1; print("EXTRACT MISMATCH", i, repr(got), repr(body))
+        elif resp.strip() == "" or resp == "prose only":
+            if got is not None:
+                fails += 1; print("EXTRACT SHOULD BE NONE", i, repr(resp), repr(got))
+    print(f"cases={n} failures={fails}")
+    return fails
+
+if __name__ == "__main__":
+    import sys
+    raise SystemExit(1 if main(int(sys.argv[1]) if len(sys.argv) > 1 else 1000) else 0)
