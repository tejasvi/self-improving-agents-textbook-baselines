+def _has_benchmark_input(git_tempdir):
+    """True if a max-size benchmark input file (big_input.*) exists in the repository root."""
+    try:
+        return any(name.startswith('big_input.') for name in os.listdir(git_tempdir))
+    except OSError:
+        return False
+
+
+def _import_timeout_output(git_tempdir, timeout=10):
+    """Raw output of `python -c 'import solution'` if it times out, else None."""
+    try:
+        result = subprocess.run(
+            ["python", "-c", "import solution"], cwd=git_tempdir,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=timeout
+        )
+    except subprocess.TimeoutExpired as e:
+        out = (e.stdout or b'') + (e.stderr or b'')
+        return f"TIMEOUT after {timeout}s\n" + out.decode(errors='replace')
+    return None
+
