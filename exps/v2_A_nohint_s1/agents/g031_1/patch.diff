diff --git a/tests/test_benchmark_tool.py b/tests/test_benchmark_tool.py
new file mode 100644
index 0000000..969cc2d
--- /dev/null
+++ b/tests/test_benchmark_tool.py
@@ -0,0 +1,28 @@
+from tools.benchmark import tool_function, tool_info
+
+
+def test_schema_is_valid():
+    info = tool_info()
+    assert info['name'] == 'benchmark'
+    schema = info['input_schema']
+    assert schema['type'] == 'object'
+    assert schema['required'] == ['command']
+    for name, prop in schema['properties'].items():
+        assert 'type' in prop and 'description' in prop, name
+
+
+def test_timeout_marker():
+    result = tool_function('sleep 30', timeout_seconds=1)
+    assert 'TIMEOUT' in result
+
+
+def test_normal_run_reports_output_and_return_code():
+    result = tool_function('echo hello; exit 3')
+    assert 'hello' in result
+    assert 'Return code: 3' in result
+    assert 'TIMEOUT' not in result
+
+
+def test_cwd_is_respected(tmp_path):
+    result = tool_function('pwd', cwd=str(tmp_path))
+    assert str(tmp_path) in result
diff --git a/tools/benchmark.py b/tools/benchmark.py
new file mode 100644
index 0000000..dabf80e
--- /dev/null
+++ b/tools/benchmark.py
@@ -0,0 +1,93 @@
+import os
+import signal
+import subprocess
+import time
+
+MAX_OUTPUT_CHARS = 4000
+
+
+def tool_info():
+    return {
+        "name": "benchmark",
+        "description": """Run a shell command with a hard wall-clock timeout and report the raw result.\n
+* Use it to time a solution on maximum-size generated inputs, e.g. `python solution.py < big_input.txt` or `python -c 'from solution import Solution; ...'`.\n
+* If the command does not finish within timeout_seconds, the whole process group is killed and the output starts with a 'TIMEOUT' line.\n
+* The output contains the elapsed wall time, the return code, and the (possibly truncated) raw stdout and stderr. No interpretation is done; analyze the raw output yourself.\n
+* stdin of the command is empty (/dev/null).""",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {
+                    "type": "string",
+                    "description": "The shell command to run, e.g. `python solution.py < big_input.txt`."
+                },
+                "timeout_seconds": {
+                    "type": "number",
+                    "description": "Hard timeout in seconds before the process group is killed. Default 10."
+                },
+                "cwd": {
+                    "type": "string",
+                    "description": "Working directory in which to run the command. Defaults to the current directory."
+                }
+            },
+            "required": ["command"]
+        }
+    }
+
+
+def _truncate(text):
+    if len(text) <= MAX_OUTPUT_CHARS:
+        return text
+    half = MAX_OUTPUT_CHARS // 2
+    return text[:half] + f"\n<output truncated: {len(text)} chars total>\n" + text[-half:]
+
+
+def tool_function(command, timeout_seconds=10, cwd=None):
+    try:
+        timeout = float(timeout_seconds) if timeout_seconds is not None else 10.0
+    except (TypeError, ValueError):
+        timeout = 10.0
+    if timeout <= 0:
+        timeout = 10.0
+
+    try:
+        proc = subprocess.Popen(
+            command,
+            shell=True,
+            cwd=cwd or None,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,  # own process group so the whole tree can be killed
+        )
+    except OSError as e:
+        return f"Failed to start command: {e}"
+
+    start = time.monotonic()
+    timed_out = False
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except OSError:
+            pass
+        try:
+            stdout, stderr = proc.communicate(timeout=5)
+        except subprocess.TimeoutExpired:
+            stdout, stderr = b"", b""
+            proc.kill()
+    elapsed = time.monotonic() - start
+
+    out = _truncate(stdout.decode(errors='replace'))
+    err = _truncate(stderr.decode(errors='replace'))
+
+    lines = []
+    if timed_out:
+        lines.append(f"TIMEOUT after {timeout:g}s (process group killed)")
+    lines.append(f"Elapsed: {elapsed:.3f}s")
+    lines.append(f"Return code: {proc.returncode}")
+    lines.append(f"--- stdout ---\n{out}")
+    lines.append(f"--- stderr ---\n{err}")
+    return "\n".join(lines)
