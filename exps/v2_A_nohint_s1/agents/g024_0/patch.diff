+import random, sys
+sys.path.insert(0, '/dgm')
+from solution import Solution
+from brute import min_difference
+s = Solution()
+random.seed(1)
+cases = 0
+for _ in range(5000):
+    n = random.randint(1, 9)
+    r = random.choice([0, 1, 3, 10, 10**9])
+    nums = [random.randint(-r, r) for _ in range(n)]
+    if random.random() < 0.2:
+        nums = [nums[0]] * n  # all equal
+    got, exp = s.minDifference(list(nums)), min_difference(nums)
+    cases += 1
+    if got != exp:
+        print("MISMATCH", nums, got, exp); sys.exit(1)
+print(f"stress OK: {cases} cases, no mismatches")
