@@ -0,0 +1,12 @@
+import itertools
+def min_difference(nums):
+    n = len(nums)
+    if n <= 4:
+        return 0
+    best = None
+    for rm in itertools.combinations(range(n), 3):
+        s = set(rm)
+        rest = [nums[i] for i in range(n) if i not in s]
+        d = max(rest) - min(rest)
+        best = d if best is None else min(best, d)
+    return best
