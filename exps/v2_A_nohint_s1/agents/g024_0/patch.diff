@@ -0,0 +1,13 @@
+from typing import List
+
+
+class Solution:
+    def minDifference(self, nums: List[int]) -> int:
+        # With at most 3 changes, we can remove any 3 elements.
+        # Sorted, the remaining range is a window of length n-3 (i.e. drop k from
+        # the low end and 3-k from the high end), so check all 4 such windows.
+        n = len(nums)
+        if n <= 4:
+            return 0
+        a = sorted(nums)
+        return min(a[n - 4 + i] - a[i] for i in range(4))
