+def _read_repo_snapshot(files, problem_statement, max_chars=SNAPSHOT_MAX_CHARS):
+    """
+    Build a repo snapshot from a dict {name: content}.
+    Skips README-like files whose content mostly overlaps the problem statement,
+    and caps the total size at max_chars.
+    """
+    problem_words = set(re.findall(r"\w+", (problem_statement or "").lower()))
+    parts = []
+    total = 0
+    for name, content in files.items():
+        if os.path.basename(name).lower().startswith("readme") and name.lower().endswith(".md"):
+            words = re.findall(r"\w+", content.lower())
+            if words:
+                overlap = sum(1 for w in words if w in problem_words) / len(words)
+                if overlap > 0.5:
+                    continue
+        remaining = max_chars - total
+        if remaining <= 0:
+            break
+        chunk = f"--- {name} ---\n{content}\n"
+        if len(chunk) > remaining:
+            chunk = chunk[:remaining]
+        parts.append(chunk)
+        total += len(chunk)
+    return "".join(parts)
 
 
