+def _direct_generate_solution(generate_fn, models, prompt, out_path):
+    """
+    Try each model in order with generate_fn(model, prompt) -> raw text.
+    Extract code and write it to out_path. Returns True on success.
+    """
+    for model in models:
+        try:
+            text = generate_fn(model, prompt)
+            code = _extract_code(text)
+            if not code:
+                log(f"No code extracted from model {model}")
+                continue
+            with open(out_path, "w") as f:
+                f.write(code + "\n")
+            return True
+        except IndexError:
+            log(f"IndexError with model {model}:\n{traceback.format_exc()}")
+        except Exception:
+            log(f"Direct generation failed with model {model}:\n{traceback.format_exc()}")
+    return False
+
+
+def ensure_solution(out_path):
+    """
+    Last resort: if out_path is missing or empty, write a minimal compilable stub.
+    Returns True if a stub was written.
+    """
+    if os.path.exists(out_path) and os.path.getsize(out_path) > 0:
+        return False
+    with open(out_path, "w") as f:
+        f.write(STUB_SOLUTION)
+    log(f"Wrote stub solution to {out_path} (no valid solution was produced)")
+    return True
