 from utils.common_utils import load_json_file
+
+# flagship: the driver replaces this with a per-instance proxy token minter (default = DGM's behaviour)
+api_key_for = lambda instance_id: os.getenv('ANTHROPIC_API_KEY')
+
+def diag_copy_out(container, instance_id, base_commit, out_dname):
+    """flagship, diagnostics only: after a failed step, keep the agent's chat history and its current patch on the host
+    under <out_dname>/diag/. Runs after the agent process has ended; writes nothing into the prediction JSON."""
+    if container is None:
+        return
+    try:
+        d = out_dname / 'diag'
+        d.mkdir(exist_ok=True)
+        r = container.exec_run(f"find /dgm/ -maxdepth 1 -name '{instance_id}*.md'", workdir='/')
+        for f in r.output.decode().split():
+            copy_from_container(container, f, d / Path(f).name)
+        r = container.exec_run("cat /dgm/model_patch.diff")
+        if r.exit_code == 0:
+            (d / f"{instance_id}_model_patch.diff").write_bytes(r.output)
+        # the patch as the agent would have written it (its own utils.git_utils.diff_versus_commit), else plain git diff
+        r = container.exec_run(["python", "-c", "import sys; sys.path.insert(0, '/dgm'); from utils.git_utils import "
+                                "diff_versus_commit; sys.stdout.write(diff_versus_commit('/testbed/', sys.argv[1]))",
+                                base_commit], workdir='/')
+        if r.exit_code != 0:
+            r = container.exec_run(["git", "-C", "/testbed", "diff", base_commit], workdir='/')
+        (d / f"{instance_id}_current_patch.diff").write_bytes(r.output)
+    except Exception as e:
+        print(f"diag copy-out failed for {instance_id}: {e}")
 
