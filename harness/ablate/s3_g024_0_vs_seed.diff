+            ["git", "-C", self.git_tempdir, "ls-files", "--others", "--exclude-standard"],
+        ]
+        for cmd in commands:
+            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            for line in result.stdout.decode(errors='replace').splitlines():
+                line = line.strip()
+                if line:
+                    changed.add(line)
